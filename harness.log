\t\t// SCA reads the target's manifests from the paths the scan was given, not from the\n694\t\t\t\t// partition, so a dependency finding is produced once per partition. Findings that\n695\t\t\t\t// come from source cannot repeat: the partitions are disjoint file sets.\n696\t\t\t\tfp := resultpolicy.Fingerprint(f)\n697\t\t\t\tif seen[fp] {\n698\t\t\t\t\tcontinue\n699\t\t\t\t}\n700\t\t\t\tseen[fp] = true\n701\t\t\t\tall = append(all, f)\n702\t\t\t}\n703\t\t}\n704\t\treturn all, stats, nil, nil\n705\t}\n706\t\n707\tfunc scanPathsWithProfileDemand(paths []string, ruleSources []parser.V2DefinitionSource, profileName string, pruneBindings bool, build extract.Options) ([]*findings.Finding, extract.Stats, usg.Store, error) {\n708\t\trules, err := compiledRulesFor(ruleSources)\n709\t\tif err != nil {\n710\t\t\treturn nil, extract.Stats{}, nil, err\n711\t\t}\n712\t\tvar bindingConcepts map[string]bool\n713\t\tif pruneBindings {\n714\t\t\tbindingConcepts = engine.BindingConcepts(rules.onto, rules.compiled, profileName)\n715\t\t}\n716\t\tbuild.BindingConcepts = bindingConcepts\n717\t\tbuild.Sync = syncCollector\n718\t\tg, stats, err := extract.BuildGraph(paths, extract.SharedDeltaCache(), build)\n719\t\tif err != nil {\n720\t\t\treturn nil, stats, nil, err\n721\t\t}\n722\t\tif g == nil {\n723\t\t\treturn nil, stats, nil, nil // recognized files, but nothing to analyze\n724\t\t}\n725\t\teng := engine.New(rules.onto, g)\n726\t\tvar all []*findings.Finding\n727\t\ttk := timing.New()\n728\t\tvar activeRules []*engine.CompiledRule\n729\t\tfor _, cr := range rules.compiled {\n730\t\t\tif !engine.RuleActiveForProfile(cr, profileName) {\n731\t\t\t\tcontinue\n732\t\t\t}\n733\t\t\tactiveRules = append(activeRules, cr)\n734\t\t}\n735\t\tif err := eng.PrecomputeTaintFlows(activeRules); err != nil {\n736\t\t\treturn nil, stats, g, err\n737\t\t}\n738\t\tfor _, cr := range activeRules {\n739\t\t\tstart := time.Now()\n740\t\t\tgot, err := eng.Evaluate(cr)\n741\t\t\tif err != nil {\n742\t\t\t\