{"type":"assistant","message":{"id":"msg_2026091913255882f0cd5406c1462a","type":"message","role":"assistant","model":"glm-5.3","content":[{"type":"tool_use","id":"call_6bcdbb8cc1554d8ab314ca06","name":"Write","input":{"file_path":"/campaign/work/engine-the-engine-s-memory-safety-stop-ends-a-whole-repository-scan/internal/extract/frontend/treesitter/python_literal_profile_test.go","content":"package treesitter\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/vyprai/vyql/internal/extract/lowering\"\n\t\"github.com/vyprai/vyql/internal/usg\"\n)\n\n// TestPythonModuleLiteralProfile is a scratch measurement, not a shipped test:\n// it lowers one dense module and reports where the bytes sit.\nfunc TestPythonModuleLiteralProfile(t *testing.T) {\n\tif os.Getenv(\"VYQL_PROFILE\") == \"\" {\n\t\tt.Skip(\"set VYQL_PROFILE=1\")\n\t}\n\tvar src strings.Builder\n\tfor i := 0; i < 2000; i++ {\n\t\tfmt.Fprintf(&src, \"def handler_%d(request):\\n    \\\"\\\"\\\"Handler %d: read the request, shape a record, answer.\\\"\\\"\\\"\\n    field_%d = request.get(\\\"field_%d\\\", \\\"\\\")\\n    record_%d = {\\\"field_%d\\\": field_%d, \\\"size_%d\\\": len(field_%d)}\\n    return record_%d\\n\\n\", i, i, i, i, i, i, i, i, i, i)\n\t}\n\tdir := t.TempDir()\n\tfile := filepath.Join(dir, \"dense.py\")\n\tif err := os.WriteFile(file, []byte(src.String()), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tprog, err := ExtractPython([]string{file}, dir)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tg, err := lowering.Lower(prog, true)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tnodes, err := g.AllNodes()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tvar strArgsBytes, constValueBytes, otherPropBytes int\n\tconstValues := map[string]int{}\n\tfor _, n := range nodes {\n\t\tstrArgsBytes += len(n.StrArgs)\n\t\tfor k, v := range n.Props {\n\t\t\tif k == \"value\" && n.Type == \"code.Const\" {\n\t\t\t\tconstValueBytes += len(v)\n\t\t\t\tconstValues[v]++\n\t\t\t} else {\n\t\t\t\totherPropBytes += len(v)\n\t\t\t}\n\t\t}\n\t}\n\tvar sharedBytes int\n\tfor v, c := range constValues {\n\t\tif c > 1 {\n\t\t\tsharedBytes += len(v)\n\t\t}\n\t}\n\tt.Logf(\"nodes=%d str_args total=%d MiB (%.1f KiB/node) const value bytes(sum over nodes)=%d MiB distinct const values=%d MiB shared-by->1-node=%d MiB other props=%d MiB\",\n\t\tlen(nodes), strArgsBytes>>20, float64(strArgsBytes)/float64(len(nodes))/1024, constValueBytes>>20,\n\t\tsumKeys(constValues)>>20, sharedBytes>>20, otherPropBytes>>20)\n\tvar biggest int\n\tvar bigSrc string\n\tfor _, n := range nodes {\n\t\tif len(n.StrArgs) > biggest {\n\t\t\tbiggest, bigSrc = len(n.StrArgs), n.Prop(\"callee_path\")\n\t\t}\n\t}\n\tt.Logf(\"biggest str_args=%d KiB on %q\", biggest>>10, bigSrc)\n}\n\nfunc sumKeys(m map[string]int) int {\n\tvar t int\n\tfor k := range m {\n\t\tt += len(k)\n\t}\n\treturn t\n}\n\nvar _ = usg.Close\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"3d3b39ce-4baf-4531-a837-11deefe45eb7","uuid":"725e988f-fb93-4521-b568-799453652a5f","timestamp":"2026-09-19T05:26:30.458Z"}
