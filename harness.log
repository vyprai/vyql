{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f290d2e8beb84296a36e4a5b","type":"tool_result","content":"1\tpackage extract\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"strings\"\n6\t\n7\t\t\"github.com/vyprai/vyql/internal/bindings\"\n8\t\t\"github.com/vyprai/vyql/internal/extract/lowering\"\n9\t\t\"github.com/vyprai/vyql/internal/extract/nir\"\n10\t\t\"github.com/vyprai/vyql/internal/extract/parsecache\"\n11\t\t\"github.com/vyprai/vyql/internal/extract/sca\"\n12\t\t\"github.com/vyprai/vyql/internal/graphsync\"\n13\t\t\"github.com/vyprai/vyql/internal/timing\"\n14\t\t\"github.com/vyprai/vyql/internal/usg\"\n15\t)\n16\t\n17\t// Options are the per-scan inputs to BuildGraph. They are fields rather than package state:\n18\t// as globals they made two scans in one process unsafe, and neither the exclude set nor the\n19\t// overlay was visible at the call site that depended on it.\n20\ttype Options struct {\n21\t\t// BindingConcepts, when non-nil, restricts binding application to the concepts the active\n22\t\t// rules can actually reach (demand analysis).\n23\t\tBindingConcepts map[string]bool\n24\t\t// BindingOverlay is a directory of extra binding data layered over the built-in set.\n25\t\tBindingOverlay string\n26\t\t// Excludes are the compiled -exclude patterns. A directory pattern prunes the\n27\t\t// walk; a file glob drops entries as they are listed.\n28\t\tExcludes Excludes\n29\t\t// Only, when non-nil, restricts this build to one partition of the target: the set of\n30\t\t// file paths it covers. See PlanPartitions.\n31\t\tOnly map[string]bool\n32\t\t// Sync, when non-nil, collects a graph-database change-feed during the build.\n33\t\tSync *graphsync.Collector\n34\t}\n35\t\n36\t// SharedDeltaCache returns the process parse cache as a lowering.DeltaCache, or nil when\n37\t// caching is off. (A nil *parsecache.Cache must become a nil interface, not a non-nil\n38\t// interface holding nil.)\n39\tfunc SharedDeltaCache() lowering.DeltaCache {\n40\t\tif c := parsecache.Shared(); c != nil && c.Persistent() {\n41\t\t\treturn c\n42\t\t}\n43\t\treturn nil\n44\t}\n45\t\n46\t// BuildGraph runs extract → lower → SCA → bindings and returns the analysis graph (the USG\n47\t// the rule engine evaluates against), plus what the extraction pass did and did not read.\n48\t// Returns a nil store when recognized files produced nothing to analyze.\n49\tfunc init() {\n50\t\tlowering.CallEffects = bindings.CallEffectsForLoc\n51\t}\n52\t\n53\tfunc BuildGraph(paths []string, cache lowering.DeltaCache, opts Options) (usg.Store, Stats, error) {\n54\t\trestoreConcepts := bindings.SetActiveBindingConcepts(opts.BindingConcepts)\n55\t\tdefer restoreConcepts()\n56\t\n57\t\ttk := timing.New()\n58\t\tprog, bindingApps, ctorTypes, stats, err := AllIn(paths, opts.Excludes, opts.Only)\n59\t\tif err != nil {\n60\t\t\treturn nil, stats, err\n61\t\t}\n62\t\ttk.Mark(\"extract\")\n63\t\t// A tree with nothing parseable can still carry dependency evidence: applySCA does its own\n64\t\t// walk and reads manifests and vendored library banners without needing a parsed module. A\n65\t\t// project that vendors only minified bundles lands here, because the walker skips those as\n66\t\t// unparseable — so run SCA before concluding there is nothing to report.\n67\t\tif len(prog.Modules) == 0 {\n68\t\t\tg := usg.NewInMemStore()\n69\t\t\tsca.Apply(g, paths)\n70\t\t\tnodes, err := g.AllNodes()\n71\t\t\tif err != nil {\n72\t\t\t\treturn nil, stats, err\n73\t\t\t}\n74\t\t\tif len(nodes) == 0 {\n75\t\t\t\t// Nothing parseable AND no dependency evidence. Distinguish \"you pointed me at a\n76\t\t\t\t// tree I cannot read\" from \"I read it and it is clean\", so the former stays a\n77\t\t\t\t// diagnosable error rather than a silent zero-finding pass.\n78\t\t\t\tif len(stats.Files) == 0 {\n79\t\t\t\t\treturn nil, stats, fmt.Errorf(\"no supported source found under %s\", strings.Join(paths, \", \"))\n80\t\t\t\t}\n81\t\t\t\treturn nil, stats, nil\n82\t\t\t}\n83\t\t\tif _, _, err := bindings.Apply(g, bindings.AutoBindings(), nil); err != nil {\n84\t\t\t\treturn nil, stats, err\n85\t\t\t}\n86\t\t\ttk.Mark(\"sca+bindings\")\n87\t\t\tusg.Freeze(g)\n88\t\t\treturn g, stats, nil\n89\t\t}\n90\t\t// Incremental lowering when a cache is provided: reuse the lowered sub-graph of unchanged\n91\t\t// modules, re-lowering only edited ones. Equivalent to LowerTyped (the merged graph is\n92\t\t// identical), so bindings/taint/rules below are untouched. Benefits every command that\n93\t\t// builds a graph (scan, trace, query, graph, …).\n94\t\tvar g usg.Store\n95\t\tvar fresh map[string]bool\n96\t\tincremental := cache != nil\n97\t\tif incremental {\n98\t\t\tg, fresh, err = lowering.LowerIncremental(prog, true, ctorTypes, cache, opts.Sync)\n99\t\t} else {\n100\t\t\t// Even with cross-scan caching disabled, a bounded scan installs a transient\n101\t\t\t// body spool. It controls frontend/NIR lifetime without paying to encode graph\n102\t\t\t// deltas that cannot be reused after this process exits.\n103\t\t\tvar bodies lowering.BodyCache\n104\t\t\tif c := parsecache.Shared(); c != nil {\n105\t\t\t\tbodies = c\n106\t\t\t}\n107\t\t\tg, err = lowering.LowerTypedDeferred(prog, true, ctorTypes, bodies)\n108\t\t}\n109\t\tif err != nil {\n110\t\t\treturn nil, stats, err\n111\t\t}\n112\t\ttk.Mark(\"lower\")\n113\t\t// SCA runs before binding apply so SBOM/manifest packages join the import evidence\n114\t\t// that gates package-aware bindings (the generated catalog included).\n115\t\tsca.Apply(g, paths)\n116\t\t// Dynamic, dependency-gated package bindings: load the generated per-package catalog\n117\t\t// only for packages this project actually depends on, then apply alongside the static\n118\t\t// framework bindings.\n119\t\tdeps := bindings.DependencyEvidence(g)\n120\t\tfor _, lang := range stats.Languages {\n121\t\t\tbindingApps = append(bindingApps, bindings.GeneratedPackageBindingsFor(lang, deps)...)\n122\t\t}\n123\t\tif overlay := strings.TrimSpace(opts.BindingOverlay); overlay != \"\" {\n124\t\t\textra, err := bindings.OverlayBindings(overlay, stats.Languages)\n125\t\t\tif err != nil {\n126\t\t\t\treturn nil, stats, fmt.Errorf(\"binding overlay: %w\", err)\n127\t\t\t}\n128\t\t\tbindingApps = append(bindingApps, extra...)\n129\t\t}\n130\t\ttk.Mark(\"sca+pkg\")\n131\t\t// Binding labeling: incremental (reuse unchanged modules' cached labels) when caching is\n132\t\t// on, else a full pass. Both produce identical labels — binding precedence is per-node.\n133\t\tif incremental {\n134\t\t\trelabel, err := bindings.ApplyIncremental(g, bindingApps, ModuleHashes(prog), deps, cache)\n135\t\t\tif err != nil {\n136\t\t\t\treturn nil, stats, err\n137\t\t\t}\n138\t\t\t// Graph DB change-feed: collect the label rows of every label-dirty module. Label-dirty\n139\t\t\t// is the binding relabel set plus the lowering fresh set (a fresh module's labels may also\n140\t\t\t// have changed; re-emitting unchanged ones is an idempotent upsert). Nodes come from the\n141\t\t\t// same pass (fresh set); edges were collected creator-attributed during lowering.\n142\t\t\tif opts.Sync != nil {\n143\t\t\t\tlabelDirty := map[string]bool{}\n144\t\t\t\tfor ns := range fresh {\n145\t\t\t\t\tlabelDirty[ns] = true\n146\t\t\t\t}\n147\t\t\t\tfor ns := range relabel {\n148\t\t\t\t\tlabelDirty[ns] = true\n149\t\t\t\t}\n150\t\t\t\tfor ns := range labelDirty {\n151\t\t\t\t\topts.Sync.MarkRelabel(ns)\n152\t\t\t\t}\n153\t\t\t\tif err := opts.Sync.CollectGraph(g, labelDirty); err != nil {\n154\t\t\t\t\treturn nil, stats, err\n155\t\t\t\t}\n156\t\t\t}\n157\t\t} else if _, _, err := bindings.Apply(g, bindingApps, nil); err != nil {\n158\t\t\treturn nil, stats, err\n159\t\t}\n160\t\ttk.Mark(\"bindings\")\n161\t\tusg.Freeze(g)\n162\t\treturn g, stats, nil\n163\t}\n164\t\n165\t// ModuleHashes maps each content-addressed module's namespace (lowering.ModuleNS) to its\n166\t// content hash, the per-module identity the incremental binding-label cache keys on. Modules\n167\t// without a Hash (native frontends) are omitted, so they are always relabeled.\n168\tfunc ModuleHashes(prog nir.Program) map[string]string {\n169\t\tm := map[string]string{}\n170\t\tfor _, mod := range prog.Modules {\n171\t\t\tif mod.Hash != \"\" {\n172\t\t\t\tm[lowering.ModuleNS(mod)] = mod.Hash\n173\t\t\t}\n174\t\t}\n175\t\treturn m\n176\t}\n177\t"}]},"parent_tool_use_id":null,"session_id":"f1b7e732-1060-4c03-a560-f041798bec11","uuid":"afbc50cf-50ab-4412-974e-69df49255db5","timestamp":"2026-09-16T22:45:11.906Z","tool_use_result":{"type":"text","file":{"filePath":"/campaign/work/engine-the-engine-s-memory-safety-stop-ends-a-whole-repository-scan/internal/extract/pipeline.go","content":"package extract\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n\n\t\"github.com/vyprai/vyql/internal/bindings\"\n\t\"github.com/vyprai/vyql/internal/extract/lowering\"\n\t\"github.com/vyprai/vyql/internal/extract/nir\"\n\t\"github.com/vyprai/vyql/internal/extract/parsecache\"\n\t\"github.com/vyprai/vyql/internal/extract/sca\"\n\t\"github.com/vyprai/vyql/internal/graphsync\"\n\t\"github.com/vyprai/vyql/internal/timing\"\n\t\"github.com/vyprai/vyql/internal/usg\"\n)\n\n// Options are the per-scan inputs to BuildGraph. They are fields rather than package state:\n// as globals they made two scans in one process unsafe, and neither the exclude set nor the\n// overlay was visible at the call site that depended on it.\ntype Options struct {\n\t// BindingConcepts, when non-nil, restricts binding application to the concepts the active\n\t// rules can actually reach (demand analysis).\n\tBindingConcepts map[string]bool\n\t// BindingOverlay is a directory of extra binding data layered over the built-in set.\n\tBindingOverlay string\n\t// Excludes are the compiled -exclude patterns. A directory pattern prunes the\n\t// walk; a file glob drops entries as they are listed.\n\tExcludes Excludes\n\t// Only, when non-nil, restricts this build to one partition of the target: the set of\n\t// file paths it covers. See PlanPartitions.\n\tOnly map[string]bool\n\t// Sync, when non-nil, collects a graph-database change-feed during the build.\n\tSync *graphsync.Collector\n}\n\n// SharedDeltaCache returns the process parse cache as a lowering.DeltaCache, or nil when\n// caching is off. (A nil *parsecache.Cache must become a nil interface, not a non-nil\n// interface holding nil.)\nfunc SharedDeltaCache() lowering.DeltaCache {\n\tif c := parsecache.Shared(); c != nil && c.Persistent() {\n\t\treturn c\n\t}\n\treturn nil\n}\n\n// BuildGraph runs extract → lower → SCA → bindings and returns the analysis graph (the USG\n// the rule engine evaluates against), plus what the extraction pass did and did not read.\n// Returns a nil store when recognized files produced nothing to analyze.\nfunc init() {\n\tlowering.CallEffects = bindings.CallEffectsForLoc\n}\n\nfunc BuildGraph(paths []string, cache lowering.DeltaCache, opts Options) (usg.Store, Stats, error) {\n\trestoreConcepts := bindings.SetActiveBindingConcepts(opts.BindingConcepts)\n\tdefer restoreConcepts()\n\n\ttk := timing.New()\n\tprog, bindingApps, ctorTypes, stats, err := AllIn(paths, opts.Excludes, opts.Only)\n\tif err != nil {\n\t\treturn nil, stats, err\n\t}\n\ttk.Mark(\"extract\")\n\t// A tree with nothing parseable can still carry dependency evidence: applySCA does its own\n\t// walk and reads manifests and vendored library banners without needing a parsed module. A\n\t// project that vendors only minified bundles lands here, because the walker skips those as\n\t// unparseable — so run SCA before concluding there is nothing to report.\n\tif len(prog.Modules) == 0 {\n\t\tg := usg.NewInMemStore()\n\t\tsca.Apply(g, paths)\n\t\tnodes, err := g.AllNodes()\n\t\tif err != nil {\n\t\t\treturn nil, stats, err\n\t\t}\n\t\tif len(nodes) == 0 {\n\t\t\t// Nothing parseable AND no dependency evidence. Distinguish \"you pointed me at a\n\t\t\t// tree I cannot read\" from \"I read it and it is clean\", so the former stays a\n\t\t\t// diagnosable error rather than a silent zero-finding pass.\n\t\t\tif len(stats.Files) == 0 {\n\t\t\t\treturn nil, stats, fmt.Errorf(\"no supported source found under %s\", strings.Join(paths, \", \"))\n\t\t\t}\n\t\t\treturn nil, stats, nil\n\t\t}\n\t\tif _, _, err := bindings.Apply(g, bindings.AutoBindings(), nil); err != nil {\n\t\t\treturn nil, stats, err\n\t\t}\n\t\ttk.Mark(\"sca+bindings\")\n\t\tusg.Freeze(g)\n\t\treturn g, stats, nil\n\t}\n\t// Incremental lowering when a cache is provided: reuse the lowered sub-graph of unchanged\n\t// modules, re-lowering only edited ones. Equivalent to LowerTyped (the merged graph is\n\t// identical), so bindings/taint/rules below are untouched. Benefits every command that\n\t// builds a graph (scan, trace, query, graph, …).\n\tvar g usg.Store\n\tvar fresh map[string]bool\n\tincremental := cache != nil\n\tif incremental {\n\t\tg, fresh, err = lowering.LowerIncremental(prog, true, ctorTypes, cache, opts.Sync)\n\t} else {\n\t\t// Even with cross-scan caching disabled, a bounded scan installs a transient\n\t\t// body spool. It controls frontend/NIR lifetime without paying to encode graph\n\t\t// deltas that cannot be reused after this process exits.\n\t\tvar bodies lowering.BodyCache\n\t\tif c := parsecache.Shared(); c != nil {\n\t\t\tbodies = c\n\t\t}\n\t\tg, err = lowering.LowerTypedDeferred(prog, true, ctorTypes, bodies)\n\t}\n\tif err != nil {\n\t\treturn nil, stats, err\n\t}\n\ttk.Mark(\"lower\")\n\t// SCA runs before binding apply so SBOM/manifest packages join the import evidence\n\t// that gates package-aware bindings (the generated catalog included).\n\tsca.Apply(g, paths)\n\t// Dynamic, dependency-gated package bindings: load the generated per-package catalog\n\t// only for packages this project actually depends on, then apply alongside the static\n\t// framework bindings.\n\tdeps := bindings.DependencyEvidence(g)\n\tfor _, lang := range stats.Languages {\n\t\tbindingApps = append(bindingApps, bindings.GeneratedPackageBindingsFor(lang, deps)...)\n\t}\n\tif overlay := strings.TrimSpace(opts.BindingOverlay); overlay != \"\" {\n\t\textra, err := bindings.OverlayBindings(overlay, stats.Languages)\n\t\tif err != nil {\n\t\t\treturn nil, stats, fmt.Errorf(\"binding overlay: %w\", err)\n\t\t}\n\t\tbindingApps = append(bindingApps, extra...)\n\t}\n\ttk.Mark(\"sca+pkg\")\n\t// Binding labeling: incremental (reuse unchanged modules' cached labels) when caching is\n\t// on, else a full pass. Both produce identical labels — binding precedence is per-node.\n\tif incremental {\n\t\trelabel, err := bindings.ApplyIncremental(g, bindingApps, ModuleHashes(prog), deps, cache)\n\t\tif err != nil {\n\t\t\treturn nil, stats, err\n\t\t}\n\t\t// Graph DB change-feed: collect the label rows of every label-dirty module. Label-dirty\n\t\t// is the binding relabel set plus the lowering fresh set (a fresh module's labels may also\n\t\t// have changed; re-emitting unchanged ones is an idempotent upsert). Nodes come from the\n\t\t// same pass (fresh set); edges were collected creator-attributed during lowering.\n\t\tif opts.Sync != nil {\n\t\t\tlabelDirty := map[string]bool{}\n\t\t\tfor ns := range fresh {\n\t\t\t\tlabelDirty[ns] = true\n\t\t\t}\n\t\t\tfor ns := range relabel {\n\t\t\t\tlabelDirty[ns] = true\n\t\t\t}\n\t\t\tfor ns := range labelDirty {\n\t\t\t\topts.Sync.MarkRelabel(ns)\n\t\t\t}\n\t\t\tif err := opts.Sync.CollectGraph(g, labelDirty); err != nil {\n\t\t\t\treturn nil, stats, err\n\t\t\t}\n\t\t}\n\t} else if _, _, err := bindings.Apply(g, bindingApps, nil); err != nil {\n\t\treturn nil, stats, err\n\t}\n\ttk.Mark(\"bindings\")\n\tusg.Freeze(g)\n\treturn g, stats, nil\n}\n\n// ModuleHashes maps each content-addressed module's namespace (lowering.ModuleNS) to its\n// content hash, the per-module identity the incremental binding-label cache keys on. Modules\n// without a Hash (native frontends) are omitted, so they are always relabeled.\nfunc ModuleHashes(prog nir.Program) map[string]string {\n\tm := map[string]string{}\n\tfor _, mod := range prog.Modules {\n\t\tif mod.Hash != \"\" {\n\t\t\tm[lowering.ModuleNS(mod)] = mod.Hash\n\t\t}\n\t}\n\treturn m\n}\n","numLines":177,"startLine":1,"totalLines":177}}}
