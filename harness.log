{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_0e1252c8298d4e06b3ecfaf0","type":"tool_result","content":"1\tpackage usg\n2\t\n3\timport (\n4\t\t\"encoding/binary\"\n5\t\t\"os\"\n6\t\t\"sync\"\n7\t\n8\t\tbadger \"github.com/dgraph-io/badger/v4\"\n9\t)\n10\t\n11\t// BadgerGraph makes BadgerDB the source of truth for the analysis graph, with RAM bounded by\n12\t// Badger's block/value cache (sized to the user's --max-ram). When RAM is ample the graph is\n13\t// fully cached → ~in-memory speed; when it's tight, cold data pages from disk → bounded RAM.\n14\t//\n15\t// Records are compact binary (no JSON/gob reflection) and INT-INDEXED — nodes are referenced by\n16\t// a dense int32, so the taint hot loop (via usg.IntGraph) reads cached int adjacency blobs with\n17\t// near-zero decode. String ids and payload are fetched only when emitting findings or matching\n18\t// bindings. Key layout (\\x00 separator, \"g\" graph namespace to coexist with the parse cache):\n19\t//\n20\t//\tgI\\0<id>          -> int32                 intern: id -> index\n21\t//\tgx\\0<idx>         -> id string             reverse: index -> id\n22\t//\tgn\\0<idx>         -> node detail blob       type/loc/region/order/scope/props\n23\t//\tgo\\0<idx>         -> out-adjacency blob     []{typeId, dstIdx[, props]}\n24\t//\tgr\\0<idx>         -> in-adjacency blob      (only inIndexedTypes)\n25\t//\tgl\\0<idx>         -> labels blob\n26\t//\tgc\\0<concept>     -> []int32 (nodes w/ concept)\n27\t//\tgt\\0<type>        -> []int32 (nodes of type)\n28\t//\n29\t// NOTE: this is the correctness foundation (build accumulates adjacency/labels in RAM, flushed to\n30\t// badger on Finalize). Streaming the build to bound PEAK RAM, and the make-default wiring, are\n31\t// the follow-on steps. Reads after Finalize are served from badger (cache-bounded).\n32\ttype BadgerGraph struct {\n33\t\tdb     *badger.DB\n34\t\towned  bool   // we opened db and must close it\n35\t\townDir string // a directory this graph created and removes on Close\n36\t\n37\t\tmu sync.Mutex\n38\t\n39\t\t// epoch stamps structural mutations so binding application can share one node index per\n40\t\t// pass. Omitting it did not fail loudly: bindings.storeIndexes type-asserts for the method\n41\t\t// and, not finding it, returned a FRESH empty index on every call -- so every applicator\n42\t\t// rebuilt its flag/flow/gram index from scratch, in the mode chosen precisely because\n43\t\t// resources were tight. See usg/epoch.go.\n44\t\tepoch uint64\n45\t\n46\t\t// Resident structural core (int-indexed). Node DETAIL (loc/region/props/type) is NOT kept\n47\t\t// here — it is streamed to badger so peak RAM is bounded by the core + a small write buffer +\n48\t\t// badger's cache, not the full payload.\n49\t\tidx           map[string]int32\n50\t\tids           []string\n51\t\ttyps          []string // node type by index; resident because AddNode consults it per call\n52\t\tout           [][]iedge\n53\t\tin            map[int32][]iedge\n54\t\tflowOut       [][]int32\n55\t\tflowIn        [][]int32\n56\t\tflowOutPacked packedAdj\n57\t\tflowInPacked  packedAdj\n58\t\tlabels        [][]Label\n59\t\tlabelsPacked  packedLabels\n60\t\tbyType        map[string][]int32\n61\t\tbyConcept     map[string][]int32\n62\t\tconceptHas    map[string]map[int32]bool\n63\t\n64\t\t// write-back buffer for node detail, held as STRUCTS so resident reads share the stored\n65\t\t// strings and props map instead of decoding a blob per read — encoding happens once, at\n66\t\t// spill time. detCap == 0 means UNBOUNDED (no RAM ceiling): detail stays in RAM and is\n67\t\t// never written to badger, so the build pays no write or codec cost at all. With a\n68\t\t// ceiling, detCap bounds the buffer and detail spills to badger when full, so RAM stays\n69\t\t// under budget (cold detail pages from disk).\n70\t\tdet        map[int32]nodeDetail\n71\t\tdetBytes   int   // approx bytes buffered (for the byte-accurate spill threshold)\n72\t\tdetCapByte int64 // spill when detBytes exceeds this (0 = unbounded)\n73\t}\n74\t\n75\ttype nodeDetail struct {\n76\t\ttyp, loc, region, scope string\n77\t\t// The hottest match-path properties, carried inline on Node rather than in Props. They must\n78\t\t// round-trip: dropping them made Node.Prop(\"method\") return \"\" here but not in IntStore, so\n79\t\t// --max-ram silently changed which bindings matched and therefore which findings appeared.\n80\t\tmethod, calleePath, strArgs, vkind string\n81\t\torder                              int32\n82\t\thasOrder                           bool\n83\t\tprops                              map[string]string\n84\t}\n85\t\n86\t// OpenBadgerGraphUnder opens a graph in a directory of its own beneath base, and removes that\n87\t// directory when the graph is closed.\n88\t//\n89\t// Badger holds a lock on its directory, so two graphs opened at one path cannot both exist: the\n90\t// second falls back to the in-RAM store, which is the whole graph resident — the opposite of\n91\t// what a memory ceiling asked for, and silent. A scan that builds one graph per partition opens\n92\t// several in turn, so each needs its own directory and each needs it gone once its partition is\n93\t// scanned.\n94\tfunc OpenBadgerGraphUnder(base string, cacheBytes, detailBufBytes int64) (*BadgerGraph, error) {\n95\t\tdir, err := os.MkdirTemp(base, \"g-\")\n96\t\tif err != nil {\n97\t\t\treturn nil, err\n98\t\t}\n99\t\tg, err := OpenBadgerGraph(dir, cacheBytes, detailBufBytes)\n100\t\tif err != nil {\n101\t\t\t_ = os.RemoveAll(dir)\n102\t\t\treturn nil, err\n103\t\t}\n104\t\tg.ownDir = dir\n105\t\treturn g, nil\n106\t}\n107\t\n108\t// OpenBadgerGraph opens a graph store at path (\":memory:\" for an in-memory Badger) with a cache\n109\t// budget in bytes (block + value cache; 0 = Badger defaults).\n110\tfunc OpenBadgerGraph(path string, cacheBytes, detailBufBytes int64) (*BadgerGraph, error) {\n111\t\tvar opts badger.Options\n112\t\tif path == \":memory:\" {\n113\t\t\topts = badger.DefaultOptions(\"\").WithInMemory(true)\n114\t\t} else {\n115\t\t\topts = badger.DefaultOptions(path)\n116\t\t}\n117\t\tmemTableSize := int64(32 << 20)\n118\t\tif cacheBytes > 0 && cacheBytes/2 < memTableSize {\n119\t\t\t// Badger's own max batch size is a fraction of the memtable arena, and must stay\n120\t\t\t// above its ValueThreshold (1MiB by default) or Open refuses outright -- so this\n121\t\t\t// floor cannot chase the cache budget all the way down to it.\n122\t\t\tmemTableSize = clampInt64(cacheBytes/2, 16<<20, memTableSize)\n123\t\t}\n124\t\topts = opts.WithLogger(nil).\n125\t\t\tWithSyncWrites(false).    // a scan-scoped graph: durability not needed, speed is\n126\t\t\tWithCompression(0).       // skip per-block (de)compression CPU\n127\t\t\tWithNumVersionsToKeep(1). // no MVCC history\n128\t\t\t// The memtable arena is an eager Go-heap allocation, paid once per graph the moment\n129\t\t\t// it opens. A scan bounded to a small partition budget opens many of these in turn\n130\t\t\t// (one per partition), so a flat 32MiB here taxes every partition regardless of how\n131\t\t\t// little it holds -- scaling it down with the cache budget keeps that tax\n132\t\t\t// proportionate instead of dominating a tight -max-ram ceiling.\n133\t\t\tWithMemTableSize(memTableSize).\n134\t\t\tWithDetectConflicts(false)\n135\t\tif cacheBytes > 0 {\n136\t\t\t// The whole cache budget goes to the block cache. The index cache is only\n137\t\t\t// consulted for encrypted DBs; funding it here spends budget on a cache\n138\t\t\t// that is never populated.\n139\t\t\topts = opts.WithBlockCacheSize(cacheBytes).WithIndexCacheSize(0)\n140\t\t}\n141\t\tdb, err := badger.Open(opts)\n142\t\tif err != nil {\n143\t\t\treturn nil, err\n144\t\t}\n145\t\tg := NewBadgerGraphDB(db, true)\n146\t\tg.detCapByte = detailBufBytes // 0 = unbounded; else spill detail to badger past this many bytes\n147\t\treturn g, nil\n148\t}\n149\t\n150\tfunc clampInt64(want, lo, hi int64) int64 {\n151\t\tif want < lo {\n152\t\t\treturn lo\n153\t\t}\n154\t\tif want > hi {\n155\t\t\treturn hi\n156\t\t}\n157\t\treturn want\n158\t}\n159\t\n160\t// NewBadgerGraphDB wraps an existing *badger.DB (e.g. the shared parse cache db) as a graph store.\n161\tfunc NewBadgerGraphDB(db *badger.DB, owned bool) *BadgerGraph {\n162\t\treturn &BadgerGraph{\n163\t\t\tdb: db, owned: owned,\n164\t\t\tidx: map[string]int32{}, in: map[int32][]iedge{},\n165\t\t\tbyType: map[string][]int32{}, byConcept: map[string][]int32{},\n166\t\t\tconceptHas: map[string]map[int32]bool{}, det: map[int32]nodeDetail{},\n167\t\t}\n168\t}\n169\t\n170\tfunc (g *BadgerGraph) intern(id string) int32 {\n171\t\tif i, ok := g.idx[id]; ok {\n172\t\t\treturn i\n173\t\t}\n174\t\tg.thawFlows()\n175\t\tg.thawLabels()\n176\t\ti := int32(len(g.ids))\n177\t\tg.idx[id] = i\n178\t\tg.ids = append(g.ids, id)\n179\t\tg.typs = append(g.typs, \"\")\n180\t\tg.out = append(g.out, nil)\n181\t\tg.flowOut = append(g.flowOut, nil)\n182\t\tg.flowIn = append(g.flowIn, nil)\n183\t\tg.labels = append(g.labels, nil)\n184\t\treturn i\n185\t}\n186\t\n187\t// Freeze packs the dominant flow adjacency after graph construction. Badger owns cold node\n188\t// detail; CSR keeps the structural hot set small enough that the collector has useful headroom.\n189\tfunc (g *BadgerGraph) Freeze() {\n190\t\tg.mu.Lock()\n191\t\tdefer g.mu.Unlock()\n192\t\tif g.flowOutPacked.offsets != nil {\n193\t\t\treturn\n194\t\t}\n195\t\tout, okOut := packAdj(g.flowOut)\n196\t\tin, okIn := packAdj(g.flowIn)\n197\t\tlabels, okLabels := packLabelRows(g.labels)\n198\t\tif !okOut || !okIn || !okLabels {\n199\t\t\treturn\n200\t\t}\n201\t\tg.flowOutPacked, g.flowInPacked = out, in\n202\t\tg.labelsPacked = labels\n203\t\tg.flowOut, g.flowIn = nil, nil\n204\t\tg.labels = nil\n205\t\tg.conceptHas = nil\n206\t}\n207\t\n208\t// Caller holds g.mu whenever this can race with a writer.\n209\tfunc (g *BadgerGraph) thawFlows() {\n210\t\tif g.flowOutPacked.offsets == nil {\n211\t\t\treturn\n212\t\t}\n213\t\tg.flowOut, g.flowIn = g.flowOutPacked.unpack(), g.flowInPacked.unpack()\n214\t\tg.flowOutPacked, g.flowInPacked = packedAdj{}, packedAdj{}\n215\t}\n216\t\n217\tfunc (g *BadgerGraph) thawLabels() {\n218\t\tif g.labelsPacked.offsets == nil {\n219\t\t\treturn\n220\t\t}\n221\t\tg.labels = g.labelsPacked.unpack()\n222\t\tg.labelsPacked = packedLabels{}\n223\t}\n224\t\n225\tfunc (g *BadgerGraph) labelsAt(i int32) []Label {\n226\t\tif g.labelsPacked.offsets != nil {\n227\t\t\treturn g.labelsPacked.at(i)\n228\t\t}\n229\t\treturn g.labels[i]\n230\t}\n231\t\n232\tfunc (g *BadgerGraph) conceptSeen(concept string) map[int32]bool {\n233\t\tif g.conceptHas == nil {\n234\t\t\tg.conceptHas = map[string]map[int32]bool{}\n235\t\t}\n236\t\tseen := g.conceptHas[concept]\n237\t\tif seen == nil {\n238\t\t\tseen = make(map[int32]bool, len(g.byConcept[concept])+1)\n239\t\t\tfor _, i := range g.byConcept[concept] {\n240\t\t\t\tseen[i] = true\n241\t\t\t}\n242\t\t\tg.conceptHas[concept] = seen\n243\t\t}\n244\t\treturn seen\n245\t}\n246\t\n247\tfunc (g *BadgerGraph) flowOutAt(i int32) []int32 {\n248\t\tif g.flowOutPacked.offsets != nil {\n249\t\t\treturn g.flowOutPacked.at(i)\n250\t\t}\n251\t\treturn g.flowOut[i]\n252\t}\n253\t\n254\tfunc (g *BadgerGraph) flowInAt(i int32) []int32 {\n255\t\tif g.flowInPacked.offsets != nil {\n256\t\t\treturn g.flowInPacked.at(i)\n257\t\t}\n258\t\treturn g.flowIn[i]\n259\t}\n260\t\n261\t// typeOf returns a node's type from the resident core. AddNode consults it on\n262\t// every call, so it must never cost a badger read once detail has spilled.\n263\tfunc (g *BadgerGraph) typeOf(i int32) string {\n264\t\tif int(i) < len(g.typs) {\n265\t\t\treturn g.typs[i]\n266\t\t}\n267\t\treturn \"\"\n268\t}\n269\t\n270\t// StructEpoch reports the store's structural epoch. See usg/epoch.go.\n271\tfunc (g *BadgerGraph) StructEpoch() uint64 {\n272\t\tg.mu.Lock()\n273\t\tdefer g.mu.Unlock()\n274\t\treturn g.epoch\n275\t}\n276\t\n277\tfunc (g *BadgerGraph) AddNode(n Node) error {\n278\t\tg.mu.Lock()\n279\t\tdefer g.mu.Unlock()\n280\t\tg.epoch = nextStructEpoch()\n281\t\ti, existed := g.idx[n.ID]\n282\t\tif !existed {\n283\t\t\ti = g.intern(n.ID)\n284\t\t}\n285\t\tif t := g.typeOf(i); t != n.Type {\n286\t\t\tif existed && t != \"\" {\n287\t\t\t\tremoveIdx(g.byType, t, i)\n288\t\t\t}\n289\t\t\tg.byType[n.Type] = append(g.byType[n.Type], i)\n290\t\t}\n291\t\tg.typs[i] = n.Type\n292\t\td := nodeDetail{typ: n.Type, loc: n.Loc, region: n.Region, scope: n.Scope,\n293\t\t\tmethod: n.Method, calleePath: n.CalleePath, strArgs: n.StrArgs, vkind: n.Vkind,\n294\t\t\torder: n.Order, hasOrder: n.HasOrder, props: n.Props}\n295\t\t// Same normalization as IntStore.AddNode: an explicit props entry wins over the inline field,\n296\t\t// so a producer may set either and both stores agree.\n297\t\tif n.Props != nil {\n298\t\t\tif v, ok := n.Props[\"method\"]; ok {\n299\t\t\t\td.method = v\n300\t\t\t}\n301\t\t\tif v, ok := n.Props[\"callee_path\"]; ok {\n302\t\t\t\td.calleePath = v\n303\t\t\t}\n304\t\t\tif v, ok := n.Props[\"str_args\"]; ok {\n305\t\t\t\td.strArgs = v\n306\t\t\t}\n307\t\t\tif v, ok := n.Props[\"vkind\"]; ok {\n308\t\t\t\td.vkind = v\n309\t\t\t}\n310\t\t}\n311\t\tif old, ok := g.det[i]; ok {\n312\t\t\tg.detBytes -= estDetBytes(old)\n313\t\t}\n314\t\tg.det[i] = d\n315\t\tg.detBytes += estDetBytes(d)\n316\t\tif g.detCapByte > 0 && int64(g.detBytes) >= g.detCapByte {\n317\t\t\tg.flushDet() // ceiling set: spill to badger to bound RAM\n318\t\t}\n319\t\treturn nil\n320\t}\n321\t\n322\tfunc (g *BadgerGraph) AddEdge(e Edge) error {\n323\t\tg.mu.Lock()\n324\t\tdefer g.mu.Unlock()\n325\t\tg.epoch = nextStructEpoch()\n326\t\tsi, di := g.intern(e.Src), g.intern(e.Dst)\n327\t\ttyp := edgeTypeIDFor(e.Type)\n328\t\tif typ == edgeTypeFlows && len(e.Props) == 0 {\n329\t\t\tg.thawFlows()\n330\t\t\tg.flowOut[si] = append(g.flowOut[si], di)\n331\t\t\tg.flowIn[di] = append(g.flowIn[di], si)\n332\t\t\treturn nil\n333\t\t}\n334\t\tg.out[si] = append(g.out[si], iedge{typ: typ, dst: di, props: e.Props})\n335\t\tif edgeTypeInIndexed(typ) {\n336\t\t\tg.in[di] = append(g.in[di], iedge{typ: typ, dst: si, props: e.Props})\n337\t\t}\n338\t\treturn nil\n339\t}\n340\t\n341\t// AddFlowEdgeIfPresent appends a prop-less FLOWS edge only when both endpoints already exist.\n342\tfunc (g *BadgerGraph) AddFlowEdgeIfPresent(src, dst string) bool {\n343\t\tg.mu.Lock()\n344\t\tdefer g.mu.Unlock()\n345\t\tsi, ok := g.idx[src]\n346\t\tif !ok {\n347\t\t\treturn false\n348\t\t}\n349\t\tdi, ok := g.idx[dst]\n350\t\tif !ok {\n351\t\t\treturn false\n352\t\t}\n353\t\tg.thawFlows()\n354\t\tg.epoch = nextStructEpoch()\n355\t\tg.flowOut[si] = append(g.flowOut[si], di)\n356\t\tg.flowIn[di] = append(g.flowIn[di], si)\n357\t\treturn true\n358\t}\n359\t\n360\tfunc (g *BadgerGraph) AddLabel(nodeID string, l Label) error {\n361\t\tg.mu.Lock()\n362\t\tdefer g.mu.Unlock()\n363\t\ti := g.intern(nodeID)\n364\t\tg.thawLabels()\n365\t\tg.labels[i] = append(g.labels[i], l)\n366\t\tseen := g.conceptSeen(l.Concept)\n367\t\tif !seen[i] {\n368\t\t\tseen[i] = true\n369\t\t\tg.byConcept[l.Concept] = append(g.byConcept[l.Concept], i)\n370\t\t}\n371\t\treturn nil\n372\t}\n373\t\n374\tfunc removeIdx(m map[string][]int32, k string, i int32) {\n375\t\ts := m[k]\n376\t\tfor j, v := range s {\n377\t\t\tif v == i {\n378\t\t\t\tm[k] = append(s[:j], s[j+1:]...)\n379\t\t\t\treturn\n380\t\t\t}\n381\t\t}\n382\t}\n383\t\n384\t// --- read API: served from RAM accumulators (pre-Finalize) ----------------------------------\n385\t// (post-Finalize disk reads land in a follow-on step; the accumulators stay valid until then.)\n386\t\n387\tfunc (g *BadgerGraph) idxOf(id string) (int32, bool) { i, ok := g.idx[id]; return i, ok }\n388\t\n389\t// estDetBytes approximates a detail's resident cost — string bytes plus struct and\n390\t// map-slot overhead — so the spill threshold keeps meaning \"about this many bytes\n391\t// buffered\" without encoding anything to find out.\n392\tfunc estDetBytes(d nodeDetail) int {\n393\t\tn := len(d.typ) + len(d.loc) + len(d.region) + len(d.scope) +\n394\t\t\tlen(d.method) + len(d.calleePath) + len(d.strArgs) + len(d.vkind) + 96\n395\t\tfor k, v := range d.props {\n396\t\t\tn += len(k) + len(v) + 48\n397\t\t}\n398\t\treturn n\n399\t}\n400\t\n401\t// rawDet returns a node's encoded detail from badger (cache-served). Resident detail\n402\t// lives as structs in g.det and never takes this path.\n403\tfunc (g *BadgerGraph) rawDet(i int32) []byte {\n404\t\tvar out []byte\n405\t\t_ = g.db.View(func(txn *badger.Txn) error {\n406\t\t\titem, err := txn.Get(detKey(i))\n407\t\t\tif err != nil {\n408\t\t\t\treturn err\n409\t\t\t}\n410\t\t\tout, err = item.ValueCopy(nil)\n411\t\t\treturn err\n412\t\t})\n413\t\treturn out\n414\t}\n415\t\n416\tfunc (g *BadgerGraph) nodeAt(i int32) Node {\n417\t\td, ok := g.det[i]\n418\t\tif !ok {\n419\t\t\td = decDet(g.rawDet(i))\n420\t\t}\n421\t\treturn g.nodeFromDetail(i, d)\n422\t}\n423\t\n424\tfunc (g *BadgerGraph) nodeFromDetail(i int32, d nodeDetail) Node {\n425\t\treturn Node{ID: g.ids[i], Type: d.typ, Loc: d.loc, Region: d.region, Order: d.order,\n426\t\t\tHasOrder: d.hasOrder, Scope: d.scope, Props: d.props,\n427\t\t\tMethod: d.method, CalleePath: d.calleePath, StrArgs: d.strArgs, Vkind: d.vkind}\n428\t}\n429\t\n430\t// flushDet writes the buffered node details to badger in one transaction and clears the buffer,\n431\t// bounding RAM to the structural core + ~detBufMax buffered blobs + badger's cache.\n432\tfunc (g *BadgerGraph) flushDet() {\n433\t\tif len(g.det) == 0 {\n434\t\t\treturn\n435\t\t}\n436\t\twb := g.db.NewWriteBatch()\n437\t\tfor i, d := range g.det {\n438\t\t\t_ = wb.Set(detKey(i), encDet(d))\n439\t\t}\n440\t\t_ = wb.Flush()\n441\t\tg.det = map[int32]nodeDetail{}\n442\t\tg.detBytes = 0\n443\t}\n444\t\n445\tfunc detKey(i int32) []byte {\n446\t\tb := make([]byte, 6)\n447\t\tb[0], b[1] = 'g', 'n'\n448\t\tbinary.BigEndian.PutUint32(b[2:], uint32(i))\n449\t\treturn b\n450\t}\n451\t\n452\t// Has reports whether a node id exists, without decoding its detail (existence-only fast path for\n453\t// the lowerer's flow() checks, so the build never reads detail back from disk).\n454\tfunc (g *BadgerGraph) Has(id string) bool { _, ok := g.idx[id]; return ok }\n455\t\n456\tfunc (g *BadgerGraph) GetNode(id string) (Node, bool, error) {\n457\t\ti, ok := g.idxOf(id)\n458\t\tif !ok {\n459\t\t\treturn Node{}, false, nil\n460\t\t}\n461\t\treturn g.nodeAt(i), true, nil\n462\t}\n463\t\n464\tfunc (g *BadgerGraph) OutEdges(src, edgeType string) ([]Edge, error) {\n465\t\ti, ok := g.idxOf(src)\n466\t\tif !ok {\n467\t\t\treturn nil, nil\n468\t\t}\n469\t\tvar out []Edge\n470\t\tif edgeTypeMatches(edgeTypeFlows, edgeType) {\n471\t\t\tfor _, dst := range g.flowOutAt(i) {\n472\t\t\t\tout = append(out, Edge{Type: \"FLOWS\", Src: src, Dst: g.ids[dst]})\n473\t\t\t}\n474\t\t}\n475\t\tfor _, e := range g.out[i] {\n476\t\t\tif edgeTypeMatches(e.typ, edgeType) {\n477\t\t\t\tout = append(out, Edge{Type: edgeTypeName(e.typ), Src: src, Dst: g.ids[e.dst], Props: e.props})\n478\t\t\t}\n479\t\t}\n480\t\treturn out, nil\n481\t}\n482\t\n483\tfunc (g *BadgerGraph) InEdges(dst, edgeType string) ([]Edge, error) {\n484\t\ti, ok := g.idxOf(dst)\n485\t\tif !ok {\n486\t\t\treturn nil, nil\n487\t\t}\n488\t\tvar out []Edge\n489\t\tif edgeTypeMatches(edgeTypeFlows, edgeType) {\n490\t\t\tfor _, src := range g.flowInAt(i) {\n491\t\t\t\tout = append(out, Edge{Type: \"FLOWS\", Src: g.ids[src], Dst: dst})\n492\t\t\t}\n493\t\t}\n494\t\tfor _, e := range g.in[i] {\n495\t\t\tif edgeTypeMatches(e.typ, edgeType) {\n496\t\t\t\tout = append(out, Edge{Type: edgeTypeName(e.typ), Src: g.ids[e.dst], Dst: dst, Props: e.props})\n497\t\t\t}\n498\t\t}\n499\t\treturn out, nil\n500\t}\n501\t\n502\tfunc (g *BadgerGraph) RangeInEdges(dst, edgeType string, fn func(src string) bool) {\n503\t\ti, ok := g.idxOf(dst)\n504\t\tif !ok {\n505\t\t\treturn\n506\t\t}\n507\t\tif edgeTypeMatches(edgeTypeFlows, edgeType) {\n508\t\t\tfor _, src := range g.flowInAt(i) {\n509\t\t\t\tif !fn(g.ids[src]) {\n510\t\t\t\t\treturn\n511\t\t\t\t}\n512\t\t\t}\n513\t\t}\n514\t\tfor _, e := range g.in[i] {\n515\t\t\tif edgeTypeMatches(e.typ, edgeType) {\n516\t\t\t\tif !fn(g.ids[e.dst]) {\n517\t\t\t\t\treturn\n518\t\t\t\t}\n519\t\t\t}\n520\t\t}\n521\t}\n522\t\n523\tfunc (g *BadgerGraph) NodesWithConcept(concept string) ([]string, error) {\n524\t\treturn g.idsOf(g.byConcept[concept]), nil\n525\t}\n526\tfunc (g *BadgerGraph) NodesOfType(nodeType string) ([]string, error) {\n527\t\treturn g.idsOf(g.byType[nodeType]), nil\n528\t}\n529\t\n530\t// TypeNodeIndexes returns the store-owned dense indexes for a node type.\n531\t// Callers must treat the returned slice as read-only.\n532\tfunc (g *BadgerGraph) TypeNodeIndexes(nodeType string) []int32 {\n533\t\treturn g.byType[nodeType]\n534\t}\n535\t\n536\t// NodeAtIndex reads one node without converting its dense index through the\n537\t// string-id map. Binding matching retains these indexes, so the disk-backed\n538\t// path should not pay an id hash lookup for every candidate and predicate.\n539\tfunc (g *BadgerGraph) NodeAtIndex(i int32) (Node, bool) {\n540\t\tif i < 0 || int(i) >= len(g.ids) {\n541\t\t\treturn Node{}, false\n542\t\t}\n543\t\treturn g.nodeAt(i), true\n544\t}\n545\t\n546\tfunc (g *BadgerGraph) RangeNodesOfType(nodeType string, fn func(Node) bool) {\n547\t\tfor _, i := range g.byType[nodeType] {\n548\t\t\tif !fn(g.nodeAt(i)) {\n549\t\t\t\treturn\n550\t\t\t}\n551\t\t}\n552\t}\n553\t\n554\tfunc (g *BadgerGraph) idsOf(idxs []int32) []string {\n555\t\tout := make([]string, len(idxs))\n556\t\tfor k, i := range idxs {\n557\t\t\tout[k] = g.ids[i]\n558\t\t}\n559\t\treturn out\n560\t}\n561\t\n562\tfunc (g *BadgerGraph) AllNodes() ([]Node, error) {\n563\t\tout := make([]Node, 0, len(g.ids))\n564\t\tg.RangeNodes(func(n Node) bool { out = append(out, n); return true })\n565\t\treturn out, nil\n566\t}\n567\t\n568\tfunc (g *BadgerGraph) Labels(nodeID string) ([]Label, error) {\n569\t\ti, ok := g.idxOf(nodeID)\n570\t\tif !ok {\n571\t\t\treturn nil, nil\n572\t\t}\n573\t\treturn g.labelsAt(i), nil\n574\t}\n575\t\n576\tfunc (g *BadgerGraph) Close() error {\n577\t\tg.flushDet()\n578\t\tvar err error\n579\t\tif g.owned {\n580\t\t\terr = g.db.Close()\n581\t\t}\n582\t\tif g.ownDir != \"\" {\n583\t\t\t_ = os.RemoveAll(g.ownDir)\n584\t\t\tg.ownDir = \"\"\n585\t\t}\n586\t\treturn err\n587\t}\n588\t\n589\t// --- node-detail binary codec ---------------------------------------------------------------\n590\t\n591\ttype detWriter struct{ b []byte }\n592\t\n593\tfunc (w *detWriter) u(n int) {\n594\t\tfor n >= 0x80 {\n595\t\t\tw.b = append(w.b, byte(n)|0x80)\n596\t\t\tn >>= 7\n597\t\t}\n598\t\tw.b = append(w.b, byte(n))\n599\t}\n600\tfunc (w *detWriter) str(s string) { w.u(len(s)); w.b = append(w.b, s...) }\n601\tfunc (w *detWriter) boolean(v bool) {\n602\t\tif v {\n603\t\t\tw.b = append(w.b, 1)\n604\t\t} else {\n605\t\t\tw.b = append(w.b, 0)\n606\t\t}\n607\t}\n608\t\n609\ttype detReader struct {\n610\t\tb []byte\n611\t\ti int\n612\t}\n613\t\n614\tfunc (r *detReader) u() int {\n615\t\tvar x int\n616\t\tvar s uint\n617\t\tfor {\n618\t\t\tc := r.b[r.i]\n619\t\t\tr.i++\n620\t\t\tx |= int(c&0x7f) << s\n621\t\t\tif c < 0x80 {\n622\t\t\t\treturn x\n623\t\t\t}\n624\t\t\ts += 7\n625\t\t}\n626\t}\n627\tfunc (r *detReader) str() string {\n628\t\tif r.i >= len(r.b) {\n629\t\t\treturn \"\"\n630\t\t}\n631\t\tn := r.u()\n632\t\ts := string(r.b[r.i : r.i+n])\n633\t\tr.i += n\n634\t\treturn s\n635\t}\n636\tfunc (r *detReader) boolean() bool { v := r.b[r.i] == 1; r.i++; return v }\n637\t\n638\t// encDet writes type first (so typeOf can read it cheaply), then the rest of the payload.\n639\tfunc encDet(d nodeDetail) []byte {\n640\t\tw := &detWriter{}\n641\t\tw.str(d.typ)\n642\t\tw.str(d.loc)\n643\t\tw.str(d.region)\n644\t\tw.str(d.scope)\n645\t\tw.str(d.method)\n646\t\tw.str(d.calleePath)\n647\t\tw.str(d.strArgs)\n648\t\tw.str(d.vkind)\n649\t\tw.u(int(uint32(d.order)))\n650\t\tw.boolean(d.hasOrder)\n651\t\tw.u(len(d.props))\n652\t\tfor k, v := range d.props {\n653\t\t\tw.str(k)\n654\t\t\tw.str(v)\n655\t\t}\n656\t\treturn w.b\n657\t}\n658\t\n659\tfunc decDet(b []byte) nodeDetail {\n660\t\tif len(b) == 0 {\n661\t\t\treturn nodeDetail{}\n662\t\t}\n663\t\tr := &detReader{b: b}\n664\t\td := nodeDetail{typ: r.str(), loc: r.str(), region: r.str(), scope: r.str()}\n665\t\td.method, d.calleePath, d.strArgs, d.vkind = r.str(), r.str(), r.str(), r.str()\n666\t\td.order = int32(uint32(r.u()))\n667\t\td.hasOrder = r.boolean()\n668\t\tif n := r.u(); n > 0 {\n669\t\t\td.props = make(map[string]string, n)\n670\t\t\tfor j := 0; j < n; j++ {\n671\t\t\t\tk := r.str()\n672\t\t\t\td.props[k] = r.str()\n673\t\t\t}\n674\t\t}\n675\t\treturn d\n676\t}\n677\t\n678\t// --- IntGraph fast path ---------------------------------------------------------------------\n679\t\n680\t// Asserted, not assumed: solvers.FindTaintFlows dispatches on this interface and\n681\t// silently falls back to its string-keyed implementation for a store that does not\n682\t// satisfy it. The answers stay the same, but the hot loop starts touching string ids\n683\t// and payload — which is the whole cost this store exists to avoid — so losing\n684\t// conformance would surface only as an unexplained slowdown on large scans.\n685\tvar _ IntGraph = (*BadgerGraph)(nil)\n686\t\n687\tfunc (g *BadgerGraph) NodeCount() int                      { return len(g.ids) }\n688\tfunc (g *BadgerGraph) ConceptNodes(concept string) []int32 { return g.byConcept[concept] }\n689\tfunc (g *BadgerGraph) LabelsAt(idx int32) []Label {\n690\t\tif idx < 0 || int(idx) >= len(g.ids) {\n691\t\t\treturn nil\n692\t\t}\n693\t\treturn g.labelsAt(idx)\n694\t}\n695\tfunc (g *BadgerGraph) NodeID(idx int32) string           { return g.ids[idx] }\n696\tfunc (g *BadgerGraph) NodeIndex(id string) (int32, bool) { return g.idxOf(id) }\n697\tfunc (g *BadgerGraph) LabelsOf(nodeID string) []Label    { l, _ := g.Labels(nodeID); return l }\n698\t\n699\tfunc (g *BadgerGraph) RangeOut(src int32, edgeType string, fn func(dst int32) bool) {\n700\t\tif int(src) >= len(g.out) {\n701\t\t\treturn\n702\t\t}\n703\t\tif edgeTypeMatches(edgeTypeFlows, edgeType) {\n704\t\t\tfor _, dst := range g.flowOutAt(src) {\n705\t\t\t\tif !fn(dst) {\n706\t\t\t\t\treturn\n707\t\t\t\t}\n708\t\t\t}\n709\t\t}\n710\t\tfor _, e := range g.out[src] {\n711\t\t\tif edgeTypeMatches(e.typ, edgeType) {\n712\t\t\t\tif !fn(e.dst) {\n713\t\t\t\t\treturn\n714\t\t\t\t}\n715\t\t\t}\n716\t\t}\n717\t}\n718\t\n719\tfunc (g *BadgerGraph) RangeOutEdges(src, edgeType string, fn func(dst string) bool) {\n720\t\ti, ok := g.idxOf(src)\n721\t\tif !ok {\n722\t\t\treturn\n723\t\t}\n724\t\tif edgeTypeMatches(edgeTypeFlows, edgeType) {\n725\t\t\tfor _, dst := range g.flowOutAt(i) {\n726\t\t\t\tif !fn(g.ids[dst]) {\n727\t\t\t\t\treturn\n728\t\t\t\t}\n729\t\t\t}\n730\t\t}\n731\t\tfor _, e := range g.out[i] {\n732\t\t\tif edgeTypeMatches(e.typ, edgeType) {\n733\t\t\t\tif !fn(g.ids[e.dst]) {\n734\t\t\t\t\treturn\n735\t\t\t\t}\n736\t\t\t}\n737\t\t}\n738\t}\n739\t\n740\t// RangeNodes streams every node in stable dense-index order.\n741\tfunc (g *BadgerGraph) RangeNodes(fn func(Node) bool) {\n742\t\tg.RangeNodeIndexes(func(_ int32, n Node) bool { return fn(n) })\n743\t}\n744\t\n745\t// RangeNodeIndexes streams every dense index with its node. It flushes the\n746\t// detail buffer, then reads detail via a single SEQUENTIAL badger scan of the\n747\t// gn\\0 prefix rather than a random Get per node. The binding matcher builds its\n748\t// compact indexes through this path and keeps the int32 reference thereafter.\n749\tfunc (g *BadgerGraph) RangeNodeIndexes(fn func(int32, Node) bool) {\n750\t\temit := func(idx int32, d nodeDetail) bool {\n751\t\t\treturn fn(idx, g.nodeFromDetail(idx, d))\n752\t\t}\n753\t\tif len(g.det) == len(g.ids) { // everything resident → no badger scan, no decode\n754\t\t\tfor idx := range g.ids {\n755\t\t\t\ti := int32(idx)\n756\t\t\t\tif !emit(i, g.det[i]) {\n757\t\t\t\t\treturn\n758\t\t\t\t}\n759\t\t\t}\n760\t\t\treturn\n761\t\t}\n762\t\tnextResidentScan := int32(0)\n763\t\temitResidentBefore := func(limit int32) bool {\n764\t\t\tfor nextResidentScan < limit {\n765\t\t\t\tif d, ok := g.det[nextResidentScan]; ok {\n766\t\t\t\t\tif !emit(nextResidentScan, d) {\n767\t\t\t\t\t\treturn false\n768\t\t\t\t\t}\n769\t\t\t\t}\n770\t\t\t\tnextResidentScan++\n771\t\t\t}\n772\t\t\treturn true\n773\t\t}\n774\t\t// Spilled detail: one sequential prefix scan, merging any still-resident nodes.\n775\t\tpfx := []byte(\"gn\")\n776\t\tstop := false\n777\t\t_ = g.db.View(func(txn *badger.Txn) error {\n778\t\t\tit := txn.NewIterator(badger.DefaultIteratorOptions)\n779\t\t\tdefer it.Close()\n780\t\t\tfor it.Seek(pfx); it.ValidForPrefix(pfx); it.Next() {\n781\t\t\t\titem := it.Item()\n782\t\t\t\tk := item.Key()\n783\t\t\t\tif len(k) != 6 {\n784\t\t\t\t\tcontinue\n785\t\t\t\t}\n786\t\t\t\tidx := int32(binary.BigEndian.Uint32(k[2:]))\n787\t\t\t\tif idx < 0 || int(idx) >= len(g.ids) {\n788\t\t\t\t\tcontinue\n789\t\t\t\t}\n790\t\t\t\tif idx < nextResidentScan {\n791\t\t\t\t\tcontinue\n792\t\t\t\t}\n793\t\t\t\tif !emitResidentBefore(idx) {\n794\t\t\t\t\tstop = true\n795\t\t\t\t\treturn nil\n796\t\t\t\t}\n797\t\t\t\tif d, inRAM := g.det[idx]; inRAM {\n798\t\t\t\t\tnextResidentScan = idx + 1\n799\t\t\t\t\tif !emit(idx, d) {\n800\t\t\t\t\t\tstop = true\n801\t\t\t\t\t\treturn nil\n802\t\t\t\t\t}\n803\t\t\t\t\tcontinue\n804\t\t\t\t}\n805\t\t\t\tif err := item.Value(func(v []byte) error {\n806\t\t\t\t\tif !emit(idx, decDet(v)) {\n807\t\t\t\t\t\tstop = true\n808\t\t\t\t\t}\n809\t\t\t\t\tnextResidentScan = idx + 1\n810\t\t\t\t\treturn nil\n811\t\t\t\t}); err != nil {\n812\t\t\t\t\treturn err\n813\t\t\t\t}\n814\t\t\t\tif stop {\n815\t\t\t\t\treturn nil\n816\t\t\t\t}\n817\t\t\t}\n818\t\t\treturn nil\n819\t\t})\n820\t\tif stop {\n821\t\t\treturn\n822\t\t}\n823\t\tfor nextResidentScan < int32(len(g.ids)) {\n824\t\t\tif d, ok := g.det[nextResidentScan]; ok {\n825\t\t\t\tif !emit(nextResidentScan, d) {\n826\t\t\t\t\treturn\n827\t\t\t\t}\n828\t\t\t}\n829\t\t\tnextResidentScan++\n830\t\t}\n831\t}\n832\t"}]},"parent_tool_use_id":null,"session_id":"f1b7e732-1060-4c03-a560-f041798bec11","uuid":"f96813bd-087f-4b69-992b-92798ee687f6","timestamp":"2026-09-16T22:50:30.480Z","tool_use_result":{"type":"text","file":{"filePath":"/campaign/work/engine-the-engine-s-memory-safety-stop-ends-a-whole-repository-scan/internal/usg/badgergraph.go","content":"package usg\n\nimport (\n\t\"encoding/binary\"\n\t\"os\"\n\t\"sync\"\n\n\tbadger \"github.com/dgraph-io/badger/v4\"\n)\n\n// BadgerGraph makes BadgerDB the source of truth for the analysis graph, with RAM bounded by\n// Badger's block/value cache (sized to the user's --max-ram). When RAM is ample the graph is\n// fully cached → ~in-memory speed; when it's tight, cold data pages from disk → bounded RAM.\n//\n// Records are compact binary (no JSON/gob reflection) and INT-INDEXED — nodes are referenced by\n// a dense int32, so the taint hot loop (via usg.IntGraph) reads cached int adjacency blobs with\n// near-zero decode. String ids and payload are fetched only when emitting findings or matching\n// bindings. Key layout (\\x00 separator, \"g\" graph namespace to coexist with the parse cache):\n//\n//\tgI\\0<id>          -> int32                 intern: id -> index\n//\tgx\\0<idx>         -> id string             reverse: index -> id\n//\tgn\\0<idx>         -> node detail blob       type/loc/region/order/scope/props\n//\tgo\\0<idx>         -> out-adjacency blob     []{typeId, dstIdx[, props]}\n//\tgr\\0<idx>         -> in-adjacency blob      (only inIndexedTypes)\n//\tgl\\0<idx>         -> labels blob\n//\tgc\\0<concept>     -> []int32 (nodes w/ concept)\n//\tgt\\0<type>        -> []int32 (nodes of type)\n//\n// NOTE: this is the correctness foundation (build accumulates adjacency/labels in RAM, flushed to\n// badger on Finalize). Streaming the build to bound PEAK RAM, and the make-default wiring, are\n// the follow-on steps. Reads after Finalize are served from badger (cache-bounded).\ntype BadgerGraph struct {\n\tdb     *badger.DB\n\towned  bool   // we opened db and must close it\n\townDir string // a directory this graph created and removes on Close\n\n\tmu sync.Mutex\n\n\t// epoch stamps structural mutations so binding application can share one node index per\n\t// pass. Omitting it did not fail loudly: bindings.storeIndexes type-asserts for the method\n\t// and, not finding it, returned a FRESH empty index on every call -- so every applicator\n\t// rebuilt its flag/flow/gram index from scratch, in the mode chosen precisely because\n\t// resources were tight. See usg/epoch.go.\n\tepoch uint64\n\n\t// Resident structural core (int-indexed). Node DETAIL (loc/region/props/type) is NOT kept\n\t// here — it is streamed to badger so peak RAM is bounded by the core + a small write buffer +\n\t// badger's cache, not the full payload.\n\tidx           map[string]int32\n\tids           []string\n\ttyps          []string // node type by index; resident because AddNode consults it per call\n\tout           [][]iedge\n\tin            map[int32][]iedge\n\tflowOut       [][]int32\n\tflowIn        [][]int32\n\tflowOutPacked packedAdj\n\tflowInPacked  packedAdj\n\tlabels        [][]Label\n\tlabelsPacked  packedLabels\n\tbyType        map[string][]int32\n\tbyConcept     map[string][]int32\n\tconceptHas    map[string]map[int32]bool\n\n\t// write-back buffer for node detail, held as STRUCTS so resident reads share the stored\n\t// strings and props map instead of decoding a blob per read — encoding happens once, at\n\t// spill time. detCap == 0 means UNBOUNDED (no RAM ceiling): detail stays in RAM and is\n\t// never written to badger, so the build pays no write or codec cost at all. With a\n\t// ceiling, detCap bounds the buffer and detail spills to badger when full, so RAM stays\n\t// under budget (cold detail pages from disk).\n\tdet        map[int32]nodeDetail\n\tdetBytes   int   // approx bytes buffered (for the byte-accurate spill threshold)\n\tdetCapByte int64 // spill when detBytes exceeds this (0 = unbounded)\n}\n\ntype nodeDetail struct {\n\ttyp, loc, region, scope string\n\t// The hottest match-path properties, carried inline on Node rather than in Props. They must\n\t// round-trip: dropping them made Node.Prop(\"method\") return \"\" here but not in IntStore, so\n\t// --max-ram silently changed which bindings matched and therefore which findings appeared.\n\tmethod, calleePath, strArgs, vkind string\n\torder                              int32\n\thasOrder                           bool\n\tprops                              map[string]string\n}\n\n// OpenBadgerGraphUnder opens a graph in a directory of its own beneath base, and removes that\n// directory when the graph is closed.\n//\n// Badger holds a lock on its directory, so two graphs opened at one path cannot both exist: the\n// second falls back to the in-RAM store, which is the whole graph resident — the opposite of\n// what a memory ceiling asked for, and silent. A scan that builds one graph per partition opens\n// several in turn, so each needs its own directory and each needs it gone once its partition is\n// scanned.\nfunc OpenBadgerGraphUnder(base string, cacheBytes, detailBufBytes int64) (*BadgerGraph, error) {\n\tdir, err := os.MkdirTemp(base, \"g-\")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tg, err := OpenBadgerGraph(dir, cacheBytes, detailBufBytes)\n\tif err != nil {\n\t\t_ = os.RemoveAll(dir)\n\t\treturn nil, err\n\t}\n\tg.ownDir = dir\n\treturn g, nil\n}\n\n// OpenBadgerGraph opens a graph store at path (\":memory:\" for an in-memory Badger) with a cache\n// budget in bytes (block + value cache; 0 = Badger defaults).\nfunc OpenBadgerGraph(path string, cacheBytes, detailBufBytes int64) (*BadgerGraph, error) {\n\tvar opts badger.Options\n\tif path == \":memory:\" {\n\t\topts = badger.DefaultOptions(\"\").WithInMemory(true)\n\t} else {\n\t\topts = badger.DefaultOptions(path)\n\t}\n\tmemTableSize := int64(32 << 20)\n\tif cacheBytes > 0 && cacheBytes/2 < memTableSize {\n\t\t// Badger's own max batch size is a fraction of the memtable arena, and must stay\n\t\t// above its ValueThreshold (1MiB by default) or Open refuses outright -- so this\n\t\t// floor cannot chase the cache budget all the way down to it.\n\t\tmemTableSize = clampInt64(cacheBytes/2, 16<<20, memTableSize)\n\t}\n\topts = opts.WithLogger(nil).\n\t\tWithSyncWrites(false).    // a scan-scoped graph: durability not needed, speed is\n\t\tWithCompression(0).       // skip per-block (de)compression CPU\n\t\tWithNumVersionsToKeep(1). // no MVCC history\n\t\t// The memtable arena is an eager Go-heap allocation, paid once per graph the moment\n\t\t// it opens. A scan bounded to a small partition budget opens many of these in turn\n\t\t// (one per partition), so a flat 32MiB here taxes every partition regardless of how\n\t\t// little it holds -- scaling it down with the cache budget keeps that tax\n\t\t// proportionate instead of dominating a tight -max-ram ceiling.\n\t\tWithMemTableSize(memTableSize).\n\t\tWithDetectConflicts(false)\n\tif cacheBytes > 0 {\n\t\t// The whole cache budget goes to the block cache. The index cache is only\n\t\t// consulted for encrypted DBs; funding it here spends budget on a cache\n\t\t// that is never populated.\n\t\topts = opts.WithBlockCacheSize(cacheBytes).WithIndexCacheSize(0)\n\t}\n\tdb, err := badger.Open(opts)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tg := NewBadgerGraphDB(db, true)\n\tg.detCapByte = detailBufBytes // 0 = unbounded; else spill detail to badger past this many bytes\n\treturn g, nil\n}\n\nfunc clampInt64(want, lo, hi int64) int64 {\n\tif want < lo {\n\t\treturn lo\n\t}\n\tif want > hi {\n\t\treturn hi\n\t}\n\treturn want\n}\n\n// NewBadgerGraphDB wraps an existing *badger.DB (e.g. the shared parse cache db) as a graph store.\nfunc NewBadgerGraphDB(db *badger.DB, owned bool) *BadgerGraph {\n\treturn &BadgerGraph{\n\t\tdb: db, owned: owned,\n\t\tidx: map[string]int32{}, in: map[int32][]iedge{},\n\t\tbyType: map[string][]int32{}, byConcept: map[string][]int32{},\n\t\tconceptHas: map[string]map[int32]bool{}, det: map[int32]nodeDetail{},\n\t}\n}\n\nfunc (g *BadgerGraph) intern(id string) int32 {\n\tif i, ok := g.idx[id]; ok {\n\t\treturn i\n\t}\n\tg.thawFlows()\n\tg.thawLabels()\n\ti := int32(len(g.ids))\n\tg.idx[id] = i\n\tg.ids = append(g.ids, id)\n\tg.typs = append(g.typs, \"\")\n\tg.out = append(g.out, nil)\n\tg.flowOut = append(g.flowOut, nil)\n\tg.flowIn = append(g.flowIn, nil)\n\tg.labels = append(g.labels, nil)\n\treturn i\n}\n\n// Freeze packs the dominant flow adjacency after graph construction. Badger owns cold node\n// detail; CSR keeps the structural hot set small enough that the collector has useful headroom.\nfunc (g *BadgerGraph) Freeze() {\n\tg.mu.Lock()\n\tdefer g.mu.Unlock()\n\tif g.flowOutPacked.offsets != nil {\n\t\treturn\n\t}\n\tout, okOut := packAdj(g.flowOut)\n\tin, okIn := packAdj(g.flowIn)\n\tlabels, okLabels := packLabelRows(g.labels)\n\tif !okOut || !okIn || !okLabels {\n\t\treturn\n\t}\n\tg.flowOutPacked, g.flowInPacked = out, in\n\tg.labelsPacked = labels\n\tg.flowOut, g.flowIn = nil, nil\n\tg.labels = nil\n\tg.conceptHas = nil\n}\n\n// Caller holds g.mu whenever this can race with a writer.\nfunc (g *BadgerGraph) thawFlows() {\n\tif g.flowOutPacked.offsets == nil {\n\t\treturn\n\t}\n\tg.flowOut, g.flowIn = g.flowOutPacked.unpack(), g.flowInPacked.unpack()\n\tg.flowOutPacked, g.flowInPacked = packedAdj{}, packedAdj{}\n}\n\nfunc (g *BadgerGraph) thawLabels() {\n\tif g.labelsPacked.offsets == nil {\n\t\treturn\n\t}\n\tg.labels = g.labelsPacked.unpack()\n\tg.labelsPacked = packedLabels{}\n}\n\nfunc (g *BadgerGraph) labelsAt(i int32) []Label {\n\tif g.labelsPacked.offsets != nil {\n\t\treturn g.labelsPacked.at(i)\n\t}\n\treturn g.labels[i]\n}\n\nfunc (g *BadgerGraph) conceptSeen(concept string) map[int32]bool {\n\tif g.conceptHas == nil {\n\t\tg.conceptHas = map[string]map[int32]bool{}\n\t}\n\tseen := g.conceptHas[concept]\n\tif seen == nil {\n\t\tseen = make(map[int32]bool, len(g.byConcept[concept])+1)\n\t\tfor _, i := range g.byConcept[concept] {\n\t\t\tseen[i] = true\n\t\t}\n\t\tg.conceptHas[concept] = seen\n\t}\n\treturn seen\n}\n\nfunc (g *BadgerGraph) flowOutAt(i int32) []int32 {\n\tif g.flowOutPacked.offsets != nil {\n\t\treturn g.flowOutPacked.at(i)\n\t}\n\treturn g.flowOut[i]\n}\n\nfunc (g *BadgerGraph) flowInAt(i int32) []int32 {\n\tif g.flowInPacked.offsets != nil {\n\t\treturn g.flowInPacked.at(i)\n\t}\n\treturn g.flowIn[i]\n}\n\n// typeOf returns a node's type from the resident core. AddNode consults it on\n// every call, so it must never cost a badger read once detail has spilled.\nfunc (g *BadgerGraph) typeOf(i int32) string {\n\tif int(i) < len(g.typs) {\n\t\treturn g.typs[i]\n\t}\n\treturn \"\"\n}\n\n// StructEpoch reports the store's structural epoch. See usg/epoch.go.\nfunc (g *BadgerGraph) StructEpoch() uint64 {\n\tg.mu.Lock()\n\tdefer g.mu.Unlock()\n\treturn g.epoch\n}\n\nfunc (g *BadgerGraph) AddNode(n Node) error {\n\tg.mu.Lock()\n\tdefer g.mu.Unlock()\n\tg.epoch = nextStructEpoch()\n\ti, existed := g.idx[n.ID]\n\tif !existed {\n\t\ti = g.intern(n.ID)\n\t}\n\tif t := g.typeOf(i); t != n.Type {\n\t\tif existed && t != \"\" {\n\t\t\tremoveIdx(g.byType, t, i)\n\t\t}\n\t\tg.byType[n.Type] = append(g.byType[n.Type], i)\n\t}\n\tg.typs[i] = n.Type\n\td := nodeDetail{typ: n.Type, loc: n.Loc, region: n.Region, scope: n.Scope,\n\t\tmethod: n.Method, calleePath: n.CalleePath, strArgs: n.StrArgs, vkind: n.Vkind,\n\t\torder: n.Order, hasOrder: n.HasOrder, props: n.Props}\n\t// Same normalization as IntStore.AddNode: an explicit props entry wins over the inline field,\n\t// so a producer may set either and both stores agree.\n\tif n.Props != nil {\n\t\tif v, ok := n.Props[\"method\"]; ok {\n\t\t\td.method = v\n\t\t}\n\t\tif v, ok := n.Props[\"callee_path\"]; ok {\n\t\t\td.calleePath = v\n\t\t}\n\t\tif v, ok := n.Props[\"str_args\"]; ok {\n\t\t\td.strArgs = v\n\t\t}\n\t\tif v, ok := n.Props[\"vkind\"]; ok {\n\t\t\td.vkind = v\n\t\t}\n\t}\n\tif old, ok := g.det[i]; ok {\n\t\tg.detBytes -= estDetBytes(old)\n\t}\n\tg.det[i] = d\n\tg.detBytes += estDetBytes(d)\n\tif g.detCapByte > 0 && int64(g.detBytes) >= g.detCapByte {\n\t\tg.flushDet() // ceiling set: spill to badger to bound RAM\n\t}\n\treturn nil\n}\n\nfunc (g *BadgerGraph) AddEdge(e Edge) error {\n\tg.mu.Lock()\n\tdefer g.mu.Unlock()\n\tg.epoch = nextStructEpoch()\n\tsi, di := g.intern(e.Src), g.intern(e.Dst)\n\ttyp := edgeTypeIDFor(e.Type)\n\tif typ == edgeTypeFlows && len(e.Props) == 0 {\n\t\tg.thawFlows()\n\t\tg.flowOut[si] = append(g.flowOut[si], di)\n\t\tg.flowIn[di] = append(g.flowIn[di], si)\n\t\treturn nil\n\t}\n\tg.out[si] = append(g.out[si], iedge{typ: typ, dst: di, props: e.Props})\n\tif edgeTypeInIndexed(typ) {\n\t\tg.in[di] = append(g.in[di], iedge{typ: typ, dst: si, props: e.Props})\n\t}\n\treturn nil\n}\n\n// AddFlowEdgeIfPresent appends a prop-less FLOWS edge only when both endpoints already exist.\nfunc (g *BadgerGraph) AddFlowEdgeIfPresent(src, dst string) bool {\n\tg.mu.Lock()\n\tdefer g.mu.Unlock()\n\tsi, ok := g.idx[src]\n\tif !ok {\n\t\treturn false\n\t}\n\tdi, ok := g.idx[dst]\n\tif !ok {\n\t\treturn false\n\t}\n\tg.thawFlows()\n\tg.epoch = nextStructEpoch()\n\tg.flowOut[si] = append(g.flowOut[si], di)\n\tg.flowIn[di] = append(g.flowIn[di], si)\n\treturn true\n}\n\nfunc (g *BadgerGraph) AddLabel(nodeID string, l Label) error {\n\tg.mu.Lock()\n\tdefer g.mu.Unlock()\n\ti := g.intern(nodeID)\n\tg.thawLabels()\n\tg.labels[i] = append(g.labels[i], l)\n\tseen := g.conceptSeen(l.Concept)\n\tif !seen[i] {\n\t\tseen[i] = true\n\t\tg.byConcept[l.Concept] = append(g.byConcept[l.Concept], i)\n\t}\n\treturn nil\n}\n\nfunc removeIdx(m map[string][]int32, k string, i int32) {\n\ts := m[k]\n\tfor j, v := range s {\n\t\tif v == i {\n\t\t\tm[k] = append(s[:j], s[j+1:]...)\n\t\t\treturn\n\t\t}\n\t}\n}\n\n// --- read API: served from RAM accumulators (pre-Finalize) ----------------------------------\n// (post-Finalize disk reads land in a follow-on step; the accumulators stay valid until then.)\n\nfunc (g *BadgerGraph) idxOf(id string) (int32, bool) { i, ok := g.idx[id]; return i, ok }\n\n// estDetBytes approximates a detail's resident cost — string bytes plus struct and\n// map-slot overhead — so the spill threshold keeps meaning \"about this many bytes\n// buffered\" without encoding anything to find out.\nfunc estDetBytes(d nodeDetail) int {\n\tn := len(d.typ) + len(d.loc) + len(d.region) + len(d.scope) +\n\t\tlen(d.method) + len(d.calleePath) + len(d.strArgs) + len(d.vkind) + 96\n\tfor k, v := range d.props {\n\t\tn += len(k) + len(v) + 48\n\t}\n\treturn n\n}\n\n// rawDet returns a node's encoded detail from badger (cache-served). Resident detail\n// lives as structs in g.det and never takes this path.\nfunc (g *BadgerGraph) rawDet(i int32) []byte {\n\tvar out []byte\n\t_ = g.db.View(func(txn *badger.Txn) error {\n\t\titem, err := txn.Get(detKey(i))\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tout, err = item.ValueCopy(nil)\n\t\treturn err\n\t})\n\treturn out\n}\n\nfunc (g *BadgerGraph) nodeAt(i int32) Node {\n\td, ok := g.det[i]\n\tif !ok {\n\t\td = decDet(g.rawDet(i))\n\t}\n\treturn g.nodeFromDetail(i, d)\n}\n\nfunc (g *BadgerGraph) nodeFromDetail(i int32, d nodeDetail) Node {\n\treturn Node{ID: g.ids[i], Type: d.typ, Loc: d.loc, Region: d.region, Order: d.order,\n\t\tHasOrder: d.hasOrder, Scope: d.scope, Props: d.props,\n\t\tMethod: d.method, CalleePath: d.calleePath, StrArgs: d.strArgs, Vkind: d.vkind}\n}\n\n// flushDet writes the buffered node details to badger in one transaction and clears the buffer,\n// bounding RAM to the structural core + ~detBufMax buffered blobs + badger's cache.\nfunc (g *BadgerGraph) flushDet() {\n\tif len(g.det) == 0 {\n\t\treturn\n\t}\n\twb := g.db.NewWriteBatch()\n\tfor i, d := range g.det {\n\t\t_ = wb.Set(detKey(i), encDet(d))\n\t}\n\t_ = wb.Flush()\n\tg.det = map[int32]nodeDetail{}\n\tg.detBytes = 0\n}\n\nfunc detKey(i int32) []byte {\n\tb := make([]byte, 6)\n\tb[0], b[1] = 'g', 'n'\n\tbinary.BigEndian.PutUint32(b[2:], uint32(i))\n\treturn b\n}\n\n// Has reports whether a node id exists, without decoding its detail (existence-only fast path for\n// the lowerer's flow() checks, so the build never reads detail back from disk).\nfunc (g *BadgerGraph) Has(id string) bool { _, ok := g.idx[id]; return ok }\n\nfunc (g *BadgerGraph) GetNode(id string) (Node, bool, error) {\n\ti, ok := g.idxOf(id)\n\tif !ok {\n\t\treturn Node{}, false, nil\n\t}\n\treturn g.nodeAt(i), true, nil\n}\n\nfunc (g *BadgerGraph) OutEdges(src, edgeType string) ([]Edge, error) {\n\ti, ok := g.idxOf(src)\n\tif !ok {\n\t\treturn nil, nil\n\t}\n\tvar out []Edge\n\tif edgeTypeMatches(edgeTypeFlows, edgeType) {\n\t\tfor _, dst := range g.flowOutAt(i) {\n\t\t\tout = append(out, Edge{Type: \"FLOWS\", Src: src, Dst: g.ids[dst]})\n\t\t}\n\t}\n\tfor _, e := range g.out[i] {\n\t\tif edgeTypeMatches(e.typ, edgeType) {\n\t\t\tout = append(out, Edge{Type: edgeTypeName(e.typ), Src: src, Dst: g.ids[e.dst], Props: e.props})\n\t\t}\n\t}\n\treturn out, nil\n}\n\nfunc (g *BadgerGraph) InEdges(dst, edgeType string) ([]Edge, error) {\n\ti, ok := g.idxOf(dst)\n\tif !ok {\n\t\treturn nil, nil\n\t}\n\tvar out []Edge\n\tif edgeTypeMatches(edgeTypeFlows, edgeType) {\n\t\tfor _, src := range g.flowInAt(i) {\n\t\t\tout = append(out, Edge{Type: \"FLOWS\", Src: g.ids[src], Dst: dst})\n\t\t}\n\t}\n\tfor _, e := range g.in[i] {\n\t\tif edgeTypeMatches(e.typ, edgeType) {\n\t\t\tout = append(out, Edge{Type: edgeTypeName(e.typ), Src: g.ids[e.dst], Dst: dst, Props: e.props})\n\t\t}\n\t}\n\treturn out, nil\n}\n\nfunc (g *BadgerGraph) RangeInEdges(dst, edgeType string, fn func(src string) bool) {\n\ti, ok := g.idxOf(dst)\n\tif !ok {\n\t\treturn\n\t}\n\tif edgeTypeMatches(edgeTypeFlows, edgeType) {\n\t\tfor _, src := range g.flowInAt(i) {\n\t\t\tif !fn(g.ids[src]) {\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}\n\tfor _, e := range g.in[i] {\n\t\tif edgeTypeMatches(e.typ, edgeType) {\n\t\t\tif !fn(g.ids[e.dst]) {\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunc (g *BadgerGraph) NodesWithConcept(concept string) ([]string, error) {\n\treturn g.idsOf(g.byConcept[concept]), nil\n}\nfunc (g *BadgerGraph) NodesOfType(nodeType string) ([]string, error) {\n\treturn g.idsOf(g.byType[nodeType]), nil\n}\n\n// TypeNodeIndexes returns the store-owned dense indexes for a node type.\n// Callers must treat the returned slice as read-only.\nfunc (g *BadgerGraph) TypeNodeIndexes(nodeType string) []int32 {\n\treturn g.byType[nodeType]\n}\n\n// NodeAtIndex reads one node without converting its dense index through the\n// string-id map. Binding matching retains these indexes, so the disk-backed\n// path should not pay an id hash lookup for every candidate and predicate.\nfunc (g *BadgerGraph) NodeAtIndex(i int32) (Node, bool) {\n\tif i < 0 || int(i) >= len(g.ids) {\n\t\treturn Node{}, false\n\t}\n\treturn g.nodeAt(i), true\n}\n\nfunc (g *BadgerGraph) RangeNodesOfType(nodeType string, fn func(Node) bool) {\n\tfor _, i := range g.byType[nodeType] {\n\t\tif !fn(g.nodeAt(i)) {\n\t\t\treturn\n\t\t}\n\t}\n}\n\nfunc (g *BadgerGraph) idsOf(idxs []int32) []string {\n\tout := make([]string, len(idxs))\n\tfor k, i := range idxs {\n\t\tout[k] = g.ids[i]\n\t}\n\treturn out\n}\n\nfunc (g *BadgerGraph) AllNodes() ([]Node, error) {\n\tout := make([]Node, 0, len(g.ids))\n\tg.RangeNodes(func(n Node) bool { out = append(out, n); return true })\n\treturn out, nil\n}\n\nfunc (g *BadgerGraph) Labels(nodeID string) ([]Label, error) {\n\ti, ok := g.idxOf(nodeID)\n\tif !ok {\n\t\treturn nil, nil\n\t}\n\treturn g.labelsAt(i), nil\n}\n\nfunc (g *BadgerGraph) Close() error {\n\tg.flushDet()\n\tvar err error\n\tif g.owned {\n\t\terr = g.db.Close()\n\t}\n\tif g.ownDir != \"\" {\n\t\t_ = os.RemoveAll(g.ownDir)\n\t\tg.ownDir = \"\"\n\t}\n\treturn err\n}\n\n// --- node-detail binary codec ---------------------------------------------------------------\n\ntype detWriter struct{ b []byte }\n\nfunc (w *detWriter) u(n int) {\n\tfor n >= 0x80 {\n\t\tw.b = append(w.b, byte(n)|0x80)\n\t\tn >>= 7\n\t}\n\tw.b = append(w.b, byte(n))\n}\nfunc (w *detWriter) str(s string) { w.u(len(s)); w.b = append(w.b, s...) }\nfunc (w *detWriter) boolean(v bool) {\n\tif v {\n\t\tw.b = append(w.b, 1)\n\t} else {\n\t\tw.b = append(w.b, 0)\n\t}\n}\n\ntype detReader struct {\n\tb []byte\n\ti int\n}\n\nfunc (r *detReader) u() int {\n\tvar x int\n\tvar s uint\n\tfor {\n\t\tc := r.b[r.i]\n\t\tr.i++\n\t\tx |= int(c&0x7f) << s\n\t\tif c < 0x80 {\n\t\t\treturn x\n\t\t}\n\t\ts += 7\n\t}\n}\nfunc (r *detReader) str() string {\n\tif r.i >= len(r.b) {\n\t\treturn \"\"\n\t}\n\tn := r.u()\n\ts := string(r.b[r.i : r.i+n])\n\tr.i += n\n\treturn s\n}\nfunc (r *detReader) boolean() bool { v := r.b[r.i] == 1; r.i++; return v }\n\n// encDet writes type first (so typeOf can read it cheaply), then the rest of the payload.\nfunc encDet(d nodeDetail) []byte {\n\tw := &detWriter{}\n\tw.str(d.typ)\n\tw.str(d.loc)\n\tw.str(d.region)\n\tw.str(d.scope)\n\tw.str(d.method)\n\tw.str(d.calleePath)\n\tw.str(d.strArgs)\n\tw.str(d.vkind)\n\tw.u(int(uint32(d.order)))\n\tw.boolean(d.hasOrder)\n\tw.u(len(d.props))\n\tfor k, v := range d.props {\n\t\tw.str(k)\n\t\tw.str(v)\n\t}\n\treturn w.b\n}\n\nfunc decDet(b []byte) nodeDetail {\n\tif len(b) == 0 {\n\t\treturn nodeDetail{}\n\t}\n\tr := &detReader{b: b}\n\td := nodeDetail{typ: r.str(), loc: r.str(), region: r.str(), scope: r.str()}\n\td.method, d.calleePath, d.strArgs, d.vkind = r.str(), r.str(), r.str(), r.str()\n\td.order = int32(uint32(r.u()))\n\td.hasOrder = r.boolean()\n\tif n := r.u(); n > 0 {\n\t\td.props = make(map[string]string, n)\n\t\tfor j := 0; j < n; j++ {\n\t\t\tk := r.str()\n\t\t\td.props[k] = r.str()\n\t\t}\n\t}\n\treturn d\n}\n\n// --- IntGraph fast path ---------------------------------------------------------------------\n\n// Asserted, not assumed: solvers.FindTaintFlows dispatches on this interface and\n// silently falls back to its string-keyed implementation for a store that does not\n// satisfy it. The answers stay the same, but the hot loop starts touching string ids\n// and payload — which is the whole cost this store exists to avoid — so losing\n// conformance would surface only as an unexplained slowdown on large scans.\nvar _ IntGraph = (*BadgerGraph)(nil)\n\nfunc (g *BadgerGraph) NodeCount() int                      { return len(g.ids) }\nfunc (g *BadgerGraph) ConceptNodes(concept string) []int32 { return g.byConcept[concept] }\nfunc (g *BadgerGraph) LabelsAt(idx int32) []Label {\n\tif idx < 0 || int(idx) >= len(g.ids) {\n\t\treturn nil\n\t}\n\treturn g.labelsAt(idx)\n}\nfunc (g *BadgerGraph) NodeID(idx int32) string           { return g.ids[idx] }\nfunc (g *BadgerGraph) NodeIndex(id string) (int32, bool) { return g.idxOf(id) }\nfunc (g *BadgerGraph) LabelsOf(nodeID string) []Label    { l, _ := g.Labels(nodeID); return l }\n\nfunc (g *BadgerGraph) RangeOut(src int32, edgeType string, fn func(dst int32) bool) {\n\tif int(src) >= len(g.out) {\n\t\treturn\n\t}\n\tif edgeTypeMatches(edgeTypeFlows, edgeType) {\n\t\tfor _, dst := range g.flowOutAt(src) {\n\t\t\tif !fn(dst) {\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}\n\tfor _, e := range g.out[src] {\n\t\tif edgeTypeMatches(e.typ, edgeType) {\n\t\t\tif !fn(e.dst) {\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunc (g *BadgerGraph) RangeOutEdges(src, edgeType string, fn func(dst string) bool) {\n\ti, ok := g.idxOf(src)\n\tif !ok {\n\t\treturn\n\t}\n\tif edgeTypeMatches(edgeTypeFlows, edgeType) {\n\t\tfor _, dst := range g.flowOutAt(i) {\n\t\t\tif !fn(g.ids[dst]) {\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}\n\tfor _, e := range g.out[i] {\n\t\tif edgeTypeMatches(e.typ, edgeType) {\n\t\t\tif !fn(g.ids[e.dst]) {\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}\n}\n\n// RangeNodes streams every node in stable dense-index order.\nfunc (g *BadgerGraph) RangeNodes(fn func(Node) bool) {\n\tg.RangeNodeIndexes(func(_ int32, n Node) bool { return fn(n) })\n}\n\n// RangeNodeIndexes streams every dense index with its node. It flushes the\n// detail buffer, then reads detail via a single SEQUENTIAL badger scan of the\n// gn\\0 prefix rather than a random Get per node. The binding matcher builds its\n// compact indexes through this path and keeps the int32 reference thereafter.\nfunc (g *BadgerGraph) RangeNodeIndexes(fn func(int32, Node) bool) {\n\temit := func(idx int32, d nodeDetail) bool {\n\t\treturn fn(idx, g.nodeFromDetail(idx, d))\n\t}\n\tif len(g.det) == len(g.ids) { // everything resident → no badger scan, no decode\n\t\tfor idx := range g.ids {\n\t\t\ti := int32(idx)\n\t\t\tif !emit(i, g.det[i]) {\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t\treturn\n\t}\n\tnextResidentScan := int32(0)\n\temitResidentBefore := func(limit int32) bool {\n\t\tfor nextResidentScan < limit {\n\t\t\tif d, ok := g.det[nextResidentScan]; ok {\n\t\t\t\tif !emit(nextResidentScan, d) {\n\t\t\t\t\treturn false\n\t\t\t\t}\n\t\t\t}\n\t\t\tnextResidentScan++\n\t\t}\n\t\treturn true\n\t}\n\t// Spilled detail: one sequential prefix scan, merging any still-resident nodes.\n\tpfx := []byte(\"gn\")\n\tstop := false\n\t_ = g.db.View(func(txn *badger.Txn) error {\n\t\tit := txn.NewIterator(badger.DefaultIteratorOptions)\n\t\tdefer it.Close()\n\t\tfor it.Seek(pfx); it.ValidForPrefix(pfx); it.Next() {\n\t\t\titem := it.Item()\n\t\t\tk := item.Key()\n\t\t\tif len(k) != 6 {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tidx := int32(binary.BigEndian.Uint32(k[2:]))\n\t\t\tif idx < 0 || int(idx) >= len(g.ids) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif idx < nextResidentScan {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif !emitResidentBefore(idx) {\n\t\t\t\tstop = true\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\tif d, inRAM := g.det[idx]; inRAM {\n\t\t\t\tnextResidentScan = idx + 1\n\t\t\t\tif !emit(idx, d) {\n\t\t\t\t\tstop = true\n\t\t\t\t\treturn nil\n\t\t\t\t}\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif err := item.Value(func(v []byte) error {\n\t\t\t\tif !emit(idx, decDet(v)) {\n\t\t\t\t\tstop = true\n\t\t\t\t}\n\t\t\t\tnextResidentScan = idx + 1\n\t\t\t\treturn nil\n\t\t\t}); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tif stop {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t\treturn nil\n\t})\n\tif stop {\n\t\treturn\n\t}\n\tfor nextResidentScan < int32(len(g.ids)) {\n\t\tif d, ok := g.det[nextResidentScan]; ok {\n\t\t\tif !emit(nextResidentScan, d) {\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t\tnextResidentScan++\n\t}\n}\n","numLines":832,"startLine":1,"totalLines":832}}}
