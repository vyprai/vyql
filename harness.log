{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_3df8adf9ab9743cb95115cb9","type":"tool_result","content":"1\tpackage treesitter\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"fmt\"\n6\t\t\"os\"\n7\t\t\"path/filepath\"\n8\t\t\"strings\"\n9\t\t\"testing\"\n10\t\n11\t\t\"github.com/vyprai/vyql/internal/extract/lowering\"\n12\t\t\"github.com/vyprai/vyql/internal/extract/nir\"\n13\t\t\"github.com/vyprai/vyql/internal/usg\"\n14\t)\n15\t\n16\t// extractAndLowerPython extracts one Python source and lowers it, the way a scan\n17\t// of that repository would.\n18\tfunc extractAndLowerPython(t *testing.T, name, src string) (nir.Program, usg.Store) {\n19\t\tt.Helper()\n20\t\tdir := t.TempDir()\n21\t\tfile := filepath.Join(dir, name)\n22\t\tif err := os.WriteFile(file, []byte(src), 0o644); err != nil {\n23\t\t\tt.Fatal(err)\n24\t\t}\n25\t\tprog, err := ExtractPython([]string{file}, dir)\n26\t\tif err != nil {\n27\t\t\tt.Fatal(err)\n28\t\t}\n29\t\tg, err := lowering.Lower(prog, true)\n30\t\tif err != nil {\n31\t\t\tt.Fatalf(\"lower: %v\", err)\n32\t\t}\n33\t\treturn prog, g\n34\t}\n35\t\n36\t// TestPythonFunctionEndModuleTokensAreOneLiteral pins the node economy of the\n37\t// module-fact re-carriage: a function's .end call carries the module's context\n38\t// tokens (capped at pyContextBaseTokenLimit) as ONE joined literal, not one\n39\t// literal per token. One literal per token costs a Const+Arg node pair per token\n40\t// per function — the 512-token cap over thousands of functions is millions of\n41\t// nodes, a graph quadratic in the module — and that term is what pushed a dense\n42\t// multi-package Python repository past a whole-repository scan's memory safety\n43\t// stop before any finding was emitted.\n44\tfunc TestPythonFunctionEndModuleTokensAreOneLiteral(t *testing.T) {\n45\t\tprog, _ := extractAndLowerPython(t, \"mod.py\", moduleTokenSource(3))\n46\t\tvar endCalls, otherCalls, endWithModuleLiteral, otherCallsWithModuleLiteral int\n47\t\tvar walk func([]nir.Stmt)\n48\t\twalk = func(sts []nir.Stmt) {\n49\t\t\tfor _, st := range sts {\n50\t\t\t\tswitch s := st.(type) {\n51\t\t\t\tcase nir.ExprStmt:\n52\t\t\t\t\tc, ok := s.Value.(nir.Call)\n53\t\t\t\t\tif !ok || !strings.HasPrefix(c.Path, \"analysis.function.context\") {\n54\t\t\t\t\t\tcontinue\n55\t\t\t\t\t}\n56\t\t\t\t\tvar blob string\n57\t\t\t\t\tmoduleLiterals := 0\n58\t\t\t\t\tfor _, a := range c.Args {\n59\t\t\t\t\t\tlit, ok := a.(nir.Const)\n60\t\t\t\t\t\tif !ok || !strings.HasPrefix(lit.Value, \"module_\") {\n61\t\t\t\t\t\t\tcontinue\n62\t\t\t\t\t\t}\n63\t\t\t\t\t\tmoduleLiterals++\n64\t\t\t\t\t\tblob = lit.Value\n65\t\t\t\t\t}\n66\t\t\t\t\tif c.Path == \"analysis.function.context.end\" {\n67\t\t\t\t\t\tendCalls++\n68\t\t\t\t\t\t// The joined literal still carries every module token, \\x00\n69\t\t\t\t\t\t// separated and module_ prefixed, so str_args (value matching)\n70\t\t\t\t\t\t// and the \\x00-splitting presence walk see the same tokens\n71\t\t\t\t\t\t// one-literal-per-token produced.\n72\t\t\t\t\t\tsegments := strings.Split(blob, \"\\x00\")\n73\t\t\t\t\t\tknown := map[string]bool{\n74\t\t\t\t\t\t\t\"module_function_name:module\":  false,\n75\t\t\t\t\t\t\t\"module_identifier:handler_0\":  false,\n76\t\t\t\t\t\t\t\"module_call_path:request.get\": false,\n77\t\t\t\t\t\t\t\"module_literal:field_0\":       false,\n78\t\t\t\t\t\t}\n79\t\t\t\t\t\tfor _, seg := range segments {\n80\t\t\t\t\t\t\tif !strings.HasPrefix(seg, \"module_\") {\n81\t\t\t\t\t\t\t\tt.Fatalf(\"re-carriage segment %q is not module_ prefixed\", seg)\n82\t\t\t\t\t\t\t}\n83\t\t\t\t\t\t\tif _, ok := known[seg]; ok {\n84\t\t\t\t\t\t\t\tknown[seg] = true\n85\t\t\t\t\t\t\t}\n86\t\t\t\t\t\t}\n87\t\t\t\t\t\tcomplete := moduleLiterals == 1\n88\t\t\t\t\t\tfor seg, present := range known {\n89\t\t\t\t\t\t\tif !present {\n90\t\t\t\t\t\t\t\tt.Errorf(\"end call re-carriage is missing module token %q (blob has %d segments)\", seg, len(segments))\n91\t\t\t\t\t\t\t\tcomplete = false\n92\t\t\t\t\t\t\t}\n93\t\t\t\t\t\t}\n94\t\t\t\t\t\tif complete {\n95\t\t\t\t\t\t\tendWithModuleLiteral++\n96\t\t\t\t\t\t}\n97\t\t\t\t\t} else {\n98\t\t\t\t\t\totherCalls++\n99\t\t\t\t\t\tif moduleLiterals > 0 {\n100\t\t\t\t\t\t\totherCallsWithModuleLiteral++\n101\t\t\t\t\t\t}\n102\t\t\t\t\t}\n103\t\t\t\tcase nir.FuncDef:\n104\t\t\t\t\twalk(s.Body)\n105\t\t\t\tcase nir.Block:\n106\t\t\t\t\twalk(s.Stmts)\n107\t\t\t\t}\n108\t\t\t}\n109\t\t}\n110\t\tfor _, m := range prog.Modules {\n111\t\t\twalk(m.Body)\n112\t\t}\n113\t\tif endCalls == 0 {\n114\t\t\tt.Fatal(\"no analysis.function.context.end call was emitted\")\n115\t\t}\n116\t\tif endWithModuleLiteral != endCalls {\n117\t\t\tt.Fatalf(\"module re-carriage is not one joined literal carrying every module token on %d of %d end calls\", endCalls-endWithModuleLiteral, endCalls)\n118\t\t}\n119\t\tif otherCallsWithModuleLiteral != 0 {\n120\t\t\tt.Fatalf(\"%d non-end context calls carry module_ literals; the re-carriage is the end call's alone\", otherCallsWithModuleLiteral)\n121\t\t}\n122\t}\n123\t\n124\t// TestPythonManyFunctionModuleGraphBudget pins what the economy buys: a module\n125\t// of many small functions lowers to a graph whose size is linear in the module,\n126\t// not linear in functions × module tokens. At one literal per token the same\n127\t// source lowered to 529031 nodes, 1322 per function (each of the 400 functions\n128\t// re-carried the capped 512-token module list as 512 Const+Arg pairs); the\n129\t// budget leaves headroom over the joined-literal shape's ~300.\n130\tfunc TestPythonManyFunctionModuleGraphBudget(t *testing.T) {\n131\t\tconst funcs = 400\n132\t\t_, g := extractAndLowerPython(t, \"dense.py\", moduleTokenSource(funcs))\n133\t\tnodes, err := g.AllNodes()\n134\t\tif err != nil {\n135\t\t\tt.Fatal(err)\n136\t\t}\n137\t\t// The module facts must still be on every function's end call.\n138\t\tvar endCalls, endWithModule int\n139\t\tfor _, n := range nodes {\n140\t\t\tif n.Type != \"code.Call\" || n.Prop(\"callee_path\") != \"analysis.function.context.end\" {\n141\t\t\t\tcontinue\n142\t\t\t}\n143\t\t\tendCalls++\n144\t\t\tif strings.Contains(n.Prop(\"str_args\"), \"module_identifier:handler_0\") {\n145\t\t\t\tendWithModule++\n146\t\t\t}\n147\t\t}\n148\t\tif endCalls == 0 {\n149\t\t\tt.Fatal(\"no analysis.function.context.end call was lowered\")\n150\t\t}\n151\t\tif endWithModule != endCalls {\n152\t\t\tt.Fatalf(\"module context tokens missing from %d of %d end calls' str_args\", endCalls-endWithModule, endCalls)\n153\t\t}\n154\t\tif perFunc := len(nodes) / funcs; perFunc > 500 {\n155\t\t\tt.Fatalf(\"%d functions lowered to %d nodes (%d per function); the module re-carriage must not mint a node per token per function\", funcs, len(nodes), perFunc)\n156\t\t}\n157\t}\n158\t\n159\t// moduleTokenSource builds a module of same-shaped functions: every function\n160\t// gets the frontend's five context calls, and the module's own token list (each\n161\t// module-level def contributes identifiers) is re-carried on each .end call.\n162\tfunc moduleTokenSource(funcs int) string {\n163\t\tvar src bytes.Buffer\n164\t\tfor i := range funcs {\n165\t\t\tfmt.Fprintf(&src, \"def handler_%d(request, response):\\n    data = request.get('field_%d')\\n    response.write('<b>' + data + '</b>')\\n\\n\", i, i)\n166\t\t}\n167\t\treturn src.String()\n168\t}\n169\t"}]},"parent_tool_use_id":null,"session_id":"3d3b39ce-4baf-4531-a837-11deefe45eb7","uuid":"e50c431e-53ca-463f-93fe-1e919d16c925","timestamp":"2026-09-19T05:25:57.942Z","tool_use_result":{"type":"text","file":{"filePath":"/campaign/work/engine-the-engine-s-memory-safety-stop-ends-a-whole-repository-scan/internal/extract/frontend/treesitter/python_context_economy_test.go","content":"package treesitter\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/vyprai/vyql/internal/extract/lowering\"\n\t\"github.com/vyprai/vyql/internal/extract/nir\"\n\t\"github.com/vyprai/vyql/internal/usg\"\n)\n\n// extractAndLowerPython extracts one Python source and lowers it, the way a scan\n// of that repository would.\nfunc extractAndLowerPython(t *testing.T, name, src string) (nir.Program, usg.Store) {\n\tt.Helper()\n\tdir := t.TempDir()\n\tfile := filepath.Join(dir, name)\n\tif err := os.WriteFile(file, []byte(src), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tprog, err := ExtractPython([]string{file}, dir)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tg, err := lowering.Lower(prog, true)\n\tif err != nil {\n\t\tt.Fatalf(\"lower: %v\", err)\n\t}\n\treturn prog, g\n}\n\n// TestPythonFunctionEndModuleTokensAreOneLiteral pins the node economy of the\n// module-fact re-carriage: a function's .end call carries the module's context\n// tokens (capped at pyContextBaseTokenLimit) as ONE joined literal, not one\n// literal per token. One literal per token costs a Const+Arg node pair per token\n// per function — the 512-token cap over thousands of functions is millions of\n// nodes, a graph quadratic in the module — and that term is what pushed a dense\n// multi-package Python repository past a whole-repository scan's memory safety\n// stop before any finding was emitted.\nfunc TestPythonFunctionEndModuleTokensAreOneLiteral(t *testing.T) {\n\tprog, _ := extractAndLowerPython(t, \"mod.py\", moduleTokenSource(3))\n\tvar endCalls, otherCalls, endWithModuleLiteral, otherCallsWithModuleLiteral int\n\tvar walk func([]nir.Stmt)\n\twalk = func(sts []nir.Stmt) {\n\t\tfor _, st := range sts {\n\t\t\tswitch s := st.(type) {\n\t\t\tcase nir.ExprStmt:\n\t\t\t\tc, ok := s.Value.(nir.Call)\n\t\t\t\tif !ok || !strings.HasPrefix(c.Path, \"analysis.function.context\") {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tvar blob string\n\t\t\t\tmoduleLiterals := 0\n\t\t\t\tfor _, a := range c.Args {\n\t\t\t\t\tlit, ok := a.(nir.Const)\n\t\t\t\t\tif !ok || !strings.HasPrefix(lit.Value, \"module_\") {\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t\tmoduleLiterals++\n\t\t\t\t\tblob = lit.Value\n\t\t\t