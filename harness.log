ss the computed value as an\n# argument -- which is the shape the fix moved to. The third pins the two\n# forms that must stay silent: the variadic forwarding wrapper Ruby's own\n# headers declare RBIMPL_ATTR_FORMAT (va_start plus rb_vsprintf, the\n# documented way to add a formatted-error helper to an extension), and the\n# everyday literal rb_raise with a computed argument.\n\ntest \"rank2019: a duplicate key's bytes reach rb_sprintf as the format\"\n  lang c\n  profile library\n  file ext/json/ext/parser/parser.c\n  ```\n#include <ruby.h>\n\n#define PARSE_ERROR_FRAGMENT_LEN 32\n\nstatic rb_encoding *enc_utf8;\n\nstatic void cursor_position(JSON_ParserState *state, long *line_out, long *column_out)\n{\n    const char *cursor = state->cursor;\n    long column = 0;\n    long line = 1;\n\n    while (cursor >= state->start) {\n        if (*cursor-- == '\\n') {\n            break;\n        }\n        column++;\n    }\n    *line_out = line;\n    *column_out = column;\n}\n\nstatic void raise_parse_error(const char *format, JSON_ParserState *state)\n{\n    unsigned char buffer[PARSE_ERROR_FRAGMENT_LEN + 3];\n    long line, column;\n    cursor_position(state, &line, &column);\n\n    const char *ptr = \"EOF\";\n    if (state->cursor && state->cursor < state->end) {\n        ptr = state->cursor;\n        size_t len = 0;\n        while (len < PARSE_ERROR_FRAGMENT_LEN) {\n            char ch = ptr[len];\n            if (!ch || ch == '\\n' || ch == ' ' || ch == '\\t' || ch == '\\r') {\n                break;\n            }\n            len++;\n        }\n        if (len) {\n            buffer[0] = '\\'';\n            MEMCPY(buffer + 1, ptr, char, len);\n            buffer[len + 1] = '\\'';\n            buffer[len + 2] = '\\0';\n            ptr = (const char *)buffer;\n        }\n    }\n\n    VALUE msg = rb_sprintf(format, ptr);\n    VALUE message = rb_enc_sprintf(enc_utf8, \"%s at line %ld column %ld\", RSTRING_PTR(msg), line, column);\n    RB_GC_GUARD(msg);\n\n    VALUE exc = rb_exc_new_str(rb_path2class(\"JSON::ParserError\"), message);\n    rb_ivar_set(exc, rb_intern(\"@line\"), LONG2NUM(line));\n    rb_exc_raise(exc);\n}\n\nstatic void raise_duplicate_key_error(JSON_ParserState *state, VALUE duplicate_key)\n{\n    VALUE message = rb_sprintf(\n        \"duplicate key %\"PRIsVALUE,\n        rb_inspect(duplicate_key)\n    );\n\n    raise_parse_error(RSTRING_PTR(message), state);\n    RB_GC_GUARD(message);\n}\n  ```\n  expect VYQL-INJ-284\n\n\ntest \"rank2019: the rendered key as an argument of a literal format stays silent\"\n  lang c\n  profile library\n  file ext/json/ext/parser/parser.c\n  ```\n#include <ruby.h>\n\n#define PARSE_ERROR_FRAGMENT_LEN 32\n\nstatic rb_encoding *enc_utf8;\n\nstatic void cursor_position(JSON_ParserState *state, long *line_out, long *column_out)\n{\n    const char *cursor = state->cursor;\n    long column = 0;\n    long line = 1;\n\n    while (cursor >= state->start) {\n        if (*cursor-- == '\\n') {\n            break;\n        }\n        column++;\n    }\n    *line_out = line;\n    *column_out = column;\n}\n\nstatic void raise_parse_error(const char *fragment, JSON_ParserState *state)\n{\n    unsigned char buffer[PARSE_ERROR_FRAGMENT_LEN + 3];\n    long line, column;\n    cursor_position(state, &line, &column);\n\n    const char *ptr = \"EOF\";\n    if (state->cursor && state->cursor < state->end) {\n        ptr = state->cursor;\n        size_t len = 0;\n        while (len < PARSE_ERROR_FRAGMENT_LEN) {\n            char ch = ptr[len];\n            if (!ch || ch == '\\n' || ch == ' ' || ch == '\\t' || ch == '\\r') {\n                break;\n            }\n            len++;\n        }\n        if (len) {\n            buffer[0] = '\\'';\n            MEMCPY(buffer + 1, ptr, char, len);\n            buffer[len + 1] = '\\'';\n            buffer[len + 2] = '\\0';\n            ptr = (const char *)buffer;\n        }\n    }\n\n    VALUE msg = rb_sprintf(\"%s: %s\", fragment, ptr);\n    VALUE message = rb_enc_sprintf(enc_utf8, \"%s at line %ld column %ld\", RSTRING_PTR(msg), line, column);\n    RB_GC_GUARD(msg);\n\n    VALUE exc = rb_exc_new_str(rb_path2class(\"JSON::ParserError\"), message);\n    rb_ivar_set(exc, rb_intern(\"@line\"), LONG2NUM(line));\n    rb_exc_raise(exc);\n}\n\nstatic void raise_duplicate_key_error(JSON_ParserState *state, VALUE duplicate_key)\n{\n    VALUE message = rb_sprintf(\n        \"duplicate key %\"PRIsVALUE,\n        rb_inspect(duplicate_key)\n    );\n\n    raise_parse_error(RSTRING_PTR(message), state);\n    RB_GC_GUARD(message);\n}\n  ```\n  reject VYQL-INJ-284\n\n\ntest \"rank2019: the forwarding wrapper and the literal rb_raise stay silent\"\n  lang c\n  profile library\n  file ext/json/ext/generator/generator.c\n  ```\n#include <ruby.h>\n\nstatic void raise_generator_error_str(VALUE invalid_object, VALUE str)\n{\n    VALUE exc = rb_exc_new_str(eGeneratorError, str);\n    rb_ivar_set(exc, rb_intern(\"@invalid_object\"), invalid_object);\n    rb_exc_raise(exc);\n}\n\nstatic void raise_generator_error(VALUE invalid_object, const char *fmt, ...)\n{\n    va_list args;\n    va_start(args, fmt);\n    VALUE str = rb_vsprintf(fmt, args);\n    va_end(args);\n    raise_generator_error_str(invalid_object, str);\n}\n\nstatic void raise_nesting_error(JSON_ParserState *state)\n{\n    rb_raise(eNestingError, \"nesting of %d is too deep\", state->current_nesting);\n}\n  ```\n  reject VYQL-INJ-284","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
