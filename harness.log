{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_09e0bc3ff1364a11bff8ea66","type":"tool_result","content":"870\t\t\treturn err\n871\t\t}\n872\t\t// whole-scan result cache: if an explicit process cache exists and nothing the output depends on\n873\t\t// changed — no source file edit and no vyql/ data change — replay the cached findings and\n874\t\t// skip the pipeline entirely. On a miss, the per-file parse cache still makes the rebuild\n875\t\t// reparse only the files that actually changed.\n876\t\tcache := parsecache.Shared()\n877\t\ttk := timing.New()\n878\t\t// Graph-DB change-feed: when requested, build the per-module delta during the scan. Force the\n879\t\t// full pipeline (skip the whole-scan findings cache) so the collector is populated.\n880\t\tsyncPath := syncOutputPath()\n881\t\tif syncPath != \"\" {\n882\t\t\tsyncCollector = graphsync.New()\n883\t\t}\n884\t\tvar rkey string\n885\t\tvar all []*findings.Finding\n886\t\tvar stats extract.Stats\n887\t\tvar graph usg.Store\n888\t\t// codemap holds the merged graph-json document when the scan was partitioned;\n889\t\t// nil when the run built one graph (or replayed nothing) and the document is\n890\t\t// built from that graph at output time.\n891\t\tvar codemap *graphjson.Document\n892\t\thit := false\n893\t\twantsFlags := opts.wantsFlags()\n894\t\t// graph-json serialises the live graph, which the whole-scan findings cache\n895\t\t// cannot replay -- it stores findings, not the USG. Force the full pipeline,\n896\t\t// exactly as the flag paths do.\n897\t\t//\n898\t\t// -stats belongs in this set because it reports node and edge counts, which\n899\t\t// only exist while the graph is retained.\n900\t\tneedsGraph := wantsFlags || format == \"graph-json\" || opts.ShowStats\n901\t\tif cache != nil && syncCollector == nil && !needsGraph {\n902\t\t\trkey = scanFingerprint(cache.Salt(), paths, ruleSources, prof.Name, opts.BindingOverlay, opts.Excludes)\n903\t\t\tif cs, ok := loadCachedScan(cache, rkey); ok {\n904\t\t\t\tall, stats, hit = cs.Findings, statsFromCachedScan(cs), true\n905\t\t\t\trestoreExcludeCounts(cs, opts.Excludes)\n906\t\t\t}\n907\t\t}\n908\t\ttk.Mark(\"fingerprint\")\n909\t\tif !hit {\n910\t\t\tbuild := extract.Options{BindingOverlay: opts.BindingOverlay, Excludes: opts.Excludes}\n911\t\t\t// A target too large to hold as one graph inside the ceiling is scanned as several.\n912\t\t\t// Not when the run needs the graph itself (the flag reports, -stats): those serialise\n913\t\t\t// one store, and there is no one store to hand them. graph-json is the exception: its\n914\t\t\t// document is a projection of the graph — functions, call edges, findings — and\n915\t\t\t// projections of partitions merge, so a graph-json run without the flag reports or\n916\t\t\t// -stats is scanned as several documents of which one is printed.\n917\t\t\tcodemapParts := format == \"graph-json\" && !wantsFlags && !opts.ShowStats\n918\t\t\tvar parts []map[string]bool\n919\t\t\tif !needsGraph || codemapParts {\n920\t\t\t\tparts = extract.PlanPartitions(paths, opts.Excludes, scanSourceLimit, scanSourceBudget)\n921\t\t\t}\n922\t\t\tscanNow := func() {\n923\t\t\t\tif len(parts) > 1 {\n924\t\t\t\t\tif codemapParts {\n925\t\t\t\t\t\tvar doc graphjson.Document\n926\t\t\t\t\t\tall, stats, doc, err = scanPartitionsCodemap(paths, ruleSources, prof.Name, build, parts, sarifRulesMeta(ruleSources), scanRoot(paths))\n927\t\t\t\t\t\tcodemap = &doc\n928\t\t\t\t\t\treturn\n929\t\t\t\t\t}\n930\t\t\t\t\tall, stats, err = scanPartitions(paths, ruleSources, prof.Name, build, parts)\n931\t\t\t\t\treturn\n932\t\t\t\t}\n933\t\t\t\tall, stats, graph, err = scanPathsWithProfileDemand(paths, ruleSources, prof.Name, !needsGraph, build)\n934\t\t\t}\n935\t\t\tif cache != nil && !opts.GraphCache {\n936\t\t\t\tfunc() {\n937\t\t\t\t\trestore := parsecache.SetShared(nil)\n938\t\t\t\t\tdefer restore()\n939\t\t\t\t\tscanNow()\n940\t\t\t\t}()\n941\t\t\t} else {\n942\t\t\t\tscanNow()\n943\t\t\t}\n94