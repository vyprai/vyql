on select_string($n) {\n      $header = $_GET['plural_forms'];\n      $this->STREAM->emit($header);\n    }\n  }\n  ```\n\ntest \"rank2044: the header read back out of preg_match's captures does not reach eval\"\n  lang php\n  file share/server/core/ext/php-gettext-1.0.12/gettext.php\n  reject VYQL-INJ-003\n  code\n  ```\n  <?php\n\n  function select_string($n) {\n    $header = $_GET['plural_forms'];\n    if (preg_match(\"/(^|\\n)plural-forms: ([^\\n]*)\\n/i\", $header, $regs)) {\n      $string = $regs[2];\n    } else {\n      $string = \"nplurals=2; plural=n == 1 ? 0 : 1;\";\n    }\n    $total = 0;\n    $plural = 0;\n    eval(\"$string\");\n    return $plural;\n  }\n  ```","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
