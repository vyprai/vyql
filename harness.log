{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_4cf57d03fe3b48f3a64ba8d7","type":"tool_result","content":"1\tpackage extract_test\n2\t\n3\timport (\n4\t\t\"runtime\"\n5\t\t\"testing\"\n6\t\n7\t\t\"github.com/vyprai/vyql/internal/extract/frontend/treesitter\"\n8\t\t\"github.com/vyprai/vyql/internal/extract/lowering\"\n9\t)\n10\t\n11\t// Allocation ceilings for one extract+lower pass over the deterministic\n12\t// 64-file benchmark corpus. These are a regression gate, not a target:\n13\t// measured-at-land-time with slack. A perf change that lands a win MUST\n14\t// tighten these in the same commit, or the win is unprotected — the\n15\t// --max-ram budget partition was silently lost once precisely because\n16\t// nothing in CI measured memory.\n17\tconst (\n18\t\tmemGateCorpusFiles    = 64\n19\t\tmaxPipelineAllocBytes = 80 << 20  // measured 63.3MB, ×1.25 slack\n20\t\tmaxPipelineAllocs     = 1_300_000 // measured 1.04M, ×1.25 slack\n21\t)\n22\t\n23\tfunc TestPipelineAllocationCeiling(t *testing.T) {\n24\t\tif testing.Short() {\n25\t\t\tt.Skip(\"allocation gate needs a full pipeline pass\")\n26\t\t}\n27\t\tfiles, root := benchCorpus(t, memGateCorpusFiles)\n28\t\n29\t\tvar before, after runtime.MemStats\n30\t\truntime.GC()\n31\t\truntime.ReadMemStats(&before)\n32\t\n33\t\tprog, err := treesitter.ExtractJava(files, root)\n34\t\tif err != nil {\n35\t\t\tt.Fatalf(\"extract: %v\", err)\n36\t\t}\n37\t\tif _, err := lowering.LowerTyped(prog, true, nil); err != nil {\n38\t\t\tt.Fatalf(\"lower: %v\", err)\n39\t\t}\n40\t\n41\t\truntime.ReadMemStats(&after)\n42\t\tallocBytes := after.TotalAlloc - before.TotalAlloc\n43\t\tallocs := after.Mallocs - before.Mallocs\n44\t\tt.Logf(\"pipeline allocated %d bytes in %d allocations\", allocBytes, allocs)\n45\t\tif allocBytes > maxPipelineAllocBytes {\n46\t\t\tt.Errorf(\"allocated %d bytes, ceiling %d\", allocBytes, maxPipelineAllocBytes)\n47\t\t}\n48\t\tif allocs > maxPipelineAllocs {\n49\t\t\tt.Errorf(\"%d allocations, ceiling %d\", allocs, maxPipelineAllocs)\n50\t\t}\n51\t}\n52\t"}]},"parent_tool_use_id":null,"session_id":"f1b7e732-1060-4c03-a560-f041798bec11","uuid":"c82ea784-4d4a-4371-a921-d973f571cf3c","timestamp":"2026-09-16T22:35:31.706Z","tool_use_result":{"type":"text","file":{"filePath":"/campaign/work/engine-the-engine-s-memory-safety-stop-ends-a-whole-repository-scan/internal/extract/memgate_test.go","content":"package extract_test\n\nimport (\n\t\"runtime\"\n\t\"testing\"\n\n\t\"github.com/vyprai/vyql/internal/extract/frontend/treesitter\"\n\t\"github.com/vyprai/vyql/internal/extract/lowering\"\n)\n\n// Allocation ceilings for one extract+lower pass over the deterministic\n// 64-file benchmark corpus. These are a regression gate, not a target:\n// measured-at-land-time with slack. A perf change that lands a win MUST\n// tighten these in the same commit, or the win is unprotected — the\n// --max-ram budget partition was silently lost once precisely because\n// nothing in CI measured memory.\nconst (\n\tmemGateCorpusFiles    = 64\n\tmaxPipelineAllocBytes = 80 << 20  // measured 63.3MB, ×1.25 slack\n\tmaxPipelineAllocs     = 1_300_000 // measured 1.04M, ×1.25 slack\n)\n\nfunc TestPipelineAllocationCeiling(t *testing.T) {\n\tif testing.Short() {\n\t\tt.Skip(\"allocation gate needs a full pipeline pass\")\n\t}\n\tfiles, root := benchCorpus(t, memGateCorpusFiles)\n\n\tvar before, after runtime.MemStats\n\truntime.GC()\n\truntime.ReadMemStats(&before)\n\n\tprog, err := treesitter.ExtractJava(files, root)\n\tif err != nil {\n\t\tt.Fatalf(\"extract: %v\", err)\n\t}\n\tif _, err := lowering.LowerTyped(prog, true, nil); err != nil {\n\t\tt.Fatalf(\"lower: %v\", err)\n\t}\n\n\truntime.ReadMemStats(&after)\n\tallocBytes := after.TotalAlloc - before.TotalAlloc\n\tallocs := after.Mallocs - before.Mallocs\n\tt.Logf(\"pipeline allocated %d bytes in %d allocations\", allocBytes, allocs)\n\tif allocBytes > maxPipelineAllocBytes {\n\t\tt.Errorf(\"allocated %d bytes, ceiling %d\", allocBytes, maxPipelineAllocBytes)\n\t}\n\tif allocs > maxPipelineAllocs {\n\t\tt.Errorf(\"%d allocations, ceiling %d\", allocs, maxPipelineAllocs)\n\t}\n}\n","numLines":52,"startLine":1,"totalLines":52}}}
