{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_63e44a7c75854b1fa28f811d","type":"tool_result","content":"\"\"\"The bounded scan every rank runs.\n\nThe limits are safety limits rather than defaults. A real repository can\nexhaust the machine, so every scan carries a wall-clock timeout and a memory\ncap. Comparing behaviour across definition edits needs the persistent cache\noff, because that cache is keyed for normal use and not for comparing two\ndefinition states.\n\nBuilding the command here means the limits arrive with the command instead of\nbeing remembered. An attempt to override one fails rather than being honoured,\nbecause a caller that wants a bigger cap is a caller running something this\nwrapper is not for.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport subprocess\nfrom pathlib import Path\n\nTIMEOUT_SECONDS = 180\nMANDATORY = {\"--max-ram\": \"4GB\", \"--cache\": \"off\"}\n\n\nclass ScanError(ValueError):\n    \"\"\"A scan that would run without its limits.\"\"\"\n\n\ndef build_argv(\n    target: str,\n    data_dir: str,\n    binary: str = \"vyql\",\n    extra: list[str] | None = None,\n) -> list[str]:\n    if not target or not target.strip():\n        raise ScanError(\"target must be a non-empty path\")\n\n    extra = list(extra or [])\n    for flag, value in MANDATORY.items():\n        if flag in extra:\n            raise ScanError(f\"{flag} is fixed at {value} and cannot be overridden\")\n    if \"-data\" in extra or \"--data\" in extra:\n        raise ScanError(\"-data is set from the data_dir argument, not from extra\")\n\n    argv = [\"timeout\", str(TIMEOUT_SECONDS), binary, \"scan\", \"-data\", data_dir]\n    for flag, value in MANDATORY.items():\n        argv += [flag, value]\n    argv += extra\n    argv.append(target.strip())\n    return argv\n\n\ndef output_runner(argv, cwd: Path, env: dict | None = None) -> tuple[int, str]:\n    \"\"\"Run a scan and return its standard output alone.\n\n    The suite runner merges the two streams, because a benchmark prints its\n    table to either. A scan is parsed as SARIF, so a diagnostic written to\n    standard error would make the document unreadable, and the two runners are\n    separate for that reason rather than by accident.\n    \"\"\"\n    merged = dict(os.environ)\n    merged.update(env or {})\n    completed = subprocess.run(list(argv), cwd=cwd, capture_output=True, text=True,\n                               env=merged, check=False)\n    return completed.returncode, completed.stdout","is_error":false}]},"parent_tool_use_id":null,"session_id":"f1b7e732-1060-4c03-a560-f041798bec11","uuid":"62df8513-3f51-4a4e-86f7-315f0d5e2aa1","timestamp":"2026-09-16T22:36:24.436Z","tool_use_result":{"stdout":"\"\"\"The bounded scan every rank runs.\n\nThe limits are safety limits rather than defaults. A real repository can\nexhaust the machine, so every scan carries a wall-clock timeout and a memory\ncap. Comparing behaviour across definition edits needs the persistent cache\noff, because that cache is keyed for normal use and not for comparing two\ndefinition states.\n\nBuilding the command here means the limits arrive with the command instead of\nbeing remembered. An attempt to override one fails rather than being honoured,\nbecause a caller that wants a bigger cap is a caller running something this\nwrapper is not for.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport subprocess\nfrom pathlib import Path\n\nTIMEOUT_SECONDS = 180\nMANDATORY = {\"--max-ram\": \"4GB\", \"--cache\": \"off\"}\n\n\nclass ScanError(ValueError):\n    \"\"\"A scan that would run without its limits.\"\"\"\n\n\ndef build_argv(\n    target: str,\n    data_dir: str,\n    binary: str = \"vyql\",\n    extra: list[str] | None = None,\n) -> list[str]:\n    if not target or not target.strip():\n        raise ScanError(\"target must be a non-empty path\")\n\n    extra = list(extra or [])\n    for flag, value in MANDATORY.items():\n        if flag in extra:\n            raise ScanError(f\"{flag} is fixed at {value} and cannot be overridden\")\n    if \"-data\" in extra or \"--data\" in extra:\n        raise ScanError(\"-data is set from the data_dir argument, not from extra\")\n\n    argv = [\"timeout\", str(TIMEOUT_SECONDS), binary, \"scan\", \"-data\", data_dir]\n    for flag, value in MANDATORY.items():\n        argv += [flag, value]\n    argv += extra\n    argv.append(target.strip())\n    return argv\n\n\ndef output_runner(argv, cwd: Path, env: dict | None = None) -> tuple[int, str]:\n    \"\"\"Run a scan and return its standard output alone.\n\n    The suite runner merges the two streams, because a benchmark prints its\n    table to either. A scan is parsed as SARIF, so a diagnostic written to\n    standard error would make the document unreadable, and the two runners are\n    separate for that reason rather than by accident.\n    \"\"\"\n    merged = dict(os.environ)\n    merged.update(env or {})\n    completed = subprocess.run(list(argv), cwd=cwd, capture_output=True, text=True,\n                               env=merged, check=False)\n    return completed.returncode, completed.stdout","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
