, to adopt on an existing codebase\")\n241\t\trunOpts := addRunFlags(fs)\n242\t\tif err := parseFlags(fs, args); err != nil {\n243\t\t\treturn err\n244\t\t}\n245\t\tstopProfiling, err := runOpts.apply()\n246\t\tif err != nil {\n247\t\t\treturn err\n248\t\t}\n249\t\tdefer stopProfiling()\n250\t\tpaths := fs.Args()\n251\t\tif len(paths) == 0 {\n252\t\t\t// Scanning the working directory is what a bare `vyql scan` almost always\n253\t\t\t// means. Announced rather than assumed, so the report is never read as\n254\t\t\t// covering somewhere else.\n255\t\t\twarnf(\"no path given; scanning the working directory\")\n256\t\t\tpaths = []string{\".\"}\n257\t\t}\n258\t\t// A filter that cannot reach the output is a filter the operator expected to\n259\t\t// work. Rejected here rather than accepted and ignored.\n260\t\tif err := checkFlagFilters(flagsMode.value, *flagCategory, flagKind.value, *flagLoc); err != nil {\n261\t\t\treturn err\n262\t\t}\n263\t\t// Resolved before the scan runs. A typo here should cost nothing; finding\n264\t\t// out after a multi-minute scan that the gate was never armed is the kind of\n265\t\t// silent no-op this flag exists to prevent.\n266\t\tfailOnRank, err := parseFailOn(*failOn)\n267\t\tif err != nil {\n268\t\t\treturn err\n269\t\t}\n270\t\t// Whether the operator asked for a threshold, as opposed to inheriting one.\n271\t\t// A baseline run reads the two differently, and the flag's value alone cannot\n272\t\t// tell them apart.\n273\t\texplicitFailOn := false\n274\t\tfs.Visit(func(f *flag.Flag) {\n275\t\t\tif f.Name == \"fail-on\" {\n276\t\t\t\texplicitFailOn = true\n277\t\t\t}\n278\t\t})\n279\t\t// Checked up front for the same reason: a combination that cannot mean what\n280\t\t// the user hoped should cost nothing to discover.\n281\t\tif err := checkBaselineFlags(*baseline, *baselineWrite); err != nil {\n282\t\t\treturn err\n283\t\t}\n284\t\t// Loaded up front for the same reason: a bad path or a bad verdict should\n285\t\t// cost nothing, a