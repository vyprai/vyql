{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a25e2deba77a4d32b75c5c65","type":"tool_result","content":"355\t\treturn func() {\n356\t\t\trestore()\n357\t\t\t_ = cache.Close()\n358\t\t}\n359\t}\n360\t\n361\t// applyMaxRAM honors --max-ram: it partitions the budget across the pools a scan provisions,\n362\t// applies the heap ceiling, and routes the graph through the disk-backed BadgerGraph store so\n363\t// node detail can leave RAM. (A target that goes over the one-graph limit is partitioned\n364\t// instead, and each partition is small enough to hold in RAM — see scanPartitionsCollect for\n365\t// why the disk store is bypassed there.) Returns a cleanup func that removes the graph db.\n366\t// Overrides the auto-80% default; an invalid value is reported and ignored.\n367\tfunc applyMaxRAM(v string) func() {\n368\t\tnoop := func() {}\n369\t\tif v == \"\" {\n370\t\t\treturn noop\n371\t\t}\n372\t\tn, err := parseBytes(v)\n373\t\tif err != nil || n <= 0 {\n374\t\t\tfmt.Fprintf(os.Stderr, \"vyql: invalid --max-ram %q (use e.g. 8GB, 16GiB)\\n\", v)\n375\t\t\treturn noop\n376\t\t}\n377\t\tscanSourceLimit, scanSourceBudget = oneGraphSourceBytes(n), sourceBudgetBytes(n)\n378\t\tdir, err := newGraphStoreDir()\n379\t\tif err != nil {\n380\t\t\tdebug.SetMemoryLimit(goHeapMemoryLimit(n))\n381\t\t\tlowering.UseIntStore = true // fallback: lower-footprint in-RAM store\n382\t\t\treturn func() { scanSourceLimit, scanSourceBudget = 0, 0 }\n383\t\t}\n384\t\t// The flag names a ceiling on the whole process, so every pool is carved out of the one\n385\t\t// figure and the heap ceiling is that figure less a reserve for the memory the Go runtime\n386\t\t// does not account for: tree-sitter's C parse trees and badger's mapped tables.\n387\t\t//\n388\t\t// The detail buffer gets an eighth. A buffer large enough to hold the whole scan's node\n389\t\t// detail means nothing ever spills and no blob is ever read back, which is by far the\n390\t\t// cheapest outcome, but the structural graph is live memory too. Spilling earlier leaves\n391\t\t// it room to grow under the same process ceiling.\n392\t\t//\n393\t\t// Badger's block cache gets a sixteenth and no more than half a gigabyte. It is ordinary Go\n394\t\t// heap, because ristretto holds decoded blocks as Go values, so it is spent from the same\n395\t\t// ceiling as the graph itself, and it only earns anything after a spill. A cache sized as a large\n396\t\t// share of the budget fills the ceiling before a node is stored, leaving the collector to\n397\t\t// run against memory it may not release.\n398\t\tlowering.DiskCacheBytes = clampBytes(n/16, min(64<<20, n/16), 512<<20)\n399\t\tlowering.DiskDetailBuf = detailBufferBytes(n)\n400\t\tgraphDir := filepath.Join(dir, \"graph\")\n401\t\tif err := os.MkdirAll(graphDir, 0o700); err != nil {\n402\t\t\tgraphDir = dir\n403\t\t}\n404\t\tlowering.DiskStorePath = graphDir\n405\t\t// A memory-bounded scan must be able to release completed frontend bodies even when\n406\t\t// the user explicitly disables the persistent scan cache. This append-only spool has\n407\t\t// no Badger cache/memtable floor and disappears with the graph directory at cleanup.\n408\t\tvar bodyCache *parsecache.Cache\n409\t\tvar restoreBodies = func() {}\n410\t\tif c, openErr := parsecache.OpenTransient(filepath.Join(dir, \"bodies\")); openErr == nil {\n411\t\t\tbodyCache = c\n412\t\t\trestoreBodies = parsecache.SetShared(c)\n413\t\t}\n414\t\tprev := debug.SetMemoryLimit(-1)\n415\t\t// The Go limit is soft, so place it below the resident watchdog's stop point.\n416\t\t// This buys the collector time to trade CPU for memory before the process as a\n417\t\t// whole reaches the safety threshold.\n418\t\tdebug.SetMemoryLimit(goHeapMemoryLimit(n))\n419\t\treturn func() {\n420\t\t\tdebug.SetMemoryLimit(prev)\n421\t\t\trestoreBodies()\n422\t\t\tif bodyCache != nil {\n423\t\t\t\t_ = bodyCache.Close()\n424\t\t\t}\n425\t\t\tlowering.DiskStorePath = \"\"\n426\t\t\tlowering.DiskCacheBytes, lowering.DiskDetailBuf = 0, 0\n427\t\t\tscanSourceLimit, scanSourceBudget = 0, 0\n428\t\t\t_ = os.RemoveAll(dir) // best-effort temp cleanup\n429\t\t}\n430\t}\n431\t\n432\t// scanSourceLimit is the most analysable source one resident program graph may be built from\n433\t// under the ceiling in force, and scanSourceBudget is how much each partition holds once a\n434\t// target passes it. Both zero — no ceiling was asked for — means the target is scanned as one\n435\t// graph however large it is, which is what every scan did before partitioning existed. Both\n436\t// are in JavaScript-equivalent bytes: PlanPartitions weighs a file by its language's\n437\t// frontend.GraphWeight, so a byte of Python counts as the ~five JavaScript bytes of graph it\n438\t// lowers to, and the constants below stay calibrated on the corpus they were measured on.\n439\tvar (\n440\t\tscanSourceLimit  int64\n441\t\tscanSourceBudget int64\n442\t)\n443\t\n444\t// detailBytesPerSourceByte is how much node detail a byte of source lowers to: type, location,\n445\t// region, scope and the match-path properties of every node the byte becomes. Measured at ~58\n446\t// bytes on the JavaScript corpus, rounded up.\n447\tconst detailBytesPerSourceByte = 64\n448\t\n449\t// detailBufferBytes is the share of the ceiling the node detail buffer gets. See applyMaxRAM\n450\t// for why an eighth, and oneGraphSourceBytes for why the partition sizes are read off it.\n451\tfunc detailBufferBytes(ceiling int64) int64 {\n452\t\treturn clampBytes(ceiling/8, min(64<<20, ceiling/8), 2<<30)\n453\t}\n454\t\n455\t// oneGraphSourceBytes is the most analysable source one resident graph may be built from under\n456\t// a ceiling: past it the scan is partitioned, and inside it nothing about the scan changes.\n457\t//\n458\t// It is read off the node detail buffer rather than the ceiling directly, because that is where\n459\t// the sharp limit is. Memory is the looser one: lowering source costs on the order of two\n460\t// hundred times its own size in live graph and lowering state, and the peak lands mid-lower,\n461\t// before a rule has run — 13MB of JavaScript peaks near 3GB, which a 4GB ceiling does not\n462\t// survive. Detail is the buffer's own arithmetic and lands close to the same place.\n463\tfunc oneGraphSourceBytes(ceiling int64) int64 {\n464\t\tif ceiling <= 0 {\n465\t\t\treturn 0\n466\t\t}\n467\t\treturn detailBufferBytes(ceiling) / detailBytesPerSourceByte\n468\t}\n469\t\n470\t// sourceBudgetBytes is how much source each partition holds once a target is being partitioned.\n471\t//\n472\t// Half the limit, not the limit, because the limit is a cliff rather than a slope: a partition\n473\t// whose detail overruns the buffer spills it to the store, and binding matching then reads\n474\t// every node's detail back. Measured on the same corpus under a 4GB ceiling, 5.2MB of source\n475\t// binds in 13s and 7.8MB in 85s. Half leaves room for source that lowers more densely than what\n476\t// this was measured on.\n477\t//\n478\t// The floor keeps a small ceiling from producing a partition too small to hold a source file.\n479\t// It is the one case where the budget is knowingly above what the buffer holds: a partition\n480\t// that cannot hold one file is not a partition.\n481\tfunc sourceBudgetBytes(ceiling int64) int64 {\n482\t\tif ceiling <= 0 {\n483\t\t\treturn 0\n484\t\t}"}]},"parent_tool_use_id":null,"session_id":"f1b7e732-1060-4c03-a560-f041798bec11","uuid":"359be9df-6f5c-4a0f-8a41-b90ab6ab0389","timestamp":"2026-09-16T22:47:36.194Z","tool_use_result":{"type":"text","file":{"filePath":"/campaign/work/engine-the-engine-s-memory-safety-stop-ends-a-whole-repository-scan/cmd/vyql/main.go","content":"\treturn func() {\n\t\trestore()\n\t\t_ = cache.Close()\n\t}\n}\n\n// applyMaxRAM honors --max-ram: it partitions the budget across the pools a scan provisions,\n// applies the heap ceiling, and routes the graph through the disk-backed BadgerGraph store so\n// node detail can leave RAM. (A target that goes over the one-graph limit is partitioned\n// instead, and each partition is small enough to hold in RAM — see scanPartitionsCollect for\n// why the disk store is bypassed there.) Returns a cleanup func that removes the graph db.\n// Overrides the auto-80% default; an invalid value is reported and ignored.\nfunc applyMaxRAM(v string) func() {\n\tnoop := func() {}\n\tif v == \"\" {\n\t\treturn noop\n\t}\n\tn, err := parseBytes(v)\n\tif err != nil || n <= 0 {\n\t\tfmt.Fprintf(os.Stderr, \"vyql: invalid --max-ram %q (use e.g. 8GB, 16GiB)\\n\", v)\n\t\treturn noop\n\t}\n\tscanSourceLimit, scanSourceBudget = oneGraphSourceBytes(n), sourceBudgetBytes(n)\n\tdir, err := newGraphStoreDir()\n\tif err != nil {\n\t\tdebug.SetMemoryLimit(goHeapMemoryLimit(n))\n\t\tlowering.UseIntStore = true // fallback: lower-footprint in-RAM store\n\t\treturn func() { scanSourceLimit, scanSourceBudget = 0, 0 }\n\t}\n\t// The flag names a ceiling on the whole process, so every pool is carved out of the one\n\t// figure and the heap ceiling is that figure less a reserve for the memory the Go runtime\n\t// does not account for: tree-sitter's C parse trees and badger's mapped tables.\n\t//\n\t// The detail buffer gets an eighth. A buffer large enough to hold the whole scan's node\n\t// detail means nothing ever spills and no blob is ever read back, which is by far the\n\t// cheapest outcome, but the structural graph is live memory too. Spilling earlier leaves\n\t// it room to grow under the same process ceiling.\n\t//\n\t// Badger's block cache gets a sixteenth and no more than half a gigabyte. It is ordinary Go\n\t// heap, because ristretto holds decoded blocks as Go values, so it is spent from the same\n\t// ceiling as the graph itself, and it only earns anything after a spill. A cache sized as a large\n\t// share of the budget fills the ceiling before a node is stored, leaving the collector to\n\t// run against memory it may not release.\n\tlowering.DiskCach