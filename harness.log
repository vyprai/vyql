{"type":"assistant","message":{"id":"msg_20260916140931759cd6b5800a47ed","type":"message","role":"assistant","model":"glm-5.3","content":[{"type":"tool_use","id":"call_d31678e42bd64557847eba4f","name":"Write","input":{"file_path":"/campaign/work/engine-taint-is-not-traced-into-a-variadic-c-function-call-so-a-pri/internal/extract/c_variadic_probe_test.go","content":"package extract_test\n\nimport (\n\t\"testing\"\n\n\t\"github.com/vyprai/vyql/internal/usg\"\n)\n\n// PROBE — not the final test. Establishes what the scanner currently does with\n// taint handed to a variadic C wrapper's tail.\nfunc TestCProbeVariadicTail(t *testing.T) {\n\tg := lowerC(t, \"probe.c\", `\n#include <stdarg.h>\n\nstatic void log_msg(int level, const char *format, ...)\n{\n    va_list ap;\n    va_start(ap, format);\n    vfprintf(stderr, format, ap);\n    va_end(ap);\n}\n\nstatic void report(char *name)\n{\n    log_msg(1, \"scanned %s\", name);\n}\n`)\n\tnodes, err := g.AllNodes()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, n := range nodes {\n\t\tif n.Type != \"code.Call\" {\n\t\t\tcontinue\n\t\t}\n\t\tt.Logf(\"call %s callee=%s\", n.Loc, n.Prop(\"callee_path\"))\n\t\tfor i := 0; i < 6; i++ {\n\t\t\tif a := n.Prop(usg.ArgPropKey(i)); a != \"\" {\n\t\t\t\tan, ok, _ := g.GetNode(a)\n\t\t\t\tif ok {\n\t\t\t\t\tt.Logf(\"  arg%d -> %s (%s)\", i, an.ID, an.Loc)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tparams, _ := g.NodesOfType(\"code.Param\")\n\tfor _, id := range params {\n\t\tn, ok, _ := g.GetNode(id)\n\t\tif ok {\n\t\t\tt.Logf(\"param %s name=%s func=%s\", n.Loc, n.Prop(\"name\"), n.Prop(\"func\"))\n\t\t}\n\t}\n\t// does the report() call's third argument reach the vfprintf call at all?\n\tlogCall := callAt(t, g, \"probe.c:16\")\n\treachable, err := usg.BFS(g, logCall, \"FLOWS\", 60)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, n := range nodes {\n\t\tif n.Type == \"code.Call\" && n.Prop(\"callee_path\") == \"vfprintf\" {\n\t\t\thit := false\n\t\t\tfor i := 0; i < 4; i++ {\n\t\t\t\tif a := n.Prop(usg.ArgPropKey(i)); a != \"\" && reachable[a] {\n\t\t\t\t\thit = true\n\t\t\t\t}\n\t\t\t}\n\t\t\tt.Logf(\"vfprintf at %s reached-from-log-call=%v\", n.Loc, hit)\n\t\t}\n\t}\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"b2e47c8b-b052-45f8-b9f8-606406eb025a","uuid":"f20702e4-dde8-49f6-8b31-0c52c72dc949","timestamp":"2026-09-16T06:09:43.310Z"}
