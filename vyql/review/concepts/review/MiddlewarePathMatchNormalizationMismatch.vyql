module code;

review code.MiddlewarePathMatchNormalizationMismatch {
  category: access_control
  expected: [core.AuthorizationCheck]
  kind: attention
  text: "review every path a component derives from the request itself so it agrees with the router on duplicate slashes, trailing slashes, case, parameter delimiters and which percent escapes are decoded, because the router's answer is what decided the middleware"
}
