}
review code.ShortSecurityIdentifier {
  category: "crypto"
  kind: "attention"
  text: "review shortened security identifiers for collision-resistant trust decisions"
}
review code.SecurityKeyTrustOperation {
  category: "crypto"
  kind: "target"
  text: "verify trust/key operations use a full collision-resistant identifier"
}
review code.PublicKeyHashBindingReview {
  category: "crypto"
  kind: "attention"
  text: "review signature verification flows that accept a public key without checking it matches the committed key hash"
}
review code.SecretComparisonReview {
  category: "crypto"
  kind: "attention"
  text: "review secret comparisons for ordinary equality or early-exit behavior where constant-time comparison is expected"
}
review code.PremasterSecretLengthReview {
  category: "crypto"
  kind: "attention"
  text: "review TLS RSA premaster-secret decryption for exact 48-byte length validation and indistinguishable fallback behavior"
}
review code.ResourceReview {
  category: "resource"
  kind: "target"
  expected: [core.ResourceRelease]
  text: "verify resource usage is bounded, timed out, and released"
}
review code.UnboundedResourceOperation {
  category: "resource"
  kind: "attention"
  text: "review long-lived resource operation for timeouts, message limits, and cancellation"
}
review code.UnboundedStateGrowthReview {
  category: "resource"
  kind: "attention"
  text: "review state keyed by attacker-controlled or high-cardinality values for fail-closed limits"
