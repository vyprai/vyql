}
review code.PackageVersionSpecifierValidationReview {
  category: "supply_chain"
  kind: "attention"
  expected: [core.InputValidation]
  text: "review package version specifier validation before using the specifier in package installation"
}
review code.CommandLineAssemblyReview {
  category: "command"
  kind: "attention"
