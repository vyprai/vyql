  text: "verify algorithm choice, key/IV handling, and signature or certificate checks"
}
review code.HeaderControlledJwkReview {
  category: "crypto"
  kind: "attention"
  text: "review signature or decryption key selection for fallback to attacker-controlled JWK header data"
}
review code.AuthenticatedDecryptionTagReview {
  category: "crypto"
  kind: "attention"
  text: "review authenticated decryption tag validation for fixed length and fail-closed behavior"
}
review code.ExternalResourceIntegrityReview {
