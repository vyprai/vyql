review code.UnboundedDelimiterSplitCount {
  category: "resource"
  kind: "attention"
  text: "review delimiter counting that fully splits attacker-sized input before enforcing the count limit"
}
review code.LengthDerivedAllocation {
  category: "resource"
  kind: "attention"
  text: "review length-derived allocation for a dominating remaining-buffer or maximum-size check"
}
review code.ReachableAssertionReview {
  category: "resource"
  kind: "attention"
  text: "review externally reachable validation paths that can violate internal assertions or invariants"
}
review code.StructuredInputDecode {
  category: "input_validation"
