import core.*
import code.*

review core.AuthenticationCheck {
  category: "auth"
  kind: "check"
}
review core.AuthorizationCheck {
  category: "auth"
  kind: "check"
}
review core.OwnershipCheck {
  category: "auth"
  kind: "check"
}
review core.CsrfProtection {
  category: "request"
  kind: "check"
}
review core.ResourceRelease {
  category: "resource"
  kind: "check"
}
review core.LockRelease {
  category: "concurrency"
  kind: "check"
}
review core.XmlHardening {
  category: "xml"
  kind: "check"
}
review core.CertificateValidation {
  category: "crypto"
  kind: "check"
}
review core.EncryptionAtRest {
  category: "crypto"
  kind: "check"
}
review core.EncryptionInTransit {
  category: "crypto"
  kind: "check"
}

review code.AuthenticationRequiredOp {
  category: "auth"
  kind: "target"
  expected: [core.AuthenticationCheck]
  text: "verify an authenticated user is required before this operation"
}
review code.UnqualifiedDatabaseRoutineReview {
  category: "path"
  kind: "attention"
  text: "review database routine references for explicit trusted schema qualification"
}
review code.AuthFlowBypassReview {
  category: "auth"
  kind: "attention"
  expected: [core.AuthenticationCheck]
  text: "review alternate UI or navigation exit paths in this authentication flow"
}
review code.MissingSessionRotationAfterAuthentication {
  category: "auth"
  kind: "attention"
  expected: [core.AuthenticationCheck]
  text: "review successful authentication flows that reuse the pre-login HTTP session instead of rotating it"
}
review code.LocalRequestBypassReview {
  category: "auth"
  kind: "attention"
  expected: [core.AuthenticationCheck, core.AuthorizationCheck]
  text: "review localhost or local-request bypasses on protected routes"
}
review code.PrivilegedEntryPointReview {
  category: "auth"
  kind: "attention"
  expected: [core.AuthorizationCheck]
  text: "review privileged entry point dispatch and caller privilege checks"
}
review code.IgnoredAuthorizationResult {
  category: "auth"
  kind: "attention"
  expected: [core.AuthorizationCheck]
  text: "review authorization check result usage; a failed check must stop the operation"
}
review code.CredentialedEndpointReview {
  category: "auth"
  kind: "attention"
  expected: [core.AuthorizationCheck]
  text: "review credentialed test endpoint for admin permission and request-method guards"
}
review code.TimeBoundAccessTokenReview {
  category: "auth"
  kind: "attention"
  text: "review generated access tokens or signed URLs for configurable, appropriately bounded expiration"
}
review code.AuthAttemptLimitReview {
  category: "auth"
  kind: "attention"
  expected: [core.RateLimit]
  text: "review authentication challenge or failed-attempt limit logic for brute-force resistance and concurrent bypasses"
}
review code.ProtocolFrameBindingReview {
  category: "auth"
  kind: "attention"
  expected: [core.AuthenticationCheck]
  text: "review protocol frame/session identifier binding before accepting the frame as belonging to an existing authenticated session"
}
review code.AuthFailureResponseReview {
  category: "auth"
  kind: "attention"
  expected: [core.AuthenticationCheck]
  text: "review authentication verification error responses for fail-closed unauthorized behavior expected by the proxy"
}
review code.ClientAuthFailureResponseReview {
  category: "auth"
  kind: "attention"
  expected: [core.AuthenticationCheck]
  text: "review client-side unauthorized response handling before invoking privileged success callbacks"
}
review code.ObjectLookupByUserInput {
  category: "auth"
  kind: "target"
  expected: [core.OwnershipCheck, core.AuthorizationCheck]
  text: "verify object access is constrained to the current principal"
}
review code.DeserializableInvocationHandler {
  category: "deserialization"
  kind: "attention"
  text: "review serializable dynamic-proxy invocation handlers that dispatch reflected or scripted methods without a deserialization rejection hook"
}
review code.RequestSelectedDeserializationFormat {
  category: "deserialization"
  kind: "attention"
  text: "review request-selected deserialization formats for unsafe codecs such as pickle"
}
review code.MethodGatedRedirectValidationBypass {
  category: "request_forgery"
  kind: "attention"
  expected: [core.RedirectAllowlist]
  text: "review HTTP method gates that skip redirect or callback URL origin validation"
}
review code.ChecksumErrorLogoutRedirect {
  category: "request_forgery"
  kind: "attention"
  expected: [core.RedirectAllowlist]
  text: "review checksum-error redirect handling that can fall back to request-supplied logout URLs"
}
review code.RequestHostUrlValidationBypass {
  category: "request_forgery"
  kind: "attention"
  expected: [core.AllowlistValidation]
  text: "review URL host validation that trusts request Host or server-name metadata instead of a configured allowlist"
}
review code.SensitiveOperation {
  category: "auth"
  kind: "target"
  expected: [core.AuthorizationCheck]
  text: "verify this privileged or destructive operation enforces authorization"
}
review code.AccessPolicyReview {
  category: "auth"
  kind: "attention"
  expected: [core.AuthorizationCheck]
  text: "review role or group policy configuration for overly broad access"
}
review code.RequestScopePolicyReview {
  category: "auth"
  kind: "attention"
  expected: [core.AuthorizationCheck]
  text: "review request/resource scope consistency before dispatching the resource handler"
}
review code.UserIdentityMappingReview {
  category: "auth"
  kind: "attention"
  expected: [core.AuthorizationCheck]
  text: "review external identity to local UID/GID mapping for collision resistance and durable uniqueness"
}
review code.AdmissionSubresourcePolicyReview {
  category: "auth"
  kind: "attention"
  expected: [core.AuthorizationCheck]
  text: "review subresource admission handling for alternate paths that bypass the primary resource policy"
}
review code.WorkflowPolicyReview {
  category: "auth"
  kind: "attention"
  expected: [core.AuthorizationCheck]
  text: "review workflow or status checks before this protected business action"
}
review code.IdorPolicyReview {
  category: "auth"
  kind: "attention"
  expected: [core.OwnershipCheck, core.AuthorizationCheck]
  text: "review object lookup or delete criteria for a current-principal ownership constraint"
}
review code.IncompleteIpDenylist {
  category: "request"
  kind: "attention"
  text: "review network address validation for missing special-use IP ranges such as unspecified or broadcast"
}
review code.ProtocolStateReview {
  category: "request"
  kind: "attention"
  text: "review protocol/state transitions for out-of-sequence, stale, or unauthenticated data accepted without the required state check"
}
review code.StateChangingOp {
  category: "request"
  kind: "target"
  expected: [core.CsrfProtection, core.AuthenticationCheck]
  text: "verify state-changing request paths have CSRF protection and auth context"
}
review code.CsrfDisabled {
  category: "request"
  kind: "target"
  expected: [core.CsrfProtection]
  text: "review why CSRF protection is disabled or exempted here"
}
review code.IncompleteCsrfTokenValidation {
  category: "request"
  kind: "attention"
  expected: [core.CsrfProtection]
  text: "review CSRF token validation for empty-token acceptance or missing freshness checks"
}
review code.MissingHttpMethodAssertion {
  category: "csrf"
  kind: "attention"
  expected: [core.CsrfProtection, core.AuthenticationCheck]
  text: "review state-changing HTTP actions for explicit allowed-method assertions"
