module bindings.kotlin.migration.m304d1620;

binding missingFrameProtection123 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "setHeader" and node.token contains "X-Frame-Options" and node.token contains "ALLOWALL"
  emit issue code.MissingFrameProtection at node
}
