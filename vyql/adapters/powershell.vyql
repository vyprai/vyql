// powershell framework adapter (docs/07) — framework→concept content.
// A cmdlet/command is modeled as a call; $env:CGI vars + param() are sources.
adapter powershell {
  meta { fidelity: resolved }

  // untrusted input
  source "shell_input" -> code.HttpInput
  source "http_input" -> code.HttpInput

  // code evaluation
  sink path "Invoke-Expression" -> code.CodeEval
  sink path "iex" -> code.CodeEval
  sink path "Invoke-Command" -> code.CodeEval

  // command / process execution
  sink path "Start-Process" -> code.CommandExecution
  sink path "&" -> code.CommandExecution
  sink path "cmd" -> code.CommandExecution
  sink path "cmd.exe" -> code.CommandExecution
  sink path "powershell" -> code.CommandExecution

  // SSRF / remote fetch
  sink path "Invoke-WebRequest" -> code.UrlFetch
  sink path "Invoke-RestMethod" -> code.UrlFetch
  sink path "iwr" -> code.UrlFetch
  sink path "wget" -> code.UrlFetch
  sink path "curl" -> code.UrlFetch
  sink path "Select-String" -> code.RegexCompile
  mark "Invoke-WebRequest" val "http://" nval "127.0" -> code.CleartextChannel
  mark "Invoke-RestMethod" val "http://" nval "127.0" -> code.CleartextChannel
  mark "iwr" val "http://" nval "127.0" -> code.CleartextChannel
  mark "wget" val "http://" nval "127.0" -> code.CleartextChannel
  mark "curl" val "http://" nval "127.0" -> code.CleartextChannel

  // SQL
  sink path "Invoke-Sqlcmd" -> code.SqlExecution

  // deserialization (CWE-502) — Import-Clixml reconstructs arbitrary objects
  sink path "Import-Clixml" -> code.Deserialization

  // XXE (CWE-611) — Select-Xml / XML cmdlets
  sink path "Select-Xml" -> code.XmlParse

  // path / file
  sink path "Get-Content" -> code.FilePathAccess
  sink path "Set-Content" -> code.FilePathAccess
  sink path "Add-Content" -> code.FilePathAccess
  sink path "Out-File" -> code.FilePathAccess
  sink path "Remove-Item" -> code.FilePathAccess
  sink path "Copy-Item" -> code.FilePathAccess
  sink path "Move-Item" -> code.FilePathAccess
  sink path "Rename-Item" -> code.FilePathAccess
  sink path "New-Item" -> code.FilePathAccess
  sink path "Test-Path" -> code.FilePathAccess
  sink path "Import-Module" -> code.DynamicCodeLoad

}
