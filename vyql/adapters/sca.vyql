// Supply-chain package analysis events. Go owns manifest parsing, package
// normalization, version matching, and reachability algorithms; this adapter
// assigns security concepts to the neutral package tokens those algorithms emit.
adapter sca {
  meta { fidelity: resolved, cross_language: true, auto_apply: graph }

  flag sbom.VulnerableDependency on any {
    path exact "analysis.sca.package"
    fact status "vulnerable"
  }
  flag sbom.HttpRequestSmugglingDependency on any {
    path exact "analysis.sca.package"
    fact advisory_cwe "CWE-444"
  }
  flag sbom.HttpRequestSmugglingDependency on any {
    path exact "analysis.sca.package"
    fact advisory_cwe "CWE_444"
  }
  flag sbom.CertValidationDependency on any {
    path exact "analysis.sca.package"
    fact advisory_cwe "CWE-295"
  }
  flag sbom.CertValidationDependency on any {
    path exact "analysis.sca.package"
    fact advisory_cwe "CWE_295"
  }
  flag sbom.SuspiciousDependency on any {
    path exact "analysis.sca.package"
    fact status "suspicious"
  }
  flag sbom.MaliciousDependency on any {
    path exact "analysis.sca.package"
    fact status "malicious"
  }
  flag sbom.MaliciousDependency on any {
    path exact "analysis.sca.package"
    fact advisory_cwe "CWE-506"
  }
  flag sbom.MaliciousDependency on any {
    path exact "analysis.sca.package"
    fact advisory_cwe "CWE_506"
  }
  flag sbom.ReachableSymbol on any {
    path exact "analysis.sca.package"
    fact reachable "true"
  }
}
