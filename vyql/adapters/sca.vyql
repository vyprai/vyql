// Supply-chain package analysis events. Go owns manifest parsing, package
// normalization, version matching, and reachability algorithms; this adapter
// assigns security concepts to the neutral package tokens those algorithms emit.
adapter sca {
  meta { fidelity: resolved, cross_language: true, auto_apply: graph }

  mark exact "analysis.sca.package" val "status=vulnerable" -> sbom.VulnerableDependency
  mark exact "analysis.sca.package" val "advisory_cwe=CWE-444" -> sbom.HttpRequestSmugglingDependency
  mark exact "analysis.sca.package" val "advisory_cwe=CWE_444" -> sbom.HttpRequestSmugglingDependency
  mark exact "analysis.sca.package" val "status=suspicious" -> sbom.SuspiciousDependency
  mark exact "analysis.sca.package" val "status=malicious" -> sbom.MaliciousDependency
  mark exact "analysis.sca.package" val "reachable=true" -> sbom.ReachableSymbol
}
