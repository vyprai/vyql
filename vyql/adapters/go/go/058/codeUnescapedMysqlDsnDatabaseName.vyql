module bindings.go.migration.m48a985c1;

binding unescapedMysqlDsnDatabaseName58 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=go" and node.token contains "call_path:sql.NewParserFromAlterStatement" and node.token contains "selector:migrationContext.DatabaseName" and not (node.token contains "call_path:url.QueryEscape")
  emit issue code.UnescapedMysqlDsnDatabaseName at node
}
