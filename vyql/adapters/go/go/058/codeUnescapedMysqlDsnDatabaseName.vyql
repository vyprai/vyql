binding unescapedMysqlDsnDatabaseName58 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=go" and node.token contains "call_path:sql.NewParserFromAlterStatement" and node.token contains "selector:migrationContext.DatabaseName" and not (node.token contains "call_path:url.QueryEscape")
