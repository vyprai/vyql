binding logWrite155 {
  query pattern presenceNode where node.scope == "function" and node.token contains "function_name:NewClient" and node.token contains "call_path:log.Infof" and node.token contains "literal:Loaded client config: %#v" and node.token contains "selector:cfg.Spec"
