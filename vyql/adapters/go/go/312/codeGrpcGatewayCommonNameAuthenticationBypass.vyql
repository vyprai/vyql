module bindings.go.migration.m48a985c1;

binding grpcGatewayCommonNameAuthenticationBypass312 {
  query pattern presenceNode where node.scope == "function" and node.token contains "call_path:peer.FromContext" and node.token contains "selector:tlsInfo.State.VerifiedChains" and node.token contains "selector:chains.Subject.CommonName" and not (node.token contains "literal:grpcgateway-accept")
