binding charmRouteFileStorePathAccess279 {
  query pattern presenceNode where node.scope == "function" and node.token contains "function_name:handleGetFile" and node.token contains "call_path:pattern.Path" and node.token contains "call_path:s.cfg.FileStore.Get" and not (node.token contains "call_path:filepath.Clean")
