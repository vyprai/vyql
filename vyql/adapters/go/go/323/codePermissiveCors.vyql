module bindings.go.migration.m48a985c1;

binding permissiveCors323 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "Header.Add" and node.token contains "Access-Control-Allow-Origin" and node.token contains "*"
  emit issue code.PermissiveCors at node
}
