module bindings.go.migration.m48a985c1;

binding tpmDiskKeyWeakPcrSealing54 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "module" and node.token contains "var_name:DiskKeySealingPCRs" and node.token contains "tpm2.PCRSelection" and node.token contains "Hash:tpm2.AlgSHA1" and node.token contains "PCRs:[]int{0,1,2,3,4,6,7,8,9,13}" and not (node.token contains "AlgSHA256")
  emit issue code.TpmDiskKeyWeakPcrSealing at node
}
