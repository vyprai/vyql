module bindings.go.migration.m48a985c1;

binding secretComparisonReview300 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "call_path:scrypt.Key" and node.token contains "call_path:bytes.Equal" and node.token contains "call_arg:bytes.Equal:source_master_key" and node.token contains "call_arg:bytes.Equal:target_master_key" and not (node.scopeCall.any contains "ConstantTimeCompare") and not (node.token contains "call_path:hmac.Equal") and not (node.token contains "call_path:subtle.ConstantTimeCompare")
  emit issue code.SecretComparisonReview at node
}
