binding csrfDisabled310 {
  query pattern presenceNode where node.scope == "function" and node.token contains "function_name:CheckOrigin" and node.token contains "param_type:http.Request" and node.token contains "return:true" and not (node.token contains "call_path:r.Header.Get") and not (node.token contains "selector:r.Host")
  emit issue code.CsrfDisabled at node
}
