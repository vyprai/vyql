module bindings.go.migration.m48a985c1;

binding csrfDisabled310 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "function_name:CheckOrigin" and node.token contains "param_type:http.Request" and node.token contains "return:true" and not (node.token contains "call_path:r.Header.Get") and not (node.token contains "selector:r.Host")
  emit issue code.CsrfDisabled at node
}
