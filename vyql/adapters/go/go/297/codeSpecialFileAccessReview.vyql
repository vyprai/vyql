module bindings.go.migration.m48a985c1;

binding specialFileAccessReview297 {
  query pattern presenceNode where node.scope == "function" and node.context.callPath contains "os.OpenFile" and node.context.literal contains "/proc/self/attr/exec" and not (node.scopeCall.any contains "OpenProcRoot") and not (node.scopeCall.any contains "OpenThreadSelf") and not (node.context.callPath contains "pathrs.Reopen")
  emit issue code.SpecialFileAccessReview at node
}
