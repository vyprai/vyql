module bindings.go.migration.m48a985c1;

binding unqualifiedDatabaseRoutineReview288 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "literal:SELECT 'aurora_global_db_instance_status'::regproc" and not (node.token contains "pg_catalog.aurora_global_db_instance_status")
  emit issue code.UnqualifiedDatabaseRoutineReview at node
}
