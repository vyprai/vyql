module bindings.go.migration.m48a985c1;

binding containerPrimaryGidMissingSupplementalGroup231 {
  query pattern presenceNode where node.scope == "function" and node.token contains "function_name:setupContainerUser" and node.token contains "call_path:specgen.SetProcessGID" and node.token contains "selector:sc.RunAsGroup" and node.token contains "call_path:specgen.AddProcessAdditionalGid" and not (node.token contains "call_arg:specgen.AddProcessAdditionalGid:gid")
  emit issue code.ContainerPrimaryGidMissingSupplementalGroup at node
}
