module bindings.go.migration.m48a985c1;

binding inheritedProcessEnvironmentLeak229 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "call_path:unshare.Command" and node.token contains "selector:cmd.Env" and node.token contains "call_path:os.Environ" and node.token contains "literal:LOGLEVEL=%d"
