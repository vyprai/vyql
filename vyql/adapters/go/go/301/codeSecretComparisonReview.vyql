module bindings.go.migration.m48a985c1;

binding secretComparisonReview301 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "binop" and node.op in ["==", "!="] and not (containsAny(node.scopeCall.any, [ConstantTimeCompare, hmac.Equal, subtle.ConstantTimeCompare, CompareHashAndPassword])) and operand(node, where: containsAny(operand.key, [".Password", ".password", ".Secret", ".secret", ".Token", ".token", ".APIKey", ".apiKey", ".AccessKey", ".accessKey"])) and operand(node, where: containsAny(operand.key, [".Password", ".password", ".Secret", ".secret", ".Token", ".token", ".APIKey", ".apiKey", ".AccessKey", ".accessKey"]))
  emit issue code.SecretComparisonReview at node
}
