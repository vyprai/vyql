module bindings.go.migration.m48a985c1;

binding protocolStateReview240 {
  query pattern presenceNode where node.scope == "function" and node.token contains "call_path:pc.c.WriteMsg" and node.token contains "call_path:pc.c.ReadMsg" and node.token contains "call_path:pc.c.Close" and node.token contains "selector:state.Req.Id" and node.token contains "selector:ret.Id" and not (node.token contains "selector:net.Error") and not (node.token contains "binary:proto==\"udp\"")
  emit issue code.ProtocolStateReview at node
}
