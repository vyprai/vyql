module bindings.go.migration.m48a985c1;

binding insecurePermission224 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "os.MkdirAll" and node.token contains "0777"
  emit issue code.InsecurePermission at node
}
