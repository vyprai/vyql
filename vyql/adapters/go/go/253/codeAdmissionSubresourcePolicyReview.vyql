binding admissionSubresourcePolicyReview253 {
  query pattern presenceNode where node.scope == "function" and node.context.functionName contains "shouldIgnore" and node.context.call contains "GetSubresource" and not (node.token contains "ignoredSubresources")
  emit issue code.AdmissionSubresourcePolicyReview at node
}
