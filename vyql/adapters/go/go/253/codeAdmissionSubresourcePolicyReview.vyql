module bindings.go.migration.m48a985c1;

binding admissionSubresourcePolicyReview253 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "function_name:shouldIgnore" and node.token contains "call:GetSubresource" and not (node.token contains "ignoredSubresources")
  emit issue code.AdmissionSubresourcePolicyReview at node
}
