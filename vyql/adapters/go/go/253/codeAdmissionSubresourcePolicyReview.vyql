module bindings.go.migration.m48a985c1;

binding admissionSubresourcePolicyReview253 {
  query pattern presenceNode where node.scope == "function" and node.token contains "function_name:shouldIgnore" and node.token contains "call:GetSubresource" and not (node.token contains "ignoredSubresources")
  emit issue code.AdmissionSubresourcePolicyReview at node
}
