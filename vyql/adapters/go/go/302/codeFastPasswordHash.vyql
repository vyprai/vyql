module bindings.go.migration.m48a985c1;

binding fastPasswordHash302 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "function_name:GenerateUsers" and node.token contains "user.Password" and node.token contains "sha256sum" and not (node.token contains "GenerateFromPassword") and not (node.token contains "bcrypt") and not (node.token contains "argon2") and not (node.token contains "scrypt")
  emit issue code.FastPasswordHash at node
}
