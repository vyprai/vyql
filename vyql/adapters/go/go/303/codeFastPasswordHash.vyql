module bindings.go.migration.m48a985c1;

binding fastPasswordHash303 {
  query pattern presenceNode where node.scope == "function" and node.context.functionName contains "FindByPassword" and node.token contains "user.Password" and node.token contains "sha256sum" and not (node.token contains "CompareHashAndPassword") and not (node.token contains "bcrypt") and not (node.token contains "argon2") and not (node.token contains "scrypt")
  emit issue code.FastPasswordHash at node
}
