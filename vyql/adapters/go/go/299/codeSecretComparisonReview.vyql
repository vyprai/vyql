binding secretComparisonReview299 {
  query pattern presenceNode where node.scope == "function" and node.token contains "call:BasicAuth" and node.token contains "binary:username==wrapper.username" and node.token contains "binary:password==wrapper.password" and not (node.scopeCall.any contains "ConstantTimeCompare")
  emit issue code.SecretComparisonReview at node
}
