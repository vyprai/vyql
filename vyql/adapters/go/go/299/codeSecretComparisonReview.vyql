module bindings.go.migration.m48a985c1;

binding secretComparisonReview299 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "call:BasicAuth" and node.token contains "binary:username==wrapper.username" and node.token contains "binary:password==wrapper.password" and not (node.scopeCall.any contains "ConstantTimeCompare")
  emit issue code.SecretComparisonReview at node
}
