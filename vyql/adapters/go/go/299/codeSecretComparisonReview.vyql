binding secretComparisonReview299 {
  query pattern presenceNode where node.scope == "function" and node.context.call contains "BasicAuth" and node.context.binary contains "username==wrapper.username" and node.context.binary contains "password==wrapper.password" and not (node.context.scopeCall contains "ConstantTimeCompare")
  emit issue code.SecretComparisonReview at node
}
