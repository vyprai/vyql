module bindings.go.migration.m48a985c1;

binding missingFrameProtection326 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "Header.Add" and node.token contains "X-Frame-Options" and node.token contains "ALLOWALL"
  emit issue code.MissingFrameProtection at node
}
