module bindings.go.migration.m48a985c1;

binding kubernetesTemplateSecretLookupExposure237 {
  query pattern presenceNode where node.scope == "function" and node.token contains "call_path:ctrlcfg.GetConfig" and node.token contains "call_path:kubernetes.NewForConfig" and node.token contains "call_path:clientset.CoreV1.Secrets.Get" and node.token contains "call_arg:clientset.CoreV1.Secrets:namespace" and node.token contains "index:secret.Data" and node.token contains "index:secret.Data:keyName" and not (containsAny(node.scopeCall.any, [SelfSubjectAccessReview, SubjectAccessReview, CheckAccess, Authorize]))
  emit issue code.KubernetesTemplateSecretLookupExposure at node
}
