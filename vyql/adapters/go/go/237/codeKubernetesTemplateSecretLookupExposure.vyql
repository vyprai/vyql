module bindings.go.migration.m48a985c1;

binding kubernetesTemplateSecretLookupExposure237 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "call_path:ctrlcfg.GetConfig" and node.token contains "call_path:kubernetes.NewForConfig" and node.token contains "call_path:clientset.CoreV1.Secrets.Get" and node.token contains "call_arg:clientset.CoreV1.Secrets:namespace" and node.token contains "index:secret.Data" and node.token contains "index:secret.Data:keyName" and not (containsAny(node.scopeCall.any, [SelfSubjectAccessReview, SubjectAccessReview, CheckAccess, Authorize]))
  emit issue code.KubernetesTemplateSecretLookupExposure at node
}
