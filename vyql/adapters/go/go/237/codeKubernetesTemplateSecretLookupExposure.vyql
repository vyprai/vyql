module bindings.go.migration.m48a985c1;

binding kubernetesTemplateSecretLookupExposure237 {
  query pattern presenceNode where node.scope == "function" and node.context.callPath contains "ctrlcfg.GetConfig" and node.context.callPath contains "kubernetes.NewForConfig" and node.context.callPath contains "clientset.CoreV1.Secrets.Get" and node.context.callArg contains "clientset.CoreV1.Secrets:namespace" and node.context.index contains "secret.Data" and node.context.index contains "secret.Data:keyName" and not (containsAny(node.scopeCall.any, [SelfSubjectAccessReview, SubjectAccessReview, CheckAccess, Authorize]))
  emit issue code.KubernetesTemplateSecretLookupExposure at node
}
