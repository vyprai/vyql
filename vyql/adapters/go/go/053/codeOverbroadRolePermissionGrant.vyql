binding overbroadRolePermissionGrant53 {
  query pattern presenceNode where node.scope == "module" and node.context.varName contains "PermissionsByRole" and node.token contains "RoleNetworkManager" and node.token contains "PermBackup" and node.token contains "PermRestore" and not (node.token contains "RoleAdmin:{PermBackup,PermRestore")
