binding overbroadRolePermissionGrant53 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "module" and node.token contains "var_name:PermissionsByRole" and node.token contains "RoleNetworkManager" and node.token contains "PermBackup" and node.token contains "PermRestore" and not (node.token contains "RoleAdmin:{PermBackup,PermRestore")
