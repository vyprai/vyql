module bindings.go.migration.m48a985c1;

binding emptyVerifierAcceptance149 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "function_name:Verify" and node.token contains "call:Get" and node.token contains "binary:v==answer" and not (node.token contains "binary:v!=\"\"")
  emit issue code.EmptyVerifierAcceptance at node
}
