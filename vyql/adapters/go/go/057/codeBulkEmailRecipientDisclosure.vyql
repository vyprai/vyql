binding bulkEmailRecipientDisclosure57 {
  query pattern presenceNode where node.scope == "function" and containsAny(node.token, ["call_path:SendIssueCommentMail", "call_path:SendIssueMentionMail", "call_path:SendMail", "call_path:SendEmail", "call_path:SendNotification", "call_path:SendNotificationMail", "call_path:SendNotificationEmail"]) and node.context.callPath contains "append" and node.context.selector contains ".Email" and containsAny(node.token, ["call_arg:SendIssueCommentMail:tos", "call_arg:SendIssueMentionMail:getUserEmailsByNames", "call_arg:SendMail:tos", "call_arg:SendMail:recipients", "call_arg:SendEmail:recipients", "call_arg:SendEmail:emails", "call_arg:SendNotification:recipients", "call_arg:SendNotificationMail:recipients", "call_arg:SendNotificationEmail:recipients"]) and not (node.context.callArg contains "__object_literal") and not (containsAny(node.token, ["call_path:Bcc", "call_path:BlindCopy"]))
  emit issue code.BulkEmailRecipientDisclosure at node
}
