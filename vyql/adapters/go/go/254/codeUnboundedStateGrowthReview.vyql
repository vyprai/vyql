module bindings.go.migration.m48a985c1;

binding unboundedStateGrowthReview254 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "call:LoadOrStore" and node.token contains "literal:overflow"
  emit issue code.UnboundedStateGrowthReview at node
}
