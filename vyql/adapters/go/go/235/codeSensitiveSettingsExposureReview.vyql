module bindings.go.migration.m48a985c1;

binding sensitiveSettingsExposureReview235 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "settingspkg.Settings" and node.token contains "PasswordPattern"
  emit issue code.SensitiveSettingsExposureReview at node
}
