module bindings.go.migration.m48a985c1;

binding ciliumCliEtcdInitMountMismatch277 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "function_name:generateDeployment" and node.token contains "literal:etcd-init" and node.token contains "field:MountPath=etcd-data-dir" and node.token contains "field:Args"
  emit issue code.CiliumCliEtcdInitMountMismatch at node
}
