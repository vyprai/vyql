module bindings.go.migration.m48a985c1;

binding protocolStateReview239 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "PrevATXID" and node.token contains "call:GetLastIDByNodeID"
  emit issue code.ProtocolStateReview at node
}
