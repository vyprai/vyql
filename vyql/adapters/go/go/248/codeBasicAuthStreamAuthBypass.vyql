module bindings.go.migration.m48a985c1;

binding basicAuthStreamAuthBypass248 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path == "Options" and node.token contains "BasicAuthEnabled" and node.token contains "Creds" and not (node.token contains "AuthRequired")
  emit issue code.BasicAuthStreamAuthBypass at node
}
