binding tenantServiceAccountAdmissionBypass245 {
  query pattern presenceNode where node.scope == "function" and node.token contains "function_name:IsCapsuleUser" and node.token contains "call:NewUserGroupList" and node.token contains "literal:system:serviceaccounts:kube-system" and node.token contains "call:Find" and not (node.scopeCall.any contains "MatchingFieldsSelector") and not (node.token contains "literal:.status.namespaces")
  emit issue code.TenantServiceAccountAdmissionBypass at node
}
