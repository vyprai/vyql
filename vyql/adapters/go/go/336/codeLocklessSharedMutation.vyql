module bindings.go.migration.m48a985c1;

binding locklessSharedMutation336 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path == "analysis.global.mutation" and node.token contains "field:ctx"
  emit issue code.LocklessSharedMutation at node
}
