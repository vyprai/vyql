module bindings.go.migration.m48a985c1;

binding commandOptionInjection294 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "function_name:NodePublishVolume" and node.token contains "call:GetVolumeContext" and node.token contains "call:append" and node.token contains "call:Mount" and not (node.scopeCall.any contains "ParseIP")
