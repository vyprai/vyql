binding commandOptionInjection294 {
  query pattern presenceNode where node.scope == "function" and node.context.functionName contains "NodePublishVolume" and node.context.call contains "GetVolumeContext" and node.context.call contains "append" and node.context.call contains "Mount" and not (node.scopeCall.any contains "ParseIP")
  emit issue code.CommandOptionInjection at node
  emit sink code.CommandOptionInjectionSink at node
}
