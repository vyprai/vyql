module bindings.go.migration.m48a985c1;

binding weakHash198 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "sha1.New"
  emit issue code.WeakHash at node
}
