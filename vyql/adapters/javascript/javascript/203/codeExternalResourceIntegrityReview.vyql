module bindings.javascript.migration.mfb63017a;

binding externalResourceIntegrityReview203 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "name=updateDynamicPageSriHashes" and node.token contains "integrityRegex.exec(attrs)" and node.token contains "globalHashes[t2].set(src,sriHash)" and not (node.token contains "Detected reference to not explicitly allowed external resource")
  emit issue code.ExternalResourceIntegrityReview at node
}
