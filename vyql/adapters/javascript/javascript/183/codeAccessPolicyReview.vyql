module bindings.javascript.migration.mfb63017a;

binding accessPolicyReview183 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=javascript" and node.token contains "authorized_keys?.includes(data.pubkey)" and node.token contains "private_keys[data.pubkey]" and node.token contains "!noscraper" and not (node.token contains "pubkeyInConfig") and not (node.token contains "authorized_keys?.length&&!pubkeyInConfig")
  emit issue code.AccessPolicyReview at node
}
