module bindings.javascript.migration.mfb63017a;

binding browserlessWorkspaceFilePathTraversal641 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "name=<lambda>" and node.token contains "req.params[0]" and node.token contains "path.join(workspaceDir,file)" and node.token contains "res.sendFile(filePath" and not (node.token contains "filePath.includes(workspaceDir)")
  emit issue code.BrowserlessWorkspaceFilePathTraversal at node
}
