module bindings.javascript.migration.mfb63017a;

binding cleartextChannel659 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "node:url.URL" and node.token contains "http://" and not (node.token contains "127.0") and not (node.token contains "localhost")
  emit issue code.CleartextChannel at node
}
