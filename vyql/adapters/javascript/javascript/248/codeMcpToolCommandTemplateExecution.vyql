module bindings.javascript.migration.mfb63017a;

binding mcpToolCommandTemplateExecution248 {
  query pattern presenceNode where node.scope == "module" and node.token contains "lang=javascript" and node.token contains "call_path:server.tool" and containsAny(node.token, ["literal:lsof -t -i tcp:${port}", "literal:ps -p ${pid} -o comm="]) and not (node.token contains "call_path:execFile")
  emit issue code.McpToolCommandTemplateExecution at node
}
