module bindings.javascript.migration.mfb63017a;

binding mcpToolCommandTemplateExecution248 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "module" and node.token contains "lang=javascript" and node.token contains "call_path:server.tool" and containsAny(node.token, ["literal:lsof -t -i tcp:${port}", "literal:ps -p ${pid} -o comm="]) and not (node.token contains "call_path:execFile")
  emit issue code.McpToolCommandTemplateExecution at node
}
