module bindings.javascript.migration.mfb63017a;

binding vm2HostCallbackBridge266 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "new VM" and node.token contains "sandbox.templateFilters" and node.token contains "sandbox.templateGlobals" and node.token contains "vm.run" and not (node.token contains "isolated-vm") and not (node.token contains "Isolate")
  emit issue code.Vm2HostCallbackBridge at node
}
