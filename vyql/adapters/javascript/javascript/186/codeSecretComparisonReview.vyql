module bindings.javascript.migration.mfb63017a;

binding secretComparisonReview186 {
  query pattern presenceNode where node.kind == "binop" and node.op in ["==", "==="] and not (containsAny(node.scopeCall.any, [scmp, tsscmp, timingSafeEqual, safeCompare])) and operand(node, where: containsAny(operand.key, ["csrf-token", "x-csrf-token", "xsrf-token", "auth-token", "api-key", signature, secret])) and operand(node, where: containsAny(operand.identifier, [token, secret, signature, key, password, pass]))
  emit issue code.SecretComparisonReview at node
}
