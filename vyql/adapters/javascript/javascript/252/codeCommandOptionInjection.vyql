module bindings.javascript.migration.mfb63017a;

binding commandOptionInjection252 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "name=clone" and node.token contains "call_path:?.gitExec" and containsAny(node.token, ["literal:clone${repository}", "literal:clone${remote}", "literal:clone${url}"]) and not (containsAny(node.token, ["literal:--${repository}", "literal:--${remote}", "literal:--${url}"]))
  emit issue code.CommandOptionInjection at node
  emit sink code.CommandOptionInjectionSink at node
}
