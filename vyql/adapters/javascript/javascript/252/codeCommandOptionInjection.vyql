binding commandOptionInjection252 {
  query pattern presenceNode where node.scope == "function" and node.context.name contains "clone" and node.context.callPath contains "?.gitExec" and containsAny(node.token, ["literal:clone${repository}", "literal:clone${remote}", "literal:clone${url}"]) and not (containsAny(node.token, ["literal:--${repository}", "literal:--${remote}", "literal:--${url}"]))
  emit issue code.CommandOptionInjection at node
