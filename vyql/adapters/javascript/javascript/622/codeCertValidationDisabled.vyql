module bindings.javascript.migration.mfb63017a;

binding certValidationDisabled622 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "https.request" and node.token contains "rejectUnauthorized=false"
  emit issue code.CertValidationDisabled at node
}
