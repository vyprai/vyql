module bindings.javascript.migration.mfb63017a;

binding csrfDisabled654 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "lusca.csrf" and node.token contains "false"
  emit issue code.CsrfDisabled at node
}
