module bindings.javascript.migration.mfb63017a;

binding weakCipher598 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "simplecrypt" and node.token contains "aes-192-ecb"
  emit issue code.WeakCipher at node
}
