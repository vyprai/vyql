module bindings.javascript.migration.mfb63017a;

binding packageInstallExecution611 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "execFileSync" and node.token contains "install"
  emit issue code.PackageInstallExecution at node
}
