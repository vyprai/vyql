module bindings.javascript.migration.mfb63017a;

binding catastrophicRegex550 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=javascript" and node.token contains "varhwb=/^hwb\\(" and node.token contains "string.match(hwb)" and not (node.token contains "\\d{0,3}") and not (node.token contains "(?:\\.\\d+)?")
  emit issue code.CatastrophicRegex at node
  emit sink code.CatastrophicRegexSink at node
}
