module bindings.javascript.migration.mfb63017a;

binding prefixWildcardKeyEnumeration144 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=javascript" and node.token contains "db.findKeys(\"pad:\"+padId+\"*\"" and node.token contains "db.get(records[key]" and not (node.token contains "\"pad:\"+padId+\":*\"")
  emit issue code.PrefixWildcardKeyEnumeration at node
}
