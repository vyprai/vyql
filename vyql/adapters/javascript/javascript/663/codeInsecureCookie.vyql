module bindings.javascript.migration.mfb63017a;

binding insecureCookie663 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "res.cookie" and not (node.token contains "secure=true")
  emit issue code.InsecureCookie at node
}
