module bindings.javascript.migration.mfb63017a;

binding catastrophicRegex545 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "module" and node.token contains "lang=javascript" and node.token contains "literal:[\\{\\[].*[\\/]*.*[\\}\\]]$" and node.token contains "call_path:enclosure.test" and not (node.token contains "literal:[\\{\\[].*[\\}\\]]$")
  emit issue code.CatastrophicRegex at node
  emit sink code.CatastrophicRegexSink at node
}
