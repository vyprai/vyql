module bindings.javascript.migration.mfb63017a;

binding jwtUnverified651 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "jwt.sign" and node.token contains "algorithm=none"
  emit issue code.JwtUnverified at node
}
