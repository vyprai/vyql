module bindings.javascript.migration.mfb63017a;

binding defaultPermissiveCorsConfig110 {
  query pattern presenceNode where node.scope == "module" and node.token contains "lang=javascript" and node.token contains "prop:CORS_ENABLED=true" and node.token contains "prop:CORS_ORIGIN=true" and not (node.token contains "prop:CORS_ENABLED=false") and not (node.token contains "prop:CORS_ORIGIN=false")
  emit issue code.DefaultPermissiveCorsConfig at node
}
