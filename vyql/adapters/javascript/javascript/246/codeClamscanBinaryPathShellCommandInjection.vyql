module bindings.javascript.migration.mfb63017a;

binding clamscanBinaryPathShellCommandInjection246 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=javascript" and node.token contains "name=_is_clamav_binary" and node.token contains "version_cmds" and node.token contains "${path}--version" and node.token contains "cp_exec(version_cmds[scanner])" and not (node.token contains "cp_execfile")
  emit issue code.ClamscanBinaryPathShellCommandInjection at node
}
