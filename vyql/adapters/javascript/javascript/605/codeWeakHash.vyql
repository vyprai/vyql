module bindings.javascript.migration.mfb63017a;

binding weakHash605 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "createHash" and node.token contains "sha1"
  emit issue code.WeakHash at node
}
