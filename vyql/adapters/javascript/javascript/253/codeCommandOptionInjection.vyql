module bindings.javascript.migration.mfb63017a;

binding commandOptionInjection253 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and containsAny(node.token, ["call_path:spawn", "call_path:crossSpawn", "call_path:child_process.spawn", "call_path:spawnSync"]) and node.token contains "git_clone_argv_missing_delimiter=true"
  emit issue code.CommandOptionInjection at node
  emit sink code.CommandOptionInjectionSink at node
}
