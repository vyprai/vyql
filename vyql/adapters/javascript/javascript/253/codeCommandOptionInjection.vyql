binding commandOptionInjection253 {
  query pattern presenceNode where node.scope == "function" and containsAny(node.token, ["call_path:spawn", "call_path:crossSpawn", "call_path:child_process.spawn", "call_path:spawnSync"]) and node.token contains "git_clone_argv_missing_delimiter=true"
