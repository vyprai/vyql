module bindings.javascript.migration.mfb63017a;

binding catastrophicRegex544 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "module" and node.token contains "lang=javascript" and node.token contains "constcommentre=/\\/\\*[^*]*\\*+([^/*][^*]*\\*+)*\\//g" and not (node.token contains "[^]*?(?:\\*\\/|$)")
  emit issue code.CatastrophicRegex at node
  emit sink code.CatastrophicRegexSink at node
}
