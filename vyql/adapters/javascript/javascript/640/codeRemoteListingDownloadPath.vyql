module bindings.javascript.migration.mfb63017a;

binding remoteListingDownloadPath640 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "_downloadFromWorkingDir" and node.token contains "join(localDirPath,file.name)" and node.token contains "downloadTo(localPath,file.name)" and not (node.token contains "basename(file.name)")
  emit issue code.RemoteListingDownloadPath at node
}
