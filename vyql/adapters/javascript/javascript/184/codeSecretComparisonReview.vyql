module bindings.javascript.migration.mfb63017a;

binding secretComparisonReview184 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=javascript" and node.token contains "call_path:secure-compare" and node.token contains "call_path:keys.findIndex"
  emit issue code.SecretComparisonReview at node
}
