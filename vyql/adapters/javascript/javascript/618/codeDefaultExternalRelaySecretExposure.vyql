module bindings.javascript.migration.mfb63017a;

binding defaultExternalRelaySecretExposure618 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=javascript" and node.token contains "name=buildRelayUrl" and node.token contains "literal:herokuapp.com" and node.token contains "call_path:encodeURIComponent" and containsAny(node.token, ["identifier:token", "identifier:gurl"]) and not (node.token contains "identifier:configuredRelayHost")
  emit issue code.DefaultExternalRelaySecretExposure at node
}
