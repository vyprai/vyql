module bindings.javascript.migration.mfb63017a;

binding hardlinkedFileOverwriteWithoutClobber303 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=javascript" and node.token contains "name=statCb" and node.token contains "call_path:get-type" and node.token contains "call_path:rimraf" and node.token contains "call_path:create" and node.token contains "attr_path:self._path" and node.token contains "attr_path:self.type" and not (node.token contains "binary:current.nlink>1")
