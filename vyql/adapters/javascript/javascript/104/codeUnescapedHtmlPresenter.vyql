  query unstable.legacyFlag as node where node.scope == "module" and node.token contains "lang=javascript" and node.token contains "assign:presentType=html" and node.token contains "identifier:present" and node.token contains "identifier:encodings" and node.token contains "call_path:Utils.printable" and node.token contains "literal:<td>${value}</td>" and not (node.token contains "call_path:Utils.escapeHtml") and not (node.token contains "call_path:DOMPurify")
