module bindings.javascript.migration.mfb63017a;

binding catastrophicRegex552 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "module" and node.token contains "lang=javascript" and node.token contains "String(validFunction(this)).match(re)" and node.token contains "([\\0-')-\\uffff]+)*" and node.token contains "([\\0-(*-\\uffff]*)" and not (node.token contains "this.name||\"\"") and not (node.token contains "args.join(\",\")") and not (node.token contains "args.join(\", \")")
  emit issue code.CatastrophicRegex at node
  emit sink code.CatastrophicRegexSink at node
}
