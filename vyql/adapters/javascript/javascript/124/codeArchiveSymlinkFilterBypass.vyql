module bindings.javascript.migration.mfb63017a;

binding archiveSymlinkFilterBypass124 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "module" and node.token contains "lang=javascript" and node.token contains "tar.extract" and node.token contains "ignore:isSymlink" and node.token contains "functionisSymlink(entry)" and node.token contains "entry.type==='SymbolicLink'" and not (node.token contains "functionisSymlink(_,entry)") and not (node.token contains "entry.type==='symlink'")
  emit issue code.ArchiveSymlinkFilterBypass at node
}
