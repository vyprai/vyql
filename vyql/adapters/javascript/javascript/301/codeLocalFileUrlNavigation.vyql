module bindings.javascript.migration.mfb63017a;

binding localFileUrlNavigation301 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "page.goto(request.url,requestOptions)" and not (node.token contains "request.url.trim().toLowerCase().substring(0,4)==='file'")
  emit issue code.LocalFileUrlNavigation at node
}
