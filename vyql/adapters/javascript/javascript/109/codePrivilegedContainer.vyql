module bindings.javascript.migration.mfb63017a;

binding privilegedContainer109 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=javascript" and containsAny(node.token, ["literal:docker run -dt", "literal:dockerrun-dt"]) and containsAny(node.token, ["literal:--privileged=true", "literal:--cap-add SYS_ADMIN", "literal:--cap-addSYS_ADMIN", "literal:--device /dev/fuse", "literal:--device/dev/fuse"]) and node.token contains "call_path:exec" and not (node.token contains "selector:appConfig.capabilities") and not (node.token contains "literal:--privileged=false")
  emit issue code.PrivilegedContainer at node
}
