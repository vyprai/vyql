module bindings.javascript.migration.mfb63017a;

binding refererBasedAdminUserCreation165 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=javascript" and node.token contains "call_path:req.header" and node.token contains "call_path:url.parse" and node.token contains "literal:Referer" and node.token contains "literal:/admin/setup" and node.token contains "selector:urlParts.path" and node.token contains "assign:isAdmin=true" and node.token contains "call_path:db.users.insert" and not (node.token contains "call_path:db.users.count")
  emit issue code.RefererBasedAdminUserCreation at node
}
