module bindings.javascript.migration.mfb63017a;

binding insecureExecutableDownload660 {
  query pattern presenceNode where node.scope == "module" and node.token contains "lang=javascript" and node.token contains "jrePrefix" and node.token contains "OpenJDK-JRE" and node.token contains "http://bundled-openjdk-jre" and node.token contains "download(jreUrl,jreTempFile" and node.token contains "http.request" and not (node.token contains "https://storage.googleapis.com")
  emit issue code.InsecureExecutableDownload at node
}
