module bindings.javascript.migration.mfb63017a;

binding javaScriptUrlRedirectXss193 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=javascript" and node.token contains "URLSearchParams(window.location.search).get" and node.token contains "window.location=decodeURI" and not (node.token contains "redirect[0]==='/'") and not (node.token contains "redirect[1]!=='/'")
  emit issue code.JavaScriptUrlRedirectXss at node
}
