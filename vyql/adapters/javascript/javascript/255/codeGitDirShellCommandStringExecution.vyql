module bindings.javascript.migration.mfb63017a;

binding gitDirShellCommandStringExecution255 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "class" and node.token contains "lang=javascript" and node.token contains "call_path:child_process.exec" and node.token contains "call_path:args.join" and node.token contains "literal:git --git-dir=" and node.token contains "attr_path:?.path" and not (node.token contains "call_path:child_process.execFile")
  emit issue code.GitDirShellCommandStringExecution at node
}
