module bindings.javascript.migration.mfb63017a;

binding gitPackSignatureSearchParsingBypass254 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and containsAny(node.token, ["call_path:?.lastIndexOf", "call_path:req.body.lastIndexOf"]) and node.token contains "literal:PACK" and containsAny(node.token, ["call_path:?.slice", "call_path:req.body.slice"]) and node.token contains "call_path:getPackMeta" and not (node.token contains "identifier:packDataOffset") and not (node.token contains "literal:PACK_SIGNATURE")
  emit issue code.GitPackSignatureSearchParsingBypass at node
}
