module bindings.javascript.migration.mfb63017a;

binding webSocketUpgradeMissingOriginCheck111 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "class" and node.token contains "lang=javascript" and node.token contains "prop:noServer=true" and node.token contains "call:handleUpgrade" and node.token contains "call:bind" and node.token contains "literal:sec-websocket-protocol" and not (containsAny(node.token, ["selector:headers.origin", "selector:.origin"])) and not (containsAny(node.token, ["literal:origin", "literal:Origin"]))
  emit issue code.WebSocketUpgradeMissingOriginCheck at node
}
