module bindings.javascript.migration.mfb63017a;

binding commandStringWrapperExecution250 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and containsAny(node.token, ["call_path:utils.run", "call_path:run"]) and containsAny(node.token, ["call_arg:utils.run:gitclone", "call_arg:utils.run:git clone", "call_arg:run:gitclone", "call_arg:run:git clone"]) and not (containsAny(node.token, ["call_path:runWithSpawn", "call_path:spawn", "call_path:execFile"]))
  emit issue code.CommandStringWrapperExecution at node
}
