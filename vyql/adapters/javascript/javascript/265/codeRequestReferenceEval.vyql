module bindings.javascript.migration.mfb63017a;

binding requestReferenceEval265 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "eval" and node.token contains "ref." and node.token contains "parts"
  emit issue code.RequestReferenceEval at node
}
