module bindings.javascript.migration.mfb63017a;

binding catastrophicRegex542 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "module" and node.token contains "lang=javascript" and node.token contains "constpattern=[" and node.token contains "].join" and node.token contains "newRegExp(pattern" and node.token contains "d]*(?:;" and not (node.token contains "[-a-zA-Z\\d\\/#&.:=?%@~_]+)*|")
  emit issue code.CatastrophicRegex at node
  emit sink code.CatastrophicRegexSink at node
}
