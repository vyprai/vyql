  query pattern callExpr where callee.analysis ~= "function.context" and args.any.context.language contains "javascript" and args.any.context.name contains "getPaths" and args.any.literal contains "segment !== '__proto__'" and args.any.literal contains "segment !== 'constructor'" and args.any.literal contains "segment !== 'prototype'"
