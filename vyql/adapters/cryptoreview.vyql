// Cross-language crypto-operation labeling for the POSSIBILITY tier.
//
// Marks cryptographic operations (cipher/sign/verify/hash/KDF/key-gen) as
// code.CryptoOperation. No CONFIRMED rule consumes this concept, so these labels are
// inert in normal scans (zero effect on default output / benchmarks). The possibility
// tier (VYQL_POSSIBILITY=1) surfaces each as a "review this crypto logic" finding for the
// AI/triage pass — the bug class behind many crypto CVEs (bypassed verification, weak
// key/IV handling) that static taint cannot prove. cross_language: crypto APIs recur by
// name across ecosystems.
adapter cryptoreview {
  meta { fidelity: syntactic, cross_language: true, auto_apply: graph }

  // Node.js / JS-TS crypto
  flag code.CryptoOperation on any {
    path "crypto.createCipheriv"
  }
  flag code.CryptoOperation on any {
    path "crypto.createDecipheriv"
  }
  flag code.CryptoOperation on any {
    path "crypto.createCipher"
  }
  flag code.CryptoOperation on any {
    path "crypto.createSign"
  }
  flag code.CryptoOperation on any {
    path "crypto.createVerify"
  }
  flag code.CryptoOperation on any {
    path "crypto.publicEncrypt"
  }
  flag code.CryptoOperation on any {
    path "crypto.privateDecrypt"
  }
  flag code.CryptoOperation on any {
    path "crypto.pbkdf2"
  }
  flag code.CryptoOperation on any {
    path "crypto.scrypt"
  }
  flag code.CryptoOperation on any {
    path "crypto.generateKeyPair"
  }

  // JVM (java/kotlin) + .NET — by dotted path so generic getInstance is crypto-scoped
  flag code.CryptoOperation on any {
    path "Cipher.getInstance"
  }
  flag code.CryptoOperation on any {
    path "Signature.getInstance"
  }
  flag code.CryptoOperation on any {
    path "Mac.getInstance"
  }
  flag code.CryptoOperation on any {
    path "KeyGenerator.getInstance"
  }
  flag code.CryptoOperation on any {
    path "KeyPairGenerator.getInstance"
  }
  flag code.CryptoOperation on any {
    method "doFinal"
  }
  flag code.CryptoOperation on any {
    method "EncryptValue"
  }
  flag code.CryptoOperation on any {
    method "DecryptValue"
  }

  // Go x/crypto + stdlib
  flag code.CryptoOperation on any {
    path "aes.NewCipher"
  }
  flag code.CryptoOperation on any {
    path "cipher.NewGCM"
  }
  flag code.CryptoOperation on any {
    path "rsa.SignPKCS1v15"
  }
  flag code.CryptoOperation on any {
    path "rsa.VerifyPKCS1v15"
  }
  flag code.CryptoOperation on any {
    path "ecdsa.Sign"
  }
  flag code.CryptoOperation on any {
    path "ecdsa.Verify"
  }
  flag code.CryptoOperation on any {
    path "hmac.New"
  }

  // .NET (System.Security.Cryptography)
  flag code.CryptoOperation on any {
    path "Aes.Create"
  }
  flag code.CryptoOperation on any {
    path "SymmetricAlgorithm.Create"
  }
  flag code.CryptoOperation on any {
    path "HashAlgorithm.Create"
  }
  flag code.CryptoOperation on any {
    method "CreateEncryptor"
  }
  flag code.CryptoOperation on any {
    method "CreateDecryptor"
  }
  flag code.CryptoOperation on any {
    method "TransformFinalBlock"
  }
  flag code.CryptoOperation on any {
    method "GenerateKey"
  }
  flag code.CryptoOperation on any {
    method "GenerateIV"
  }
  flag code.CryptoOperation on any {
    path "CryptoStream"
  }
  flag code.CryptoOperation on any {
    path "RSACryptoServiceProvider"
  }
  flag code.CryptoOperation on any {
    path "AesManaged"
  }
  flag code.CryptoOperation on any {
    path "TripleDESCryptoServiceProvider"
  }
  flag code.CryptoOperation on any {
    path "RijndaelManaged"
  }
  flag code.CryptoOperation on any {
    path "ProtectedData.Protect"
  }
  flag code.CryptoOperation on any {
    path "ProtectedData.Unprotect"
  }
  flag code.CryptoOperation on any {
    path "Rfc2898DeriveBytes"
  }

  // C / OpenSSL
  flag code.CryptoOperation on any {
    path "EVP_EncryptInit_ex"
  }
  flag code.CryptoOperation on any {
    path "EVP_DecryptInit_ex"
  }
  flag code.CryptoOperation on any {
    path "EVP_DigestSignInit"
  }
  flag code.CryptoOperation on any {
    path "EVP_DigestVerifyInit"
  }
  flag code.CryptoOperation on any {
    path "RSA_sign"
  }
  flag code.CryptoOperation on any {
    path "RSA_verify"
  }
}
