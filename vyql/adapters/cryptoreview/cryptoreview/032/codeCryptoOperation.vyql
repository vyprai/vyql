module bindings.cryptoreview.migration.m4f475b34;

binding cryptoOperation32 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "GenerateIV"
  emit issue code.CryptoOperation at node
}
