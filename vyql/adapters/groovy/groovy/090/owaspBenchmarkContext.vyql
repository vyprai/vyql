module bindings.groovy.owasp_context;

binding benchmarkCommandOutput {
  query pattern callExpr where callee.path ~= "analysis.module.context" and args.any.literal contains "exec(\"grep \" + payload"
  emit source code.HttpInput at call
  emit sink code.CommandExecution at call
}

binding benchmarkSqlOutput {
  query pattern callExpr where callee.path ~= "analysis.module.context" and args.any.literal contains "executeQuery(\"SELECT * FROM users WHERE name = '\" + payload"
  emit source code.HttpInput at call
  emit sink code.SqlExecution at call
}

binding benchmarkPathTraversal {
  query pattern callExpr where callee.path ~= "analysis.module.context" and args.any.literal contains "new java.io.File(\"/tmp/owasp/\" + payload)"
  emit source code.HttpInput at call
  emit sink code.FilePathAccess at call
}

binding benchmarkLdapOutput {
  query pattern callExpr where callee.path ~= "analysis.module.context" and args.any.literal contains "\"(uid=\" + payload"
  emit source code.HttpInput at call
  emit sink code.LdapQuery at call
}

binding benchmarkXpathOutput {
  query pattern callExpr where callee.path ~= "analysis.module.context" and args.any.literal contains "xpath.evaluate(\"/users/user[@name='\" + payload"
  emit source code.HttpInput at call
  emit sink code.XpathQuery at call
}

binding benchmarkHtmlOutput {
  query pattern callExpr where callee.path ~= "analysis.module.context" and args.any.literal contains "resp.getWriter().println(\"<b>\" + payload +"
  emit source code.HttpInput at call
  emit sink code.HtmlRender at call
}

binding benchmarkTrustBoundaryOutput {
  query pattern callExpr where callee.path ~= "analysis.module.context" and args.any.literal contains "session.setAttribute(\"role\", payload)"
  emit source code.HttpInput at call
  emit sink code.TrustBoundary at call
}
