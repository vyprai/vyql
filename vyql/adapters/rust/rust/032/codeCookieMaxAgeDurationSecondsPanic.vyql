module bindings.rust.migration.mdc4f74cd;

binding cookieMaxAgeDurationSecondsPanic32 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=rust" and node.token contains "name=parse_inner" and node.token contains "\"max-age\",Some(v)" and node.token contains "v.parse()" and node.token contains "Duration::seconds(val)" and not (node.token contains "Duration::max_value().num_seconds()") and not (node.token contains "cmp::min")
  emit issue code.CookieMaxAgeDurationSecondsPanic at node
}
