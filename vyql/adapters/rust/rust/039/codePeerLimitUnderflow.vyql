module bindings.rust.migration.mdc4f74cd;

binding peerLimitUnderflow39 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=rust" and node.token contains "name=poll" and node.token contains "DiscoveryMessage::Handshake" and node.token contains "self.peer_list_limit = Some(limit);" and node.token contains "self.peer_list_limit.unwrap() as usize - 1" and node.token contains "self.get_peer_contacts(" and not (node.token contains ".saturating_sub(1)") and not (node.token contains ".min(self.config.update_limit)")
  emit issue code.PeerLimitUnderflow at node
}
