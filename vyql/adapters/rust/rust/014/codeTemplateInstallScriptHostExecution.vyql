module bindings.rust.migration.mdc4f74cd;

binding templateInstallScriptHostExecution14 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=rust" and node.token contains "installScript" and node.token contains "final_script" and not (node.token contains "spawn_installer_container")
  emit issue code.TemplateInstallScriptHostExecution at node
}
