module bindings.rust.migration.mdc4f74cd;

binding windowsReservedDeviceNameBypass35 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=rust" and node.token contains "path.file_stem()" and node.token contains "stemstr.to_uppercase().as_str()" and node.token contains "\"LPT0\"" and node.token contains "\"LPT9\"" and node.token contains "manually::open" and not (node.token contains "\"LPT¹\"")
  emit issue code.WindowsReservedDeviceNameBypass at node
}
