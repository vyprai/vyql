module bindings.rust.migration.mdc4f74cd;

binding modexpZeroExponentIterationUnderflow30 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "binop" and node.op contains "-" and operand(node, where: operand.path ~= "?.bits")
