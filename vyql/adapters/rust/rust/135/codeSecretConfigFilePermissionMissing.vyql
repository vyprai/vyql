  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=rust" and node.token contains "config_dest.push(\"ignition\");" and node.token contains "config_dest.push(\"config.ign\");" and node.token contains "create_dir_all(&config_dest)" and node.token contains "OpenOptions::new()" and node.token contains ".create_new(true)" and node.token contains "copy(&mutconfig_in,&mutconfig_out)" and not (node.token contains "set_permissions") and not (node.token contains "Permissions::from_mode") and not (node.token contains ".chmod(") and not (node.token contains ".set_mode(")
