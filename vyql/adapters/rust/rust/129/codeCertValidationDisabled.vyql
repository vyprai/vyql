module bindings.rust.migration.mdc4f74cd;

binding certValidationDisabled129 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "danger_accept_invalid_certs" and node.token contains "true"
  emit issue code.CertValidationDisabled at node
}
