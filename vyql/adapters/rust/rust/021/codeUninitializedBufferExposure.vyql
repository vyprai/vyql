module bindings.rust.migration.mdc4f74cd;

binding uninitializedBufferExposure21 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=rust" and node.token contains "Vec::with_capacity" and node.token contains "set_len" and node.token contains "read_exact(&mut" and not (node.token contains "resize")
  emit issue code.UninitializedBufferExposure at node
