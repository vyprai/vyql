module bindings.rust.migration.mdc4f74cd;

binding permissiveCors85 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path == "CorsLayer.new.allow_origin.allow_methods.allow_headers" and node.token contains "Any"
  emit issue code.PermissiveCors at node
}
