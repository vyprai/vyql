// c framework adapter (docs/07) — framework→concept content.
adapter c {
  meta { fidelity: resolved }

  // untrusted input
  source "getenv" -> code.EnvVariable
  source "argv" -> code.CliArgument
  source "fgets" -> code.StdinInput
  source "gets" -> code.StdinInput
  source "fread" -> code.HttpInput
  source "recv" -> code.HttpInput
  source "recvfrom" -> code.HttpInput

  // command execution (the program/command string is arg0)
  sink path "system" -> code.CommandExecution
  sink path "popen" -> code.CommandExecution
  sink path "execl" -> code.CommandExecution
  sink path "execlp" -> code.CommandExecution
  sink path "execle" -> code.CommandExecution
  sink path "execv" -> code.CommandExecution
  sink path "execvp" -> code.CommandExecution
  sink path "execve" -> code.CommandExecution
  sink path "execvpe" -> code.CommandExecution
  // GLib / GTK process spawning (the command line is arg0)
  sink path "g_spawn_command_line_sync" -> code.CommandExecution
  sink path "g_spawn_command_line_async" -> code.CommandExecution
  sink path "g_app_info_create_from_commandline" -> code.CommandExecution
  mark exact "analysis.function.context" val "g_app_info_create_from_commandline(cmdline" val "g_string_append_printf(cmd,\"--find=%s\",search_string)" nval "g_shell_quote" -> code.CommandLineAssemblyReview

  // SQL (procedural — the query is arg1)
  sink path "mysql_query" arg 1 -> code.SqlExecution
  sink path "mysql_real_query" arg 1 -> code.SqlExecution
  sink path "sqlite3_exec" arg 1 -> code.SqlExecution
  sink path "sqlite3_prepare" arg 1 -> code.SqlExecution
  sink path "sqlite3_prepare_v2" arg 1 -> code.SqlExecution
  sink path "PQexec" arg 1 -> code.SqlExecution

  // path / file
  sink path "fopen" -> code.FilePathAccess
  sink path "open" -> code.FilePathAccess
  sink path "open64" -> code.FilePathAccess
  sink path "unlink" -> code.FilePathAccess
  sink path "remove" -> code.FilePathAccess
  sink path "opendir" -> code.FilePathAccess

  // dynamic loading (untrusted path -> code load)
  sink path "dlopen" -> code.DynamicCodeLoad

  // XSS (CWE-79) — writing untrusted HTML to a response/output stream (arg0 is the text)
  sink path "fputs" -> code.HtmlRender
  sink path "fwrite" -> code.HtmlRender

  // LDAP injection (CWE-90) — OpenLDAP search (the filter is arg3)
  sink path "ldap_search_ext_s" arg 3 -> code.LdapQuery
  sink path "ldap_search_s" arg 3 -> code.LdapQuery

  // XPath injection (CWE-643) — libxml2 (the expression is arg0)
  sink path "xmlXPathEvalExpression" -> code.XpathQuery
  sink path "xmlXPathEval" -> code.XpathQuery

  // insecure temp file (CWE-377) — predictable-name / race-prone temp APIs
  mark "mktemp" -> code.InsecureTempFile
  mark "tmpnam" -> code.InsecureTempFile
  mark "tempnam" -> code.InsecureTempFile
  mark "chmod" val "0777" -> code.InsecurePermission
  mark "chmod" val "0666" -> code.InsecurePermission
  mark "open" val "0777" -> code.InsecurePermission
  mark "open" val "0666" -> code.InsecurePermission

  // memory safety (exploitability-aware). Taint rules fire when attacker input reaches
  // the dangerous operand; smell rules keep an explicit exploit assumption.
  sink path "strcpy" arg 1 -> code.UnboundedCopy
  sink path "strcat" arg 1 -> code.UnboundedCopy
  sink path "sprintf" arg all -> code.UnboundedCopy
  sink path "vsprintf" arg all -> code.UnboundedCopy
  mark "strcpy" -> code.UnboundedCopySmell
  mark "strcat" -> code.UnboundedCopySmell
  mark "sprintf" -> code.UnboundedCopySmell
  mark "vsprintf" -> code.UnboundedCopySmell
  sink path "memcpy" arg 2 -> code.RawMemoryCopySize
  sink path "memmove" arg 2 -> code.RawMemoryCopySize
  sink path "strncpy" arg 2 -> code.RawMemoryCopySize
  sink path "strncat" arg 2 -> code.RawMemoryCopySize
  sink path "malloc" -> code.SizeComputation
  sink path "calloc" arg all -> code.SizeComputation
  sink path "realloc" arg 1 -> code.SizeComputation
  sink path "reallocarray" arg 1 -> code.SizeComputation
  mark "realloc" -> code.ZeroSizeReallocation
  mark "reallocarray" -> code.ZeroSizeReallocation
  mark "alloca" -> code.StackAllocationSmell
  mark "__subscript" -> code.IndexAccess
  mark "analysis.index.access" val "index_kind=field_derived" val "guard=missing_upper_bound" -> code.FieldDerivedIndexAccess
  mark "analysis.lifetime.release_then_return" val "release=delete" val "return=false" val "storage=nonlocal" -> code.FailurePathOwnedBufferFree
  mark exact "analysis.function.context" val "lang=c" val "name=bt_att_cancel" val "queue_remove_if(att->req_queue" val "queue_remove_if(att->ind_queue" val "queue_remove_if(att->write_queue" val "destroy_att_send_op(op)" nval "att->in_disc" nval "bt_att_disc_cancel" -> code.ReentrantQueueCleanupReview
  mark exact "analysis.function.context" val "lang=c" val "unescapeChar(*readPtr++);}*writePtr++=c;" -> code.EscapedTerminatorWrite
  mark exact "analysis.function.context" val "lang=c" val "start+len+1>end" val "start+=len" nval "buff_size" nval "end-start-1" -> code.PointerOffsetBoundsCheck
  mark exact "analysis.function.context" val "lang=c" val "name=match" val "cur->peercallno==callno" val "dcallno==cur->callno" nval "full_frame?dcallno==cur->callno" -> code.ProtocolFrameBindingReview
  mark exact "analysis.function.context" val "lang=c" val "name=__of_unflatten_dtb" val "FDT_BEGIN_NODE" val "FDT_PROP" val "is_reserved_name(pathp)" val "is_reserved_name(name)" val "of_new_node(node,pathp)" val "of_new_property" nval "is_allowed_input_name" nval "strchr(name,'/')" -> code.ProtocolStateReview
  mark exact "analysis.function.context" val "lang=c" val "name=dispatch_cmd" val "OP_PUT" val "body_size=strtoul" val "body_size>job_data_size_limit" val "reply_msg(c,MSG_JOB_TOO_BIG)" nval "skip(c,body_size+2,MSG_JOB_TOO_BIG)" -> code.ProtocolCommandInjection
  mark exact "analysis.function.context" val "name=perform_http_xact" val "CREATION_NOTIFICATION" val "run_post_create" nval "client_uid!=0" -> code.PrivilegedEntryPointReview
  mark exact "analysis.function.context" val "lang=c" val "AVAHI_FLAGS_VALID" val "AVAHI_PUBLISH_USE_WIDE_AREA" val "AVAHI_PUBLISH_USE_MULTICAST" val "transport_flags_from_domain" nval "!(flags&AVAHI_PUBLISH_USE_WIDE_AREA)||!(flags&AVAHI_PUBLISH_USE_MULTICAST)" -> code.ReachableAssertionReview
  mark exact "analysis.function.context" val "lang=c" val "px->ft=imcb_file_send_start" val "px->ft->data=px" nval "if(!px->ft)" -> code.UncheckedNullableResultDeref
  mark "analysis.field.clear_null" -> code.OwnerFieldClear
  mark "xmlFreeDoc" -> code.OwnerFree
  mark "__deref" -> code.PointerUse
  mark "__deref" -> code.NullableDeref
  mark "free" -> code.PointerFree
  sink path "__binop.div" arg 1 -> code.DivisionDenominator
  sink path "__binop.mod" arg 1 -> code.DivisionDenominator
  mark "__binop.add" -> code.IntegerSizeArithmetic
  mark "__binop.sub" -> code.IntegerSizeArithmetic
  source "__binop.mul" -> code.ComputedSizeValue
  mark "__binop.mul" -> code.IntegerSizeArithmetic
  mark "__binop.shl" -> code.IntegerSizeArithmetic
  control "analysis.function.context" val "(int)size<0" val "save+size<save" -> core.IntegerOverflowGuard
  control "analysis.guard.value_exclusion" val "value=0" -> core.ZeroValueExclusion

  // TOCTOU / race (CWE-367): check before use on the same CFG path. The rule is
  // assumption-gated because same-path ordering is not yet same-object proof.
  mark "access" -> code.FileCheck
  mark "stat" -> code.FileCheck
  mark "lstat" -> code.FileCheck
  mark "fopen" -> code.FileUse
  mark "open" -> code.FileUse
  mark "open64" -> code.FileUse
  mark "unlink" -> code.FileUse
  mark "remove" -> code.FileUse
  mark "rename" -> code.FileUse
  mark "chmod" -> code.FileUse
  mark "chown" -> code.FileUse

  // lifecycle / concurrency
  mark "pthread_mutex_lock" -> code.LockAcquire
  mark "mtx_lock" -> code.LockAcquire
  control "pthread_mutex_unlock" -> core.LockRelease
  control "mtx_unlock" -> core.LockRelease
  mark "pthread_create" -> code.LocklessSharedMutation

  // format string (CWE-134) — tainted FORMAT argument
  sink path "printf" arg 0 -> code.FormatString
  sink path "fprintf" arg 1 -> code.FormatString
  sink path "syslog" arg 1 -> code.FormatString
  sink path "vprintf" arg 0 -> code.FormatString

  // regex compile (ReDoS) — POSIX regcomp (pattern is arg1)
  sink path "regcomp" arg 1 -> code.RegexCompile

  // SSRF — libcurl (tainted option value, most commonly CURLOPT_URL, is arg2)
  sink path "curl_easy_setopt" arg 2 -> code.UrlFetch

  // XXE (CWE-611) — libxml2 readers (xml content/path is arg0)
  sink path "xmlReadMemory" -> code.XmlParse
  sink path "xmlReadFile" -> code.XmlParse
  sink path "xmlReadDoc" -> code.XmlParse
  sink path "xmlParseFile" -> code.XmlParse
  sink path "xmlParseMemory" -> code.XmlParse

  // weak hash (CWE-328) — OpenSSL MD4/MD5/SHA1 (presence); SHA-256 is safe
  mark "MD5_Init" -> code.WeakHash
  mark "MD5" -> code.WeakHash
  mark "MD4" -> code.WeakHash
  mark "SHA1_Init" -> code.WeakHash
  mark "SHA1" -> code.WeakHash
  mark "EVP_md5" -> code.WeakHash
  mark "EVP_sha1" -> code.WeakHash

  // weak cipher (CWE-327) — OpenSSL DES (presence); AES is safe
  mark "DES_ecb_encrypt" -> code.WeakCipher
  mark "DES_ncbc_encrypt" -> code.WeakCipher
  mark "DES_set_key" -> code.WeakCipher
  mark "RC4" -> code.WeakCipher
  mark "BF_set_key" -> code.WeakCipher
  mark "EVP_EncryptInit_ex" val "0000000000000000" -> code.StaticIv
  mark "EVP_DecryptInit_ex" val "0000000000000000" -> code.StaticIv
  // Encrypted transport config must not allow an enabled cipher with HMAC/hash
  // disabled. Corosync CVE-2013-0250 is this shape: crypto_cipher can be aes*
  // while crypto_hash is none unless the config reader rejects the combination.
  mark exact "analysis.function.context" val "lang=c" val "crypto_cipher" val "crypto_hash" val "tmp_cipher" val "tmp_hash" val "strcmp(str,\"none\")==0" nval "strcmp(tmp_cipher,\"none\")!=0" nval "strcmp(tmp_hash,\"none\")==0" -> code.CipherWithoutIntegrityHash

  // insecure randomness (CWE-330) — rand()/random() (presence); getrandom()/RAND_bytes safe
  mark "rand" -> code.WeakRandomValue
  mark "random" -> code.WeakRandomValue
  mark "rand_r" -> code.WeakRandomValue

  // controls (sanitizers) — realpath canonicalizes a path; preamble defines the rest
  control "realpath" -> core.PathCanonicalization
  control "safe_path" -> core.PathCanonicalization
  control "escape_shell" -> core.ShellEscape
  control "escape_html" -> core.HtmlEscape
  control "encode_for_ldap" -> core.LdapEscape
  control "escape_xpath" -> core.XpathEscape
}
