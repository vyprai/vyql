// config "framework" adapter — mobile app configuration files. The config
// frontend (AndroidManifest.xml / Info.plist) emits a bare call per insecure
// setting; these marks label each with its presence concept.
adapter config {
  meta { fidelity: resolved }

  // Android: android:exported="true" on an activity/service/receiver/provider
  mark "android_exported" -> code.ExportedComponent
  // Android: <application android:usesCleartextTraffic="true">
  mark "android_cleartext" -> code.CleartextConfig
  // Android: <application android:debuggable="true">
  mark "android_debuggable" -> code.DebuggableApp
  // iOS Info.plist: ATS NSAllowsArbitraryLoads(/InWebContent/ForMedia) = <true/>
  mark "ats_arbitrary_loads" -> code.CleartextConfig

  // IaC / container misconfig (CWE-250/653/284) — tokens from the Dockerfile / K8s YAML
  // / Terraform scanners.
  mark "k8s_privileged" -> code.PrivilegedContainer
  mark "container_user_root" -> code.PrivilegedContainer
  mark "docker_privileged" -> code.PrivilegedContainer
  mark "k8s_host_namespace" -> code.HostNamespaceShare
  mark "k8s_host_path" -> code.HostNamespaceShare
  mark "tf_open_cidr" -> code.PublicNetworkExposure
  mark "tf_wildcard_iam" -> code.WildcardIamPolicy

  // Jenkins Jelly views: template model fields such as it.name/it.description
  // rendered into HTML-bearing attributes need escaping before display.
  source "jelly.input" -> core.UserControlledData
  sink   "jelly.render" -> code.HtmlRender
  control "h.escape" -> core.HtmlEscape

  // JSP/JSTL views: raw EL expressions in HTML/link/attribute contexts are
  // rendered output; <c:out> is skipped by the frontend as an escaped render.
  source "jsp.input" -> core.UserControlledData
  sink   "jsp.render" -> code.HtmlRender
}
