// cpp framework adapter (docs/07) — framework→concept content.
// C++: qualified names (std::system) normalize to dotted (std.system) and match
// by suffix; std::string + concat builds tainted strings.
adapter cpp {
  meta { fidelity: resolved }

  // untrusted input
  source "getenv" -> code.EnvVariable
  source "argv" -> code.CliArgument
  source "fgets" -> code.StdinInput
  source "gets" -> code.StdinInput
  source "fread" -> code.HttpInput
  source "recv" -> code.HttpInput

  // command execution (std::system normalizes to std.system, matched by suffix)
  sink path "system" -> code.CommandExecution
  sink path "popen" -> code.CommandExecution
  sink path "execl" -> code.CommandExecution
  sink path "execlp" -> code.CommandExecution
  sink path "execv" -> code.CommandExecution
  sink path "execvp" -> code.CommandExecution
  sink path "execve" -> code.CommandExecution

  // SQL (the query is arg1 for the C-style APIs)
  sink path "mysql_query" arg 1 -> code.SqlExecution
  sink path "sqlite3_exec" arg 1 -> code.SqlExecution
  sink path "sqlite3_prepare_v2" arg 1 -> code.SqlExecution
  sink path "PQexec" arg 1 -> code.SqlExecution

  // path / file (fopen, open(), fstream ctor + .open(...))
  sink path "fopen" -> code.FilePathAccess
  sink path "open" -> code.FilePathAccess
  sink path "ifstream" -> code.FilePathAccess
  sink path "ofstream" -> code.FilePathAccess
  sink path "fstream" -> code.FilePathAccess
  sink path "remove" -> code.FilePathAccess
  sink path "unlink" -> code.FilePathAccess

  // dynamic loading
  sink path "dlopen" -> code.DynamicCodeLoad

  // memory safety (exploitability-aware)
  sink path "strcpy" arg 1 -> code.UnboundedCopy
  sink path "strcat" arg 1 -> code.UnboundedCopy
  sink path "sprintf" arg all -> code.UnboundedCopy
  sink path "vsprintf" arg all -> code.UnboundedCopy
  flag code.UnboundedCopySmell on any {
    path "strcpy"
  }
  flag code.UnboundedCopySmell on any {
    path "strcat"
  }
  flag code.UnboundedCopySmell on any {
    path "sprintf"
  }
  flag code.UnboundedCopySmell on any {
    path "vsprintf"
  }
  sink path "memcpy" arg 2 -> code.RawMemoryCopySize
  sink path "memmove" arg 2 -> code.RawMemoryCopySize
  sink path "strncpy" arg 2 -> code.RawMemoryCopySize
  sink path "strncat" arg 2 -> code.RawMemoryCopySize
  sink path "malloc" -> code.SizeComputation
  sink path "calloc" arg all -> code.SizeComputation
  sink path "realloc" arg 1 -> code.SizeComputation
  sink path "reallocarray" arg 1 -> code.SizeComputation
  sink path "operator new" -> code.SizeComputation
  flag code.ZeroSizeReallocation on any {
    path "realloc"
  }
  flag code.ZeroSizeReallocation on any {
    path "reallocarray"
  }
  flag code.StackAllocationSmell on any {
    path "alloca"
  }
  flag code.InsecureTempFile on any {
    path "mktemp"
  }
  flag code.InsecureTempFile on any {
    path "tmpnam"
  }
  flag code.InsecureTempFile on any {
    path "tempnam"
  }
  flag code.InsecurePermission on any {
    path "chmod"
    has "0777"
  }
  flag code.InsecurePermission on any {
    path "chmod"
    has "0666"
  }
  flag code.InsecurePermission on any {
    path "open"
    has "0777"
  }
  flag code.InsecurePermission on any {
    path "open"
    has "0666"
  }
  // disabled TLS certificate verification (CWE-295) — Qt / OpenSSL / curl
  flag code.CertValidationDisabled on any {
    path "setPeerVerifyMode"
    has "VerifyNone"
  }
  flag code.CertValidationDisabled on any {
    path "setPeerVerifyMode"
    has "QSslSocket::VerifyNone"
  }
  flag code.CertValidationDisabled on any {
    path "SSL_CTX_set_verify"
    has "SSL_VERIFY_NONE"
  }
  flag code.CertValidationDisabled on any {
    path "SSL_set_verify"
    has "SSL_VERIFY_NONE"
  }
  flag code.CertValidationDisabled on any {
    path "curl_easy_setopt"
    has "CURLOPT_SSL_VERIFYPEER"
    has "0"
  }
  flag code.CertValidationDisabled on any {
    path "setsslverify"
    has "false"
  }
  flag code.IndexAccess on any {
    path "__subscript"
  }
  flag code.FieldDerivedIndexAccess on any {
    path "analysis.index.access"
    has "index_kind=field_derived"
    has "guard=missing_upper_bound"
  }
  flag code.FailurePathOwnedBufferFree on any {
    path "analysis.lifetime.release_then_return"
    has "release=delete"
    has "return=false"
    has "storage=nonlocal"
  }
  flag code.EscapedTerminatorWrite in function {
    has "lang=cpp"
    has "unescapeChar(*readPtr++);}*writePtr++=c;"
  }
  flag code.UnboundedAllocationReview in function {
    has "lang=cpp"
    has "count_vertices+=*itf;"
    has "newaiVector3D[count_vertices]"
    lacks "AI_MAX_FACE_INDICES"
    lacks "count_vertices>vertices.size()"
  }
  flag code.PointerOffsetBoundsCheck in function {
    has "lang=cpp"
    has "start+len+1>end"
    has "start+=len"
    lacks "buff_size"
    lacks "end-start-1"
  }
  flag code.ProtocolListAmplification in function {
    has "lang=cpp"
    has "inlineCompositeListElementCount"
    has "wordsPerElement"
    has "ListReader"
    lacks "amplifiedRead"
  }
  flag code.ProtocolListAmplification in function {
    has "lang=cpp"
    has "elementSize"
    has "ElementSize::VOID"
    has "ListReader"
    lacks "amplifiedRead"
  }
  flag code.ChakraScopeSlotArrayUncheckedIndex in function {
    has "lang=cpp"
    has "propertyIdsForScopeSlotArray[sym->GetScopeSlot()]=sym->EnsurePosition(funcInfo)"
    has "propertyIdsForScopeSlotArray[funcInfo->thisScopeSlot]=Js::PropertyIds::_lexicalThisSlotSymbol"
    has "propertyIdsForScopeSlotArray[funcInfo->superCtorScopeSlot]=Js::PropertyIds::_superCtorReferenceSymbol"
    lacks "setPropertyIdForScopeSlotArray(sym->GetScopeSlot(),sym->EnsurePosition(funcInfo))"
    lacks "slot<0||(uint)slot>=scopeSlotCount"
    lacks "Js::Throw::FatalInternalError()"
  }
  flag code.ReachableAssertionReview in function {
    has "lang=cpp"
    has "visitBrOn(&curr)"
    has "validateTypeAnnotation(in,curr.ref)"
    has "curr.desc"
    lacks "curr.ref->type.isRef"
    lacks "curr.desc->type.isRef"
  }
  flag code.ProtocolStateReview in function {
    has "lang=cpp"
    has "Record_Type::ApplicationData"
    has "callbacks().tls_record_received"
    lacks "can_decrypt_application_traffic"
  }
  flag code.SecretComparisonReview in function {
    has "lang=cpp"
    has "name=HTTPAuthorized"
    has "strUserPass==strRPCUserColonPass"
    lacks "nResult|="
  }
  flag code.CryptoImproperBlinding in function {
    has "lang=cpp"
    has "r.Randomize"
    has "MultiplicativeInverse(r)"
    has "Jacobi"
    has "modn.Square(r)"
    has "modn.Multiply(y,rInv)"
    lacks "r=modn.Square(r);rInv=modn.MultiplicativeInverse(r)"
  }
  flag code.CimgPnmDimensionProductOverflow in function {
    has "lang=cpp"
    has "cimg::fsize(filename)"
    has "W*H*D>siz"
    lacks "(cimg_int64)W*H*D>siz"
  }
  flag code.WindowsRemotePathCredentialLeak in function {
    has "lang=cpp"
    has "QFileInfo::exists(m_configFile)"
    has "QSettingsconfig(m_configFile,QSettings::IniFormat)"
    has "m_pWatchdog->setProcessConfig(command,elevate)"
    lacks "m_configFile.startsWith(QStringLiteral(\"\\\\\\\\\"))"
    lacks "m_configFile.startsWith(QStringLiteral(\"//\"))"
  }
  flag code.LibreOfficeEnhwmfDibHeaderSizeUnderflow in function {
    has "lang=cpp"
    has "EMR_ALPHABLEND"
    has "getDIBV5HeaderSize"
    has "cbBmiSrc"
    has "nDeltaToDIB5HeaderSize"
    has "nTargetSize"
    has "newchar"
    has "ReadBytes"
    lacks "cbBmiSrc>nHeaderSize"
    lacks "bSafeRead=false"
  }
  flag code.OwnerFieldClear on any {
    path "analysis.field.clear_null"
  }
  flag code.OwnerFree on any {
    path "xmlFreeDoc"
  }
  flag code.PointerUse on any {
    path "__deref"
  }
  flag code.NullableDeref on any {
    path "__deref"
  }
  flag code.PointerFree on any {
    path "free"
  }
  sink path "__binop.div" arg 1 -> code.DivisionDenominator
  sink path "__binop.mod" arg 1 -> code.DivisionDenominator
  flag code.IntegerSizeArithmetic on any {
    path "__binop.add"
  }
  flag code.IntegerSizeArithmetic on any {
    path "__binop.sub"
  }
  source "__binop.mul" -> code.ComputedSizeValue
  flag code.IntegerSizeArithmetic on any {
    path "__binop.mul"
  }
  flag code.IntegerSizeArithmetic on any {
    path "__binop.shl"
  }
  control "analysis.guard.value_exclusion" val "value=0" -> core.ZeroValueExclusion

  // TOCTOU / race (CWE-367)
  flag code.FileCheck on any {
    path "access"
  }
  flag code.FileCheck on any {
    path "stat"
  }
  flag code.FileCheck on any {
    path "lstat"
  }
  flag code.FileCheck on any {
    path "std.filesystem.exists"
  }
  flag code.FileUse on any {
    path "fopen"
  }
  flag code.FileUse on any {
    path "open"
  }
  flag code.FileUse on any {
    path "remove"
  }
  flag code.FileUse on any {
    path "unlink"
  }
  flag code.FileUse on any {
    path "rename"
  }
  flag code.FileUse on any {
    path "chmod"
  }
  flag code.FileUse on any {
    path "chown"
  }

  // lifecycle / concurrency
  flag code.LockAcquire on any {
    path "pthread_mutex_lock"
  }
  flag code.LockAcquire on any {
    path "mtx_lock"
  }
  flag code.LockAcquire on any {
    path "mutex.lock"
  }
  flag code.LockAcquire on any {
    method "lock"
  }
  control "pthread_mutex_unlock" -> core.LockRelease
  control "mtx_unlock" -> core.LockRelease
  control method "unlock" -> core.LockRelease
  flag code.LocklessSharedMutation on any {
    path "pthread_create"
  }
  flag code.LocklessSharedMutation on any {
    path "std.thread"
  }

  // XSS (CWE-79) — writing untrusted HTML to an output stream (arg0 is the text)
  sink path "fputs" -> code.HtmlRender
  sink path "fwrite" -> code.HtmlRender

  // LDAP injection (CWE-90) — OpenLDAP search (the filter is arg3)
  sink path "ldap_search_ext_s" arg 3 -> code.LdapQuery
  sink path "ldap_search_s" arg 3 -> code.LdapQuery

  // XPath injection (CWE-643) — libxml2 (the expression is arg0)
  sink path "xmlXPathEvalExpression" -> code.XpathQuery
  sink path "xmlXPathEval" -> code.XpathQuery

  // format string (CWE-134) — tainted FORMAT argument
  sink path "printf" arg 0 -> code.FormatString
  sink path "fprintf" arg 1 -> code.FormatString
  sink path "syslog" arg 1 -> code.FormatString

  // regex compile (ReDoS) — POSIX regcomp (pattern is arg1)
  sink path "regcomp" arg 1 -> code.RegexCompile

  // SSRF — libcurl (tainted option value, most commonly CURLOPT_URL, is arg2)
  sink path "curl_easy_setopt" arg 2 -> code.UrlFetch

  // XXE (CWE-611) — libxml2 readers (xml content/path is arg0)
  sink path "xmlReadMemory" -> code.XmlParse
  sink path "xmlReadFile" -> code.XmlParse
  sink path "xmlReadDoc" -> code.XmlParse
  sink path "xmlParseFile" -> code.XmlParse
  sink path "xmlParseMemory" -> code.XmlParse

  // weak hash (CWE-328) — OpenSSL MD4/MD5/SHA1 (presence); SHA-256 is safe
  flag code.WeakHash on any {
    path "MD5_Init"
  }
  flag code.WeakHash on any {
    path "MD5"
  }
  flag code.WeakHash on any {
    path "MD4"
  }
  flag code.WeakHash on any {
    path "SHA1_Init"
  }
  flag code.WeakHash on any {
    path "SHA1"
  }
  flag code.WeakHash on any {
    path "EVP_md5"
  }
  flag code.WeakHash on any {
    path "EVP_sha1"
  }

  // weak cipher (CWE-327) — OpenSSL DES (presence); AES is safe
  flag code.WeakCipher on any {
    path "DES_ecb_encrypt"
  }
  flag code.WeakCipher on any {
    path "DES_ncbc_encrypt"
  }
  flag code.WeakCipher on any {
    path "DES_set_key"
  }
  flag code.WeakCipher on any {
    path "RC4"
  }
  flag code.WeakCipher on any {
    path "BF_set_key"
  }
  flag code.StaticIv on any {
    path "EVP_EncryptInit_ex"
    has "0000000000000000"
  }
  flag code.StaticIv on any {
    path "EVP_DecryptInit_ex"
    has "0000000000000000"
  }

  // insecure randomness (CWE-330) — rand()/random() (presence); getrandom()/RAND_bytes safe
  flag code.WeakRandomValue on any {
    path "rand"
  }
  flag code.WeakRandomValue on any {
    path "random"
  }
  flag code.WeakRandomValue on any {
    path "rand_r"
  }

  // controls (sanitizers) — realpath canonicalizes a path; preamble defines the rest
  control "realpath" -> core.PathCanonicalization
  control "safe_path" -> core.PathCanonicalization
  control "escape_shell" -> core.ShellEscape
  control "escape_html" -> core.HtmlEscape
  control "encode_for_ldap" -> core.LdapEscape
  control "escape_xpath" -> core.XpathEscape
}
