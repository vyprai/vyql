// scala framework adapter (docs/07) — framework→concept content.
// frameworks: play, akka-http, slick, anorm
adapter scala {
  meta { match: contains, fidelity: resolved }

  // Play / request inputs (receiver name varies → substring match)
  source ".getQueryString" -> code.HttpInput
  source ".queryString" -> code.HttpInput
  source ".getQueryParameter" -> code.HttpInput
  source "http_input" -> code.HttpInput

  // command execution
  sink path "Process" -> code.CommandExecution
  sink method "exec" -> code.CommandExecution

  // SQL
  sink method "executeQuery" -> code.SqlExecution
  sink method "executeUpdate" -> code.SqlExecution
  sink method "execute" -> code.SqlExecution
  sink path "SQL" -> code.SqlExecution
  sink method "prepareStatement" -> code.SqlExecution

  // path / file
  sink path "Source.fromFile" -> code.FilePathAccess
  sink method "readAllBytes" -> code.FilePathAccess

  // SSRF — Play WS (ws.url), akka-http, sttp client
  sink path "ws.url" -> code.UrlFetch
  sink method "singleRequest" -> code.UrlFetch

  // regex compile (ReDoS) — tainted PATTERN
  sink path "Pattern.compile" -> code.RegexCompile

  // deserialization (CWE-502) — Java ObjectInputStream + Apache Commons / Jackson
  sink method "readObject" -> code.Deserialization
  sink method "deserialize" -> code.Deserialization
  sink method "readValue" -> code.Deserialization

  // weak crypto (CWE-327) — JCA, same API as Java
  mark "MessageDigest.getInstance" val "MD2" -> code.WeakHash
  mark "MessageDigest.getInstance" val "MD5" -> code.WeakHash
  mark "MessageDigest.getInstance" val "SHA-1" -> code.WeakHash
  mark "MessageDigest.getInstance" val "SHA1" -> code.WeakHash
  mark "Cipher.getInstance" val "DES" -> code.WeakCipher
  mark "Cipher.getInstance" val "RC4" -> code.WeakCipher
  mark "Cipher.getInstance" val "Blowfish" -> code.WeakCipher

  // expression-language injection (CWE-917)
  sink method "parseExpression" -> code.ExpressionEval

  // XSS — Play Twirl Html(...) emits unescaped markup.
  sink path "Html" -> code.HtmlRender

  // sanitizer — Apache Commons Text HTML escaping.
  control "escapeHtml4" -> core.HtmlEscape
  control "StringEscapeUtils.escapeHtml4" -> core.HtmlEscape
}
