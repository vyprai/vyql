// lua framework adapter (docs/07) — framework→concept content.
// frameworks: openresty/nginx-lua, kong, luasql, lualdap, lua-resty-*
adapter lua {
  meta { fidelity: resolved }

  // OpenResty / nginx-lua request inputs
  source "ngx.var" -> code.HttpInput
  source "ngx.req.get_uri_args" -> code.HttpInput
  source "ngx.req.get_post_args" -> code.HttpInput
  source "ngx.req.get_headers" -> code.HttpInput
  source "ngx.req.get_body_data" -> code.HttpInput

  // command execution (the shell command is arg0)
  sink path "os.execute" -> code.CommandExecution
  sink path "io.popen" -> code.CommandExecution

  // code evaluation / dynamic load
  sink path "loadstring" -> code.CodeEval
  sink path "load" -> code.CodeEval
  sink path "loadfile" -> code.CodeEval
  sink path "dofile" -> code.CodeEval
  sink path "require" -> code.DynamicCodeLoad
  sink path "loadfile" -> code.DynamicCodeLoad
  sink path "dofile" -> code.DynamicCodeLoad

  // path / file (the path is arg0)
  sink path "io.open" -> code.FilePathAccess
  sink path "io.lines" -> code.FilePathAccess
  sink path "os.remove" -> code.FilePathAccess
  sink path "os.rename" -> code.FilePathAccess
  sink path "lfs.attributes" -> code.FilePathAccess
  sink path "lfs.chdir" -> code.FilePathAccess
  sink path "lfs.mkdir" -> code.FilePathAccess
  sink path "lfs.rmdir" -> code.FilePathAccess
  sink path "lfs.touch" -> code.FilePathAccess
  sink path "lfs.chmod" -> code.FilePathAccess
  sink method "extractEntry" -> code.ArchiveEntryWrite
  sink method "extract" -> code.ArchiveEntryWrite

  // SQL — luasql conn:execute / resty.mysql db:query (raw query string is arg0)
  sink method "query" -> code.SqlExecution
  sink method "execute" -> code.SqlExecution

  // XSS — OpenResty response writers reflect tainted output (any arg)
  sink path "ngx.say" arg all -> code.HtmlRender
  sink path "ngx.print" arg all -> code.HtmlRender

  // SSRF — luasocket http.request / resty.http request_uri
  sink path "http.request" -> code.UrlFetch
  sink method "request_uri" -> code.UrlFetch
  sink path "ngx.re.match" arg 1 -> code.RegexCompile
  sink path "ngx.re.find" arg 1 -> code.RegexCompile
  sink path "ngx.re.gsub" arg 1 -> code.RegexCompile
  mark "http.request" val "http://" nval "127.0" -> code.CleartextChannel
  mark "request_uri" val "http://" nval "127.0" -> code.CleartextChannel

  // LDAP (CWE-90) — lualdap ld:search (filter is arg1)
  sink method "search" arg 1 -> code.LdapQuery

  // XPath (CWE-643) — luaexpat/xmlua evaluate (expression is arg0)
  sink method "evaluate" arg 0 -> code.XpathQuery

  // trust boundary (CWE-501) — untrusted data into the session (any arg)
  sink method "set" arg all -> code.TrustBoundary
  sink method "find_by_id" -> code.ObjectLookupByUserInput
  sink method "get_user" -> code.ObjectLookupByUserInput
  sink method "get_account" -> code.ObjectLookupByUserInput
  mark "change_password" -> code.AuthenticationRequiredOp
  mark "update_password" -> code.AuthenticationRequiredOp
  mark "reset_password" -> code.AuthenticationRequiredOp
  mark "change_email" -> code.AuthenticationRequiredOp
  mark "transfer_funds" -> code.AuthenticationRequiredOp
  mark "delete_account" -> code.AuthenticationRequiredOp
  mark "grant_role" -> code.AuthenticationRequiredOp
  mark "make_admin" -> code.AuthenticationRequiredOp

  // weak hash (CWE-328) — md5/sha1 digests (sha256 is safe; distinct path = no collision)
  mark "md5.sum" -> code.WeakHash
  mark "sha1.sum" -> code.WeakHash
  mark "ngx.md5" -> code.WeakHash
  mark "ngx.sha1_bin" -> code.WeakHash

  // weak cipher (CWE-327) — val-matched on the algorithm string (AES is safe)
  mark "crypto.cipher" val "DES" -> code.WeakCipher
  mark "crypto.cipher" val "RC4" -> code.WeakCipher
  mark "crypto.cipher" val "Blowfish" -> code.WeakCipher
  mark "crypto.cipher" val "0000000000000000" -> code.StaticIv

  // insecure randomness (CWE-330) — math.random (resty.random.bytes is safe)
  mark "math.random" -> code.WeakRandomValue

  // insecure cookie (CWE-614) — cookie flags set to false
  mark "set_secure" val "false" -> code.InsecureCookie
  mark "set_httponly" val "false" -> code.InsecureCookie
  mark "lfs.chmod" val "777" -> code.InsecurePermission
  mark "lfs.chmod" val "666" -> code.InsecurePermission
  mark "os.tmpname" -> code.InsecureTempFile
  mark "io.open" -> code.ResourceHandle
  mark "socket.tcp" -> code.ResourceHandle
  control method "close" -> core.ResourceRelease

  // controls — sanitizers/validators defined in each generated case's preamble
  control "escapeHtml" -> core.HtmlEscape
  control "escapeXPath" -> core.XpathEscape
  control "encodeForLDAP" -> core.LdapEscape
  control "escapeShell" -> core.ShellEscape
  control "safePath" -> core.PathCanonicalization
  control "validateRole" -> core.InputValidation
  control "require_auth" -> core.AuthenticationCheck
  control "ensure_authenticated" -> core.AuthenticationCheck
  control "check_ownership" -> core.OwnershipCheck
  control "require_owner" -> core.OwnershipCheck
  control "ngx.quote_sql_str" -> core.SqlParameterization
}
