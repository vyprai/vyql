module bindings.cpp.migration.m4e783366;

binding fileCheck103 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "std.filesystem.exists"
  emit issue code.FileCheck at node
}
