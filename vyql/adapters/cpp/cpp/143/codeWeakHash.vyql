module bindings.cpp.migration.m4e783366;

binding weakHash143 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "EVP_sha1"
  emit issue code.WeakHash at node
}
