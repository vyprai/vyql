binding windowsRemotePathCredentialLeak84 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=cpp" and node.token contains "QFileInfo::exists(m_configFile)" and node.token contains "QSettingsconfig(m_configFile,QSettings::IniFormat)" and node.token contains "m_pWatchdog->setProcessConfig(command,elevate)" and not (node.token contains "m_configFile.startsWith(QStringLiteral(\"\\\\\\\\\"))") and not (node.token contains "m_configFile.startsWith(QStringLiteral(\"//\"))")
  emit issue code.WindowsRemotePathCredentialLeak at node
}
