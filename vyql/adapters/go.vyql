  // Review-only: writing security state through ordinary path opening of procfs control
  // files needs a verified procfs/open boundary to avoid link or mount redirection.
  flag code.SpecialFileAccessReview in function {
    call path "os.OpenFile"
    literal "/proc/self/attr/exec"
    not call "OpenProcRoot"
    not call "OpenThreadSelf"
    not call path "pathrs.Reopen"
  }
  // Review-only: request/header secrets compared after ordinary string conversion need
  // constant-time comparison when attacker-controlled candidates can be repeated.
  flag code.SecretComparisonReview in function {
    function "ParseAndValidate"
    selector "r.Header.Get"
    call "string"
    not call "ConstantTimeCompare"
  }
  flag code.SecretComparisonReview in function {
    call "BasicAuth"
    binary "username==wrapper.username"
    binary "password==wrapper.password"
    not call "ConstantTimeCompare"
  }
  flag code.SecretComparisonReview in function {
    call path "scrypt.Key"
    call path "bytes.Equal"
    call arg "bytes.Equal:source_master_key"
    call arg "bytes.Equal:target_master_key"
    not call "ConstantTimeCompare"
    not call path "hmac.Equal"
    not call path "subtle.ConstantTimeCompare"
  }
  flag code.SecretComparisonReview on binop {
    op any ["==", "!="]
    operand {
      key contains_any [".Password", ".password", ".Secret", ".secret", ".Token", ".token", ".APIKey", ".apiKey", ".AccessKey", ".accessKey"]
    }
    operand {
      key contains_any [".Password", ".password", ".Secret", ".secret", ".Token", ".token", ".APIKey", ".apiKey", ".AccessKey", ".accessKey"]
    }
    lacks call contains_any ["ConstantTimeCompare", "hmac.Equal", "subtle.ConstantTimeCompare", "CompareHashAndPassword"]
  }
  flag code.FastPasswordHash in function {
    function "GenerateUsers"
    has "user.Password"
    has "sha256sum"
    lacks "GenerateFromPassword"
    lacks "bcrypt"
    lacks "argon2"
    lacks "scrypt"
  }
  flag code.FastPasswordHash in function {
    function "FindByPassword"
    has "user.Password"
    has "sha256sum"
    lacks "CompareHashAndPassword"
    lacks "bcrypt"
    lacks "argon2"
