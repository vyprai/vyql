  flag code.LengthDerivedAllocation in function {
    selector "r.ContentLength"
    call "make"
    call path "io.ReadFull"
    not call path "io.LimitReader"
    not call path "http.MaxBytesReader"
  }
  flag code.FieldDerivedIndexAccess in function {
    call "ReadString"
    call "BytesNtohs"
