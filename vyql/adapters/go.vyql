  flag code.SamlAssertionWrappingBypass in function {
    lang "go"
    call path "etreeutils.NSDetatch"
    call path "v.context.Validate"
    call path "elt.RemoveChild"
    call path "elt.AddChild"
    not call path "elt.ChildElements"
    not call path "child.NamespaceURI"
    not var "errMultipleAssertions"
  }

  // resource lifecycle (CWE-772) — raw handles that must be closed.
  flag code.ResourceHandle on any {
    path "net.Dial"
  }
  flag code.ResourceHandle on any {
    path "net.DialTimeout"
  }
  flag code.ResourceHandle on any {
    path "os.Open"
  }
  flag code.ResourceHandle on any {
    path "os.OpenFile"
  }
  flag code.ResourceHandle on any {
    path "os.Create"
  }
  control method "Close" -> core.ResourceRelease

  // permissive CORS (CWE-942) — w.Header().Set("Access-Control-Allow-Origin", "*")
  flag code.PermissiveCors on any {
    path "Header.Set"
    has "Access-Control-Allow-Origin"
    has "*"
  }
  flag code.PermissiveCors on any {
    path "Header.Add"
    has "Access-Control-Allow-Origin"
    has "*"
  }
  // CORS wildcard origin parsers must keep the whole prefix before a trailing *.
  // Slicing to i-1 before prefix matching weakens origin validation by one byte.
  flag code.CorsWildcardPrefixTruncation in function {
    function "parseWildcardRules"
    selector "c.AllowOrigins"
    selector "c.AllowWildcard"
    call path "strings.Index"
    call path "append"
    slice "o::i-1"
  }

  // clickjacking (CWE-1021) — X-Frame-Options EXPLICITLY set to ALLOWALL (omission not flagged)
  flag code.MissingFrameProtection on any {
    path "Header.Set"
    has "X-Frame-Options"
    has "ALLOWALL"
  }
  flag code.MissingFrameProtection on any {
    path "Header.Add"
    has "X-Frame-Options"
    has "ALLOWALL"
  }

  // insecure cookie (CWE-614) — http.Cookie{HttpOnly: false} / {Secure: false} explicit
  flag code.InsecureCookie on any {
    path "http.Cookie"
    has "HttpOnly=false"
  }
  flag code.InsecureCookie on any {
    path "http.Cookie"
    has "Secure=false"
  }
  flag code.InsecureCookie in function {
    has "ctx.SetCookie"
    has "GenerateToken"
    has "opt.CookieHttpOnly"
    has "false"
    lacks "opt.Secure"
  }

  // cleartext channel (CWE-319) — http:// URL to net/http (loopback excluded; low sev)
  flag code.CleartextChannel on any {
    path "http.Get"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "http.Post"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "http.NewRequest"
    has "http://"
    lacks "127.0"
  }

  // lifecycle / locking (CWE-667)
  flag code.LockAcquire on any {
    path "Lock"
  }
  flag code.LockAcquire on any {
    path "RLock"
  }
  flag code.RecursiveJsonMarshalUnderLock in function {
    function "MarshalJSON"
    call path "ps.mtx.Lock"
    call path "cmtjson.Marshal"
    selector "ps"
    lacks "jsonPeerState"
    not call path "ps.Count"
    not call path "ps.Total"
  }
  flag code.LocklessSharedMutation on any {
    path exact "analysis.global.mutation"
    field "ctx"
  }
  flag code.LocklessSharedMutation on any {
    path exact "analysis.global.mutation"
    field "roundTripper"
  }
  flag code.LocklessSharedMutation in function {
    function "ReplaceIndividualSubcription"
    call "GetSubscription"
    index "bsfContext.BsfSelf.Subscriptions:subId"
    call "Status"
    selector "http.StatusNoContent"
    not selector "http.StatusNotFound"
  }
  control method "Unlock" -> core.LockRelease
  control method "RUnlock" -> core.LockRelease


  // character-filter: regexp (*Regexp).ReplaceAllString is global.
  filter method "ReplaceAllString" global
  filter method "ReplaceAll" global
}
