// go framework adapter (docs/07) — framework→concept content.
// frameworks: net/http, gin, echo, fiber, chi, gorilla/mux, beego
adapter go {
  meta { match: contains, fidelity: resolved }

  // constructor -> receiver type (for type-constrained sinks)
  type "sql.Open" -> sql.DB
  type "sql.OpenDB" -> sql.DB
  type "sqlx.Open" -> sqlx.DB
  type "sqlx.Connect" -> sqlx.DB
  type "sqlx.MustConnect" -> sqlx.DB
  type "gorm.Open" -> gorm.DB
  type "redis.NewClient" -> redis.Client
  type "mongo.Connect" -> mongo.Database
  type "graphql.NewClient" -> graphql.Client
  // LDAP / XPath / session handles (go-ldap Conn.Search, antchfx doc, gorilla sessions)
  type "ldap.DialURL" -> ldap.Conn
  type "ldap.Dial" -> ldap.Conn
  type "support.NewLDAP" -> ldap.Conn
  type "support.NewXMLDoc" -> xpath.Doc
  type "support.NewSession" -> session.Store
  type "csv.NewWriter" -> csv.Writer

  source path "analysis.parameter.entry" val "param_type:http.Request" -> code.HttpInput
  source "os.Args" -> code.CliArgument
  source "os.Getenv" -> code.EnvVariable
  source "flag.Arg" -> code.CliArgument
  source "flag.Args" -> code.CliArgument
  source ".URL.Query" -> code.HttpInput
  source ".URL.RawQuery" -> code.HttpInput
  source ".URL.Path" -> code.HttpInput
  source "FormValue" -> code.HttpInput
  source "PostFormValue" -> code.HttpInput
  source "FormFile" -> code.HttpInput
  source ".PostForm" -> code.HttpInput
  source ".Form.Get" -> code.HttpInput
  source ".Header.Get" -> code.HttpInput
  source ".GetHeader" -> code.HttpInput
  source ".QueryParam" -> code.HttpInput
  source ".DefaultQuery" -> code.HttpInput
  source ".QueryArray" -> code.HttpInput
  source ".GetQuery" -> code.HttpInput
  source ".ShouldBind" -> code.HttpInput
  source ".ShouldBindJSON" -> code.HttpInput
  source ".ShouldBindQuery" -> code.HttpInput
  source ".ShouldBindUri" -> code.HttpInput
  source ".ShouldBindWith" -> code.HttpInput
  source ".ShouldBindBodyWith" -> code.HttpInput
  source ".BindJSON" -> code.HttpInput
  source ".BindQuery" -> code.HttpInput
  source ".BindUri" -> code.HttpInput
  source ".BindWith" -> code.HttpInput
  // NOTE: bare `.Bind` and `.Body` were removed — too broad (matched tmpl.Bind / a
  // client resp.Body), causing false positives. The specific gin/echo bind methods
  // above are precise; the bind out-param taint handles `c.Bind(&x)`-style decode.
  source ".URLParam" -> code.HttpInput
  source "mux.Vars" -> code.HttpInput
  source ".Cookie" -> code.HttpInput
  source ".Params" -> code.HttpInput
  source ".Param" -> code.HttpInput
  // OIDC issuers/subjects/audiences are parsed from untrusted bearer tokens before
  // verification; provider discovery on those values is an SSRF-sensitive fetch.
  source "auth.ExtractIssuer" -> code.HttpInput
  source "apiauth.ExtractIssuer" -> code.HttpInput
  source "ExtractIssuer" -> code.HttpInput

  sink method "Query" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "QueryRow" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "QueryContext" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "QueryRowContext" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "Exec" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "ExecContext" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "Prepare" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "PrepareContext" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink path "gorm.Raw" -> code.SqlExecution
  sink path "db.Raw" -> code.SqlExecution
  // gorm's .Raw(sql) is frequently called on a non-db-named receiver (e.g. a helper
  // return: `q := getDB(); q.Raw(sql)`), which the dotted-path forms above miss. The
  // method form catches it regardless of receiver var; SqlExecution only yields a
  // finding under taint, so receiver-agnostic matching is safe for recall.
  sink method "Raw" -> code.SqlExecution
  sink path "sqlx.Query" -> code.SqlExecution
  sink path "sqlx.MustExec" -> code.SqlExecution
  sink path "bun.Raw" -> code.SqlExecution
  sink path "exec.Command" -> code.CommandExecution
  sink path "exec.CommandContext" -> code.CommandExecution
  sink path "os/exec.Command" -> code.CommandExecution
  // `exec.Command("sh", "-c", X)` — arg0 is the constant shell, the tainted script
  // is arg2; the `-c` literal disambiguates this shell-wrapper form.
  sink path "exec.Command" arg 2 val "-c" -> code.CommandExecution
  sink path "exec.CommandContext" arg 3 val "-c" -> code.CommandExecution
  sink path "syscall.Exec" -> code.CommandExecution
  sink path "syscall.ForkExec" -> code.CommandExecution
  sink path "sh.Command" -> code.CommandExecution
  // chaosblade-spec-go `channel.NewLocalChannel().Run(ctx, prog, args)` runs a shell
  // command; the distinctive constructor segment keeps this from matching unrelated `.Run`.
  sink path "channel.NewLocalChannel.Run" arg all -> code.CommandExecution
  sink path "http.Get" -> code.UrlFetch
  sink path "http.Post" -> code.UrlFetch
  sink path "http.Head" -> code.UrlFetch
  sink path "http.PostForm" -> code.UrlFetch
  sink path "http.NewRequest" -> code.UrlFetch
  sink path "http.NewRequestWithContext" -> code.UrlFetch
  sink path "client.Get" -> code.UrlFetch
  sink path "client.Post" -> code.UrlFetch
  sink path "client.Do" -> code.UrlFetch
  sink path "client.Head" -> code.UrlFetch
  sink path "provider.Get" arg 1 val "issuer" -> code.UrlFetch
  sink path "oidc.NewProvider" arg 1 -> code.UrlFetch
  sink path "resty.R" -> code.UrlFetch
  sink path "req.Get" -> code.UrlFetch
  sink path "os.Open" -> code.FilePathAccess
  sink path "os.OpenFile" -> code.FilePathAccess
  sink path "os.ReadFile" -> code.FilePathAccess
  sink path "os.Create" -> code.FilePathAccess
  sink path "os.Create" -> code.UnsafeUpload
  sink path "os.Remove" -> code.FilePathAccess
  sink path "os.RemoveAll" -> code.FilePathAccess
  sink path "ioutil.ReadFile" -> code.FilePathAccess
  sink path "ioutil.WriteFile" -> code.FilePathAccess
  sink path "os.WriteFile" -> code.UnsafeUpload
  sink path "ioutil.WriteFile" -> code.UnsafeUpload
  sink path "http.ServeFile" -> code.FilePathAccess
  sink path "os.Mkdir" -> code.FilePathAccess
  sink path "os.MkdirAll" -> code.FilePathAccess
  sink path "filepath.Walk" -> code.FilePathAccess
  sink path "plugin.Open" -> code.DynamicCodeLoad
  sink path "extractEntry" -> code.ArchiveEntryWrite
  sink path "writeArchiveEntry" -> code.ArchiveEntryWrite
  // LDAP injection (CWE-90), XPath injection (CWE-643), trust-boundary write (CWE-501)
  sink method "Search" on [ldap.Conn] -> code.LdapQuery
  sink method "SearchWithPaging" on [ldap.Conn] -> code.LdapQuery
  sink method "XPath" on [xpath.Doc] -> code.XpathQuery
  sink method "Find" on [xpath.Doc] -> code.XpathQuery
  sink method "Set" arg 1 on [session.Store] -> code.TrustBoundary
  // template.HTML(x) casts an untrusted string to "safe" HTML, bypassing contextual
  // auto-escaping → reflected XSS (CWE-79), defended by HTML-escaping the input.
  sink path "template.HTML" -> code.HtmlRender
  sink path "template.JS" -> code.HtmlRender
  sink path "template.URL" -> code.HtmlRender
  // Helpers that construct and return raw HTML bytes/strings are response render
  // boundaries when caller-controlled values are interpolated into the returned value.
  // The Go frontend emits neutral function literal evidence; this adapter assigns the
  // security meaning in data.
  sink path "analysis.function.return" val "<html" -> code.HtmlRender
  sink path "analysis.function.return" val "<body" -> code.HtmlRender
  sink path "analysis.function.return" val "<a " -> code.HtmlRender
  // Gin/http response writer bodies. These are the last-hop render boundary for
  // raw strings/bytes assembled by handlers.
  sink path "Writer.WriteString" -> code.HtmlRender
  sink path "Writer.Write" -> code.HtmlRender
  sink path "http.Redirect" -> code.RedirectTarget
  sink path "c.Redirect" -> code.RedirectTarget
  sink path "ctx.Redirect" -> code.RedirectTarget
  sink method "FindByID" -> code.ObjectLookupByUserInput
  sink method "FindById" -> code.ObjectLookupByUserInput
  sink method "GetUser" -> code.ObjectLookupByUserInput
  sink method "GetAccount" -> code.ObjectLookupByUserInput
  sink method "GetOrder" -> code.ObjectLookupByUserInput
  mark "ChangePassword" -> code.AuthenticationRequiredOp
  mark "UpdatePassword" -> code.AuthenticationRequiredOp
  mark "ResetPassword" -> code.AuthenticationRequiredOp
  mark "ChangeEmail" -> code.AuthenticationRequiredOp
  mark "TransferFunds" -> code.AuthenticationRequiredOp
  mark "DeleteAccount" -> code.AuthenticationRequiredOp
  mark "GrantRole" -> code.AuthenticationRequiredOp
  mark "MakeAdmin" -> code.AuthenticationRequiredOp
  mark exact "analysis.function.context" val "function_name:SolveChallenge" val "selector:challenge.tries" val "selector:s.challenges" -> code.AuthAttemptLimitReview
  mark exact "analysis.function.context" val "function_name:Verify" val "call:Get" val "binary:v==answer" nval "binary:v!=\"\"" -> code.EmptyVerifierAcceptance
  // HTTP response splitting / header injection (CWE-113).
  sink path "Header.Set" arg 1 -> code.ResponseHeaderWrite
  sink path "Header.Add" arg 1 -> code.ResponseHeaderWrite
  // log injection (CWE-117) + secret-in-log (CWE-532).
  sink path "log.Print" arg all -> code.LogOutput
  sink path "log.Printf" arg all -> code.LogOutput
  sink path "log.Println" arg all -> code.LogOutput
  mark "log.Print" -> code.LogWrite
  mark "log.Printf" -> code.LogWrite
  mark "log.Println" -> code.LogWrite
  // CSV/formula injection (CWE-1236).
  sink path "writer.Write" arg all collection -> code.CsvCell
  sink path "csvWriter.Write" arg all collection -> code.CsvCell
  sink path "csvw.Write" arg all collection -> code.CsvCell

  // controls (sanitizers/validators) — neutralize a flow that passes through them
  control "html.EscapeString" -> core.HtmlEscape
  control "template.HTMLEscapeString" -> core.HtmlEscape
  control "ctx.Header" val "content-type" val "image/" -> core.SafeResponseContentType
  control "c.Header" val "content-type" val "image/" -> core.SafeResponseContentType
  control "Header.Set" val "content-type" val "image/" -> core.SafeResponseContentType
  control "Header.Add" val "content-type" val "image/" -> core.SafeResponseContentType
  // filepath.Base strips all directory components — no `/`, `\`, or `..` survives, so it
  // confines a path to a single segment (the Go analogue of path.basename).
  control "filepath.Base" -> core.PathCanonicalization
  // A path denylist that rejects parent-directory and Windows separator tokens is
  // a real traversal guard; weaker substring checks remain ordinary calls.
  control "strings.Contains" val ".." val "\\" -> core.PathAccessCheck
  control "pathrs.Reopen" -> core.PathAccessCheck
  control "procfs.OpenProcRoot" -> core.PathAccessCheck
  control method "OpenThreadSelf" -> core.PathAccessCheck
  // benchmark-harness escapers/validators (wrap real neutralization the rule honors).
  control "support.EscapeLDAP" -> core.LdapEscape
  control "support.XPathLiteral" -> core.XpathEscape
  control "support.AllowRole" -> core.InputValidation
  control method "RequireAuth" -> core.AuthenticationCheck
  control method "EnsureAuthenticated" -> core.AuthenticationCheck
  control method "IsAuthenticated" -> core.AuthenticationCheck
  control method "Authenticate" -> core.AuthenticationCheck
  control method "CheckOwnership" -> core.OwnershipCheck
  control method "RequireOwner" -> core.OwnershipCheck
  control method "IsOwner" -> core.OwnershipCheck
  control "oidcvalidate.IsValidIssuer" -> core.AllowlistValidation
  control "IsValidIssuer" -> core.AllowlistValidation

  // regex compile (ReDoS, CWE-1333) — tainted PATTERN arg0
  sink path "regexp.Compile" -> code.RegexCompile
  sink path "regexp.MustCompile" -> code.RegexCompile
  sink path "regexp.MatchString" -> code.RegexCompile

  // weak crypto (CWE-327) — presence marker on the call node
  mark "md5.New" -> code.WeakHash
  mark "sha1.New" -> code.WeakHash
  // one-shot digests: md5.Sum(b) / sha1.Sum(b) are the common Go idiom alongside .New().
  mark "md5.Sum" -> code.WeakHash
  mark "sha1.Sum" -> code.WeakHash

  // insecure randomness (CWE-330) — math/rand. The math/rand-only methods (Intn/Int31/
  // Int63/Float64/Perm/Shuffle) disambiguate from crypto/rand (which has Read/Int/Prime).
  mark "rand.Intn" -> code.WeakRandomValue
  mark "rand.Int31" -> code.WeakRandomValue
  mark "rand.Int31n" -> code.WeakRandomValue
  mark "rand.Int63" -> code.WeakRandomValue
  mark "rand.Int63n" -> code.WeakRandomValue
  mark "rand.Float64" -> code.WeakRandomValue
  mark "rand.Float32" -> code.WeakRandomValue
  mark "rand.Perm" -> code.WeakRandomValue
  mark "rand.Shuffle" -> code.WeakRandomValue
  mark "rand.NewSource" -> code.WeakRandomValue

  // weak cipher (CWE-327) — named broken ciphers
  mark "des.NewCipher" -> code.WeakCipher
  mark "des.NewTripleDESCipher" -> code.WeakCipher
  mark "rc4.NewCipher" -> code.WeakCipher
  mark "cipher.NewCBCEncrypter" val "0000000000000000" -> code.StaticIv
  mark "cipher.NewCBCDecrypter" val "0000000000000000" -> code.StaticIv

  // insecure file permission (CWE-732) — world-writable mode on chmod/WriteFile/MkdirAll.
  // octal literal text is carried by the frontend; restrictive modes are not matched.
  mark "os.Chmod" val "0777" -> code.InsecurePermission
  mark "os.Chmod" val "0666" -> code.InsecurePermission
  mark "os.MkdirAll" val "0777" -> code.InsecurePermission
  mark "os.WriteFile" val "0777" -> code.InsecurePermission
  // Review-only: project-specific config serializers often need an explicit
  // "redact/scrub secrets" option before returning configs through diagnostics/API.
  mark "MarshalConfig" val "false" -> code.ConfigExposureReview
  mark "instance.MarshalConfig" val "false" -> code.ConfigExposureReview
  mark exact "analysis.type.context" val "field:Repositories" val "field:Keyring" nval "method:MarshalYAML" -> code.ConfigExposureReview
  mark "settingspkg.Settings" val "PasswordPattern" -> code.SensitiveSettingsExposureReview
  // Review-only: protocol/state handlers that stop a registration timer without
  // first checking the corresponding state can accept out-of-sequence messages.
  mark exact "analysis.function.context" val "call:StopT3550" nval "selector:ue.T3550" -> code.ProtocolStateReview
  // Review-only: protocol handlers that compare an incoming previous-state pointer
  // against the last stored state need manual review for stale or forked-chain cases.
  mark exact "analysis.function.context" val "PrevATXID" val "call:GetLastIDByNodeID" -> code.ProtocolStateReview
  // Review-only: request handlers that derive request metadata, load resource metadata,
  // then dispatch a resource handler need a visible request/resource scope consistency
  // check before dispatch.
  mark exact "analysis.function.context" val "function_name:ServeHTTP" val "call:RequestInfoFrom" val "call:Get" val "call:serveResource" nval "selector:apiextensions.NamespaceScoped" -> code.RequestScopePolicyReview
  // Review-only: admission ignore helpers that skip every non-empty subresource
  // need manual review for alternate API paths that bypass the primary policy.
  mark exact "analysis.function.context" val "function_name:shouldIgnore" val "call:GetSubresource" nval "ignoredSubresources" -> code.AdmissionSubresourcePolicyReview
  mark exact "analysis.function.context" val "call:LoadOrStore" val "literal:overflow" -> code.UnboundedStateGrowthReview
  mark exact "analysis.function.context" val "function_name:MessageReceived" val "call:Wantlist" val "call:splitWantsCancels" val "call:Wants" val "call:PushTasksTruncated" nval "call:ByteLen" nval "mh.IDENTITY" -> code.UnboundedProtocolStateByIdentifier
  mark exact "analysis.function.context" val "function_name:readBytes" val "call:ReadLong" val "call:int" val "call:make" nval "selector:math.MaxInt" -> code.IntegerSizeArithmetic
  mark exact "analysis.function.context" val "call:ReadBlockHeader" val "call:int" val "call:getMaxSliceAllocSize" -> code.IntegerSizeArithmetic
  mark exact "analysis.function.context" val "call:ReadBlockHeader" val "call:int" val "call:getMaxMapAllocSize" -> code.IntegerSizeArithmetic
  mark exact "analysis.function.context" val "call:SkipNBytes" val "call:int" nval "call:SkipNBytesInt64" nval "function_name:SkipNBytesInt64" -> code.IntegerSizeArithmetic
  mark exact "analysis.function.context" val "function_name:readBlock" val "call:ReadLong" val "call:make" nval "selector:math.MaxInt" -> code.IntegerSizeArithmetic
  mark exact "analysis.function.context" val "function_name:readNBytes" val "call:make" val "call:ReadByte" nval "selector:reader.data" nval "selector:reader.pos" -> code.LengthDerivedAllocation
  mark exact "analysis.function.context" val "call:ReadString" val "call:BytesNtohs" val "binary:len(buf)<=off" nval "binary:len(buf)<off+2" -> code.FieldDerivedIndexAccess
  mark exact "analysis.function.context" val "call_path:fmt.Sprintf" val "literal:%08b" val "index:capabilities:8" nval "literal:%016b" -> code.UnderwidthFormattedIndex
  sink method "BranchPageElement" val "Count" -> code.CountDerivedElementAccess
  mark "__binop.ne" val "Count" val "0" -> core.MemoryBoundsCheck
  mark exact "analysis.function.context" val "literal:SELECT 'aurora_global_db_status'::regproc" nval "pg_catalog.aurora_global_db_status" -> code.UnqualifiedDatabaseRoutineReview
  mark exact "analysis.function.context" val "literal:SELECT 'aurora_global_db_instance_status'::regproc" nval "pg_catalog.aurora_global_db_instance_status" -> code.UnqualifiedDatabaseRoutineReview
  mark exact "analysis.function.context" val "literal:SELECT count(1) FROM aurora_global_db_status()" nval "pg_catalog.aurora_global_db_status" -> code.UnqualifiedDatabaseRoutineReview
  mark exact "analysis.function.context" val "literal:FROM aurora_global_db_instance_status()" nval "pg_catalog.aurora_global_db_instance_status" -> code.UnqualifiedDatabaseRoutineReview
  mark exact "analysis.function.context" val "function_name:NodePublishVolume" val "call:GetVolumeContext" val "call:append" val "call:Mount" nval "call:ParseIP" -> code.CommandOptionInjection
  // Review-only: writing security state through ordinary path opening of procfs control
  // files needs a verified procfs/open boundary to avoid link or mount redirection.
  mark exact "analysis.function.context" val "call_path:os.OpenFile" val "literal:/proc/self/attr/exec" nval "call:OpenProcRoot" nval "call:OpenThreadSelf" nval "call_path:pathrs.Reopen" -> code.SpecialFileAccessReview
  // Review-only: request/header secrets compared after ordinary string conversion need
  // constant-time comparison when attacker-controlled candidates can be repeated.
  mark exact "analysis.function.context" val "function_name:ParseAndValidate" val "selector:r.Header.Get" val "call:string" nval "call:ConstantTimeCompare" -> code.SecretComparisonReview
  mark "os.WriteFile" val "0666" -> code.InsecurePermission
  mark "ioutil.WriteFile" val "0777" -> code.InsecurePermission
  mark "ioutil.WriteFile" val "0666" -> code.InsecurePermission
  mark "os.Create" val "/tmp/" -> code.InsecureTempFile

  // TLS cert validation disabled (CWE-295) — tls.Config{InsecureSkipVerify: true}
  mark "tls.Config" val "InsecureSkipVerify=true" -> code.CertValidationDisabled
  mark "ParseUnverified" -> code.JwtUnverified

  // resource lifecycle (CWE-772) — raw handles that must be closed.
  mark "net.Dial" -> code.ResourceHandle
  mark "net.DialTimeout" -> code.ResourceHandle
  mark "os.Open" -> code.ResourceHandle
  mark "os.OpenFile" -> code.ResourceHandle
  mark "os.Create" -> code.ResourceHandle
  control method "Close" -> core.ResourceRelease

  // permissive CORS (CWE-942) — w.Header().Set("Access-Control-Allow-Origin", "*")
  mark "Header.Set" val "Access-Control-Allow-Origin" val "*" -> code.PermissiveCors
  mark "Header.Add" val "Access-Control-Allow-Origin" val "*" -> code.PermissiveCors

  // clickjacking (CWE-1021) — X-Frame-Options EXPLICITLY set to ALLOWALL (omission not flagged)
  mark "Header.Set" val "X-Frame-Options" val "ALLOWALL" -> code.MissingFrameProtection
  mark "Header.Add" val "X-Frame-Options" val "ALLOWALL" -> code.MissingFrameProtection

  // insecure cookie (CWE-614) — http.Cookie{HttpOnly: false} / {Secure: false} explicit
  mark "http.Cookie" val "HttpOnly=false" -> code.InsecureCookie
  mark "http.Cookie" val "Secure=false" -> code.InsecureCookie

  // cleartext channel (CWE-319) — http:// URL to net/http (loopback excluded; low sev)
  mark "http.Get" val "http://" nval "127.0" -> code.CleartextChannel
  mark "http.Post" val "http://" nval "127.0" -> code.CleartextChannel
  mark "http.NewRequest" val "http://" nval "127.0" -> code.CleartextChannel

  // lifecycle / locking (CWE-667)
  mark "Lock" -> code.LockAcquire
  mark "RLock" -> code.LockAcquire
  mark exact "analysis.global.mutation" val "field:ctx" -> code.LocklessSharedMutation
  mark exact "analysis.global.mutation" val "field:roundTripper" -> code.LocklessSharedMutation
  control method "Unlock" -> core.LockRelease
  control method "RUnlock" -> core.LockRelease


  // character-filter: regexp (*Regexp).ReplaceAllString is global.
  filter method "ReplaceAllString" global
  filter method "ReplaceAll" global
}
