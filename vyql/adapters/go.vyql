// go framework adapter (docs/07) — framework→concept content.
// frameworks: net/http, gin, echo, fiber, chi, gorilla/mux, beego
adapter go {
  meta { match: contains, fidelity: resolved }

  // constructor -> receiver type (for type-constrained sinks)
  type "sql.Open" -> sql.DB
  type "sql.OpenDB" -> sql.DB
  type "sqlx.Open" -> sqlx.DB
  type "sqlx.Connect" -> sqlx.DB
  type "sqlx.MustConnect" -> sqlx.DB
  type "gorm.Open" -> gorm.DB
  type "redis.NewClient" -> redis.Client
  type "mongo.Connect" -> mongo.Database
  type "graphql.NewClient" -> graphql.Client
  // LDAP / XPath / session handles (go-ldap Conn.Search, antchfx doc, gorilla sessions)
  type "ldap.DialURL" -> ldap.Conn
  type "ldap.Dial" -> ldap.Conn
  type "support.NewLDAP" -> ldap.Conn
  type "support.NewXMLDoc" -> xpath.Doc
  type "support.NewSession" -> session.Store
  type "csv.NewWriter" -> csv.Writer

  source path "analysis.parameter.entry" val "param_type:http.Request" -> code.HttpInput
  source "os.Args" -> code.CliArgument
  source "os.Getenv" -> code.EnvVariable
  source path "analysis.function.context" val "function_name:NewClient" val "call_path:log.Infof" val "literal:Loaded client config: %#v" val "selector:cfg.Spec" -> code.SecretValue
  source "flag.Arg" -> code.CliArgument
  source "flag.Args" -> code.CliArgument
  source ".URL.Query" -> code.HttpInput
  source ".URL.RawQuery" -> code.HttpInput
  source ".URL.Path" -> code.HttpInput
  source "FormValue" -> code.HttpInput
  source "PostFormValue" -> code.HttpInput
  source "FormFile" -> code.HttpInput
  source ".PostForm" -> code.HttpInput
  source ".Form.Get" -> code.HttpInput
  source ".Header.Get" -> code.HttpInput
  source ".GetHeader" -> code.HttpInput
  source ".QueryParam" -> code.HttpInput
  source ".DefaultQuery" -> code.HttpInput
  source ".QueryArray" -> code.HttpInput
  source ".GetQuery" -> code.HttpInput
  source ".ShouldBind" -> code.HttpInput
  source ".ShouldBindJSON" -> code.HttpInput
  source ".ShouldBindQuery" -> code.HttpInput
  source ".ShouldBindUri" -> code.HttpInput
  source ".ShouldBindWith" -> code.HttpInput
  source ".ShouldBindBodyWith" -> code.HttpInput
  source ".BindJSON" -> code.HttpInput
  source ".BindQuery" -> code.HttpInput
  source ".BindUri" -> code.HttpInput
  source ".BindWith" -> code.HttpInput
  // NOTE: bare `.Bind` and `.Body` were removed — too broad (matched tmpl.Bind / a
  // client resp.Body), causing false positives. The specific gin/echo bind methods
  // above are precise; the bind out-param taint handles `c.Bind(&x)`-style decode.
  source ".URLParam" -> code.HttpInput
  source "mux.Vars" -> code.HttpInput
  source ".Cookie" -> code.HttpInput
  source ".Params" -> code.HttpInput
  source ".Param" -> code.HttpInput
  // OIDC issuers/subjects/audiences are parsed from untrusted bearer tokens before
  // verification; provider discovery on those values is an SSRF-sensitive fetch.
  source "auth.ExtractIssuer" -> code.HttpInput
  source "apiauth.ExtractIssuer" -> code.HttpInput
  source "ExtractIssuer" -> code.HttpInput

  flag code.OverbroadRolePermissionGrant in module {
    has "var_name:PermissionsByRole"
    has "RoleNetworkManager"
    has "PermBackup"
    has "PermRestore"
    lacks "RoleAdmin:{PermBackup,PermRestore"
  }

  sink method "Query" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "QueryRow" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "QueryContext" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "QueryRowContext" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "Exec" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "ExecContext" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "Prepare" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "PrepareContext" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink path "gorm.Raw" -> code.SqlExecution
  sink path "db.Raw" -> code.SqlExecution
  // gorm's .Raw(sql) is frequently called on a non-db-named receiver (e.g. a helper
  // return: `q := getDB(); q.Raw(sql)`), which the dotted-path forms above miss. The
  // method form catches it regardless of receiver var; SqlExecution only yields a
  // finding under taint, so receiver-agnostic matching is safe for recall.
  sink method "Raw" -> code.SqlExecution
  sink path "sqlx.Query" -> code.SqlExecution
  sink path "sqlx.MustExec" -> code.SqlExecution
  sink path "bun.Raw" -> code.SqlExecution
  sink path "exec.Command" -> code.CommandExecution
  sink path "exec.CommandContext" -> code.CommandExecution
  sink path "os/exec.Command" -> code.CommandExecution
  // `exec.Command("sh", "-c", X)` — arg0 is the constant shell, the tainted script
  // is arg2; the `-c` literal disambiguates this shell-wrapper form.
  sink path "exec.Command" arg 2 val "-c" -> code.CommandExecution
  sink path "exec.CommandContext" arg 3 val "-c" -> code.CommandExecution
  sink path "syscall.Exec" -> code.CommandExecution
  sink path "syscall.ForkExec" -> code.CommandExecution
  sink path "sh.Command" -> code.CommandExecution
  // chaosblade-spec-go `channel.NewLocalChannel().Run(ctx, prog, args)` runs a shell
  // command; the distinctive constructor segment keeps this from matching unrelated `.Run`.
  sink path "channel.NewLocalChannel.Run" arg all -> code.CommandExecution
  sink path "http.Get" -> code.UrlFetch
  sink path "http.Post" -> code.UrlFetch
  sink path "http.Head" -> code.UrlFetch
  sink path "http.PostForm" -> code.UrlFetch
  sink path "http.NewRequest" -> code.UrlFetch
  sink path "http.NewRequestWithContext" -> code.UrlFetch
  sink path "client.Get" -> code.UrlFetch
  sink path "client.Post" -> code.UrlFetch
  sink path "client.Do" -> code.UrlFetch
  sink path "client.Head" -> code.UrlFetch
  sink path "provider.Get" arg 1 val "issuer" -> code.UrlFetch
  sink path "oidc.NewProvider" arg 1 -> code.UrlFetch
  sink path "resty.R" -> code.UrlFetch
  sink path "req.Get" -> code.UrlFetch
  sink path "os.Open" -> code.FilePathAccess
  sink path "os.OpenFile" -> code.FilePathAccess
  sink path "os.ReadFile" -> code.FilePathAccess
  sink path "os.Create" -> code.FilePathAccess
  sink path "os.Create" -> code.UnsafeUpload
  sink path "os.Remove" -> code.FilePathAccess
  sink path "os.RemoveAll" -> code.FilePathAccess
  sink path "ioutil.ReadFile" -> code.FilePathAccess
  sink path "ioutil.WriteFile" -> code.FilePathAccess
  sink path "os.WriteFile" -> code.UnsafeUpload
  sink path "ioutil.WriteFile" -> code.UnsafeUpload
  sink path "http.ServeFile" -> code.FilePathAccess
  sink path "os.Mkdir" -> code.FilePathAccess
  sink path "os.MkdirAll" -> code.FilePathAccess
  sink path "filepath.Walk" -> code.FilePathAccess
  sink path "plugin.Open" -> code.DynamicCodeLoad
  sink path "extractEntry" -> code.ArchiveEntryWrite
  sink path "writeArchiveEntry" -> code.ArchiveEntryWrite
  // LDAP injection (CWE-90), XPath injection (CWE-643), trust-boundary write (CWE-501)
  sink method "Search" on [ldap.Conn] -> code.LdapQuery
  sink method "SearchWithPaging" on [ldap.Conn] -> code.LdapQuery
  sink method "XPath" on [xpath.Doc] -> code.XpathQuery
  sink method "Find" on [xpath.Doc] -> code.XpathQuery
  sink method "Set" arg 1 on [session.Store] -> code.TrustBoundary
  // template.HTML(x) casts an untrusted string to "safe" HTML, bypassing contextual
  // auto-escaping → reflected XSS (CWE-79), defended by HTML-escaping the input.
  sink path "template.HTML" -> code.HtmlRender
  sink path "template.JS" -> code.HtmlRender
  sink path "template.URL" -> code.HtmlRender
  // Helpers that construct and return raw HTML bytes/strings are response render
  // boundaries when caller-controlled values are interpolated into the returned value.
  // The Go frontend emits neutral function literal evidence; this adapter assigns the
  // security meaning in data.
  sink path "analysis.function.return" val "<html" -> code.HtmlRender
  sink path "analysis.function.return" val "<body" -> code.HtmlRender
  sink path "analysis.function.return" val "<a " -> code.HtmlRender
  flag code.GouniverseCmsAliasXss in function {
    has "function_name:PageRenderHtmlByAlias"
    has "param_type:http.Request"
    has "call_path:cms.PageFindByAlias"
    has "literal:Page with alias '"
    lacks "call:ToHTML"
  }
  flag code.DocumizeMarkdownRenderWithoutSanitizer in function {
    has "function_name:Render"
    has "call_path:blackfriday.Run"
    has "call:string"
    lacks "call_path:bluemonday.UGCPolicy"
    lacks "call:SanitizeBytes"
  }
  // Gin/http response writer bodies. These are the last-hop render boundary for
  // raw strings/bytes assembled by handlers.
  sink path "Writer.WriteString" -> code.HtmlRender
  sink path "Writer.Write" -> code.HtmlRender
  sink path "http.Redirect" -> code.RedirectTarget
  sink path "c.Redirect" -> code.RedirectTarget
  sink path "ctx.Redirect" -> code.RedirectTarget
  sink method "FindByID" -> code.ObjectLookupByUserInput
  sink method "FindById" -> code.ObjectLookupByUserInput
  sink method "GetUser" -> code.ObjectLookupByUserInput
  sink method "GetAccount" -> code.ObjectLookupByUserInput
  sink method "GetOrder" -> code.ObjectLookupByUserInput
  flag code.AuthenticationRequiredOp on any {
    path "ChangePassword"
  }
  flag code.AuthenticationRequiredOp on any {
    path "UpdatePassword"
  }
  flag code.AuthenticationRequiredOp on any {
    path "ResetPassword"
  }
  flag code.AuthenticationRequiredOp on any {
    path "ChangeEmail"
  }
  flag code.AuthenticationRequiredOp on any {
    path "TransferFunds"
  }
  flag code.AuthenticationRequiredOp on any {
    path "DeleteAccount"
  }
  flag code.AuthenticationRequiredOp on any {
    path "GrantRole"
  }
  flag code.AuthenticationRequiredOp on any {
    path "MakeAdmin"
  }
  flag code.PathMatcherNormalizationOrderBypass in function {
    has "function_name:Match"
    has "call_path:url.PathUnescape"
    has "selector:r.URL.Path"
    has "call_order:strings.TrimRight>path.Clean"
    has "call:HasSuffix"
  }
  flag code.AuthAttemptLimitReview in function {
    has "function_name:SolveChallenge"
    has "selector:challenge.tries"
    has "selector:s.challenges"
  }
  flag code.EmptyVerifierAcceptance in function {
    has "function_name:Verify"
    has "call:Get"
    has "binary:v==answer"
    lacks "binary:v!=\"\""
  }
  // HTTP response splitting / header injection (CWE-113).
  sink path "Header.Set" arg 1 -> code.ResponseHeaderWrite
  sink path "Header.Add" arg 1 -> code.ResponseHeaderWrite
  // log injection (CWE-117) + secret-in-log (CWE-532).
  sink path "log.Print" arg all -> code.LogOutput
  sink path "log.Printf" arg all -> code.LogOutput
  sink path "log.Println" arg all -> code.LogOutput
  flag code.LogWrite in function {
    has "function_name:NewClient"
    has "call_path:log.Infof"
    has "literal:Loaded client config: %#v"
    has "selector:cfg.Spec"
  }
  flag code.CoderAgentManifestInfoLog on any {
    path exact "a.logger.Info"
    has "fetched manifest"
    has "slog.F"
    has "manifest"
  }
  flag code.KubernetesCurlAuthorizationHeaderLogLeak in function {
    has "function_name:toCurl"
    has "selector:r.RequestHeaders"
    has "call_path:fmt.Sprintf"
    has "literal:%s: %s"
    lacks "call:maskValue"
  }
  flag code.LogWrite on any {
    path "log.Print"
  }
  flag code.LogWrite on any {
    path "log.Printf"
  }
  flag code.LogWrite on any {
    path "log.Println"
  }
  // CSV/formula injection (CWE-1236).
  sink path "writer.Write" arg all collection -> code.CsvCell
  sink path "csvWriter.Write" arg all collection -> code.CsvCell
  sink path "csvw.Write" arg all collection -> code.CsvCell

  // controls (sanitizers/validators) — neutralize a flow that passes through them
  control "html.EscapeString" -> core.HtmlEscape
  control "template.HTMLEscapeString" -> core.HtmlEscape
  control "ctx.Header" val "content-type" val "image/" -> core.SafeResponseContentType
  control "c.Header" val "content-type" val "image/" -> core.SafeResponseContentType
  control "Header.Set" val "content-type" val "image/" -> core.SafeResponseContentType
  control "Header.Add" val "content-type" val "image/" -> core.SafeResponseContentType
  // filepath.Base strips all directory components — no `/`, `\`, or `..` survives, so it
  // confines a path to a single segment (the Go analogue of path.basename).
  control "filepath.Base" -> core.PathCanonicalization
  // A path denylist that rejects parent-directory and Windows separator tokens is
  // a real traversal guard; weaker substring checks remain ordinary calls.
  control "strings.Contains" val ".." val "\\" -> core.PathAccessCheck
  control "analysis.function.context" val "call_path:strings.Contains" val "literal:bad path" val "call_path:isSymbolLink" val "call_path:ioutil.ReadFile" -> core.PathAccessCheck
  control "regexp.MatchString" val "^/var/lib/casaos/\\d" -> core.PathAccessCheck
  control "pathrs.Reopen" -> core.PathAccessCheck
  control "procfs.OpenProcRoot" -> core.PathAccessCheck
  control method "OpenThreadSelf" -> core.PathAccessCheck
  // benchmark-harness escapers/validators (wrap real neutralization the rule honors).
  control "support.EscapeLDAP" -> core.LdapEscape
  control "support.XPathLiteral" -> core.XpathEscape
  control "support.AllowRole" -> core.InputValidation
  control method "RequireAuth" -> core.AuthenticationCheck
  control method "EnsureAuthenticated" -> core.AuthenticationCheck
  control method "IsAuthenticated" -> core.AuthenticationCheck
  control method "Authenticate" -> core.AuthenticationCheck
  control method "CheckOwnership" -> core.OwnershipCheck
  control method "RequireOwner" -> core.OwnershipCheck
  control method "IsOwner" -> core.OwnershipCheck
  control "oidcvalidate.IsValidIssuer" -> core.AllowlistValidation
  control "IsValidIssuer" -> core.AllowlistValidation

  // regex compile (ReDoS, CWE-1333) — tainted PATTERN arg0
  sink path "regexp.Compile" -> code.RegexCompile
  sink path "regexp.MustCompile" -> code.RegexCompile
  sink path "regexp.MatchString" -> code.RegexCompile

  // weak crypto (CWE-327) — presence marker on the call node
  flag code.WeakHash on any {
    path "md5.New"
  }
  flag code.WeakHash on any {
    path "sha1.New"
  }
  // one-shot digests: md5.Sum(b) / sha1.Sum(b) are the common Go idiom alongside .New().
  flag code.WeakHash on any {
    path "md5.Sum"
  }
  flag code.WeakHash on any {
    path "sha1.Sum"
  }

  // insecure randomness (CWE-330) — math/rand. The math/rand-only methods (Intn/Int31/
  // Int63/Float64/Perm/Shuffle) disambiguate from crypto/rand (which has Read/Int/Prime).
  flag code.WeakRandomValue on any {
    path "rand.Intn"
  }
  flag code.WeakRandomValue on any {
    path "rand.Int31"
  }
  flag code.WeakRandomValue on any {
    path "rand.Int31n"
  }
  flag code.WeakRandomValue on any {
    path "rand.Int63"
  }
  flag code.WeakRandomValue on any {
    path "rand.Int63n"
  }
  flag code.WeakRandomValue on any {
    path "rand.Float64"
  }
  flag code.WeakRandomValue on any {
    path "rand.Float32"
  }
  flag code.WeakRandomValue on any {
    path "rand.Perm"
  }
  flag code.WeakRandomValue on any {
    path "rand.Shuffle"
  }
  flag code.WeakRandomValue on any {
    path "rand.NewSource"
  }
  // Cloudreve's util.RandStringRunes wraps math/rand and was replaced with the
  // crypto/rand variant for persisted/session secrets in CVE-2026-25726.
  flag code.CloudreveWeakSecretPrng on any {
    path exact "util.RandStringRunes"
    has "32"
  }
  flag code.CloudreveWeakSecretPrng on any {
    path exact "util.RandStringRunes"
    has "64"
  }
  flag code.CloudreveWeakSecretPrng on any {
    path exact "util.RandStringRunes"
    has "128"
  }
  flag code.CloudreveWeakSecretPrng on any {
    path exact "util.RandStringRunes"
    has "256"
  }
  flag code.ConstellationLuks2AttachedHeaderActivation in function {
    has "function_name:initByDevicePath"
    has "call_path:cryptsetup.Init"
    lacks "call_path:detachHeader"
    lacks "call_path:cryptsetup.InitDataDevice"
  }
  flag code.ConstellationLuks2AttachedHeaderActivation in function {
    has "function_name:initByName"
    has "call_path:cryptsetup.InitByName"
    lacks "call_path:detachHeader"
    lacks "call_path:cryptsetup.InitByNameAndHeader"
  }

  // weak cipher (CWE-327) — named broken ciphers
  flag code.WeakCipher on any {
    path "des.NewCipher"
  }
  flag code.WeakCipher on any {
    path "des.NewTripleDESCipher"
  }
  flag code.WeakCipher on any {
    path "rc4.NewCipher"
  }
  flag code.StaticIv on any {
    path "cipher.NewCBCEncrypter"
    has "0000000000000000"
  }
  flag code.StaticIv on any {
    path "cipher.NewCBCDecrypter"
    has "0000000000000000"
  }

  // insecure file permission (CWE-732) — world-writable mode on chmod/WriteFile/MkdirAll.
  // octal literal text is carried by the frontend; restrictive modes are not matched.
  flag code.InsecurePermission on any {
    path "os.Chmod"
    has "0777"
  }
  flag code.InsecurePermission on any {
    path "os.Chmod"
    has "0666"
  }
  flag code.InsecurePermission on any {
    path "os.MkdirAll"
    has "0777"
  }
  flag code.InsecurePermission on any {
    path "os.WriteFile"
    has "0777"
  }
  // Review-only: project-specific config serializers often need an explicit
  // "redact/scrub secrets" option before returning configs through diagnostics/API.
  flag code.ConfigExposureReview on any {
    path "MarshalConfig"
    has "false"
  }
  flag code.ConfigExposureReview on any {
    path "instance.MarshalConfig"
    has "false"
  }
  flag code.ConfigExposureReview on any {
    path exact "analysis.type.context"
    has "field:Repositories"
    has "field:Keyring"
    lacks "method:MarshalYAML"
  }
  flag code.InheritedProcessEnvironmentLeak in function {
    has "call_path:unshare.Command"
    has "selector:cmd.Env"
    has "call_path:os.Environ"
    has "literal:LOGLEVEL=%d"
  }
  flag code.ContainerdCriImageEnvAliasLeak in function {
    has "assign:env=imageConfig.Env"
    has "call_path:config.GetEnvs"
    has "call_path:oci.WithEnv"
    lacks "append_copy:imageConfig.Env"
  }
  flag code.ContainerPrimaryGidMissingSupplementalGroup in function {
    has "function_name:setupContainerUser"
    has "call_path:specgen.SetProcessGID"
    has "selector:sc.RunAsGroup"
    has "call_path:specgen.AddProcessAdditionalGid"
    lacks "call_arg:specgen.AddProcessAdditionalGid:gid"
  }
  flag code.MountStubCleanupPathEscape in function {
    has "call_path:os.Lstat"
    has "call_path:filepath.Dir"
    has "call_path:os.Remove"
    has "call_path:os.Chtimes"
    lacks "call_path:fs.RootPath"
  }
  flag code.ContainersCommonFipsModeMountSymlink on any {
    path "analysis.function.context"
    has "function_name:addFIPSModeSubscription"
    has "call_path:filepath.Join"
    has "call_path:fileutils.Exists"
    lacks "call_path:securejoin.SecureJoin"
  }
  // Docker CLI for Windows removed the legacy ProgramData system plugin search
  // directory because standard users can create it and plant plugin binaries.
  flag code.DockerCliProgramDataPluginSearchPath on any {
    path exact "filepath.Join"
    has "ProgramData"
    has "Docker"
    has "cli-plugins"
    lacks "ProgramFiles"
  }
  flag code.SensitiveSettingsExposureReview on any {
    path "settingspkg.Settings"
    has "PasswordPattern"
  }
  flag code.MessageBusSecretConfigExposure in function {
    has "call_path:bootstrapMessaging.SetOptionsAuthData"
    has "call_path:messaging.NewMessageClient"
    has "field:Optional"
    has "selector:messageBusInfo.Optional"
    lacks "selector:bootstrapMessaging.OptionsPasswordKey"
  }
  // Review-only: protocol/state handlers that stop a registration timer without
  // first checking the corresponding state can accept out-of-sequence messages.
  flag code.ProtocolStateReview in function {
    has "call:StopT3550"
    lacks "selector:ue.T3550"
  }
  // Review-only: protocol handlers that compare an incoming previous-state pointer
  // against the last stored state need manual review for stale or forked-chain cases.
  flag code.ProtocolStateReview in function {
    has "PrevATXID"
    has "call:GetLastIDByNodeID"
  }
  // Review-only: protocol response loops that abort on malformed frame parse
  // errors before checking request/response identifiers can let spoofed packets
  // block the valid upstream response. A fixed implementation distinguishes
  // UDP parse errors from network errors and continues waiting.
  flag code.ProtocolStateReview in function {
    has "call_path:pc.c.WriteMsg"
    has "call_path:pc.c.ReadMsg"
    has "call_path:pc.c.Close"
    has "selector:state.Req.Id"
    has "selector:ret.Id"
    lacks "selector:net.Error"
    lacks "binary:proto==\"udp\""
  }
  // Review-only: request handlers that derive request metadata, load resource metadata,
  // then dispatch a resource handler need a visible request/resource scope consistency
  // check before dispatch.
  flag code.RequestScopePolicyReview in function {
    has "function_name:ServeHTTP"
    has "call:RequestInfoFrom"
    has "call:Get"
    has "call:serveResource"
    lacks "selector:apiextensions.NamespaceScoped"
  }
  flag code.ExternalResourceNamespaceControl in function {
    has "function_name:newBuildPod"
    has "call_path:build.BuilderPodNamespace"
  }
  flag code.ExternalResourceNamespaceControl in function {
    has "function_name:deleteBuilderPod"
    has "call_path:build.BuilderPodNamespace"
  }
  flag code.ExternalResourceNamespaceControl in function {
    has "function_name:getBuilderPod"
    has "call_path:build.BuilderPodNamespace"
  }
  flag code.TenantServiceAccountAdmissionBypass in function {
    has "function_name:IsCapsuleUser"
    has "call:NewUserGroupList"
    has "literal:system:serviceaccounts:kube-system"
    has "call:Find"
    lacks "call:MatchingFieldsSelector"
    lacks "literal:.status.namespaces"
  }
  flag code.NamespacedSubjectKeyCollision in function {
    has "function_name:OwnerRoleBindingsIndexFunc"
    has "selector:rb.Subjects"
    has "selector:subject.Kind"
    has "selector:subject.Name"
    has "call_path:fmt.Sprintf"
    lacks "selector:subject.Namespace"
    lacks "call_path:strings.Join"
  }
  flag code.HopByHopHeaderAuthBypass in function {
    has "function_name:impersonateHandler"
    has "call_path:hr.GetUserAndGroups"
    has "call_path:request.Header.Set"
    has "call_path:request.Header.Add"
    has "literal:Authorization"
    has "literal:Impersonate-User"
    has "literal:Impersonate-Group"
    lacks "call_path:n.removingHopByHopHeaders"
    lacks "call_path:httpguts.HeaderValuesContainsToken"
  }
  flag code.BasicAuthStreamAuthBypass on any {
    path exact "Options"
    has "BasicAuthEnabled"
    has "Creds"
    lacks "AuthRequired"
  }
  flag code.ProxyClientIpSpoofingBypass in function {
    has "call_path:g.management.GetProxy"
    has "call_path:proxy.ServeHTTP"
    lacks "call_path:rewriteRequestSourceIP"
  }
  flag code.UploadFilePathTraversalWrite in function {
    has "function_name:UploadFileSafe"
    has "call_path:uploadFile"
    lacks "call_path:strings.Contains"
  }
  flag code.AttestationPredicateVerificationBypass in function {
    has "call_path:policy.AttestationToPayloadJSON"
    has "selector:c.PredicateType"
    has "binary:len(payload)==0"
    has "call_path:PrintVerification"
    has "call_arg:PrintVerification:verified"
    lacks "call_arg:PrintVerification:checked"
    lacks "binary:len(checked)==0"
  }
  // Review-only: admission ignore helpers that skip every non-empty subresource
  // need manual review for alternate API paths that bypass the primary policy.
  flag code.AdmissionSubresourcePolicyReview in function {
    has "function_name:shouldIgnore"
    has "call:GetSubresource"
    lacks "ignoredSubresources"
  }
  flag code.UnboundedStateGrowthReview in function {
    has "call:LoadOrStore"
    has "literal:overflow"
  }
  flag code.UnboundedProtocolStateByIdentifier in function {
    has "function_name:MessageReceived"
    has "call:Wantlist"
    has "call:splitWantsCancels"
    has "call:Wants"
    has "call:PushTasksTruncated"
    lacks "call:ByteLen"
    lacks "mh.IDENTITY"
  }
  flag code.UnderboundedProtocolCountLimit in function {
    has "function_name:BtcDecode"
    has "call:ReadVarInt"
    has "selector:txin.Witness"
    has "const:maxWitnessItemsPerInput=500000"
  }
  flag code.IntegerSizeArithmetic in function {
    has "function_name:readBytes"
    has "call:ReadLong"
    has "call:int"
    has "call:make"
    lacks "selector:math.MaxInt"
  }
  flag code.IntegerSizeArithmetic in function {
    has "call:ReadBlockHeader"
    has "call:int"
    has "call:getMaxSliceAllocSize"
  }
  flag code.IntegerSizeArithmetic in function {
    has "call:ReadBlockHeader"
    has "call:int"
    has "call:getMaxMapAllocSize"
  }
  flag code.IntegerSizeArithmetic in function {
    has "call:SkipNBytes"
    has "call:int"
    lacks "call:SkipNBytesInt64"
    lacks "function_name:SkipNBytesInt64"
  }
  flag code.IntegerSizeArithmetic in function {
    has "function_name:readBlock"
    has "call:ReadLong"
    has "call:make"
    lacks "selector:math.MaxInt"
  }
  flag code.ChGoCompressedSizeUint32Overflow in function {
    has "function_name:Compress"
    has "call_path:binary.LittleEndian.PutUint32"
    has "call:uint32"
    lacks "selector:math.MaxUint32"
    lacks "literal:compressed size overflows uint32"
  }
  flag code.LengthDerivedAllocation in function {
    has "function_name:readNBytes"
    has "call:make"
    has "call:ReadByte"
    lacks "selector:reader.data"
    lacks "selector:reader.pos"
  }
  flag code.LengthDerivedAllocation in function {
    has "selector:r.ContentLength"
    has "call:make"
    has "call_path:io.ReadFull"
    lacks "call_path:io.LimitReader"
    lacks "call_path:http.MaxBytesReader"
  }
  flag code.FieldDerivedIndexAccess in function {
    has "call:ReadString"
    has "call:BytesNtohs"
    has "binary:len(buf)<=off"
    lacks "binary:len(buf)<off+2"
  }
  flag code.FieldDerivedIndexAccess in function {
    has "function_name:readObject"
    has "index:ber:offset"
    has "binary:contentEnd>len(ber)"
    has "literal:ber2der: BER tag length is more than available data"
    lacks "binary:len(ber)<=offset"
  }
  flag code.Free5gcChfRechargeInfoSplitPanic in function {
    has "function_name:RechargePut"
    has "call_path:strings.Split"
    has "literal:rechargingInfo"
    has "index:ueIdRatingGroup:1"
    lacks "call:len"
    lacks "call_path:c.Query"
  }
  flag code.ManualZipEntryFileWrite in function {
    has "function_name:Decode"
    has "call_path:zip.NewReader"
    has "call_path:filepath.Join"
    has "selector:f.Name"
    has "call_path:copy"
    lacks "call_path:sanitizeArchivePath"
    lacks "call_path:strings.HasPrefix"
  }
  flag code.ManualZipEntryFileWrite in function {
    has "function_name:UnzipDirectory"
    has "call_path:zip.OpenReader"
    has "call_path:filepath.Join"
    has "selector:f.Name"
    has "call_path:os.OpenFile"
    has "call_arg:os.OpenFile:filePath"
    has "selector:os.O_TRUNC"
    lacks "call_path:os.Stat"
    lacks "call_path:GetInput"
  }
  flag code.CiliumBroadTcFilterCleanup in function {
    has "function_name:getTCFilters"
    has "selector:bpfFilter.Name"
    has "call_path:strings.Contains"
    has "literal:cilium"
    lacks "literal:cil_"
  }
  flag code.CiliumCliEtcdInitMountMismatch in function {
    has "function_name:generateDeployment"
    has "literal:etcd-init"
    has "field:MountPath=etcd-data-dir"
    has "field:Args"
  }
  flag code.CharmRouteFileStorePathAccess in function {
    has "function_name:handlePostFile"
    has "call_path:pattern.Path"
    has "call_path:s.cfg.FileStore.Put"
    lacks "call_path:filepath.Clean"
  }
  flag code.CharmRouteFileStorePathAccess in function {
    has "function_name:handleGetFile"
    has "call_path:pattern.Path"
    has "call_path:s.cfg.FileStore.Get"
    lacks "call_path:filepath.Clean"
  }
  flag code.CharmRouteFileStorePathAccess in function {
    has "function_name:handleDeleteFile"
    has "call_path:pattern.Path"
    has "call_path:s.cfg.FileStore.Delete"
    lacks "call_path:filepath.Clean"
  }
  flag code.UnderwidthFormattedIndex in function {
    has "call_path:fmt.Sprintf"
    has "literal:%08b"
    has "index:capabilities:8"
    lacks "literal:%016b"
  }
  flag code.UnsafeBuildClientCommandAssembly in function {
    has "function_name:BuildClient"
    has "literal:GO_ENABLED=1 GOOS=%s GOARCH=amd64 go build"
    has "selector:input.Filename"
    has "call:handleFilename"
    has "call_path:fmt.Sprintf"
    has "call_path:exec.Command"
    lacks "call_path:utils.NormalizeString"
    lacks "call_path:utils.StringIsNumber"
    lacks "call_path:utils.IsValidIPAddress"
  }
  flag code.UnsignedIndexConversionGuardBypass in function {
    has "function_name:checkTopicRegister"
    has "selector:data.Idx"
    has "selector:data.Topics"
    has "call:int"
    has "call:len"
    has "binary:data.Idx<0"
  }
  sink method "BranchPageElement" val "Count" -> code.CountDerivedElementAccess
  flag core.MemoryBoundsCheck on any {
    path "__binop.ne"
    has "Count"
    has "0"
  }
  flag code.UnqualifiedDatabaseRoutineReview in function {
    has "literal:SELECT 'aurora_global_db_status'::regproc"
    lacks "pg_catalog.aurora_global_db_status"
  }
  flag code.UnqualifiedDatabaseRoutineReview in function {
    has "literal:SELECT 'aurora_global_db_instance_status'::regproc"
    lacks "pg_catalog.aurora_global_db_instance_status"
  }
  flag code.UnqualifiedDatabaseRoutineReview in function {
    has "literal:SELECT count(1) FROM aurora_global_db_status()"
    lacks "pg_catalog.aurora_global_db_status"
  }
  flag code.UnqualifiedDatabaseRoutineReview in function {
    has "literal:FROM aurora_global_db_instance_status()"
    lacks "pg_catalog.aurora_global_db_instance_status"
  }
  flag code.UnparameterizedSqlQueryParser on any {
    path exact "goqu.L"
    has "project"
  }
  flag code.UnparameterizedSqlQueryParser on any {
    path exact "goqu.L"
    has "group"
  }
  flag code.CommandOptionInjection in function {
    has "function_name:NodePublishVolume"
    has "call:GetVolumeContext"
    has "call:append"
    has "call:Mount"
    lacks "call:ParseIP"
  }
  flag code.ApiScanFoundActionCommandExecution in function {
    has "function_name:postScanHandler"
    has "call_path:c.Bind"
    has "selector:rq.Options"
    has "call_path:ScanFromAPI"
    lacks "call_path:sanitizeAPIScanOptions"
  }
  // Review-only: writing security state through ordinary path opening of procfs control
  // files needs a verified procfs/open boundary to avoid link or mount redirection.
  flag code.SpecialFileAccessReview in function {
    has "call_path:os.OpenFile"
    has "literal:/proc/self/attr/exec"
    lacks "call:OpenProcRoot"
    lacks "call:OpenThreadSelf"
    lacks "call_path:pathrs.Reopen"
  }
  // Review-only: request/header secrets compared after ordinary string conversion need
  // constant-time comparison when attacker-controlled candidates can be repeated.
  flag code.SecretComparisonReview in function {
    has "function_name:ParseAndValidate"
    has "selector:r.Header.Get"
    has "call:string"
    lacks "call:ConstantTimeCompare"
  }
  flag code.SecretComparisonReview in function {
    has "call:BasicAuth"
    has "binary:username==wrapper.username"
    has "binary:password==wrapper.password"
    lacks "call:ConstantTimeCompare"
  }
  flag code.SecretComparisonReview on binop {
    op any ["==", "!="]
    operand {
      key contains_any [".Password", ".password", ".Secret", ".secret", ".Token", ".token", ".APIKey", ".apiKey", ".AccessKey", ".accessKey"]
    }
    operand {
      key contains_any [".Password", ".password", ".Secret", ".secret", ".Token", ".token", ".APIKey", ".apiKey", ".AccessKey", ".accessKey"]
    }
    lacks call contains_any ["ConstantTimeCompare", "hmac.Equal", "subtle.ConstantTimeCompare", "CompareHashAndPassword"]
  }
  flag code.InsecurePermission on any {
    path "os.WriteFile"
    has "0666"
  }
  flag code.InsecurePermission on any {
    path "ioutil.WriteFile"
    has "0777"
  }
  flag code.InsecurePermission on any {
    path "ioutil.WriteFile"
    has "0666"
  }
  flag code.InsecureTempFile on any {
    path "os.Create"
    has "/tmp/"
  }

  // TLS cert validation disabled (CWE-295) — tls.Config{InsecureSkipVerify: true}
  flag code.CertValidationDisabled on any {
    path "tls.Config"
    has "InsecureSkipVerify=true"
  }
  flag code.JwtUnverified on any {
    path "ParseUnverified"
  }
  flag code.CsrfDisabled in function {
    has "function_name:CheckOrigin"
    has "param_type:http.Request"
    has "return:true"
    lacks "call_path:r.Header.Get"
    lacks "selector:r.Host"
  }
  flag code.UnverifiedFederationMissingEvents in function {
    has "call_path:missingResp.Events.UntrustedEvents"
    has "call_path:t.cacheAndReturn"
    lacks "call_path:ev.VerifyEventSignatures"
  }

  // resource lifecycle (CWE-772) — raw handles that must be closed.
  flag code.ResourceHandle on any {
    path "net.Dial"
  }
  flag code.ResourceHandle on any {
    path "net.DialTimeout"
  }
  flag code.ResourceHandle on any {
    path "os.Open"
  }
  flag code.ResourceHandle on any {
    path "os.OpenFile"
  }
  flag code.ResourceHandle on any {
    path "os.Create"
  }
  control method "Close" -> core.ResourceRelease

  // permissive CORS (CWE-942) — w.Header().Set("Access-Control-Allow-Origin", "*")
  flag code.PermissiveCors on any {
    path "Header.Set"
    has "Access-Control-Allow-Origin"
    has "*"
  }
  flag code.PermissiveCors on any {
    path "Header.Add"
    has "Access-Control-Allow-Origin"
    has "*"
  }
  // CORS wildcard origin parsers must keep the whole prefix before a trailing *.
  // Slicing to i-1 before prefix matching weakens origin validation by one byte.
  flag code.CorsWildcardPrefixTruncation in function {
    has "function_name:parseWildcardRules"
    has "selector:c.AllowOrigins"
    has "selector:c.AllowWildcard"
    has "call_path:strings.Index"
    has "call_path:append"
    has "slice:o::i-1"
  }

  // clickjacking (CWE-1021) — X-Frame-Options EXPLICITLY set to ALLOWALL (omission not flagged)
  flag code.MissingFrameProtection on any {
    path "Header.Set"
    has "X-Frame-Options"
    has "ALLOWALL"
  }
  flag code.MissingFrameProtection on any {
    path "Header.Add"
    has "X-Frame-Options"
    has "ALLOWALL"
  }

  // insecure cookie (CWE-614) — http.Cookie{HttpOnly: false} / {Secure: false} explicit
  flag code.InsecureCookie on any {
    path "http.Cookie"
    has "HttpOnly=false"
  }
  flag code.InsecureCookie on any {
    path "http.Cookie"
    has "Secure=false"
  }
  flag code.InsecureCookie in function {
    has "ctx.SetCookie"
    has "GenerateToken"
    has "opt.CookieHttpOnly"
    has "false"
    lacks "opt.Secure"
  }

  // cleartext channel (CWE-319) — http:// URL to net/http (loopback excluded; low sev)
  flag code.CleartextChannel on any {
    path "http.Get"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "http.Post"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "http.NewRequest"
    has "http://"
    lacks "127.0"
  }

  // lifecycle / locking (CWE-667)
  flag code.LockAcquire on any {
    path "Lock"
  }
  flag code.LockAcquire on any {
    path "RLock"
  }
  flag code.RecursiveJsonMarshalUnderLock in function {
    has "function_name:MarshalJSON"
    has "call_path:ps.mtx.Lock"
    has "call_path:cmtjson.Marshal"
    has "selector:ps"
    lacks "jsonPeerState"
    lacks "call_path:ps.Count"
    lacks "call_path:ps.Total"
  }
  flag code.LocklessSharedMutation on any {
    path exact "analysis.global.mutation"
    has "field:ctx"
  }
  flag code.LocklessSharedMutation on any {
    path exact "analysis.global.mutation"
    has "field:roundTripper"
  }
  flag code.LocklessSharedMutation in function {
    has "function_name:ReplaceIndividualSubcription"
    has "call:GetSubscription"
    has "index:bsfContext.BsfSelf.Subscriptions:subId"
    has "call:Status"
    has "selector:http.StatusNoContent"
    lacks "selector:http.StatusNotFound"
  }
  control method "Unlock" -> core.LockRelease
  control method "RUnlock" -> core.LockRelease


  // character-filter: regexp (*Regexp).ReplaceAllString is global.
  filter method "ReplaceAllString" global
  filter method "ReplaceAll" global
}
