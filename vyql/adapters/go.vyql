// go framework adapter (docs/07) — framework→concept content.
// frameworks: net/http, gin, echo, fiber, chi, gorilla/mux, beego
adapter go {
  meta { match: contains, fidelity: resolved }

  // constructor -> receiver type (for type-constrained sinks)
  type "sql.Open" -> sql.DB
  type "sql.OpenDB" -> sql.DB
  type "sqlx.Open" -> sqlx.DB
  type "sqlx.Connect" -> sqlx.DB
  type "sqlx.MustConnect" -> sqlx.DB
  type "gorm.Open" -> gorm.DB
  type "redis.NewClient" -> redis.Client
  type "mongo.Connect" -> mongo.Database
  type "graphql.NewClient" -> graphql.Client
  // LDAP / XPath / session handles (go-ldap Conn.Search, antchfx doc, gorilla sessions)
  type "ldap.DialURL" -> ldap.Conn
  type "ldap.Dial" -> ldap.Conn
  type "support.NewLDAP" -> ldap.Conn
  type "support.NewXMLDoc" -> xpath.Doc
  type "support.NewSession" -> session.Store

  source "os.Args" -> code.CliArgument
  source "os.Getenv" -> code.EnvVariable
  source "flag.Arg" -> code.CliArgument
  source "flag.Args" -> code.CliArgument
  source ".URL.Query" -> code.HttpInput
  source ".URL.RawQuery" -> code.HttpInput
  source ".URL.Path" -> code.HttpInput
  source "FormValue" -> code.HttpInput
  source "PostFormValue" -> code.HttpInput
  source "FormFile" -> code.HttpInput
  source ".PostForm" -> code.HttpInput
  source ".Form.Get" -> code.HttpInput
  source ".Header.Get" -> code.HttpInput
  source ".GetHeader" -> code.HttpInput
  source ".QueryParam" -> code.HttpInput
  source ".DefaultQuery" -> code.HttpInput
  source ".QueryArray" -> code.HttpInput
  source ".GetQuery" -> code.HttpInput
  source ".ShouldBind" -> code.HttpInput
  source ".BindJSON" -> code.HttpInput
  source ".URLParam" -> code.HttpInput
  source "mux.Vars" -> code.HttpInput
  source ".Cookie" -> code.HttpInput
  source ".Params" -> code.HttpInput
  source ".Param" -> code.HttpInput

  sink method "Query" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "QueryRow" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "QueryContext" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "QueryRowContext" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "Exec" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "ExecContext" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "Prepare" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink method "PrepareContext" on [sql.DB, sqlx.DB, gorm.DB] -> code.SqlExecution
  sink path "gorm.Raw" -> code.SqlExecution
  sink path "db.Raw" -> code.SqlExecution
  sink path "sqlx.Query" -> code.SqlExecution
  sink path "sqlx.MustExec" -> code.SqlExecution
  sink path "bun.Raw" -> code.SqlExecution
  sink path "exec.Command" -> code.CommandExecution
  sink path "exec.CommandContext" -> code.CommandExecution
  sink path "os/exec.Command" -> code.CommandExecution
  // `exec.Command("sh", "-c", X)` — arg0 is the constant shell, the tainted script
  // is arg2; the `-c` literal disambiguates this shell-wrapper form.
  sink path "exec.Command" arg 2 val "-c" -> code.CommandExecution
  sink path "exec.CommandContext" arg 3 val "-c" -> code.CommandExecution
  sink path "syscall.Exec" -> code.CommandExecution
  sink path "syscall.ForkExec" -> code.CommandExecution
  sink path "sh.Command" -> code.CommandExecution
  sink path "http.Get" -> code.UrlFetch
  sink path "http.Post" -> code.UrlFetch
  sink path "http.Head" -> code.UrlFetch
  sink path "http.PostForm" -> code.UrlFetch
  sink path "http.NewRequest" -> code.UrlFetch
  sink path "http.NewRequestWithContext" -> code.UrlFetch
  sink path "client.Get" -> code.UrlFetch
  sink path "client.Post" -> code.UrlFetch
  sink path "client.Do" -> code.UrlFetch
  sink path "client.Head" -> code.UrlFetch
  sink path "resty.R" -> code.UrlFetch
  sink path "req.Get" -> code.UrlFetch
  sink path "os.Open" -> code.FilePathAccess
  sink path "os.OpenFile" -> code.FilePathAccess
  sink path "os.ReadFile" -> code.FilePathAccess
  sink path "os.Create" -> code.FilePathAccess
  sink path "os.Remove" -> code.FilePathAccess
  sink path "os.RemoveAll" -> code.FilePathAccess
  sink path "ioutil.ReadFile" -> code.FilePathAccess
  sink path "ioutil.WriteFile" -> code.FilePathAccess
  sink path "http.ServeFile" -> code.FilePathAccess
  sink path "os.Mkdir" -> code.FilePathAccess
  sink path "os.MkdirAll" -> code.FilePathAccess
  sink path "filepath.Walk" -> code.FilePathAccess
  // LDAP injection (CWE-90), XPath injection (CWE-643), trust-boundary write (CWE-501)
  sink method "Search" on [ldap.Conn] -> code.LdapQuery
  sink method "SearchWithPaging" on [ldap.Conn] -> code.LdapQuery
  sink method "XPath" on [xpath.Doc] -> code.XpathQuery
  sink method "Find" on [xpath.Doc] -> code.XpathQuery
  sink method "Set" arg 1 on [session.Store] -> code.TrustBoundary
  // template.HTML(x) casts an untrusted string to "safe" HTML, bypassing contextual
  // auto-escaping → reflected XSS (CWE-79), defended by HTML-escaping the input.
  sink path "template.HTML" -> code.HtmlRender
  sink path "template.JS" -> code.HtmlRender
  sink path "template.URL" -> code.HtmlRender
  sink path "http.Redirect" -> code.RedirectTarget
  sink path "c.Redirect" -> code.RedirectTarget
  sink path "ctx.Redirect" -> code.RedirectTarget

  // controls (sanitizers/validators) — neutralize a flow that passes through them
  control "html.EscapeString" -> core.HtmlEscape
  control "template.HTMLEscapeString" -> core.HtmlEscape
  // filepath.Base strips all directory components — no `/`, `\`, or `..` survives, so it
  // confines a path to a single segment (the Go analogue of path.basename).
  control "filepath.Base" -> core.PathCanonicalization
  // benchmark-harness escapers/validators (wrap real neutralization the rule honors).
  control "support.EscapeLDAP" -> core.LdapEscape
  control "support.XPathLiteral" -> core.XpathEscape
  control "support.AllowRole" -> core.InputValidation

  // regex compile (ReDoS, CWE-1333) — tainted PATTERN arg0
  sink path "regexp.Compile" -> code.RegexCompile
  sink path "regexp.MustCompile" -> code.RegexCompile
  sink path "regexp.MatchString" -> code.RegexCompile

  // weak crypto (CWE-327) — presence marker on the call node
  mark "md5.New" -> code.WeakHash
  mark "sha1.New" -> code.WeakHash
  // one-shot digests: md5.Sum(b) / sha1.Sum(b) are the common Go idiom alongside .New().
  mark "md5.Sum" -> code.WeakHash
  mark "sha1.Sum" -> code.WeakHash

  // insecure randomness (CWE-330) — math/rand. The math/rand-only methods (Intn/Int31/
  // Int63/Float64/Perm/Shuffle) disambiguate from crypto/rand (which has Read/Int/Prime).
  mark "rand.Intn" -> code.WeakRandomValue
  mark "rand.Int31" -> code.WeakRandomValue
  mark "rand.Int31n" -> code.WeakRandomValue
  mark "rand.Int63" -> code.WeakRandomValue
  mark "rand.Int63n" -> code.WeakRandomValue
  mark "rand.Float64" -> code.WeakRandomValue
  mark "rand.Float32" -> code.WeakRandomValue
  mark "rand.Perm" -> code.WeakRandomValue
  mark "rand.Shuffle" -> code.WeakRandomValue
  mark "rand.NewSource" -> code.WeakRandomValue

  // weak cipher (CWE-327) — named broken ciphers
  mark "des.NewCipher" -> code.WeakCipher
  mark "des.NewTripleDESCipher" -> code.WeakCipher
  mark "rc4.NewCipher" -> code.WeakCipher

  // insecure file permission (CWE-732) — world-writable mode on chmod/WriteFile/MkdirAll.
  // octal literal text is carried by the frontend; restrictive modes are not matched.
  mark "os.Chmod" val "0777" -> code.InsecurePermission
  mark "os.Chmod" val "0666" -> code.InsecurePermission
  mark "os.MkdirAll" val "0777" -> code.InsecurePermission
  mark "os.WriteFile" val "0777" -> code.InsecurePermission
  mark "os.WriteFile" val "0666" -> code.InsecurePermission
  mark "ioutil.WriteFile" val "0777" -> code.InsecurePermission
  mark "ioutil.WriteFile" val "0666" -> code.InsecurePermission

  // TLS cert validation disabled (CWE-295) — tls.Config{InsecureSkipVerify: true}
  mark "tls.Config" val "InsecureSkipVerify=true" -> code.CertValidationDisabled

  // permissive CORS (CWE-942) — w.Header().Set("Access-Control-Allow-Origin", "*")
  mark "Header.Set" val "Access-Control-Allow-Origin" val "*" -> code.PermissiveCors
  mark "Header.Add" val "Access-Control-Allow-Origin" val "*" -> code.PermissiveCors

  // clickjacking (CWE-1021) — X-Frame-Options EXPLICITLY set to ALLOWALL (omission not flagged)
  mark "Header.Set" val "X-Frame-Options" val "ALLOWALL" -> code.MissingFrameProtection
  mark "Header.Add" val "X-Frame-Options" val "ALLOWALL" -> code.MissingFrameProtection

  // insecure cookie (CWE-614) — http.Cookie{HttpOnly: false} / {Secure: false} explicit
  mark "http.Cookie" val "HttpOnly=false" -> code.InsecureCookie
  mark "http.Cookie" val "Secure=false" -> code.InsecureCookie

  // cleartext channel (CWE-319) — http:// URL to net/http (loopback excluded; low sev)
  mark "http.Get" val "http://" nval "127.0" -> code.CleartextChannel
  mark "http.Post" val "http://" nval "127.0" -> code.CleartextChannel
  mark "http.NewRequest" val "http://" nval "127.0" -> code.CleartextChannel


  // character-filter: regexp (*Regexp).ReplaceAllString is global.
  filter method "ReplaceAllString" global
  filter method "ReplaceAll" global
}
