    has "/tmp/"
  }

  // TLS cert validation disabled (CWE-295) — tls.Config{InsecureSkipVerify: true}
  flag code.CertValidationDisabled on any {
    path "tls.Config"
    has "InsecureSkipVerify=true"
  }
  flag code.JwtUnverified on any {
    path "ParseUnverified"
  }
  flag code.CsrfDisabled in function {
    function "CheckOrigin"
    param type "http.Request"
    token return "true"
    not call path "r.Header.Get"
    not selector "r.Host"
  }
  flag code.DtlsEpochZeroApplicationData in function {
    function "handleIncomingPacket"
    call path "h.Unmarshal"
    selector "h.epoch"
    call path "c.state.cipherSuite.decrypt"
    call path "r.Unmarshal"
    selector "c.decrypted"
    not binary "h.epoch==0"
    not binary "0==h.epoch"
  }
  flag code.GrpcGatewayCommonNameAuthenticationBypass in function {
    call path "peer.FromContext"
    selector "tlsInfo.State.VerifiedChains"
    selector "chains.Subject.CommonName"
    lacks literal "grpcgateway-accept"
  }
  flag code.UnverifiedFederationMissingEvents in function {
    call path "missingResp.Events.UntrustedEvents"
    call path "t.cacheAndReturn"
    not call path "ev.VerifyEventSignatures"
