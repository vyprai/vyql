module bindings.textpattern.migration.mf0439c30;

binding hardcodedSecret0 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "analysis.text_pattern.credential_literal"
  emit issue code.HardcodedSecret at node
}
