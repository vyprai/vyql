module bindings.php.migration.mfbe84119;

binding persistentModelTitleStoredXss95 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "name=onSaveElement" and node.token contains "$model->title=$title" and node.token contains "$snapshot['title']=Html::encode($title)" and node.token contains "$model->snapshot=$this->afterSnapshot" and not (node.token contains "$model->title=Html::encode($title)")
  emit issue code.PersistentModelTitleStoredXss at node
}
