module bindings.php.migration.mfbe84119;

binding backendRouteMissingModuleAuthorization177 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "module" and node.token contains "lang=php" and node.token contains "DashboardAjaxController" and node.token contains "/dashboard/" and node.token contains "methods" and not (node.token contains "inheritAccessFromModule")
  emit issue code.BackendRouteMissingModuleAuthorization at node
}
