binding nextcloudFileDropShareScopeBypass168 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "php" and node.context.name contains "getOwnerId" and node.token contains "$this->shareManager->getShareByToken($shareToken)" and node.token contains "$share->getPermissions()&\\OCP\\Constants::PERMISSION_CREATE" and node.token contains "$share->getShareOwner()" and not (node.token contains "$share->getNode()") and not (node.token contains "getFirstNodeById") and not (node.token contains "isEncrypted()")
