module bindings.php.migration.mfbe84119;

binding htmlAttributeRewriteReview180 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "autoptimize_filter_imgopt_lazyload_placeholder" and node.token contains "preg_replace" and node.token contains "$placeholder" and node.token contains "data-src" and node.token contains "data-srcset"
  emit issue code.HtmlAttributeRewriteReview at node
}
