module bindings.php.migration.mfbe84119;

binding fullSizeMediaFileMissingViewFullAuthorization276 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=php" and containsAny(node.token, ["selector:size"]) and node.token contains "literal:full" and node.token contains "literal:view" and node.token contains "call_path:access.required" and node.token contains "call_path:$item.file_path" and containsAny(node.token, ["call_path:readfile", "call_path:file_get_contents"]) and not (node.token contains "literal:view_full")
  emit issue code.FullSizeMediaFileMissingViewFullAuthorization at node
}
