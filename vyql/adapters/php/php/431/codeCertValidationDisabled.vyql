module bindings.php.migration.mfbe84119;

binding certValidationDisabled431 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "curl_setopt_array" and node.token contains "CURLOPT_SSL_VERIFYHOST=0"
  emit issue code.CertValidationDisabled at node
}
