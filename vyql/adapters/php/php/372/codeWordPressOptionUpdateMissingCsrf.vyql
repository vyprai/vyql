module bindings.php.migration.mfbe84119;

binding wordPressOptionUpdateMissingCsrf372 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "subscript:$_REQUEST" and node.token contains "call:update_option" and not (node.scopeCall.any contains "check_admin_referer") and not (node.scopeCall.any contains "wp_verify_nonce")
  emit issue code.WordPressOptionUpdateMissingCsrf at node
}
