module bindings.php.migration.mfbe84119;

binding unparameterizedSqlQueryParser196 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "name=get" and node.token contains "$where_conditions['exclude']=\"a.idNOTIN({$exclude})\"" and node.token contains "$where_sql='WHERE'.join" and node.token contains "$wpdb->get_results" and not (node.token contains "array_map('absint',$exclude)") and not (node.token contains "wp_parse_id_list($exclude)")
  emit issue code.UnparameterizedSqlQueryParser at node
}
