module bindings.php.migration.mfbe84119;

binding passwordRecoveryLinkHostControl304 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "ResetPassword" and node.token contains "createToken" and node.token contains "account:login-token" and node.token contains "absolute: true" and node.token contains "$email->text" and not (node.token contains "buildBaseUrl") and not (node.token contains "resolveUri")
  emit issue code.PasswordRecoveryLinkHostControl at node
}
