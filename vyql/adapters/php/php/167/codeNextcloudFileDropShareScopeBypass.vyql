module bindings.php.migration.mfbe84119;

binding nextcloudFileDropShareScopeBypass167 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "name=addMetadataFileDrop" and node.token contains "$this->getOwnerId($shareToken)" and node.token contains "$this->rootFolder->getUserFolder($ownerId)" and node.token contains "$userFolder->getById($id)" and node.token contains "$this->metaDataStorage->updateMetaDataIntoIntermediateFile($ownerId,$id" and not (node.token contains "getFileDropOwnerId") and not (node.token contains "getFirstNodeById") and not (node.token contains "$share->getNode()")
  emit issue code.NextcloudFileDropShareScopeBypass at node
}
