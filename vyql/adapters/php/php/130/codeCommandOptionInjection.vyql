module bindings.php.migration.mfbe84119;

binding commandOptionInjection130 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "escapeshellarg($keyId)" and node.token contains "$operation='--list-keys'.escapeshellarg($keyId)" and not (node.token contains "$operation='--list-keys--'.escapeshellarg($keyId)")
  emit issue code.CommandOptionInjection at node
  emit sink code.CommandOptionInjectionSink at node
}
