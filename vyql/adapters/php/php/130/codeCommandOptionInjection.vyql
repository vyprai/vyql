module bindings.php.migration.mfbe84119;

binding commandOptionInjection130 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "php" and node.token contains "escapeshellarg($keyId)" and node.token contains "$operation='--list-keys'.escapeshellarg($keyId)" and not (node.token contains "$operation='--list-keys--'.escapeshellarg($keyId)")
  emit issue code.CommandOptionInjection at node
  emit sink code.CommandOptionInjectionSink at node
}
