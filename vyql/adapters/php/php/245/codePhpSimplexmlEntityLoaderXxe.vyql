module bindings.php.migration.mfbe84119;

binding phpSimplexmlEntityLoaderXxe245 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "call_path:simplexml_load_string" and not (node.token contains "call_path:libxml_disable_entity_loader")
  emit issue code.PhpSimplexmlEntityLoaderXxe at node
}
