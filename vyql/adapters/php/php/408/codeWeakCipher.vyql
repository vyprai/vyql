module bindings.php.migration.mfbe84119;

binding weakCipher408 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "openssl_encrypt" and node.token contains "ecb"
  emit issue code.WeakCipher at node
}
