module bindings.php.migration.mfbe84119;

binding secretFilePermissionReview434 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "generateKey" and node.token contains "keyfile" and not (node.token contains "chmod")
  emit issue code.SecretFilePermissionReview at node
}
