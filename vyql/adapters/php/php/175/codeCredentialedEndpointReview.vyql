module bindings.php.migration.mfbe84119;

binding credentialedEndpointReview175 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "getRequiredBodyParam" and node.token contains "loadBucketList" and node.token contains "asJson" and not (node.token contains "requireAdmin")
