module bindings.php.migration.mfbe84119;

binding incompleteCsrfTokenValidation369 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "name=restart" and node.token contains "delete_option" and node.token contains "$wpdb->query" and node.token contains "DELETE FROM" and not (node.token contains "check_admin_referer") and not (node.token contains "wp_verify_nonce")
  emit issue code.IncompleteCsrfTokenValidation at node
}
