module bindings.php.migration.mfbe84119;

binding unescapedJsonTreeLabelXss141 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "$name=$configuration->getName()" and node.token contains "'text'=>$name" and not (node.token contains "'text'=>htmlspecialchars($name)") and not (node.token contains "'text'=>htmlentities($name)")
  emit issue code.UnescapedJsonTreeLabelXss at node
}
