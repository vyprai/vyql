module bindings.php.generated.mfbe84119;

binding unescapedJsonTreeLabelXss141 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "php" and node.token contains "$name=$configuration->getName()" and node.token contains "'text'=>$name" and not (node.token contains "'text'=>htmlspecialchars($name)") and not (node.token contains "'text'=>htmlentities($name)")
  emit issue code.UnescapedJsonTreeLabelXss at node
}
