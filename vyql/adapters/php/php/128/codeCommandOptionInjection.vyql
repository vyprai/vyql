module bindings.php.migration.mfbe84119;

binding commandOptionInjection128 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "php" and node.token contains "escapeshellarg($fingerprint)" and node.token contains "$operation='--delete-key'.escapeshellarg($fingerprint)" and not (node.token contains "$operation='--delete-key--'.escapeshellarg($fingerprint)")
  emit issue code.CommandOptionInjection at node
  emit sink code.CommandOptionInjectionSink at node
}
