module bindings.php.migration.mfbe84119;

binding commandOptionInjection128 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "escapeshellarg($fingerprint)" and node.token contains "$operation='--delete-key'.escapeshellarg($fingerprint)" and not (node.token contains "$operation='--delete-key--'.escapeshellarg($fingerprint)")
  emit issue code.CommandOptionInjection at node
  emit sink code.CommandOptionInjectionSink at node
}
