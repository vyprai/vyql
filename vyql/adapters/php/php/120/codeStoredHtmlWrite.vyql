module bindings.php.migration.mfbe84119;

binding storedHtmlWrite120 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "php" and node.context.name contains "save" and node.token contains "$html=post('html')" and node.token contains "$html=$this->_filter_html($html)" and node.token contains "Comment_model::updateOrCreate" and node.token contains "'html'=>$html" and not (node.token contains "ParseMarkdown") and not (node.token contains "setSafeMode(true)")
