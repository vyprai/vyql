module bindings.php.migration.mfbe84119;

binding disabledRelationshipMetadataExposure164 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "name=getRelatableResourceTypesByField" and node.token contains "$field=$this->getFieldByPublicName($field_name)" and node.token contains "$fieldinstanceofResourceTypeRelationship" and node.token contains "$field->getRelatableResourceTypes()" and not (node.token contains "$field->isFieldEnabled()")
  emit issue code.DisabledRelationshipMetadataExposure at node
}
