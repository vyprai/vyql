module bindings.php.migration.mfbe84119;

binding unvalidatedLocaleFileInclude202 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "name=resetMessages" and node.token contains "include" and node.token contains "sprintf('%s/%s.php'" and node.token contains "$locale" and node.token contains "$this->getDirectories()" and not (node.token contains "$this->assertValidLocale($locale)")
  emit issue code.UnvalidatedLocaleFileInclude at node
}
