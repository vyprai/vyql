module bindings.php.migration.mfbe84119;

binding unvalidatedLocaleFileInclude202 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "php" and node.context.name contains "resetMessages" and node.token contains "include" and node.token contains "sprintf('%s/%s.php'" and node.token contains "$locale" and node.token contains "$this->getDirectories()" and not (node.token contains "$this->assertValidLocale($locale)")
  emit issue code.UnvalidatedLocaleFileInclude at node
}
