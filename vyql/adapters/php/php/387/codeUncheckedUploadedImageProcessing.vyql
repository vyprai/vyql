  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "imagecopyresampled" and node.token contains "$imgt($new_image,$thumb_path)" and node.token contains "$imgt($old_image,$source_path)" and node.token contains "returntrue" and not (node.token contains "===false") and not (node.token contains "return$imgt")
