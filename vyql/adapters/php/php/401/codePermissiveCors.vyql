module bindings.php.migration.mfbe84119;

binding permissiveCors401 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "header" and node.token contains "Access-Control-Allow-Origin: *"
  emit issue code.PermissiveCors at node
}
