module bindings.php.migration.mfbe84119;

binding insecureCookie417 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "setcookie" and node.token contains "httponly=false"
  emit issue code.InsecureCookie at node
}
