  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "name=sign" and node.token contains "HmacDRBG" and node.token contains "$drbg->generate($bytes)" and node.token contains "$k=$this->_truncateToN($k,true)" and node.token contains "$kp=$this->g->mul($k)" and node.token contains "$s=$k->invm($this->n)" and not (node.token contains "$ks=$k->add($this->n)") and not (node.token contains "$kt=$ks->add($this->n)") and not (node.token contains "$ks->bitLength()===$this->n->bitLength()")
