  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "call_path:Environment" and node.token contains "call_path:MarkdownConverter" and node.token contains "call_path:CommonMarkCoreExtension" and not (node.token contains "literal:html_input") and not (node.token contains "call_path:DisallowedRawHtmlExtension") and not (node.token contains "call_path:HTMLPurifier") and not (node.token contains "call_path:HtmlSanitizer") and not (node.token contains "call_path:sanitizeHtml")
