binding ezPublishSearchNumericParamXss104 {
  query pattern presenceNode where node.scope == "module" and node.context.language == "php" and node.context.callPath contains "eZSearch.search" and node.context.callPath contains "$tpl.setVariable" and node.context.assignCall contains "$pageLimit:$http.variable" and node.context.assignLiteral contains "$pageLimit:BrowsePageLimit" and node.context.callArg contains "eZSearch.search:array" and node.context.callArg contains "$tpl.setVariable:$pageLimit" and not (node.context.castCallLiteral contains "int:$http.variable:BrowsePageLimit")
