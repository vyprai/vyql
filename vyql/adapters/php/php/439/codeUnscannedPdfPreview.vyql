module bindings.php.migration.mfbe84119;

binding unscannedPdfPreview439 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "StreamedResponse" and node.token contains "application/pdf" and not (node.token contains "getResponseByScanStatus") and not (node.token contains "getScanStatus") and not (node.token contains "scan_pdf")
  emit issue code.UnscannedPdfPreview at node
}
