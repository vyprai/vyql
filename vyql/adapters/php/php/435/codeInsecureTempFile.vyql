module bindings.php.migration.mfbe84119;

binding insecureTempFile435 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "fopen" and node.token contains "/tmp/" and node.token contains "w"
  emit issue code.InsecureTempFile at node
}
