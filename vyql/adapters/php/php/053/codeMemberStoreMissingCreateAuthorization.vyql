binding memberStoreMissingCreateAuthorization53 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=php" and node.token contains "name=store" and node.token contains "call_path:$request.getParsedBody" and node.token contains "call_path:$member.setSelfMembership" and node.token contains "call_path:$member.canEdit" and node.token contains "call_path:$member.store" and node.token contains "call_path:$this.isSelfMembership" and not (node.token contains "call_path:$member.canCreate")
