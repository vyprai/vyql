module bindings.php.migration.mfbe84119;

binding unboundedReportPeriod66 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "module" and node.token contains "lang=php" and node.token contains "CHttpRequest::get_Value('period')" and node.token contains "DateTimeUtil::getLastDaysIntervals($period)" and node.token contains "getStoredBytes" and node.token contains "getStoredFiles" and not (node.token contains "array_key_exists") and not (node.token contains "filter_var($period")
  emit issue code.UnboundedReportPeriod at node
}
