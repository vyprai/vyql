module bindings.php.migration.mfbe84119;

binding bbcodeUrlTagProtocolXss78 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=php" and node.token contains "call:preg_replace" and node.token contains "url" and node.token contains "img" and node.token contains "<a href=\"$1\"" and node.token contains "<img src=\"$1\"" and not (node.token contains "https?:")
  emit issue code.BbcodeUrlTagProtocolXss at node
}
