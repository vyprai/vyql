module bindings.php.migration.mfbe84119;

binding bbcodeUrlTagProtocolXss78 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "call:preg_replace" and node.token contains "url" and node.token contains "img" and node.token contains "<a href=\"$1\"" and node.token contains "<img src=\"$1\"" and not (node.token contains "https?:")
  emit issue code.BbcodeUrlTagProtocolXss at node
}
