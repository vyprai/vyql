module bindings.php.migration.mfbe84119;

binding idorPolicyReview152 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path == "__object_literal" and node.token contains "review.id" and not (node.token contains "review.customerid")
  emit issue code.IdorPolicyReview at node
}
