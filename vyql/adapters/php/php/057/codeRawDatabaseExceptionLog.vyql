module bindings.php.migration.mfbe84119;

binding rawDatabaseExceptionLog57 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "call" and node.path == "$error.getTraceAsString" and node.flowTo.path ~= "fwrite" and not (node.flowTo.path ~= "str_replace")
  emit issue code.RawDatabaseExceptionLog at node
}
