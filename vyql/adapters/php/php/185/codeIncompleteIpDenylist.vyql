module bindings.php.migration.mfbe84119;

binding incompleteIpDenylist185 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "module" and node.token contains "lang=php" and node.token contains "base64Url" and node.token contains "get_ffmpeg()" and node.token contains "-i" and not (node.token contains "parse_url($url)") and not (node.token contains "ip_is_private")
  emit issue code.IncompleteIpDenylist at node
}
