module bindings.php.migration.mfbe84119;

binding mfaRedirectBypass178 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "MfaRequiredException" and node.token contains "redirectToMfaEndpoint" and node.token contains "!$mfaRequested" and node.token contains "!$this->isLoggedInBackendUserRequired"
  emit issue code.MfaRedirectBypass at node
}
