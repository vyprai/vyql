module bindings.php.migration.mfbe84119;

binding codeIgniterActiveRecordOffsetSqlInjection193 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=php" and node.token contains "name=offset" and node.token contains "$this->ar_offset=$offset" and not (node.token contains "$this->ar_offset=(int)$offset")
  emit issue code.CodeIgniterActiveRecordOffsetSqlInjection at node
}
