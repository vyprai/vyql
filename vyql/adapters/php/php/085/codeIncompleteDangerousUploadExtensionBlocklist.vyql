module bindings.php.migration.mfbe84119;

binding incompleteDangerousUploadExtensionBlocklist85 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "php" and node.context.name contains "process" and node.token contains "$this->no_script" and node.token contains "preg_match" and node.token contains "php|php5|php4|php3|phtml|pl|py|cgi|asp|js" and node.token contains "$this->file_src_name" and node.token contains "$file_src_name_ext='txt'" and not (node.token contains "phar")
  emit issue code.IncompleteDangerousUploadExtensionBlocklist at node
}
