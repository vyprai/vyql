module bindings.php.migration.mfbe84119;

binding composerGitBranchDiffCommandInjection126 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "name=getUnpushedChanges" and node.token contains "gitdiff--name-status%s...%s--" and node.token contains "$remoteBranch" and node.token contains "$branch" and node.token contains "$this->process->execute($command" and not (node.token contains "$command=['git','diff','--name-status'")
  emit issue code.ComposerGitBranchDiffCommandInjection at node
}
