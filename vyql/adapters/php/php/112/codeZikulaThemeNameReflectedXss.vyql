module bindings.php.migration.mfbe84119;

binding zikulaThemeNameReflectedXss112 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "name=setasdefault" and node.token contains "FormUtil::getPassedValue('themename'" and node.token contains "$this->view->assign('themename',$themename)" and node.token contains "theme_admin_setasdefault.tpl" and not (node.token contains "FILTER_SANITIZE_STRING")
  emit issue code.ZikulaThemeNameReflectedXss at node
}
