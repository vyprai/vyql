binding incompleteServerPortValidation49 {
  query pattern presenceNode where node.scope == "module" and node.context.language == "php" and node.token contains "connect(" and node.token contains "is_numeric($port)" and node.token contains "explode(" and node.token contains "server" and node.token contains "$port<1024"
