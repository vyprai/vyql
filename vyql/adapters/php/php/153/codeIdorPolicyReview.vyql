module bindings.php.migration.mfbe84119;

binding idorPolicyReview153 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "fileId" and node.token contains "getRules(" and node.token contains "return$userRules;" and not (node.token contains "userHasAccessTo")
  emit issue code.IdorPolicyReview at node
}
