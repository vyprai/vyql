module bindings.php.migration.mfbe84119;

binding phpMyAdminSetupRedirectorOpenRedirect125 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "name=PMA_linkURL" and node.token contains "url.php" and node.token contains "PMA_generate_common_url" and node.token contains "$params['url']=$url" and node.token contains "defined('PMA_SETUP')" and node.token contains "'../'.$goto" and not (node.token contains "defined('PMA_SETUP')){return$url")
  emit issue code.PhpMyAdminSetupRedirectorOpenRedirect at node
}
