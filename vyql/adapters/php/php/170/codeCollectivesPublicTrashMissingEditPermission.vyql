binding collectivesPublicTrashMissingEditPermission170 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=php" and node.token contains "name=index" and node.token contains "$this->handleErrorResponse(function():array{" and node.token contains "$this->getCollectiveShare()->getOwner()" and node.token contains "$this->service->findAllTrash($collectiveId,$owner)" and node.token contains "$pageInfo->setShareToken($this->getToken())" and not (node.token contains "$this->checkEditPermissions()")
