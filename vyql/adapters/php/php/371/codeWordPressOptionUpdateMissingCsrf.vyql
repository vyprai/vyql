module bindings.php.migration.mfbe84119;

binding wordPressOptionUpdateMissingCsrf371 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=php" and node.token contains "subscript:$_POST" and node.token contains "call:update_option" and not (node.scopeCall.any contains "check_admin_referer") and not (node.scopeCall.any contains "wp_verify_nonce")
  emit issue code.WordPressOptionUpdateMissingCsrf at node
}
