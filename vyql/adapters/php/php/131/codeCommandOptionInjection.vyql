module bindings.php.migration.mfbe84119;

binding commandOptionInjection131 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "php" and node.token contains "escapeshellarg($fingerprint)" and node.token contains "$operation.=''.escapeshellarg($fingerprint)" and not (node.token contains "$operation.='--'.escapeshellarg($fingerprint)")
  emit issue code.CommandOptionInjection at node
  emit sink code.CommandOptionInjectionSink at node
}
