module bindings.php.migration.mfbe84119;

binding incompleteCommandEscapeRegex83 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "module" and node.token contains "lang=php" and node.token contains "escape_command" and node.token contains "preg_replace" and node.token contains "/(\\\\\\$|`)/" and node.token contains "popen" and node.token contains "ns_id"
  emit issue code.IncompleteCommandEscapeRegex at node
}
