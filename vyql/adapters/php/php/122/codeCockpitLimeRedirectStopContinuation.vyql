module bindings.php.migration.mfbe84119;

binding cockpitLimeRedirectStopContinuation122 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "name=stop" and node.token contains "$this->request->stopped=true" and not (node.token contains "app:request:stop")
  emit issue code.CockpitLimeRedirectStopContinuation at node
}
