module bindings.php.migration.mfbe84119;

binding templatePathComponentTraversal139 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "templates/{$type}/{$language}" and node.token contains "{$entityType}" and node.token contains "{$name}.tpl" and not (node.token contains "basename($entityType)")
  emit issue code.TemplatePathComponentTraversal at node
}
