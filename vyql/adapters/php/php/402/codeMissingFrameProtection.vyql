module bindings.php.migration.mfbe84119;

binding missingFrameProtection402 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "header" and node.token contains "X-Frame-Options: ALLOWALL"
  emit issue code.MissingFrameProtection at node
}
