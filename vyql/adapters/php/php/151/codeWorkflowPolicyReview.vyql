module bindings.php.migration.mfbe84119;

binding workflowPolicyReview151 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path == "__object_literal" and node.token contains "order.customerid" and node.token contains "order.product.attribute.id" and not (node.token contains "order.statuspayment")
  emit issue code.WorkflowPolicyReview at node
}
