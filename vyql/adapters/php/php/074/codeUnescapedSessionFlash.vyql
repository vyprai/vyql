module bindings.php.migration.mfbe84119;

binding unescapedSessionFlash74 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "$_SESSION[\"flash\"]" and node.token contains "$" and not (node.token contains "htmlspecialchars") and not (node.token contains "htmlentities") and not (node.token contains "esc_html") and not (node.token contains "strip_tags")
  emit issue code.UnescapedSessionFlash at node
}
