module bindings.php.migration.mfbe84119;

binding unescapedSessionFlash74 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "php" and node.token contains "$_SESSION[\"flash\"]" and node.token contains "$" and not (node.token contains "htmlspecialchars") and not (node.token contains "htmlentities") and not (node.token contains "esc_html") and not (node.token contains "strip_tags")
  emit issue code.UnescapedSessionFlash at node
}
