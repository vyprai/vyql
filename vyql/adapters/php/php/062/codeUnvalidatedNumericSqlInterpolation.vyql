binding unvalidatedNumericSqlInterpolation62 {
  query pattern presenceNode where node.scope == "module" and node.token contains "lang=php" and node.token contains "subscript:$HTTP_GET_VARS['lid']" and node.token contains "call_path:$xoopsDB.query" and node.token contains "literal: where " and not (node.token contains "call_arg:is_numeric:$lid")
