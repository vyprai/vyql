module bindings.php.migration.mfbe84119;

binding recursiveObjectParentResolveWithoutCycleGuard117 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "php" and containsAny(node.token, ["name=getAttribute", "name=getInheritedAttribute", "name=resolveInherited", "name=findInherited"]) and node.context.callPath contains "PdfType.resolve" and node.context.callPath contains "PdfDictionary.get" and node.context.literal contains "Parent" and node.context.subscript contains "$parentDict.value['Parent']" and not (containsAny(node.token, ["call_arg:$ensuredObjectList", "call_arg:$visitedObjects", "call_arg:$visitedObjectList", "call_arg:$visited"]))
  emit issue code.RecursiveObjectParentResolveWithoutCycleGuard at node
