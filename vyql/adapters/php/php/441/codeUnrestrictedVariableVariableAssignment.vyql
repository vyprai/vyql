module bindings.php.migration.mfbe84119;

binding unrestrictedVariableVariableAssignment441 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "foreach" and node.token contains "$_GET" and node.token contains "$$" and not (node.token contains "preg_match") and not (node.token contains "in_array") and not (node.token contains "array_key_exists")
  emit issue code.UnrestrictedVariableVariableAssignment at node
}
