module bindings.php.migration.mfbe84119;

binding absolutePathDisclosure388 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "getAbsolutePath" and node.token contains "move_uploaded_file(" and not (node.token contains "@move_uploaded_file(")
  emit issue code.AbsolutePathDisclosure at node
}
