  query pattern presenceNode where node.scope == "module" and node.context.language == "php" and node.context.callPath contains "eZSearch.search" and node.context.callPath contains "$tpl.setVariable" and node.context.assignCall contains "$searchPageLimit:$http.variable" and node.context.assignLiteral contains "$searchPageLimit:SearchPageLimit" and node.context.callArg contains "$tpl.setVariable:$searchPageLimit" and not (node.context.castCallLiteral contains "int:$http.variable:SearchPageLimit")
