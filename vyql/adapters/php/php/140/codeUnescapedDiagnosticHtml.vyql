module bindings.php.migration.mfbe84119;

binding unescapedDiagnosticHtml140 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "$this->last_headers" and node.token contains "$log.=$this->last_headers" and node.token contains "$result['log']=$log" and not (node.token contains "$log.=htmlentities($this->last_headers")
  emit issue code.UnescapedDiagnosticHtml at node
}
