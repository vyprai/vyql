binding unescapedLocalFileContentHtmlRender275 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=php" and node.token contains "call_path:file_get_contents" and node.token contains "call_path:print" and not (containsAny(node.token, ["call_path:htmlspecialchars", "call_path:htmlentities", "call_path:esc_html", "call_path:html_escape", "call_path:strip_tags"]))
