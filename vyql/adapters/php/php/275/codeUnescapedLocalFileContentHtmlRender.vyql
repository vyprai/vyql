binding unescapedLocalFileContentHtmlRender275 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "php" and node.context.callPath contains "file_get_contents" and node.context.callPath contains "print" and not (containsAny(node.token, ["call_path:htmlspecialchars", "call_path:htmlentities", "call_path:esc_html", "call_path:html_escape", "call_path:strip_tags"]))
