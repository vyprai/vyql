module bindings.php.generated.mfbe84119;

binding concreteCmsIncompleteUploadExtensionBlacklist86 {
  query pattern presenceNode where node.scope == "module" and node.context.language == "php" and node.token contains "'extensions_blacklist'=>'*.php;*.php2;*.php3;*.php4;*.php5;*.php7;*.phtml'" and not (node.token contains "*.phar")
  emit issue code.ConcreteCmsIncompleteUploadExtensionBlacklist at node
}
