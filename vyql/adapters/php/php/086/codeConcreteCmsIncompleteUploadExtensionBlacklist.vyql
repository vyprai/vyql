module bindings.php.migration.mfbe84119;

binding concreteCmsIncompleteUploadExtensionBlacklist86 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "module" and node.token contains "lang=php" and node.token contains "'extensions_blacklist'=>'*.php;*.php2;*.php3;*.php4;*.php5;*.php7;*.phtml'" and not (node.token contains "*.phar")
  emit issue code.ConcreteCmsIncompleteUploadExtensionBlacklist at node
}
