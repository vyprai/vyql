module bindings.php.migration.mfbe84119;

binding incompleteArchiveFilenameValidation181 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "_maliciousFilename" and node.token contains "strpos(" and node.token contains "/../" and node.token contains "../" and not (node.token contains "phar://")
  emit issue code.IncompleteArchiveFilenameValidation at node
}
