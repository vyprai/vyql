module bindings.php.migration.mfbe84119;

binding weakHash416 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "hash_hmac" and node.token contains "md5"
  emit issue code.WeakHash at node
}
