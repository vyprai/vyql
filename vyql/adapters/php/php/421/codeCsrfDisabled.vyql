module bindings.php.migration.mfbe84119;

binding csrfDisabled421 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "withoutMiddleware" and node.token contains "VerifyCsrfToken"
  emit issue code.CsrfDisabled at node
}
