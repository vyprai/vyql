module bindings.php.migration.mfbe84119;

binding unvalidatedNumericSqlInterpolation61 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "name=actionDownloadFile" and node.token contains "'model_id'=>$id" and not (node.token contains "(int)$id")
  emit issue code.UnvalidatedNumericSqlInterpolation at node
}
