module bindings.php.migration.mfbe84119;

binding unsanitizedSvgUpload114 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "class" and node.token contains "lang=php" and containsAny(node.token, ["function_name:validFileExtension", "function_name:isEverythingValid", "function_name:validateFileExtension"]) and containsAny(node.token, ["literal:svg", "literal:image/svg+xml"]) and node.token contains "call_path:pathinfo" and node.token contains "call_path:GeneralUtility.inList" and node.token contains "call_path:GeneralUtility.verifyFilenameAgainstDenyPattern" and not (containsAny(node.scopeCall.any, [sanitizeSvg, svgSanitize, Sanitizer]))
  emit issue code.UnsanitizedSvgUpload at node
}
