module bindings.php.migration.mfbe84119;

binding unsanitizedSvgUpload114 {
  query pattern presenceNode where node.scope == "class" and node.context.language == "php" and containsAny(node.token, ["function_name:validFileExtension", "function_name:isEverythingValid", "function_name:validateFileExtension"]) and containsAny(node.token, ["literal:svg", "literal:image/svg+xml"]) and node.context.callPath contains "pathinfo" and node.context.callPath contains "GeneralUtility.inList" and node.context.callPath contains "GeneralUtility.verifyFilenameAgainstDenyPattern" and not (containsAny(node.scopeCall.any, [sanitizeSvg, svgSanitize, Sanitizer]))
  emit issue code.UnsanitizedSvgUpload at node
}
