module bindings.php.migration.mfbe84119;

binding absolutePathDisclosure87 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "module" and node.token contains "lang=php" and node.token contains "PluginName:" and node.token contains "add_action" and not (node.token contains "ABSPATH") and not (node.token contains "function_exists('add_action')") and not (node.token contains "function_exists(\"add_action\")")
  emit issue code.AbsolutePathDisclosure at node
}
