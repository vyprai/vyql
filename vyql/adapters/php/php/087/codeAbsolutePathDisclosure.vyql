module bindings.php.migration.mfbe84119;

binding absolutePathDisclosure87 {
  query pattern presenceNode where node.scope == "module" and node.context.language == "php" and node.token contains "PluginName:" and node.token contains "add_action" and not (node.token contains "ABSPATH") and not (node.token contains "function_exists('add_action')") and not (node.token contains "function_exists(\"add_action\")")
  emit issue code.AbsolutePathDisclosure at node
