module bindings.php.migration.mfbe84119;

binding codeSnippetsSafeModeQueryXss102 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=php" and node.token contains "name=add_safe_mode_query_var" and node.token contains "add_query_arg('snippets-safe-mode',$_REQUEST['snippets-safe-mode'],$url)" and not (node.token contains "(bool)$_REQUEST['snippets-safe-mode']") and not (node.token contains "esc_attr") and not (node.token contains "htmlspecialchars")
