module bindings.php.migration.mfbe84119;

binding codeSnippetsSafeModeQueryXss102 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=php" and node.token contains "name=add_safe_mode_query_var" and node.token contains "add_query_arg('snippets-safe-mode',$_REQUEST['snippets-safe-mode'],$url)" and not (node.token contains "(bool)$_REQUEST['snippets-safe-mode']") and not (node.token contains "esc_attr") and not (node.token contains "htmlspecialchars")
  emit issue code.CodeSnippetsSafeModeQueryXss at node
}
