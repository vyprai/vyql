module bindings.php.migration.mfbe84119;

binding jwtUnverified420 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "JWT.decode" and node.token contains "none"
  emit issue code.JwtUnverified at node
}
