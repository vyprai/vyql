// javascript framework adapter (docs/07) — framework→concept content.
// frameworks: express, koa, fastify, hapi, nestjs, nextjs, restify, sails
adapter javascript {
  meta { fidelity: resolved }

  source "process.argv" -> code.CliArgument
  // Public-API params are now handled by the cross-language library param-source
  // (FuncDef.Exported -> code.ExternalEntryInput, library-profile-gated, caller-conditional;
  // see adapters/library.vyql). The old ungated public_api_input seed was retired.
  // Library option bags are caller-controlled under the library profile. These option
  // fields have appeared in code-generation CVEs where the public API reaches an internal
  // compiler callback through a cache/helper the analyzer cannot inline.
  source "options.timezone" -> core.UserControlledData
  source "config.timezone" -> core.UserControlledData
  source path "analysis.parameter.entry" val "decorator_method:Get" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:Post" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:Put" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:Delete" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:Patch" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:Options" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:Head" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:All" -> code.HttpInput
  source path "analysis.parameter.entry" val "entry_kind:call_lambda_param" val "call_path:ipcMain" val "call_method:on" nval "param_index:0" -> code.HttpInput
  source path "analysis.parameter.entry" val "entry_kind:call_lambda_param" val "call_path:ipcMain" val "call_method:handle" nval "param_index:0" -> code.HttpInput
  source path "analysis.parameter.entry" val "entry_kind:call_lambda_param" val "call_path:ipcMain" val "call_method:once" nval "param_index:0" -> code.HttpInput
  source path "analysis.parameter.entry" val "entry_kind:call_lambda_param" val "call_path:ipcRenderer" val "call_method:on" nval "param_index:0" -> code.HttpInput
  source path "analysis.parameter.entry" val "entry_kind:call_lambda_param" val "call_path:ipcRenderer" val "call_method:once" nval "param_index:0" -> code.HttpInput
  source "req.body" -> code.HttpInput
  source "req.query" -> code.HttpInput
  source "req.params" -> code.HttpInput
  source "req.headers" -> code.HttpInput
  source "req.cookies" -> code.HttpInput
  source "req.signedCookies" -> code.HttpInput
  source "file.filename" -> code.FileUpload
  source "req.get" -> code.HttpInput
  source "req.header" -> code.HttpInput
  source "req.param" -> code.HttpInput
  source "req.files" -> code.HttpInput
  source "req.file" -> code.FileUpload
  source "req.files" -> code.FileUpload
  source "req.rawBody" -> code.HttpInput
  source "req.url" -> code.HttpInput
  source "req.path" -> code.HttpInput
  source "req.originalUrl" -> code.HttpInput
  source "request.body" -> code.HttpInput
  source "request.query" -> code.HttpInput
  source "request.params" -> code.HttpInput
  source "request.headers" -> code.HttpInput
  source "err.message" -> code.HttpInput
  source "request.payload" -> code.HttpInput
  source "request.state" -> code.HttpInput
  source "request.cookies" -> code.HttpInput
  source "ctx.request.body" -> code.HttpInput
  source "ctx.query" -> code.HttpInput
  source "ctx.params" -> code.HttpInput
  source "ctx.request.query" -> code.HttpInput
  source "ctx.cookies.get" -> code.HttpInput
  source "ctx.headers" -> code.HttpInput
  source "ctx.request.headers" -> code.HttpInput
  source "ctx.request.querystring" -> code.HttpInput
  source "event.headers" -> code.HttpInput
  source "event.multiValueHeaders" -> code.HttpInput
  source "event.queryStringParameters" -> code.HttpInput
  source "event.pathParameters" -> code.HttpInput
  source "event.body" -> code.HttpInput
  // Build/CI environment variables are operator-controlled input; when concatenated
  // into shell-plugin script strings they become command injection input.
  source "process.env.NODE_ENV" -> core.UserControlledData
  source "process.env" -> code.SecretValue
  // Parsed output from a shell command is external platform state. If a later
  // shell command interpolates one of those parsed values, it is command input.
  source path "execSync.toString.split.map" -> code.StoredDataRead
  source path "child_process.execSync.toString.split.map" -> code.StoredDataRead
  source path "cp.execSync.toString.split.map" -> code.StoredDataRead
  // vm2-style bridge boundary: arguments crossing from sandbox realm into host
  // function application are attacker-controlled by sandbox code.
  source "otherFromThisArguments" -> core.UserControlledData

  // Browser / SPA DOM entry points (attacker-controlled URL / storage / window state)
  source "location.search" -> code.DomInput
  source "location.hash" -> code.DomInput
  source "location.href" -> code.DomInput
  source "location.pathname" -> code.DomInput
  source "window.location" -> code.DomInput
  source "window.location.search" -> code.DomInput
  source "window.location.hash" -> code.DomInput
  source "window.location.href" -> code.DomInput
  source "getPageQuery" -> code.DomInput
  source "document.location" -> code.DomInput
  source "document.URL" -> code.DomInput
  source "document.documentURI" -> code.DomInput
  source "document.referrer" -> code.DomInput
  source "window.name" -> code.DomInput
  source "localStorage.getItem" -> code.DomInput
  source "sessionStorage.getItem" -> code.DomInput
  source "document.cookie" -> code.DomInput
  // Browser fetch/Response payloads are external data. SPAs often store parsed JSON
  // in a client model and later render model fields into the DOM.
  source "response.json" -> code.DomInput
  source "res.json" -> code.DomInput
  source "queryParams" -> code.DomInput
  // jQuery data-* reads can carry server/user-controlled DOM content into client-side HTML.
  source method "data" -> code.DomInput
  // Browser UI helper option bags can be populated from attacker-controlled markup/URLs.
  source "opt.title" -> code.DomInput
  // Tooltip title metadata is copied from attacker-controlled DOM attributes in common
  // Bootstrap-style helpers, then often measured/rendered through HTML sinks.
  source method "originalTitle" -> code.DomInput
  source method "tooltipTitle" -> code.DomInput
  // Parsed browser XML/HTML often comes from network responses; values extracted from it
  // are attacker-controlled unless independently verified.
  source method "parseFromString" -> core.UserControlledData
  mark exact "analysis.function.context" val "lang=javascript" val "copyIn" val "file.path" val "info.extension" nval "sanitizeSvg" nval "DOMPurify" -> code.StoredHtmlWrite
  mark exact "analysis.function.context" val "lang=javascript" val "newTomSelect" val "directoryName" val "return`<" nval "sanitizeDirectoryName" nval "textContent" nval "innerHTML" -> code.UnescapedHtmlOptionRenderer
  mark exact "analysis.function.context" val "lang=javascript" val "getAttribute" val "data-content" val "optionContent" val "innerHTML" val "appendChild" nval "sanitizeHtml" nval "DOMPurify" nval "sanitize-html" -> code.UnescapedHtmlOptionRenderer
  mark exact "analysis.module.context" val "lang=javascript" val "onCellHtmlData" val "htmlData" val "returnhtmlData" val "tableExport" val "escape:false" nval "escape:true" nval "returncell.text" nval "returncell.text()" -> code.UnescapedTableExportHtml
  mark exact "analysis.module.context" val "lang=javascript" val "tar.extract" val "ignore:isSymlink" val "functionisSymlink(entry)" val "entry.type==='SymbolicLink'" nval "functionisSymlink(_,entry)" nval "entry.type==='symlink'" -> code.ArchiveSymlinkFilterBypass
  // Next.js App Router — searchParams (page prop / destructured) + nextUrl query
  source "searchParams" -> code.HttpInput
  source "req.nextUrl" -> code.HttpInput
  source "request.nextUrl" -> code.HttpInput

  sink method "query" -> code.SqlExecution
  sink method "raw" -> code.SqlExecution
  sink method "execute" -> code.SqlExecution
  sink method "unprepared" -> code.SqlExecution
  // Prisma raw (CWE-89) — $queryRawUnsafe/$executeRawUnsafe take a raw string
  sink method "$queryRaw" -> code.SqlExecution
  sink method "$queryRawUnsafe" -> code.SqlExecution
  sink method "$executeRaw" -> code.SqlExecution
  sink method "$executeRawUnsafe" -> code.SqlExecution
  // Sequelize.literal injects raw SQL into a query
  sink method "literal" -> code.SqlExecution
  sink path "sequelize.query" -> code.SqlExecution
  sink path "knex.raw" -> code.SqlExecution
  sink path "connection.query" -> code.SqlExecution
  sink path "pool.query" -> code.SqlExecution
  sink path "db.query" -> code.SqlExecution
  // ueberDB key-glob read: db.findKeys("pad:"+id+"*") — an unsanitized id in the key pattern
  // reads keys outside the intended namespace (CWE-22-style traversal of the kv store).
  sink method "findKeys" -> code.FilePathAccess
  sink path "client.query" -> code.SqlExecution
  sink path "mysql.query" -> code.SqlExecution
  sink path "pg.query" -> code.SqlExecution
  sink path "sql.query" -> code.SqlExecution
  // CSRF (CWE-352, RF-003) — security-sensitive state-changing operations (low-FP scope)
  sink method "changePassword" -> code.StateChangingOp
  sink method "updatePassword" -> code.StateChangingOp
  sink method "resetPassword" -> code.StateChangingOp
  sink method "changeEmail" -> code.StateChangingOp
  sink method "transferFunds" -> code.StateChangingOp
  sink method "deleteAccount" -> code.StateChangingOp
  sink method "grantRole" -> code.StateChangingOp
  sink method "makeAdmin" -> code.StateChangingOp
  mark "changePassword" -> code.AuthenticationRequiredOp
  mark "updatePassword" -> code.AuthenticationRequiredOp
  mark "resetPassword" -> code.AuthenticationRequiredOp
  mark "changeEmail" -> code.AuthenticationRequiredOp
  mark "transferFunds" -> code.AuthenticationRequiredOp
  mark "deleteAccount" -> code.AuthenticationRequiredOp
  mark "grantRole" -> code.AuthenticationRequiredOp
  mark "makeAdmin" -> code.AuthenticationRequiredOp
  // CSRF protection — explicit token verification (guards RF-003 via a PROTECTS edge)
  control "verifyCsrfToken" -> core.CsrfProtection
  control "validateCsrfToken" -> core.CsrfProtection
  control "requireAuth" -> core.AuthenticationCheck
  control "ensureAuthenticated" -> core.AuthenticationCheck
  control "isAuthenticated" -> core.AuthenticationCheck
  control "authenticate" -> core.AuthenticationCheck
  // authorization checks (guards BIZ-001) — path-sensitive via B1.
  control "checkPermission" -> core.AuthorizationCheck
  control "hasPermission" -> core.AuthorizationCheck
  control "ability.can" -> core.AuthorizationCheck
  control "checkOwnership" -> core.OwnershipCheck
  control "requireOwner" -> core.OwnershipCheck
  control "isOwner" -> core.OwnershipCheck
  control "ownsResource" -> core.OwnershipCheck
  mark exact "analysis.function.context" val "isLocalRequest" val "isLocal||awaithasValidToken" nval "hasValidCliToken" -> code.LocalRequestBypassReview
  mark exact "analysis.function.context" val "lang=javascript" val "authorized_keys?.includes(data.pubkey)" val "private_keys[data.pubkey]" val "!noscraper" nval "pubkeyInConfig" nval "authorized_keys?.length&&!pubkeyInConfig" -> code.AccessPolicyReview
  mark exact "analysis.function.context" val "lang=javascript" val "user==username&&pass==password" nval "timingSafeCompare" nval "tsscmp" -> code.SecretComparisonReview
  // SSRF / open-redirect allowlist validators (guard the fetch/redirect they dominate).
  mark exact "analysis.function.context" val "lang=javascript" val "ctx.request?.method" val "POST" val "return;" val "callbackURL" val "redirectTo" val "trustedOrigins" val "validateURL" -> code.MethodGatedRedirectValidationBypass
  control "isSafeRedirect" -> core.RedirectAllowlist
  control "isValidRedirect" -> core.RedirectAllowlist
  control "isAllowedRedirect" -> core.RedirectAllowlist
  control "isUrlAllowed" -> core.AllowlistValidation
  control "isAllowedHost" -> core.AllowlistValidation
  control "validateUrl" -> core.AllowlistValidation
  mark exact "analysis.function.context" val "name=updateDynamicPageSriHashes" val "integrityRegex.exec(attrs)" val "globalHashes[t2].set(src,sriHash)" nval "Detected reference to not explicitly allowed external resource" -> code.ExternalResourceIntegrityReview
  // Electron: shell.openExternal can launch arbitrary apps/protocols from a URL
  sink path "shell.openExternal" -> code.CommandExecution
  // Electron insecure renderer config (named-value on the BrowserWindow options)
  mark "BrowserWindow" val "nodeIntegration=true" -> code.ElectronNodeIntegration
  mark "BrowserWindow" val "contextIsolation=false" -> code.ElectronNodeIntegration
  mark "webPreferences" val "nodeIntegration=true" -> code.ElectronNodeIntegration

  sink path "child_process.exec" -> code.CommandExecution
  sink path "child_process.execSync" -> code.CommandExecution
  sink path "child_process.spawn" -> code.CommandExecution
  sink path "child_process.spawn" arg 1 collection val "cmd.exe" -> code.CommandExecution
  sink path "child_process.spawnSync" -> code.CommandExecution
  sink path "child_process.spawnSync" arg 1 collection val "cmd.exe" -> code.CommandExecution
  sink path "child_process.execFile" -> code.CommandExecution
  sink path "child_process.execFileSync" -> code.CommandExecution
  // value in the ARGS ARRAY (arg1) is shell-interpreted = command injection. (arg0 is the
  sink path "child_process.fork" -> code.CommandExecution
  sink path "cp.exec" -> code.CommandExecution
  sink path "cp.execSync" -> code.CommandExecution
  sink path "cp.spawn" -> code.CommandExecution
  sink path "cp.spawn" arg 1 collection val "cmd.exe" -> code.CommandExecution
  sink path "exec" -> code.CommandExecution
  sink path "execSync" -> code.CommandExecution
  sink path "spawn" -> code.CommandExecution
  sink path "spawn" arg 1 collection val "cmd.exe" -> code.CommandExecution
  sink path "spawnSync" -> code.CommandExecution
  sink path "spawnSync" arg 1 collection val "cmd.exe" -> code.CommandExecution
  sink path "execFile" -> code.CommandExecution
  // execFile/spawn with a SHELL binary or shell:true runs the ARGS ARRAY (arg1)
  // through a shell, so a tainted value there is command injection. (Plain execFile
  // with a non-shell binary is safe — args are not shell-interpreted — so this is
  // scoped to shell contexts via val.)
  sink path "execFile" arg 1 collection val "powershell" -> code.CommandExecution
  sink path "execFile" arg 1 collection val "cmd.exe" -> code.CommandExecution
  sink path "execFile" arg 1 collection val "/bin/sh" -> code.CommandExecution
  sink path "execFile" arg 1 collection val "/bin/bash" -> code.CommandExecution
  sink path "execFile" arg 1 collection val "shell" val "true" -> code.CommandExecution
  sink path "spawn" arg 1 collection val "powershell" -> code.CommandExecution
  sink path "spawn" arg 1 collection val "shell" val "true" -> code.CommandExecution
  sink path "shelljs.exec" -> code.CommandExecution
  sink path "shell.exec" -> code.CommandExecution
  sink path "webpack-shell-plugin-next" -> code.CommandExecution
  sink path "WebpackShellPlugin" -> code.CommandExecution
  sink path "eval" -> code.CodeEval
  sink path "Function" -> code.CodeEval
  sink path "vm.runInNewContext" -> code.CodeEval
  sink path "vm.runInThisContext" -> code.CodeEval
  sink path "vm.runInContext" -> code.CodeEval
  sink path "vm.compileFunction" -> code.CodeEval
  sink path "vm2.run" -> code.CodeEval
  mark "eval" val "ref." val "parts" -> code.RequestReferenceEval
  mark exact "analysis.function.context" val "new VM" val "sandbox.templateFilters" val "sandbox.templateGlobals" val "vm.run" nval "isolated-vm" nval "Isolate" -> code.Vm2HostCallbackBridge
  sink path "globalEval" -> code.CodeEval
  sink path "require" -> code.DynamicCodeLoad
  sink path "import" -> code.DynamicCodeLoad
  sink path "pdfjs.getDocument" -> code.PdfJsDocumentLoad
  // vm2-style bridge boundary: applying a host function with sandbox-provided args
  // can expose host Function constructors when callback args are not sanitized.
  sink path "otherReflectApply" arg 2 -> code.CodeEval
  // `generate-function` style builders append source snippets via calls like
  // `parserFn("return " + user)` before `parserFn.toFunction()` compiles them.
  sink path "parserFn" arg all -> code.CodeEval
  sink method "toFunction" -> code.CodeEval
  sink path "serialize.unserialize" -> code.Deserialization
  sink path "node-serialize.unserialize" -> code.Deserialization
  sink path "unserialize" -> code.Deserialization
  sink path "funcster.deepDeserialize" -> code.Deserialization
  sink path "cryo.parse" -> code.Deserialization
  sink path "yaml.load" -> code.Deserialization
  sink path "js-yaml.load" -> code.Deserialization
  sink path "jsyaml.load" -> code.Deserialization
  sink path "axios.get" -> code.UrlFetch
  sink path "axios.post" -> code.UrlFetch
  sink path "axios.put" -> code.UrlFetch
  sink path "axios.delete" -> code.UrlFetch
  sink path "axios.request" -> code.UrlFetch
  sink path "axios" -> code.UrlFetch
  sink path "fetch" -> code.UrlFetch
  sink path "node-fetch" -> code.UrlFetch
  sink path "http.get" -> code.UrlFetch
  sink path "https.get" -> code.UrlFetch
  sink path "http.request" -> code.UrlFetch
  sink path "https.request" -> code.UrlFetch
  sink path "request" -> code.UrlFetch
  // headless-browser navigation (Puppeteer/Playwright `page.goto(url)`) fetches an
  // attacker-controllable URL server-side -> SSRF (CVE-2026-5323, a11y-mcp).
  sink method "goto" -> code.UrlFetch
  sink path "request.get" -> code.UrlFetch
  sink path "request.post" -> code.UrlFetch
  sink path "needle.get" -> code.UrlFetch
  sink path "needle.post" -> code.UrlFetch
  sink path "superagent.get" -> code.UrlFetch
  sink path "superagent.post" -> code.UrlFetch
  sink path "got" -> code.UrlFetch
  sink path "got.get" -> code.UrlFetch
  sink path "got.post" -> code.UrlFetch
  sink path "undici.request" -> code.UrlFetch
  sink path "fetch.default" -> code.UrlFetch
  sink path "fs.writeFile" -> code.UnsafeUpload
  sink path "fs.writeFileSync" -> code.UnsafeUpload
  sink path "fs.createWriteStream" -> code.UnsafeUpload
  sink path "fs.readFile" -> code.FilePathAccess
  sink path "fs.readFileSync" -> code.FilePathAccess
  sink path "fs.writeFile" -> code.FilePathAccess
  sink path "fs.writeFileSync" -> code.FilePathAccess
  sink path "fs.unlink" -> code.FilePathAccess
  sink path "fs.unlinkSync" -> code.FilePathAccess
  sink path "fs.createReadStream" -> code.FilePathAccess
  sink path "fs.createWriteStream" -> code.FilePathAccess
  sink path "fs.appendFile" -> code.FilePathAccess
  sink path "fs.appendFileSync" -> code.FilePathAccess
  sink path "fs.readdir" -> code.FilePathAccess
  sink path "fs.open" -> code.FilePathAccess
  sink path "fs.openSync" -> code.FilePathAccess
  sink path "fs.rename" -> code.FilePathAccess
  sink path "fs.mkdir" -> code.FilePathAccess
  sink path "existsSync" -> code.FilePathAccess
  sink path "lstatSync" -> code.FilePathAccess
  sink path "readdirSync" -> code.FilePathAccess
  sink path "unlinkSync" -> code.FilePathAccess
  sink path "mkdirSync" -> code.FilePathAccess
  sink path "fsPromises.readFile" -> code.FilePathAccess
  sink path "fsp.readFile" -> code.FilePathAccess
  sink path "fse.readFile" -> code.FilePathAccess
  sink path "res.sendFile" -> code.FilePathAccess
  sink path "res.download" -> code.FilePathAccess
  sink path "zip.file" -> code.FilePathAccess
  sink path "extractEntryTo" -> code.ArchiveEntryWrite
  sink path "zip.extractEntryTo" -> code.ArchiveEntryWrite
  sink path "admZip.extractEntryTo" -> code.ArchiveEntryWrite
  sink path "entry.pipe" -> code.ArchiveEntryWrite
  package "adm-zip" {
    // Bulk extraction writes archive entry names chosen by the archive content.
    // Model the constructed archive as untrusted data and the extraction receiver
    // as the path-writing primitive; guarded_by PathAccessCheck handles preflight
    // entry containment loops.
    source path "adm-zip" -> code.ArchiveEntryName
    sink receiver "extractAllTo" -> code.ArchiveEntryWrite
  }
  sink path "User.findById" -> code.ObjectLookupByUserInput
  sink path "Account.findById" -> code.ObjectLookupByUserInput
  sink path "Order.findById" -> code.ObjectLookupByUserInput
  sink path "findUserById" -> code.ObjectLookupByUserInput
  sink path "findAccountById" -> code.ObjectLookupByUserInput
  sink path "findOrderById" -> code.ObjectLookupByUserInput
  sink path "readFileToBuffer" -> code.FilePathAccess
  sink path "writeFileFromBuffer" -> code.FilePathAccess
  // Client-side handoff of an uploaded object key/path into a hidden form field that the
  // server later opens from storage.
  sink path "hiddenFileInput.value" -> code.FilePathAccess
  sink path "res.send" -> code.HtmlRender
  // HTTP response splitting / header injection (CWE-113) — Express/Koa header value is arg1.
  sink path "res.setHeader" arg 1 -> code.ResponseHeaderWrite
  sink path "res.header" arg 1 -> code.ResponseHeaderWrite
  sink path "res.set" arg 1 -> code.ResponseHeaderWrite
  sink path "ctx.set" arg 1 -> code.ResponseHeaderWrite
  sink path "reply.header" arg 1 -> code.ResponseHeaderWrite
  // log injection (CWE-117) + secret-in-log (CWE-532).
  sink path "console.log" arg all -> code.LogOutput
  sink path "console.warn" arg all -> code.LogOutput
  sink path "console.error" arg all -> code.LogOutput
  sink path "logger.info" arg all -> code.LogOutput
  sink path "logger.warn" arg all -> code.LogOutput
  sink path "logger.error" arg all -> code.LogOutput
  sink path "logger.debug" arg all -> code.LogOutput
  sink path "log.info" arg all -> code.LogOutput
  sink path "log.error" arg all -> code.LogOutput
  mark "console.log" -> code.LogWrite
  mark "console.warn" -> code.LogWrite
  mark "console.error" -> code.LogWrite
  mark "logger.info" -> code.LogWrite
  mark "logger.warn" -> code.LogWrite
  mark "logger.error" -> code.LogWrite
  mark "logger.debug" -> code.LogWrite
  mark "log.info" -> code.LogWrite
  mark "log.error" -> code.LogWrite
  // CSV/formula injection (CWE-1236) — common csv-stringify/fast-csv writer APIs.
  sink path "csv.write" arg all -> code.CsvCell
  sink path "csvStream.write" arg all -> code.CsvCell
  sink path "stringifier.write" arg all -> code.CsvCell
  sink path "csvStringify.write" arg all -> code.CsvCell
  sink method "writeRecords" arg all -> code.CsvCell
  // chained / callback emit: res.type("html").send(x), res.format({html:()=>res.send(x)})
  sink method "send" -> code.HtmlRender
  sink path "res.write" -> code.HtmlRender
  sink path "res.end" -> code.HtmlRender
  sink path "dangerouslySetInnerHTML" -> code.HtmlRender
  sink path "innerHTML" -> code.HtmlRender
  sink path "outerHTML" -> code.HtmlRender
  sink path "document.write" -> code.HtmlRender
  sink path "insertAdjacentHTML" arg 1 -> code.HtmlRender
  // jQuery root calls can parse an HTML string, unlike scoped lookups such as
  // $(document).find(selector).
  sink exact "$" val "selector" -> code.HtmlRender
  sink exact "jQuery" val "selector" -> code.HtmlRender
  sink path "$.html" -> code.HtmlRender
  sink path "el.html" -> code.HtmlRender
  sink method "html" -> code.HtmlRender
  sink method "append" -> code.HtmlRender
  sink method "prepend" -> code.HtmlRender
  // Contao/SimpleModal-style modal helpers render the `title` field as HTML.
  sink path "M.show" arg 0 collection val "title" -> code.HtmlRender
  // Stored XSS: writing attacker-controlled markup into high-signal HTML-bearing
  // fields. Kept field-qualified so generic Mongo writes remain NoSQL/proto checks.
  sink method "findOneAndUpdate" arg 1 collection val "hypertext" -> code.HtmlRender
  sink method "findOneAndUpdate" arg 1 collection val "html" -> code.HtmlRender
  sink method "updateOne" arg 1 collection val "hypertext" -> code.HtmlRender
  sink method "updateOne" arg 1 collection val "html" -> code.HtmlRender
  sink method "updateMany" arg 1 collection val "hypertext" -> code.HtmlRender
  sink method "updateMany" arg 1 collection val "html" -> code.HtmlRender
  sink method "create" arg 0 collection val "hypertext" -> code.HtmlRender
  sink method "create" arg 0 collection val "html" -> code.HtmlRender
  sink method "insertOne" arg 0 collection val "hypertext" -> code.HtmlRender
  sink method "insertOne" arg 0 collection val "html" -> code.HtmlRender
  // Angular: bypassSecurityTrust* defeats the sanitizer (untrusted -> trusted HTML/URL)
  sink method "bypassSecurityTrustHtml" -> code.HtmlRender
  sink method "bypassSecurityTrustUrl" -> code.HtmlRender
  sink method "bypassSecurityTrustResourceUrl" -> code.HtmlRender
  sink method "bypassSecurityTrustScript" -> code.HtmlRender
  sink method "bypassSecurityTrustStyle" -> code.HtmlRender
  sink path "handlebars.compile" -> code.TemplateRender
  sink path "Handlebars.compile" -> code.TemplateRender
  sink path "ejs.render" -> code.TemplateRender
  sink path "ejs.compile" -> code.TemplateRender
  sink path "pug.compile" -> code.TemplateRender
  sink path "pug.render" -> code.TemplateRender
  sink path "lodash.template" -> code.TemplateRender
  sink path "_.template" -> code.TemplateRender
  sink path "nunjucks.renderString" -> code.TemplateRender
  sink path "nunjucks.compile" -> code.TemplateRender
  sink path "res.redirect" -> code.RedirectTarget
  sink path "ctx.redirect" -> code.RedirectTarget
  sink path "reply.redirect" -> code.RedirectTarget
  sink path "response.redirect" -> code.RedirectTarget
  // DOM open-redirect: writing a tainted URL to location (property-write sinks)
  sink path "location.href" -> code.RedirectTarget
  sink path "location.href" -> code.HtmlRender
  sink path "location.assign" -> code.RedirectTarget
  sink path "location.replace" -> code.RedirectTarget
  sink path "window.location.href" -> code.RedirectTarget
  sink path "window.location.href" -> code.HtmlRender
  sink path "window.location" -> code.RedirectTarget
  sink path "collection.find" -> code.NosqlQuery
  sink path "collection.findOne" -> code.NosqlQuery
  sink path "db.eval" -> code.NosqlQuery
  sink path "Model.find" -> code.NosqlQuery
  sink path "Model.findOne" -> code.NosqlQuery
  sink path "Model.where" -> code.NosqlQuery
  sink path "mapReduce" -> code.NosqlQuery

  // controls (sanitizers/validators) — neutralize a flow that passes through them
  // numeric coercion bounds output to digits/sign/dot/exponent — no HTML/SQL metachar can
  // survive, so it neutralizes injection (sound; FN-safe — only the coerced flow is killed).
  control "Number" -> core.HtmlEscape
  control "Number" -> core.SqlParameterization
  control "parseInt" -> core.HtmlEscape
  control "parseInt" -> core.SqlParameterization
  control "parseFloat" -> core.HtmlEscape
  control "parseFloat" -> core.SqlParameterization
  // numeric coercion is also INPUT VALIDATION: the value is confined to a number, so it
  // cannot carry a forged identity/role into a trust context (CWE-501). FN-safe — real
  // trust-boundary violations write the raw string, with no Number()/parseInt() coercion.
  control "Number" -> core.InputValidation
  control "parseInt" -> core.InputValidation
  control "parseFloat" -> core.InputValidation
  // SOUND path neutralizer: path.basename(x) strips all directory components -> no `/` or
  // `..` can survive (a boundary check like target.startsWith(base) is NOT added — it is
  // unsound alone, e.g. "/tmp/../etc" startsWith "/tmp", which would create false negatives).
  control "path.basename" -> core.PathCanonicalization
  // format validators provably constrain the value (membership/format) -> validated input.
  control "validator.isUUID" -> core.InputValidation
  control "validator.isAlphanumeric" -> core.InputValidation
  control "validator.isInt" -> core.InputValidation
  control "validator.isNumeric" -> core.InputValidation
  mark "string.replace" val "&amp;" val "\\w+;" nval "#\\d" nval "#x" -> code.IncompleteHtmlEntityEscape
  control "encode" -> core.HtmlEscape
  control "encodeEntities" -> core.HtmlEscape
  control "escapeHTML" -> core.HtmlEscape
  control "escape-html" -> core.HtmlEscape
  control "he.encode" -> core.HtmlEscape
  control "validator.escape" -> core.HtmlEscape
  control "lodash.escape" -> core.HtmlEscape
  control "_.escape" -> core.HtmlEscape
  control "DOMPurify.sanitize" -> core.HtmlEscape
  control "sanitize-html" -> core.HtmlEscape
  control "sanitizeHtml" -> core.HtmlEscape
  control "xss" -> core.HtmlEscape
  control "mysql.escape" -> core.SqlParameterization
  control "sqlstring.escape" -> core.SqlParameterization
  control "shell-quote.quote" -> core.ShellEscape
  control "shellQuote.quote" -> core.ShellEscape

  // ── UNSOUND neutralizers (`assume`) ───────────────────────────────────────────────
  // These MIGHT defuse the threat but cannot be proven to, so they NEVER suppress a flow.
  // Instead the engine emits the finding WITH an assumption note: the confident bucket
  // (no note) stays near-zero-FP, the noted bucket is the human review queue. This is the
  // regex-CharFilter mechanism generalized to arbitrary guards/escapers.
  //
  // guard = must DOMINATE the sink (a boundary check); sanitizer = must lie ON the path.

  // Prefix/suffix/containment boundary checks: "/tmp/../etc".startsWith("/tmp") passes yet
  // escapes the dir — sound enough to flag-with-assumption, unsound to suppress on.
  assume guard method "startsWith"   -> code.FilePathAccess
  assume guard method "endsWith"     -> code.FilePathAccess
  assume guard method "includes"     -> code.FilePathAccess
  assume guard method "startsWith"   -> code.TrustBoundary
  // NB: path.normalize / path.resolve are NOT listed as assume-sanitizers. They canonicalize
  // but make no attempt to confine to a base dir (path.resolve('/files','../../etc')='/etc'),
  // so they are not even *plausible* neutralizers — a flow through them is a confident finding,
  // not an assumption. What makes a path case safe is a containment guard (startsWith, above)
  // or path.basename (a sound control), each handled on its own.
  control "sanitizeFilename" -> core.PathCanonicalization
  control "sanitizeFilePath" -> core.PathCanonicalization
  control method "sanitizeFilePath" -> core.PathCanonicalization
  control "checkLoadingAccess" -> core.PathAccessCheck
  control "isParentDirectory" -> core.PathAccessCheck
  control "isWithin" -> core.PathAccessCheck
  // Custom / library LDAP & XPath escapers we cannot verify are complete for the sink grammar.
  assume sanitizer method "ldapEscape"      -> code.LdapQuery
  assume sanitizer path   "ldap.escapeFilter" -> code.LdapQuery
  assume sanitizer path   "ldapEscape"      -> code.LdapQuery
  assume sanitizer method "escapeXPath"     -> code.XpathQuery
  assume sanitizer method "xpathLiteral"    -> code.XpathQuery
  assume sanitizer method "encodeXPath"     -> code.XpathQuery

  // regex compile (ReDoS, CWE-1333) — tainted PATTERN arg0
  sink path "RegExp" -> code.RegexCompile
  sink receiver "replace" val "+)*m" -> code.RegexMatch
  mark "RegExp" val "d]*(?:;" -> code.CatastrophicRegex

  // mass assignment (CWE-915) — request body -> bulk bind
  sink method "bulkCreate" -> code.MassAssign

  // prototype pollution (CWE-1321) — untrusted source object (arg1) of a deep merge
  sink path "_.merge" arg 1 -> code.ProtoPollute
  sink path "lodash.merge" arg 1 -> code.ProtoPollute
  sink path "_.mergeWith" arg 1 -> code.ProtoPollute
  sink path "_.defaultsDeep" arg 1 -> code.ProtoPollute
  sink path "deepmerge" arg 1 -> code.ProtoPollute
  sink path "$.extend" arg 2 -> code.ProtoPollute
  sink path "jQuery.extend" arg 2 -> code.ProtoPollute
  sink path "__js_dynamic_property_write" -> code.ProtoPollute
  control "analysis.function.context" val "curr[prop]===constructor.prototype" val "curr[prop]={}" -> core.PrototypePollutionGuard
  // Polluted inherited option reads in template/compiler APIs can control generated code.
  sink path "opts.client" -> code.ProtoPollute
  sink path "opts.escape" -> code.ProtoPollute
  sink path "opts.escapeFunction" -> code.ProtoPollute
  sink path "opts.outputFunctionName" -> code.ProtoPollute
  sink path "opts.localsName" -> code.ProtoPollute
  sink path "opts.destructuredLocals" -> code.ProtoPollute
  sink path "opts._with" -> code.ProtoPollute

  // weak cipher (CWE-327) value-matched
  // weak cipher (CWE-327): fire unless a strong AEAD/256-bit algorithm literal is present
  // (catches ecb/cbc/des/rc4/aes-128 + dynamic algorithm vars; accepts FP on dynamic-strong).
  mark "simplecrypt" val "aes-192-ecb" -> code.WeakCipher
  mark "createCipheriv" nval "gcm" nval "chacha" nval "poly1305" -> code.WeakCipher
  mark "createCipheriv" val "0000000000000000" -> code.StaticIv
  mark "createCipheriv" val "000000000000" -> code.StaticIv

  // weak hash (CWE-328) — crypto.createHash('md5'|'sha1') (value-matched).
  // weak hash (CWE-328): value-match the weak algorithm on the createHash node. Precise —
  // resolves indirection too (createHash(['sha1'][0]) / const-propped vars put the literal in
  // the args) and does NOT mis-fire on the chained .update()/.digest() nodes.
  mark "createHash" val "md5" -> code.WeakHash
  mark "createHash" val "md4" -> code.WeakHash
  mark "createHash" val "md2" -> code.WeakHash
  mark "createHash" val "sha1" -> code.WeakHash
  mark "createHash" val "ripemd" -> code.WeakHash

  // Package managers and monorepo tools execute project-controlled lifecycle
  // scripts during install/sync. Treat explicit installer invocations as code
  // execution even when the command string itself is constant.
  mark "spawnSync" val "install" -> code.PackageInstallExecution
  mark "spawnSync" val "sync" -> code.PackageInstallExecution
  mark "child_process.spawnSync" val "install" -> code.PackageInstallExecution
  mark "child_process.spawnSync" val "sync" -> code.PackageInstallExecution
  mark "execFileSync" val "install" -> code.PackageInstallExecution
  mark "execFileSync" val "sync" -> code.PackageInstallExecution
  mark "child_process.execFileSync" val "install" -> code.PackageInstallExecution
  mark "child_process.execFileSync" val "sync" -> code.PackageInstallExecution

  // Embeddable iframe allowlists that include domains able to host attacker content
  // become XSS when paired with same-origin sandboxing/srcdoc embed behavior.
  mark "Set" val "dddice.com" -> code.UnsafeEmbeddableAllowlist
  // Next.js middleware that rewrites to markdown solely on an acceptsMarkdown()
  // predicate can serve markdown to clients that also prefer HTML.
  mark "acceptsMarkdown" -> code.MarkdownNegotiationBypass
  // PDF.js eval support allows malicious PDFs to execute embedded JavaScript.
  mark "__object_literal" val "isEvalSupported=true" -> code.PdfJsEvalSupported

  // weak randomness (CWE-330) — presence of Math.random() (non-crypto PRNG).
  // crypto.randomBytes / randomUUID (CSPRNG) are deliberately NOT marked.
  mark "Math.random" -> code.WeakRandomValue

  // TLS cert validation disabled (CWE-295) — rejectUnauthorized:false
  mark "https.request" val "rejectUnauthorized=false" -> code.CertValidationDisabled
  mark "https.get" val "rejectUnauthorized=false" -> code.CertValidationDisabled
  mark "https.Agent" val "rejectUnauthorized=false" -> code.CertValidationDisabled
  mark "tls.connect" val "rejectUnauthorized=false" -> code.CertValidationDisabled
  mark exact "analysis.function.context" val "responseBuffer.push(chunk)" val "Buffer.concat(responseBuffer).length>config.maxContentLength" nval "stream.destroy()" -> code.UnboundedResourceOperation
  mark exact "analysis.function.context" val "lang=javascript" val "body.split('&').length" val "len>limit?undefined:len-1" nval "indexOf('&'" -> code.UnboundedDelimiterSplitCount
  mark exact "analysis.function.context" val "lang=javascript" val "Math.abs(numeric(n[2]))" val "test(i,y)" val "i+=incr" nval "Math.max(Math.abs(numeric(n[2])),1)" -> code.ZeroStepSequenceExpansion
  mark "fs.openSync" -> code.ResourceHandle
  mark "fs.open" -> code.ResourceHandle
  control "fs.closeSync" -> core.ResourceRelease
  control "fs.close" -> core.ResourceRelease
  mark exact "analysis.function.context" val "maxContentLength" val "Buffer.concat(responseBuffer).length>config.maxContentLength" val "reject(createError" nval "stream.destroy" -> code.UnstoppedLimitedStream
  mark exact "analysis.function.context" val "name=processMessage" val "protocolMsg" val "HISTORY_SYNC_NOTIFICATION" val "APP_STATE_SYNC_KEY_SHARE" val "PEER_DATA_OPERATION_REQUEST_RESPONSE_MESSAGE" nval "SELF_ONLY_TYPES.has(protocolMsg.type)&&!message.key.fromMe" -> code.ProtocolStateReview
  mark exact "analysis.function.context" val "_downloadFromWorkingDir" val "join(localDirPath,file.name)" val "downloadTo(localPath,file.name)" nval "basename(file.name)" -> code.RemoteListingDownloadPath
  mark exact "analysis.function.context" val "name=<lambda>" val "callbackData.hasOwnProperty(\"status\")" val "data.status==-1" val "callbackFun(callbackData)" nval "callbackData.status==-1" -> code.ClientAuthFailureResponseReview
  mark exact "analysis.function.context" val "prisma.accounts.update" val "where:{id}" val "passwordHash" val "originalPassword" nval "currentUserId" nval "ctx.id" -> code.IdorPolicyReview

  // JWT signature not verified (CWE-347) — jsonwebtoken alg none
  mark "jwt.verify" val "algorithms=none" -> code.JwtUnverified
  mark "jwt.sign" val "algorithm=none" -> code.JwtUnverified
  // explicit CSRF middleware disablement.
  mark "lusca.csrf" val "false" -> code.CsrfDisabled
  mark "csrfProtection" val "false" -> code.CsrfDisabled

  // cleartext channel (CWE-319) — http:// URL to an HTTP client, excluding loopback
  // dev traffic (127.0.x); still FP-prone for other internal hosts → low sev.
  mark "axios" val "http://" nval "127.0" -> code.CleartextChannel
  // Reconstructing a browser Request while copying headers but dropping redirect policy
  // can turn caller-specified `redirect: "error"` into the default follow behavior.
  sink method "newRequest" arg 1 collection val "headers" nval "redirect" -> code.RequestPolicyStripped

  // insecure cookie (CWE-614) — a security flag EXPLICITLY disabled (omission not flagged).
  mark "res.cookie" val "httpOnly=false" -> code.InsecureCookie
  mark "res.cookie" nval "secure=true" -> code.InsecureCookie

  // permissive CORS (CWE-942) — ACAO header set to "*" (multi-val: name AND wildcard)
  mark "res.header" val "Access-Control-Allow-Origin" val "*" -> code.PermissiveCors
  mark "res.set" val "Access-Control-Allow-Origin" val "*" -> code.PermissiveCors
  mark "res.setHeader" val "Access-Control-Allow-Origin" val "*" -> code.PermissiveCors

  // clickjacking (CWE-1021) — frame protection EXPLICITLY disabled (omission not flagged):
  // X-Frame-Options: ALLOWALL, or helmet frameguard turned off.
  mark "res.setHeader" val "X-Frame-Options" val "ALLOWALL" -> code.MissingFrameProtection
  mark "res.set" val "X-Frame-Options" val "ALLOWALL" -> code.MissingFrameProtection
  mark "res.header" val "X-Frame-Options" val "ALLOWALL" -> code.MissingFrameProtection
  mark "helmet" val "frameguard=false" -> code.MissingFrameProtection

  // character-filtering replace(/regex/g, repl): the engine analyzes the output
  // alphabet (charfilter.go) -> sound sanitizer where it excludes the sink excluded_chars.
  filter method "replace"

  // sqlite3 / better-sqlite3 — db.all/get/each/run/exec/prepare(sql, …). A non-SQL
  // collection arg0 (Promise.all([...])) is a Seq and is skipped by the sink matcher.
  sink method "all" -> code.SqlExecution
  sink method "get" -> code.SqlExecution
  sink method "each" -> code.SqlExecution
  sink method "exec" -> code.SqlExecution
  sink method "prepare" -> code.SqlExecution

  // xpath (npm xpath) — the expression is arg0.
  sink path "xpath.select" -> code.XpathQuery
  sink path "xpath.select1" -> code.XpathQuery
  sink path "xpath.evaluate" -> code.XpathQuery

  // ldapjs — client.search(base, {filter}, cb): the filter rides in the options object (arg1).
  sink method "search" arg 1 collection -> code.LdapQuery

  // trust boundary (CWE-501) — untrusted data written into a trust context object
  // (req.session.* / req.securityContext.* / req.authContext.*). These lower to member-
  // write path sinks; the taint requirement means only user-controlled values fire.
  sink path "session" -> code.TrustBoundary
  sink path "securityContext" -> code.TrustBoundary
  sink path "authContext" -> code.TrustBoundary
  // Object.assign(trustContext, { k: untrusted }) — the source object (arg1+) carries taint.
  sink path "Object.assign" arg all collection -> code.TrustBoundary
}
