// javascript framework adapter (docs/07) — framework→concept content.
// frameworks: express, koa, fastify, hapi, nestjs, nextjs, restify, sails
adapter javascript {
  meta { fidelity: resolved }

  source "process.argv" -> code.CliArgument
  // NestJS route-handler params (@Body/@Query/@Param/@Headers), seeded by the frontend.
  source "http_input" -> code.HttpInput
  source "req.body" -> code.HttpInput
  source "req.query" -> code.HttpInput
  source "req.params" -> code.HttpInput
  source "req.headers" -> code.HttpInput
  source "req.cookies" -> code.HttpInput
  source "req.signedCookies" -> code.HttpInput
  source "req.get" -> code.HttpInput
  source "req.header" -> code.HttpInput
  source "req.param" -> code.HttpInput
  source "req.files" -> code.HttpInput
  source "req.rawBody" -> code.HttpInput
  source "req.url" -> code.HttpInput
  source "req.originalUrl" -> code.HttpInput
  source "request.body" -> code.HttpInput
  source "request.query" -> code.HttpInput
  source "request.params" -> code.HttpInput
  source "request.headers" -> code.HttpInput
  source "request.payload" -> code.HttpInput
  source "request.state" -> code.HttpInput
  source "request.cookies" -> code.HttpInput
  source "ctx.request.body" -> code.HttpInput
  source "ctx.query" -> code.HttpInput
  source "ctx.params" -> code.HttpInput
  source "ctx.request.query" -> code.HttpInput
  source "ctx.cookies.get" -> code.HttpInput
  source "ctx.headers" -> code.HttpInput
  source "ctx.request.headers" -> code.HttpInput
  source "ctx.request.querystring" -> code.HttpInput
  source "process.env" -> code.SecretValue

  // Browser / SPA DOM entry points (attacker-controlled URL / storage / window state)
  source "location.search" -> code.DomInput
  source "location.hash" -> code.DomInput
  source "location.href" -> code.DomInput
  source "location.pathname" -> code.DomInput
  source "window.location.search" -> code.DomInput
  source "window.location.hash" -> code.DomInput
  source "window.location.href" -> code.DomInput
  source "document.location" -> code.DomInput
  source "document.URL" -> code.DomInput
  source "document.documentURI" -> code.DomInput
  source "document.referrer" -> code.DomInput
  source "window.name" -> code.DomInput
  source "localStorage.getItem" -> code.DomInput
  source "sessionStorage.getItem" -> code.DomInput
  source "document.cookie" -> code.DomInput
  // Next.js App Router — searchParams (page prop / destructured) + nextUrl query
  source "searchParams" -> code.HttpInput
  source "req.nextUrl" -> code.HttpInput
  source "request.nextUrl" -> code.HttpInput

  sink method "query" -> code.SqlExecution
  sink method "raw" -> code.SqlExecution
  sink method "execute" -> code.SqlExecution
  sink method "unprepared" -> code.SqlExecution
  // Prisma raw (CWE-89) — $queryRawUnsafe/$executeRawUnsafe take a raw string
  sink method "$queryRaw" -> code.SqlExecution
  sink method "$queryRawUnsafe" -> code.SqlExecution
  sink method "$executeRaw" -> code.SqlExecution
  sink method "$executeRawUnsafe" -> code.SqlExecution
  // Sequelize.literal injects raw SQL into a query
  sink method "literal" -> code.SqlExecution
  sink path "sequelize.query" -> code.SqlExecution
  sink path "knex.raw" -> code.SqlExecution
  sink path "connection.query" -> code.SqlExecution
  sink path "pool.query" -> code.SqlExecution
  sink path "db.query" -> code.SqlExecution
  sink path "client.query" -> code.SqlExecution
  sink path "mysql.query" -> code.SqlExecution
  sink path "pg.query" -> code.SqlExecution
  sink path "sql.query" -> code.SqlExecution
  // CSRF (CWE-352, RF-003) — security-sensitive state-changing operations (low-FP scope)
  sink method "changePassword" -> code.StateChangingOp
  sink method "updatePassword" -> code.StateChangingOp
  sink method "resetPassword" -> code.StateChangingOp
  sink method "changeEmail" -> code.StateChangingOp
  sink method "transferFunds" -> code.StateChangingOp
  sink method "deleteAccount" -> code.StateChangingOp
  sink method "grantRole" -> code.StateChangingOp
  sink method "makeAdmin" -> code.StateChangingOp
  // CSRF protection — explicit token verification (guards RF-003 via a PROTECTS edge)
  control "verifyCsrfToken" -> core.CsrfProtection
  control "validateCsrfToken" -> core.CsrfProtection
  // authorization checks (guards BIZ-001) — path-sensitive via B1.
  control "checkPermission" -> core.AuthorizationCheck
  control "hasPermission" -> core.AuthorizationCheck
  control "ability.can" -> core.AuthorizationCheck
  // SSRF / open-redirect allowlist validators (guard the fetch/redirect they dominate).
  control "isSafeRedirect" -> core.RedirectAllowlist
  control "isValidRedirect" -> core.RedirectAllowlist
  control "isAllowedRedirect" -> core.RedirectAllowlist
  control "isUrlAllowed" -> core.AllowlistValidation
  control "isAllowedHost" -> core.AllowlistValidation
  control "validateUrl" -> core.AllowlistValidation
  // Electron: shell.openExternal can launch arbitrary apps/protocols from a URL
  sink path "shell.openExternal" -> code.CommandExecution
  // Electron insecure renderer config (named-value on the BrowserWindow options)
  mark "BrowserWindow" val "nodeIntegration=true" -> code.ElectronNodeIntegration
  mark "BrowserWindow" val "contextIsolation=false" -> code.ElectronNodeIntegration
  mark "webPreferences" val "nodeIntegration=true" -> code.ElectronNodeIntegration

  sink path "child_process.exec" -> code.CommandExecution
  sink path "child_process.execSync" -> code.CommandExecution
  sink path "child_process.spawn" -> code.CommandExecution
  sink path "child_process.spawnSync" -> code.CommandExecution
  sink path "child_process.execFile" -> code.CommandExecution
  sink path "child_process.execFileSync" -> code.CommandExecution
  sink path "child_process.fork" -> code.CommandExecution
  sink path "cp.exec" -> code.CommandExecution
  sink path "cp.execSync" -> code.CommandExecution
  sink path "cp.spawn" -> code.CommandExecution
  sink path "exec" -> code.CommandExecution
  sink path "execSync" -> code.CommandExecution
  sink path "spawn" -> code.CommandExecution
  sink path "spawnSync" -> code.CommandExecution
  sink path "execFile" -> code.CommandExecution
  sink path "shelljs.exec" -> code.CommandExecution
  sink path "shell.exec" -> code.CommandExecution
  sink path "eval" -> code.CodeEval
  sink path "Function" -> code.CodeEval
  sink path "vm.runInNewContext" -> code.CodeEval
  sink path "vm.runInThisContext" -> code.CodeEval
  sink path "vm.runInContext" -> code.CodeEval
  sink path "vm.compileFunction" -> code.CodeEval
  sink path "vm2.run" -> code.CodeEval
  sink path "globalEval" -> code.CodeEval
  sink path "serialize.unserialize" -> code.Deserialization
  sink path "node-serialize.unserialize" -> code.Deserialization
  sink path "unserialize" -> code.Deserialization
  sink path "funcster.deepDeserialize" -> code.Deserialization
  sink path "cryo.parse" -> code.Deserialization
  sink path "yaml.load" -> code.Deserialization
  sink path "js-yaml.load" -> code.Deserialization
  sink path "jsyaml.load" -> code.Deserialization
  sink path "axios.get" -> code.UrlFetch
  sink path "axios.post" -> code.UrlFetch
  sink path "axios.put" -> code.UrlFetch
  sink path "axios.delete" -> code.UrlFetch
  sink path "axios.request" -> code.UrlFetch
  sink path "axios" -> code.UrlFetch
  sink path "fetch" -> code.UrlFetch
  sink path "node-fetch" -> code.UrlFetch
  sink path "http.get" -> code.UrlFetch
  sink path "https.get" -> code.UrlFetch
  sink path "http.request" -> code.UrlFetch
  sink path "https.request" -> code.UrlFetch
  sink path "request" -> code.UrlFetch
  sink path "request.get" -> code.UrlFetch
  sink path "request.post" -> code.UrlFetch
  sink path "needle.get" -> code.UrlFetch
  sink path "needle.post" -> code.UrlFetch
  sink path "superagent.get" -> code.UrlFetch
  sink path "superagent.post" -> code.UrlFetch
  sink path "got" -> code.UrlFetch
  sink path "got.get" -> code.UrlFetch
  sink path "got.post" -> code.UrlFetch
  sink path "undici.request" -> code.UrlFetch
  sink path "fetch.default" -> code.UrlFetch
  sink path "fs.readFile" -> code.FilePathAccess
  sink path "fs.readFileSync" -> code.FilePathAccess
  sink path "fs.writeFile" -> code.FilePathAccess
  sink path "fs.writeFileSync" -> code.FilePathAccess
  sink path "fs.unlink" -> code.FilePathAccess
  sink path "fs.unlinkSync" -> code.FilePathAccess
  sink path "fs.createReadStream" -> code.FilePathAccess
  sink path "fs.createWriteStream" -> code.FilePathAccess
  sink path "fs.appendFile" -> code.FilePathAccess
  sink path "fs.appendFileSync" -> code.FilePathAccess
  sink path "fs.readdir" -> code.FilePathAccess
  sink path "fs.open" -> code.FilePathAccess
  sink path "fs.openSync" -> code.FilePathAccess
  sink path "fs.rename" -> code.FilePathAccess
  sink path "fs.mkdir" -> code.FilePathAccess
  sink path "fsPromises.readFile" -> code.FilePathAccess
  sink path "fse.readFile" -> code.FilePathAccess
  sink path "res.sendFile" -> code.FilePathAccess
  sink path "res.download" -> code.FilePathAccess
  sink path "res.send" -> code.HtmlRender
  // chained / callback emit: res.type("html").send(x), res.format({html:()=>res.send(x)})
  sink method "send" -> code.HtmlRender
  sink path "res.write" -> code.HtmlRender
  sink path "res.end" -> code.HtmlRender
  sink path "dangerouslySetInnerHTML" -> code.HtmlRender
  sink path "innerHTML" -> code.HtmlRender
  sink path "outerHTML" -> code.HtmlRender
  sink path "document.write" -> code.HtmlRender
  sink path "insertAdjacentHTML" arg 1 -> code.HtmlRender
  sink path "$.html" -> code.HtmlRender
  sink path "el.html" -> code.HtmlRender
  // Angular: bypassSecurityTrust* defeats the sanitizer (untrusted -> trusted HTML/URL)
  sink method "bypassSecurityTrustHtml" -> code.HtmlRender
  sink method "bypassSecurityTrustUrl" -> code.HtmlRender
  sink method "bypassSecurityTrustResourceUrl" -> code.HtmlRender
  sink method "bypassSecurityTrustScript" -> code.HtmlRender
  sink method "bypassSecurityTrustStyle" -> code.HtmlRender
  sink path "handlebars.compile" -> code.TemplateRender
  sink path "Handlebars.compile" -> code.TemplateRender
  sink path "ejs.render" -> code.TemplateRender
  sink path "ejs.compile" -> code.TemplateRender
  sink path "pug.compile" -> code.TemplateRender
  sink path "pug.render" -> code.TemplateRender
  sink path "lodash.template" -> code.TemplateRender
  sink path "_.template" -> code.TemplateRender
  sink path "nunjucks.renderString" -> code.TemplateRender
  sink path "nunjucks.compile" -> code.TemplateRender
  sink path "res.redirect" -> code.RedirectTarget
  sink path "ctx.redirect" -> code.RedirectTarget
  sink path "reply.redirect" -> code.RedirectTarget
  sink path "response.redirect" -> code.RedirectTarget
  // DOM open-redirect: writing a tainted URL to location (property-write sinks)
  sink path "location.href" -> code.RedirectTarget
  sink path "location.assign" -> code.RedirectTarget
  sink path "location.replace" -> code.RedirectTarget
  sink path "window.location.href" -> code.RedirectTarget
  sink path "window.location" -> code.RedirectTarget
  sink path "collection.find" -> code.NosqlQuery
  sink path "collection.findOne" -> code.NosqlQuery
  sink path "db.eval" -> code.NosqlQuery
  sink path "Model.find" -> code.NosqlQuery
  sink path "Model.findOne" -> code.NosqlQuery
  sink path "Model.where" -> code.NosqlQuery
  sink path "mapReduce" -> code.NosqlQuery

  // controls (sanitizers/validators) — neutralize a flow that passes through them
  // numeric coercion bounds output to digits/sign/dot/exponent — no HTML/SQL metachar can
  // survive, so it neutralizes injection (sound; FN-safe — only the coerced flow is killed).
  control "Number" -> core.HtmlEscape
  control "Number" -> core.SqlParameterization
  control "parseInt" -> core.HtmlEscape
  control "parseInt" -> core.SqlParameterization
  control "parseFloat" -> core.HtmlEscape
  control "parseFloat" -> core.SqlParameterization
  // numeric coercion is also INPUT VALIDATION: the value is confined to a number, so it
  // cannot carry a forged identity/role into a trust context (CWE-501). FN-safe — real
  // trust-boundary violations write the raw string, with no Number()/parseInt() coercion.
  control "Number" -> core.InputValidation
  control "parseInt" -> core.InputValidation
  control "parseFloat" -> core.InputValidation
  // SOUND path neutralizer: path.basename(x) strips all directory components -> no `/` or
  // `..` can survive (a boundary check like target.startsWith(base) is NOT added — it is
  // unsound alone, e.g. "/tmp/../etc" startsWith "/tmp", which would create false negatives).
  control "path.basename" -> core.PathCanonicalization
  // format validators provably constrain the value (membership/format) -> validated input.
  control "validator.isUUID" -> core.InputValidation
  control "validator.isAlphanumeric" -> core.InputValidation
  control "validator.isInt" -> core.InputValidation
  control "validator.isNumeric" -> core.InputValidation
  control "escape-html" -> core.HtmlEscape
  control "he.encode" -> core.HtmlEscape
  control "validator.escape" -> core.HtmlEscape
  control "lodash.escape" -> core.HtmlEscape
  control "_.escape" -> core.HtmlEscape
  control "DOMPurify.sanitize" -> core.HtmlEscape
  control "xss" -> core.HtmlEscape
  control "mysql.escape" -> core.SqlParameterization
  control "sqlstring.escape" -> core.SqlParameterization
  control "shell-quote.quote" -> core.ShellEscape
  control "shellQuote.quote" -> core.ShellEscape

  // ── UNSOUND neutralizers (`assume`) ───────────────────────────────────────────────
  // These MIGHT defuse the threat but cannot be proven to, so they NEVER suppress a flow.
  // Instead the engine emits the finding WITH an assumption note: the confident bucket
  // (no note) stays near-zero-FP, the noted bucket is the human review queue. This is the
  // regex-CharFilter mechanism generalized to arbitrary guards/escapers.
  //
  // guard = must DOMINATE the sink (a boundary check); sanitizer = must lie ON the path.

  // Prefix/suffix/containment boundary checks: "/tmp/../etc".startsWith("/tmp") passes yet
  // escapes the dir — sound enough to flag-with-assumption, unsound to suppress on.
  assume guard method "startsWith"   -> code.FilePathAccess
  assume guard method "endsWith"     -> code.FilePathAccess
  assume guard method "includes"     -> code.FilePathAccess
  assume guard method "startsWith"   -> code.TrustBoundary
  // NB: path.normalize / path.resolve are NOT listed as assume-sanitizers. They canonicalize
  // but make no attempt to confine to a base dir (path.resolve('/files','../../etc')='/etc'),
  // so they are not even *plausible* neutralizers — a flow through them is a confident finding,
  // not an assumption. What makes a path case safe is a containment guard (startsWith, above)
  // or path.basename (a sound control), each handled on its own.
  // Custom / library LDAP & XPath escapers we cannot verify are complete for the sink grammar.
  assume sanitizer method "ldapEscape"      -> code.LdapQuery
  assume sanitizer path   "ldap.escapeFilter" -> code.LdapQuery
  assume sanitizer path   "ldapEscape"      -> code.LdapQuery
  assume sanitizer method "escapeXPath"     -> code.XpathQuery
  assume sanitizer method "xpathLiteral"    -> code.XpathQuery
  assume sanitizer method "encodeXPath"     -> code.XpathQuery

  // regex compile (ReDoS, CWE-1333) — tainted PATTERN arg0
  sink path "RegExp" -> code.RegexCompile

  // mass assignment (CWE-915) — request body -> bulk bind
  sink method "bulkCreate" -> code.MassAssign

  // prototype pollution (CWE-1321) — untrusted source object (arg1) of a deep merge
  sink path "_.merge" arg 1 -> code.ProtoPollute
  sink path "lodash.merge" arg 1 -> code.ProtoPollute
  sink path "_.mergeWith" arg 1 -> code.ProtoPollute
  sink path "_.defaultsDeep" arg 1 -> code.ProtoPollute
  sink path "deepmerge" arg 1 -> code.ProtoPollute
  sink path "$.extend" arg 2 -> code.ProtoPollute
  sink path "jQuery.extend" arg 2 -> code.ProtoPollute

  // weak cipher (CWE-327) value-matched
  // weak cipher (CWE-327): fire unless a strong AEAD/256-bit algorithm literal is present
  // (catches ecb/cbc/des/rc4/aes-128 + dynamic algorithm vars; accepts FP on dynamic-strong).
  mark "createCipheriv" nval "gcm" nval "chacha" nval "poly1305" -> code.WeakCipher

  // weak hash (CWE-328) — crypto.createHash('md5'|'sha1') (value-matched).
  // weak hash (CWE-328): value-match the weak algorithm on the createHash node. Precise —
  // resolves indirection too (createHash(['sha1'][0]) / const-propped vars put the literal in
  // the args) and does NOT mis-fire on the chained .update()/.digest() nodes.
  mark "createHash" val "md5" -> code.WeakHash
  mark "createHash" val "md4" -> code.WeakHash
  mark "createHash" val "md2" -> code.WeakHash
  mark "createHash" val "sha1" -> code.WeakHash
  mark "createHash" val "ripemd" -> code.WeakHash

  // weak randomness (CWE-330) — presence of Math.random() (non-crypto PRNG).
  // crypto.randomBytes / randomUUID (CSPRNG) are deliberately NOT marked.
  mark "Math.random" -> code.WeakRandomValue

  // TLS cert validation disabled (CWE-295) — rejectUnauthorized:false
  mark "https.request" val "rejectUnauthorized=false" -> code.CertValidationDisabled
  mark "https.get" val "rejectUnauthorized=false" -> code.CertValidationDisabled
  mark "https.Agent" val "rejectUnauthorized=false" -> code.CertValidationDisabled
  mark "tls.connect" val "rejectUnauthorized=false" -> code.CertValidationDisabled

  // JWT signature not verified (CWE-347) — jsonwebtoken alg none
  mark "jwt.verify" val "algorithms=none" -> code.JwtUnverified
  mark "jwt.sign" val "algorithm=none" -> code.JwtUnverified

  // cleartext channel (CWE-319) — http:// URL to an HTTP client, excluding loopback
  // dev traffic (127.0.x); still FP-prone for other internal hosts → low sev.
  mark "axios" val "http://" nval "127.0" -> code.CleartextChannel

  // insecure cookie (CWE-614) — a security flag EXPLICITLY disabled (omission not flagged).
  mark "res.cookie" val "httpOnly=false" -> code.InsecureCookie
  mark "res.cookie" nval "secure=true" -> code.InsecureCookie

  // permissive CORS (CWE-942) — ACAO header set to "*" (multi-val: name AND wildcard)
  mark "res.header" val "Access-Control-Allow-Origin" val "*" -> code.PermissiveCors
  mark "res.set" val "Access-Control-Allow-Origin" val "*" -> code.PermissiveCors
  mark "res.setHeader" val "Access-Control-Allow-Origin" val "*" -> code.PermissiveCors

  // clickjacking (CWE-1021) — frame protection EXPLICITLY disabled (omission not flagged):
  // X-Frame-Options: ALLOWALL, or helmet frameguard turned off.
  mark "res.setHeader" val "X-Frame-Options" val "ALLOWALL" -> code.MissingFrameProtection
  mark "res.set" val "X-Frame-Options" val "ALLOWALL" -> code.MissingFrameProtection
  mark "res.header" val "X-Frame-Options" val "ALLOWALL" -> code.MissingFrameProtection
  mark "helmet" val "frameguard=false" -> code.MissingFrameProtection

  // character-filtering replace(/regex/g, repl): the engine analyzes the output
  // alphabet (charfilter.go) -> sound sanitizer where it excludes the sink dangerous_chars.
  filter method "replace"

  // sqlite3 / better-sqlite3 — db.all/get/each/run/exec/prepare(sql, …). A non-SQL
  // collection arg0 (Promise.all([...])) is a Seq and is skipped by the sink matcher.
  sink method "all" -> code.SqlExecution
  sink method "get" -> code.SqlExecution
  sink method "each" -> code.SqlExecution
  sink method "exec" -> code.SqlExecution
  sink method "prepare" -> code.SqlExecution

  // xpath (npm xpath) — the expression is arg0.
  sink path "xpath.select" -> code.XpathQuery
  sink path "xpath.select1" -> code.XpathQuery
  sink path "xpath.evaluate" -> code.XpathQuery

  // ldapjs — client.search(base, {filter}, cb): the filter rides in the options object (arg1).
  sink method "search" arg 1 collection -> code.LdapQuery

  // trust boundary (CWE-501) — untrusted data written into a trust context object
  // (req.session.* / req.securityContext.* / req.authContext.*). These lower to member-
  // write path sinks; the taint requirement means only user-controlled values fire.
  sink path "session" -> code.TrustBoundary
  sink path "securityContext" -> code.TrustBoundary
  sink path "authContext" -> code.TrustBoundary
  // Object.assign(trustContext, { k: untrusted }) — the source object (arg1+) carries taint.
  sink path "Object.assign" arg all collection -> code.TrustBoundary
}
