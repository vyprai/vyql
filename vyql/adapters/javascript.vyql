    has "value:directiveValue"
    lacks "newMap()"
    lacks "result.set(directiveKey,directiveValue)"
  }
  flag code.ControlledMergeInheritedKeyPrototypePollution in function {
    lang "javascript"
    name "iterateAndMerge"
    has "for(varattrinobj2)"
    has "result[attr]=clone(obj2[attr])"
    has "result[attr]=iterateAndMerge(obj1[attr],obj2[attr])"
    lacks "Object.getOwnPropertyNames(obj2)"
    lacks "allowedAttrs.includes(attr)"
  }
  flag code.ControlledMergeInheritedKeyPrototypePollution in function {
    lang "javascript"
    has "for(varxinprops)"
    has "obj[x]=props[x]"
    has "obj[x]=jqMix(obj[x],props[x])"
    lacks "__proto__"
    lacks "constructor"
    lacks "Object.keys(props)"
    lacks "Object.getOwnPropertyNames(props)"
    lacks "hasOwnProperty.call(props,x)"
  }
  flag code.ChartkickRecursiveExtendPrototypePollution in function {
    lang "javascript"
    name "extend"
    has "for(keyinsource)"
    has "target[key]=source[key]"
    has "extend(target[key],source[key])"
    lacks "key===\"__proto__\""
  }
  flag code.CollectionExtendPrototypePollution in module {
    lang "javascript"
    has "Collection.prototype.extend"
    has "forEach((el,key)=>"
    has "byLink"
    has "setVal(data,key,val)"
    lacks "key==='__proto__'"
  }
  flag code.CollectionExtendPrototypePollution in module {
    lang "javascript"
    has "_core.Collection.prototype.extend"
    has "forEach((el,key)=>"
    has "_link.byLink"
    has "setVal(data,key,val)"
    lacks "key==='__proto__'"
  }
  flag code.CookiexDeepPrototypePollution in module {
    lang "javascript"
    has "Object.keys(b).forEach(key=>"
    has "a[key]=b[key]"
    has "delegate.call(this,a[key],b[key])"
    lacks "invalids.includes(key)"
    lacks "'__proto__'"
  }
  flag code.ForOwnRecursiveDefaultsPrototypePollution on any {
    path exact "analysis.function.context"
    lang "javascript"
    name "copy"
    has "lazy.forOwn(current,function(value,key)"
    has "target[key]=value"
    has "defaultsDeep(val,value)"
    lacks "key==='__proto__'"
  }
  flag code.TemplateDirectoryHiddenGlobCopy on any {
    path exact "analysis.function.context"
    lang "javascript"
    name "downloadTemplate"
    has "fs.statSync(file).isDirectory()"
    has "d.copy(file,dist)"
    lacks "hide:false"
  }
  flag code.NestedPathInheritedPropertyPrototypePollution in function {
    lang "javascript"
    has "currentKeyPath"
    has "remainingKeyPath"
    has "obj[currentKeyPath]"
    has "obj[currentKeyPath]={}"
    has "setByKeyPath(innerObj,remainingKeyPath,value)"
    lacks "hasOwn(obj,currentKeyPath)"
    lacks "Object.prototype.hasOwnProperty.call(obj,currentKeyPath)"
  }
  // Polluted inherited option reads in template/compiler APIs can control generated code.
  sink path "opts.client" -> code.ProtoPollute
  sink path "opts.escape" -> code.ProtoPollute
  sink path "opts.escapeFunction" -> code.ProtoPollute
  sink path "opts.outputFunctionName" -> code.ProtoPollute
  sink path "opts.localsName" -> code.ProtoPollute
  sink path "opts.destructuredLocals" -> code.ProtoPollute
  sink path "opts._with" -> code.ProtoPollute

  // weak cipher (CWE-327) value-matched
  // weak cipher (CWE-327): fire unless a strong AEAD/256-bit algorithm literal is present
  // (catches ecb/cbc/des/rc4/aes-128 + dynamic algorithm vars; accepts FP on dynamic-strong).
  flag code.WeakCipher on any {
    path "simplecrypt"
    has "aes-192-ecb"
  }
  flag code.WeakCipher on any {
    path "createCipheriv"
    lacks "gcm"
    lacks "chacha"
    lacks "poly1305"
  }
  flag code.StaticIv on any {
    path "createCipheriv"
    has "0000000000000000"
  }
  flag code.StaticIv on any {
    path "createCipheriv"
    has "000000000000"
  }

  // weak hash (CWE-328) — crypto.createHash('md5'|'sha1') (value-matched).
  // weak hash (CWE-328): value-match the weak algorithm on the createHash node. Precise —
  // resolves indirection too (createHash(['sha1'][0]) / const-propped vars put the literal in
  // the args) and does NOT mis-fire on the chained .update()/.digest() nodes.
  flag code.WeakHash on any {
    path "createHash"
    has "md5"
  }
  flag code.WeakHash on any {
    path "createHash"
    has "md4"
  }
  flag code.WeakHash on any {
    path "createHash"
    has "md2"
  }
  flag code.WeakHash on any {
    path "createHash"
    has "sha1"
  }
  flag code.WeakHash on any {
    path "createHash"
    has "ripemd"
  }

  // Package managers and monorepo tools execute project-controlled lifecycle
  // scripts during install/sync. Treat explicit installer invocations as code
  // execution even when the command string itself is constant.
  flag code.PackageInstallExecution on any {
    path "spawnSync"
    has "install"
  }
  flag code.PackageInstallExecution on any {
    path "spawnSync"
    has "sync"
  }
  flag code.PackageInstallExecution on any {
    path "child_process.spawnSync"
    has "install"
  }
  flag code.PackageInstallExecution on any {
    path "child_process.spawnSync"
    has "sync"
  }
  flag code.PackageInstallExecution on any {
    path "execFileSync"
    has "install"
  }
  flag code.PackageInstallExecution on any {
    path "execFileSync"
    has "sync"
  }
  flag code.PackageInstallExecution on any {
    path "child_process.execFileSync"
    has "install"
  }
  flag code.PackageInstallExecution on any {
    path "child_process.execFileSync"
    has "sync"
  }

  // Embeddable iframe allowlists that include domains able to host attacker content
  // become XSS when paired with same-origin sandboxing/srcdoc embed behavior.
  flag code.UnsafeEmbeddableAllowlist on any {
    path "Set"
    has "dddice.com"
  }
  // Next.js middleware that rewrites to markdown solely on an acceptsMarkdown()
  // predicate can serve markdown to clients that also prefer HTML.
  flag code.MarkdownNegotiationBypass on any {
    path "acceptsMarkdown"
  }
  // PDF.js eval support allows malicious PDFs to execute embedded JavaScript.
  flag code.PdfJsEvalSupported on any {
    path "__object_literal"
    has "isEvalSupported=true"
  }
  // Default relay/proxy URL builders that embed caller URL/token metadata into
  // a hardcoded fallback host need trust-boundary review.
  flag code.DefaultExternalRelaySecretExposure in function {
    lang "javascript"
    name "buildRelayUrl"
    has "herokuapp.com"
    has "encodeURIComponent(gurl)"
    has "token"
    lacks "configuredRelayHost"
  }

  // weak randomness (CWE-330) — presence of Math.random() (non-crypto PRNG).
  // crypto.randomBytes / randomUUID (CSPRNG) are deliberately NOT marked.
  flag code.WeakRandomValue on any {
    path "Math.random"
  }

  // TLS cert validation disabled (CWE-295) — rejectUnauthorized:false
  flag code.CertValidationDisabled on any {
    path "https.request"
    has "rejectUnauthorized=false"
  }
  flag code.CertValidationDisabled on any {
    path "https.get"
    has "rejectUnauthorized=false"
  }
  flag code.CertValidationDisabled on any {
    path "https.Agent"
    has "rejectUnauthorized=false"
  }
  flag code.CertValidationDisabled on any {
    path "tls.connect"
    has "rejectUnauthorized=false"
  }
  flag code.UnboundedResourceOperation in function {
    has "responseBuffer.push(chunk)"
    has "Buffer.concat(responseBuffer).length>config.maxContentLength"
    lacks "stream.destroy()"
  }
  flag code.UnboundedDelimiterSplitCount in function {
    lang "javascript"
    has "body.split('&').length"
    has "len>limit?undefined:len-1"
    lacks "indexOf('&'"
  }
  flag code.ZeroStepSequenceExpansion in function {
    lang "javascript"
    has "Math.abs(numeric(n[2]))"
    has "test(i,y)"
    has "i+=incr"
    lacks "Math.max(Math.abs(numeric(n[2])),1)"
  }
  flag code.FoldedHeaderContinuationCrash in function {
    lang "javascript"
    has "this.buffer.split(RE_CRLF)"
    has "lines[i][0]"
    has "RE_HDR.exec(lines[i])"
    has "this.header[h]"
    has "lines[i]"
    lacks "if(h)"
    lacks "if(h!==undefined)"
    lacks "if(h!=null)"
  }
  flag code.ResourceHandle on any {
    path "fs.openSync"
  }
  flag code.ResourceHandle on any {
    path "fs.open"
  }
  control "fs.closeSync" -> core.ResourceRelease
  control "fs.close" -> core.ResourceRelease
  flag code.UnstoppedLimitedStream in function {
    has "maxContentLength"
    has "Buffer.concat(responseBuffer).length>config.maxContentLength"
    has "reject(createError"
    lacks "stream.destroy"
  }
  flag code.ProtocolStateReview in function {
    name "processMessage"
    has "protocolMsg"
    has "HISTORY_SYNC_NOTIFICATION"
    has "APP_STATE_SYNC_KEY_SHARE"
    has "PEER_DATA_OPERATION_REQUEST_RESPONSE_MESSAGE"
    lacks "SELF_ONLY_TYPES.has(protocolMsg.type)&&!message.key.fromMe"
  }
  flag code.RemoteListingDownloadPath in function {
    has "_downloadFromWorkingDir"
    has "join(localDirPath,file.name)"
    has "downloadTo(localPath,file.name)"
    lacks "basename(file.name)"
  }
  flag code.BrowserlessWorkspaceFilePathTraversal in function {
    name "<lambda>"
    has "req.params[0]"
    has "path.join(workspaceDir,file)"
    has "res.sendFile(filePath"
    lacks "filePath.includes(workspaceDir)"
  }
  flag code.BrowserlessWorkspaceFilePathTraversal in function {
    name "<lambda>"
    has "req.params[0]"
    has "path.join(workspaceDir,file)"
    has "rimraf(filePath"
    lacks "filePath.includes(workspaceDir)"
  }
  flag code.ClaspRemoteFilePathTraversal in function {
    name "fetchRemote"
    has "script.projects.getContent"
    has "response.data.files"
    has "f.name"
    has "path.resolve(contentDir"
    lacks "isInside"
  }
  flag code.UnvalidatedDynamicRequirePathTraversal in function {
    lang "javascript"
    name "runWidget"
    has "widgetId"
    has "widget-${widgetId}.js"
    has "path.join(__dirname,file)"
    has "require(path.join(__dirname,file))"
    lacks "resolveWidgetPath"
    lacks "path.relative"
    lacks "widgetIdPattern"
  }
  flag code.ClientAuthFailureResponseReview in function {
    name "<lambda>"
    has "callbackData.hasOwnProperty(\"status\")"
    has "data.status==-1"
    has "callbackFun(callbackData)"
    lacks "callbackData.status==-1"
  }
  flag code.IdorPolicyReview in function {
    has "prisma.accounts.update"
    has "where:{id}"
    has "passwordHash"
    has "originalPassword"
    lacks "currentUserId"
    lacks "ctx.id"
  }

  // JWT signature not verified (CWE-347) — jsonwebtoken alg none
  flag code.JwtUnverified on any {
    path "jwt.verify"
    fact algorithms "none"
  }
  flag code.JwtUnverified on any {
    path "jwt.sign"
    fact algorithm "none"
  }
  // explicit CSRF middleware disablement.
  flag code.CsrfDisabled on any {
    path "lusca.csrf"
    has "false"
  }
  flag code.CsrfDisabled on any {
    path "csrfProtection"
    has "false"
  }

  // cleartext channel (CWE-319) — http:// URL to an HTTP client, excluding loopback
  // dev traffic (127.0.x); still FP-prone for other internal hosts → low sev.
  flag code.CleartextChannel on any {
    path "axios"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "fetch"
    has "http://"
    lacks "127.0"
    lacks "localhost"
  }
  flag code.CleartextChannel on any {
    path "URL"
    has "http://"
    lacks "127.0"
    lacks "localhost"
  }
  flag code.CleartextChannel on any {
    path "node:url.URL"
    has "http://"
    lacks "127.0"
    lacks "localhost"
  }
  flag code.InsecureExecutableDownload in module {
    lang "javascript"
    has "jrePrefix"
    has "OpenJDK-JRE"
    has "http://bundled-openjdk-jre"
    has "download(jreUrl,jreTempFile"
    has "http.request"
    lacks "https://storage.googleapis.com"
  }
  // Reconstructing a browser Request while copying headers but dropping redirect policy
  // can turn caller-specified `redirect: "error"` into the default follow behavior.
  sink method "newRequest" arg 1 collection val "headers" nval "redirect" -> code.RequestPolicyStripped

  // insecure cookie (CWE-614) — a security flag EXPLICITLY disabled (omission not flagged).
  flag code.InsecureCookie on any {
    path "res.cookie"
    has "httpOnly=false"
  }
  flag code.InsecureCookie on any {
    path "res.cookie"
    not fact secure "true"
  }

  // permissive CORS (CWE-942) — ACAO header set to "*" (multi-val: name AND wildcard)
  flag code.PermissiveCors on any {
    path "res.header"
    has "Access-Control-Allow-Origin"
    has "*"
  }
  flag code.PermissiveCors on any {
    path "res.set"
    has "Access-Control-Allow-Origin"
    has "*"
  }
  flag code.PermissiveCors on any {
    path "res.setHeader"
    has "Access-Control-Allow-Origin"
    has "*"
  }

  // clickjacking (CWE-1021) — frame protection EXPLICITLY disabled (omission not flagged):
  // X-Frame-Options: ALLOWALL, or helmet frameguard turned off.
  flag code.MissingFrameProtection on any {
    path "res.setHeader"
    has "X-Frame-Options"
    has "ALLOWALL"
  }
  flag code.MissingFrameProtection on any {
    path "res.set"
    has "X-Frame-Options"
    has "ALLOWALL"
  }
  flag code.MissingFrameProtection on any {
    path "res.header"
    has "X-Frame-Options"
    has "ALLOWALL"
  }
  flag code.MissingFrameProtection on any {
    path "helmet"
    has "frameguard=false"
  }

  // character-filtering replace(/regex/g, repl): the engine analyzes the output
  // alphabet (charfilter.go) -> sound sanitizer where it excludes the sink excluded_chars.
  filter method "replace"

  // sqlite3 / better-sqlite3 — db.all/get/each/run/exec/prepare(sql, …). A non-SQL
  // collection arg0 (Promise.all([...])) is a Seq and is skipped by the sink matcher.
  sink method "all" -> code.SqlExecution
  sink method "get" -> code.SqlExecution
  sink method "each" -> code.SqlExecution
  sink method "exec" -> code.SqlExecution
  sink method "prepare" -> code.SqlExecution

  // xpath (npm xpath) — the expression is arg0.
  sink path "xpath.select" -> code.XpathQuery
  sink path "xpath.select1" -> code.XpathQuery
  sink path "xpath.evaluate" -> code.XpathQuery

  // ldapjs — client.search(base, {filter}, cb): the filter rides in the options object (arg1).
  sink method "search" arg 1 collection -> code.LdapQuery

  // trust boundary (CWE-501) — untrusted data written into a trust context object
  // (req.session.* / req.securityContext.* / req.authContext.*). These lower to member-
  // write path sinks; the taint requirement means only user-controlled values fire.
  sink path "session" -> code.TrustBoundary
  sink path "securityContext" -> code.TrustBoundary
  sink path "authContext" -> code.TrustBoundary
  // Object.assign(trustContext, { k: untrusted }) — the source object (arg1+) carries taint.
  sink path "Object.assign" arg all collection -> code.TrustBoundary
}
