  // controls (sanitizers/validators) — neutralize a flow that passes through them
  // numeric coercion bounds output to digits/sign/dot/exponent — no HTML/SQL metachar can
  // survive, so it neutralizes injection (sound; FN-safe — only the coerced flow is killed).
  control "Number" -> core.HtmlEscape
  control "Number" -> core.SqlParameterization
  control "parseInt" -> core.HtmlEscape
  control "parseInt" -> core.SqlParameterization
  control "parseFloat" -> core.HtmlEscape
  control "parseFloat" -> core.SqlParameterization
