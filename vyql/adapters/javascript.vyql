// javascript framework adapter (docs/07) — framework→concept content.
// frameworks: express, koa, fastify, hapi, nestjs, nextjs, restify, sails
adapter javascript {
  meta { fidelity: resolved }

  source "process.argv" -> code.CliArgument
  // Public-API params are now handled by the cross-language library param-source
  // (FuncDef.Exported -> code.ExternalEntryInput, library-profile-gated, caller-conditional;
  // see adapters/library.vyql). The old ungated public_api_input seed was retired.
  // Library option bags are caller-controlled under the library profile. These option
  // fields have appeared in code-generation CVEs where the public API reaches an internal
  // compiler callback through a cache/helper the analyzer cannot inline.
  source "options.pattern" -> code.PatternOptionInput
  source "options.timezone" -> core.UserControlledData
  source "config.timezone" -> core.UserControlledData
  source path "analysis.parameter.entry" val "decorator_method:Get" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:Post" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:Put" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:Delete" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:Patch" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:Options" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:Head" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:All" -> code.HttpInput
  source path "analysis.parameter.entry" val "entry_kind:call_lambda_param" val "call_path:ipcMain" val "call_method:on" nval "param_index:0" -> code.HttpInput
  source path "analysis.parameter.entry" val "entry_kind:call_lambda_param" val "call_path:ipcMain" val "call_method:handle" nval "param_index:0" -> code.HttpInput
  source path "analysis.parameter.entry" val "entry_kind:call_lambda_param" val "call_path:ipcMain" val "call_method:once" nval "param_index:0" -> code.HttpInput
  source path "analysis.parameter.entry" val "entry_kind:call_lambda_param" val "call_path:ipcRenderer" val "call_method:on" nval "param_index:0" -> code.HttpInput
  source path "analysis.parameter.entry" val "entry_kind:call_lambda_param" val "call_path:ipcRenderer" val "call_method:once" nval "param_index:0" -> code.HttpInput
  source "req.body" -> code.HttpInput
  source "req.query" -> code.HttpInput
  source "req.params" -> code.HttpInput
  source "req.headers" -> code.HttpInput
  source "req.cookies" -> code.HttpInput
  source "req.signedCookies" -> code.HttpInput
  source "file.filename" -> code.FileUpload
  source "req.get" -> code.HttpInput
  source "req.header" -> code.HttpInput
  source "req.param" -> code.HttpInput
  source "req.files" -> code.HttpInput
  source "file.name" -> code.FileUpload
  source "req.file" -> code.FileUpload
  source "req.files" -> code.FileUpload
  source "req.rawBody" -> code.HttpInput
  source "req.url" -> code.HttpInput
  source "req.path" -> code.HttpInput
  source "req.originalUrl" -> code.HttpInput
  source "req.method" -> code.HttpInput
  source "request.body" -> code.HttpInput
  source "request.query" -> code.HttpInput
  source "request.params" -> code.HttpInput
  source "request.headers" -> code.HttpInput
  source "err.message" -> code.HttpInput
  source "request.payload" -> code.HttpInput
  source "request.state" -> code.HttpInput
  source "request.cookies" -> code.HttpInput
  source "ctx.request.body" -> code.HttpInput
  source "ctx.query" -> code.HttpInput
  source "ctx.params" -> code.HttpInput
  source "ctx.request.query" -> code.HttpInput
  source "ctx.cookies.get" -> code.HttpInput
  source "ctx.headers" -> code.HttpInput
  source "ctx.request.headers" -> code.HttpInput
  source "ctx.request.querystring" -> code.HttpInput
  source "event.headers" -> code.HttpInput
  source "event.multiValueHeaders" -> code.HttpInput
  source "event.queryStringParameters" -> code.HttpInput
  source "event.pathParameters" -> code.HttpInput
  source "event.body" -> code.HttpInput
  // Build/CI environment variables are operator-controlled input; when concatenated
  // into shell-plugin script strings they become command injection input.
  source "process.env.NODE_ENV" -> core.UserControlledData
  source "process.env" -> code.SecretValue
  // Parsed output from a shell command is external platform state. If a later
  // shell command interpolates one of those parsed values, it is command input.
  source path "execSync.toString.split.map" -> code.StoredDataRead
  source path "child_process.execSync.toString.split.map" -> code.StoredDataRead
  source path "cp.execSync.toString.split.map" -> code.StoredDataRead
  // vm2-style bridge boundary: arguments crossing from sandbox realm into host
  // function application are attacker-controlled by sandbox code.
  source "otherFromThisArguments" -> core.UserControlledData

  flag code.NuxtPublicRuntimeConfigSecretExposure in module {
    call path "defineNuxtModule"
    literal "public_runtime_secret_config"
  }

  // Browser / SPA DOM entry points (attacker-controlled URL / storage / window state)
  source "location.search" -> code.DomInput
  source "location.hash" -> code.DomInput
  source "location.href" -> code.DomInput
  source "location.pathname" -> code.DomInput
  source "window.location" -> code.DomInput
  source "window.location.search" -> code.DomInput
  source "window.location.hash" -> code.DomInput
  source "window.location.href" -> code.DomInput
  source "getPageQuery" -> code.DomInput
  source "document.location" -> code.DomInput
  source "document.URL" -> code.DomInput
  source "document.documentURI" -> code.DomInput
  source "document.referrer" -> code.DomInput
  source "window.name" -> code.DomInput
  source "localStorage.getItem" -> code.DomInput
  source "sessionStorage.getItem" -> code.DomInput
  source "document.cookie" -> code.DomInput
  // Browser fetch/Response payloads are external data. SPAs often store parsed JSON
  // in a client model and later render model fields into the DOM.
  source "response.json" -> code.DomInput
  source "res.json" -> code.DomInput
  source path "analysis.parameter.entry" val "entry_kind:call_lambda_param" val "call_method:getJSON" -> code.DomInput
  source path "analysis.parameter.entry" val "entry_kind:call_lambda_param" val "call_method:ajax" -> code.DomInput
  source path "analysis.parameter.entry" val "entry_kind:call_lambda_param" val "call_method:get" -> code.DomInput
  source path "analysis.parameter.entry" val "entry_kind:call_lambda_param" val "call_method:post" -> code.DomInput
  source path "analysis.parameter.entry" val "entry_kind:call_lambda_param" val "call_method:jsonWrapper" -> code.DomInput
  source path "analysis.parameter.entry" val "entry_kind:call_lambda_param" val "call_method:fetchJson" -> code.DomInput
  source path "analysis.parameter.entry" val "entry_kind:call_lambda_param" val "call_method:fetchJSON" -> code.DomInput
  source path "analysis.parameter.entry" val "entry_kind:global_function_assignment" -> code.DomInput
  source "queryParams" -> code.DomInput
  // jQuery data-* reads can carry server/user-controlled DOM content into client-side HTML.
  source method "data" -> code.DomInput
  // Browser UI helper option bags can be populated from attacker-controlled markup/URLs.
  source "opt.title" -> code.DomInput
  // Tooltip title metadata is copied from attacker-controlled DOM attributes in common
  // Bootstrap-style helpers, then often measured/rendered through HTML sinks.
  source method "originalTitle" -> code.DomInput
  source method "tooltipTitle" -> code.DomInput
  // Parsed browser XML/HTML often comes from network responses; values extracted from it
  // are attacker-controlled unless independently verified.
  source method "parseFromString" -> core.UserControlledData
  flag code.StoredHtmlWrite in function {
    lang "javascript"
    call path "copyIn"
    selector "file.path"
    selector "info.extension"
    not call path "sanitizeSvg"
    not call path "DOMPurify"
  }
  flag code.UnescapedHtmlOptionRenderer in function {
    lang "javascript"
    call path "newTomSelect"
    identifier "directoryName"
    literal "<"
    not call path "sanitizeDirectoryName"
    not selector "textContent"
    not selector "innerHTML"
  }
  flag code.UnescapedHtmlOptionRenderer in function {
    lang "javascript"
    call path "getAttribute"
    literal "data-content"
    identifier "optionContent"
    selector "innerHTML"
    call path "appendChild"
    not call path "sanitizeHtml"
    not call path "DOMPurify"
    not literal "sanitize-html"
  }
  flag code.HighlightedSearchResultHtmlEscapeMissing on any {
    path exact "analysis.function.context"
    lang "javascript"
    name "search"
    call path "ignoreDiacriticalMarks"
    literal "search-keyword"
    identifier "matchingPost"
    not call path "escapeHtml"
  }
  flag code.UnescapedTableExportHtml in module {
    lang "javascript"
    identifier "onCellHtmlData"
    identifier "htmlData"
    call path "tableExport"
    token prop "escape=false"
    not token prop "escape=true"
    not call path "cell.text"
  }
  flag code.UnescapedHtmlPresenter in module {
    lang "javascript"
    token prop "presentType=html"
    call path "present"
    call path "Utils.printable"
    literal "<td>${value}</td>"
    not call path "Utils.escapeHtml"
    not call path "DOMPurify"
  }
  flag code.UninitializedBufferExposure in module {
    lang "javascript"
    selector "name.encode"
    call path "Buffer.allocUnsafe"
    call path "name.encodingLength"
    call path "str.replace"
    selector "name.encodingLength"
    call path "Buffer.byteLength"
    not call arg "Buffer.byteLength:n.replace"
  }
  flag code.UnescapedChartTooltipHtml in function {
    lang "javascript"
    selector "tooltipModel.body"
    selector "tooltipModel.labelColors"
    call path "generateTooltipContent"
    selector "innerHTML"
    not call path "replaceChildren"
    not selector "textContent"
  }
  flag code.UnescapedChartTooltipDataName in function {
    lang "javascript"
    name "formatTooltip"
    call arg "itemModel.get:name"
    identifier "name"
    call arg "createTooltipMarkup:nameValue"
    not token prop "name=itemName"
    not call arg "encodeHTML:name"
    not call arg "escapeHTML:name"
    not call arg "escapeHtml:name"
  }
  flag code.DropdownEntryLabelInnerHtmlXss in function {
    lang "javascript"
    name "addDropDownEntry"
    selector "li.innerHTML"
    literal "dropdown-item"
    identifier "label"
    not call arg "sanitizeHTML:label"
    not selector "textContent"
  }
  flag code.PrivilegedContainer in function {
    lang "javascript"
    literal contains_any ["docker run -dt", "dockerrun-dt"]
    literal contains_any ["--privileged=true", "--cap-add SYS_ADMIN", "--cap-addSYS_ADMIN", "--device /dev/fuse", "--device/dev/fuse"]
    call path "exec"
    not selector "appConfig.capabilities"
    not literal "--privileged=false"
  }
  flag code.DefaultPermissiveCorsConfig in module {
    lang "javascript"
    token prop "CORS_ENABLED=true"
    token prop "CORS_ORIGIN=true"
    not token prop "CORS_ENABLED=false"
    not token prop "CORS_ORIGIN=false"
  }
  flag code.WebSocketUpgradeMissingOriginCheck in class {
    lang "javascript"
    token prop "noServer=true"
    call "handleUpgrade"
    call "bind"
    token literal "sec-websocket-protocol"
    not selector contains_any ["headers.origin", ".origin"]
    not literal contains_any ["origin", "Origin"]
  }
  flag code.PostMessageHtmlWriteMissingOriginCheck in function {
    lang "javascript"
    selector "message.data"
    call path contains_any ["document.write", "parseFromString"]
    selector contains "innerHTML"
    not selector contains_any ["message.origin", "event.origin", ".origin"]
    not literal contains_any ["origin", "Origin"]
  }
  flag code.IncompleteHtmlEventHandlerStrip in module {
    lang "javascript"
    has "ViewSource"
    has "stripScripts"
    has "stripIFrames"
    has "stripComments"
    has "_stripScripts"
    has "_stripIFrames"
    has "_filter"
    lacks "stripEventHandlers"
    lacks "_stripEventHandlers"
  }
  flag code.ClientLightboxOptionXss in module {
    lang "javascript"
    has "setHTMLContent"
    has "setMessage(html)"
    lacks "DOMPurify"
    lacks "sanitize(html)"
    lacks "sanitizeHtml(html)"
  }
  flag code.ClientLightboxOptionXss in module {
    lang "javascript"
    has "setVideoContent"
    has "options.videoParams"
    has "$('<video>',videoParams)"
    lacks "startsWith('on')"
    lacks "startsWith(\"on\")"
    lacks "deletevideoParams[key]"
  }
  flag code.ClientLightboxOptionXss in module {
    lang "javascript"
    has "setSlideshowContent"
    has "options.slides.forEach"
    has "data-elementor-slideshow-video"
    has "slide.image"
    lacks "isValidUrl"
    lacks "startsWith(protocol)"
  }
  flag code.AjaxBackslashProtocolRelativeUrlXss in module {
    lang "javascript"
    has "function ajax(url, handler)"
    has "url[0] != '/'"
    has "url[1] == '/'"
    has "$.ajax"
    has "url: url"
    has "$(receivedHtml).find('.paginate-container')"
    has ".append($(this).html())"
    lacks "startsWith"
    lacks "replace(/\\\\/g,'/')"
    lacks "new URL"
  }
  flag code.JobOutputEventUpdateAuthorizationBypass in function {
    literal "Got job update from child"
    literal "update_event"
    assign "job[key]=data[key]"
    not literal "allow_event_updates_from_jobs"
    not selector "data.update_event"
  }
  flag code.PublicVisibilityCacheInvalidationMissing in module {
    lang "javascript"
    has "ProxyCacheInvalidationService"
    has "RUNNER_INFO_CACHE_PREFIX"
    has "SandboxEvents.ARCHIVED"
    has "redis.del"
    lacks "SandboxEvents.PUBLIC_STATUS_UPDATED"
    lacks "PUBLIC_CACHE_PREFIX"
  }
  flag code.EcdhPeerPublicKeyMissingCurveValidation in function {
    lang "javascript"
    name "deriveSharedSecret"
    has "publicKey.Q.multiply(this.d)"
    has "zeroBuffer(S.getX().toBigInteger().toString(16),this._size)"
    lacks "onCurve(publicKey)"
    lacks "validatePublicKey(publicKey)"
    lacks "isOnCurve(publicKey)"
  }
  flag code.TotalJsAdminThemeXss in module {
    lang "javascript"
    has "COMPONENT('grid'"
    has "column.format"
    has "m.value=column.template?column.template(items[i],column):column.render?column.render(val,column,items[i]):val==null?'':(column.format?val.format(column.format):val)"
    has "builder.push(self.template(m,column))"
    lacks "Thelpers.encode((column.format?val.format(column.format):val))"
  }
  flag code.UnescapedLinterIssueMessageXss in function {
    lang "javascript"
    name "renderIssue"
    has "issueTemplate({"
    has "message:message.message"
    lacks "message:_.escape(message.message)"
  }
  flag code.CocotaisEchoPlatformTagInjection in module {
    lang "javascript"
    token builtin "echo"
    has "\"/echo\""
    has "_msgs.join(\" \")"
    has "event.reply(content)"
  }
  flag code.ArchiveSymlinkFilterBypass in module {
    lang "javascript"
    has "tar.extract"
    token ignore "isSymlink"
    has "functionisSymlink(entry)"
    has "entry.type==='SymbolicLink'"
    lacks "functionisSymlink(_,entry)"
    lacks "entry.type==='symlink'"
  }
  flag code.FlarumTranslatorRawStringParameterXss in function {
    lang "javascript"
    name "preprocessParameters"
    has "if('user'inparameters)"
    has "extract(parameters,'user')"
    has "parameters.username"
    has "returnparameters;"
    lacks "escapedParameters"
    lacks "typeofparamValue==='string'"
    lacks "<>{parameters[param]}</>"
  }
  // Next.js App Router — searchParams (page prop / destructured) + nextUrl query
  source "searchParams" -> code.HttpInput
  source "req.nextUrl" -> code.HttpInput
  source "request.nextUrl" -> code.HttpInput

  sink method "query" -> code.SqlExecution
  sink method "raw" -> code.SqlExecution
  sink method "execute" -> code.SqlExecution
  sink method "unprepared" -> code.SqlExecution
  // Prisma raw (CWE-89) — $queryRawUnsafe/$executeRawUnsafe take a raw string
  sink method "$queryRaw" -> code.SqlExecution
  sink method "$queryRawUnsafe" -> code.SqlExecution
  sink method "$executeRaw" -> code.SqlExecution
  sink method "$executeRawUnsafe" -> code.SqlExecution
  // Sequelize.literal injects raw SQL into a query
  sink method "literal" -> code.SqlExecution
  sink path "sequelize.query" -> code.SqlExecution
  sink path "knex.raw" -> code.SqlExecution
  sink path "connection.query" -> code.SqlExecution
  sink path "pool.query" -> code.SqlExecution
  sink path "db.query" -> code.SqlExecution
  // ueberDB key-glob read: db.findKeys("pad:"+id+"*") — an unsanitized id in the key pattern
  // reads keys outside the intended namespace (CWE-22-style traversal of the kv store).
  sink method "findKeys" -> code.FilePathAccess
  flag code.PrefixWildcardKeyEnumeration in function {
    lang "javascript"
    has "db.findKeys(\"pad:\"+padId+\"*\""
    has "db.get(records[key]"
    lacks "\"pad:\"+padId+\":*\""
  }
  sink path "client.query" -> code.SqlExecution
  sink path "mysql.query" -> code.SqlExecution
  sink path "pg.query" -> code.SqlExecution
  sink path "sql.query" -> code.SqlExecution
  // CSRF (CWE-352, RF-003) — security-sensitive state-changing operations (low-FP scope)
  sink method "changePassword" -> code.StateChangingOp
  sink method "updatePassword" -> code.StateChangingOp
  sink method "resetPassword" -> code.StateChangingOp
  sink method "changeEmail" -> code.StateChangingOp
  sink method "transferFunds" -> code.StateChangingOp
  sink method "deleteAccount" -> code.StateChangingOp
  sink method "grantRole" -> code.StateChangingOp
  sink method "makeAdmin" -> code.StateChangingOp
  flag code.AuthenticationRequiredOp on any {
    path "changePassword"
  }
  flag code.AuthenticationRequiredOp on any {
    path "updatePassword"
  }
  flag code.AuthenticationRequiredOp on any {
    path "resetPassword"
  }
  flag code.AuthenticationRequiredOp on any {
    path "changeEmail"
  }
  flag code.AuthenticationRequiredOp on any {
    path "transferFunds"
  }
  flag code.AuthenticationRequiredOp on any {
    path "deleteAccount"
  }
  flag code.AuthenticationRequiredOp on any {
    path "grantRole"
  }
  flag code.AuthenticationRequiredOp on any {
    path "makeAdmin"
  }
  flag code.RefererBasedAdminUserCreation in function {
    lang "javascript"
    call path "req.header"
    call path "url.parse"
    literal "Referer"
    literal "/admin/setup"
    selector "urlParts.path"
    assign "isAdmin=true"
    call path "db.users.insert"
    lacks call path "db.users.count"
  }
  flag code.ExpressParamArrayValuePollution in function {
    lang "javascript"
    selector "req.params"
    selector "req.body"
    selector "req.query"
    lacks call path "Array.isArray"
  }
  flag code.BrowserPostExportMissingOriginGuard in function {
    lang "javascript"
    name "<lambda>"
    call path "app.post"
    selector "req.body.path"
    call path "exportAll"
    not selector "req.headers.origin"
    not call contains_any ["verifyCsrfToken", "validateCsrfToken", "checkCsrf", "csrf"]
  }
  flag code.WebhookUrlFetchMissingSsrfGuard in function {
    lang "javascript"
    name contains_any ["callWebhook", "sendWebhook", "deliverWebhook", "postWebhook"]
    call path contains_any ["axios.post", "axios.request", "request.post", "undici.fetch", "fetch"]
    selector contains_any ["webhookUrl.url", "webhook.url", "callbackUrl", "callback.url"]
    not token identifier "secureDispatcher"
    not call contains_any ["safeFetch", "fetchWithSsrfGuard", "validateUrl", "assertPublicUrl"]
  }
  // CSRF protection — explicit token verification (guards RF-003 via a PROTECTS edge)
  control "verifyCsrfToken" -> core.CsrfProtection
  control "validateCsrfToken" -> core.CsrfProtection
  control "requireAuth" -> core.AuthenticationCheck
  control "ensureAuthenticated" -> core.AuthenticationCheck
  control "isAuthenticated" -> core.AuthenticationCheck
  control "authenticate" -> core.AuthenticationCheck
  // authorization checks (guards BIZ-001) — path-sensitive via B1.
  control "checkPermission" -> core.AuthorizationCheck
  control "hasPermission" -> core.AuthorizationCheck
  control "ability.can" -> core.AuthorizationCheck
  control "checkOwnership" -> core.OwnershipCheck
  control "requireOwner" -> core.OwnershipCheck
  control "isOwner" -> core.OwnershipCheck
  control "ownsResource" -> core.OwnershipCheck
  flag code.LocalRequestBypassReview in function {
    has "isLocalRequest"
    has "isLocal||awaithasValidToken"
    lacks "hasValidCliToken"
  }
  flag code.AccessPolicyReview in function {
    lang "javascript"
    has "authorized_keys?.includes(data.pubkey)"
    has "private_keys[data.pubkey]"
    has "!noscraper"
    lacks "pubkeyInConfig"
    lacks "authorized_keys?.length&&!pubkeyInConfig"
  }
  flag code.SecretComparisonReview in function {
    lang "javascript"
    call path "secure-compare"
    call path "keys.findIndex"
  }
  flag code.SecretComparisonReview on binop {
    op any ["==", "==="]
    operand {
      identifier contains_any ["token", "secret", "signature", "key", "password", "pass", "username", "user"]
    }
    operand {
      identifier contains_any ["token", "secret", "signature", "key", "password", "pass", "username", "user"]
    }
    lacks call contains_any ["scmp", "tsscmp", "timingSafeEqual", "safeCompare", "timingSafeCompare"]
  }
  flag code.SecretComparisonReview on binop {
    op any ["==", "==="]
    operand {
      key contains_any ["csrf-token", "x-csrf-token", "xsrf-token", "auth-token", "api-key", "signature", "secret"]
    }
    operand {
      identifier contains_any ["token", "secret", "signature", "key", "password", "pass"]
    }
    lacks call contains_any ["scmp", "tsscmp", "timingSafeEqual", "safeCompare"]
  }
  // SSRF / open-redirect allowlist validators (guard the fetch/redirect they dominate).
  flag code.MethodGatedRedirectValidationBypass in function {
    lang "javascript"
    selector contains_any ["ctx.request.method", "ctx.request?.method"]
    literal "POST"
    identifier "callbackURL"
    identifier "redirectTo"
    identifier "trustedOrigins"
    call path "validateURL"
  }
  flag code.CinnyServiceWorkerMediaAuthLeak in function {
    lang "javascript"
    call path "event.respondWith"
    call path "askForAccessToken"
    call path "fetchConfig"
    literal "/_matrix/client/v1/media/download"
    literal "/_matrix/client/v1/media/thumbnail"
    not call path "validMediaRequest"
  }
  flag code.IncompleteIpDenylist in function {
    lang "javascript"
    name "isValidPublicIPv4Address"
    call path "parseInt"
    expr "first===10"
    expr "first===127"
    expr "first===169&&second===254"
    expr "first===172&&second>=16&&second<=31"
    expr "first===192&&second===168"
  }
  flag code.CkeditorStaticProtectedSourceTokenBypass in function {
    lang "javascript"
    name "protectSource"
    has "protectedHtml"
    has "cke_tempcomment"
    has "/cke_temp(comment)?/"
    has "'<!--{cke_temp}'"
    lacks "randomNumber"
    lacks "cke_temp_"
  }
  flag code.CkeditorRawElementLiveDocumentRenderXss in function {
    lang "javascript"
    name "viewToPlainText"
    has "viewItem.is('rawElement')"
    has "document.createElement('div')"
    has "viewItem.render(tempElement,converter)"
    has "domElementToPlainText(tempElement)"
    lacks "createHTMLDocument"
  }
  flag code.CodeServerPathProxyPortConfusedProxy in function {
    lang "javascript"
    name "getProxyTarget"
    has "req.params.port"
    has "0.0.0.0:"
    has "req.originalUrl.slice(base.length)"
    lacks "parseInt(req.params.port,10)"
  }
  flag code.JavaScriptUrlRedirectXss in function {
    lang "javascript"
    has "URLSearchParams(window.location.search).get"
    has "window.location=decodeURI"
    lacks "redirect[0]==='/'"
    lacks "redirect[1]!=='/'"
  }
  control "isSafeRedirect" -> core.RedirectAllowlist
  control "isValidRedirect" -> core.RedirectAllowlist
  control "isAllowedRedirect" -> core.RedirectAllowlist
  control "isUrlAllowed" -> core.AllowlistValidation
  control "isAllowedHost" -> core.AllowlistValidation
  control "validateUrl" -> core.AllowlistValidation
  control "validateFetchUrl" -> core.AllowlistValidation
  control "isUrlSafeToOpen" -> core.AllowlistValidation
  flag code.ExternalResourceIntegrityReview in function {
    name "updateDynamicPageSriHashes"
    has "integrityRegex.exec(attrs)"
    has "globalHashes[t2].set(src,sriHash)"
    lacks "Detected reference to not explicitly allowed external resource"
  }
  // Electron: shell.openExternal can launch arbitrary apps/protocols from a URL
  sink path "shell.openExternal" -> code.CommandExecution
  // React Native CLI's development-server URL opener passed request body `url`
  // directly to the OS browser opener before CVE-2025-11953 added protocol checks.
  flag code.ReactNativeCliOpenUrlMiddlewareCommandExecution in function {
    lang "javascript"
