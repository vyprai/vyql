module bindings.ruby.migration.m5a48bf47;

binding rubyFfiWindowsPosixLibrarySearchPath209 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "call_path:FFI.DynamicLibrary.open" and node.token contains "lang=ruby" and node.token contains "function_name:ffi_lib" and node.token contains "call_path:File.exist?" and node.token contains "literal:/usr/lib/" and node.token contains "literal:/usr/local/lib/" and not (node.token contains "call_path:FFI.Platform.windows?")
