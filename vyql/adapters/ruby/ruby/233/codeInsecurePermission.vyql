module bindings.ruby.migration.m5a48bf47;

binding insecurePermission233 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "File.chmod" and node.token contains "0777"
  emit issue code.InsecurePermission at node
}
