module bindings.ruby.migration.m5a48bf47;

binding certValidationDisabled230 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=ruby" and node.token contains "SSLContext.new" and node.token contains "ca_file" and not (node.token contains "verify_mode")
  emit issue code.CertValidationDisabled at node
}
