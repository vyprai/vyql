binding certValidationDisabled232 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=ruby" and node.token contains "call_path:Fog.Kubevirt.Compute.new" and node.token contains "field:kubevirt_verify_ssl=ca_cert.present?" and not (node.token contains "field:kubevirt_verify_ssl=true")
  emit issue code.CertValidationDisabled at node
}
