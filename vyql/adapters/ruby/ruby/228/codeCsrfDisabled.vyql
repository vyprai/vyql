module bindings.ruby.migration.m5a48bf47;

binding csrfDisabled228 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "skip_before_action" and node.token contains "verify_authenticity_token"
  emit issue code.CsrfDisabled at node
}
