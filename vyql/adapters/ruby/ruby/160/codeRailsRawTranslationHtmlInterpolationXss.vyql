  query unstable.legacyFlag as node where node.kind == "call" and node.path ~= "raw" and not (containsAny(node.scopeCall.any, [content_tag, "ERB::Util.html_escape", "ERB::Util.h", CGI.escapeHTML, Rack.Utils.escape_html])) and operand(node, where: operand.path ~= "t")
