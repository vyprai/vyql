module bindings.ruby.migration.m5a48bf47;

binding jwtUnverified225 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "JWT.decode" and node.token contains "false"
  emit issue code.JwtUnverified at node
}
