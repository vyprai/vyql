module bindings.ruby.migration.m5a48bf47;

binding hardcodedSecret25 {
  query pattern presenceNode where node.scope == "module" and node.token contains "lang=ruby" and containsAny(node.token, ["assign:config.secret_token="]) and not (containsAny(node.token, ["assign:config.secret_token=ENV", "assign:config.secret_token=Rails.application.credentials", "assign:config.secret_token=credentials"])) and not (node.token contains "expr:Rails.env=='test'") and not (node.token contains "call_path:ENV.fetch") and not (node.token contains "call_path:ENV.[]") and not (node.token contains "call_path:SecureRandom.hex")
  emit issue code.HardcodedSecret at node
}
