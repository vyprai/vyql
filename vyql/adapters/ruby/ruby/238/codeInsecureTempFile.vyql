module bindings.ruby.migration.m5a48bf47;

binding insecureTempFile238 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "File.open" and node.token contains "/tmp/" and node.token contains "w"
  emit issue code.InsecureTempFile at node
}
