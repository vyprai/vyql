module bindings.ruby.migration.m5a48bf47;

binding polymorphicTypeSelectionReview249 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=ruby" and node.token contains "polymorphic_as" and node.token contains "_type=" and node.token contains "params[\"#{polymorphic_as}_type\"]" and node.token contains "model.send" and not (node.token contains "valid_polymorphic_class")
  emit issue code.PolymorphicTypeSelectionReview at node
}
