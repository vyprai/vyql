module bindings.ruby.migration.m5a48bf47;

binding polymorphicTypeSelectionReview249 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=ruby" and node.token contains "polymorphic_as" and node.token contains "_type=" and node.token contains "params[\"#{polymorphic_as}_type\"]" and node.token contains "model.send" and not (node.token contains "valid_polymorphic_class")
  emit issue code.PolymorphicTypeSelectionReview at node
}
