module bindings.ruby.migration.m5a48bf47;

binding catastrophicRegex206 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "module" and node.token contains "lang=ruby" and containsAny(node.token, ["literal:(?:[^\\\"]|\\\\.)*?", "literal:(?:[^\\\"]|\\\\.)*)"]) and not (containsAny(node.token, ["literal:(?:[^\\\"]|\\\\\")*?", "literal:(?:[^\\\"]|\\\\\")*)"]))
  emit issue code.CatastrophicRegex at node
  emit sink code.CatastrophicRegexSink at node
}
