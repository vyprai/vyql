module bindings.ruby.migration.m5a48bf47;

binding storedHtmlWrite161 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=ruby" and node.token contains "name=cama_comments_render_html" and node.token contains "#{comment.content}" and not (node.token contains "sanitize comment.content")
  emit issue code.StoredHtmlWrite at node
}
