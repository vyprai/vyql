module bindings.ruby.migration.m5a48bf47;

binding weakHash223 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "OpenSSL.Digest.MD5"
  emit issue code.WeakHash at node
}
