  sink path "mysqli_query" arg 1 -> code.SqlExecution
  sink path "mysqli_real_query" arg 1 -> code.SqlExecution
  sink path "mysqli_multi_query" arg 1 -> code.SqlExecution
  sink path "mysql_query" -> code.SqlExecution
  sink path "pg_query" arg 1 -> code.SqlExecution
  sink path "sqlite_query" -> code.SqlExecution
  sink path "queryDB" -> code.SqlExecution
  sink path "RunQuery" -> code.SqlExecution
  sink method "query" -> code.SqlExecution
  sink method "exec" -> code.SqlExecution
  sink method "prepare" -> code.SqlExecution
  // WordPress $wpdb raw queries (CWE-89)
  sink method "get_results" -> code.SqlExecution
  sink method "get_var" -> code.SqlExecution
  sink method "get_row" -> code.SqlExecution
  sink method "get_col" -> code.SqlExecution
  source "wp.list_table.row" -> code.DatabaseRead
  source method "get_results" -> code.DatabaseRead
  source method "get_var" -> code.DatabaseRead
  source method "get_row" -> code.DatabaseRead
  source method "get_col" -> code.DatabaseRead
  // Drupal
  sink path "db_query" -> code.SqlExecution
  // Laravel Eloquent / query-builder raw expressions
  sink method "raw" -> code.SqlExecution
  sink method "whereRaw" -> code.SqlExecution
  sink method "havingRaw" -> code.SqlExecution
  sink method "orderByRaw" -> code.SqlExecution
  sink method "selectRaw" -> code.SqlExecution
  // Pimcore listings accept raw SQL condition fragments as arg0; bound values
  // in later args are parameters and should not be treated as executable SQL.
  sink method "addConditionParam" -> code.SqlExecution
  sink path "DB.statement" -> code.SqlExecution
  sink path "DB.select" -> code.SqlExecution
  sink path "DB.raw" -> code.SqlExecution

  // command execution
  sink path "system" -> code.CommandExecution
  sink path "exec" -> code.CommandExecution
  sink path "shell_exec" -> code.CommandExecution
  sink path "passthru" -> code.CommandExecution
  sink path "popen" -> code.CommandExecution
  sink path "proc_open" -> code.CommandExecution
  sink path "pcntl_exec" -> code.CommandExecution

  // code evaluation
  sink path "eval" -> code.CodeEval
  sink path "assert" -> code.CodeEval
  sink path "create_function" arg 1 -> code.CodeEval
  control "preg_replace" val ")\\W*\\w+.*$" -> core.CodeExecutionValidation

  // deserialization
  sink path "unserialize" -> code.Deserialization
  flag code.PhpSimplexmlEntityLoaderXxe in function {
    lang "php"
    has "simplexml_load_string"
    lacks "libxml_disable_entity_loader"
  }

  // file inclusion (include/require modeled as include() call)
  sink path "include" -> code.FileInclude

  // path / file
  sink path "fopen" -> code.FilePathAccess
  sink path "file_get_contents" -> code.FilePathAccess
  sink path "readfile" -> code.FilePathAccess
  sink path "file" -> code.FilePathAccess
  sink path "unlink" -> code.FilePathAccess
  sink path "file_put_contents" -> code.FilePathAccess

  // SSRF
  sink path "curl_exec" -> code.UrlFetch
  sink path "wp_remote_get" -> code.UrlFetch
  sink path "wp_remote_post" -> code.UrlFetch
  sink path "wp_remote_request" -> code.UrlFetch

  // HTTP response splitting / header injection (CWE-113) and log injection (CWE-117).
  sink path "header" -> code.ResponseHeaderWrite
  sink path "overlay_close_dialog" -> code.RedirectTarget
  control "url_is_external" -> core.RedirectAllowlist
  control method "is_safe_url" -> core.AllowlistValidation
  control method "is_safe_host" -> core.AllowlistValidation
  sink path "error_log" arg all -> code.LogOutput
  flag code.LogWrite on any {
    path "error_log"
  }

  // reflected XSS — echo/print modeled as calls
  sink path "echo" -> code.HtmlRender
  sink path "print" -> code.HtmlRender
  sink path "printf" -> code.HtmlRender
  sink path "die" -> code.HtmlRender
  sink path "exit" -> code.HtmlRender
  flag code.BufferedErrorPageRequestMetadataXss in function {
    lang "php"
    has "$out.="
    has "REQUEST_URI"
    has "print$out"
    lacks "dol_htmlentities"
    lacks "htmlentities($_SERVER"
    lacks "htmlspecialchars($_SERVER"
    lacks "html_escape($_SERVER"
  }
  // MediaWiki Html builder: rawElement emits its content arg RAW (unescaped) and both
  // element/rawElement pass the attributes array through WITHOUT validating attribute names,
  // so a tainted attributes array is attribute-injection XSS (CVE-2025-59332; the upstream fix
  // is Sanitizer::validateAttributes). element escapes the content arg, so only its attrs sink.
  sink path "Html.rawElement" -> code.HtmlRender
  sink path "Html.rawElement" arg 1 -> code.HtmlRender
  sink path "Html.rawElement" arg 2 -> code.HtmlRender
  sink path "Html.element" arg 1 -> code.HtmlRender
  sink "wp.list_table.render" -> code.HtmlRender
  // Stored CMS/page HTML writes. Aimeos text reference items are later rendered as page
  // content, so writing editor-controlled HTML through the ref item must be sanitized.
  flag code.StoredHtmlWrite on any {
    path "$refItem.fromArray"
  }
  flag code.GleezRedactorEditorStoredXss on any {
    path exact "self.codes"
    has ".redactor({"
    has "autoresize: false"
  }

  // server-side template injection (CWE-1336) — Twig compiles a STRING template
  sink method "createTemplate" -> code.TemplateRender

  // controls (sanitizers/validators)
  // authorization checks (guards BIZ-001) — Laravel Gate predicates (path-sensitive via B1).
  control "Gate.allows" -> core.AuthorizationCheck
  control "Gate.authorize" -> core.AuthorizationCheck
  control method "access" -> core.AuthorizationCheck
  control "current_user_can" -> core.AuthorizationCheck
  control "current_user_can_for_blog" -> core.AuthorizationCheck
  control "groups_is_user_admin" -> core.AuthorizationCheck
  control "requireAuth" -> core.AuthenticationCheck
  control "requireAdmin" -> core.AuthorizationCheck
  control "ensureAuthenticated" -> core.AuthenticationCheck
  control "isAuthenticated" -> core.AuthenticationCheck
  control "is_user_logged_in" -> core.AuthenticationCheck
  control "auth.check" -> core.AuthenticationCheck
  control "checkOwnership" -> core.OwnershipCheck
  control "requireOwner" -> core.OwnershipCheck
  control "isOwner" -> core.OwnershipCheck
  control "analysis.function.context" val "customer_id" val "auth()->guard" val "user()->id" -> core.OwnershipCheck
  control method "userHasAccessTo" -> core.AuthorizationCheck
  flag code.PasswordRecoveryLinkHostControl in function {
    has "ResetPassword"
    has "createToken"
    has "account:login-token"
    has "absolute: true"
    has "$email->text"
    lacks "buildBaseUrl"
    lacks "resolveUri"
  }
  control "htmlspecialchars" -> core.HtmlEscape
  control "htmlentities" -> core.HtmlEscape
  control "dol_htmlentities" -> core.HtmlEscape
  control "e" -> core.HtmlEscape
  control "Tools.htmlentitiesUTF8" -> core.HtmlEscape
  control "html_escape" -> core.HtmlEscape
  control "esc_html" -> core.HtmlEscape
  control "esc_attr" -> core.HtmlEscape
  control "esc_url" -> core.HtmlEscape
  control "wp_kses" -> core.HtmlEscape
  control "wp_kses_post" -> core.HtmlEscape
  control "strip_tags" -> core.HtmlEscape
  control "preg_replace" val "[^a-zA-Z0-9" -> core.HtmlEscape
  control "libxml_disable_entity_loader" val "true" -> core.XmlHardening
  control "esc_csv" -> core.CsvEscape
  control method "esc_csv" -> core.CsvEscape
  control "escapeCsvRecord" -> core.CsvEscape
  control method "escapeCsvRecord" -> core.CsvEscape
  flag code.CsvFormulaProneExportRow in function {
    lang "php"
    has "getForCsvExport"
    has "self::COLUMNS"
    has "$row[self::COLUMNS][]="
    has "$rows[]=$row"
    lacks "escapeCsvRecord"
    lacks "esc_csv"
  }
  flag code.ExportDefaultPublicFilesystemDisk in function {
    lang "php"
    name "getFileDisk"
    call path "config"
    literal "filament.default_filesystem_disk"
    not literal "local"
    not call path "array_key_exists"
  }
  control method "purify" -> core.HtmlEscape
  control "escapeshellarg" -> core.ShellEscape
  control "escapeshellcmd" -> core.ShellEscape
  control "mysqli_real_escape_string" -> core.SqlParameterization
  control method "escape_string" -> core.SqlParameterization
  control "pg_escape_string" -> core.SqlParameterization
  // realpath canonicalizes `../` but does NOT bound the path to a base dir, so it is not a
  // sound traversal sanitizer on its own (only a following prefix/containment check is —
  // core.PathAccessCheck). Leaving it out lets realpath-without-check traversal surface.
  // control "realpath" -> core.PathCanonicalization
  control "basename" -> core.PathCanonicalization
  control "in_array" val "$tpl" val "$templates" -> core.PathAccessCheck
  control method "isBelow" -> core.PathAccessCheck

  // regex compile (ReDoS, CWE-1333) — tainted PATTERN arg0
  sink path "preg_match" -> code.RegexCompile
  sink path "preg_replace" -> code.RegexCompile
  sink path "preg_match_all" -> code.RegexCompile

  // mass assignment (CWE-915) — request body -> bulk bind
  sink method "fill" -> code.MassAssign
  sink method "forceFill" -> code.MassAssign
  flag code.IncompleteMassAssignmentIdUnset in module {
    lang "php"
    has "functionadd("
    has "$patchEntityParams=['associated'=>[],'accessibleFields'=>$data->getAccessibleFieldForNew(),];"
    has "unset($params['id']);"
    has "$input=$this->__massageInput($params);"
    has "$data=$this->Table->patchEntity($data,$input,$patchEntityParams);"
    lacks "unset($input['id']);"
  }
  // Review-only: model bulk hydration/update helpers as sensitive because they may bind
  // security-critical account fields depending on the object type and allowed field list.
  flag code.SensitiveOperation on any {
    method "fromArray"
  }
  sink method "find" -> code.ObjectLookupByUserInput
  sink method "findOrFail" -> code.ObjectLookupByUserInput
  sink method "findById" -> code.ObjectLookupByUserInput
  sink method "getUser" -> code.ObjectLookupByUserInput
  sink method "getAccount" -> code.ObjectLookupByUserInput
  // CSRF-sensitive state changes. PHP applications commonly route request handlers
  // straight into model mutators/persistence methods, so request data reaching these
  // operations should require a dominating CSRF check.
  flag code.StateChangingOp on any {
    method "changePassword"
  }
  flag code.StateChangingOp on any {
    method "updatePassword"
  }
  flag code.StateChangingOp on any {
    method "resetPassword"
  }
  flag code.StateChangingOp on any {
    method "changeEmail"
  }
  flag code.StateChangingOp on any {
    method "transferFunds"
  }
  flag code.StateChangingOp on any {
    method "deleteAccount"
  }
  flag code.StateChangingOp on any {
    method "grantRole"
  }
  flag code.StateChangingOp on any {
    method "makeAdmin"
  }
  flag code.StateChangingOp on any {
    method "setValue"
  }
  flag code.StateChangingOp on any {
    method "setValues"
  }
  flag code.StateChangingOp on any {
    method "save"
  }
  flag code.StateChangingOp on any {
    method "store"
  }
  flag code.StateChangingOp on any {
    method "insert"
  }
  flag code.StateChangingOp on any {
    method "update"
  }
  flag code.StateChangingOp on any {
    method "delete"
  }
  sink path "update_option" -> code.StateChangingOp
  sink method "setFromPost" -> code.StateChangingOp
  flag code.MissingHttpMethodAssertion in class {
    has "Action"
    has "deleteBy"
    has "redirect"
    lacks "assertAllowedHttpMethod"
  }
  flag code.MissingHttpMethodAssertion in class {
    has "Action"
    has "$this->addToCompareList"
    has "$this->removeFromCompareList"
    lacks "$this->assertAllowedHttpMethod"
  }
  flag code.MissingHttpMethodAssertion in class {
    has "Action"
    has "PasswordReset::class"
    has "->initiateReset"
    lacks "$this->assertAllowedHttpMethod"
  }
  flag code.MissingHttpMethodAssertion in class {
    has "Action"
    has "$this->backendUserSessionRepository->terminateSessionByIdentifier"
    lacks "$this->assertAllowedHttpMethod"
  }
  flag code.IncompleteCsrfTokenValidation in function {
    lang "php"
    name "restart"
    has "delete_option"
    has "$wpdb->query"
    has "DELETE FROM"
    lacks "check_admin_referer"
    lacks "wp_verify_nonce"
  }
  flag code.BestWebSoftContactFormSettingsCsrf in function {
    lang "php"
    name "cntctfrm_settings_page"
    has "cntctfrm_form_submit"
    has "$cntctfrm_options_submit"
    has "update_option"
    lacks "check_admin_referer"
    lacks "wp_nonce_field"
  }
  flag code.WordPressOptionUpdateMissingCsrf in function {
    lang "php"
    token subscript "$_POST"
    call "update_option"
    not call "check_admin_referer"
    not call "wp_verify_nonce"
  }
  flag code.WordPressOptionUpdateMissingCsrf in function {
    lang "php"
    token subscript "$_REQUEST"
    call "update_option"
    not call "check_admin_referer"
    not call "wp_verify_nonce"
  }
  sink path "queryDB" val "insert into" -> code.StateChangingOp
  sink path "queryDB" val "replace into" -> code.StateChangingOp
  sink path "queryDB" val "update " val " set " -> code.StateChangingOp
  sink path "queryDB" val "delete from" -> code.StateChangingOp
  flag code.AuthenticationRequiredOp on any {
    path "changePassword"
  }
  flag code.AuthenticationRequiredOp on any {
    path "updatePassword"
  }
  flag code.AuthenticationRequiredOp on any {
    path "resetPassword"
  }
  flag code.AuthenticationRequiredOp on any {
    path "changeEmail"
  }
  flag code.AuthenticationRequiredOp on any {
    path "transferFunds"
  }
  flag code.AuthenticationRequiredOp on any {
    path "deleteAccount"
  }
  flag code.AuthenticationRequiredOp on any {
    path "grantRole"
  }
  flag code.AuthenticationRequiredOp on any {
    path "makeAdmin"
  }
  flag code.DokuwikiRemoteAclMissingAdminCheck in function {
    lang "php"
    has "plugin_load('admin','acl')"
    has "$apa->_acl_add"
    lacks "auth_isadmin"
    lacks "RemoteAccessDeniedException"
  }
  flag code.DokuwikiRemoteAclMissingAdminCheck in function {
    lang "php"
    has "plugin_load('admin','acl')"
    has "$apa->_acl_del"
    lacks "auth_isadmin"
    lacks "RemoteAccessDeniedException"
  }

  // CSV injection (CWE-1236) + unrestricted upload (CWE-434)
  flag code.UncheckedUploadedImageProcessing in function {
    lang "php"
    has "imagecopyresampled"
    has "$imgt($new_image,$thumb_path)"
    has "$imgt($old_image,$source_path)"
    has "returntrue"
    lacks "===false"
    lacks "return$imgt"
  }
  flag code.AbsolutePathDisclosure in function {
    lang "php"
    has "getAbsolutePath"
    has "move_uploaded_file("
    lacks "@move_uploaded_file("
  }
  flag code.AbsolutePathDisclosure in function {
    lang "php"
    has "getAbsolutePath"
    has "rename("
    lacks "@rename("
  }
  flag code.AbsolutePathDisclosure in function {
    lang "php"
    has "getAbsolutePath"
    has "copy("
    lacks "@copy("
  }
  flag code.AbsolutePathDisclosure in function {
    lang "php"
    has "getAbsolutePath"
    has "touch("
    lacks "@touch("
  }
  flag code.AbsolutePathDisclosure in function {
    lang "php"
    has "getAbsolutePath"
    has "unlink("
    lacks "@unlink("
  }
  sink path "fputcsv" arg 1 collection -> code.CsvCell
  sink path "move_uploaded_file" arg 1 -> code.UnsafeUpload
  sink path "FileSystem.write" -> code.UnsafeUpload
  sink path "$this.context.fs.write" -> code.UnsafeUpload
  sink path "File.write" -> code.FilePathAccess
  sink method "extractTo" arg all -> code.ArchiveEntryWrite
  sink path "ZipArchive.extractTo" arg all -> code.ArchiveEntryWrite

  // session fixation (CWE-384) — user value as session id
  sink path "session_id" -> code.SessionId

  // permissive CORS (CWE-942)
  flag code.PermissiveCors on any {
    path "header"
    has "Access-Control-Allow-Origin: *"
  }

  // clickjacking (CWE-1021) — header("X-Frame-Options: ALLOWALL") explicitly permits framing
  flag code.MissingFrameProtection on any {
    path "header"
    has "X-Frame-Options: ALLOWALL"
  }

  // email-header injection (CWE-93) — mail($to,$subj,$body,$headers): tainted CRLF in the
  // additional-headers arg (index 3) injects extra headers / a second message.
  sink path "mail" arg 3 -> code.MailHeaderWrite

  // weak crypto (CWE-327) — named-value on the algorithm string.
  // Cipher: openssl_encrypt($d, "des-ede3-cbc"/"rc4"/"...-ecb", ...) / mcrypt des/rc4.
  flag code.WeakCipher on any {
    path "openssl_encrypt"
    has "des"
  }
  flag code.WeakCipher on any {
    path "openssl_encrypt"
    has "rc4"
  }
  flag code.WeakCipher on any {
    path "openssl_encrypt"
    has "rc2"
  }
  flag code.WeakCipher on any {
    path "openssl_encrypt"
    has "bf-"
  }
  flag code.WeakCipher on any {
    path "openssl_encrypt"
    has "ecb"
  }
  flag code.AuthenticatedDecryptionTagReview in function {
    lang "php"
    has "openssl_decrypt"
    has "VAL_CRYPTO_ALGO"
    has "base64_decode"
    has "['tag']"
    lacks "strlen($tag)"
  }
  flag code.WeakCipher on any {
    path "mcrypt_encrypt"
    has "des"
  }
  flag code.WeakCipher on any {
    path "mcrypt_encrypt"
    has "rc4"
  }
  flag code.StaticIv on any {
    path "openssl_encrypt"
    has "0000000000000000"
  }
  flag code.StaticIv on any {
    path "openssl_decrypt"
    has "0000000000000000"
  }
  // Hash: explicit hash("md5"/"sha1", ...) — clearer security signal than bare md5().
  flag code.WeakHash on any {
    path "hash"
    has "md5"
  }
  flag code.WeakHash on any {
    path "hash"
    has "sha1"
  }
  flag code.WeakHash on any {
    path "hash_hmac"
    has "md5"
  }

  // insecure cookie (CWE-614) — setcookie options array EXPLICITLY disabling a flag
  flag code.InsecureCookie on any {
    path "setcookie"
    fact httponly "false"
  }
  flag code.InsecureCookie on any {
    path "setcookie"
    fact secure "false"
  }
  flag code.InsecureCookie on any {
    path "setrawcookie"
    fact httponly "false"
  }

  // JWT signature not verified (CWE-347) — firebase/php-jwt decode allowing alg "none"
  flag code.JwtUnverified on any {
    path "JWT.decode"
    has "none"
  }
  flag code.CsrfDisabled on any {
    path "withoutMiddleware"
    has "VerifyCsrfToken"
  }
  control "csrf_token" -> core.CsrfProtection
  control "validate_csrf_token" -> core.CsrfProtection
  control "check_csrf_token" -> core.CsrfProtection
  control "verify_csrf_token" -> core.CsrfProtection
  control method "isCsrfTokenValid" -> core.CsrfProtection
  control method "checkToken" -> core.CsrfProtection
  control "check_admin_referer" -> core.CsrfProtection
  control "wp_verify_nonce" -> core.CsrfProtection

  // TLS cert validation disabled (CWE-295) — curl_setopt_array([CURLOPT_SSL_VERIFYPEER => false])
  flag code.CertValidationDisabled on any {
    path "curl_setopt_array"
    has "CURLOPT_SSL_VERIFYPEER=false"
  }
  flag code.CertValidationDisabled on any {
    path "curl_setopt_array"
    has "CURLOPT_SSL_VERIFYHOST=0"
  }
  flag code.InsecurePermission on any {
    path "chmod"
    has "0777"
  }
  flag code.InsecurePermission on any {
    path "chmod"
    has "0666"
  }
  // Review-only: private key generation helpers should be followed by restrictive
  // file permissions; function-context text suppresses this when chmod is present.
  flag code.SecretFilePermissionReview in function {
    has "generateKey"
    has "keyfile"
    lacks "chmod"
  }
  flag code.InsecureTempFile on any {
    path "fopen"
    has "/tmp/"
    has "w"
  }
  flag code.ResourceHandle on any {
    path "fopen"
  }
  flag code.ResourceHandle on any {
    path "fsockopen"
  }
  control "fclose" -> core.ResourceRelease
  // PDF previews can execute embedded script in-browser when streamed/rendered before
  // content scanning. Match only explicit PDF responses and suppress once a scan gate runs.
  flag code.UnscannedPdfPreview in function {
    lang "php"
    has "StreamedResponse"
    has "application/pdf"
    lacks "getResponseByScanStatus"
    lacks "getScanStatus"
    lacks "scan_pdf"
  }
  flag code.UnrestrictedVariableVariableAssignment in module {
    lang "php"
    has "foreach"
    has "$_GET"
    has "$$"
    lacks "preg_match"
    lacks "in_array"
    lacks "array_key_exists"
  }
  flag code.UnrestrictedVariableVariableAssignment in function {
    lang "php"
    has "foreach"
    has "$_GET"
    has "$$"
    lacks "preg_match"
    lacks "in_array"
    lacks "array_key_exists"
  }
  control method "getScanStatus" -> core.PdfScanCheck
  control "getResponseByScanStatus" -> core.PdfScanCheck

  // XPath injection (CWE-643) — SimpleXMLElement::xpath($expr) (distinctive method)
  sink method "xpath" -> code.XpathQuery

  // LDAP injection (CWE-90) — ldap_search/list/read($conn, $base, $filter): filter is arg 2
  sink path "ldap_search" arg 2 -> code.LdapQuery
  sink path "ldap_list" arg 2 -> code.LdapQuery
  sink path "ldap_read" arg 2 -> code.LdapQuery

  // cleartext channel (CWE-319) — http:// URL to a fetch/transport (loopback excluded; low sev)
  flag code.CleartextChannel on any {
    path "file_get_contents"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "fopen"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "curl_init"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "curl_setopt"
    has "http://"
    lacks "127.0"
  }

  // character-filter: preg_replace(pattern, repl, subject) is global.
  filter path "preg_replace" global
  sink path "ldap_search" arg 2 -> code.LdapQuery
  sink path "ldap_list" arg 2 -> code.LdapQuery
  sink method "evaluate" -> code.XpathQuery
  // (setcookie sink removed — fires on safe too)
  flag code.InsecureCookie on any {
    path "setcookie"
    has "false"
  }
  sink path "$_SESSION" arg all -> code.TrustBoundary
  sink method "__set" arg all -> code.TrustBoundary
  flag code.WeakRandomValue on any {
    path "rand"
  }
  flag code.WeakRandomValue on any {
    path "mt_rand"
  }
  flag code.WeakHash on any {
    path "md5"
  }
  flag code.WeakHash on any {
    path "sha1"
  }
  control "ldap_escape" -> core.LdapEscape
  control "xpathEscape" -> core.XpathEscape
  control "validateRole" -> core.InputValidation
}
