// php framework adapter (docs/07) — framework→concept content.
// frameworks: vanilla, laravel, symfony, wordpress, codeigniter
adapter php {
  meta { fidelity: resolved }

  // superglobals (subscripted) -> HTTP input
  source "$argv" -> code.CliArgument
  source path "analysis.parameter.entry" val "function_param_type:Parser" nval "param_type:Parser" nval "param_type:PPFrame" nval "param_type:OutputPage" nval "param_type:Skin" nval "param_type:Title" nval "param_type:MimeAnalyzer" -> code.HttpInput
  source path "analysis.parameter.entry" val "function_param_type:PPFrame" nval "param_type:Parser" nval "param_type:PPFrame" nval "param_type:OutputPage" nval "param_type:Skin" nval "param_type:Title" nval "param_type:MimeAnalyzer" -> code.HttpInput
  source path "$request.__subscript" -> code.HttpInput
  source "$_GET" -> code.HttpInput
  source "$_POST" -> code.HttpInput
  source "$_REQUEST" -> code.HttpInput
  source "$_COOKIE" -> code.HttpInput
  source "$_FILES" -> code.HttpInput
  source "$_SERVER" val "HTTP_" -> code.HttpInput
  source "$_SERVER" val "REQUEST_URI" -> code.HttpInput
  source "$_SERVER" val "QUERY_STRING" -> code.HttpInput
  source "$_SERVER" val "PATH_INFO" -> code.HttpInput
  source "$_SERVER" val "PHP_SELF" -> code.HttpInput
  source "$_SERVER" val "REQUEST_METHOD" -> code.HttpInput
  source "$_SERVER" val "REMOTE_ADDR" -> code.HttpInput
  source "$_SERVER" val "REMOTE_PORT" -> code.HttpInput
  source "$_SERVER" val "SERVER_SOFTWARE" -> code.HttpInput
  source path "Request.post" -> code.HttpInput
  // Symfony/Pimcore request parameter bags. query/request/filter accessors return
  // attacker-controlled request values even when used through object-property chains.
  source path "$request.query.get" -> code.HttpInput
  source path "$request.query.all" -> code.HttpInput
  source path "$request.query.filter" -> code.HttpInput
  source path "$request.request.get" -> code.HttpInput
  source path "$request.request.all" -> code.HttpInput
  source path "$request.request.filter" -> code.HttpInput
  source path "$request.headers.get" -> code.HttpHeader
  source path "$request.cookies.get" -> code.Cookie
  source path "$this.metadata" -> code.ArchiveEntryName
  source method "getNameIndex" -> code.ArchiveEntryName
  // framework request-object accessors (Utopia/Appwrite, Symfony-style): the request URI /
  // query / path are attacker-controlled. Method form → receiver-agnostic.
  source method "getURI" -> code.HttpInput
  source method "getQuery" -> code.HttpInput
  source method "getPathInfo" -> code.HttpInput
  // Drupal request helpers. current_path() can reflect the requested q/path
  // value; URL helper consumers must reject absolute/external targets before
  // using it as a redirect destination.
  source path "current_path" -> code.HttpInput
  // Aimeos media uploads must derive the storage path from the uploaded file,
  // not from an existing item URL controlled through media metadata.
  source "$item.getUrl" -> code.FileUpload
  // getenv() reading request-controlled CGI vars — untrusted (X-Forwarded-For SQLi/SSRF).
  // val-gated so benign getenv('PATH')/getenv('HOME') stay clean.
  source "getenv" val "HTTP_" -> code.HttpInput
  source "getenv" val "QUERY_STRING" -> code.HttpInput
  source "getenv" val "REQUEST_" -> code.HttpInput
  source "getenv" val "REMOTE_ADDR" -> code.HttpInput
  source "getenv" val "PATH_INFO" -> code.HttpInput
  flag code.IncompleteServerPortValidation in module {
    lang "php"
    has "connect("
    has "is_numeric($port)"
    has "explode("
    has "server"
    has "$port<1024"
  }
  flag code.IncompleteServerPortValidation in module {
    lang "php"
    has "connect("
    has "is_numeric($port)"
    has "explode("
    has "server"
    has "1024>$port"
  }
  flag code.UnsignedStorageDownloadRoute in module {
    lang "php"
    call path "Route.get"
    call path "Route.get.where"
    call arg "Route.get.where:.*"
    call path "Storage.disk.path"
    call path "response.download"
    call path "response.download.deleteFileAfterSend"
    literal contains_any ["{path}", "{file}", "{filename}"]
    not call path "Route.get.middleware"
    not literal contains_any ["signed", "auth", "can:"]
  }
  flag code.SessionHashMissingAuthorizationState in function {
    lang "php"
    name "authenticate"
    call path "$this.session.set"
    call arg "$this.session.set:SESSION_HASH"
    token subscript "$u['password']"
    not token subscript "$u['permissions']"
    not token subscript "$u['homedir']"
    not token subscript "$u['role']"
  }
