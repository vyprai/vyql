  // Review-only access-policy config: nested PHP arrays such as
  // ['locale' => ['site' => ['groups' => ['admin', 'super']]]]
  // carry key-path tokens, so broad role grants on sensitive resource groups can
  // be surfaced without forcing a confirmed authz finding.
  flag code.AccessPolicyReview on any {
    path exact "__object_literal"
    has "locale/site/groups"
    has "admin"
  }
  flag code.AccessPolicyReview on any {
    path exact "__object_literal"
    has "locale/language/groups"
    has "admin"
  }
  flag code.AccessPolicyReview on any {
    path exact "__object_literal"
    has "locale/currency/groups"
    has "admin"
  }
  // Review-only workflow policy: Aimeos-style digital download access queries must
  // constrain both ownership and payment status. If the condition array checks the
  // customer and product attribute but has no order.statuspayment term, surface it
  // for AI/manual review instead of emitting a confirmed scan finding.
  flag code.WorkflowPolicyReview on any {
    path exact "__object_literal"
    has "order.customerid"
    has "order.product.attribute.id"
    lacks "order.statuspayment"
  }
  // Review-only IDOR policy: Aimeos review deletes must constrain the selected
  // review ids by the current customer. Missing review.customerid is the
  // CVE-2024-39319 pattern; the confirmed authz rule remains untouched.
  flag code.IdorPolicyReview on any {
    path exact "__object_literal"
    has "review.id"
    lacks "review.customerid"
  }
