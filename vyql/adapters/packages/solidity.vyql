import code.{HttpInput, ExternalCall, PrivilegedOp, StateWrite, TxOriginAuth, UrlFetch, SecretValue}
import core.{AuthenticationCheck, AuthorizationCheck, OwnershipCheck, RateLimit}

adapter solidity {
  package "solidity" {
    source "msg.data" -> HttpInput
    source "msg.value" -> HttpInput
    source "tx.origin" -> HttpInput
    sink method "call" -> ExternalCall
    sink method "delegatecall" -> ExternalCall
    sink method "send" -> ExternalCall
    sink method "transfer" -> ExternalCall
    sink path "selfdestruct" -> PrivilegedOp
    flag StateWrite on any {
      path "state_write"
    }
    flag TxOriginAuth on any {
      path "tx.origin"
    }
    control "msg.sender" -> AuthenticationCheck
  }
  package "@chainlink/contracts" {
    source "AggregatorV3Interface.latestRoundData" -> SecretValue
    sink method "requestRandomWords" -> UrlFetch
  }
  package "@openzeppelin/contracts" {
    sink method "safeTransferFrom" -> ExternalCall
    sink method "functionCall" -> ExternalCall
    sink method "verifyCallResult" -> ExternalCall
    control "onlyOwner" -> OwnershipCheck
    control "Ownable._checkOwner" -> OwnershipCheck
    control "AccessControl.hasRole" -> AuthorizationCheck
    control "nonReentrant" -> RateLimit
    control "Pausable.whenNotPaused" -> AuthorizationCheck
  }
}
