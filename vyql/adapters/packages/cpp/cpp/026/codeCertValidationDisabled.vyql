module bindings.cpp.migration.m1c1357ee;

binding certValidationDisabled26 {
  requires {
    dependency("libcurl")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "curl_easy_setopt" and node.token contains "CURLOPT_SSL_VERIFYPEER=0"
  emit issue code.CertValidationDisabled at node
}
