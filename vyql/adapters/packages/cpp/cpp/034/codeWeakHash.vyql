module bindings.cpp.migration.m1c1357ee;

binding weakHash34 {
  requires {
    dependency("openssl")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "EVP_md5"
  emit issue code.WeakHash at node
}
