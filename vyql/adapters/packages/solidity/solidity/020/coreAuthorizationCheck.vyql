module bindings.solidity.migration.m72929a80;

binding authorizationCheck20 {
  requires {
    dependency("@openzeppelin/contracts")
  }
  query pattern callExpr where callee.path ~= "Pausable.whenNotPaused"
  emit check core.AuthorizationCheck at call {
    covers path {
      from: call
      to: call
    }
  }
}
