module bindings.solidity.migration.m72929a80;

binding txOriginAuth9 {
  requires {
    dependency("solidity")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "tx.origin"
  emit issue code.TxOriginAuth at node
}
