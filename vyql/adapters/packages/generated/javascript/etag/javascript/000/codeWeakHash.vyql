module bindings.javascript.migration.m9281e918;

binding weakHash0 {
  requires {
    dependency("etag")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "etag"
  emit issue code.WeakHash at node
