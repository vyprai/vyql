import code.{NetworkData}
adapter javascript {
  package "portfinder" {
    source method "getPort" -> code.NetworkData
    source method "getPorts" -> code.NetworkData
    source method "getPortPromise" -> code.NetworkData
    source method "getPortsPromise" -> code.NetworkData
    source method "getSocket" -> code.NetworkData
    source method "getSocketPromise" -> code.NetworkData
  }
}
