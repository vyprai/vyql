import code.{NetworkConnect, NetworkSend}

adapter javascript {
  package "https-proxy-agent" {
    sink method "HttpsProxyAgent.constructor" -> code.NetworkConnect
    sink method "HttpsProxyAgent.connect" -> code.NetworkConnect
    sink method "HttpsProxyAgent.connect" -> code.NetworkSend
    sink method "HttpsProxyAgent._connectWithAuth" -> code.NetworkSend
  }
}
