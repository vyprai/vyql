import code.{HtmlRender, NetworkConnect, NetworkData, WeakHash, WeakRandomValue, Cookie}
import core.{InputValidation}

adapter javascript {
  package "sockjs" {
    control method "escape_selected" -> core.InputValidation
    flag code.WeakHash on any {
      method "md5_hex"
    }
    flag code.WeakHash on any {
      method "sha1_base64"
    }
    source method "parseCookie" -> code.Cookie
    flag code.WeakRandomValue on any {
      method "random32"
    }
    sink method "htmlfile" -> code.HtmlRender
  }
}
