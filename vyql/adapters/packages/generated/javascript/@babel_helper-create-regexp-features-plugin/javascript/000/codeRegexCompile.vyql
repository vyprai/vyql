module bindings.javascript.migration.m8b125d6b;

binding regexCompile0 {
  requires {
    dependency("@babel/helper-create-regexp-features-plugin")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "createRegExpFeaturePlugin"
  emit issue code.RegexCompile at node
  emit sink code.RegexCompileSink at node
}
