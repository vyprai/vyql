import code.{HttpInput, RedirectTarget, FilePathAccess, NetworkSend, TemplateRender, Cookie, ResponseHeaderWrite}

adapter javascript {
  package "express" {
    source method "req.query" -> code.HttpInput
    source method "req.params" -> code.HttpInput
    source method "req.body" -> code.HttpInput
    source method "req.headers" -> code.HttpInput
    source method "req.get" -> code.HttpInput
    source method "req.cookies" -> code.Cookie
    source method "req.signedCookies" -> code.Cookie

    mark method "res.redirect" -> code.RedirectTarget
    sink method "res.send" -> code.NetworkSend
    sink method "res.json" -> code.NetworkSend
    sink method "res.jsonp" -> code.NetworkSend
    sink method "res.render" -> code.TemplateRender
    sink method "res.sendFile" -> code.FilePathAccess
    sink method "res.download" -> code.FilePathAccess
    sink method "res.set" -> code.ResponseHeaderWrite
    sink method "res.header" -> code.ResponseHeaderWrite
    source method "res.cookie" -> code.Cookie
  }
}
