import code.{NetworkConnect, NetworkSend, NetworkData}

adapter javascript {
  package "node-fetch" {
    sink method "fetch" -> code.NetworkConnect
    sink method "fetch" -> code.NetworkSend
    source method "arrayBuffer" -> code.NetworkData
    source method "json" -> code.NetworkData
    source method "text" -> code.NetworkData
    source method "blob" -> code.NetworkData
    source method "formData" -> code.NetworkData
  }
}
