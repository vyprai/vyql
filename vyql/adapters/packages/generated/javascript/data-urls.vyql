import code.{Deserialization, UrlFetch}

adapter javascript {
  package "data-urls" {
    sink method "stringInput" -> code.UrlFetch
    sink method "fromURLRecord" -> code.UrlFetch
    sink method "isomorphicDecode" -> code.Deserialization
    sink method "forgivingBase64Decode" -> code.Deserialization
  }
}
