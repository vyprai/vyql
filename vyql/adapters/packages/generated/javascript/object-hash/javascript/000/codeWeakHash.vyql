module bindings.javascript.migration.mcb1f96d7;

binding weakHash0 {
  requires {
    dependency("object-hash")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "object.hash.hash"
  emit issue code.WeakHash at node
}
