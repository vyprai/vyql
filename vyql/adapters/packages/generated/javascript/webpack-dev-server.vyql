import code.{CommandExecution, Deserialization, FilePathAccess, NetworkBind, NetworkConnect, NetworkSend, UrlFetch}
import core.{InputValidation}

adapter javascript {
  package "webpack-dev-server" {
    sink method "send" -> code.NetworkSend
    sink method "parse" -> code.Deserialization
    control method "sanitize" -> core.InputValidation
    sink method "proxyUpgrade" -> code.NetworkConnect
    sink method "createWebSocketServer" -> code.NetworkBind
    sink method "openBrowser" -> code.UrlFetch
    sink method "readFile" -> code.FilePathAccess
    sink method "setupWatchStaticFiles" -> code.FilePathAccess
    sink method "setupWatchFiles" -> code.FilePathAccess
    sink method "launchEditor" -> code.CommandExecution
  }
}
