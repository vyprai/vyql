import code.{NetworkData}
import core.{InputValidation}

adapter javascript {
  package "proxy-addr" {
    source method "proxyaddr" -> code.NetworkData
    source method "alladdrs" -> code.NetworkData
    control method "compile" -> core.InputValidation
    control method "compileTrust" -> core.InputValidation
    control method "parseipNotation" -> core.InputValidation
    control method "parseNetmask" -> core.InputValidation
  }
}
