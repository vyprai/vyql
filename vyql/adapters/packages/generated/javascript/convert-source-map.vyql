import code.{Deserialization}

adapter javascript {
  package "convert-source-map" {
    sink method "fromObject" -> code.Deserialization
    sink method "fromJSON" -> code.Deserialization
    sink method "fromURI" -> code.Deserialization
    sink method "fromComment" -> code.Deserialization
    sink method "fromSource" -> code.Deserialization
    sink method "decodeBase64WithBufferFrom" -> code.Deserialization
    sink method "decodeBase64WithNewBuffer" -> code.Deserialization
    sink method "decodeBase64WithAtob" -> code.Deserialization
  }
}
