module bindings.javascript.migration.m854e2786;

binding pathCanonicalization1 {
  requires {
    dependency("@rollup/pluginutils")
  }
  query pattern callExpr where callee.method == "normalizePath"
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
  }
}
