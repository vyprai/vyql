import code.{FilePathAccess}
adapter javascript {
  package "glob" {
    sink method "globStreamSync" -> code.FilePathAccess
    sink method "globStream" -> code.FilePathAccess
    sink method "globSync" -> code.FilePathAccess
    sink method "globIterateSync" -> code.FilePathAccess
    sink method "globIterate" -> code.FilePathAccess
  }
}
