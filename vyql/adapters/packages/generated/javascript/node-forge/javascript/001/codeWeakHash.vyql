module bindings.javascript.migration.m0f4e57b9;

binding weakHash1 {
  requires {
    dependency("node-forge")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "forge.sha1.create"
  emit issue code.WeakHash at node
}
