import code.{HttpInput}
adapter javascript {
  package "negotiator" {
    source method "Negotiator" -> code.HttpInput
    source method "preferredCharsets" -> code.HttpInput
    source method "preferredEncodings" -> code.HttpInput
    source method "preferredLanguages" -> code.HttpInput
    source method "preferredMediaTypes" -> code.HttpInput
  }
}
