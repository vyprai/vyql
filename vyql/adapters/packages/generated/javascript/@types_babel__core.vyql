    sink method "parseAsync" -> code.Deserialization
    sink method "transform" -> code.Deserialization
    sink method "transformSync" -> code.Deserialization
    sink method "transformAsync" -> code.Deserialization
    sink method "transformFile" -> code.Deserialization
    sink method "transformFileSync" -> code.Deserialization
    sink method "transformFileAsync" -> code.Deserialization
    sink method "transformFromAst" -> code.Deserialization
    sink method "transformFromAstSync" -> code.Deserialization
    sink method "transformFromAstAsync" -> code.Deserialization
  }
}
