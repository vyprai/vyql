module bindings.javascript.migration.m2776b029;

binding weakHash0 {
  requires {
    dependency("selfsigned")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "generate"
  emit issue code.WeakHash at node
