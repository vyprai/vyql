module bindings.javascript.migration.m3c38face;

binding regexCompile0 {
  requires {
    dependency("path-to-regexp")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "parse"
