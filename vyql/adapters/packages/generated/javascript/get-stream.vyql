import core.{UserControlledData}
adapter javascript {
  package "get-stream" {
    source method "getStreamAsBuffer" -> core.UserControlledData
    source method "getStreamAsArray" -> core.UserControlledData
    source method "getStreamAsArrayBuffer" -> core.UserControlledData
    source method "getStreamAsString" -> core.UserControlledData
    source method "getStreamContents" -> core.UserControlledData
  }
}
