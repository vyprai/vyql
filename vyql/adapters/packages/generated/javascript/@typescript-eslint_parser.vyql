import code.{Deserialization, FilePathAccess, LogOutput}
adapter javascript {
  package "@typescript-eslint/parser" {
    sink method "parse" -> code.Deserialization
    sink method "parseForESLint" -> code.Deserialization
    control method "validateBoolean" -> core.InputValidation
    sink method "getLib" -> code.FilePathAccess
    sink method "log" -> code.LogOutput
  }
}
