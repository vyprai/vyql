module bindings.javascript.migration.mf5eeb3f0;

binding regexCompile0 {
  requires {
    dependency("astral-regex")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "astralRegex"
  emit issue code.RegexCompile at node
  emit sink code.RegexCompileSink at node
}
