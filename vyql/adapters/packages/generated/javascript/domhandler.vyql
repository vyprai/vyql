import code.{HtmlRender}
adapter javascript {
  package "domhandler" {
    sink method "onopentag" -> code.HtmlRender
    sink method "ontext" -> code.HtmlRender
    sink method "oncomment" -> code.HtmlRender
    sink method "oncdatastart" -> code.HtmlRender
    sink method "onprocessinginstruction" -> code.HtmlRender
  }
}
