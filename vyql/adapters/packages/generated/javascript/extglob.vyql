import code.{RegexCompile}
adapter javascript {
  package "extglob" {
    flag code.RegexCompile on any {
      method "extglob"
    }
    flag code.RegexCompile on any {
      method "match"
    }
    flag code.RegexCompile on any {
      method "matcher"
    }
    flag code.RegexCompile on any {
      method "create"
    }
    flag code.RegexCompile on any {
      method "makeRe"
    }
    flag code.RegexCompile on any {
      method "Extglob"
    }
  }
}
