import code.{Deserialization, FilePathAccess}
adapter javascript {
  package "cosmiconfig" {
    sink method "load" -> code.Deserialization
    sink method "loadJs" -> code.Deserialization
    sink method "loadJsSync" -> code.Deserialization
    sink method "loadJson" -> code.Deserialization
    sink method "loadYaml" -> code.Deserialization
    sink method "loadTs" -> code.Deserialization
    sink method "loadTsSync" -> code.Deserialization
    sink method "search" -> code.FilePathAccess
    sink method "cosmiconfig" -> code.Deserialization
    sink method "cosmiconfigSync" -> code.Deserialization
  }
}
