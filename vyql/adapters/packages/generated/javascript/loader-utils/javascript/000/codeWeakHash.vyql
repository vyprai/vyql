module bindings.javascript.migration.m15b7d022;

binding weakHash0 {
  requires {
    dependency("loader-utils")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "getHashDigest"
  emit issue code.WeakHash at node
}
