module bindings.javascript.migration.mbba09c33;

binding weakHash2 {
  requires {
    dependency("loader-fs-cache")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "filename"
  emit issue code.WeakHash at node
}
