import code.{HttpInput, NetworkData, NetworkSend, ResponseHeaderWrite}
adapter javascript {
  package "spdy" {
    source method "Server" -> code.HttpInput
    source method "PlainServer" -> code.HttpInput
    source method "Handle" -> code.NetworkData
    source method "Socket" -> code.NetworkData
    sink method "Agent" -> code.NetworkConnect
    sink method "PlainAgent" -> code.NetworkConnect
    sink method "push" -> code.NetworkSend
    sink method "writeHead" -> code.ResponseHeaderWrite
    sink method "end" -> code.NetworkSend
  }
}
