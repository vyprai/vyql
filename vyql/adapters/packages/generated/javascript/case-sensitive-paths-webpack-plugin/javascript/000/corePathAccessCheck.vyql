module bindings.javascript.migration.m3c10970f;

binding pathAccessCheck0 {
  requires {
    dependency("case-sensitive-paths-webpack-plugin")
  }
  query pattern callExpr where callee.method == "CaseSensitivePathsPlugin"
  emit check core.PathAccessCheck at call {
    covers path {
      from: call
      to: call
    }
  }
}
