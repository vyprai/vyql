import code.{HttpInput, NetworkConnect, UrlFetch}
import core.{InputValidation, PathCanonicalization}

adapter javascript {
  package "http-proxy-middleware" {
    sink method "HttpProxyMiddleware" -> code.NetworkConnect
    sink method "HttpProxyMiddleware" -> code.UrlFetch
    control method "createPathRewriter" -> core.PathCanonicalization
    control method "matchPathFilter" -> core.InputValidation
  }
}
