import core.{PathCanonicalization}

adapter javascript {
  package "sass-loader" {
    sink method "load" -> code.FilePathAccess
    sink method "resolve" -> code.FilePathAccess
    sink method "load" -> code.UrlFetch
    sink method "resolve" -> code.UrlFetch
    control method "getWebpackResolver" -> core.PathCanonicalization
  }
}
