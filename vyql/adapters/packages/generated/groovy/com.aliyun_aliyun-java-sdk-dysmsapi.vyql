import code.{NetworkData}
adapter groovy {
  package "com.aliyun:aliyun-java-sdk-dysmsapi" {
    source method "setPhoneNumbers" -> code.NetworkData
    source method "setSignName" -> code.NetworkData
    source method "setTemplateCode" -> code.NetworkData
    source method "setTemplateParam" -> code.NetworkData
    source method "setSourceUrl" -> code.NetworkData
    source method "setShortUrlName" -> code.NetworkData
  }
}
