import code.{CliArgument, SqlExecution}

adapter groovy {
  package "org.apache.ibatis:ibatis-sqlmap" {
    source method "parse" -> code.CliArgument
    sink method "run" -> code.SqlExecution
    sink method "selectOne" -> code.SqlExecution
    sink method "selectAll" -> code.SqlExecution
    sink method "insert" -> code.SqlExecution
    sink method "update" -> code.SqlExecution
    sink method "delete" -> code.SqlExecution
    sink method "query" -> code.SqlExecution
  }
}
