import code.{NetworkConnect, NetworkData}

adapter groovy {
  package "io.netty:netty-all" {
    sink method "connect" -> code.NetworkConnect
    sink method "bind" -> code.NetworkConnect
    source method "readBoolean" -> code.NetworkData
    source method "readByte" -> code.NetworkData
    source method "readShort" -> code.NetworkData
    source method "readInt" -> code.NetworkData
    source method "readLong" -> code.NetworkData
    source method "readBytes" -> code.NetworkData
    source method "writeBoolean" -> code.NetworkData
    source method "writeByte" -> code.NetworkData
    source method "writeShort" -> code.NetworkData
    source method "writeInt" -> code.NetworkData
    source method "writeLong" -> code.NetworkData
    source method "writeBytes" -> code.NetworkData
  }
}
