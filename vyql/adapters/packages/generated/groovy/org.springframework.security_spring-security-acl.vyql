import code.{SqlExecution}

adapter groovy {
  package "org.springframework.security:spring-security-acl" {
    sink method "readAclsById" -> code.SqlExecution
    sink method "createAcl" -> code.SqlExecution
    sink method "deleteAcl" -> code.SqlExecution
    sink method "updateAcl" -> code.SqlExecution
    sink method "computeRepeatingSql" -> code.SqlExecution
    sink method "setLookupPrimaryKeysWhereClause" -> code.SqlExecution
    sink method "setLookupObjectIdentitiesWhereClause" -> code.SqlExecution
  }
}
