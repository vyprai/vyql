import code.{Cookie}
import core.{UserControlledData}
adapter groovy {
  package "javax.ws.rs:jsr311-api" {
    source method "getPathSegments" -> core.UserControlledData
    source method "getQueryParameters" -> core.UserControlledData
    source method "getPathParameters" -> core.UserControlledData
    source method "getRequestUri" -> core.UserControlledData
    source method "valueOf" -> code.Cookie
    source method "getName" -> code.Cookie
    source method "getValue" -> code.Cookie
    source method "getPath" -> code.Cookie
    source method "getDomain" -> code.Cookie
  }
}
