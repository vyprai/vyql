module bindings.groovy.migration.md59d21f5;

binding redirectTarget0 {
  requires {
    dependency("org.tuckey:urlrewritefilter")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "execute"
  emit issue code.RedirectTarget at node
