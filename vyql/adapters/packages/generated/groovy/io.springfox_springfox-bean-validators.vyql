import core.{InputValidation}

adapter groovy {
  package "io.springfox:springfox-bean-validators" {
    control method "extractAnnotation" -> InputValidation
    control method "annotationFromBean" -> InputValidation
    control method "annotationFromField" -> InputValidation
    control method "annotationFromParameter" -> InputValidation
    control method "stringLengthRange" -> InputValidation
    control method "allowableRange" -> InputValidation
    control method "createPatternValueFromAnnotation" -> InputValidation
  }
}
