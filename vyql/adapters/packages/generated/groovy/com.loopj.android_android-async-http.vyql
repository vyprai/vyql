import code.{NetworkConnect, NetworkSend}
adapter groovy {
  package "com.loopj.android:android-async-http" {
    sink method "get" -> code.NetworkConnect
    sink method "post" -> code.NetworkConnect
    sink method "put" -> code.NetworkConnect
    sink method "delete" -> code.NetworkConnect
    sink method "patch" -> code.NetworkConnect
    sink method "sendRequest" -> code.NetworkSend
  }
}
