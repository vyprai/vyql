binding htmlEscape4 {
  requires {
    dependency("org.apache.taglibs:taglibs-standard-impl")
  }
  query pattern callExpr where callee.method == "escapeXml"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
