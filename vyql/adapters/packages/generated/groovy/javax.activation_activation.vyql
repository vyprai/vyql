import code.{Deserialization}
adapter groovy {
  package "javax.activation:activation" {
    sink method "parse" -> code.Deserialization
    sink method "setPrimaryType" -> code.Deserialization
    sink method "setSubType" -> code.Deserialization
    sink method "match" -> code.Deserialization
    sink method "getCommandObject" -> code.Deserialization
    sink method "writeTo" -> code.Deserialization
    sink method "readExternal" -> code.Deserialization
  }
}
