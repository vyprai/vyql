import core.{InputValidation}
adapter groovy {
  package "org.glassfish.jersey.ext:jersey-bean-validation" {
    control method "validate" -> InputValidation
    control method "validateValue" -> InputValidation
    control method "validateResourceAndInputParams" -> InputValidation
    control method "onValidate" -> InputValidation
    control method "validateResult" -> InputValidation
  }
}
