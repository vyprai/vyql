import code.{NetworkSend}
adapter groovy {
  package "io.grpc:grpc-stub" {
    sink method "blockingUnaryCall" -> code.NetworkSend
    sink method "blockingServerStreamingCall" -> code.NetworkSend
    sink method "blockingBidiStreamingCall" -> code.NetworkSend
    sink method "blockingClientStreamingCall" -> code.NetworkSend
    sink method "futureUnaryCall" -> code.NetworkSend
    sink method "write" -> code.NetworkSend
  }
}
