import code.{LogOutput}
adapter groovy {
  package "com.jakewharton.timber:timber" {
    sink method "v" -> code.LogOutput
    sink method "d" -> code.LogOutput
    sink method "i" -> code.LogOutput
    sink method "w" -> code.LogOutput
    sink method "e" -> code.LogOutput
    sink method "wtf" -> code.LogOutput
    sink method "log" -> code.LogOutput
  }
}
