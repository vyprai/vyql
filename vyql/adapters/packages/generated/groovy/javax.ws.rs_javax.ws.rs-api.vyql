import core.{UserControlledData}

adapter groovy {
  package "javax.ws.rs:javax.ws.rs-api" {
    source method "getPathSegments" -> core.UserControlledData
    source method "getQueryParameters" -> core.UserControlledData
    source method "getHeaderString" -> core.UserControlledData
    source method "getCookies" -> core.UserControlledData
    source method "getRequestUri" -> core.UserControlledData
    source method "getAbsolutePath" -> core.UserControlledData
    source method "getPathParameters" -> core.UserControlledData
    source method "target" -> core.UserControlledData
    source method "readEntity" -> core.UserControlledData
    source method "valueOf" -> core.UserControlledData
  }
}
