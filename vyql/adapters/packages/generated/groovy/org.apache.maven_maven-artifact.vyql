import code.{SecretValue, NetworkConnect}
adapter groovy {
  package "org.apache.maven:maven-artifact" {
    source method "getPassword" -> code.SecretValue
    source method "setPassword" -> code.SecretValue
    source method "getUserName" -> code.SecretValue
    sink method "getHost" -> code.NetworkConnect
    sink method "getPort" -> code.NetworkConnect
    sink method "getProtocol" -> code.NetworkConnect
  }
}
