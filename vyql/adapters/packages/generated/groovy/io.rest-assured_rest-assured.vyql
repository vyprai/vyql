import code.{NetworkConnect, NetworkSend, Deserialization, SecretValue}

adapter groovy {
  package "io.rest-assured:rest-assured" {
    sink method "get" -> code.NetworkConnect
    sink method "post" -> code.NetworkConnect
    sink method "put" -> code.NetworkConnect
    sink method "delete" -> code.NetworkConnect
    sink method "head" -> code.NetworkConnect
    sink method "patch" -> code.NetworkConnect
    sink method "options" -> code.NetworkConnect
    sink method "request" -> code.NetworkConnect
    sink method "get" -> code.NetworkSend
    sink method "post" -> code.NetworkSend
    sink method "put" -> code.NetworkSend
    sink method "delete" -> code.NetworkSend
    sink method "head" -> code.NetworkSend
    sink method "patch" -> code.NetworkSend
    sink method "options" -> code.NetworkSend
    sink method "request" -> code.NetworkSend
    source method "basic" -> code.SecretValue
    source method "ntlm" -> code.SecretValue
    source method "form" -> code.SecretValue
    source method "certificate" -> code.SecretValue
    source method "digest" -> code.SecretValue
    source method "oauth" -> code.SecretValue
    source method "oauth2" -> code.SecretValue
    sink method "registerParser" -> code.Deserialization
  }
}
