import code.{HttpInput, NetworkSend, NetworkData}

adapter groovy {
  package "org.apache.cxf:cxf-rt-rs-client" {
    source method "query" -> code.HttpInput
    source method "header" -> code.HttpInput
    source method "headers" -> code.HttpInput
    sink method "writeBody" -> code.NetworkSend
    source method "readBody" -> code.NetworkData
  }
}
