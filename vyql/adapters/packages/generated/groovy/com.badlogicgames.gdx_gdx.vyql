import code.{NetworkBind, NetworkConnect, RedirectTarget, UrlFetch}
adapter groovy {
  package "com.badlogicgames.gdx:gdx" {
    sink method "setUrl" -> code.UrlFetch
    sink method "sendHttpRequest" -> code.UrlFetch
    sink method "newServerSocket" -> code.NetworkBind
    sink method "newClientSocket" -> code.NetworkConnect
    flag code.RedirectTarget on any {
      method "openURI"
    }
  }
}
