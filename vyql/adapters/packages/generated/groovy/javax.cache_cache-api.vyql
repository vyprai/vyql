import code.{CodeEval, UrlFetch}

adapter groovy {
  package "javax.cache:cache-api" {
    sink method "getClassLoader" -> code.CodeEval
    sink method "getDefaultClassLoader" -> code.CodeEval
    sink method "setDefaultClassLoader" -> code.CodeEval
    sink method "getCachingProvider" -> code.CodeEval
    sink method "getCachingProviders" -> code.CodeEval
    sink method "loadCachingProvider" -> code.CodeEval
    sink method "getCacheManager" -> code.UrlFetch
    sink method "getCacheManager" -> code.CodeEval
  }
}
