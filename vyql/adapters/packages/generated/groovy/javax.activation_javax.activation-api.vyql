import code.{CommandExecution, Deserialization, CodeEval, NetworkSend}

adapter groovy {
  package "javax.activation:javax.activation-api" {
    sink method "parse" -> code.Deserialization
    sink method "run" -> code.CommandExecution
    sink method "getCommandObject" -> code.CodeEval
    sink method "writeTo" -> code.NetworkSend
  }
}
