import code.{Deserialization, FilePathAccess, NetworkData}

adapter groovy {
  package "com.rabbitmq:amqp-client" {
    sink method "read" -> code.Deserialization
    sink method "load" -> code.FilePathAccess
    source method "getContentBody" -> code.NetworkData
    source method "getBody" -> code.NetworkData
  }
}
