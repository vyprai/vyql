import code.{HttpInput, RedirectTarget}
import core.{AuthenticationCheck}

adapter groovy {
  package "org.springframework.social:spring-social-security" {
    source method "attemptAuthentication" -> code.HttpInput
    mark method "buildSignupUrl" -> code.RedirectTarget
    mark method "getRedirectUrl" -> code.RedirectTarget
    control method "attemptAuthentication" -> core.AuthenticationCheck
  }
}
