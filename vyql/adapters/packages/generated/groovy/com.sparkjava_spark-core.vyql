import code.{HttpInput, Cookie}

adapter groovy {
  package "com.sparkjava:spark-core" {
    source method "Request.body" -> code.HttpInput
    source method "Request.bodyAsBytes" -> code.HttpInput
    source method "Request.params" -> code.HttpInput
    source method "Request.queryParams" -> code.HttpInput
    source method "Request.headers" -> code.HttpInput
    source method "Request.cookie" -> code.Cookie
    source method "Request.uri" -> code.HttpInput
    source method "Request.url" -> code.HttpInput
    source method "Request.splat" -> code.HttpInput
  }
}
