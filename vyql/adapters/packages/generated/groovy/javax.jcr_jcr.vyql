import code.{Deserialization, StoredDataRead, StoredDataWrite}
import core.{UserControlledData}

adapter groovy {
  package "javax.jcr:jcr" {
    sink method "addNode" -> code.StoredDataWrite
    sink method "setProperty" -> code.StoredDataWrite
    sink method "importXML" -> code.Deserialization
    source method "getNode" -> code.StoredDataRead
    source method "getProperty" -> code.StoredDataRead
  }
}
