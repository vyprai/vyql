module bindings.groovy.migration.mff8ced10;

binding weakHash3 {
  requires {
    dependency("com.clearspring.analytics:stream")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "lookup3ycs"
  emit issue code.WeakHash at node
}
