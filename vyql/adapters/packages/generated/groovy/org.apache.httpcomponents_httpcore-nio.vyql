import code.{HttpInput, NetworkData, NetworkSend, FilePathAccess}

adapter groovy {
  package "org.apache.httpcomponents:httpcore-nio" {
    source method "read" -> code.NetworkData
    sink method "write" -> code.NetworkSend
    source method "requestReceived" -> code.HttpInput
    sink method "outputReady" -> code.NetworkSend
    source method "inputReady" -> code.NetworkData
    sink method "NFileEntity" -> code.FilePathAccess
  }
}
