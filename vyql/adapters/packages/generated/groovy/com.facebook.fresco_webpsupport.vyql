adapter groovy {
  package "com.facebook.fresco:webpsupport" {
    sink method "decodeByteBuffer" -> code.Deserialization
    sink method "decodeInputStream" -> code.Deserialization
    sink method "decodeFileDescriptor" -> code.Deserialization
    sink method "decodeStream" -> code.Deserialization
    sink method "decodeFile" -> code.Deserialization
    sink method "decodeByteArray" -> code.Deserialization
    sink method "hookDecodeResourceStream" -> code.Deserialization
    sink method "hookDecodeResource" -> code.Deserialization
  }
}
