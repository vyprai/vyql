import code.{NetworkSend, FilePathAccess, StdinInput}
import core.{UserControlledData}

adapter groovy {
  package "org.apache.httpcomponents:httpmime" {
    sink method "MultipartEntity.writeTo" -> code.NetworkSend
    sink method "FileBody" -> code.FilePathAccess
    source method "InputStreamBody" -> code.StdinInput
    source method "StringBody" -> core.UserControlledData
  }
}
