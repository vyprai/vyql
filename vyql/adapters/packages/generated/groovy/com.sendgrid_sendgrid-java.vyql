import code.{NetworkSend, NetworkConnect, HttpInput}
import core.{UserControlledData}

adapter groovy {
  package "com.sendgrid:sendgrid-java" {
    source method "addQueryParam" -> core.UserControlledData
    source method "addBody" -> core.UserControlledData
    source method "addHeaderParam" -> core.UserControlledData
    sink method "makeCall" -> code.NetworkSend
  }
}
