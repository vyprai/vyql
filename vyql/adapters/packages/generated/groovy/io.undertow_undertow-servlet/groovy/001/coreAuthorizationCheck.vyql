module bindings.groovy.migration.md570f727;

binding authorizationCheck1 {
  requires {
    dependency("io.undertow:undertow-servlet")
  }
  query pattern callExpr where callee.method == "canAccessResource"
  emit check core.AuthorizationCheck at call {
    covers path {
      from: call
      to: call
    }
  }
}
