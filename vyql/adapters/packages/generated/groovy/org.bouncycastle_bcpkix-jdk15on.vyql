import code.{Deserialization, SecretValue}

adapter groovy {
  package "org.bouncycastle:bcpkix-jdk15on" {
    sink method "parseBytes" -> code.Deserialization
    sink method "parseNonEmptyASN1" -> code.Deserialization
    sink method "parseStream" -> code.Deserialization
    source method "getPassword" -> code.SecretValue
  }
}
