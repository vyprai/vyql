adapter groovy {
  package "org.apache.poi:poi-scratchpad" {
    sink method "parse" -> code.Deserialization
    sink method "read" -> code.Deserialization
    sink method "process" -> code.Deserialization
    sink method "processMessage" -> code.Deserialization
    sink method "processAttachment" -> code.Deserialization
  }
}
