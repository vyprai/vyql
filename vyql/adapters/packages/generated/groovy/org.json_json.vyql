import code.{Deserialization}
import core.{HtmlEscape}

adapter groovy {
  package "org.json:json" {
    sink method "parse" -> code.Deserialization
    sink method "nextString" -> code.Deserialization
    sink method "nextTo" -> code.Deserialization
    control method "escape" -> core.HtmlEscape
    control method "unescape" -> core.HtmlEscape
  }
}
