import code.{NetworkData, NetworkSend}
adapter groovy {
  package "org.mule.connectors:mule-sockets-connector" {
    source method "read" -> code.NetworkData
    source method "sendAndReceive" -> code.NetworkData
    sink method "write" -> code.NetworkSend
    sink method "send" -> code.NetworkSend
    sink method "sendUdpPackages" -> code.NetworkSend
  }
}
