import code.{CodeEval, RedirectTarget, UrlFetch, SecretValue}

adapter groovy {
  package "com.codeborne:selenide" {
    flag code.RedirectTarget on any {
      method "open"
    }
    sink method "executeJavaScript" -> CodeEval
    sink method "executeAsyncJavaScript" -> CodeEval
    sink method "download" -> UrlFetch
    source method "sessionId" -> code.SecretValue
  }
}
