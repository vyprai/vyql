module bindings.groovy.migration.m18ea75ce;

binding weakCipher11 {
  requires {
    dependency("net.lingala.zip4j:zip4j")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
