adapter groovy {
  package "org.apache.pig:pig" {
    sink method "exec" -> code.CommandExecution
    sink method "file" -> code.FilePathAccess
    sink method "load" -> code.Deserialization
    flag code.WeakRandomValue on any {
      method "RANDOM"
    }
    flag code.WeakHash on any {
      method "sum"
    }
  }
}
