module bindings.powershell.migration.ma84ab135;

binding htmlEscape0 {
  requires {
    dependency("chosen.jquery")
  }
  query pattern callExpr where callee.method == "SelectParser.prototype.escapeExpression"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}
