import code.{NetworkData, NetworkSend, NetworkConnect, NetworkBind}

adapter c {
  package "usockets" {
    source method "us_quic_socket_context_on_stream_data" -> code.NetworkData
    sink method "us_quic_stream_write" -> code.NetworkSend
    sink method "us_quic_socket_context_send_headers" -> code.NetworkSend
    sink method "us_socket_context_listen" -> code.NetworkBind
    sink method "us_quic_socket_context_listen" -> code.NetworkBind
    sink method "us_socket_context_connect" -> code.NetworkConnect
    sink method "us_quic_socket_context_connect" -> code.NetworkConnect
  }
}
