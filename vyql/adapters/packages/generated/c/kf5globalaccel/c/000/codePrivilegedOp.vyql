module bindings.c.migration.mdfc1c7c8;

binding privilegedOp0 {
  requires {
    dependency("kf5globalaccel")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "stealShortcutSystemwide"
  emit issue code.PrivilegedOp at node
  emit sink code.PrivilegedOpSink at node
}
