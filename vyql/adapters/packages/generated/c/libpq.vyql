import code.{WeakHash, Deserialization}
adapter c {
  package "libpq" {
    flag code.WeakHash on any {
      method "pg_md5_init"
    }
    flag code.WeakHash on any {
      method "pg_md5_update"
    }
    flag code.WeakHash on any {
      method "pg_md5_final"
    }
    flag code.WeakHash on any {
      method "pg_sha1_init"
    }
    flag code.WeakHash on any {
      method "pg_sha1_update"
    }
    flag code.WeakHash on any {
      method "pg_sha1_final"
    }
    sink method "seg_yyparse" -> code.Deserialization
  }
}
