import code.{Deserialization, FilePathAccess}

adapter c {
  package "nanovg" {
    sink method "nvgCreateImage" -> code.FilePathAccess
    sink method "nvgCreateFont" -> code.FilePathAccess
    sink method "nvgCreateFontAtIndex" -> code.FilePathAccess
    sink method "nvgCreateFontMem" -> code.Deserialization
    sink method "nvgCreateFontMemAtIndex" -> code.Deserialization
    sink method "fonsAddFont" -> code.FilePathAccess
    sink method "fonsAddFontMem" -> code.Deserialization
    sink method "stbi_load" -> code.FilePathAccess
    sink method "stbi_load_from_memory" -> code.Deserialization
    sink method "stbi_load_from_callbacks" -> code.Deserialization
  }
}
