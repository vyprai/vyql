import code.{ExpressionEval}
import core.{UserControlledData}

adapter c {
  package "muparser" {
    source method "mupSetExpr" -> core.UserControlledData
    sink method "mupEval" -> code.ExpressionEval
    sink method "mupEvalMulti" -> code.ExpressionEval
    sink method "mupEvalBulk" -> code.ExpressionEval
  }
}
