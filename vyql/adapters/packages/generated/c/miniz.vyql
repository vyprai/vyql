import code.{Deserialization}
adapter c {
  package "miniz" {
    sink method "inflateInit" -> code.Deserialization
    sink method "inflateInit2" -> code.Deserialization
    sink method "inflateReset" -> code.Deserialization
    sink method "inflate" -> code.Deserialization
    sink method "inflateEnd" -> code.Deserialization
    sink method "uncompress" -> code.Deserialization
    sink method "uncompress2" -> code.Deserialization
  }
}
