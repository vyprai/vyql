import code.{WeakRandomValue}
adapter c {
  package "mbedtls" {
    flag code.WeakRandomValue on any {
      method "mbedtls_mpi_mod_random"
    }
    flag code.WeakRandomValue on any {
      method "mbedtls_mpi_core_fill_random"
    }
    flag code.WeakRandomValue on any {
      method "mbedtls_mpi_core_random"
    }
    flag code.WeakRandomValue on any {
      method "mbedtls_mpi_mod_raw_random"
    }
  }
}
