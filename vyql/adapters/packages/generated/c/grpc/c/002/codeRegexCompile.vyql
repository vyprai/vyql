module bindings.c.migration.m1850c2bf;

binding regexCompile2 {
  requires {
    dependency("grpc")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "CreateFromStringMatcher"
  emit issue code.RegexCompile at node
  emit sink code.RegexCompileSink at node
}
