import code.{FilePathAccess, ArchiveEntryWrite, StoredDataRead}

adapter c {
  package "kubazip" {
    sink method "zip_open" -> code.FilePathAccess
    sink method "zip_entry_open" -> code.FilePathAccess
    sink method "zip_entry_opencasesensitive" -> code.FilePathAccess
    sink method "zip_entry_openbyindex" -> code.FilePathAccess
    sink method "zip_entry_write" -> code.ArchiveEntryWrite
    source method "zip_entry_read" -> code.StoredDataRead
  }
}
