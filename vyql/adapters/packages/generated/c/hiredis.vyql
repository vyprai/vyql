import code.{Deserialization, NetworkConnect, NetworkData}

adapter c {
  package "hiredis" {
    sink method "redisReaderFeed" -> code.Deserialization
    sink method "redisReaderGetReply" -> code.Deserialization
    source method "redisNetWrite" -> code.NetworkData
    source method "redisNetRead" -> code.NetworkData
    sink method "redisContextConnectTcp" -> code.NetworkConnect
    sink method "redisContextConnectBindTcp" -> code.NetworkConnect
    sink method "redisContextConnectUnix" -> code.NetworkConnect
  }
}
