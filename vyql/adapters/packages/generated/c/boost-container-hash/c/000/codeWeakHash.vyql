module bindings.c.migration.m714f6a33;

binding weakHash0 {
  requires {
    dependency("boost-container-hash")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "hash_value"
  emit issue code.WeakHash at node
}
