import code.{Deserialization}
adapter c {
  package "chartdir" {
    sink method "load" -> code.Deserialization
    sink method "loadGIF" -> code.Deserialization
    sink method "loadPNG" -> code.Deserialization
    sink method "loadJPG" -> code.Deserialization
    sink method "loadWMP" -> code.Deserialization
  }
}
