import code.{Deserialization, StoredDataWrite}
adapter c {
  package "boost-serialization" {
    sink method "load_override" -> code.Deserialization
    sink method "serialize" -> code.Deserialization
    sink method "load_map_collection" -> code.Deserialization
    sink method "load_set_collection" -> code.Deserialization
    sink method "load_construct_data" -> code.Deserialization
    sink method "save" -> code.StoredDataWrite
  }
}
