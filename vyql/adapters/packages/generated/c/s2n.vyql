import code.{SecretValue}
import core.{AuthenticationCheck}

adapter c {
  package "s2n" {
    source method "s2n_cert_chain_and_key_load_pem" -> code.SecretValue
    source method "s2n_cert_chain_and_key_load_pem_bytes" -> code.SecretValue
    source method "s2n_cert_chain_and_key_load_public_pem_bytes" -> code.SecretValue
    control method "s2n_config_set_verification_ca_location" -> core.AuthenticationCheck
  }
}
