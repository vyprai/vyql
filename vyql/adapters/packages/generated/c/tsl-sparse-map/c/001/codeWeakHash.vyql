module bindings.c.migration.m24f1ac9c;

binding weakHash1 {
  requires {
    dependency("tsl-sparse-map")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "hash_key"
  emit issue code.WeakHash at node
}
