import code.{FilePathAccess, ArchiveEntryWrite}
adapter c {
  package "glpk" {
    sink method "glp_read_sol" -> code.FilePathAccess
    sink method "glp_read_mip" -> code.FilePathAccess
    sink method "glp_read_mps" -> code.FilePathAccess
    sink method "glp_read_lp" -> code.FilePathAccess
    sink method "glp_read_prob" -> code.FilePathAccess
    sink method "glp_write_sol" -> code.ArchiveEntryWrite
    sink method "glp_write_ipt" -> code.ArchiveEntryWrite
    sink method "glp_write_mip" -> code.ArchiveEntryWrite
    sink method "glp_write_mps" -> code.ArchiveEntryWrite
    sink method "glp_write_lp" -> code.ArchiveEntryWrite
  }
}
