module bindings.c.migration.mbb741b84;

binding weakRandomValue3 {
  requires {
    dependency("mbedtls")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "mbedtls_mpi_mod_raw_random"
