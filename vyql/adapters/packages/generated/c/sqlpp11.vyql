import code.{SqlExecution}
import core.{SqlParameterization}

adapter c {
  package "sqlpp11" {
    sink method "run" -> code.SqlExecution
    sink method "query" -> code.SqlExecution
    sink method "prepare_select" -> code.SqlExecution
    sink method "prepare_insert" -> code.SqlExecution
    sink method "run_prepared_insert" -> code.SqlExecution
    sink method "prepare_update" -> code.SqlExecution
    sink method "run_prepared_update" -> code.SqlExecution
    sink method "insert_into" -> code.SqlExecution
    control method "escape" -> core.SqlParameterization
  }
}
