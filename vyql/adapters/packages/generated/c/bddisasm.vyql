import code.{Deserialization, FilePathAccess}
adapter c {
  package "bddisasm" {
    sink method "nd_decode" -> code.Deserialization
    sink method "nd_decode_ex" -> code.Deserialization
    sink method "nd_decode_ex2" -> code.Deserialization
    sink method "nd_decode_with_context" -> code.Deserialization
    sink method "read_file" -> code.FilePathAccess
  }
}
