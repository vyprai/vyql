import code.{FilePathAccess}
adapter c {
  package "attr" {
    sink method "attr_get" -> code.FilePathAccess
    sink method "attr_set" -> code.FilePathAccess
    sink method "attr_remove" -> code.FilePathAccess
    sink method "attr_list" -> code.FilePathAccess
    sink method "attr_listf" -> code.FilePathAccess
    sink method "attr_multi" -> code.FilePathAccess
    sink method "attr_copy_file" -> code.FilePathAccess
    sink method "attr_copy_fd" -> code.FilePathAccess
    sink method "attr_copy_action" -> code.FilePathAccess
    sink method "walk_tree" -> code.FilePathAccess
  }
}
