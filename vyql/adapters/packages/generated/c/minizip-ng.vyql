import core.{PathCanonicalization, PathAccessCheck}

adapter c {
  package "minizip-ng" {
    control method "mz_path_combine" -> core.PathCanonicalization
    control method "mz_path_resolve" -> core.PathCanonicalization
    control method "mz_dir_has_unsafe_symlink" -> core.PathAccessCheck
    control method "mz_path_compare_wc" -> core.PathAccessCheck
  }
}
