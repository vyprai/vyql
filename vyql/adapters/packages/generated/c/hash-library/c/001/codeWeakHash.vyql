module bindings.c.migration.me42e1aa9;

binding weakHash1 {
  requires {
    dependency("hash-library")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "getHash"
  emit issue code.WeakHash at node
}
