import code.{FilePathAccess, Deserialization}
adapter c {
  package "libgeotiff" {
    sink method "XTIFFOpen" -> code.FilePathAccess
    sink method "XTIFFFdOpen" -> code.FilePathAccess
    sink method "XTIFFClientOpen" -> code.FilePathAccess
    sink method "XTIFFOpenExt" -> code.FilePathAccess
    sink method "XTIFFFdOpenExt" -> code.FilePathAccess
    sink method "XTIFFClientOpenExt" -> code.FilePathAccess
    sink method "GTIFImport" -> code.Deserialization
  }
}
