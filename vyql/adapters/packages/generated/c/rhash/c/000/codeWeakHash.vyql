module bindings.c.migration.mdbbb55eb;

binding weakHash0 {
  requires {
    dependency("rhash")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "load_updated_hash_file"
  emit issue code.WeakHash at node
}
