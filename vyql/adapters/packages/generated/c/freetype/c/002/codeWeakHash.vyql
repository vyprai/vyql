module bindings.c.migration.maa8603ad;

binding weakHash2 {
  requires {
    dependency("freetype")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "MD5_Final"
  emit issue code.WeakHash at node
}
