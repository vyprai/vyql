module bindings.c.migration.mf5b5c569;

binding weakHash3 {
  requires {
    dependency("libpq")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "pg_sha1_init"
  emit issue code.WeakHash at node
}
