import code.{FileUpload, SqlExecution}
import core.{UserControlledData}

adapter php {
  package "yajra/laravel-datatables-editor" {
    source method "dataFromRequest" -> core.UserControlledData
    sink method "create" -> code.SqlExecution
    sink method "edit" -> code.SqlExecution
    sink method "remove" -> code.SqlExecution
    flag code.FileUpload on any {
      method "upload"
    }
  }
}
