import code.{Deserialization, NetworkData, SecretValue}
import core.{UserControlledData}

adapter php {
  package "laravel/socialite" {
    source method "getUserByToken" -> code.NetworkData
    source method "mapUserToObject" -> core.UserControlledData
    source method "getAccessTokenResponse" -> code.NetworkData
    source method "setToken" -> code.SecretValue
    source method "setRefreshToken" -> code.SecretValue
  }
}
