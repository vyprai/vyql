import code.{NetworkSend, SecretValue}
import core.{AuthenticationCheck}

adapter php {
  package "nexmo/client-core" {
    sink method "send" -> code.NetworkSend
    sink method "get" -> code.NetworkSend
    sink method "post" -> code.NetworkSend
    sink method "put" -> code.NetworkSend
    sink method "delete" -> code.NetworkSend
    control method "signRequest" -> core.AuthenticationCheck
    control method "authRequest" -> core.AuthenticationCheck
    control method "generateJwt" -> core.AuthenticationCheck
    source method "getCredentials" -> code.SecretValue
  }
}
