module bindings.php.migration.m540714b3;

binding redirectTarget7 {
  requires {
    dependency("mpdf/mpdf")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "SetFormSubmit"
  emit issue code.RedirectTarget at node
  emit sink code.RedirectTargetSink at node
}
