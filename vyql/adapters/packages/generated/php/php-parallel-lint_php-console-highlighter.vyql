import code.{ExpressionEval}

adapter php {
  package "php-parallel-lint/php-console-highlighter" {
    sink method "getWholeFile" -> code.ExpressionEval
    sink method "getWholeFileWithLineNumbers" -> code.ExpressionEval
    sink method "getCodeSnippet" -> code.ExpressionEval
    sink method "tokenize" -> code.ExpressionEval
  }
}
