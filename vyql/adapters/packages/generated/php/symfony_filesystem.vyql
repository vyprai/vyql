import code.{FilePathAccess, FileUse}
adapter php {
  package "symfony/filesystem" {
    sink method "copy" -> code.FileUse
    sink method "mkdir" -> code.FilePathAccess
    sink method "exists" -> code.FilePathAccess
    sink method "touch" -> code.FilePathAccess
    sink method "remove" -> code.FilePathAccess
    sink method "rename" -> code.FilePathAccess
    sink method "symlink" -> code.FilePathAccess
    sink method "chmod" -> code.FilePathAccess
    sink method "chown" -> code.FilePathAccess
    sink method "dumpFile" -> code.FileUse
    sink method "appendToFile" -> code.FileUse
    sink method "mirror" -> code.FileUse
  }
}
