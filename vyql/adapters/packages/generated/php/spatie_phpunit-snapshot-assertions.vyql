import code.{FilePathAccess, FileUse}

adapter php {
  package "spatie/phpunit-snapshot-assertions" {
    sink method "Spatie\Snapshots\Filesystem::read" -> code.FilePathAccess
    sink method "Spatie\Snapshots\Filesystem::put" -> code.FileUse
    sink method "Spatie\Snapshots\Filesystem::delete" -> code.FileUse
    sink method "Spatie\Snapshots\Filesystem::copy" -> code.FileUse
  }
}
