module bindings.php.migration.m9d6302fc;

binding fileUpload2 {
  requires {
    dependency("php-http/discovery")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "Psr17Factory.createServerRequestFromGlobals"
  emit issue code.FileUpload at node
  emit source code.FileUploadSource at node
}
