import code.{HtmlRender, XmlParse}
import core.{UserControlledData}

adapter php {
  package "tijsverkoyen/css-to-inline-styles" {
    sink method "convert" -> code.HtmlRender
    sink method "inlineCssOnElement" -> code.HtmlRender
    sink method "createDomDocumentFromHtml" -> code.XmlParse
    source method "getRules" -> core.UserControlledData
    source method "getCssFromStyleTags" -> core.UserControlledData
  }
}
