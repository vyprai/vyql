import code.{UrlFetch, RedirectTarget, ResponseHeaderWrite, Cookie, HtmlRender, XpathQuery, HttpInput}
import core.{UserControlledData}
adapter php {
  package "behat/mink-browserkit-driver" {
    sink method "visit" -> code.UrlFetch
    flag code.RedirectTarget on any {
      method "visit"
    }
    sink method "setRequestHeader" -> code.ResponseHeaderWrite
    source method "setCookie" -> code.Cookie
    sink method "setValue" -> code.HtmlRender
    sink method "click" -> code.XpathQuery
    source method "submitForm" -> core.UserControlledData
  }
}
