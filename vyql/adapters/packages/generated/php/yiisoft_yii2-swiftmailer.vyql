import code.{FileUse, HtmlRender, NetworkSend}

adapter php {
  package "yiisoft/yii2-swiftmailer" {
    sink method "setTextBody" -> code.HtmlRender
    sink method "setHtmlBody" -> code.HtmlRender
    sink method "attach" -> code.FileUse
    sink method "attachContent" -> code.FileUse
    sink method "embed" -> code.FileUse
    sink method "embedContent" -> code.FileUse
    sink method "sendMessage" -> code.NetworkSend
  }
}
