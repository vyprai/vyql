adapter php {
  package "drupal/core" {
    sink method "insert" -> code.SqlExecution
    control method "prepareMachineName" -> core.SqlParameterization
    sink method "get" -> code.NosqlQuery
    sink method "settings" -> code.StoredDataWrite
    source method "token" -> code.SecretValue
    flag code.RegexCompile on any {
      method "RegExp"
    }
  }
}
