module bindings.php.migration.m1167df3a;

binding regexCompile0 {
  requires {
    dependency("consolidation/filter-via-dot-access-data")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "ConsolidationFilterOperatorsRegexOp::test"
