adapter php {
  package "yajra/laravel-datatables-buttons" {
    source method "request" -> code.HttpInput
    sink method "ajax" -> code.ResponseHeaderWrite
    sink method "response" -> code.ResponseHeaderWrite
    sink method "apply" -> code.SqlExecution
    sink method "streamOpenSpoutExport" -> code.FilePathAccess
    sink method "streamDownload" -> code.FilePathAccess
    sink method "snappyPdf" -> code.FilePathAccess
  }
}
