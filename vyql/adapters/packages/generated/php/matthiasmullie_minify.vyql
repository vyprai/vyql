import code.{FilePathAccess}

adapter php {
  package "matthiasmullie/minify" {
    sink method "addFile" -> code.FilePathAccess
    sink method "minify" -> code.FilePathAccess
    sink method "gzip" -> code.FilePathAccess
    sink method "execute" -> code.FilePathAccess
    sink method "importFiles" -> code.FilePathAccess
  }
}
