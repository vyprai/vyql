import code.{Deserialization}

adapter php {
  package "andrewsville/php-token-reflection" {
    sink method "processString" -> code.Deserialization
    sink method "processFile" -> code.Deserialization
    sink method "processPhar" -> code.Deserialization
    sink method "processDirectory" -> code.Deserialization
    sink method "process" -> code.Deserialization
  }
}
