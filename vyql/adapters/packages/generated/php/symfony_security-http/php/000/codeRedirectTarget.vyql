module bindings.php.migration.m2cffab7b;

binding redirectTarget0 {
  requires {
    dependency("symfony/security-http")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "createRedirectResponse"
  emit issue code.RedirectTarget at node
