import code.{HttpInput, RedirectTarget, ResponseHeaderWrite}
adapter php {
  package "slim/slim" {
    source method "addBodyParsingMiddleware" -> code.HttpInput
    flag code.RedirectTarget on any {
      method "handle"
    }
    sink method "emit" -> code.ResponseHeaderWrite
    flag code.RedirectTarget on any {
      method "redirect"
    }
  }
}
