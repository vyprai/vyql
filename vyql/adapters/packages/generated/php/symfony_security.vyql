import code.{SecretValue, RedirectTarget}
import core.{AuthenticationCheck, PathCanonicalization, CsrfProtection}

adapter php {
  package "symfony/security" {
    source method "getToken" -> code.SecretValue
    flag code.RedirectTarget on any {
      method "createRedirectResponse"
    }
    control method "generateUri" -> core.PathCanonicalization
    control method "checkRequestPath" -> core.PathCanonicalization
    control method "refreshToken" -> core.CsrfProtection
    source method "getPassword" -> code.SecretValue
    control method "isAccountNonLocked" -> core.AuthenticationCheck
    control method "isCredentialsNonExpired" -> core.AuthenticationCheck
  }
}
