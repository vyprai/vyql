import code.{FilePathAccess, StoredDataRead, StoredDataWrite}

adapter php {
  package "drupal/core-file-cache" {
    sink method "get" -> code.FilePathAccess
    sink method "getMultiple" -> code.FilePathAccess
    sink method "set" -> code.FilePathAccess
    sink method "delete" -> code.FilePathAccess
    source method "fetch" -> code.StoredDataRead
    sink method "store" -> code.StoredDataWrite
  }
}
