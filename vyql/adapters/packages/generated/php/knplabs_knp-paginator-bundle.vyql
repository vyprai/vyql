import code.{HttpInput}

adapter php {
  package "knplabs/knp-paginator-bundle" {
    source method "Knp\Bundle\PaginatorBundle\Helper\Processor::render" -> code.HttpInput
    source method "Knp\Bundle\PaginatorBundle\Helper\Processor::sortable" -> code.HttpInput
    source method "Knp\Bundle\PaginatorBundle\Helper\Processor::filter" -> code.HttpInput
    source method "Knp\Bundle\PaginatorBundle\Pagination\SlidingPagination::getParams" -> code.HttpInput
    source method "Knp\Bundle\PaginatorBundle\Pagination\SlidingPagination::getQuery" -> code.HttpInput
  }
}
