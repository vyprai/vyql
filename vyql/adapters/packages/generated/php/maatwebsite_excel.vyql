import code.{FilePathAccess, CodeEval}

adapter php {
  package "maatwebsite/excel" {
    sink method "import" -> code.FilePathAccess
    sink method "read" -> code.FilePathAccess
    sink method "toArray" -> code.FilePathAccess
    sink method "toCollection" -> code.FilePathAccess
    sink method "store" -> code.FilePathAccess
    sink method "download" -> code.FilePathAccess
  }
}
