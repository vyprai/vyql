module bindings.php.migration.m4685cbb4;

binding redirectTarget13 {
  requires {
    dependency("zendframework/zend-diactoros")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
