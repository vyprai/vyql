import code.{CommandExecution, NetworkSend}
import core.{UserControlledData}

adapter php {
  package "raven/raven" {
    sink method "exec" -> code.CommandExecution
    sink method "send" -> code.NetworkSend
    source method "captureMessage" -> core.UserControlledData
    source method "captureQuery" -> core.UserControlledData
  }
}
