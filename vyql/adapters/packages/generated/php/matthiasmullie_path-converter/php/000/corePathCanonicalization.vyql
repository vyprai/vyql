module bindings.php.generated.m2a59f34a;

binding pathCanonicalization0 {
  requires {
    dependency("matthiasmullie/path-converter")
  }
  query pattern callExpr where callee.method == "convert"
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
  }
}
