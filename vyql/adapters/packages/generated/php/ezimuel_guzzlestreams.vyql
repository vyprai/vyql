import code.{FilePathAccess, FileUse}

adapter php {
  package "ezimuel/guzzlestreams" {
    sink method "GuzzleHttp\Stream\Utils::open" -> code.FilePathAccess
    sink method "GuzzleHttp\Stream\GuzzleStreamWrapper::stream_open" -> code.FilePathAccess
    sink method "GuzzleHttp\Stream\Stream::read" -> code.FileUse
    sink method "GuzzleHttp\Stream\Stream::write" -> code.FileUse
  }
}
