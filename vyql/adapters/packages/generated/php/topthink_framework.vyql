adapter php {
  package "topthink/framework" {
    sink method "query" -> code.SqlExecution
    control method "bind" -> core.SqlParameterization
    source method "token" -> code.SecretValue
    source method "cookie" -> code.HttpInput
    sink method "write" -> code.FilePathAccess
    sink method "parse" -> code.XmlParse
    flag code.WeakHash on any {
      path "topthink.framework.hash"
    }
  }
}
