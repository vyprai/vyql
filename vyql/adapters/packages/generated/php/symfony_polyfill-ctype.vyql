import core.{InputValidation}

adapter php {
  package "symfony/polyfill-ctype" {
    control method "ctype_alnum" -> core.InputValidation
    control method "ctype_alpha" -> core.InputValidation
    control method "ctype_cntrl" -> core.InputValidation
    control method "ctype_digit" -> core.InputValidation
    control method "ctype_graph" -> core.InputValidation
    control method "ctype_lower" -> core.InputValidation
    control method "ctype_print" -> core.InputValidation
    control method "ctype_punct" -> core.InputValidation
    control method "ctype_space" -> core.InputValidation
    control method "ctype_upper" -> core.InputValidation
    control method "ctype_xdigit" -> core.InputValidation
  }
}
