adapter php {
  package "symfony/security-csrf" {
    control method "isTokenValid" -> core.AuthenticationCheck
    source method "getToken" -> code.SecretValue
    source method "refreshToken" -> code.SecretValue
    source method "generateToken" -> code.SecretValue
    source method "setToken" -> code.SecretValue
    source method "hasToken" -> code.SecretValue
  }
}
