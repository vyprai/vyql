adapter php {
  package "laracasts/flash" {
    sink method "info" -> code.HtmlRender
    sink method "success" -> code.HtmlRender
    sink method "error" -> code.HtmlRender
    sink method "warning" -> code.HtmlRender
    sink method "message" -> code.HtmlRender
    sink method "overlay" -> code.HtmlRender
    sink method "flash" -> code.HtmlRender
  }
}
