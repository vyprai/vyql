adapter php {
  package "thecodingmachine/safe" {
    sink method "exec" -> code.CommandExecution
    sink method "system" -> code.CommandExecution
    sink method "opendir" -> code.FilePathAccess
    sink method "eio_chmod" -> code.FilePathAccess
    sink method "eio_chown" -> code.FilePathAccess
    sink method "eio_mkdir" -> code.FilePathAccess
    sink method "eio_mknod" -> code.FilePathAccess
    sink method "eio_rename" -> code.FilePathAccess
    sink method "eio_rmdir" -> code.FilePathAccess
    sink method "eio_symlink" -> code.FilePathAccess
    sink method "eio_truncate" -> code.FilePathAccess
    sink method "eio_unlink" -> code.FilePathAccess
    sink method "eio_write" -> code.FileUse
    sink method "eio_readahead" -> code.FileUse
    sink method "eio_readdir" -> code.FileUse
    sink method "eio_readlink" -> code.FileUse
    sink method "eio_stat" -> code.FilePathAccess
    sink method "eio_statvfs" -> code.FilePathAccess
    sink method "eio_sendfile" -> code.FileUse
    sink method "eio_sync_file_range" -> code.FileUse
  }
}
