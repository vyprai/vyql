import code.{FilePathAccess}

adapter php {
  package "league/flysystem-local" {
    sink method "write" -> code.FilePathAccess
    sink method "writeStream" -> code.FilePathAccess
    sink method "delete" -> code.FilePathAccess
    sink method "deleteDirectory" -> code.FilePathAccess
    sink method "createDirectory" -> code.FilePathAccess
    sink method "copy" -> code.FilePathAccess
    sink method "move" -> code.FilePathAccess
    sink method "read" -> code.FilePathAccess
    sink method "readStream" -> code.FilePathAccess
  }
}
