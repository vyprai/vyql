adapter php {
  package "nette/http" {
    source method "getQuery" -> code.HttpInput
    source method "getPost" -> code.HttpInput
    flag code.FileUpload on any {
      method "getFiles"
    }
    source method "getCookies" -> code.Cookie
    source method "getHeader" -> code.HttpInput
    source method "getHeaders" -> code.HttpInput
  }
}
