binding authenticationCheck24 {
  requires {
    dependency("pestphp/pest-plugin-laravel")
  }
  query pattern callExpr where callee.method == "withBasicAuth"
  emit check core.AuthenticationCheck at call {
    covers path {
      from: call
      to: call
    }
  }
}
