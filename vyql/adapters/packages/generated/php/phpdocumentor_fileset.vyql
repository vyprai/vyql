import code.{FilePathAccess}
adapter php {
  package "phpdocumentor/fileset" {
    sink method "addDirectory" -> code.FilePathAccess
    sink method "addFiles" -> code.FilePathAccess
    sink method "addFile" -> code.FilePathAccess
    sink method "fread" -> code.FilePathAccess
    sink method "getMimeType" -> code.FilePathAccess
  }
}
