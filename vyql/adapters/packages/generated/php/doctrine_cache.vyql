import code.{StoredDataRead, StoredDataWrite}

adapter php {
  package "doctrine/cache" {
    sink method "save" -> code.StoredDataWrite
    sink method "saveMultiple" -> code.StoredDataWrite
    source method "fetch" -> code.StoredDataRead
    source method "fetchMultiple" -> code.StoredDataRead
    sink method "delete" -> code.StoredDataWrite
    sink method "deleteMultiple" -> code.StoredDataWrite
  }
}
