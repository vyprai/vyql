import code.{UrlFetch, HttpInput, RedirectTarget}

adapter php {
  package "guzzle/http" {
    sink method "createRequest" -> code.UrlFetch
    sink method "send" -> code.UrlFetch
    sink method "buildUrl" -> code.UrlFetch
    sink method "setPath" -> code.UrlFetch
    sink method "addPath" -> code.UrlFetch
    sink method "setQuery" -> code.UrlFetch
    sink method "combine" -> code.UrlFetch
  }
}
