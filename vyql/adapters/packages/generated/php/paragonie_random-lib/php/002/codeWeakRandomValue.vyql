module bindings.php.migration.mf48d19e2;

binding weakRandomValue2 {
  requires {
    dependency("paragonie/random-lib")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "RandomLib\\Generator::generateString"
