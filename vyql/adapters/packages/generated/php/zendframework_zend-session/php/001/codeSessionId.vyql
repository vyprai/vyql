module bindings.php.migration.m95a22b16;

binding sessionId1 {
  requires {
    dependency("zendframework/zend-session")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "start"
  emit issue code.SessionId at node
  emit sink code.SessionIdSink at node
}
