module bindings.php.migration.mb76847d9;

binding redirectTarget5 {
  requires {
    dependency("drupal/drupal-extension")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "iFollowLinkInMailToWithSubject"
  emit issue code.RedirectTarget at node
  emit sink code.RedirectTargetSink at node
}
