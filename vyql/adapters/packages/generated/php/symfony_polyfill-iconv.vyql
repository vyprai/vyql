import code.{Deserialization}
import core.{InputValidation}

adapter php {
  package "symfony/polyfill-iconv" {
    sink method "iconv" -> code.Deserialization
    sink method "iconv_mime_decode" -> code.Deserialization
    sink method "iconv_mime_decode_headers" -> code.Deserialization
    control method "iconv_strlen" -> core.InputValidation
    control method "iconv_strpos" -> core.InputValidation
    control method "iconv_strrpos" -> core.InputValidation
    control method "iconv_substr" -> core.InputValidation
  }
}
