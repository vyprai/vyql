module bindings.php.migration.m3a5e7773;

binding fileUpload4 {
  requires {
    dependency("yajra/laravel-datatables-editor")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "upload"
  emit issue code.FileUpload at node
  emit source code.FileUploadSource at node
}
