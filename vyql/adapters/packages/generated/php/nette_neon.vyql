import code.{Deserialization, FilePathAccess}

adapter php {
  package "nette/neon" {
    sink method "Nette\Neon\Decoder::decode" -> code.Deserialization
    sink method "Nette\Neon\Decoder::parseToNode" -> code.Deserialization
    sink method "Nette\Neon\Neon::decode" -> code.Deserialization
    sink method "Nette\Neon\Neon::decodeFile" -> code.Deserialization
    sink method "Nette\Neon\Neon::decodeFile" -> code.FilePathAccess
    sink method "Nette\Neon\Lexer::tokenize" -> code.Deserialization
    sink method "Nette\Neon\Parser::parse" -> code.Deserialization
  }
}
