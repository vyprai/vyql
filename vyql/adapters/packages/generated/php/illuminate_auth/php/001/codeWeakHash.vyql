module bindings.php.migration.m00733b29;

binding weakHash1 {
  requires {
    dependency("illuminate/auth")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "illuminate.auth.hash"
  emit issue code.WeakHash at node
}
