module bindings.php.migration.m47de4297;

binding pathCanonicalization1 {
  requires {
    dependency("cakephp/plugin-installer")
  }
  query pattern callExpr where callee.method == "getFullPath"
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
  }
}
