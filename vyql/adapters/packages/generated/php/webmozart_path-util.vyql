import core.{PathCanonicalization, InputValidation}

adapter php {
  package "webmozart/path-util" {
    control method "canonicalize" -> core.PathCanonicalization
    control method "normalize" -> core.PathCanonicalization
    control method "isAbsolute" -> core.InputValidation
    control method "isRelative" -> core.InputValidation
    control method "isLocal" -> core.InputValidation
  }
}
