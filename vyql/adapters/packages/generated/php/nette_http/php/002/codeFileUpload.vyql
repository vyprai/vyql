module bindings.php.migration.m3722870d;

binding fileUpload2 {
  requires {
    dependency("nette/http")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "getFiles"
  emit issue code.FileUpload at node
  emit source code.FileUploadSource at node
}
