import code.{RedirectTarget, UrlFetch}
adapter php {
  package "mcamara/laravel-localization" {
    flag code.RedirectTarget on any {
      method "localizeURL"
    }
    flag code.RedirectTarget on any {
      method "getLocalizedURL"
    }
    flag code.RedirectTarget on any {
      method "getNonLocalizedURL"
    }
  }
}
