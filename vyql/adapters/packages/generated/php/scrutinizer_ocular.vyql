import code.{CommandExecution, SecretValue}
import core.{UserControlledData}

adapter php {
  package "scrutinizer/ocular" {
    source method "Scrutinizer\\Ocular\\Command\\CodeCoverage\\UploadCommand::execute" -> core.UserControlledData
    source method "Scrutinizer\\Ocular\\Command\\CodeCoverage\\UploadCommand::generatePostData" -> core.UserControlledData
    source method "Scrutinizer\\Ocular\\Configuration::getAccessToken" -> code.SecretValue
  }
}
