adapter php {
  package "fruitcake/php-cors" {
    control method "isCorsRequest" -> core.InputValidation
    control method "isPreflightRequest" -> core.InputValidation
    sink method "handlePreflightRequest" -> code.ResponseHeaderWrite
    sink method "addPreflightRequestHeaders" -> code.ResponseHeaderWrite
    sink method "addActualRequestHeaders" -> code.ResponseHeaderWrite
    control method "isOriginAllowed" -> core.AuthorizationCheck
    sink method "configureAllowedOrigin" -> code.ResponseHeaderWrite
    sink method "configureAllowedMethods" -> code.ResponseHeaderWrite
    sink method "configureAllowedHeaders" -> code.ResponseHeaderWrite
    sink method "configureAllowCredentials" -> code.ResponseHeaderWrite
    sink method "configureExposedHeaders" -> code.ResponseHeaderWrite
    sink method "configureMaxAge" -> code.ResponseHeaderWrite
    sink method "varyHeader" -> code.ResponseHeaderWrite
  }
}
