import code.{FilePathAccess, FileUse}
adapter php {
  package "zetacomponents/base" {
    sink method "ezcBase::autoload" -> code.FileUse
    sink method "ezcBase::requireFile" -> code.FilePathAccess
    sink method "ezcBase::loadFile" -> code.FilePathAccess
    sink method "ezcBase::loadExternalFile" -> code.FilePathAccess
    sink method "ezcBase::addClassRepository" -> code.FilePathAccess
    sink method "ezcBaseFile::copyRecursive" -> code.FilePathAccess
    sink method "ezcBaseFile::copy" -> code.FilePathAccess
    sink method "ezcBaseFile::createTemporaryFile" -> code.FilePathAccess
    sink method "ezcBaseFile::createTemporaryDir" -> code.FilePathAccess
    sink method "ezcBaseFile::removeRecursive" -> code.FilePathAccess
  }
}
