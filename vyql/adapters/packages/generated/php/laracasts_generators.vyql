import code.{CliArgument, CodeEval}

adapter php {
  package "laracasts/generators" {
    source method "fire" -> code.CliArgument
    source method "compileMigrationStub" -> code.CliArgument
    source method "replaceSchema" -> code.CliArgument
    sink method "fire" -> code.CodeEval
    sink method "compileMigrationStub" -> code.CodeEval
    sink method "replaceSchema" -> code.CodeEval
  }
}
