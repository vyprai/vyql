import code.{SecretValue}
import core.{InputValidation, UserControlledData}

adapter php {
  package "symfonycasts/verify-email-bundle" {
    source method "generateSignature" -> core.UserControlledData
    control method "validateEmailConfirmation" -> core.InputValidation
    control method "validateEmailConfirmationFromRequest" -> core.InputValidation
  }
}
