import code.{HttpInput, SecretValue, UrlFetch}

adapter php {
  package "codeception/module-phpbrowser" {
    sink method "setHeader" -> code.UrlFetch
    sink method "amOnUrl" -> code.UrlFetch
    source method "amHttpAuthenticated" -> code.SecretValue
    source method "setAuth" -> code.SecretValue
  }
}
