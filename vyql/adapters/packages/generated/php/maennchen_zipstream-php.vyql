import code.{ArchiveEntryWrite, FilePathAccess}
import core.{InputValidation}

adapter php {
  package "maennchen/zipstream-php" {
    sink method "addFile" -> code.ArchiveEntryWrite
    sink method "addFileFromPath" -> code.FilePathAccess
    sink method "addFileFromStream" -> code.ArchiveEntryWrite
    sink method "addFileFromPsr7Stream" -> code.ArchiveEntryWrite
    sink method "addFileFromCallback" -> code.ArchiveEntryWrite
    control method "filterFilename" -> core.InputValidation
  }
}
