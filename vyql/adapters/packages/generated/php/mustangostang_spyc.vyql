import code.{Deserialization}
adapter php {
  package "mustangostang/spyc" {
    sink method "YAMLLoad" -> code.Deserialization
    sink method "YAMLLoadString" -> code.Deserialization
    sink method "load" -> code.Deserialization
    sink method "loadFile" -> code.Deserialization
    sink method "spyc_load" -> code.Deserialization
    sink method "spyc_load_file" -> code.Deserialization
  }
}
