adapter php {
  package "kreait/firebase-php" {
    control method "sendEmailVerificationLink" -> core.AuthenticationCheck
    control method "sendPasswordResetLink" -> core.AuthenticationCheck
    control method "sendSignInWithEmailLink" -> core.AuthenticationCheck
    source method "createCustomToken" -> code.SecretValue
    control method "verifyIdToken" -> core.AuthenticationCheck
    control method "verifySessionCookie" -> core.AuthenticationCheck
  }
}
