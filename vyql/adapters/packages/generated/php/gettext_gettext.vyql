import code.{Deserialization, FilePathAccess}

adapter php {
  package "gettext/gettext" {
    sink method "loadFile" -> code.FilePathAccess
    sink method "loadFile" -> code.Deserialization
    sink method "loadString" -> code.Deserialization
    sink method "readFile" -> code.FilePathAccess
    sink method "decode" -> code.Deserialization
  }
}
