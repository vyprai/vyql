import code.{RedirectTarget}
import core.{HtmlEscape}

adapter php {
  package "knplabs/knp-menu" {
    control method "Knp\Menu\Renderer\Renderer::escape" -> core.HtmlEscape
    flag code.RedirectTarget on any {
      method "Knp\Menu\MenuItem::setUri"
    }
    control method "Knp\Menu\MenuItem::setLabel" -> core.HtmlEscape
  }
}
