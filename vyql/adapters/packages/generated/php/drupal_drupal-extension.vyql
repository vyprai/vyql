import code.{NetworkSend, RedirectTarget}

adapter php {
  package "drupal/drupal-extension" {
    sink method "iSendMail" -> code.NetworkSend
    sink method "iSendEmail" -> code.NetworkSend
    flag code.RedirectTarget on any {
      method "iFollowLinkInMail"
    }
    flag code.RedirectTarget on any {
      method "iFollowLinkInMailTo"
    }
    flag code.RedirectTarget on any {
      method "iFollowLinkInMailWithSubject"
    }
    flag code.RedirectTarget on any {
      method "iFollowLinkInMailToWithSubject"
    }
    flag code.RedirectTarget on any {
      method "iFollowLinkInEmail"
    }
    flag code.RedirectTarget on any {
      method "iFollowLinkInEmailTo"
    }
    flag code.RedirectTarget on any {
      method "iFollowLinkInEmailWithSubject"
    }
    flag code.RedirectTarget on any {
      method "iFollowLinkInEmailToWithSubject"
    }
  }
}
