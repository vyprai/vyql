import code.{NetworkData, NetworkSend, SecretValue}

adapter php {
  package "grpc/grpc" {
    sink method "UnaryCall" -> code.NetworkSend
    sink method "ClientStreamingCall" -> code.NetworkSend
    sink method "ServerStreamingCall" -> code.NetworkSend
    sink method "BidiStreamingCall" -> code.NetworkSend
    source method "UnaryCall" -> code.NetworkData
    source method "ClientStreamingCall" -> code.NetworkData
    source method "ServerStreamingCall" -> code.NetworkData
    source method "BidiStreamingCall" -> code.NetworkData
    source method "setCallCredentials" -> code.SecretValue
  }
}
