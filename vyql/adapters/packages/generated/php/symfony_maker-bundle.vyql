import code.{FilePathAccess}
import core.{UserControlledData}

adapter php {
  package "symfony/maker-bundle" {
    sink method "dumpFile" -> code.FilePathAccess
    sink method "generateFile" -> code.FilePathAccess
    source method "asCommand" -> core.UserControlledData
    source method "asFilePath" -> core.UserControlledData
  }
}
