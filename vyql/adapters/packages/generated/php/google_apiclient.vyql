import code.{SecretValue, RedirectTarget}
import core.{AuthenticationCheck, AuthorizationCheck}

adapter php {
  package "google/apiclient" {
    source method "getClientSecret" -> code.SecretValue
    source method "getRefreshToken" -> code.SecretValue
    source method "getAccessToken" -> code.SecretValue
    source method "fetchAccessTokenWithAuthCode" -> code.SecretValue
    source method "fetchAccessTokenWithAssertion" -> code.SecretValue
    source method "fetchAccessTokenWithRefreshToken" -> code.SecretValue
    source method "refreshTokenWithAssertion" -> code.SecretValue
    source method "refreshToken" -> code.SecretValue

    control method "authenticate" -> core.AuthenticationCheck
    control method "authorize" -> core.AuthorizationCheck

    mark method "setRedirectUri" -> code.RedirectTarget
    mark method "createAuthUrl" -> code.RedirectTarget
  }
}
