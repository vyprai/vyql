adapter php {
  package "laminas/laminas-mvc" {
    source method "getRequest" -> code.HttpInput
    sink method "fromFiles" -> code.FilePathAccess
    source method "fromHeader" -> code.HttpInput
    source method "fromPost" -> code.HttpInput
    source method "fromQuery" -> code.HttpInput
    source method "fromRoute" -> code.HttpInput
    sink method "getResponse" -> code.ResponseHeaderWrite
  }
}
