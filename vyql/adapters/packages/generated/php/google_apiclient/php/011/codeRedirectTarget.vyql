module bindings.php.migration.m3625d3eb;

binding redirectTarget11 {
  requires {
    dependency("google/apiclient")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "createAuthUrl"
  emit issue code.RedirectTarget at node
  emit sink code.RedirectTargetSink at node
}
