import code.{FilePathAccess, HtmlRender, FileUse}
adapter php {
  package "milon/barcode" {
    sink method "setStorPath" -> code.FilePathAccess
    sink method "getBarcodeHTML" -> code.HtmlRender
    sink method "getBarcodeSVG" -> code.FileUse
    sink method "getBarcodePNGPath" -> code.FileUse
    sink method "getBarcodeJPGPath" -> code.FileUse
  }
}
