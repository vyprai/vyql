import code.{Deserialization, CommandExecution, UrlFetch}
import core.{UserControlledData}

adapter php {
  package "illuminate/routing" {
    sink method "RouteUri::parse" -> code.Deserialization
    source method "UrlGenerator::query" -> core.UserControlledData
    sink method "Route::run" -> code.CommandExecution
    sink method "Route::runCallable" -> code.CommandExecution
    sink method "Route::runController" -> code.CommandExecution
  }
}
