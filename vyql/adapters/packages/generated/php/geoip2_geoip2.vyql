import code.{DatabaseRead}

adapter php {
  package "geoip2/geoip2" {
    sink method "anonymousIp" -> code.DatabaseRead
    sink method "anonymousPlus" -> code.DatabaseRead
    sink method "asn" -> code.DatabaseRead
    sink method "city" -> code.DatabaseRead
    sink method "connectionType" -> code.DatabaseRead
    sink method "country" -> code.DatabaseRead
    sink method "domain" -> code.DatabaseRead
    sink method "enterprise" -> code.DatabaseRead
    sink method "isp" -> code.DatabaseRead
  }
}
