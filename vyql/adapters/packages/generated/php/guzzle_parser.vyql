import code.{UrlFetch, Cookie, HttpInput}

adapter php {
  package "guzzle/parser" {
    sink method "parseUrl" -> code.UrlFetch
    source method "parseCookie" -> code.Cookie
    source method "parseRequest" -> code.HttpInput
    source method "parseResponse" -> code.HttpInput
    sink method "expand" -> code.UrlFetch
  }
}
