import code.{NetworkConnect, NetworkSend}
adapter php {
  package "guzzlehttp/guzzle" {
    sink method "sendAsync" -> code.NetworkConnect
    sink method "sendAsync" -> code.NetworkSend
    sink method "send" -> code.NetworkConnect
    sink method "send" -> code.NetworkSend
    sink method "requestAsync" -> code.NetworkConnect
    sink method "requestAsync" -> code.NetworkSend
    sink method "request" -> code.NetworkConnect
    sink method "request" -> code.NetworkSend
  }
}
