import core.{AuthenticationCheck, InputValidation}
import code.{NetworkConnect, NetworkSend}

adapter php {
  package "pusher/pusher-php-server" {
    control method "authenticateUser" -> core.AuthenticationCheck
    control method "authorizeChannel" -> core.AuthenticationCheck
    control method "authorizePresenceChannel" -> core.AuthenticationCheck
    control method "verifySignature" -> core.InputValidation
    sink method "trigger" -> code.NetworkSend
    sink method "triggerAsync" -> code.NetworkSend
    sink method "sendToUserAsync" -> code.NetworkSend
    sink method "make_request" -> code.NetworkConnect
    sink method "make_batch_request" -> code.NetworkConnect
    sink method "triggerBatchAsync" -> code.NetworkSend
    sink method "terminateUserConnectionsAsync" -> code.NetworkConnect
    sink method "get" -> code.NetworkConnect
    sink method "post" -> code.NetworkConnect
    sink method "postAsync" -> code.NetworkConnect
  }
}
