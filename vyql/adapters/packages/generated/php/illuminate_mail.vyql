import code.{FilePathAccess, HtmlRender, TemplateRender, UrlFetch}

adapter php {
  package "illuminate/mail" {
    sink method "send" -> code.HtmlRender
    sink method "raw" -> code.HtmlRender
    sink method "parse" -> code.TemplateRender
    sink method "attach" -> code.FilePathAccess
    sink method "embed" -> code.FilePathAccess
    sink method "fromPath" -> code.FilePathAccess
    sink method "fromUrl" -> code.UrlFetch
    sink method "fromUploadedFile" -> code.FilePathAccess
  }
}
