import code.{FilePathAccess, Deserialization}

adapter php {
  package "league/mime-type-detection" {
    sink method "League\MimeTypeDetection\FinfoMimeTypeDetector::detectMimeTypeFromFile" -> code.FilePathAccess
    sink method "League\MimeTypeDetection\FinfoMimeTypeDetector::detectMimeTypeFromBuffer" -> code.Deserialization
    sink method "League\MimeTypeDetection\FinfoMimeTypeDetector::detectMimeType" -> code.FilePathAccess
    sink method "League\MimeTypeDetection\FinfoMimeTypeDetector::detectMimeType" -> code.Deserialization
  }
}
