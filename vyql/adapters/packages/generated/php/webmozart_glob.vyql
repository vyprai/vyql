import code.{RegexCompile}

adapter php {
  package "webmozart/glob" {
    flag code.RegexCompile on any {
      method "Webmozart\\Glob\\Glob::toRegEx"
    }
    flag code.RegexCompile on any {
      method "Webmozart\\Glob\\Glob::match"
    }
    flag code.RegexCompile on any {
      method "Webmozart\\Glob\\Glob::filter"
    }
  }
}
