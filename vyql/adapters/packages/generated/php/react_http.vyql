import code.{HttpInput, UrlFetch, NetworkSend, Deserialization}
import core.{UserControlledData}

adapter php {
  package "react/http" {
    sink method "React\Http\Browser.get" -> code.UrlFetch
    sink method "React\Http\Browser.post" -> code.UrlFetch
    sink method "React\Http\Browser.post" -> code.NetworkSend
    sink method "React\Http\Browser.request" -> code.UrlFetch
    sink method "React\Http\Browser.request" -> code.NetworkSend
    sink method "React\Http\Browser.requestStreaming" -> code.UrlFetch
    sink method "React\Http\Browser.requestStreaming" -> code.NetworkSend
    source method "React\Http\Io\MultipartParser.parse" -> core.UserControlledData
    sink method "React\Http\Io\MultipartParser.parse" -> code.Deserialization
  }
}
