import code.{SecretValue, UrlFetch}
import core.{AuthenticationCheck, InputValidation, AuthorizationCheck}

adapter php {
  package "laravel/passport" {
    source method "secret" -> code.SecretValue
    sink method "redirectUris" -> code.UrlFetch
    control method "validate" -> core.AuthenticationCheck
    control method "can" -> core.AuthorizationCheck
    control method "cant" -> core.AuthorizationCheck
  }
}
