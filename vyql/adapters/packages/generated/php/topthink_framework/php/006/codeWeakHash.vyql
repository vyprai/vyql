module bindings.php.migration.mb928c19c;

binding weakHash6 {
  requires {
    dependency("topthink/framework")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "topthink.framework.hash"
  emit issue code.WeakHash at node
}
