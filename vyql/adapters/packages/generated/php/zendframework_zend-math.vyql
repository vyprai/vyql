import code.{WeakRandomValue}
adapter php {
  package "zendframework/zend-math" {
    flag code.WeakRandomValue on any {
      method "Zend\Math\Rand::getBytes"
    }
    flag code.WeakRandomValue on any {
      method "Zend\Math\Rand::getBoolean"
    }
    flag code.WeakRandomValue on any {
      method "Zend\Math\Rand::getInteger"
    }
    flag code.WeakRandomValue on any {
      method "Zend\Math\Rand::getFloat"
    }
    flag code.WeakRandomValue on any {
      method "Zend\Math\Rand::getString"
    }
  }
}
