import code.{WeakRandomValue}
adapter php {
  package "zendframework/zend-math" {
    mark method "Zend\Math\Rand::getBytes" -> code.WeakRandomValue
    mark method "Zend\Math\Rand::getBoolean" -> code.WeakRandomValue
    mark method "Zend\Math\Rand::getInteger" -> code.WeakRandomValue
    mark method "Zend\Math\Rand::getFloat" -> code.WeakRandomValue
    mark method "Zend\Math\Rand::getString" -> code.WeakRandomValue
  }
}
