import code.{NetworkSend}
adapter php {
  package "braintree/braintree_php" {
    sink method "delete" -> code.NetworkSend
    sink method "get" -> code.NetworkSend
    sink method "post" -> code.NetworkSend
    sink method "postMultipart" -> code.NetworkSend
    sink method "put" -> code.NetworkSend
    sink method "query" -> code.NetworkSend
  }
}
