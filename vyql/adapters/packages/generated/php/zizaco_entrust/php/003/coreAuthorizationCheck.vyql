binding authorizationCheck3 {
  requires {
    dependency("zizaco/entrust")
  }
  query pattern callExpr where callee.method == "routeNeedsRoleOrPermission"
  emit check core.AuthorizationCheck at call {
    covers path {
      from: call
      to: call
    }
  }
}
