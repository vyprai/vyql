import code.{Deserialization, FilePathAccess, FileUse}
adapter php {
  package "laminas/laminas-config" {
    sink method "fromFile" -> code.FilePathAccess
    sink method "fromString" -> code.Deserialization
    sink method "decode" -> code.Deserialization
    sink method "parse" -> code.Deserialization
    sink method "process" -> code.Deserialization
  }
}
