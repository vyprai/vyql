module bindings.php.migration.ma10f8a15;

binding authorizationCheck5 {
  requires {
    dependency("fruitcake/php-cors")
  }
  query pattern callExpr where callee.method == "isOriginAllowed"
  emit check core.AuthorizationCheck at call {
    covers path {
      from: call
      to: call
    }
  }
}
