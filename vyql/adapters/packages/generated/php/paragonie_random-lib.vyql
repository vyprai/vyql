import code.{WeakRandomValue}

adapter php {
  package "paragonie/random-lib" {
    flag code.WeakRandomValue on any {
      method "RandomLib\\Generator::generate"
    }
    flag code.WeakRandomValue on any {
      method "RandomLib\\Generator::generateInt"
    }
    flag code.WeakRandomValue on any {
      method "RandomLib\\Generator::generateString"
    }
  }
}
