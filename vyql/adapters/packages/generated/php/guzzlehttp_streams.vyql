import code.{FilePathAccess, NetworkData}

adapter php {
  package "guzzlehttp/streams" {
    sink method "GuzzleHttp\Stream\Utils::open" -> code.FilePathAccess
    sink method "GuzzleHttp\Stream\GuzzleStreamWrapper::stream_open" -> code.FilePathAccess
    source method "GuzzleHttp\Stream\Stream::write" -> code.NetworkData
    source method "GuzzleHttp\Stream\GuzzleStreamWrapper::stream_write" -> code.NetworkData
  }
}
