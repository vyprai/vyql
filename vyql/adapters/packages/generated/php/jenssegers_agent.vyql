import core.{UserControlledData}

adapter php {
  package "jenssegers/agent" {
    source method "browser" -> core.UserControlledData
    source method "platform" -> core.UserControlledData
    source method "device" -> core.UserControlledData
    source method "isDesktop" -> core.UserControlledData
    source method "isPhone" -> core.UserControlledData
    source method "robot" -> core.UserControlledData
    source method "isRobot" -> core.UserControlledData
    source method "languages" -> core.UserControlledData
  }
}
