module bindings.php.migration.mec5dfadc;

binding weakHash4 {
  requires {
    dependency("laravel/framework")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "laravel.framework.hash"
  emit issue code.WeakHash at node
}
