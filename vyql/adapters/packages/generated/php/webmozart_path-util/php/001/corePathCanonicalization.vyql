module bindings.php.migration.m2e4e2d62;

binding pathCanonicalization1 {
  requires {
    dependency("webmozart/path-util")
  }
  query pattern callExpr where callee.method == "normalize"
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
  }
}
