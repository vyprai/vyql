module bindings.php.generated.m2e4e2d62;

binding pathCanonicalization0 {
  requires {
    dependency("webmozart/path-util")
  }
  query pattern callExpr where callee.method == "canonicalize"
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
  }
}
