import code.{NetworkSend}

adapter php {
  package "facade/flare-client-php" {
    sink method "sendReportsInBatches" -> code.NetworkSend
    sink method "sendReportToApi" -> code.NetworkSend
    sink method "get" -> code.NetworkSend
    sink method "post" -> code.NetworkSend
    sink method "patch" -> code.NetworkSend
  }
}
