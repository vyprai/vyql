import code.{Deserialization, FilePathAccess}

adapter php {
  package "hassankhan/config" {
    sink method "parseFile" -> code.Deserialization
    sink method "parseString" -> code.Deserialization
    sink method "parse" -> code.Deserialization
    sink method "eval" -> code.Deserialization
    sink method "load" -> code.FilePathAccess
    sink method "loadFromFile" -> code.FilePathAccess
  }
}
