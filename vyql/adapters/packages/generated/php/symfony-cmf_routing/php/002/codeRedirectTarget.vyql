module bindings.php.migration.m23fc3e07;

binding redirectTarget2 {
  requires {
    dependency("symfony-cmf/routing")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "generate"
  emit issue code.RedirectTarget at node
  emit sink code.RedirectTargetSink at node
}
