import code.{FilePathAccess, ArchiveEntryWrite}
adapter php {
  package "pear/archive_tar" {
    sink method "create" -> code.ArchiveEntryWrite
    sink method "add" -> code.ArchiveEntryWrite
    sink method "addString" -> code.ArchiveEntryWrite
    sink method "createModify" -> code.ArchiveEntryWrite
    sink method "addModify" -> code.ArchiveEntryWrite
    sink method "extract" -> code.FilePathAccess
    sink method "extractModify" -> code.FilePathAccess
    sink method "extractInString" -> code.FilePathAccess
    sink method "extractList" -> code.FilePathAccess
  }
}
