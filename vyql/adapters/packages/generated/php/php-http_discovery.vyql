import code.{FilePathAccess, FileUpload, HttpInput, NetworkSend}

adapter php {
  package "php-http/discovery" {
    source method "Psr17Factory.createServerRequestFromGlobals" -> code.HttpInput
    source method "Psr17Factory.createServerRequestFromGlobals" -> core.UserControlledData
    mark method "Psr17Factory.createServerRequestFromGlobals" -> code.FileUpload
    sink method "Psr17Factory.createStreamFromFile" -> code.FilePathAccess
    sink method "Psr18Client.sendRequest" -> code.NetworkSend
  }
}
