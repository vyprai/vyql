module bindings.php.migration.m121e19aa;

binding regexCompile1 {
  requires {
    dependency("webmozart/glob")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "Webmozart\\Glob\\Glob::match"
  emit issue code.RegexCompile at node
  emit sink code.RegexCompileSink at node
}
