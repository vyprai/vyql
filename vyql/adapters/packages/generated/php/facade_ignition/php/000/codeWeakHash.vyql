module bindings.php.migration.mcbcf73ce;

binding weakHash0 {
  requires {
    dependency("facade/ignition")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "facade.ignition.hash"
  emit issue code.WeakHash at node
}
