adapter php {
  package "zendframework/zend-diactoros" {
    source method "ServerRequest::getCookieParams" -> code.Cookie
    source method "ServerRequest::getQueryParams" -> code.HttpInput
    source method "ServerRequest::getParsedBody" -> code.HttpInput
    source method "RequestTrait::getUri" -> code.HttpInput

    source method "ServerRequest::withCookieParams" -> code.Cookie
    sink method "ServerRequest::withQueryParams" -> code.UrlFetch
    sink method "ServerRequest::withParsedBody" -> code.UrlFetch
    sink method "MessageTrait::withHeader" -> code.ResponseHeaderWrite
    sink method "MessageTrait::withAddedHeader" -> code.ResponseHeaderWrite
    sink method "MessageTrait::withoutHeader" -> code.ResponseHeaderWrite
    sink method "Stream::write" -> code.FilePathAccess
    sink method "CallbackStream::write" -> code.FilePathAccess
    sink method "RelativeStream::write" -> code.FilePathAccess
    mark method "RequestTrait::withUri" -> code.RedirectTarget
  }
}
