import code.{Deserialization, FilePathAccess}

adapter php {
  package "phar-io/manifest" {
    sink method "ManifestLoader::fromFile" -> code.Deserialization
    sink method "ManifestLoader::fromPhar" -> code.Deserialization
    sink method "ManifestLoader::fromString" -> code.Deserialization
    sink method "ManifestDocument::fromFile" -> code.Deserialization
    sink method "ManifestDocument::fromString" -> code.Deserialization
  }
}
