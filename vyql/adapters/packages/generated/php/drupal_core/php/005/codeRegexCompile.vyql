module bindings.php.migration.m5d32eb5a;

binding regexCompile5 {
  requires {
    dependency("drupal/core")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "RegExp"
  emit issue code.RegexCompile at node
  emit sink code.RegexCompileSink at node
}
