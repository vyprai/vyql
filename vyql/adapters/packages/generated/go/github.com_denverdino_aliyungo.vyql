import code.{NetworkConnect, NetworkSend, SecretValue}

adapter go {
  package "github.com/denverdino/aliyungo" {
    sink method "httpPost" -> code.NetworkConnect
    sink method "httpPost" -> code.NetworkSend
    sink method "HttpGet" -> code.NetworkConnect
    sink method "HttpGet" -> code.NetworkSend
    sink method "HttpDelete" -> code.NetworkConnect
    sink method "HttpDelete" -> code.NetworkSend
  }
}
