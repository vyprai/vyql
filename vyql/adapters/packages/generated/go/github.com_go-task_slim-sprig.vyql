import code.{RegexCompile, WeakHash}

adapter go {
  package "github.com/go-task/slim-sprig" {
    flag code.WeakHash on any {
      method "sha1sum"
    }
    flag code.WeakHash on any {
      method "adler32sum"
    }
    flag code.WeakHash on any {
      method "derivePassword"
    }
    flag code.RegexCompile on any {
      method "regexMatch"
    }
    flag code.RegexCompile on any {
      method "regexFindAll"
    }
    flag code.RegexCompile on any {
      method "regexFind"
    }
    flag code.RegexCompile on any {
      method "regexReplaceAll"
    }
  }
}
