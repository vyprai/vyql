import code.{WeakRandomValue}

adapter go {
  package "github.com/openzipkin/zipkin-go" {
    flag code.WeakRandomValue on any {
      method "NewRandom64"
    }
    flag code.WeakRandomValue on any {
      method "NewRandom128"
    }
    flag code.WeakRandomValue on any {
      method "NewRandomTimestamped"
    }
  }
}
