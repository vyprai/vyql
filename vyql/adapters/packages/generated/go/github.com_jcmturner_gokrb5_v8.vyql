adapter go {
  package "github.com/jcmturner/gokrb5/v8" {
    control method "NewWithPassword" -> core.AuthenticationCheck
    control method "NewWithKeytab" -> core.AuthenticationCheck
    control method "NewFromCCache" -> core.AuthenticationCheck
    source method "GetKeyFromPassword" -> code.SecretValue
    source method "Load" -> code.SecretValue
    source method "ChangePasswdMsg" -> code.SecretValue
    control method "SPNEGOKRB5Authenticate" -> core.AuthenticationCheck
  }
}
