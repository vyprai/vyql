adapter go {
  package "github.com/go-redis/redis" {
    sink method "Get" -> code.NosqlQuery
    sink method "SetBit" -> code.StoredDataWrite
    source method "Auth" -> code.SecretValue
    flag code.WeakRandomValue on any {
      method "Random"
    }
    flag code.WeakHash on any {
      method "Hash"
    }
  }
}
