adapter go {
  package "github.com/gookit/color" {
    sink method "Fprint" -> code.HtmlRender
    sink method "Fprintf" -> code.HtmlRender
    sink method "Fprintln" -> code.HtmlRender
    sink method "RenderCode" -> code.HtmlRender
    sink method "RenderWithSpaces" -> code.HtmlRender
    sink method "RenderString" -> code.HtmlRender
    sink method "ReplaceTag" -> code.HtmlRender
    sink method "ParseCodeFromAttr" -> code.Deserialization
  }
}
