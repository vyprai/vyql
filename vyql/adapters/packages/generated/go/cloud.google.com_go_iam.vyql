import code.{NetworkConnect, NetworkSend}

adapter go {
  package "cloud.google.com/go/iam" {
    sink method "executeHTTPRequestWithResponse" -> code.NetworkConnect
    sink method "executeHTTPRequestWithResponse" -> code.NetworkSend
    sink method "executeHTTPRequest" -> code.NetworkConnect
    sink method "executeHTTPRequest" -> code.NetworkSend
    sink method "executeStreamingHTTPRequest" -> code.NetworkConnect
    sink method "executeStreamingHTTPRequest" -> code.NetworkSend
  }
}
