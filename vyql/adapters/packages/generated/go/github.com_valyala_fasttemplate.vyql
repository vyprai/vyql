adapter go {
  package "github.com/valyala/fasttemplate" {
    sink method "ExecuteFunc" -> code.TemplateRender
    sink method "ExecuteFuncString" -> code.TemplateRender
    sink method "ExecuteFuncStringWithErr" -> code.TemplateRender
    sink method "Execute" -> code.TemplateRender
    sink method "ExecuteStd" -> code.TemplateRender
    sink method "ExecuteString" -> code.TemplateRender
    sink method "ExecuteStringStd" -> code.TemplateRender
  }
}
