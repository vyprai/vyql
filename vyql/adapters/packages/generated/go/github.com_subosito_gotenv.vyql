adapter go {
  package "github.com/subosito/gotenv" {
    source method "Load" -> core.UserControlledData
    source method "OverLoad" -> core.UserControlledData
    source method "Apply" -> core.UserControlledData
    source method "OverApply" -> core.UserControlledData
    source method "Parse" -> core.UserControlledData
    source method "StrictParse" -> core.UserControlledData
    source method "Read" -> core.UserControlledData
    source method "Unmarshal" -> core.UserControlledData
    sink method "Write" -> code.StoredDataWrite
  }
}
