import code.{FilePathAccess, SecretValue}
import core.{UserControlledData}

adapter go {
  package "github.com/gorilla/sessions" {
    source method "newCookieFromOptions" -> core.UserControlledData
    source method "NewCookieStore" -> code.SecretValue
    sink method "NewFilesystemStore" -> code.FilePathAccess
  }
}
