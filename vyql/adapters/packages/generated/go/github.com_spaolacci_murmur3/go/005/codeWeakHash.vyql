module bindings.go.migration.m50f7fc36;

binding weakHash5 {
  requires {
    dependency("github.com/spaolacci/murmur3")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "New64WithSeed"
  emit issue code.WeakHash at node
}
