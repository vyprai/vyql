import code.{Deserialization}

adapter go {
  package "github.com/go-ini/ini" {
    sink method "Load" -> code.Deserialization
    sink method "LooseLoad" -> code.Deserialization
    sink method "InsensitiveLoad" -> code.Deserialization
    sink method "ShadowLoad" -> code.Deserialization
    sink method "LoadSources" -> code.Deserialization
  }
}
