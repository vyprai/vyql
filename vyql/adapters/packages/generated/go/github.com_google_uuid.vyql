import code.{Deserialization, WeakHash}

adapter go {
  package "github.com/google/uuid" {
    sink method "Parse" -> code.Deserialization
    sink method "ParseBytes" -> code.Deserialization
    sink method "MustParse" -> code.Deserialization
    mark method "NewMD5" -> code.WeakHash
    mark method "NewSHA1" -> code.WeakHash
  }
}
