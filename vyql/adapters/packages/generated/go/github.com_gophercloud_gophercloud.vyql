import code.{SecretValue, UrlFetch, NetworkConnect}

adapter go {
  package "github.com/gophercloud/gophercloud" {
    source method "AuthenticatedClient" -> code.SecretValue
    source method "Authenticate" -> code.SecretValue
    source method "AuthenticateV2" -> code.SecretValue
    source method "AuthenticateV3" -> code.SecretValue
    sink method "Request" -> code.UrlFetch
    sink method "ParseResponse" -> code.NetworkConnect
  }
}
