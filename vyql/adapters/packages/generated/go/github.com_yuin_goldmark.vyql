import code.{Deserialization, FilePathAccess}
import core.{HtmlEscape, InputValidation}

adapter go {
  package "github.com/yuin/goldmark" {
    sink method "Convert" -> code.Deserialization
    control method "EscapeHTML" -> core.HtmlEscape
    control method "URLEscape" -> core.InputValidation
  }
}
