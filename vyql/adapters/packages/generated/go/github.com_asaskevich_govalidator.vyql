import code.{RegexCompile}
import core.{InputValidation, PathCanonicalization}

adapter go {
  package "github.com/asaskevich/govalidator" {
    flag code.RegexCompile on any {
      method "Matches"
    }
    flag code.RegexCompile on any {
      method "StringMatches"
    }
    control method "SafeFileName" -> core.PathCanonicalization
    control method "IsFilePath" -> core.InputValidation
    control method "IsWinFilePath" -> core.InputValidation
    control method "IsUnixFilePath" -> core.InputValidation
    control method "IsURL" -> core.InputValidation
    control method "IsRequestURL" -> core.InputValidation
    control method "IsRequestURI" -> core.InputValidation
    control method "NormalizeEmail" -> core.InputValidation
    control method "ByteLength" -> core.InputValidation
    control method "RuneLength" -> core.InputValidation
    control method "StringLength" -> core.InputValidation
    control method "MinStringLength" -> core.InputValidation
    control method "MaxStringLength" -> core.InputValidation
    control method "Range" -> core.InputValidation
    control method "IsInRaw" -> core.InputValidation
  }
}
