import code.{Deserialization}

adapter go {
  package "github.com/jcmturner/gofork" {
    sink method "parseBool" -> code.Deserialization
    sink method "parseInt64" -> code.Deserialization
    sink method "parseInt32" -> code.Deserialization
    sink method "parseBigInt" -> code.Deserialization
    sink method "parseBitString" -> code.Deserialization
    sink method "parseObjectIdentifier" -> code.Deserialization
    sink method "parseBase128Int" -> code.Deserialization
    sink method "parseUTCTime" -> code.Deserialization
    sink method "parseGeneralizedTime" -> code.Deserialization
    sink method "parsePrintableString" -> code.Deserialization
    sink method "parseIA5String" -> code.Deserialization
    sink method "parseT61String" -> code.Deserialization
    sink method "parseUTF8String" -> code.Deserialization
    sink method "parseTagAndLength" -> code.Deserialization
    sink method "parseSequenceOf" -> code.Deserialization
    sink method "parseField" -> code.Deserialization
  }
}
