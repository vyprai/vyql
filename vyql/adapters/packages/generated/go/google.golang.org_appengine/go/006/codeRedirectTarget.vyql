module bindings.go.migration.md6dcc4ff;

binding redirectTarget6 {
  requires {
    dependency("google.golang.org/appengine")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "LoginURLFederated"
  emit issue code.RedirectTarget at node
  emit sink code.RedirectTargetSink at node
}
