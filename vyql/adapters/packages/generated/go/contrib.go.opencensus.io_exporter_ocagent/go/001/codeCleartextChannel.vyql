module bindings.go.migration.m364c6374;

binding cleartextChannel1 {
  requires {
    dependency("contrib.go.opencensus.io/exporter/ocagent")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "WithInsecure"
  emit issue code.CleartextChannel at node
}
