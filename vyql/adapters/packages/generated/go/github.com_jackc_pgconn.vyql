import code.{NetworkConnect, SecretValue}
adapter go {
  package "github.com/jackc/pgconn" {
    sink method "Connect" -> code.NetworkConnect
    source method "Connect" -> core.UserControlledData
    sink method "ConnectWithOptions" -> code.NetworkConnect
    source method "ConnectWithOptions" -> core.UserControlledData
    source method "ParseConfig" -> core.UserControlledData
    source method "ParseConfigWithOptions" -> core.UserControlledData
    source method "newScramClient" -> code.SecretValue
  }
}
