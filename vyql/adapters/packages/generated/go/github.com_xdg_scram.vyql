import code.{Deserialization, SecretValue}
import core.{AuthenticationCheck}

adapter go {
  package "github.com/xdg/scram" {
    sink method "parseField" -> code.Deserialization
    sink method "parseGS2Flag" -> code.Deserialization
    sink method "parseFieldBase64" -> code.Deserialization
    sink method "parseFieldInt" -> code.Deserialization
    sink method "parseClientFirst" -> code.Deserialization
    sink method "parseClientFinal" -> code.Deserialization
    sink method "parseServerFirst" -> code.Deserialization
    sink method "parseServerFinal" -> code.Deserialization
    
    source method "newClient" -> code.SecretValue
    source method "newServer" -> code.SecretValue
    
    control method "decodeName" -> core.AuthenticationCheck
    control method "encodeName" -> core.AuthenticationCheck
  }
}
