module bindings.go.migration.m7d6b69dc;

binding authorizationCheck5 {
  requires {
    dependency("github.com/samuel/go-zookeeper")
  }
  query pattern callExpr where callee.method == "SetACL"
  emit check core.AuthorizationCheck at call {
    covers path {
      from: call
      to: call
    }
  }
}
