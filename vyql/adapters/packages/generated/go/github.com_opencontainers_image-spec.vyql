import code.{Deserialization}

adapter go {
  package "github.com/opencontainers/image-spec" {
    sink method "validateManifest" -> code.Deserialization
    sink method "validateDescriptor" -> code.Deserialization
    sink method "validateIndex" -> code.Deserialization
    sink method "validateConfig" -> code.Deserialization
  }
}
