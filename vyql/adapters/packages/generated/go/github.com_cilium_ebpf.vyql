import code.{FilePathAccess, FileUse, Deserialization}

adapter go {
  package "github.com/cilium/ebpf" {
    sink method "LoadPinnedMap" -> code.FilePathAccess
    sink method "LoadPinnedProgram" -> code.FilePathAccess
    sink method "LoadSpec" -> code.FilePathAccess
    sink method "LoadSpecFromReader" -> code.FileUse
    sink method "LoadSpecAndExtInfosFromReader" -> code.FileUse
    sink method "unmarshalMap" -> code.Deserialization
    sink method "unmarshalProgram" -> code.Deserialization
  }
}
