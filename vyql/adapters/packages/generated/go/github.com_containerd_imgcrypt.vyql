import code.{SecretValue, WeakCipher}
adapter go {
  package "github.com/containerd/imgcrypt" {
    source method "processPwdString" -> code.SecretValue
    source method "processPrivateKeyFiles" -> code.SecretValue
    source method "getGPGPrivateKeys" -> code.SecretValue
    source method "CreateDecryptCryptoConfig" -> code.SecretValue
    source method "CreateCryptoConfig" -> code.SecretValue
    flag code.WeakCipher on any {
      method "EncryptImage"
    }
    flag code.WeakCipher on any {
      method "DecryptImage"
    }
    flag code.WeakCipher on any {
      method "encryptLayer"
    }
    flag code.WeakCipher on any {
      method "decryptLayer"
    }
  }
}
