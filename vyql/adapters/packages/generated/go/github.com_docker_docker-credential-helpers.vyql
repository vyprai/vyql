import code.{CommandExecution, SecretValue}

adapter go {
  package "github.com/docker/docker-credential-helpers" {
    sink method "NewShellProgramFunc" -> code.CommandExecution
    sink method "NewShellProgramFuncWithEnv" -> code.CommandExecution
    sink method "createProgramCmdRedirectErr" -> code.CommandExecution
    source method "Store" -> code.SecretValue
    source method "Get" -> code.SecretValue
    source method "Erase" -> code.SecretValue
  }
}
