import code.{HttpInput, SecretValue, RedirectTarget}
adapter go {
  package "google.golang.org/appengine" {
    source method "NewContext" -> code.HttpInput
    source method "WithContext" -> code.HttpInput
    source method "AccessToken" -> code.SecretValue
    source method "CurrentOAuth" -> code.HttpInput
    source method "OAuthConsumerKey" -> code.SecretValue
    flag code.RedirectTarget on any {
      method "LoginURL"
    }
    flag code.RedirectTarget on any {
      method "LoginURLFederated"
    }
    flag code.RedirectTarget on any {
      method "LogoutURL"
    }
  }
}
