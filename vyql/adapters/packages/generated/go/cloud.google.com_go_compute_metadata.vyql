import code.{NetworkData}

adapter go {
  package "cloud.google.com/go/compute/metadata" {
    source method "Get" -> code.NetworkData
    source method "GetWithContext" -> code.NetworkData
    source method "InstanceAttributeValue" -> code.NetworkData
    source method "InstanceAttributeValueWithContext" -> code.NetworkData
    source method "ProjectAttributeValue" -> code.NetworkData
    source method "ProjectAttributeValueWithContext" -> code.NetworkData
  }
}
