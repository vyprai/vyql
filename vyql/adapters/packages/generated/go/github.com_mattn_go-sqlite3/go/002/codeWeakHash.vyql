module bindings.go.migration.m85270cdc;

binding weakHash2 {
  requires {
    dependency("github.com/mattn/go-sqlite3")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
