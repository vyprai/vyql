import core.{AuthenticationCheck, UserControlledData}

adapter go {
  package "golang.org/x/build" {
    control method "BasicAuth" -> core.AuthenticationCheck
    control method "GitCookiesAuth" -> core.AuthenticationCheck
    control method "GitCookieFileAuth" -> core.AuthenticationCheck
    control method "OAuth2Auth" -> core.AuthenticationCheck
    control method "DigestAuth" -> core.AuthenticationCheck
  }
}
