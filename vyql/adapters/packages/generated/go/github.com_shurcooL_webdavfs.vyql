import code.{FilePathAccess, FileUse}

adapter go {
  package "github.com/shurcooL/webdavfs" {
    sink method "Create" -> code.FilePathAccess
    sink method "Open" -> code.FilePathAccess
    sink method "ReadDir" -> code.FilePathAccess
    sink method "Stat" -> code.FilePathAccess
    sink method "WriteFile" -> code.FileUse
    sink method "MkdirAll" -> code.FilePathAccess
  }
}
