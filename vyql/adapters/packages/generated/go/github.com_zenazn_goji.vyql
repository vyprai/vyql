import code.{HttpInput}
adapter go {
  package "github.com/zenazn/goji" {
    source method "Connect" -> code.HttpInput
    source method "Delete" -> code.HttpInput
    source method "Get" -> code.HttpInput
    source method "Head" -> code.HttpInput
    source method "Options" -> code.HttpInput
    source method "Patch" -> code.HttpInput
    source method "Post" -> code.HttpInput
    source method "Put" -> code.HttpInput
    source method "Trace" -> code.HttpInput
  }
}
