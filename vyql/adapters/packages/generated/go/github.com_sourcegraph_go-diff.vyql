import code.{Deserialization}

adapter go {
  package "github.com/sourcegraph/go-diff" {
    sink method "ParseMultiFileDiff" -> code.Deserialization
    sink method "ParseMultiFileDiffOptions" -> code.Deserialization
    sink method "ParseFileDiff" -> code.Deserialization
    sink method "ParseFileDiffOptions" -> code.Deserialization
    sink method "ParseHunks" -> code.Deserialization
    sink method "ParseHunksOptions" -> code.Deserialization
  }
}
