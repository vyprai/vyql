import code.{WeakHash}
adapter go {
  package "github.com/spaolacci/murmur3" {
    flag code.WeakHash on any {
      method "New32"
    }
    flag code.WeakHash on any {
      method "New32WithSeed"
    }
    flag code.WeakHash on any {
      method "Sum32"
    }
    flag code.WeakHash on any {
      method "Sum32WithSeed"
    }
    flag code.WeakHash on any {
      method "New64"
    }
    flag code.WeakHash on any {
      method "New64WithSeed"
    }
    flag code.WeakHash on any {
      method "Sum64"
    }
    flag code.WeakHash on any {
      method "Sum64WithSeed"
    }
    flag code.WeakHash on any {
      method "New128"
    }
    flag code.WeakHash on any {
      method "New128WithSeed"
    }
    flag code.WeakHash on any {
      method "Sum128"
    }
    flag code.WeakHash on any {
      method "Sum128WithSeed"
    }
  }
}
