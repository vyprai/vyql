module bindings.go.migration.m417c0eb3;

binding regexCompile4 {
  requires {
    dependency("github.com/go-task/slim-sprig")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "regexFindAll"
  emit issue code.RegexCompile at node
  emit sink code.RegexCompileSink at node
}
