module bindings.go.migration.m417c0eb3;

binding weakHash1 {
  requires {
    dependency("github.com/go-task/slim-sprig")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
