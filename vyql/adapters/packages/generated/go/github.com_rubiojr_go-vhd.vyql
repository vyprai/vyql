import code.{FilePathAccess, FileUse}

adapter go {
  package "github.com/rubiojr/go-vhd" {
    sink method "createVHD" -> code.FilePathAccess
    sink method "rawToFixed" -> code.FilePathAccess
    sink method "vhdInfo" -> code.FilePathAccess
    sink method "VHDCreateSparse" -> code.FilePathAccess
    sink method "RawToFixed" -> code.FileUse
    sink method "FromFile" -> code.FileUse
  }
}
