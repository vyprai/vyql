import code.{WeakHash}
adapter go {
  package "github.com/dgryski/go-farm" {
    flag code.WeakHash on any {
      method "Hash32"
    }
    flag code.WeakHash on any {
      method "Hash32WithSeed"
    }
    flag code.WeakHash on any {
      method "Hash64"
    }
    flag code.WeakHash on any {
      method "Hash64WithSeed"
    }
    flag code.WeakHash on any {
      method "Hash64WithSeeds"
    }
    flag code.WeakHash on any {
      method "Hash128"
    }
    flag code.WeakHash on any {
      method "Hash128WithSeed"
    }
  }
}
