import code.{LogOutput}

adapter go {
  package "github.com/davecgh/go-spew" {
    sink method "Errorf" -> code.LogOutput
    sink method "Fprint" -> code.LogOutput
    sink method "Fprintf" -> code.LogOutput
    sink method "Fprintln" -> code.LogOutput
    sink method "Print" -> code.LogOutput
    sink method "Printf" -> code.LogOutput
    sink method "Println" -> code.LogOutput
    sink method "Sprint" -> code.LogOutput
    sink method "Sprintf" -> code.LogOutput
    sink method "Sprintln" -> code.LogOutput
    sink method "Dump" -> code.LogOutput
    sink method "ConfigState.Dump" -> code.LogOutput
  }
}
