import code.{NetworkConnect, NetworkData, FilePathAccess, Deserialization}

adapter go {
  package "github.com/Microsoft/go-winio" {
    sink method "DialPipe" -> code.NetworkConnect
    sink method "DialPipeContext" -> code.NetworkConnect
    sink method "DialPipeAccess" -> code.NetworkConnect
    sink method "DialPipeAccessImpLevel" -> code.NetworkConnect
    source method "ListenPipe" -> code.NetworkData
    sink method "OpenForBackup" -> code.FilePathAccess
    sink method "parseEa" -> code.Deserialization
    sink method "DecodeExtendedAttributes" -> code.Deserialization
  }
}
