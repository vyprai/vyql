import code.{FilePathAccess, NetworkSend}
import core.{UserControlledData}

adapter go {
  package "github.com/yudai/pp" {
    sink method "Fprint" -> code.FilePathAccess
    sink method "Fprint" -> code.NetworkSend
    source method "Fprint" -> core.UserControlledData
    sink method "Fprintf" -> code.FilePathAccess
    sink method "Fprintf" -> code.NetworkSend
    source method "Fprintf" -> core.UserControlledData
    sink method "Fprintln" -> code.FilePathAccess
    sink method "Fprintln" -> code.NetworkSend
    source method "Fprintln" -> core.UserControlledData
  }
}
