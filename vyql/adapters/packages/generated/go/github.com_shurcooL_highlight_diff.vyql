import core.{HtmlEscape}

adapter go {
  package "github.com/shurcooL/highlight_diff" {
    source method "NewScanner" -> core.UserControlledData
    source method "Annotate" -> core.UserControlledData
    source method "HighlightedDiffFunc" -> core.UserControlledData
    sink method "Print" -> code.HtmlRender
    control method "Print" -> core.HtmlEscape
  }
}
