adapter go {
  package "github.com/aws/aws-sdk-go-v2/config" {
    source method "LoadDefaultConfig" -> core.UserControlledData
    source method "getSharedConfigProfile" -> core.UserControlledData
    sink method "getSharedConfigFiles" -> code.FilePathAccess
    sink method "getSharedCredentialsFiles" -> code.FilePathAccess
    sink method "getCustomCABundle" -> code.FilePathAccess
    source method "getCredentialsProvider" -> code.SecretValue
    source method "getBearerAuthTokenProvider" -> code.SecretValue
    sink method "parse" -> code.Deserialization
  }
}
