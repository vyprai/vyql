import code.{Deserialization, NetworkConnect, NetworkData, SecretValue}
import core.{AuthenticationCheck, UserControlledData}

adapter go {
  package "github.com/gliderlabs/ssh" {
    source method "Serve" -> code.NetworkData
    source method "ListenAndServe" -> code.NetworkData
    sink method "ParseAuthorizedKey" -> code.Deserialization
    sink method "ParsePublicKey" -> code.Deserialization
    control method "PasswordAuth" -> core.AuthenticationCheck
    source method "SetAgentRequested" -> core.UserControlledData
    source method "AgentRequested" -> core.UserControlledData
    source method "NewAgentListener" -> code.NetworkData
    sink method "ForwardAgentConnections" -> code.NetworkConnect
    source method "parsePtyRequest" -> core.UserControlledData
    source method "parseWinchRequest" -> core.UserControlledData
    source method "parseString" -> core.UserControlledData
    source method "parseUint32" -> core.UserControlledData
  }
}
