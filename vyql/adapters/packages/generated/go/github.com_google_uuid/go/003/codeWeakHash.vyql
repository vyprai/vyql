module bindings.go.migration.m000d1d82;

binding weakHash3 {
  requires {
    dependency("github.com/google/uuid")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "NewMD5"
  emit issue code.WeakHash at node
}
