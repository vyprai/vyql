import code.{Deserialization, FilePathAccess}
import core.{UserControlledData}

adapter go {
  package "github.com/xeipuuv/gojsonschema" {
    sink method "Validate" -> code.Deserialization
    sink method "NewReferenceLoader" -> code.FilePathAccess
    source method "NewStringLoader" -> core.UserControlledData
    source method "NewBytesLoader" -> core.UserControlledData
    source method "NewReaderLoader" -> core.UserControlledData
  }
}
