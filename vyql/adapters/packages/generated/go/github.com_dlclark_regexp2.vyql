import code.{RegexCompile}
import core.{InputValidation}

adapter go {
  package "github.com/dlclark/regexp2" {
    flag code.RegexCompile on any {
      method "Compile"
    }
    flag code.RegexCompile on any {
      method "MustCompile"
    }
    control method "Escape" -> core.InputValidation
  }
}
