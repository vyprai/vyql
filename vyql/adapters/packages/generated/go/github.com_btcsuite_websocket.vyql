import code.{NetworkSend, NetworkData, NetworkConnect}

adapter go {
  package "github.com/btcsuite/websocket" {
    sink method "WriteControl" -> code.NetworkSend
    sink method "Write" -> code.NetworkSend
    sink method "WriteString" -> code.NetworkSend
    sink method "WriteMessage" -> code.NetworkSend
    source method "Read" -> code.NetworkData
    source method "ReadMessage" -> code.NetworkData
    sink method "Dial" -> code.NetworkConnect
    sink method "Upgrade" -> code.NetworkConnect
  }
}
