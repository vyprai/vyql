module bindings.go.migration.me2bfc398;

binding weakHash1 {
  requires {
    dependency("github.com/cespare/xxhash/v2")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
