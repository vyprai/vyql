module bindings.go.migration.m93dbd5f2;

binding pathCanonicalization1 {
  requires {
    dependency("github.com/opencontainers/runtime-tools")
  }
  query pattern callExpr where callee.method == "Clean"
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
  }
}
