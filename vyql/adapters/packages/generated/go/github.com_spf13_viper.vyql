import code.{Deserialization, FilePathAccess, CliArgument, EnvVariable, SecretValue}

adapter go {
  package "github.com/spf13/viper" {
    sink method "Unmarshal" -> code.Deserialization
    sink method "UnmarshalKey" -> code.Deserialization
    sink method "UnmarshalExact" -> code.Deserialization
    sink method "SetConfigFile" -> code.FilePathAccess
    sink method "AddConfigPath" -> code.FilePathAccess
    source method "BindEnv" -> code.EnvVariable
    source method "BindPFlags" -> code.CliArgument
    source method "BindPFlag" -> code.CliArgument
    source method "BindFlagValues" -> code.CliArgument
    source method "BindFlagValue" -> code.CliArgument
  }
}
