import code.{NetworkConnect, NetworkData}

adapter go {
  package "go.opentelemetry.io/otel/exporters/otlp" {
    sink method "WithTracesEndpoint" -> code.NetworkConnect
    sink method "WithMetricsEndpoint" -> code.NetworkConnect
    source method "WithTracesHeaders" -> code.NetworkData
    source method "WithMetricsHeaders" -> code.NetworkData
  }
}
