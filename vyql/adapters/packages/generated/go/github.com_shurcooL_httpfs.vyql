import code.{FileUse, FilePathAccess, TemplateRender}
import core.{PathCanonicalization}

adapter go {
  package "github.com/shurcooL/httpfs" {
    sink method "ReadFile" -> code.FilePathAccess
    sink method "Walk" -> code.FileUse
    sink method "WalkFiles" -> code.FileUse
    sink method "Glob" -> code.FilePathAccess
    sink method "ParseFiles" -> code.TemplateRender
    sink method "ParseGlob" -> code.TemplateRender
    control method "clean" -> core.PathCanonicalization
  }
}
