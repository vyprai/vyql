import code.{Deserialization, FilePathAccess}
adapter go {
  package "github.com/dgraph-io/ristretto" {
    sink method "parseFlag" -> code.Deserialization
    sink method "OpenMmapFileUsing" -> code.FilePathAccess
    sink method "OpenMmapFile" -> code.FilePathAccess
    sink method "Mmap" -> code.FilePathAccess
    sink method "NewTreePersistent" -> code.FilePathAccess
    sink method "NewBufferPersistent" -> code.FilePathAccess
    sink method "NewBufferTmp" -> code.FilePathAccess
  }
}
