import code.{HttpInput, NetworkSend}
import core.{InputValidation}

adapter go {
  package "github.com/tmc/grpc-websocket-proxy" {
    sink method "WebsocketProxy" -> code.NetworkSend
    source method "WebsocketProxy" -> code.HttpInput
    control method "WithRequestMutator" -> core.InputValidation
    control method "WithForwardedHeaders" -> core.InputValidation
  }
}
