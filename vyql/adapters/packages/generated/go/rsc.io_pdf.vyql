import code.{FilePathAccess, Deserialization, CodeEval}
import core.{UserControlledData}

adapter go {
  package "rsc.io/pdf" {
    sink method "Open" -> code.FilePathAccess
    source method "NewReader" -> core.UserControlledData
    source method "NewReaderEncrypted" -> core.UserControlledData
    sink method "readCmap" -> code.Deserialization
    sink method "applyFilter" -> code.Deserialization
    sink method "Interpret" -> code.CodeEval
  }
}
