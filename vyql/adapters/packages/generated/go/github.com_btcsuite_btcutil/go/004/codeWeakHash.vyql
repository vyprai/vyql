module bindings.go.migration.mca5e322a;

binding weakHash4 {
  requires {
    dependency("github.com/btcsuite/btcutil")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "Hash160"
  emit issue code.WeakHash at node
}
