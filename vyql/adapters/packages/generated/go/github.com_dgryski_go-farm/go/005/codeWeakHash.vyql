module bindings.go.migration.mb7f09ede;

binding weakHash5 {
  requires {
    dependency("github.com/dgryski/go-farm")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "Hash128"
  emit issue code.WeakHash at node
}
