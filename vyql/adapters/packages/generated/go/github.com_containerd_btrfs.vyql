adapter go {
  package "github.com/containerd/btrfs" {
    sink method "SubvolCreate" -> code.FilePathAccess
    sink method "SubvolSnapshot" -> code.FilePathAccess
    sink method "SubvolDelete" -> code.FilePathAccess
    sink method "SubvolInfo" -> code.FilePathAccess
    sink method "SubvolID" -> code.FilePathAccess
    sink method "SubvolList" -> code.FilePathAccess
  }
}
