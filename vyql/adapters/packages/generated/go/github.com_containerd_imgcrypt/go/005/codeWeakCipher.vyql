module bindings.go.migration.m11300376;

binding weakCipher5 {
  requires {
    dependency("github.com/containerd/imgcrypt")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "EncryptImage"
  emit issue code.WeakCipher at node
}
