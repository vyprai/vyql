import code.{WeakRandomValue}

adapter go {
  package "github.com/aokoli/goutils" {
    flag code.WeakRandomValue on any {
      method "RandomNonAlphaNumeric"
    }
    flag code.WeakRandomValue on any {
      method "RandomAscii"
    }
    flag code.WeakRandomValue on any {
      method "RandomNumeric"
    }
    flag code.WeakRandomValue on any {
      method "RandomAlphabetic"
    }
    flag code.WeakRandomValue on any {
      method "RandomAlphaNumeric"
    }
    flag code.WeakRandomValue on any {
      method "RandomAlphaNumericCustom"
    }
    flag code.WeakRandomValue on any {
      method "Random"
    }
    flag code.WeakRandomValue on any {
      method "RandomSeed"
    }
  }
}
