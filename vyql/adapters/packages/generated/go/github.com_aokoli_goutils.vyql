import code.{WeakRandomValue}

adapter go {
  package "github.com/aokoli/goutils" {
    mark method "RandomNonAlphaNumeric" -> code.WeakRandomValue
    mark method "RandomAscii" -> code.WeakRandomValue
    mark method "RandomNumeric" -> code.WeakRandomValue
    mark method "RandomAlphabetic" -> code.WeakRandomValue
    mark method "RandomAlphaNumeric" -> code.WeakRandomValue
    mark method "RandomAlphaNumericCustom" -> code.WeakRandomValue
    mark method "Random" -> code.WeakRandomValue
    mark method "RandomSeed" -> code.WeakRandomValue
  }
}
