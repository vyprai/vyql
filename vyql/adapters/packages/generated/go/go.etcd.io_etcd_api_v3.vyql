import code.{StoredDataRead, StoredDataWrite, SecretValue}
import core.{AuthenticationCheck, AuthorizationCheck}

adapter go {
  package "go.etcd.io/etcd/api/v3" {
    source method "request_KV_Range_0" -> code.StoredDataRead
    sink method "request_KV_Put_0" -> code.StoredDataWrite
    sink method "request_KV_DeleteRange_0" -> code.StoredDataWrite
    sink method "request_KV_Txn_0" -> code.StoredDataWrite
    sink method "request_KV_Compact_0" -> code.StoredDataWrite

    control method "request_Auth_Authenticate_0" -> core.AuthenticationCheck
    source method "request_Auth_UserAdd_0" -> code.SecretValue
    source method "request_Auth_UserChangePassword_0" -> code.SecretValue
    control method "request_Auth_UserGrantRole_0" -> core.AuthorizationCheck
    control method "request_Auth_UserRevokeRole_0" -> core.AuthorizationCheck
    control method "request_Auth_RoleGrantPermission_0" -> core.AuthorizationCheck
    control method "request_Auth_RoleRevokePermission_0" -> core.AuthorizationCheck
  }
}
