import code.{NetworkConnect}

adapter go {
  package "github.com/godbus/dbus/v5" {
    sink method "Connect" -> code.NetworkConnect
    sink method "ConnectSessionBus" -> code.NetworkConnect
    sink method "ConnectSystemBus" -> code.NetworkConnect
    sink method "SessionBus" -> code.NetworkConnect
    sink method "SessionBusPrivate" -> code.NetworkConnect
    sink method "SessionBusPrivateNoAutoStartup" -> code.NetworkConnect
    sink method "SessionBusPrivateHandler" -> code.NetworkConnect
    sink method "SystemBus" -> code.NetworkConnect
    sink method "SystemBusPrivate" -> code.NetworkConnect
    sink method "SystemBusPrivateHandler" -> code.NetworkConnect
  }
}
