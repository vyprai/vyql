adapter go {
  package "github.com/google/wire" {
    sink method "load" -> code.Deserialization
    sink method "processFuncProvider" -> code.Deserialization
    sink method "processStructLiteralProvider" -> code.Deserialization
    sink method "processStructProvider" -> code.Deserialization
    sink method "processBind" -> code.Deserialization
    sink method "processValue" -> code.Deserialization
    sink method "processInterfaceValue" -> code.Deserialization
    sink method "processFieldsOf" -> code.Deserialization
  }
}
