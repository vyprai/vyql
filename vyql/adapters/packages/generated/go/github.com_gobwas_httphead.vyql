import code.{Deserialization, HttpInput}

adapter go {
  package "github.com/gobwas/httphead" {
    sink method "ScanCookie" -> code.Deserialization
    sink method "ParseRequestLine" -> code.Deserialization
    sink method "ParseResponseLine" -> code.Deserialization
    sink method "ParseHeaderLine" -> code.Deserialization
    sink method "ScanTokens" -> code.Deserialization
    sink method "ParseOptions" -> code.Deserialization
    sink method "ScanToken" -> code.Deserialization

    control method "ValidCookieValue" -> core.InputValidation
    control method "ValidCookieName" -> core.InputValidation
    control method "CanonicalizeHeaderKey" -> core.InputValidation
  }
}
