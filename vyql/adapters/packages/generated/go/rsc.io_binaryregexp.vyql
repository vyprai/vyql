import code.{RegexCompile}

adapter go {
  package "rsc.io/binaryregexp" {
    flag code.RegexCompile on any {
      method "Compile"
    }
    flag code.RegexCompile on any {
      method "CompilePOSIX"
    }
    flag code.RegexCompile on any {
      method "MustCompile"
    }
    flag code.RegexCompile on any {
      method "MustCompilePOSIX"
    }
  }
}
