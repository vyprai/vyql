import code.{Deserialization}

adapter go {
  package "github.com/mitchellh/mapstructure" {
    sink method "DecodeHookExec" -> code.Deserialization
    sink method "StringToSliceHookFunc" -> code.Deserialization
    sink method "StringToTimeDurationHookFunc" -> code.Deserialization
    sink method "StringToIPHookFunc" -> code.Deserialization
    sink method "StringToIPNetHookFunc" -> code.Deserialization
    sink method "StringToTimeHookFunc" -> code.Deserialization
    sink method "RecursiveStructToMapHookFunc" -> code.Deserialization
    sink method "TextUnmarshallerHookFunc" -> code.Deserialization
  }
}
