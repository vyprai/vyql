import code.{ExpressionEval}
import core.{InputValidation}

adapter go {
  package "github.com/go-openapi/jsonpointer" {
    sink method "GetForToken" -> code.ExpressionEval
    sink method "SetForToken" -> code.ExpressionEval
    control method "Unescape" -> core.InputValidation
    control method "Escape" -> core.InputValidation
  }
}
