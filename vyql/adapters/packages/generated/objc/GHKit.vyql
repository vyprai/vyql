import code.{Deserialization, FilePathAccess}
import core.{InputValidation}

adapter objc {
  package "GHKit" {
    control method "gh_escapeAll" -> core.InputValidation
    sink method "gh_decode" -> code.Deserialization
    sink method "gh_openFile" -> code.FilePathAccess
    sink method "gh_openContainingFolder" -> code.FilePathAccess
  }
}
