import code.{Deserialization, UrlFetch}

adapter objc {
  package "TBXML" {
    sink method "newTBXMLWithXMLString" -> code.Deserialization
    sink method "newTBXMLWithXMLData" -> code.Deserialization
    sink method "newTBXMLWithXMLFile" -> code.Deserialization
    sink method "initWithXMLString" -> code.Deserialization
    sink method "initWithXMLData" -> code.Deserialization
    sink method "initWithXMLFile" -> code.Deserialization
    sink method "decodeData" -> code.Deserialization
    sink method "newTBXMLWithURL" -> code.UrlFetch
    sink method "initWithURL" -> code.UrlFetch
    sink method "gzipInflate" -> code.Deserialization
  }
}
