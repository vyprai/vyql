import code.{NetworkBind, NetworkConnect, NetworkData, NetworkSend}

adapter objc {
  package "Venice" {
    sink method "tcplisten" -> code.NetworkBind
    sink method "tcpconnect" -> code.NetworkConnect
    sink method "tcpsend" -> code.NetworkSend
    source method "tcprecv" -> code.NetworkData
    source method "tcprecvlh" -> code.NetworkData
    source method "tcprecvuntil" -> code.NetworkData
  }
}
