import code.{Deserialization, FilePathAccess, StoredDataRead}

adapter objc {
  package "PINCache" {
    sink method "setObject:forKey:" -> code.Deserialization
    sink method "setObject:forKey:withAgeLimit:" -> code.Deserialization
    sink method "setObject:forKey:withCost:" -> code.Deserialization
    sink method "setObject:forKey:withCost:ageLimit:" -> code.Deserialization
    sink method "setObject:forKey:withAgeLimit:fileURL:" -> code.Deserialization
    sink method "setObjectAsync:forKey:completion:" -> code.Deserialization
    sink method "setObjectAsync:forKey:withAgeLimit:completion:" -> code.Deserialization
    sink method "setObjectAsync:forKey:withCost:completion:" -> code.Deserialization
    sink method "setObjectAsync:forKey:withCost:ageLimit:completion:" -> code.Deserialization
    source method "objectForKey:" -> code.StoredDataRead
    source method "objectForKey:fileURL:" -> code.StoredDataRead
    sink method "initWithName:rootPath:" -> code.FilePathAccess
  }
}
