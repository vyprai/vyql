module bindings.objc.migration.mf5582be2;

binding weakHash0 {
  requires {
    dependency("AliyunOSSiOS")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "calBase64Sha1WithData"
  emit issue code.WeakHash at node
}
