module bindings.objc.migration.ma6dc1814;

binding weakHash3 {
  requires {
    dependency("CNIOHTTPParser")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "cniohttpparser.hash"
  emit issue code.WeakHash at node
}
