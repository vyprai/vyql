import code.{Deserialization}
import core.{UserControlledData}

adapter objc {
  package "Flutter" {
    sink method "decode" -> code.Deserialization
    sink method "decodeMethodCall" -> code.Deserialization
    sink method "decodeEnvelope" -> code.Deserialization
    source method "readValue" -> core.UserControlledData
  }
}
