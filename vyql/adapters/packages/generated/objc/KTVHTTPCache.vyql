import code.{NetworkConnect, UrlFetch, HttpInput, NetworkData}

adapter objc {
  package "KTVHTTPCache" {
    sink method "proxyStart" -> code.NetworkConnect
    sink method "proxyURLWithOriginalURL" -> code.UrlFetch
    source method "cacheReaderWithRequest" -> code.HttpInput
    source method "downloadSetAdditionalHeaders" -> code.NetworkData
  }
}
