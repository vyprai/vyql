adapter objc {
  package "SimpleAuth" {
    control method "authorize" -> core.AuthenticationCheck
    control method "authorizeWithCompletion" -> core.AuthenticationCheck
    control method "handleCallback" -> core.AuthenticationCheck
    control method "isTargetRedirectURL" -> core.InputValidation
    source method "requestToken" -> code.SecretValue
    source method "accessTokenWithRequestToken" -> code.SecretValue
    source method "authenticateWithRequestToken" -> code.SecretValue
    source method "accountWithAccessToken" -> code.SecretValue
  }
}
