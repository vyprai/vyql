import code.{SecretValue, NetworkData}
adapter objc {
  package "FlurrySDK" {
    source method "startSession:" -> code.SecretValue
    source method "logEvent:" -> code.NetworkData
    source method "logError:message:exception:" -> code.NetworkData
    source method "logError:message:error:" -> code.NetworkData
    source method "setUserCookies:" -> code.NetworkData
    source method "setKeywordsForTargeting:" -> code.NetworkData
  }
}
