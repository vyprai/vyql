module bindings.objc.migration.m1fbc47fd;

binding weakHash0 {
  requires {
    dependency("XMPPFramework")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "xmppframework.hash"
  emit issue code.WeakHash at node
}
