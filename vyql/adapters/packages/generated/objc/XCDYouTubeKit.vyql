import code.{NetworkData, UrlFetch, NetworkConnect}
adapter objc {
  package "XCDYouTubeKit" {
    source method "getVideoWithIdentifier" -> code.NetworkData
    sink method "getVideoWithIdentifier" -> code.UrlFetch
    source method "queryVideo" -> code.NetworkData
    sink method "queryVideo" -> code.UrlFetch
    sink method "initWithURL" -> code.NetworkConnect
    sink method "start" -> code.UrlFetch
  }
}
