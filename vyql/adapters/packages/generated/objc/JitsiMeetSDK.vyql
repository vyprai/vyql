adapter objc {
  package "JitsiMeetSDK" {
    sink method "sendEndpointTextMessage" -> code.NetworkSend
    sink method "sendChatMessage" -> code.NetworkSend
    sink method "overwriteConfig" -> code.CodeEval
    source method "startRecording" -> code.SecretValue
    sink method "startRecording" -> code.NetworkSend
    flag code.PrivilegedOp on any {
      method "requestTransaction"
    }
    flag code.PrivilegedOp on any {
      method "request"
    }
    source method "fromBuilder" -> core.UserControlledData
  }
}
