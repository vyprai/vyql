import code.{NetworkConnect, SecretValue}
adapter objc {
  package "UMDevice" {
    source method "initWithAppKey" -> code.SecretValue
    source method "getZID" -> code.SecretValue
    source method "getResetToken" -> code.SecretValue
    source method "getATStr" -> code.SecretValue
    sink method "configureDomain" -> code.NetworkConnect
  }
}
