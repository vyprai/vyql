import code.{StoredDataRead, StoredDataWrite}

adapter objc {
  package "GVUserDefaults" {
    source method "longLongGetter" -> code.StoredDataRead
    sink method "longLongSetter" -> code.StoredDataWrite
    source method "boolGetter" -> code.StoredDataRead
    sink method "boolSetter" -> code.StoredDataWrite
    source method "integerGetter" -> code.StoredDataRead
    sink method "integerSetter" -> code.StoredDataWrite
    source method "floatGetter" -> code.StoredDataRead
    sink method "floatSetter" -> code.StoredDataWrite
    source method "doubleGetter" -> code.StoredDataRead
    sink method "doubleSetter" -> code.StoredDataWrite
    source method "objectGetter" -> code.StoredDataRead
    sink method "objectSetter" -> code.StoredDataWrite
  }
}
