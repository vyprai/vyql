module bindings.objc.migration.m42f45fae;

binding redirectTarget5 {
  requires {
    dependency("razorpay-pod")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "handleRedirection"
  emit issue code.RedirectTarget at node
  emit sink code.RedirectTargetSink at node
}
