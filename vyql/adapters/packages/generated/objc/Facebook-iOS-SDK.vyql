import code.{SecretValue, UrlFetch}
import core.{InputValidation}

adapter objc {
  package "Facebook-iOS-SDK" {
    sink method "URLWithURL" -> code.UrlFetch
    sink method "URLWithInboundURL" -> code.UrlFetch
    control method "URLDecode" -> core.InputValidation
    control method "URLEncode" -> core.InputValidation
    source method "clientToken" -> code.SecretValue
    source method "setClientToken" -> code.SecretValue
  }
}
