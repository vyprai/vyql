import code.{NetworkBind, NetworkData, NetworkSend}
adapter objc {
  package "gRPC-ProtoRPC" {
    sink method "grpc_call_start_batch" -> code.NetworkSend
    source method "grpc_server_request_call" -> code.NetworkData
    source method "grpc_server_request_registered_call" -> code.NetworkData
    sink method "grpc_server_add_http2_port" -> code.NetworkBind
    sink method "grpc_server_start" -> code.NetworkBind
  }
}
