import code.{StoredDataRead, StoredDataWrite, FilePathAccess}
adapter objc {
  package "EGOCache" {
    sink method "initWithCacheDirectory" -> code.FilePathAccess
    source method "dataForKey" -> code.StoredDataRead
    sink method "setData:forKey" -> code.StoredDataWrite
    sink method "setData:forKey:withTimeoutInterval" -> code.StoredDataWrite
    source method "stringForKey" -> code.StoredDataRead
    sink method "setString:forKey" -> code.StoredDataWrite
    sink method "setString:forKey:withTimeoutInterval" -> code.StoredDataWrite
    source method "dateForKey" -> code.StoredDataRead
    source method "imageForKey" -> code.StoredDataRead
    sink method "setImage:forKey" -> code.StoredDataWrite
    sink method "setImage:forKey:withTimeoutInterval" -> code.StoredDataWrite
    source method "plistForKey" -> code.StoredDataRead
    sink method "setPlist:forKey" -> code.StoredDataWrite
    source method "objectForKey" -> code.StoredDataRead
    sink method "setObject:forKey" -> code.StoredDataWrite
    sink method "setObject:forKey:withTimeoutInterval" -> code.StoredDataWrite
    sink method "copyFilePath:asKey" -> code.FilePathAccess
  }
}
