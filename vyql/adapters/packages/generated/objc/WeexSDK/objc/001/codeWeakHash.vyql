module bindings.objc.migration.mf97fd0db;

binding weakHash1 {
  requires {
    dependency("WeexSDK")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "weexsdk.hash"
  emit issue code.WeakHash at node
}
