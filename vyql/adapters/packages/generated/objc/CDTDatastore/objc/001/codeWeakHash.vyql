module bindings.objc.migration.m3fd03f38;

binding weakHash1 {
  requires {
    dependency("CDTDatastore")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "cdtdatastore.hash"
  emit issue code.WeakHash at node
}
