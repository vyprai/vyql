import code.{Deserialization}

adapter objc {
  package "XMLDictionary" {
    sink method "dictionaryWithParser" -> code.Deserialization
    sink method "dictionaryWithFile" -> code.Deserialization
    sink method "dictionaryWithData" -> code.Deserialization
    sink method "dictionaryWithString" -> code.Deserialization
    sink method "dictionaryWithXMLParser" -> code.Deserialization
    sink method "dictionaryWithXMLData" -> code.Deserialization
    sink method "dictionaryWithXMLString" -> code.Deserialization
    sink method "dictionaryWithXMLFile" -> code.Deserialization
  }
}
