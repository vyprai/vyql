import code.{FilePathAccess, UrlFetch, NetworkData, NetworkSend}

adapter objc {
  package "JXHTTP" {
    sink method "initWithFilePath" -> code.FilePathAccess
    sink method "initWithURL" -> code.UrlFetch
    source method "connection:didReceiveResponse:" -> code.NetworkData
    sink method "connection:didSendBodyData:totalBytesWritten:totalBytesExpectedToWrite:" -> code.NetworkSend
  }
}
