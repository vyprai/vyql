import code.{HttpInput, NetworkData}

adapter objc {
  package "YTKNetwork" {
    source method "requestUrl" -> code.HttpInput
    source method "requestArgument" -> code.HttpInput
    source method "requestHeaderFieldValueDictionary" -> code.HttpInput
    source method "responseObject" -> code.NetworkData
    source method "responseString" -> code.NetworkData
  }
}
