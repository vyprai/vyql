import code.{DatabaseRead, Deserialization}
import core.{InputValidation}
adapter objc {
  package "couchbase-lite-ios" {
    sink method "run:" -> code.DatabaseRead
    sink method "validateJSONObject:" -> code.Deserialization
    control method "validatorForSchemaAtURL:" -> core.InputValidation
    control method "registerSchema:forURL:" -> core.InputValidation
  }
}
