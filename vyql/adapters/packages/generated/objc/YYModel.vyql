import code.{Deserialization, SecretValue}

adapter objc {
  package "YYModel" {
    sink method "yy_modelWithJSON" -> code.Deserialization
    sink method "yy_modelWithDictionary" -> code.Deserialization
    sink method "yy_modelSetWithJSON" -> code.Deserialization
    sink method "yy_modelSetWithDictionary" -> code.Deserialization
  }
}
