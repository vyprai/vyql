import core.{UserControlledData}

adapter objc {
  package "HLSCachingReverseProxyServer" {
    source method "reverseProxyURL" -> core.UserControlledData
    source method "reverseProxyPlaylist" -> core.UserControlledData
    source method "processPlaylistLine" -> core.UserControlledData
    source method "lineByReplacingURI" -> core.UserControlledData
    source method "absoluteURL" -> core.UserControlledData
  }
}
