module bindings.objc.migration.mc1361ff5;

binding weakHash2 {
  requires {
    dependency("MSAL")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "msal.hash"
  emit issue code.WeakHash at node
}
