import code.{NetworkConnect, NetworkSend}
adapter objc {
  package "Giphy" {
    sink method "httpRequestWith" -> code.NetworkConnect
    sink method "httpRequestWith" -> code.NetworkSend
    sink method "downloadAssetData" -> code.NetworkConnect
    sink method "downloadAssetData" -> code.NetworkSend
    sink method "downloadAsset" -> code.NetworkConnect
    sink method "downloadAsset" -> code.NetworkSend
  }
}
