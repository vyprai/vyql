import code.{UrlFetch}

adapter objc {
  package "ZFPlayer" {
    sink method "setAssetURL:" -> code.UrlFetch
    sink method "startDownloadImageWithUrl:" -> code.UrlFetch
    sink method "setImageWithURLString:placeholderImageName:" -> code.UrlFetch
    sink method "setImageWithURLString:placeholder:" -> code.UrlFetch
    sink method "setImageWithURLString:" -> code.UrlFetch
  }
}
