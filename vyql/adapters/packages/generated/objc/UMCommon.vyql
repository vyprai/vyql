import core.{UserControlledData}

adapter objc {
  package "UMCommon" {
    source method "profileSignInWithPUID" -> core.UserControlledData
    source method "userProfile" -> core.UserControlledData
    source method "userProfileMobile" -> core.UserControlledData
    source method "userProfileEMail" -> core.UserControlledData
    source method "setSecret" -> code.SecretValue
    sink method "handleUrl" -> code.UrlFetch
    sink method "handleOpenURL" -> code.UrlFetch
    source method "didResolveDeepLink" -> core.UserControlledData
    source method "getInstallParams" -> core.UserControlledData
  }
}
