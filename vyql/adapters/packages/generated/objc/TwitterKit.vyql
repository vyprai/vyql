import code.{UrlFetch, NetworkConnect, NetworkSend, SecretValue}

adapter objc {
  package "TwitterKit" {
    sink method "URLRequestWithMethod:URLString:parameters:error:" -> code.UrlFetch
    sink method "sendTwitterRequest:completion:" -> code.NetworkConnect
    sink method "uploadMedia:contentType:completion:" -> code.NetworkSend
    source method "requestEmailForCurrentUser:completion:" -> code.SecretValue
  }
}
