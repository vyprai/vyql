module bindings.objc.migration.mc2f1d3c9;

binding weakCipher2 {
  requires {
    dependency("LGHelper+NS")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "xorCryptedWithKey"
  emit issue code.WeakCipher at node
}
