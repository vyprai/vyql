adapter objc {
  package "OneSignalXCFramework" {
    source method "login:withToken:" -> code.SecretValue
    source method "initialize:withLaunchOptions:" -> code.SecretValue
    source method "didReceiveNotificationExtensionRequest:withMutableNotificationContent:" -> core.UserControlledData
    source method "serviceExtensionTimeWillExpireRequest:withMutableNotificationContent:" -> core.UserControlledData
    source method "requestPermission:" -> core.UserControlledData
    source method "registerForProvisionalAuthorization:" -> core.UserControlledData
    source method "startLocationSharedWithFlag:" -> core.UserControlledData
  }
}
