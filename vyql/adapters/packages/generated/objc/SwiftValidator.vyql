import code.{RegexCompile}
import core.{InputValidation, UserControlledData}

adapter objc {
  package "SwiftValidator" {
    flag code.RegexCompile on any {
      method "RegexRule.init"
    }
    control method "RegexRule.validate" -> core.InputValidation
    source method "Validator.validateField" -> core.UserControlledData
  }
}
