import code.{NetworkSend, NetworkConnect}

adapter objc {
  package "SocketRocket" {
    sink method "open" -> code.NetworkConnect
    sink method "send:" -> code.NetworkSend
    sink method "sendString:error:" -> code.NetworkSend
    sink method "sendData:error:" -> code.NetworkSend
    sink method "sendDataNoCopy:error:" -> code.NetworkSend
    sink method "sendPing:error:" -> code.NetworkSend
  }
}
