import code.{NetworkConnect, NetworkSend}

adapter objc {
  package "OMGHTTPURLRQ" {
    sink method "GET:parameters:error:" -> code.NetworkConnect
    sink method "GET:parameters:error:" -> code.NetworkSend
    sink method "POST:parametersOrMultipartFormData:error:" -> code.NetworkConnect
    sink method "POST:parametersOrMultipartFormData:error:" -> code.NetworkSend
    sink method "PUT:parameters:error:" -> code.NetworkConnect
    sink method "PUT:parameters:error:" -> code.NetworkSend
    sink method "PATCH:JSON:error:" -> code.NetworkConnect
    sink method "PATCH:JSON:error:" -> code.NetworkSend
    sink method "DELETE:parameters:error:" -> code.NetworkConnect
    sink method "DELETE:parameters:error:" -> code.NetworkSend
    sink method "addFile:parameterName:filename:contentType:" -> code.NetworkSend
    sink method "addText:parameterName:" -> code.NetworkSend
  }
}
