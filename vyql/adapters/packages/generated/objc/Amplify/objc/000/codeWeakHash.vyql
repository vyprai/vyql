module bindings.objc.migration.m6dfcc102;

binding weakHash0 {
  requires {
    dependency("Amplify")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "amplify.hash"
  emit issue code.WeakHash at node
}
