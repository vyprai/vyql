adapter objc {
  package "gRPC-Core" {
    sink method "grpc_call_start_batch" -> code.NetworkSend
    source method "grpc_server_request_call" -> code.NetworkData
    control method "grpc_channel_credentials_release" -> core.AuthenticationCheck
    control method "grpc_server_credentials_release" -> core.AuthenticationCheck
    control method "grpc_call_set_credentials" -> core.AuthenticationCheck
    source method "grpc_server_add_http2_port" -> code.NetworkData
    source method "grpc_server_start" -> code.NetworkData
    control method "grpc_header_key_is_legal" -> core.InputValidation
  }
}
