module bindings.objc.migration.m5d49181c;

binding weakHash3 {
  requires {
    dependency("Moya")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "moya.hash"
  emit issue code.WeakHash at node
}
