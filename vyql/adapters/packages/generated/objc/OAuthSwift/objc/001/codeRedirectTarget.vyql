module bindings.objc.migration.mc6062c70;

binding redirectTarget1 {
  requires {
    dependency("OAuthSwift")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "authorize"
  emit issue code.RedirectTarget at node
  emit sink code.RedirectTargetSink at node
}
