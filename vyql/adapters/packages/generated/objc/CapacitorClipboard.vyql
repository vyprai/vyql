import code.{StoredDataWrite}
import core.{UserControlledData}

adapter objc {
  package "CapacitorClipboard" {
    source method "read" -> core.UserControlledData
    source method "readText" -> core.UserControlledData
    sink method "write" -> code.StoredDataWrite
    sink method "writeText" -> code.StoredDataWrite
  }
}
