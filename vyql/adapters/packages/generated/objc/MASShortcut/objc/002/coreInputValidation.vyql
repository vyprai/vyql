module bindings.objc.migration.m15006c85;

binding inputValidation2 {
  requires {
    dependency("MASShortcut")
  }
  query pattern callExpr where callee.method == "isShortcutAlreadyTakenBySystem:explanation:"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
