import code.{Deserialization, FilePathAccess, SecretValue, WeakHash}
import core.{HtmlEscape, InputValidation, UserControlledData}

adapter objc {
  package "SAMCategories" {
    source method "sam_queryDictionary" -> core.UserControlledData
    flag code.WeakHash on any {
      method "sam_MD5Digest"
    }
    flag code.WeakHash on any {
      method "sam_SHA1Digest"
    }
    control method "sam_escapeHTML" -> core.HtmlEscape
    control method "sam_stringByEscapingForURLQuery" -> core.InputValidation
    source method "sam_stringByUnescapingFromURLQuery" -> core.UserControlledData
    sink method "sam_dictionaryWithFormEncodedString" -> code.Deserialization
    sink method "sam_documentsDirectoryURL" -> code.FilePathAccess
    sink method "sam_cachesDirectoryURL" -> code.FilePathAccess
    sink method "sam_downloadsDirectoryURL" -> code.FilePathAccess
    sink method "sam_libraryDirectoryURL" -> code.FilePathAccess
    sink method "sam_applicationSupportDirectoryURL" -> code.FilePathAccess
    source method "sam_setSignatureSalt" -> code.SecretValue
    source method "sam_signatureSalt" -> code.SecretValue
  }
}
