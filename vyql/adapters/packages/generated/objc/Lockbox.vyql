import code.{SecretValue}
adapter objc {
  package "Lockbox" {
    source method "archiveObject:forKey:" -> code.SecretValue
    source method "archiveObject:forKey:accessibility:" -> code.SecretValue
    source method "unarchiveObjectForKey:" -> code.SecretValue

    source method "setString:forKey:" -> code.SecretValue
    source method "setString:forKey:accessibility:" -> code.SecretValue
    source method "stringForKey:" -> code.SecretValue

    source method "setArray:forKey:" -> code.SecretValue
    source method "setArray:forKey:accessibility:" -> code.SecretValue
    source method "arrayForKey:" -> code.SecretValue

    source method "setSet:forKey:" -> code.SecretValue
    source method "setSet:forKey:accessibility:" -> code.SecretValue
    source method "setForKey:" -> code.SecretValue

    source method "setDictionary:forKey:" -> code.SecretValue
    source method "setDictionary:forKey:accessibility:" -> code.SecretValue
    source method "dictionaryForKey:" -> code.SecretValue

    source method "setDate:forKey:" -> code.SecretValue
    source method "setDate:forKey:accessibility:" -> code.SecretValue
    source method "dateForKey:" -> code.SecretValue

    source method "setObject:forKey:accessibility:" -> code.SecretValue
    source method "objectForKey:" -> code.SecretValue

    source method "setData:forKey:accessibility:" -> code.SecretValue
    source method "dataForKey:" -> code.SecretValue
  }
}
