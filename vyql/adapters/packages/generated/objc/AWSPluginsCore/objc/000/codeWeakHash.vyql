module bindings.objc.migration.mddd1a0e2;

binding weakHash0 {
  requires {
    dependency("AWSPluginsCore")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "update"
  emit issue code.WeakHash at node
}
