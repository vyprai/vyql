import code.{Deserialization, RedirectTarget}

adapter objc {
  package "OHAttributedLabel" {
    sink method "processMarkupInAttributedString" -> code.Deserialization
    sink method "attributedStringByProcessingMarkupInString" -> code.Deserialization
    flag code.RedirectTarget on any {
      method "addCustomLink"
    }
  }
}
