import code.{Deserialization, SecretValue}

adapter objc {
  package "LUKeychainAccess" {
    source method "objectForKey:ofClasses:" -> code.SecretValue
    source method "boolForKey:" -> code.SecretValue
    source method "dataForKey:" -> code.SecretValue
    source method "doubleForKey:" -> code.SecretValue
    source method "floatForKey:" -> code.SecretValue
    source method "integerForKey:" -> code.SecretValue
    source method "recursivelyFindObjectForKey:fromClass:" -> code.SecretValue
    source method "stringForKey:" -> code.SecretValue
    source method "objectForKey:ofClass:" -> code.SecretValue

    source method "setBool:forKey:" -> code.SecretValue
    source method "setData:forKey:" -> code.SecretValue
    source method "setDouble:forKey:" -> code.SecretValue
    source method "setFloat:forKey:" -> code.SecretValue
    source method "setInteger:forKey:" -> code.SecretValue
    source method "setObject:forKey:" -> code.SecretValue
    source method "setString:forKey:" -> code.SecretValue
    source method "addData:forKey:error:" -> code.SecretValue
    source method "updateData:forKey:error:" -> code.SecretValue

    sink method "lu_unarchiveObjectWithData:" -> code.Deserialization
    sink method "lu_unarchiveObjectOfClasses:withData:" -> code.Deserialization
    sink method "lu_unarchiveObjectOfClass:withData:" -> code.Deserialization
  }
}
