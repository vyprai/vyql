import code.{HttpInput, NetworkData, NetworkSend, SecretValue}

adapter objc {
  package "KTVCocoaHTTPServer" {
    source method "headerField:" -> code.HttpInput
    source method "url" -> code.HttpInput
    source method "initRequestWithMethod:URL:version:" -> code.HttpInput
    source method "base64Credentials" -> code.SecretValue
    source method "response" -> code.SecretValue
    source method "webSocket:didReceiveMessage:" -> code.NetworkData
    sink method "sendMessage:" -> code.NetworkSend
    sink method "sendData:" -> code.NetworkSend
  }
}
