import code.{NetworkData}

adapter objc {
  package "INTULocationManager" {
    source method "requestLocationWithDesiredAccuracy" -> code.NetworkData
    source method "subscribeToLocationUpdatesWithBlock" -> code.NetworkData
    source method "subscribeToLocationUpdatesWithDesiredAccuracy" -> code.NetworkData
    source method "subscribeToSignificantLocationChangesWithBlock" -> code.NetworkData
    source method "subscribeToHeadingUpdatesWithBlock" -> code.NetworkData
    source method "initWithType" -> code.NetworkData
  }
}
