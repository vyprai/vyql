import code.{NetworkSend, NetworkData}
import core.{UserControlledData, CertificateValidation}

adapter objc {
  package "SwiftHTTP" {
    sink method "run" -> code.NetworkSend
    sink method "Download" -> code.NetworkSend
    sink method "New" -> code.NetworkSend
    source method "appendParametersAsQueryString" -> core.UserControlledData
    source method "appendParametersAsUrlEncoding" -> core.UserControlledData
    source method "appendParametersAsMultiPartFormData" -> core.UserControlledData
    source method "appendParametersAsJSON" -> core.UserControlledData
    control method "isValid" -> core.CertificateValidation
  }
}
