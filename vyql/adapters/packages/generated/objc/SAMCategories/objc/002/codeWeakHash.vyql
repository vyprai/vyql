module bindings.objc.migration.m0cb6a173;

binding weakHash2 {
  requires {
    dependency("SAMCategories")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "sam_SHA1Digest"
  emit issue code.WeakHash at node
}
