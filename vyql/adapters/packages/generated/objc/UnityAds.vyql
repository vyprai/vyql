import code.{StoredDataRead, StoredDataWrite, NetworkSend}
adapter objc {
  package "UnityAds" {
    source method "readStorage" -> code.StoredDataRead
    sink method "writeStorage" -> code.StoredDataWrite
    sink method "setRaw" -> code.StoredDataWrite
    source method "getValueForKey" -> code.StoredDataRead
    sink method "load" -> code.NetworkSend
    sink method "loadBanner" -> code.NetworkSend
    sink method "loadWithOptions" -> code.NetworkSend
  }
}
