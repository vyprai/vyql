import code.{NetworkConnect, NetworkData, Deserialization}

adapter objc {
  package "socket.IO" {
    sink method "connectToHost:onPort:" -> code.NetworkConnect
    source method "send:" -> code.NetworkData
    source method "sendMessage:" -> code.NetworkData
    source method "sendJSON:" -> code.NetworkData
    source method "sendEvent:withData:" -> code.NetworkData
    source method "socketIO:didReceiveMessage:" -> code.NetworkData
    source method "socketIO:didReceiveJSON:" -> code.NetworkData
    sink method "objectFromJSONData:error:" -> code.Deserialization
  }
}
