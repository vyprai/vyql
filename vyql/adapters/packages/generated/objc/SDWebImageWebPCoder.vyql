import code.{Deserialization}

adapter objc {
  package "SDWebImageWebPCoder" {
    sink method "canDecodeFromData" -> code.Deserialization
    sink method "decodedImageWithData" -> code.Deserialization
    sink method "incrementalDecodedImageWithOptions" -> code.Deserialization
    sink method "updateIncrementalData" -> code.Deserialization
    sink method "sd_imageWithWebPData" -> code.Deserialization
  }
}
