module bindings.objc.migration.m2873fa1a;

binding weakHash1 {
  requires {
    dependency("photo_manager")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "getmd5WithString"
  emit issue code.WeakHash at node
}
