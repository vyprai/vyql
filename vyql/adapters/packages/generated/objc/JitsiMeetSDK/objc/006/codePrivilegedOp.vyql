module bindings.objc.migration.mb118e0aa;

binding privilegedOp6 {
  requires {
    dependency("JitsiMeetSDK")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "request"
  emit issue code.PrivilegedOp at node
  emit sink code.PrivilegedOpSink at node
}
