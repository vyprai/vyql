import code.{Deserialization, NetworkConnect, RedirectTarget}
adapter objc {
  package "Siren" {
    sink method "parseForUpdate" -> code.Deserialization
    sink method "processVersionCheckResults" -> code.Deserialization
    flag code.RedirectTarget on any {
      method "launchAppStore"
    }
    sink method "launchAppStore" -> code.NetworkConnect
  }
}
