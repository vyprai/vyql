import code.{UrlFetch, SecretValue, RedirectTarget}

adapter objc {
  package "FBSDKCoreKit" {
    sink method "startGraphRequestWithGraphPath:parameters:tokenString:HTTPMethod:completion:" -> code.UrlFetch
    source method "initWithTokenString:" -> code.SecretValue
    mark method "handle:" -> code.RedirectTarget
  }
}
