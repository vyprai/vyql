module bindings.objc.migration.mf8a3c543;

binding weakHash1 {
  requires {
    dependency("SwiftNIOSSL")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "MD5"
  emit issue code.WeakHash at node
}
