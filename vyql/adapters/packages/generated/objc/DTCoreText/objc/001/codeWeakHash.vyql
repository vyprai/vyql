module bindings.objc.migration.mbd1e868a;

binding weakHash1 {
  requires {
    dependency("DTCoreText")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "dtcoretext.hash"
  emit issue code.WeakHash at node
}
