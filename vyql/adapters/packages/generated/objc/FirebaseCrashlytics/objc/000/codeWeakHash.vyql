module bindings.objc.migration.mccc8be40;

binding weakHash0 {
  requires {
    dependency("FirebaseCrashlytics")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "FIRCLSHashNSData"
  emit issue code.WeakHash at node
}
