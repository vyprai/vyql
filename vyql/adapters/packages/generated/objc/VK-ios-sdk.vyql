import code.{SecretValue, HttpInput}
import core.{AuthenticationCheck, InputValidation}

adapter objc {
  package "VK-ios-sdk" {
    control method "authorize" -> core.AuthenticationCheck
    source method "accessToken" -> code.SecretValue
    source method "setAccessToken" -> code.SecretValue
    control method "processOpenURL" -> core.InputValidation
  }
}
