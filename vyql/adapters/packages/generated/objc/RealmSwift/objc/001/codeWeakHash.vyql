module bindings.objc.migration.mbc1c1b4c;

binding weakHash1 {
  requires {
    dependency("RealmSwift")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "realmswift.hash"
  emit issue code.WeakHash at node
}
