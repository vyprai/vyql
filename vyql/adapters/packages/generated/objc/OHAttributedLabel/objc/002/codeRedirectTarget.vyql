module bindings.objc.migration.m573092eb;

binding redirectTarget2 {
  requires {
    dependency("OHAttributedLabel")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "addCustomLink"
  emit issue code.RedirectTarget at node
  emit sink code.RedirectTargetSink at node
}
