module bindings.objc.migration.mef2186dc;

binding weakHash6 {
  requires {
    dependency("RHCategoryKit")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "rh_stringWithMD5Encode"
  emit issue code.WeakHash at node
}
