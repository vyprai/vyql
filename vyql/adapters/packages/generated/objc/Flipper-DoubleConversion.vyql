import code.{Deserialization}

adapter objc {
  package "Flipper-DoubleConversion" {
    sink method "Strtod" -> code.Deserialization
    sink method "Strtof" -> code.Deserialization
    sink method "StringToDouble" -> code.Deserialization
    sink method "StringToFloat" -> code.Deserialization
  }
}
