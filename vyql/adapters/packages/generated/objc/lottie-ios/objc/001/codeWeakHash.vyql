module bindings.objc.migration.m75ea5ac7;

binding weakHash1 {
  requires {
    dependency("lottie-ios")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "lottie.ios.hash"
  emit issue code.WeakHash at node
}
