import code.{HtmlRender}
adapter objc {
  package "CWStatusBarNotification" {
    sink method "displayNotificationWithMessage:completion:" -> code.HtmlRender
    sink method "displayNotificationWithMessage:forDuration:" -> code.HtmlRender
    sink method "displayNotificationWithAttributedString:completion:" -> code.HtmlRender
    sink method "displayNotificationWithAttributedString:forDuration:" -> code.HtmlRender
    sink method "displayNotificationWithView:completion:" -> code.HtmlRender
    sink method "displayNotificationWithView:forDuration:" -> code.HtmlRender
  }
}
