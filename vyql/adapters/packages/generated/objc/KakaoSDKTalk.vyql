import code.{UrlFetch, StoredDataRead, TemplateRender}

adapter objc {
  package "KakaoSDKTalk" {
    source method "profile" -> code.StoredDataRead
    sink method "sendCustomMemo" -> code.TemplateRender
    sink method "sendDefaultMemo" -> code.TemplateRender
    sink method "sendScrapMemo" -> code.TemplateRender
    sink method "sendScrapMemo" -> code.UrlFetch
    sink method "sendDefaultMessage" -> code.TemplateRender
    sink method "sendCustomMessage" -> code.TemplateRender
    sink method "sendScrapMessage" -> code.TemplateRender
    sink method "sendScrapMessage" -> code.UrlFetch
  }
}
