import code.{CommandExecution, FilePathAccess, FileUse, SqlExecution}
adapter objc {
  package "LKDBHelper" {
    sink method "executeSQL:arguments:" -> code.SqlExecution
    sink method "executeScalarWithSQL:arguments:" -> code.SqlExecution
    sink method "executeDB:" -> code.SqlExecution
    sink method "searchWithSQL:toClass:" -> code.SqlExecution
    sink method "searchWithRAWSQL:toClass:" -> code.SqlExecution
    sink method "createDirectoryWithFilePath:" -> code.FilePathAccess
    sink method "getPathForDocuments:" -> code.FilePathAccess
    sink method "deleteWithFilepath:" -> code.FilePathAccess
    sink method "backupDBFilesToDirectory:" -> code.FilePathAccess
    sink method "restoreDBFilesFromDirectory:" -> code.FilePathAccess
    sink method "removeDBFiles" -> code.FilePathAccess
    sink method "isFileExists:" -> code.FileUse
    sink method "getFilenamesWithDir:" -> code.FileUse
    sink method "insertToDB:callback:" -> code.SqlExecution
    sink method "updateToDB:callback:" -> code.SqlExecution
    sink method "deleteToDB:callback:" -> code.SqlExecution
    sink method "search:where:orderBy:offset:count:" -> code.SqlExecution
    sink method "searchWithParams:" -> code.SqlExecution
    sink method "search:" -> code.SqlExecution
    sink method "setDBName:" -> code.FilePathAccess
    sink method "initWithDBPath:" -> code.FilePathAccess
    sink method "setDBPath:" -> code.FilePathAccess
  }
}
