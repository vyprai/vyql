import core.{AuthenticationCheck}

adapter objc {
  package "ParseFacebookUtilsV4" {
    control method "logInInBackgroundWithReadPermissions" -> core.AuthenticationCheck
    control method "logInInBackgroundWithPublishPermissions" -> core.AuthenticationCheck
    control method "logInInBackgroundWithAccessToken" -> core.AuthenticationCheck
    control method "linkUserInBackground" -> core.AuthenticationCheck
    control method "unlinkUserInBackground" -> core.AuthenticationCheck
    control method "authenticateAsyncWithReadPermissions" -> core.AuthenticationCheck
  }
}
