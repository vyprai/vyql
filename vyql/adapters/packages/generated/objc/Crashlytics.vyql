import code.{NetworkSend, SecretValue}
import core.{UserControlledData}

adapter objc {
  package "Crashlytics" {
    sink method "logSignUpWithMethod" -> code.NetworkSend
    sink method "logLoginWithMethod" -> code.NetworkSend
    sink method "logShareWithMethod" -> code.NetworkSend
    sink method "logInviteWithMethod" -> code.NetworkSend
    sink method "logPurchaseWithPrice" -> code.NetworkSend
    sink method "logLevelStart" -> code.NetworkSend
    sink method "logLevelEnd" -> code.NetworkSend
    sink method "logAddToCartWithPrice" -> code.NetworkSend
    sink method "logStartCheckoutWithPrice" -> code.NetworkSend
    sink method "logRating" -> code.NetworkSend
    sink method "logContentViewWithName" -> code.NetworkSend
    sink method "logSearchWithQuery" -> code.NetworkSend
    sink method "logCustomEventWithName" -> code.NetworkSend
    sink method "CLSLog" -> code.NetworkSend
    sink method "CLSLogv" -> code.NetworkSend
    sink method "CLSNSLog" -> code.NetworkSend
    sink method "CLSNSLogv" -> code.NetworkSend
    sink method "setObjectValue" -> code.NetworkSend
    source method "setUserIdentifier" -> core.UserControlledData
    source method "setUserName" -> core.UserControlledData
    source method "setUserEmail" -> core.UserControlledData
    source method "startWithAPIKey" -> code.SecretValue
  }
}
