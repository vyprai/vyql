import code.{Deserialization, FilePathAccess}

adapter objc {
  package "SSZipArchive" {
    sink method "unzipFileAtPath:toDestination:" -> code.Deserialization
    sink method "unzipFileAtPath:toDestination:" -> code.FilePathAccess
    sink method "unzipFileAtPath:toDestination:delegate:" -> code.Deserialization
    sink method "unzipFileAtPath:toDestination:delegate:" -> code.FilePathAccess
  }
}
