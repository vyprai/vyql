import code.{SecretValue, LogOutput}
import core.{UserControlledData}

adapter objc {
  package "CrashlyticsFramework" {
    source method "startWithAPIKey" -> code.SecretValue
    source method "setObjectValue" -> core.UserControlledData
    source method "setIntValue" -> core.UserControlledData
    source method "setBoolValue" -> core.UserControlledData
    source method "setFloatValue" -> core.UserControlledData
    source method "setUserIdentifier" -> core.UserControlledData
    source method "setUserName" -> core.UserControlledData
    source method "setUserEmail" -> core.UserControlledData
    sink method "CLSLog" -> code.LogOutput
    sink method "CLSLogv" -> code.LogOutput
    sink method "CLSNSLog" -> code.LogOutput
    sink method "CLSNSLogv" -> code.LogOutput
  }
}
