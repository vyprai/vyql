module bindings.objc.migration.mc92852c5;

binding weakHash0 {
  requires {
    dependency("AnyCodable-FlightSchool")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "anycodable.flightschool.hash"
  emit issue code.WeakHash at node
}
