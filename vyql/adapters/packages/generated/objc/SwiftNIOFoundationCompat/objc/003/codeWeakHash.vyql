module bindings.objc.migration.mc84d0226;

binding weakHash3 {
  requires {
    dependency("SwiftNIOFoundationCompat")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "swiftniofoundationcompat.hash"
  emit issue code.WeakHash at node
}
