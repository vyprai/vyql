import code.{NetworkSend, LogOutput}

adapter objc {
  package "GoogleUtilities" {
    sink method "postURL" -> code.NetworkSend
    sink method "getURL" -> code.NetworkSend
    sink method "GULOSLogError" -> code.LogOutput
    sink method "GULOSLogWarning" -> code.LogOutput
    sink method "GULOSLogNotice" -> code.LogOutput
    sink method "GULOSLogInfo" -> code.LogOutput
    sink method "GULOSLogDebug" -> code.LogOutput
  }
}
