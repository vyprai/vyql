import code.{SecretValue}
adapter objc {
  package "Valet" {
    source method "setObject" -> code.SecretValue
    source method "object" -> code.SecretValue
    source method "setString" -> code.SecretValue
    source method "string" -> code.SecretValue
    source method "containsObject" -> code.SecretValue
    source method "removeObject" -> code.SecretValue
    source method "migrateObjects" -> code.SecretValue
    source method "migrateObjectsFromAlwaysAccessibleValet" -> code.SecretValue
  }
}
