import code.{SecretValue}
import core.{AuthenticationCheck}

adapter dart {
  package "firebase_auth" {
    source method "getIdToken" -> code.SecretValue
    control method "signInWithCredential" -> core.AuthenticationCheck
    control method "signInWithEmailAndPassword" -> core.AuthenticationCheck
    control method "signInAnonymously" -> core.AuthenticationCheck
    control method "sendPasswordResetEmail" -> core.AuthenticationCheck
    control method "confirmPasswordReset" -> core.AuthenticationCheck
    control method "createUserWithEmailAndPassword" -> core.AuthenticationCheck
    control method "reauthenticateWithCredential" -> core.AuthenticationCheck
    control method "linkWithCredential" -> core.AuthenticationCheck
    control method "verifyBeforeUpdateEmail" -> core.AuthenticationCheck
  }
}
