module bindings.dart.migration.mc2ae0e2a;

binding privilegedOp8 {
  requires {
    dependency("app_settings")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "openBatteryOptimizationSettings"
  emit issue code.PrivilegedOp at node
  emit sink code.PrivilegedOpSink at node
}
