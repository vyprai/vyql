module bindings.dart.migration.mcb5af206;

binding privilegedOp0 {
  requires {
    dependency("in_app_purchase_android")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "acknowledgePurchase"
