import code.{RedirectTarget}
import core.{UserControlledData}

adapter dart {
  package "firebase_dynamic_links" {
    source method "getDynamicLink" -> core.UserControlledData
    flag code.RedirectTarget on any {
      method "buildLink"
    }
    flag code.RedirectTarget on any {
      method "buildShortLink"
    }
    source method "onNewIntent" -> core.UserControlledData
    source method "onMethodCall" -> core.UserControlledData
  }
}
