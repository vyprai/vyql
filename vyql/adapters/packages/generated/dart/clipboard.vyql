import code.{StoredDataWrite, StoredDataRead}

adapter dart {
  package "clipboard" {
    sink method "copy" -> code.StoredDataWrite
    sink method "copyRichText" -> code.StoredDataWrite
    sink method "copyMultiple" -> code.StoredDataWrite
    sink method "copyImage" -> code.StoredDataWrite
    sink method "copyWithCallback" -> code.StoredDataWrite

    source method "paste" -> code.StoredDataRead
    source method "pasteRichText" -> code.StoredDataRead
    source method "pasteImage" -> code.StoredDataRead
    source method "getContentType" -> code.StoredDataRead
    source method "hasData" -> code.StoredDataRead
  }
}
