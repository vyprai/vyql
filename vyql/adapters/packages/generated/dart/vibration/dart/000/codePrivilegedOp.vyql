module bindings.dart.migration.m230aecc1;

binding privilegedOp0 {
  requires {
    dependency("vibration")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "vibrate"
  emit issue code.PrivilegedOp at node
  emit sink code.PrivilegedOpSink at node
}
