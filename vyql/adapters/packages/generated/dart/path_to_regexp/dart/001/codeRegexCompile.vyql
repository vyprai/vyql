module bindings.dart.migration.m4a35b5c0;

binding regexCompile1 {
  requires {
    dependency("path_to_regexp")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "parse"
  emit issue code.RegexCompile at node
  emit sink code.RegexCompileSink at node
}
