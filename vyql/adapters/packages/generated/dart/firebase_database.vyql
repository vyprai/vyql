import code.{DatabaseRead}
adapter dart {
  package "firebase_database" {
    sink method "Query.startAt" -> code.DatabaseRead
    sink method "Query.startAfter" -> code.DatabaseRead
    sink method "Query.endAt" -> code.DatabaseRead
    sink method "Query.endBefore" -> code.DatabaseRead
    sink method "Query.equalTo" -> code.DatabaseRead
    sink method "Query.limitToFirst" -> code.DatabaseRead
    sink method "Query.limitToLast" -> code.DatabaseRead
    sink method "Query.orderByChild" -> code.DatabaseRead
    sink method "Query.orderByKey" -> code.DatabaseRead
    sink method "Query.orderByValue" -> code.DatabaseRead
    sink method "Query.orderByPriority" -> code.DatabaseRead
  }
}
