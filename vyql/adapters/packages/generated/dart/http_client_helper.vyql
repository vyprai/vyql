import code.{NetworkConnect, HttpInput}
adapter dart {
  package "http_client_helper" {
    sink method "get" -> code.NetworkConnect
    sink method "post" -> code.NetworkConnect
    sink method "head" -> code.NetworkConnect
    sink method "put" -> code.NetworkConnect
    sink method "patch" -> code.NetworkConnect
    sink method "delete" -> code.NetworkConnect
    sink method "read" -> code.NetworkConnect
    sink method "readBytes" -> code.NetworkConnect
    sink method "send" -> code.NetworkConnect
  }
}
