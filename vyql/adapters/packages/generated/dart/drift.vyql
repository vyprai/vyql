import code.{SqlExecution}
adapter dart {
  package "drift" {
    sink method "run" -> code.SqlExecution
    sink method "exec" -> code.SqlExecution
    sink method "runCustom" -> code.SqlExecution
    sink method "runInsert" -> code.SqlExecution
    sink method "runUpdate" -> code.SqlExecution
    sink method "runBatched" -> code.SqlExecution
  }
}
