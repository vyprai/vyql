import code.{Deserialization, FilePathAccess, RegexCompile}

adapter dart {
  package "glob" {
    sink method "parse" -> code.Deserialization
    sink method "list" -> code.FilePathAccess
    sink method "listSync" -> code.FilePathAccess
    flag code.RegexCompile on any {
      method "matchAsPrefix"
    }
    flag code.RegexCompile on any {
      method "matches"
    }
  }
}
