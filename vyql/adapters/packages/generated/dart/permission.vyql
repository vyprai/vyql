import code.{PrivilegedOp}
adapter dart {
  package "permission" {
    flag code.PrivilegedOp on any {
      method "requestPermissions"
    }
    flag code.PrivilegedOp on any {
      method "requestSinglePermission"
    }
    flag code.PrivilegedOp on any {
      method "openSettings"
    }
  }
}
