import code.{PrivilegedOp}
adapter dart {
  package "app_settings" {
    flag code.PrivilegedOp on any {
      method "openAppSettings"
    }
    flag code.PrivilegedOp on any {
      method "openAppSettingsPanel"
    }
    flag code.PrivilegedOp on any {
      method "handleOpenSettings"
    }
    flag code.PrivilegedOp on any {
      method "openSettings"
    }
    flag code.PrivilegedOp on any {
      method "openSubscriptionSettings"
    }
    flag code.PrivilegedOp on any {
      method "handleOpenSettingsPanel"
    }
    flag code.PrivilegedOp on any {
      method "openAppLocaleSettings"
    }
    flag code.PrivilegedOp on any {
      method "openAlarmSettings"
    }
    flag code.PrivilegedOp on any {
      method "openBatteryOptimizationSettings"
    }
    flag code.PrivilegedOp on any {
      method "openHotspotSettings"
    }
    flag code.PrivilegedOp on any {
      method "openNotificationSettings"
    }
    flag code.PrivilegedOp on any {
      method "openSettingsWithIntent"
    }
    flag code.PrivilegedOp on any {
      method "openVpnSettings"
    }
  }
}
