module bindings.dart.migration.mb06f65f7;

binding regexCompile4 {
  requires {
    dependency("glob")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "matches"
  emit issue code.RegexCompile at node
  emit sink code.RegexCompileSink at node
}
