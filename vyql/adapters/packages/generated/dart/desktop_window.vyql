adapter dart {
  package "desktop_window" {
    flag code.PrivilegedOp on any {
      method "setWindowSize"
    }
    flag code.PrivilegedOp on any {
      method "setMinWindowSize"
    }
    flag code.PrivilegedOp on any {
      method "setMaxWindowSize"
    }
    flag code.PrivilegedOp on any {
      method "setFullScreen"
    }
    flag code.PrivilegedOp on any {
      method "toggleFullScreen"
    }
    flag code.PrivilegedOp on any {
      method "setBorders"
    }
    flag code.PrivilegedOp on any {
      method "toggleBorders"
    }
  }
}
