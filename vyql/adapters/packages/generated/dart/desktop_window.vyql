adapter dart {
  package "desktop_window" {
    mark method "setWindowSize" -> code.PrivilegedOp
    mark method "setMinWindowSize" -> code.PrivilegedOp
    mark method "setMaxWindowSize" -> code.PrivilegedOp
    mark method "setFullScreen" -> code.PrivilegedOp
    mark method "toggleFullScreen" -> code.PrivilegedOp
    mark method "setBorders" -> code.PrivilegedOp
    mark method "toggleBorders" -> code.PrivilegedOp
  }
}
