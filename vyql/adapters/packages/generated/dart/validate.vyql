import core.{InputValidation}

adapter dart {
  package "validate" {
    control method "matchesPattern" -> core.InputValidation
    control method "isEmail" -> core.InputValidation
    control method "isPassword" -> core.InputValidation
    control method "isAlphaNumeric" -> core.InputValidation
    control method "isHex" -> core.InputValidation
    control method "isUUID" -> core.InputValidation
    control method "isJson" -> core.InputValidation
  }
}
