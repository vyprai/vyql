import code.{NosqlQuery, StoredDataRead, StoredDataWrite}
adapter dart {
  package "cloud_firestore_web" {
    sink method "collection" -> code.NosqlQuery
    sink method "doc" -> code.NosqlQuery
    sink method "set" -> code.StoredDataWrite
    sink method "update" -> code.StoredDataWrite
    sink method "delete" -> code.StoredDataWrite
    source method "get" -> code.StoredDataRead
    sink method "collectionGroup" -> code.NosqlQuery
  }
}
