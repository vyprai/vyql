import code.{SecretValue, NetworkConnect}

adapter dart {
  package "twitter_login" {
    source method "TwitterLogin.apiKey" -> code.SecretValue
    source method "TwitterLogin.apiSecretKey" -> code.SecretValue
    sink method "RequestToken.getRequestToken" -> code.NetworkConnect
    sink method "Oauth2.getBearerToken" -> code.NetworkConnect
  }
}
