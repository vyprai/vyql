module bindings.dart.migration.m22d0a444;

binding weakHash0 {
  requires {
    dependency("extended_image_library")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "keyToMd5"
  emit issue code.WeakHash at node
}
