module bindings.dart.migration.m82aed6aa;

binding privilegedOp0 {
  requires {
    dependency("vibration_web")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "VibrationWebPlugin.registerWith"
  emit issue code.PrivilegedOp at node
  emit sink code.PrivilegedOpSink at node
}
