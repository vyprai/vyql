import code.{StoredDataRead, StoredDataWrite}
import core.{UserControlledData}

adapter dart {
  package "contacts_service" {
    source method "getContacts" -> code.StoredDataRead
    source method "getContactsForPhone" -> code.StoredDataRead
    source method "getContactsForEmail" -> code.StoredDataRead
    sink method "addContact" -> code.StoredDataWrite
    sink method "deleteContact" -> code.StoredDataWrite
    sink method "updateContact" -> code.StoredDataWrite
    source method "openContactForm" -> core.UserControlledData
    source method "openExistingContact" -> core.UserControlledData
    source method "openDeviceContactPicker" -> core.UserControlledData
  }
}
