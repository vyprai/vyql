import code.{Deserialization}
adapter dart {
  package "_fe_analyzer_shared" {
    sink method "beginMetadata" -> code.Deserialization
    sink method "endMetadata" -> code.Deserialization
    sink method "endMetadataStar" -> code.Deserialization
    sink method "handleIdentifier" -> code.Deserialization
    sink method "endConstExpression" -> code.Deserialization
    sink method "handleSpreadExpression" -> code.Deserialization
    sink method "handleNullAwareElement" -> code.Deserialization
    sink method "handleParenthesizedCondition" -> code.Deserialization
    sink method "endIfControlFlow" -> code.Deserialization
    sink method "handleElseControlFlow" -> code.Deserialization
    sink method "endIfElseControlFlow" -> code.Deserialization
    sink method "endConstLiteral" -> code.Deserialization
    sink method "handleNamedRecordField" -> code.Deserialization
    sink method "endRecordLiteral" -> code.Deserialization
    sink method "handleDotAccess" -> code.Deserialization
    sink method "endBinaryExpression" -> code.Deserialization
  }
}
