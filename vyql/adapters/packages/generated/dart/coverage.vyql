import code.{Deserialization, FilePathAccess, CliArgument}
import core.{UserControlledData}

adapter dart {
  package "coverage" {
    sink method "HitMap.parseJsonSync" -> code.Deserialization
    sink method "HitMap.parseJson" -> code.Deserialization
    sink method "HitMap.parseFiles" -> code.Deserialization
    source method "Options.parse" -> core.UserControlledData
    sink method "findOptionsFilePath" -> code.FilePathAccess
  }
}
