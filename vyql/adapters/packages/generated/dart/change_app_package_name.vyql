import code.{CliArgument, FilePathAccess}

adapter dart {
  package "change_app_package_name" {
    source method "main" -> code.CliArgument
    sink method "replaceInFile" -> code.FilePathAccess
    sink method "replaceInFileRegex" -> code.FilePathAccess
    sink method "readFileAsString" -> code.FilePathAccess
    sink method "writeFileFromString" -> code.FilePathAccess
    sink method "deleteOldDirectories" -> code.FilePathAccess
  }
}
