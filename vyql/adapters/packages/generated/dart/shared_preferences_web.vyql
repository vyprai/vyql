import code.{StoredDataRead, StoredDataWrite}
adapter dart {
  package "shared_preferences_web" {
    sink method "SharedPreferencesPlugin.setValue" -> code.StoredDataWrite
    source method "SharedPreferencesPlugin.getValue" -> code.StoredDataRead
    sink method "SharedPreferencesPlugin.remove" -> code.StoredDataWrite
    sink method "SharedPreferencesPlugin.clear" -> code.StoredDataWrite
    source method "SharedPreferencesPlugin.getAll" -> code.StoredDataRead
    source method "SharedPreferencesPlugin.getKeys" -> code.StoredDataRead
  }
}
