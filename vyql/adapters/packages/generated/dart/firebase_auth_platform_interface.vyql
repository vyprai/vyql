import code.{SecretValue}
import core.{InputValidation}

adapter dart {
  package "firebase_auth_platform_interface" {
    source method "getIdToken" -> code.SecretValue
    source method "getIdTokenResult" -> code.SecretValue
    source method "credentialFromToken" -> code.SecretValue
    source method "generateSecret" -> code.SecretValue
    source method "openInOtpApp" -> code.SecretValue
    control method "isPasswordValid" -> core.InputValidation
  }
}
