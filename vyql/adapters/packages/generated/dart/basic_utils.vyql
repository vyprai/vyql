import code.{NetworkData, NetworkSend}
adapter dart {
  package "basic_utils" {
    source method "getForFullResponse" -> code.NetworkData
    source method "getForJson" -> code.NetworkData
    source method "getForString" -> code.NetworkData
    sink method "postForFullResponse" -> code.NetworkSend
    sink method "postForJson" -> code.NetworkSend
    sink method "postForString" -> code.NetworkSend
    sink method "putForFullResponse" -> code.NetworkSend
    sink method "putForJson" -> code.NetworkSend
    sink method "putForString" -> code.NetworkSend
    sink method "deleteForFullResponse" -> code.NetworkSend
    sink method "deleteForJson" -> code.NetworkSend
    sink method "deleteForString" -> code.NetworkSend
  }
}
