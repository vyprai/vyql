import code.{FilePathAccess}

adapter dart {
  package "watcher" {
    sink method "createFile" -> code.FilePathAccess
    sink method "createDirectory" -> code.FilePathAccess
    sink method "delete" -> code.FilePathAccess
    sink method "modifyFile" -> code.FilePathAccess
    sink method "poll" -> code.FilePathAccess
    sink method "NativeFileWatcher" -> code.FilePathAccess
    sink method "PollingFileWatcher" -> code.FilePathAccess
    sink method "LinuxDirectoryWatcher" -> code.FilePathAccess
    sink method "PollingDirectoryWatcher" -> code.FilePathAccess
  }
}
