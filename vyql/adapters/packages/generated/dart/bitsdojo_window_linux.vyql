import code.{PrivilegedOp}
adapter dart {
  package "bitsdojo_window_linux" {
    flag code.PrivilegedOp on any {
      method "startWindowDrag"
    }
    flag code.PrivilegedOp on any {
      method "startDragging"
    }
    flag code.PrivilegedOp on any {
      method "start_window_drag_at_position"
    }
    flag code.PrivilegedOp on any {
      method "setPosition"
    }
    flag code.PrivilegedOp on any {
      method "setSize"
    }
    flag code.PrivilegedOp on any {
      method "setRect"
    }
    flag code.PrivilegedOp on any {
      method "setMinSize"
    }
    flag code.PrivilegedOp on any {
      method "setMaxSize"
    }
    flag code.PrivilegedOp on any {
      method "showWindow"
    }
    flag code.PrivilegedOp on any {
      method "hideWindow"
    }
    flag code.PrivilegedOp on any {
      method "minimizeWindow"
    }
    flag code.PrivilegedOp on any {
      method "maximizeWindow"
    }
    flag code.PrivilegedOp on any {
      method "unmaximizeWindow"
    }
    flag code.PrivilegedOp on any {
      method "setWindowTitle"
    }
  }
}
