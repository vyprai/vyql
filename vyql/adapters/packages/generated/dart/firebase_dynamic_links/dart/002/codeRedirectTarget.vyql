module bindings.dart.migration.md0448496;

binding redirectTarget2 {
  requires {
    dependency("firebase_dynamic_links")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "buildShortLink"
  emit issue code.RedirectTarget at node
  emit sink code.RedirectTargetSink at node
}
