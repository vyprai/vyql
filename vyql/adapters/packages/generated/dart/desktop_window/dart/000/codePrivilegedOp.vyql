module bindings.dart.migration.m3f72b36e;

binding privilegedOp0 {
  requires {
    dependency("desktop_window")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "setWindowSize"
  emit issue code.PrivilegedOp at node
  emit sink code.PrivilegedOpSink at node
}
