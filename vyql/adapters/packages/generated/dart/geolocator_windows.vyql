import core.{UserControlledData, AuthorizationCheck}
adapter dart {
  package "geolocator_windows" {
    source method "GetLocationAccuracy" -> core.UserControlledData
    control method "OnRequestPermission" -> core.AuthorizationCheck
    control method "OnCheckPermission" -> core.AuthorizationCheck
    control method "OnIsLocationServiceEnabled" -> core.AuthorizationCheck
    control method "OpenPrivacyLocationSettings" -> core.AuthorizationCheck
  }
}
