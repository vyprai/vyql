import code.{FilePathAccess, FileUse, WeakHash}

adapter dart {
  package "extended_image_library" {
    mark method "keyToMd5" -> code.WeakHash
    sink method "clearDiskCachedImage" -> code.FileUse
    sink method "getCachedImageFile" -> code.FilePathAccess
    sink method "getCachedImageFilePath" -> code.FilePathAccess
    sink method "cachedImageExists" -> code.FilePathAccess
  }
}
