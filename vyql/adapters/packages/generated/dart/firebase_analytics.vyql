import code.{LogOutput, SecretValue}
import core.{UserControlledData}

adapter dart {
  package "firebase_analytics" {
    sink method "logEvent" -> code.LogOutput
    source method "setUserId" -> core.UserControlledData
    source method "setUserProperty" -> core.UserControlledData
    source method "getSessionId" -> code.SecretValue
  }
}
