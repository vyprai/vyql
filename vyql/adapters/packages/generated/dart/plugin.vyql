import core.{InputValidation, UserControlledData}
import code.{CodeEval}
adapter dart {
  package "plugin" {
    source method "RegisterExtension" -> core.UserControlledData
    source method "RegisterExtensionPoint" -> core.UserControlledData
    control method "ValidateExtension" -> core.InputValidation
    sink method "processPlugins" -> code.CodeEval
  }
}
