import code.{WeakHash}

adapter cpp {
  package "tracy" {
    flag code.WeakHash on any {
      method "XXH32"
    }
    flag code.WeakHash on any {
      method "XXH32_freeState"
    }
    flag code.WeakHash on any {
      method "XXH32_copyState"
    }
    flag code.WeakHash on any {
      method "XXH32_reset"
    }
    flag code.WeakHash on any {
      method "XXH32_digest"
    }
    flag code.WeakHash on any {
      method "XXH32_canonicalFromHash"
    }
    flag code.WeakHash on any {
      method "XXH32_hashFromCanonical"
    }
    flag code.WeakHash on any {
      method "XXH64"
    }
    flag code.WeakHash on any {
      method "XXH64_freeState"
    }
    flag code.WeakHash on any {
      method "XXH64_copyState"
    }
    flag code.WeakHash on any {
      method "XXH64_reset"
    }
    flag code.WeakHash on any {
      method "XXH64_update"
    }
    flag code.WeakHash on any {
      method "XXH64_digest"
    }
    flag code.WeakHash on any {
      method "XXH64_canonicalFromHash"
    }
    flag code.WeakHash on any {
      method "XXH64_hashFromCanonical"
    }
    flag code.WeakHash on any {
      method "XXH3_64bits"
    }
    flag code.WeakHash on any {
      method "XXH3_64bits_withSeed"
    }
    flag code.WeakHash on any {
      method "XXH3_64bits_withSecret"
    }
    flag code.WeakHash on any {
      method "XXH3_freeState"
    }
    flag code.WeakHash on any {
      method "XXH3_copyState"
    }
    flag code.WeakHash on any {
      method "XXH3_64bits_reset"
    }
  }
}
