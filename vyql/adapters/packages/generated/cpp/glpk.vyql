    sink method "glp_write_ipt" -> code.FilePathAccess
    sink method "glp_read_mip" -> code.FilePathAccess
    sink method "glp_write_mip" -> code.FilePathAccess
    sink method "glp_read_mps" -> code.FilePathAccess
    sink method "glp_write_mps" -> code.FilePathAccess
    sink method "glp_read_lp" -> code.FilePathAccess
    sink method "glp_write_lp" -> code.FilePathAccess
    sink method "glp_read_prob" -> code.FilePathAccess
    sink method "glp_write_prob" -> code.FilePathAccess
  }
}
