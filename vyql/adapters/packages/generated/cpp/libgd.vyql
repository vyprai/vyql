import code.{Deserialization}

adapter cpp {
  package "libgd" {
    sink method "gdImageCreateFromPng" -> code.Deserialization
    sink method "gdImageCreateFromQoi" -> code.Deserialization
    sink method "gdImageCreateFromGif" -> code.Deserialization
    sink method "gdImageCreateFromWBMP" -> code.Deserialization
    sink method "gdImageCreateFromWBMPCtx" -> code.Deserialization
    sink method "gdImageCreateFromJpeg" -> code.Deserialization
    sink method "gdImageCreateFromJpegCtx" -> code.Deserialization
    sink method "gdImageCreateFromWebp" -> code.Deserialization
    sink method "gdImageCreateFromWebpCtx" -> code.Deserialization
  }
}
