import code.{CommandExecution}
import core.{UserControlledData}

adapter cpp {
  package "qt5-androidextras" {
    source method "writeData" -> core.UserControlledData
    source method "writeVariant" -> core.UserControlledData
    source method "writeBinder" -> core.UserControlledData
    source method "writeFileDescriptor" -> core.UserControlledData
    source method "readData" -> core.UserControlledData
    source method "readVariant" -> core.UserControlledData
    source method "readBinder" -> core.UserControlledData
    source method "readFileDescriptor" -> core.UserControlledData
  }
}
