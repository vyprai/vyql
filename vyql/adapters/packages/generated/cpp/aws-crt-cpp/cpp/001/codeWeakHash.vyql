module bindings.cpp.migration.m4fa6ca30;

binding weakHash1 {
  requires {
    dependency("aws-crt-cpp")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
