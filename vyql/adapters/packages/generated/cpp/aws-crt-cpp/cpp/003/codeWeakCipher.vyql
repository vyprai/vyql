module bindings.cpp.migration.m4fa6ca30;

binding weakCipher3 {
  requires {
    dependency("aws-crt-cpp")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "SetBYOCryptoNewSHA256HMACCallback"
  emit issue code.WeakCipher at node
}
