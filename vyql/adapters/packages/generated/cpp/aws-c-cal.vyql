import code.{WeakHash}
adapter cpp {
  package "aws-c-cal" {
    flag code.WeakHash on any {
      method "aws_md5_new"
    }
    flag code.WeakHash on any {
      method "aws_sha1_new"
    }
    flag code.WeakHash on any {
      method "aws_md5_compute"
    }
    flag code.WeakHash on any {
      method "aws_sha1_compute"
    }
  }
}
