module bindings.cpp.migration.m50d9fa15;

binding weakHash2 {
  requires {
    dependency("xtl")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "murmur2_x64"
  emit issue code.WeakHash at node
}
