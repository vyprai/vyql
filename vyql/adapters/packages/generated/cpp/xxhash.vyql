import code.{WeakHash}

adapter cpp {
  package "xxhash" {
    flag code.WeakHash on any {
      method "XXH3_64bits"
    }
    flag code.WeakHash on any {
      method "XXH3_128bits"
    }
    flag code.WeakHash on any {
      method "XXH64"
    }
    flag code.WeakHash on any {
      method "XXH32"
    }
  }
}
