import code.{Deserialization, FilePathAccess}
adapter cpp {
  package "boost-xpressive" {
    sink method "parse_alternates" -> code.Deserialization
    sink method "parse_group" -> code.Deserialization
    sink method "parse_charset" -> code.Deserialization
    sink method "parse_atom" -> code.Deserialization
    sink method "parse_quant" -> code.Deserialization
    sink method "parse_sequence" -> code.Deserialization
    sink method "parse_literal" -> code.Deserialization
    sink method "parse_quote_meta" -> code.Deserialization
    sink method "parse_escape" -> code.Deserialization
    sink method "load_file" -> code.FilePathAccess
  }
}
