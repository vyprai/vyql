import code.{Deserialization, FilePathAccess, UrlFetch}
import core.{UserControlledData}

adapter cpp {
  package "opusfile" {
    sink method "opus_head_parse" -> code.Deserialization
    sink method "opus_tags_parse" -> code.Deserialization
    sink method "opus_picture_tag_parse" -> code.Deserialization
    sink method "op_fopen" -> code.FilePathAccess
    sink method "op_fdopen" -> code.FilePathAccess
    sink method "op_freopen" -> code.FilePathAccess
    sink method "op_open_file" -> code.FilePathAccess
    source method "op_open_memory" -> core.UserControlledData
    sink method "op_url_stream_create" -> code.UrlFetch
    sink method "op_open_url" -> code.UrlFetch
  }
}
