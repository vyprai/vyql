import code.{WeakHash}
adapter cpp {
  package "xtl" {
    flag code.WeakHash on any {
      method "hash_bytes"
    }
    flag code.WeakHash on any {
      method "murmur2_x86"
    }
    flag code.WeakHash on any {
      method "murmur2_x64"
    }
    flag code.WeakHash on any {
      method "murmur_hash"
    }
  }
}
