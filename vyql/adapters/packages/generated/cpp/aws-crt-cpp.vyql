adapter cpp {
  package "aws-crt-cpp" {
    source method "Base64Decode" -> core.UserControlledData
    flag code.WeakHash on any {
      method "SetBYOCryptoNewMD5Callback"
    }
    flag code.WeakHash on any {
      method "SetBYOCryptoNewSHA1Callback"
    }
    flag code.WeakCipher on any {
      method "SetBYOCryptoNewSHA256HMACCallback"
    }
    flag code.WeakCipher on any {
      method "SetBYOCryptoNewSHA512HMACCallback"
    }
    flag code.CertValidationDisabled on any {
      method "SetBYOCryptoClientTlsCallback"
    }
    flag code.CertValidationDisabled on any {
      method "SetBYOCryptoTlsContextCallbacks"
    }
  }
}
