import code.{NetworkBind, NetworkConnect, NetworkData, NetworkSend}
adapter cpp {
  package "qtconnectivity" {
    sink method "QBluetoothServer::listen" -> code.NetworkBind
    source method "QBluetoothServer::nextPendingConnection" -> code.NetworkData
    sink method "QBluetoothSocket::connectToService" -> code.NetworkConnect
    sink method "QBluetoothSocket::writeData" -> code.NetworkSend
    source method "QBluetoothSocket::readData" -> code.NetworkData
  }
}
