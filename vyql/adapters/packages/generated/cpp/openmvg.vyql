    sink method "ReadTiff" -> code.FilePathAccess
    sink method "WriteImage" -> code.FilePathAccess
    sink method "WritePng" -> code.FilePathAccess
    sink method "WriteJpg" -> code.FilePathAccess
    sink method "WritePnm" -> code.FilePathAccess
    sink method "WriteTiff" -> code.FilePathAccess
    sink method "open" -> code.FilePathAccess
  }
}
