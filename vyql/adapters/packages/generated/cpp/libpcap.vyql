import code.{NetworkData, NetworkSend, NetworkConnect, CommandExecution}
adapter cpp {
  package "libpcap" {
    source method "read" -> code.NetworkData
    source method "recv" -> code.NetworkData
    sink method "write" -> code.NetworkSend
    sink method "send" -> code.NetworkSend
    sink method "connect" -> code.NetworkConnect
    sink method "system" -> code.CommandExecution
  }
}
