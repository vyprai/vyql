import code.{WeakHash}
adapter cpp {
  package "boost-container-hash" {
    flag code.WeakHash on any {
      method "hash_value"
    }
    flag code.WeakHash on any {
      method "hash_combine"
    }
    flag code.WeakHash on any {
      method "hash_range"
    }
    flag code.WeakHash on any {
      method "hash_unordered_range"
    }
  }
}
