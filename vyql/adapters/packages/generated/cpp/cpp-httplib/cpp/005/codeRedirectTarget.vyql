module bindings.cpp.migration.mb7311fac;

binding redirectTarget5 {
  requires {
    dependency("cpp-httplib")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
