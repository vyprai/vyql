module bindings.cpp.migration.mb7311fac;

binding weakHash11 {
  requires {
    dependency("cpp-httplib")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "hash_core"
  emit issue code.WeakHash at node
}
