module bindings.cpp.migration.m8056df59;

binding weakHash2 {
  requires {
    dependency("libpq")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "pg_md5_final"
  emit issue code.WeakHash at node
}
