import code.{Deserialization}
adapter cpp {
  package "boost-regex" {
    sink method "parse" -> code.Deserialization
    sink method "regex_match" -> code.Deserialization
    sink method "regex_search" -> code.Deserialization
    sink method "do_regex_match" -> code.Deserialization
    sink method "u32regex_match" -> code.Deserialization
    sink method "do_regex_search" -> code.Deserialization
    sink method "u32regex_search" -> code.Deserialization
    sink method "regexecA" -> code.Deserialization
  }
}
