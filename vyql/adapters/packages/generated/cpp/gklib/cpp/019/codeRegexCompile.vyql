module bindings.cpp.migration.m5d6a286e;

binding regexCompile19 {
  requires {
    dependency("gklib")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "re_match_2"
  emit issue code.RegexCompile at node
  emit sink code.RegexCompileSink at node
}
