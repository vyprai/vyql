module bindings.cpp.migration.m64fe9f9b;

binding weakHash1 {
  requires {
    dependency("rhash")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "rhash_init_multi"
  emit issue code.WeakHash at node
}
