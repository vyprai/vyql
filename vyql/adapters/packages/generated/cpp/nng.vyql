import code.{FilePathAccess, NetworkConnect, NetworkBind, NetworkData}
import core.{PathCanonicalization, InputValidation}

adapter cpp {
  package "nng" {
    sink method "nni_file_put" -> code.FilePathAccess
    sink method "nni_file_get" -> code.FilePathAccess
    sink method "nni_file_delete" -> code.FilePathAccess
    sink method "nni_file_walk" -> code.FilePathAccess
    control method "nni_file_join" -> core.PathCanonicalization
    control method "nni_url_parse" -> core.InputValidation
    sink method "nni_tcp_dialer_alloc" -> code.NetworkConnect
    sink method "nni_tcp_listener_alloc" -> code.NetworkBind
    source method "nni_pipe_recv" -> code.NetworkData
    source method "nni_pipe_send" -> code.NetworkData
  }
}
