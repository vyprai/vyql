import code.{FilePathAccess, NosqlQuery}

adapter cpp {
  package "lmdb" {
    sink method "mdb_env_open" -> code.FilePathAccess
    sink method "mdb_dbi_open" -> code.NosqlQuery
    sink method "mdb_env_copy" -> code.FilePathAccess
    sink method "mdb_env_copy2" -> code.FilePathAccess
    sink method "mdb_env_copyfd" -> code.FilePathAccess
    sink method "mdb_env_copyfd2" -> code.FilePathAccess
  }
}
