import code.{WeakHash}
adapter cpp {
  package "cityhash" {
    flag code.WeakHash on any {
      method "CityHash64"
    }
    flag code.WeakHash on any {
      method "CityHash64WithSeed"
    }
    flag code.WeakHash on any {
      method "CityHash64WithSeeds"
    }
    flag code.WeakHash on any {
      method "CityHash128"
    }
    flag code.WeakHash on any {
      method "CityHash128WithSeed"
    }
    flag code.WeakHash on any {
      method "CityHash32"
    }
    flag code.WeakHash on any {
      method "CityHashCrc128"
    }
    flag code.WeakHash on any {
      method "CityHashCrc128WithSeed"
    }
    flag code.WeakHash on any {
      method "CityHashCrc256"
    }
  }
}
