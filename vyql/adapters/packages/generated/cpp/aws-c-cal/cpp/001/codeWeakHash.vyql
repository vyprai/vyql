module bindings.cpp.migration.m0e4711e9;

binding weakHash1 {
  requires {
    dependency("aws-c-cal")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "aws_sha1_new"
  emit issue code.WeakHash at node
}
