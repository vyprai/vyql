module bindings.cpp.migration.m247f06f3;

binding networkConnect0 {
  requires {
    dependency("qt5-serialport")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "open"
  emit issue code.NetworkConnect at node
  emit sink code.NetworkConnectSink at node
}
