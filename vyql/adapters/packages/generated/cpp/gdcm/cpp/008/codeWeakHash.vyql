module bindings.cpp.migration.m56a368d6;

binding weakHash8 {
  requires {
    dependency("gdcm")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "ComputeFile"
  emit issue code.WeakHash at node
}
