import code.{NetworkConnect, NetworkBind, FilePathAccess, SecretValue}
import core.{InputValidation}

adapter cpp {
  package "aws-c-io" {
    sink method "aws_socket_connect" -> code.NetworkConnect
    sink method "aws_socket_bind" -> code.NetworkBind
    sink method "aws_socket_listen" -> code.NetworkBind
    sink method "aws_pem_objects_init_from_file_path" -> code.FilePathAccess
    control method "aws_sanitize_pem" -> core.InputValidation
    source method "aws_tls_s2n_load_macos_keychain_root_cas" -> code.SecretValue
  }
}
