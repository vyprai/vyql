import code.{NetworkData, NetworkBind, NetworkConnect, NetworkSend}

adapter cpp {
  package "zeromq" {
    source method "zmq_msg_recv" -> code.NetworkData
    sink method "zmq_msg_send" -> code.NetworkSend
    sink method "zmq_bind" -> code.NetworkBind
    sink method "zmq_connect" -> code.NetworkConnect
  }
}
