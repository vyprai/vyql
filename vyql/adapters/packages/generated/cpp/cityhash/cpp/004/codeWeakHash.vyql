module bindings.cpp.migration.m9209981e;

binding weakHash4 {
  requires {
    dependency("cityhash")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "CityHash128WithSeed"
