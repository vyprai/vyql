import code.{WeakHash}
adapter cpp {
  package "hash-library" {
    mark method "MD5.add" -> code.WeakHash
    mark method "MD5.getHash" -> code.WeakHash

    mark method "SHA1.add" -> code.WeakHash
    mark method "SHA1.getHash" -> code.WeakHash

    mark method "CRC32.add" -> code.WeakHash
    mark method "CRC32.getHash" -> code.WeakHash
  }
}
