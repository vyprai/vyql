import code.{WeakHash}
adapter cpp {
  package "hash-library" {
    flag code.WeakHash on any {
      method "MD5.add"
    }
    flag code.WeakHash on any {
      method "MD5.getHash"
    }

    flag code.WeakHash on any {
      method "SHA1.add"
    }
    flag code.WeakHash on any {
      method "SHA1.getHash"
    }

    flag code.WeakHash on any {
      method "CRC32.add"
    }
    flag code.WeakHash on any {
      method "CRC32.getHash"
    }
  }
}
