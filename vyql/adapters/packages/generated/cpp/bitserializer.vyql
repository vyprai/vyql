import code.{Deserialization}

adapter cpp {
  package "bitserializer" {
    sink method "ReadValue" -> code.Deserialization
    sink method "ParseNextRow" -> code.Deserialization
    sink method "ParseNextLine" -> code.Deserialization
    sink method "LoadFundamentalValue" -> code.Deserialization
    sink method "LoadString" -> code.Deserialization
  }
}
