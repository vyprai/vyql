module bindings.cpp.migration.mba04978c;

binding weakCipher6 {
  requires {
    dependency("libxcrypt")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "des_crypt_block"
  emit issue code.WeakCipher at node
}
