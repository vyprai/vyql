import code.{SqlExecution}

adapter cpp {
  package "sqlpp11" {
    sink method "eval" -> code.SqlExecution
    sink method "join" -> code.SqlExecution
    sink method "inner_join" -> code.SqlExecution
    sink method "left_outer_join" -> code.SqlExecution
    sink method "right_outer_join" -> code.SqlExecution
    sink method "outer_join" -> code.SqlExecution
    sink method "cross_join" -> code.SqlExecution
    sink method "where" -> code.SqlExecution
    sink method "dynamic_where" -> code.SqlExecution
  }
}
