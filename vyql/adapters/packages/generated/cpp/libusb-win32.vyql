import code.{Deserialization, NetworkData, NetworkSend}

adapter cpp {
  package "libusb-win32" {
    sink method "usb_bulk_write" -> code.NetworkSend
    source method "usb_bulk_read" -> code.NetworkData
    sink method "usb_interrupt_write" -> code.NetworkSend
    source method "usb_interrupt_read" -> code.NetworkData
    sink method "usb_control_msg" -> code.NetworkSend
    sink method "usb_parse_descriptor" -> code.Deserialization
  }
}
