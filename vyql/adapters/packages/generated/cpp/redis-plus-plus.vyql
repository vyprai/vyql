import code.{StoredDataWrite, StoredDataRead, SecretValue}
adapter cpp {
  package "redis-plus-plus" {
    source method "auth" -> code.SecretValue
    sink method "del" -> code.StoredDataWrite
    sink method "del_range" -> code.StoredDataWrite
    sink method "flushall" -> code.StoredDataWrite
    sink method "flushdb" -> code.StoredDataWrite
    source method "dump" -> code.StoredDataRead
    source method "info" -> code.StoredDataRead
    source method "lastsave" -> code.StoredDataRead
    sink method "save" -> code.StoredDataWrite
    source method "select" -> code.StoredDataRead
    sink method "swapdb" -> code.StoredDataWrite
  }
}
