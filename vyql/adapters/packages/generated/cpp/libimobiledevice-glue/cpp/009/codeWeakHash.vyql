module bindings.cpp.migration.m9681b87d;

binding weakHash9 {
  requires {
    dependency("libimobiledevice-glue")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "sha1_update"
  emit issue code.WeakHash at node
}
