import code.{XmlParse}
import core.{UserControlledData}

adapter cpp {
  package "librsvg" {
    sink method "rsvg_create_xml_parser_from_stream" -> code.XmlParse
    source method "rsvg_css_parse_color" -> core.UserControlledData
    source method "rsvg_css_parse_aspect_ratio" -> core.UserControlledData
    source method "rsvg_css_parse_opacity" -> core.UserControlledData
    source method "rsvg_css_parse_angle" -> core.UserControlledData
    source method "rsvg_css_parse_frequency" -> core.UserControlledData
    source method "rsvg_css_parse_time" -> core.UserControlledData
    source method "rsvg_css_parse_font_style" -> core.UserControlledData
    source method "rsvg_css_parse_font_variant" -> core.UserControlledData
    source method "rsvg_css_parse_font_weight" -> core.UserControlledData
    source method "rsvg_css_parse_font_stretch" -> core.UserControlledData
    source method "rsvg_css_parse_font_family" -> core.UserControlledData
    source method "rsvg_css_parse_vbox" -> core.UserControlledData
    source method "rsvg_css_parse_number_optional_number" -> core.UserControlledData
    source method "rsvg_css_parse_number_list" -> core.UserControlledData
    source method "rsvg_css_parse_overflow" -> core.UserControlledData
  }
}
