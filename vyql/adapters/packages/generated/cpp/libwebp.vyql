import code.{Deserialization}

adapter cpp {
  package "libwebp" {
    sink method "ReadPNG" -> code.Deserialization
    sink method "ReadPNM" -> code.Deserialization
    sink method "ReadJPEG" -> code.Deserialization
    sink method "ReadTIFF" -> code.Deserialization
    sink method "LoadWebP" -> code.Deserialization
    sink method "DecodeWebP" -> code.Deserialization
    sink method "DecodeWebPIncremental" -> code.Deserialization
    sink method "ReadWebP" -> code.Deserialization
    sink method "VP8GetHeaders" -> code.Deserialization
    sink method "VP8Decode" -> code.Deserialization
    sink method "VP8ParseProba" -> code.Deserialization
    sink method "VP8ParseIntraModeRow" -> code.Deserialization
  }
}
