import code.{FilePathAccess, ArchiveEntryWrite}
adapter cpp {
  package "kf5archive" {
    sink method "doPrepareWriting" -> code.FilePathAccess
    sink method "doWriteDir" -> code.FilePathAccess
    sink method "doWriteSymLink" -> code.FilePathAccess
    sink method "writeData" -> code.ArchiveEntryWrite
    sink method "openArchive" -> code.FilePathAccess
  }
}
