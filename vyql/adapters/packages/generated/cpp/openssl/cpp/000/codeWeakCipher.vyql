module bindings.cpp.migration.mdffc4e53;

binding weakCipher0 {
  requires {
    dependency("openssl")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "sslv3_method"
  emit issue code.WeakCipher at node
}
