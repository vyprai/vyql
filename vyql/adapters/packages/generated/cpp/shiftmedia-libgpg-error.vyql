import code.{CodeEval, FileUse}
adapter cpp {
  package "shiftmedia-libgpg-error" {
    sink method "scheme_load_file" -> code.FileUse
    sink method "scheme_load_string" -> code.CodeEval
    sink method "scheme_load_memory" -> code.CodeEval
    sink method "scheme_eval" -> code.CodeEval
    sink method "ffi_scheme_eval" -> code.CodeEval
  }
}
