import code.{FilePathAccess}
adapter cpp {
  package "boost-sort" {
    sink method "generate_file" -> code.FilePathAccess
    sink method "write_file_uint64" -> code.FilePathAccess
    sink method "write_file_string" -> code.FilePathAccess
    sink method "fill_vector_uint64" -> code.FilePathAccess
    sink method "fill_vector_string" -> code.FilePathAccess
  }
}
