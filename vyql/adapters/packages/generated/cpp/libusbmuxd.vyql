import code.{NetworkConnect, NetworkSend, NetworkData}

adapter cpp {
  package "libusbmuxd" {
    sink method "usbmuxd_connect" -> code.NetworkConnect
    sink method "usbmuxd_send" -> code.NetworkSend
    source method "usbmuxd_recv_timeout" -> code.NetworkData
    source method "usbmuxd_recv" -> code.NetworkData
  }
}
