module bindings.cpp.migration.m32f513a3;

binding weakHash2 {
  requires {
    dependency("boost-container-hash")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "hash_range"
  emit issue code.WeakHash at node
}
