module bindings.cpp.migration.mf3924679;

binding weakHash4 {
  requires {
    dependency("hash-library")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "CRC32.add"
  emit issue code.WeakHash at node
}
