import code.{FilePathAccess, FileUse, StoredDataRead, StoredDataWrite}
adapter cpp {
  package "physfs" {
    source method "PHYSFS_openRead" -> code.StoredDataRead
    sink method "PHYSFS_openWrite" -> code.StoredDataWrite
    sink method "PHYSFS_openAppend" -> code.StoredDataWrite
    source method "PHYSFS_read" -> code.StoredDataRead
    sink method "PHYSFS_write" -> code.StoredDataWrite
    sink method "PHYSFS_delete" -> code.FileUse
    sink method "PHYSFS_setWriteDir" -> code.FilePathAccess
    sink method "PHYSFS_addToSearchPath" -> code.FilePathAccess
    sink method "PHYSFS_removeFromSearchPath" -> code.FilePathAccess
    sink method "PHYSFS_getRealDir" -> code.FilePathAccess
  }
}
