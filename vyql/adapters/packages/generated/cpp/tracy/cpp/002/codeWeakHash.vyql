module bindings.cpp.migration.m8f316b0e;

binding weakHash2 {
  requires {
    dependency("tracy")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "XXH32_copyState"
  emit issue code.WeakHash at node
}
