import code.{Deserialization, FilePathAccess}
adapter cpp {
  package "libxmlpp" {
    sink method "parse" -> code.Deserialization
    sink method "parse_file" -> code.Deserialization
    sink method "parse_subset" -> code.Deserialization
    sink method "parse_memory" -> code.Deserialization
    sink method "parse_stream" -> code.Deserialization
  }
}
