import code.{Deserialization, FileUse}
adapter cpp {
  package "libigl" {
    sink method "parse_nodes" -> code.Deserialization
    sink method "parse_elements" -> code.Deserialization
    sink method "parse_node_field" -> code.Deserialization
    sink method "parse_element_field" -> code.Deserialization
    sink method "parse_unknown_field" -> code.Deserialization
    sink method "fin" -> code.FileUse
  }
}
