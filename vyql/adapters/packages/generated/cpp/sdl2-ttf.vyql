import code.{Deserialization}
adapter cpp {
  package "sdl2-ttf" {
    sink method "TTF_OpenFont" -> code.Deserialization
    sink method "TTF_OpenFontIndex" -> code.Deserialization
    sink method "TTF_OpenFontRW" -> code.Deserialization
    sink method "TTF_OpenFontIndexRW" -> code.Deserialization
    sink method "TTF_OpenFontDPI" -> code.Deserialization
    sink method "TTF_OpenFontIndexDPI" -> code.Deserialization
    sink method "TTF_OpenFontDPIRW" -> code.Deserialization
    sink method "TTF_OpenFontIndexDPIRW" -> code.Deserialization
  }
}
