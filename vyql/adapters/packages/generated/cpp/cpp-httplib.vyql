import code.{Deserialization, FilePathAccess, NetworkConnect, NetworkSend, RedirectTarget, ResponseHeaderWrite, WeakHash}
import core.{UserControlledData}

adapter cpp {
  package "cpp-httplib" {
    source method "get_header_value" -> core.UserControlledData
    source method "parse_url" -> core.UserControlledData
    source method "parse_port" -> core.UserControlledData

    sink method "parse" -> code.Deserialization
    sink method "write" -> code.NetworkSend
    mark method "set_redirect" -> code.RedirectTarget
    sink method "open" -> code.FilePathAccess
    sink method "connect" -> code.NetworkConnect
    sink method "set_file_content" -> code.FilePathAccess
    sink method "send" -> code.NetworkSend
    sink method "set_header" -> code.ResponseHeaderWrite

    mark method "hash_core" -> code.WeakHash
  }
}
