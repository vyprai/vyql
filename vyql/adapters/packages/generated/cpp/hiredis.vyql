import code.{NetworkData, NetworkConnect, NetworkSend}
import core.{InputValidation}

adapter cpp {
  package "hiredis" {
    source method "redisReaderFeed" -> code.NetworkData
    sink method "redisNetWrite" -> code.NetworkSend
    sink method "redisContextConnectTcp" -> code.NetworkConnect
    sink method "redisContextConnectUnix" -> code.NetworkConnect
    control method "sdssplitargs" -> core.InputValidation
  }
}
