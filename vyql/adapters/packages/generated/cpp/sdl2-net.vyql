import code.{NetworkData, NetworkSend, NetworkConnect}
adapter cpp {
  package "sdl2-net" {
    source method "NET_ReadFromStreamSocket" -> code.NetworkData
    source method "NET_ReceiveDatagram" -> code.NetworkData
    sink method "NET_WriteToStreamSocket" -> code.NetworkSend
    sink method "NET_SendDatagram" -> code.NetworkSend
    sink method "NET_AcceptClient" -> code.NetworkConnect
  }
}
