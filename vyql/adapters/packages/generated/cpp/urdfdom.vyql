import code.{Deserialization, FilePathAccess}

adapter cpp {
  package "urdfdom" {
    sink method "parseURDF" -> code.Deserialization
    sink method "parseURDFFile" -> code.Deserialization
    sink method "parsePose" -> code.Deserialization
    sink method "parseCamera" -> code.Deserialization
    sink method "parseRay" -> code.Deserialization
    sink method "parseSensor" -> code.Deserialization
    sink method "parseModelState" -> code.Deserialization
    sink method "parseMaterial" -> code.Deserialization
    sink method "parseSphere" -> code.Deserialization
    sink method "parseBox" -> code.Deserialization
    sink method "parseCylinder" -> code.Deserialization
    sink method "parseMesh" -> code.Deserialization
    sink method "parseGeometry" -> code.Deserialization
    sink method "parseInertial" -> code.Deserialization
    sink method "parseVisual" -> code.Deserialization
    sink method "parseCollision" -> code.Deserialization
    sink method "parseLink" -> code.Deserialization
  }
}
