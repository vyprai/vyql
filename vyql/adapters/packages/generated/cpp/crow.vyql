import code.{Deserialization, HttpInput, WeakHash, ResponseHeaderWrite, NetworkConnect, NetworkSend}
import core.{HtmlEscape, InputValidation, PathCanonicalization}

adapter cpp {
  package "crow" {
    source method "handle_initial" -> code.HttpInput
    source method "handle_full" -> code.HttpInput
    source method "handle_upgrade" -> code.HttpInput

    sink method "load" -> code.Deserialization
    sink method "parse" -> code.Deserialization
    sink method "write" -> code.ResponseHeaderWrite
    sink method "bindaddr" -> code.NetworkConnect
    control method "local_socket_path" -> core.PathCanonicalization
    sink method "add_websocket" -> code.NetworkConnect
    sink method "close_websockets" -> code.NetworkSend

    control method "validate" -> core.InputValidation
    control method "escape" -> core.HtmlEscape

  }
}
