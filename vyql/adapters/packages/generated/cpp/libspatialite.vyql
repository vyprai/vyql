import code.{FilePathAccess}

adapter cpp {
  package "libspatialite" {
    sink method "dump_shapefile" -> code.FilePathAccess
    sink method "dump_shapefile_ex" -> code.FilePathAccess
    sink method "dump_shapefile_ex2" -> code.FilePathAccess
    sink method "load_shapefile" -> code.FilePathAccess
    sink method "load_shapefile_ex" -> code.FilePathAccess
    sink method "load_shapefile_ex2" -> code.FilePathAccess
    sink method "load_shapefile_ex3" -> code.FilePathAccess
    sink method "load_zip_shapefile" -> code.FilePathAccess
    sink method "load_dbf" -> code.FilePathAccess
    sink method "load_dbf_ex" -> code.FilePathAccess
    sink method "load_dbf_ex2" -> code.FilePathAccess
    sink method "load_dbf_ex3" -> code.FilePathAccess
    sink method "load_zip_dbf" -> code.FilePathAccess
    sink method "dump_dbf" -> code.FilePathAccess
    sink method "dump_dbf_ex" -> code.FilePathAccess
  }
}
