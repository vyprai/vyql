import code.{CodeEval, CommandExecution, Deserialization, NetworkData, NetworkSend}

adapter python {
  package "execnet" {
    sink method "remote_exec" -> code.CodeEval
    sink method "spawn" -> code.CommandExecution
    sink method "loads" -> code.Deserialization
    source method "read" -> code.NetworkData
    sink method "write" -> code.NetworkSend
  }
}
