import code.{Deserialization}
adapter python {
  package "pyparsing" {
    sink method "parseImpl" -> code.Deserialization
    sink method "parse_string" -> code.Deserialization
    sink method "search_string" -> code.Deserialization
    sink method "try_parse" -> code.Deserialization
    sink method "can_parse_next" -> code.Deserialization
  }
}
