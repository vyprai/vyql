import core.{InputValidation, PathCanonicalization}

adapter python {
  package "packaging" {
    source method "packaging.version.parse" -> core.UserControlledData
    sink method "packaging._parser.parse_requirement" -> code.Deserialization
    sink method "packaging._parser.parse_marker" -> code.Deserialization
    control method "packaging.utils.canonicalize_name" -> core.InputValidation
    control method "packaging.licenses.canonicalize_license_expression" -> core.InputValidation
  }
}
