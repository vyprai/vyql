import core.{AuthenticationCheck, InputValidation}

adapter python {
  package "django-rest-auth" {
    control method "authenticate" -> core.AuthenticationCheck
    control method "login" -> core.AuthenticationCheck
    control method "validate" -> core.InputValidation
    control method "validate_email" -> core.InputValidation
    control method "validate_old_password" -> core.InputValidation
    control method "validate_username" -> core.InputValidation
    control method "validate_password1" -> core.InputValidation
    source method "create" -> core.UserControlledData
    sink method "save" -> code.StoredDataWrite
    source method "post" -> code.HttpInput
    source method "get" -> code.HttpInput
  }
}
