import code.{Deserialization, StateChangingOp}
import core.{AuthenticationCheck}

adapter python {
  package "djangorestframework-simplejwt" {
    control method "authenticate" -> core.AuthenticationCheck
    sink method "decode" -> code.Deserialization
    control method "check_blacklist" -> core.AuthenticationCheck
    flag code.StateChangingOp on any {
      method "blacklist"
    }
  }
}
