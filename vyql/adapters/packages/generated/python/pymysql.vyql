import code.{SqlExecution}
import core.{SqlParameterization}

adapter python {
  package "pymysql" {
    sink method "query" -> code.SqlExecution
    sink method "execute" -> code.SqlExecution
    sink method "executemany" -> code.SqlExecution
    control method "mogrify" -> core.SqlParameterization
    control method "escape" -> core.SqlParameterization
    control method "escape_string" -> core.SqlParameterization
  }
}
