import core.{InputValidation}

adapter python {
  package "django-cors-headers" {
    sink method "add_response_headers" -> code.ResponseHeaderWrite
    control method "check_preflight" -> core.InputValidation
    source method "CORS_ALLOW_HEADERS" -> code.StoredDataRead
    source method "CORS_EXPOSE_HEADERS" -> code.StoredDataRead
    source method "CORS_ALLOW_ALL_ORIGINS" -> code.StoredDataRead
    source method "CORS_ALLOWED_ORIGINS" -> code.StoredDataRead
  }
}
