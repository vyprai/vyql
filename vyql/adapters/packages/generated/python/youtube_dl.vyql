import code.{UrlFetch, FilePathAccess}
import core.{PathCanonicalization, InputValidation}

adapter python {
  package "youtube_dl" {
    sink method "YoutubeDL.extract_info" -> code.UrlFetch
    sink method "sanitize_open" -> code.FilePathAccess
    control method "sanitize_filename" -> core.PathCanonicalization
    control method "sanitize_path" -> core.PathCanonicalization
    control method "sanitize_url" -> core.InputValidation
  }
}
