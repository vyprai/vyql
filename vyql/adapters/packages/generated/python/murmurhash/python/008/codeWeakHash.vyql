module bindings.python.migration.m92c9ed46;

binding weakHash8 {
  requires {
    dependency("murmurhash")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "MurmurHash3_x64_128"
  emit issue code.WeakHash at node
}
