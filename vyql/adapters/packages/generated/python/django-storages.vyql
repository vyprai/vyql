import code.{FilePathAccess, StoredDataRead, StoredDataWrite, UrlFetch}
import core.{UserControlledData}

adapter python {
  package "django-storages" {
    source method "read" -> code.StoredDataRead
    sink method "write" -> code.StoredDataWrite
    sink method "open" -> code.FilePathAccess
    source method "url" -> core.UserControlledData
    sink method "listdir" -> code.FilePathAccess
    sink method "list_all" -> code.FilePathAccess
  }
}
