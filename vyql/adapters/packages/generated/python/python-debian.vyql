import code.{ArchiveEntryWrite, Deserialization, FilePathAccess}
adapter python {
  package "python-debian" {
    sink method "extract" -> code.ArchiveEntryWrite
    sink method "extractfile" -> code.ArchiveEntryWrite
    sink method "get_file" -> code.FilePathAccess
    sink method "parse_relations" -> code.Deserialization
    sink method "parse_archs" -> code.Deserialization
    sink method "parse_restrictions" -> code.Deserialization
  }
}
