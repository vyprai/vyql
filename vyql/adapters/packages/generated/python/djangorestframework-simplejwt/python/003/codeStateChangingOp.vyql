module bindings.python.migration.mac4e01b5;

binding stateChangingOp3 {
  requires {
    dependency("djangorestframework-simplejwt")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "blacklist"
  emit issue code.StateChangingOp at node
  emit sink code.StateChangingOpSink at node
}
