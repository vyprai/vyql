import code.{UrlFetch, NetworkSend, Deserialization}
adapter python {
  package "geopy" {
    sink method "get_json" -> code.UrlFetch
    sink method "get_text" -> code.UrlFetch
    sink method "geocode" -> code.NetworkSend
    sink method "reverse" -> code.NetworkSend
    sink method "parse_resource" -> code.Deserialization
    sink method "parse_place" -> code.Deserialization
    sink method "parse_feature" -> code.Deserialization
    sink method "parse_address" -> code.Deserialization
  }
}
