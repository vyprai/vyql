import code.{HttpInput, NetworkConnect, RedirectTarget}
import core.{UserControlledData}

adapter python {
  package "spotipy" {
    flag code.RedirectTarget on any {
      method "get_authorize_url"
    }
    source method "parse_response_code" -> core.UserControlledData
    source method "parse_auth_response_url" -> core.UserControlledData
    source method "get_auth_response" -> code.HttpInput
    sink method "start_local_http_server" -> code.NetworkConnect
  }
}
