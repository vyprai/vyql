import code.{Deserialization}
import core.{InputValidation}

adapter python {
  package "itsdangerous" {
    sink method "loads" -> code.Deserialization
    sink method "loads_unsafe" -> code.Deserialization
    sink method "load" -> code.Deserialization
    sink method "load_unsafe" -> code.Deserialization
    sink method "base64_decode" -> code.Deserialization
    control method "verify_signature" -> core.InputValidation
    control method "validate" -> core.InputValidation
  }
}
