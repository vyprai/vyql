import code.{HttpInput, Cookie, ResponseHeaderWrite, NetworkConnect, FilePathAccess}
import core.{UserControlledData}

adapter python {
  package "falcon" {
    source method "falcon.request.Request.media" -> code.HttpInput
    source method "falcon.request.Request.get_param" -> code.HttpInput
    source method "falcon.request.Request.get_header" -> code.HttpInput
    source method "falcon.request.Request.get_cookie" -> code.Cookie
    source method "falcon.request.Request.get_all_headers" -> code.HttpInput
    source method "falcon.request.Request.bounded_stream" -> code.HttpInput

    sink method "falcon.response.Response.set_header" -> code.ResponseHeaderWrite
    source method "falcon.response.Response.set_cookie" -> code.Cookie
    sink method "falcon.response.Response.stream" -> code.NetworkConnect
    sink method "falcon.response.Response.stream_file" -> code.FilePathAccess

    source method "falcon.uri.parse_query_string" -> core.UserControlledData
    source method "falcon.uri.parse_host" -> core.UserControlledData
    source method "falcon.uri.parse_port" -> core.UserControlledData

  }
}
