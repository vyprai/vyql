import code.{CommandExecution}
import core.{UserControlledData}

adapter python {
  package "pexpect" {
    sink method "run" -> code.CommandExecution
    sink method "runu" -> code.CommandExecution
    sink method "spawn" -> code.CommandExecution
    sink method "run_command" -> code.CommandExecution
    source method "split_command_line" -> core.UserControlledData
  }
}
