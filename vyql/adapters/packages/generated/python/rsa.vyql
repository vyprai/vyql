import code.{Deserialization, SecretValue, WeakRandomValue, WeakHash}

adapter python {
  package "rsa" {
    sink method "decrypt" -> code.Deserialization
    flag code.WeakHash on any {
      method "sign"
    }
    source method "load_pkcs1" -> code.SecretValue
    flag code.WeakRandomValue on any {
      method "read_random_bits"
    }
  }
}
