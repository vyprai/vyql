import code.{CommandExecution, EnvVariable, HttpInput, NetworkConnect, NetworkSend, SecretValue}
adapter python {
  package "httplib2" {
    sink method "request" -> code.NetworkSend
    sink method "connect" -> code.NetworkConnect
    source method "add_credentials" -> code.SecretValue
    source method "add_certificate" -> code.SecretValue
    source method "proxy_info_from_environment" -> code.EnvVariable
    source method "proxy_info_from_url" -> code.HttpInput
    source method "parse_uri" -> code.HttpInput
    source method "urlnorm" -> code.HttpInput
  }
}
