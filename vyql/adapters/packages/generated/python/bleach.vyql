adapter python {
  package "bleach" {
    control method "linkify" -> core.InputValidation
    control method "sanitize_stream" -> core.HtmlEscape
    control method "sanitize_token" -> core.HtmlEscape
    control method "sanitize_characters" -> core.HtmlEscape
    control method "sanitize_uri_value" -> core.InputValidation
    control method "sanitize_css" -> core.InputValidation

    sink path "bleach._vendor.html5lib.html5parser.parse" -> code.Deserialization
    sink path "bleach._vendor.html5lib.html5parser.parseFragment" -> code.Deserialization

    source path "bleach._vendor.parse.parse_qs" -> core.UserControlledData
    source path "bleach._vendor.parse.parse_qsl" -> core.UserControlledData
  }
}
