module bindings.python.migration.mf95c8770;

binding redirectTarget3 {
  requires {
    dependency("social-auth-app-django")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "redirect"
  emit issue code.RedirectTarget at node
  emit sink code.RedirectTargetSink at node
}
