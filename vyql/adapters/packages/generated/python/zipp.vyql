import code.{FilePathAccess}

adapter python {
  package "zipp" {
    sink method "open" -> code.FilePathAccess
    sink method "read_text" -> code.FilePathAccess
    sink method "read_bytes" -> code.FilePathAccess
    sink method "glob" -> code.FilePathAccess
    sink method "match" -> code.FilePathAccess
  }
}
