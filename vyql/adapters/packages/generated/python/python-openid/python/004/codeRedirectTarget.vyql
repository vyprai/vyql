module bindings.python.migration.m64dfebba;

binding redirectTarget4 {
  requires {
    dependency("python-openid")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "toURLEncoded"
  emit issue code.RedirectTarget at node
  emit sink code.RedirectTargetSink at node
}
