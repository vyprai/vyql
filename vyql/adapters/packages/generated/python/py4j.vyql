import code.{CommandExecution, Deserialization}

adapter python {
  package "py4j" {
    sink method "smart_decode" -> code.Deserialization
    sink method "decode_bytearray" -> code.Deserialization
    sink method "get_command_part" -> code.Deserialization
    sink method "get_return_value" -> code.Deserialization
  }
}
