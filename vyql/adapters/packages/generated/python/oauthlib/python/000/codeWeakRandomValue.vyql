module bindings.python.migration.m3db0ea90;

binding weakRandomValue0 {
  requires {
    dependency("oauthlib")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "generate_token"
  emit issue code.WeakRandomValue at node
}
