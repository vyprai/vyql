import code.{FilePathAccess}
import core.{UserControlledData}

adapter python {
  package "soundfile" {
    sink method "read" -> code.FilePathAccess
    source method "read" -> core.UserControlledData
    sink method "blocks" -> code.FilePathAccess
    source method "blocks" -> core.UserControlledData
    source method "buffer_read" -> core.UserControlledData
    source method "vio_read" -> core.UserControlledData
    sink method "write" -> code.FilePathAccess
    source method "buffer_write" -> core.UserControlledData
    source method "vio_write" -> core.UserControlledData
  }
}
