import code.{HttpInput, FileUpload, FileUse, FilePathAccess}
import core.{InputValidation}

adapter python {
  package "django-ckeditor" {
    source method "ckeditor_uploader.views.post" -> code.HttpInput
    flag code.FileUpload on any {
      method "ckeditor_uploader.views.post"
    }
    sink method "ckeditor_uploader.views.post" -> code.FileUse
    sink method "ckeditor_uploader.views.browse" -> code.FilePathAccess
    control method "ckeditor_uploader.utils.slugify_filename" -> core.InputValidation
    control method "ckeditor_uploader.utils.is_valid_image_extension" -> core.InputValidation
  }
}
