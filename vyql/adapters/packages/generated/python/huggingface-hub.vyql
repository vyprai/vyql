import code.{SecretValue}
adapter python {
  package "huggingface-hub" {
    source method "get_oidc_token" -> code.SecretValue
    source method "exchange_oidc_token" -> code.SecretValue
    source method "login_token_event" -> code.SecretValue
    source method "logout" -> code.SecretValue
    source method "auth_switch" -> code.SecretValue
    source method "whoami" -> code.SecretValue
  }
}
