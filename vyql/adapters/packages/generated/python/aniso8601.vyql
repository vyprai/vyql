import code.{Deserialization}

adapter python {
  package "aniso8601" {
    sink method "parse_date" -> code.Deserialization
    sink method "parse_time" -> code.Deserialization
    sink method "parse_datetime" -> code.Deserialization
    sink method "parse_duration" -> code.Deserialization
    sink method "parse_interval" -> code.Deserialization
    sink method "parse_repeating_interval" -> code.Deserialization
  }
}
