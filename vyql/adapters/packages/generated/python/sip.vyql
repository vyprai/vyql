import code.{CommandExecution, Deserialization}
adapter python {
  package "sip" {
    sink method "read_command_pipe" -> code.CommandExecution
    sink method "run_command" -> code.CommandExecution
    sink method "toml_load" -> code.Deserialization
    sink method "toml_loads" -> code.Deserialization
    sink method "parse" -> code.Deserialization
  }
}
