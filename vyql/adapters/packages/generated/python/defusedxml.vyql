import code.{Deserialization}

adapter python {
  package "defusedxml" {
    sink method "parse" -> code.Deserialization
    sink method "parseString" -> code.Deserialization
    sink method "iterparse" -> code.Deserialization
    sink method "fromstring" -> code.Deserialization
    sink method "make_parser" -> code.Deserialization
  }
}
