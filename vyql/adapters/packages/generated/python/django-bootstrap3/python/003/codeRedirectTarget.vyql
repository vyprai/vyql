module bindings.python.migration.m11fd24d1;

binding redirectTarget3 {
  requires {
    dependency("django-bootstrap3")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "url_replace_param"
  emit issue code.RedirectTarget at node
  emit sink code.RedirectTargetSink at node
}
