import code.{FilePathAccess}
adapter python {
  package "lockfile" {
    sink method "acquire" -> code.FilePathAccess
    sink method "release" -> code.FilePathAccess
    sink method "break_lock" -> code.FilePathAccess
    sink method "read_pid_from_pidfile" -> code.FilePathAccess
    sink method "write_pid_to_pidfile" -> code.FilePathAccess
    sink method "remove_existing_pidfile" -> code.FilePathAccess
    sink method "is_locked" -> code.FilePathAccess
  }
}
