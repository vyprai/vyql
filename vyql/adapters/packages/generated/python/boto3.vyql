import code.{FileUpload, FileUse}
adapter python {
  package "boto3" {
    flag code.FileUpload on any {
      method "upload_file"
    }
    flag code.FileUpload on any {
      method "upload_fileobj"
    }
    sink method "download_file" -> code.FileUse
    sink method "download_fileobj" -> code.FileUse
  }
}
