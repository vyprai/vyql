import code.{Deserialization, FileUse, CommandExecution}

adapter python {
  package "docutils" {
    sink method "parse" -> code.Deserialization
    sink method "publish_cmdline" -> code.CommandExecution
    sink method "publish_file" -> code.FileUse
    sink method "publish_string" -> code.Deserialization
    sink method "publish_parts" -> code.Deserialization
  }
}
