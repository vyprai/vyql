import code.{Deserialization}
import core.{InputValidation}

adapter python {
  package "nbformat" {
    sink method "read" -> code.Deserialization
    sink method "reads" -> code.Deserialization
    sink method "parse_json" -> code.Deserialization
    sink method "reads_json" -> code.Deserialization
    control method "validate" -> core.InputValidation
  }
}
