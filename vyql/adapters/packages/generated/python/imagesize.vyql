import code.{FilePathAccess, UrlFetch}

adapter python {
  package "imagesize" {
    sink method "get_info" -> code.FilePathAccess
    sink method "get_info" -> code.UrlFetch
    sink method "get" -> code.FilePathAccess
    sink method "get" -> code.UrlFetch
    sink method "getDPI" -> code.FilePathAccess
    sink method "getDPI" -> code.UrlFetch
  }
}
