import code.{CliArgument, HttpInput, NetworkConnect, NetworkData, FilePathAccess, Deserialization, CommandExecution}
import core.{HtmlEscape, InputValidation}

adapter python {
  package "starlette" {
    source method "query_params" -> code.HttpInput
    source method "body" -> code.HttpInput
    source method "json" -> code.HttpInput
    source method "form" -> code.HttpInput
    sink method "render" -> code.HtmlRender
    sink method "send" -> code.NetworkConnect
  }
}
