import code.{FilePathAccess, UrlFetch}

adapter python {
  package "timm" {
    sink method "download_cached_file" -> code.UrlFetch
    sink method "download_from_hf" -> code.UrlFetch
    sink method "load_cfg_from_json" -> code.FilePathAccess
    sink method "load_model_config_from_hf" -> code.FilePathAccess
    sink method "load_model_config_from_path" -> code.FilePathAccess
    sink method "load_state_dict_from_hf" -> code.FilePathAccess
    sink method "load_state_dict_from_path" -> code.FilePathAccess
    sink method "load_custom_from_hf" -> code.FilePathAccess
  }
}
