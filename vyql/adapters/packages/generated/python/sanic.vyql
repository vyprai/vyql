import code.{CliArgument, CommandExecution, NetworkData, HttpInput, HtmlRender}
import core.{HtmlEscape}

adapter python {
  package "sanic" {
    source method "read" -> code.NetworkData
    source method "recv" -> code.NetworkData
    sink method "handle_request" -> code.UrlFetch
    sink method "spawn" -> code.CommandExecution
    source method "send" -> code.NetworkData
    sink method "parse" -> code.Deserialization
    control method "escape" -> core.HtmlEscape
  }
}
