adapter python {
  package "inflection" {
    control method "camelize" -> core.InputValidation
    control method "dasherize" -> core.InputValidation
    control method "humanize" -> core.InputValidation
    control method "ordinal" -> core.InputValidation
    control method "ordinalize" -> core.InputValidation
    control method "parameterize" -> core.InputValidation
    control method "pluralize" -> core.InputValidation
    control method "singularize" -> core.InputValidation
    control method "tableize" -> core.InputValidation
    control method "titleize" -> core.InputValidation
    control method "underscore" -> core.InputValidation
    control method "transliterate" -> core.InputValidation
  }
}
