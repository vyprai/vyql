import code.{Deserialization, FilePathAccess}

adapter python {
  package "pyreadline" {
    sink method "parse_and_bind" -> code.Deserialization
    sink method "read_init_file" -> code.FilePathAccess
    sink method "read_history_file" -> code.FilePathAccess
    sink method "write_history_file" -> code.FilePathAccess
    sink method "sethistoryfilename" -> code.FilePathAccess
    sink method "read_inputrc" -> code.FilePathAccess
  }
}
