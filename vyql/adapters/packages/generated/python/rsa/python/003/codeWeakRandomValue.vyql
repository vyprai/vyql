module bindings.python.migration.m65d9ea34;

binding weakRandomValue3 {
  requires {
    dependency("rsa")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "read_random_bits"
  emit issue code.WeakRandomValue at node
}
