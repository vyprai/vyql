import code.{FilePathAccess, HttpInput, NetworkConnect, Deserialization, CommandExecution}
import core.{UserControlledData, InputValidation, CsrfProtection, AuthenticationCheck, AuthorizationCheck}
adapter python {
  package "flask-wtf" {
    control method "validate_csrf" -> core.CsrfProtection
    control method "csrf_protect" -> core.CsrfProtection
    control method "same_origin" -> core.InputValidation
    source method "process_formdata" -> core.UserControlledData
  }
}
