import code.{NetworkData, NetworkSend}

adapter python {
  package "h2" {
    sink method "H2Connection.send_headers" -> code.NetworkSend
    sink method "H2Connection.send_data" -> code.NetworkSend
    source method "H2Connection.receive_data" -> code.NetworkData
    source method "H2Connection.process_input" -> code.NetworkData
    sink method "H2Stream.send_headers" -> code.NetworkSend
    sink method "H2Stream.send_data" -> code.NetworkSend
    source method "H2Stream.receive_data" -> code.NetworkData
    source method "H2Stream.process_input" -> code.NetworkData
  }
}
