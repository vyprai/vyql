import code.{NetworkConnect, NetworkSend, NetworkData}

adapter python {
  package "websocket-client" {
    sink method "connect" -> code.NetworkConnect
    sink method "send" -> code.NetworkSend
    sink method "send_text" -> code.NetworkSend
    sink method "send_bytes" -> code.NetworkSend
    sink method "send_binary" -> code.NetworkSend
    source method "recv" -> code.NetworkData
  }
}
