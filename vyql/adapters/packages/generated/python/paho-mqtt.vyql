import code.{NetworkConnect, NetworkData, NetworkSend, SecretValue}

adapter python {
  package "paho-mqtt" {
    source method "recv" -> code.NetworkData
    sink method "send" -> code.NetworkSend
    sink method "connect" -> code.NetworkConnect
    sink method "connect_srv" -> code.NetworkConnect
    sink method "connect_async" -> code.NetworkConnect
    source method "password" -> code.SecretValue
    source method "will_payload" -> code.SecretValue
  }
}
