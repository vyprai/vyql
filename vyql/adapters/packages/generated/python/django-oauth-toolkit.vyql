import code.{SecretValue}
import core.{AuthenticationCheck}

adapter python {
  package "django-oauth-toolkit" {
    source method "get_access_token_model" -> code.SecretValue
    source method "get_id_token_model" -> code.SecretValue
    source method "get_refresh_token_model" -> code.SecretValue
    source method "ClientSecretField" -> code.SecretValue
    control method "authenticate" -> core.AuthenticationCheck
  }
}
