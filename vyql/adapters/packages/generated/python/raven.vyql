import code.{NetworkSend, SqlExecution, UrlFetch}
import core.{InputValidation}

adapter python {
  package "raven" {
    sink method "send" -> code.NetworkSend
    sink method "captureQuery" -> code.SqlExecution
    sink method "urlopen" -> code.UrlFetch
    control method "sanitize" -> core.InputValidation
  }
}
