module bindings.python.migration.m2a5e00b5;

binding privilegedOp2 {
  requires {
    dependency("python-daemon")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "change_process_owner"
  emit issue code.PrivilegedOp at node
  emit sink code.PrivilegedOpSink at node
}
