module bindings.python.generated.mf4fe81f1;

binding inputValidation4 {
  requires {
    dependency("django-ckeditor")
  }
  query pattern callExpr where callee.method == "ckeditor_uploader.utils.slugify_filename"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
