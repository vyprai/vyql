module bindings.python.migration.mf4fe81f1;

binding inputValidation5 {
  requires {
    dependency("django-ckeditor")
  }
  query pattern callExpr where callee.method == "ckeditor_uploader.utils.is_valid_image_extension"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
