module bindings.python.migration.mf4fe81f1;

binding fileUpload1 {
  requires {
    dependency("django-ckeditor")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "ckeditor_uploader.views.post"
  emit issue code.FileUpload at node
  emit source code.FileUploadSource at node
}
