import code.{StoredDataRead, StoredDataWrite}

adapter python {
  package "pickleshare" {
    source method "PickleShareDB.hget" -> code.StoredDataRead
    sink method "PickleShareDB.hset" -> code.StoredDataWrite
    source method "PickleShareDB.keys" -> code.StoredDataRead
    source method "PickleShareDB.waitget" -> code.StoredDataRead
    sink method "PickleShareDB.__delitem__" -> code.StoredDataWrite
    sink method "PickleShareDB.__setitem__" -> code.StoredDataWrite
    source method "PickleShareDB.__getitem__" -> code.StoredDataRead
    source method "PickleShareDB.__contains__" -> code.StoredDataRead
  }
}
