import code.{Deserialization}
adapter python {
  package "hyperframe" {
    sink method "parse_frame_header" -> code.Deserialization
    sink method "parse_flags" -> code.Deserialization
    sink method "parse_body" -> code.Deserialization
    sink method "parse_padding_data" -> code.Deserialization
    sink method "parse_priority_data" -> code.Deserialization
    sink method "explain" -> code.Deserialization
  }
}
