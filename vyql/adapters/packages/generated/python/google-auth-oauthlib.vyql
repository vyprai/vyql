import code.{HttpInput, NetworkConnect, SecretValue}

adapter python {
  package "google-auth-oauthlib" {
    source method "from_client_secrets_file" -> code.SecretValue
    source method "run_local_server" -> code.HttpInput
    sink method "fetch_token" -> code.NetworkConnect
    source method "fetch_token" -> code.SecretValue
  }
}
