import code.{CliArgument, FilePathAccess}
adapter python {
  package "identify" {
    sink method "tags_from_path" -> code.FilePathAccess
    sink method "tags_from_filename" -> code.FilePathAccess
    sink method "file_is_text" -> code.FilePathAccess
    sink method "parse_shebang" -> code.FilePathAccess
    sink method "parse_shebang_from_file" -> code.FilePathAccess
    sink method "is_text" -> code.FilePathAccess
    source method "main" -> code.CliArgument
  }
}
