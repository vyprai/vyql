import code.{FilePathAccess, FileUse}
import core.{PathCanonicalization}

adapter python {
  package "pathlib2" {
    sink method "open" -> code.FileUse
    sink method "read_bytes" -> code.FilePathAccess
    sink method "read_text" -> code.FilePathAccess
    sink method "write_bytes" -> code.FilePathAccess
    sink method "write_text" -> code.FilePathAccess
    sink method "rename" -> code.FilePathAccess
    sink method "replace" -> code.FilePathAccess
    sink method "symlink_to" -> code.FilePathAccess
    sink method "lchmod" -> code.FilePathAccess
    sink method "readlink" -> code.FilePathAccess
    control method "resolve" -> core.PathCanonicalization
  }
}
