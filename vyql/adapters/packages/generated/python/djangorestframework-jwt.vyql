import code.{Deserialization}
import core.{AuthenticationCheck}

adapter python {
  package "djangorestframework-jwt" {
    control method "authenticate" -> core.AuthenticationCheck
    control method "authenticate_credentials" -> core.AuthenticationCheck
    control method "jwt_encode_handler" -> core.AuthenticationCheck
    sink method "jwt_decode_handler" -> code.Deserialization
    control method "jwt_decode_handler" -> core.AuthenticationCheck
  }
}
