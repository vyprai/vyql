import code.{NetworkConnect, NetworkSend, NetworkData, UrlFetch, HttpInput}
adapter python {
  package "ndg-httpsclient" {
    sink method "connect" -> code.NetworkConnect
    sink method "send" -> code.NetworkSend
    sink method "sendall" -> code.NetworkSend
    source method "recv" -> code.NetworkData
    sink method "http_request" -> code.UrlFetch
    sink method "fetch_from_url" -> code.UrlFetch
    sink method "fetch_from_url_to_file" -> code.UrlFetch
    sink method "fetch_stream_from_url" -> code.UrlFetch
    sink method "open_url" -> code.UrlFetch
  }
}
