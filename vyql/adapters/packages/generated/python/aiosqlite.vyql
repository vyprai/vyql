import code.{CommandExecution, DatabaseRead, SqlExecution}
adapter python {
  package "aiosqlite" {
    sink method "connect" -> code.DatabaseRead
    sink method "execute" -> code.SqlExecution
    sink method "execute_insert" -> code.SqlExecution
    sink method "execute_fetchall" -> code.SqlExecution
    sink method "executemany" -> code.SqlExecution
    sink method "executescript" -> code.SqlExecution
  }
}
