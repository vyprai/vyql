import core.{InputValidation, UserControlledData}

adapter python {
  package "mdurl" {
    source method "parse" -> core.UserControlledData
    source method "url_parse" -> core.UserControlledData
    control method "decode" -> core.InputValidation
    control method "encode" -> core.InputValidation
    control method "format" -> core.InputValidation
  }
}
