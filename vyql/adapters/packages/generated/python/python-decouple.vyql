import code.{SecretValue}
import core.{UserControlledData}

adapter python {
  package "python-decouple" {
    source method "Config.get" -> core.UserControlledData
    source method "RepositoryEnv.get" -> core.UserControlledData
    source method "RepositoryIni.get" -> core.UserControlledData
    source method "RepositorySecret.get" -> core.UserControlledData
  }
}
