import code.{Deserialization, CodeEval, NetworkConnect}

adapter python {
  package "graphene" {
    sink method "parse_literal" -> code.Deserialization
    sink method "parse_value" -> code.Deserialization
    sink method "execute" -> code.CodeEval
    sink method "execute_async" -> code.CodeEval
    sink method "subscribe" -> code.NetworkConnect
    sink method "import_string" -> code.CodeEval
    sink method "lazy_import" -> code.CodeEval
  }
}
