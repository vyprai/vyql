import code.{Deserialization, FilePathAccess}
adapter python {
  package "spacy-legacy" {
    sink method "load_model" -> code.Deserialization
    sink method "set_kb" -> code.Deserialization
    sink method "TransitionBasedParser_v1" -> code.Deserialization
    sink method "setup_logger" -> code.FilePathAccess
    sink method "console_logger_v2" -> code.FilePathAccess
  }
}
