import code.{Deserialization, NetworkData, NetworkSend}

adapter python {
  package "channels-redis" {
    sink method "send" -> code.NetworkSend
    sink method "group_send" -> code.NetworkSend
    sink method "publish" -> code.NetworkSend
    source method "receive" -> code.NetworkData
    source method "receive_single" -> code.NetworkData
    source method "subscribe" -> code.NetworkData
    sink method "deserialize" -> code.Deserialization
  }
}
