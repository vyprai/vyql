import code.{SecretValue}
adapter python {
  package "requests-oauthlib" {
    source method "token" -> code.SecretValue
    source method "access_token" -> code.SecretValue
    source method "fetch_request_token" -> code.SecretValue
    source method "fetch_access_token" -> code.SecretValue
    source method "refresh_token" -> code.SecretValue
  }
}
