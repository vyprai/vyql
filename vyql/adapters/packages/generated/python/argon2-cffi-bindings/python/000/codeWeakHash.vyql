module bindings.python.migration.m1dbf86b9;

binding weakHash0 {
  requires {
    dependency("argon2-cffi-bindings")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "argon2.cffi.bindings.hash"
  emit issue code.WeakHash at node
}
