module bindings.python.migration.m78ea425f;

binding weakHash0 {
  requires {
    dependency("pyobjc-core")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "pyobjc.core.hash"
  emit issue code.WeakHash at node
}
