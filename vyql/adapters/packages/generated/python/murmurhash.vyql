import code.{WeakHash}
adapter python {
  package "murmurhash" {
    flag code.WeakHash on any {
      method "MurmurHash2"
    }
    flag code.WeakHash on any {
      method "MurmurHash2A"
    }
    flag code.WeakHash on any {
      method "MurmurHash64A"
    }
    flag code.WeakHash on any {
      method "MurmurHash64B"
    }
    flag code.WeakHash on any {
      method "MurmurHashNeutral2"
    }
    flag code.WeakHash on any {
      method "MurmurHashAligned2"
    }
    flag code.WeakHash on any {
      method "MurmurHash3_x86_32"
    }
    flag code.WeakHash on any {
      method "MurmurHash3_x86_128"
    }
    flag code.WeakHash on any {
      method "MurmurHash3_x64_128"
    }
  }
}
