import code.{SecretValue, HttpInput}
import core.{AuthenticationCheck, InputValidation, RedirectAllowlist}

adapter python {
  package "social-auth-core" {
    control method "sanitize_redirect" -> core.RedirectAllowlist
    control method "do_auth" -> core.AuthenticationCheck
    control method "user_is_authenticated" -> core.AuthenticationCheck
    source method "access_token" -> code.SecretValue
    source method "get_access_token" -> code.SecretValue
    source method "refresh_token" -> code.SecretValue
    control method "useNonce" -> core.InputValidation
  }
}
