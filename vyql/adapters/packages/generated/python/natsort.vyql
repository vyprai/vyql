import code.{Deserialization, RegexCompile}
adapter python {
  package "natsort" {
    sink method "natsort_keygen" -> code.Deserialization
    sink method "parse_string_factory" -> code.Deserialization
    sink method "parse_bytes_factory" -> code.Deserialization
    sink method "parse_number_or_none_factory" -> code.Deserialization
    sink method "parse_path_factory" -> code.Deserialization
    mark method "regex_chooser" -> code.RegexCompile
  }
}
