import code.{NetworkSend, Deserialization}

adapter ruby {
  package "dnsruby" {
    sink method "query" -> code.NetworkSend
    sink method "send_message" -> code.NetworkSend
    sink method "query_raw" -> code.NetworkSend
    sink method "parse_config" -> code.Deserialization
    sink method "from_hash" -> code.Deserialization
  }
}
