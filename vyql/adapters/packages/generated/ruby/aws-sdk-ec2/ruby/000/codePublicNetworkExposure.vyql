module bindings.ruby.migration.m8c3ba7cd;

binding publicNetworkExposure0 {
  requires {
    dependency("aws-sdk-ec2")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "create_security_group"
  emit issue code.PublicNetworkExposure at node
}
