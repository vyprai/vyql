import code.{NetworkConnect, NetworkData, NetworkSend}

adapter ruby {
  package "celluloid-io" {
    source method "recv" -> code.NetworkData
    source method "recvfrom" -> code.NetworkData
    source method "read" -> code.NetworkData
    source method "sysread" -> code.NetworkData
    sink method "send" -> code.NetworkSend
    sink method "write" -> code.NetworkSend
    sink method "syswrite" -> code.NetworkSend
    sink method "create_socket" -> code.NetworkConnect
  }
}
