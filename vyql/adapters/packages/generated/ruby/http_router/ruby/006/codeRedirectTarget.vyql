module bindings.ruby.migration.m02e745e0;

binding redirectTarget6 {
  requires {
    dependency("http_router")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
