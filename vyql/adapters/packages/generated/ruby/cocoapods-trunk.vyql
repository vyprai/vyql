import code.{Deserialization, NetworkConnect, NetworkSend}

adapter ruby {
  package "cocoapods-trunk" {
    sink method "request_url" -> code.NetworkConnect
    sink method "request_url" -> code.NetworkSend
    sink method "request_path" -> code.NetworkConnect
    sink method "request_path" -> code.NetworkSend
    sink method "create_request" -> code.NetworkConnect
    sink method "create_request" -> code.NetworkSend
    sink method "json" -> code.Deserialization
  }
}
