import code.{FilePathAccess, Deserialization, FileUse, ArchiveEntryWrite}
adapter ruby {
  package "pathutil" {
    sink method "initialize" -> code.FilePathAccess
    sink method "read_yaml" -> code.Deserialization
    sink method "read_json" -> code.Deserialization
    sink method "glob" -> code.FilePathAccess
    sink method "safe_copy" -> code.FileUse
    sink method "read" -> code.FileUse
    sink method "binread" -> code.FileUse
    sink method "readlines" -> code.FileUse
    sink method "write" -> code.FileUse
    sink method "binwrite" -> code.FileUse
    sink method "safe_copy_file" -> code.FileUse
    sink method "safe_copy_directory" -> code.FileUse
  }
}
