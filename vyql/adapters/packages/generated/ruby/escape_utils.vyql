adapter ruby {
  package "escape_utils" {
    control method "escape_html_once_as_html_safe" -> core.HtmlEscape
    control method "escape_html" -> core.HtmlEscape
    control method "escape_html_as_html_safe" -> core.HtmlEscape
    control method "escape_url" -> core.InputValidation
    control method "escape" -> core.InputValidation
    control method "url_encode" -> core.InputValidation
    control method "escapeHTML" -> core.HtmlEscape
  }
}
