import code.{NetworkConnect, UrlFetch}

adapter ruby {
  package "webrat" {
    sink method "request_page" -> code.UrlFetch
    sink method "request_page" -> code.NetworkConnect
    sink method "visit" -> code.UrlFetch
    sink method "visit" -> code.NetworkConnect
    sink method "process_request" -> code.UrlFetch
    sink method "process_request" -> code.NetworkConnect
    sink method "get" -> code.UrlFetch
    sink method "get" -> code.NetworkConnect
    sink method "post" -> code.UrlFetch
    sink method "post" -> code.NetworkConnect
    sink method "put" -> code.UrlFetch
    sink method "put" -> code.NetworkConnect
    sink method "delete" -> code.UrlFetch
    sink method "delete" -> code.NetworkConnect
    sink method "do_request" -> code.UrlFetch
    sink method "do_request" -> code.NetworkConnect
  }
}
