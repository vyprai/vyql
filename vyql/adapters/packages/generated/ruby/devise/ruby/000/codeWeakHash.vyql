module bindings.ruby.migration.m0f162836;

binding weakHash0 {
  requires {
    dependency("devise")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "devise.hash"
