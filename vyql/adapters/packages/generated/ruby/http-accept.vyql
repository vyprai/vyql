import code.{HttpInput}

adapter ruby {
  package "http-accept" {
    source method "HTTP::Accept::Charsets.parse" -> code.HttpInput
    source method "HTTP::Accept::Encodings.parse" -> code.HttpInput
    source method "HTTP::Accept::Languages.parse" -> code.HttpInput
    source method "HTTP::Accept::MediaTypes.parse" -> code.HttpInput
    source method "HTTP::Accept::QuotedString.unquote" -> code.HttpInput
    source method "HTTP::Accept::Charsets.browser_preferred_charsets" -> code.HttpInput
    source method "HTTP::Accept::Encodings.browser_preferred_content_codings" -> code.HttpInput
    source method "HTTP::Accept::MediaTypes.browser_preferred_media_types" -> code.HttpInput
  }
}
