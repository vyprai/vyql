module bindings.ruby.migration.m187cb072;

binding regexCompile3 {
  requires {
    dependency("arel")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "Regexp"
  emit issue code.RegexCompile at node
  emit sink code.RegexCompileSink at node
}
