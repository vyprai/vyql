module bindings.ruby.migration.ma1da0d8f;

binding fileUpload7 {
  requires {
    dependency("google-apis-storage_v1")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "insert_object"
  emit issue code.FileUpload at node
  emit source code.FileUploadSource at node
}
