module bindings.ruby.migration.mc9010118;

binding weakHash6 {
  requires {
    dependency("ntlm-http")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "ntlmv2_hash"
  emit issue code.WeakHash at node
}
