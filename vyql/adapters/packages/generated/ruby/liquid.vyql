import code.{Deserialization}
import core.{HtmlEscape}
adapter ruby {
  package "liquid" {
    control method "escape" -> core.HtmlEscape
    sink method "parse" -> code.Deserialization
    sink method "lax_parse" -> code.Deserialization
    sink method "strict_parse" -> code.Deserialization
    sink method "strict2_parse" -> code.Deserialization
    sink method "parse_expression" -> code.Deserialization
    sink method "safe_parse_expression" -> code.Deserialization
  }
}
