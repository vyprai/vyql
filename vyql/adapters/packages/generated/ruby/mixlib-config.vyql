import code.{Deserialization, FilePathAccess}

adapter ruby {
  package "mixlib-config" {
    sink method "from_file" -> code.Deserialization
    sink method "from_yaml" -> code.Deserialization
    sink method "from_json" -> code.Deserialization
    sink method "from_toml" -> code.Deserialization
    sink method "from_hash" -> code.Deserialization
  }
}
