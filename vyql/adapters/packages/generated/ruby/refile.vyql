import code.{Deserialization, FilePathAccess, NetworkData, UrlFetch, SecretValue, WeakHash}

adapter ruby {
  package "refile" {
    source method "call" -> code.NetworkData
    sink method "parse_json" -> code.Deserialization
    sink method "download" -> code.UrlFetch
    sink method "write" -> code.FilePathAccess
    sink method "read" -> code.FilePathAccess
    source method "token" -> code.SecretValue
    flag code.WeakHash on any {
      method "hash"
    }
  }
}
