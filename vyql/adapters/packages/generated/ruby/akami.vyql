import code.{XmlParse, WeakHash}
import core.{InputValidation}

adapter ruby {
  package "akami" {
    control method "Akami::C14nHelper.canonicalize" -> core.InputValidation
    sink method "Akami::WSSE::VerifySignature.initialize" -> code.XmlParse
    mark method "Akami::WSSE::VerifySignature.generate_digest" -> code.WeakHash
    mark method "Akami::WSSE::VerifySignature.digest" -> code.WeakHash
    mark method "Akami::WSSE.security_hash" -> code.WeakHash
  }
}
