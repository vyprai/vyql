import code.{SqlExecution}
adapter ruby {
  package "dm-do-adapter" {
    sink method "select" -> code.SqlExecution
    sink method "execute" -> code.SqlExecution
    sink method "read" -> code.SqlExecution
    sink method "create" -> code.SqlExecution
    sink method "update" -> code.SqlExecution
    sink method "delete" -> code.SqlExecution
    sink method "insert_statement" -> code.SqlExecution
    sink method "update_statement" -> code.SqlExecution
    sink method "delete_statement" -> code.SqlExecution
  }
}
