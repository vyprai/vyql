import code.{Deserialization, SecretValue, NetworkSend, WeakHash, WeakCipher}

adapter ruby {
  package "ntlm-http" {
    sink method "parse" -> code.Deserialization
    source method "lm_hash" -> code.SecretValue
    flag code.WeakHash on any {
      method "lm_hash"
    }
    source method "ntlm_hash" -> code.SecretValue
    flag code.WeakHash on any {
      method "ntlm_hash"
    }
    source method "ntlmv2_hash" -> code.SecretValue
    flag code.WeakHash on any {
      method "ntlmv2_hash"
    }
    flag code.WeakCipher on any {
      method "apply_des"
    }
    sink method "old_request" -> code.NetworkSend
  }
}
