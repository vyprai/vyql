import code.{FilePathAccess}

adapter ruby {
  package "require_all" {
    sink method "require_all" -> code.FilePathAccess
    sink method "require_rel" -> code.FilePathAccess
    sink method "load_all" -> code.FilePathAccess
    sink method "load_rel" -> code.FilePathAccess
    sink method "autoload_all" -> code.FilePathAccess
    sink method "autoload_rel" -> code.FilePathAccess
  }
}
