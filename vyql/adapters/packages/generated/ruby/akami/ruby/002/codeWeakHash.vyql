module bindings.ruby.migration.me382d2eb;

binding weakHash2 {
  requires {
    dependency("akami")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "Akami::WSSE::VerifySignature.generate_digest"
  emit issue code.WeakHash at node
}
