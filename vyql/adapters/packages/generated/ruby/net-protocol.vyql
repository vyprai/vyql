import code.{NetworkData, NetworkSend}

adapter ruby {
  package "net-protocol" {
    source method "read" -> code.NetworkData
    source method "read_all" -> code.NetworkData
    source method "rbuf_consume" -> code.NetworkData
    sink method "write" -> code.NetworkSend
    sink method "writeline" -> code.NetworkSend
    sink method "write0" -> code.NetworkSend
    sink method "write_message_0" -> code.NetworkSend
    sink method "write_message" -> code.NetworkSend
    sink method "write_message_by_block" -> code.NetworkSend
    sink method "buffer_filling" -> code.NetworkSend
    sink method "puts" -> code.NetworkSend
    sink method "printf" -> code.NetworkSend
  }
}
