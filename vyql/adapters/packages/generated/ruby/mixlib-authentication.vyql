import code.{WeakHash, SecretValue}
import core.{AuthenticationCheck}

adapter ruby {
  package "mixlib-authentication" {
    flag code.WeakHash on any {
      method "Mixlib::Authentication::Digester.hash_file"
    }
    flag code.WeakHash on any {
      method "Mixlib::Authentication::Digester.hash_string"
    }
    control method "Mixlib::Authentication::SignatureVerification.authenticate_user_request" -> core.AuthenticationCheck
    control method "Mixlib::Authentication::SignatureVerification.authenticate_request" -> core.AuthenticationCheck
    source method "Mixlib::Authentication::SignedHeaderAuth.sign" -> code.SecretValue
    source method "Mixlib::Authentication::SignedHeaderAuth.do_sign" -> code.SecretValue
  }
}
