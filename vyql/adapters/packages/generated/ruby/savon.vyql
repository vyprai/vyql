import code.{NetworkSend, SecretValue, WeakCipher}

adapter ruby {
  package "savon" {
    sink method "call" -> code.NetworkSend
    source method "wsse_auth" -> code.SecretValue
    source method "ssl_cert_key_file" -> code.SecretValue
    source method "ssl_cert_key_password" -> code.SecretValue
    source method "ssl_cert_file" -> code.SecretValue
    source method "ssl_ca_cert_file" -> code.SecretValue
    flag code.WeakCipher on any {
      method "ssl_ciphers"
    }
    source method "basic_auth" -> code.SecretValue
    source method "digest_auth" -> code.SecretValue
    source method "ntlm" -> code.SecretValue
  }
}
