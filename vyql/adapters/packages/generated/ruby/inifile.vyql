import code.{FilePathAccess, Deserialization}
import core.{InputValidation}

adapter ruby {
  package "inifile" {
    sink method "self.load" -> code.FilePathAccess
    sink method "read" -> code.FilePathAccess
    sink method "write" -> code.FilePathAccess
    sink method "parse" -> code.Deserialization
    sink method "Parser.parse" -> code.Deserialization
    control method "escape_value" -> core.InputValidation
  }
}
