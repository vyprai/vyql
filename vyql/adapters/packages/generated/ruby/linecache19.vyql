import code.{FilePathAccess}

adapter ruby {
  package "linecache19" {
    sink method "checkcache" -> code.FilePathAccess
    sink method "cache" -> code.FilePathAccess
    sink method "getline" -> code.FilePathAccess
    sink method "getlines" -> code.FilePathAccess
    sink method "remap_file" -> code.FilePathAccess
    sink method "remap_file_lines" -> code.FilePathAccess
    sink method "sha1" -> code.FilePathAccess
    sink method "size" -> code.FilePathAccess
    sink method "stat" -> code.FilePathAccess
    sink method "trace_line_numbers" -> code.FilePathAccess
    sink method "update_cache" -> code.FilePathAccess
    sink method "lnums_for_file" -> code.FilePathAccess
  }
}
