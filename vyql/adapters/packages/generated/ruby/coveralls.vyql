import code.{CommandExecution, SecretValue, UrlFetch}

adapter ruby {
  package "coveralls" {
    sink method "CommandLine.push" -> code.CommandExecution
    sink method "CommandLine.report" -> code.CommandExecution
    sink method "CommandLine.open_token_based_url" -> code.CommandExecution
    sink method "CommandLine.open_token_based_url" -> code.UrlFetch
    source method "Configuration.configuration" -> code.SecretValue
  }
}
