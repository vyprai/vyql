import code.{DatabaseRead, SqlExecution}
adapter ruby {
  package "orm_adapter" {
    sink method "get!" -> code.DatabaseRead
    sink method "get" -> code.DatabaseRead
    sink method "find_first" -> code.DatabaseRead
    sink method "find_all" -> code.DatabaseRead
    sink method "create!" -> code.SqlExecution
    sink method "destroy" -> code.SqlExecution
  }
}
