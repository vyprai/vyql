import code.{CommandExecution, UrlFetch}

adapter ruby {
  package "rvm-capistrano" {
    sink method "run_rvm" -> code.CommandExecution
    sink method "run_without_rvm" -> code.CommandExecution
    sink method "run_with_rvm" -> code.CommandExecution
    sink method "command_with_shell" -> code.CommandExecution
    sink method "rvm_user_command" -> code.CommandExecution
    sink method "run_silent_curl" -> code.UrlFetch
  }
}
