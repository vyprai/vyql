import code.{SecretValue}
import core.{UserControlledData}

adapter ruby {
  package "signet" {
    source method "parse_auth_param_list" -> core.UserControlledData
    source method "parse_authorization_header" -> core.UserControlledData
    source method "parse_form_encoded_credentials" -> core.UserControlledData
    source method "parse_www_authenticate_header" -> core.UserControlledData
    source method "parse_basic_credentials" -> core.UserControlledData
    source method "parse_bearer_credentials" -> core.UserControlledData
    source method "parse_oauth_challenge" -> core.UserControlledData
    source method "parse_credentials" -> core.UserControlledData
    source method "extract_credential_key_option" -> code.SecretValue
    source method "extract_credential_secret_option" -> code.SecretValue
  }
}
