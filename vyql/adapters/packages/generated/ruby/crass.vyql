import code.{Deserialization}
adapter ruby {
  package "crass" {
    sink method "parse_component_value" -> code.Deserialization
    sink method "parse_component_values" -> code.Deserialization
    sink method "parse_declaration" -> code.Deserialization
    sink method "parse_declarations" -> code.Deserialization
    sink method "parse_properties" -> code.Deserialization
    sink method "parse_rule" -> code.Deserialization
  }
}
