import code.{HttpInput, StoredDataRead}
import core.{InputValidation, AuthenticationCheck}

adapter ruby {
  package "rack-openid" {
    source method "call" -> code.HttpInput
    control method "sanitize_params!" -> core.InputValidation
    control method "authenticate_session" -> core.AuthenticationCheck
    source method "session" -> code.StoredDataRead
  }
}
