import code.{FileUse, StoredDataWrite}

adapter ruby {
  package "activestorage" {
    sink method "upload" -> code.FileUse
    sink method "download" -> code.FileUse
    sink method "download_chunk" -> code.FileUse
    sink method "open" -> code.FileUse
    sink method "compose" -> code.FileUse
  }
}
