import code.{Deserialization}

adapter ruby {
  package "globalid" {
    sink method "parse" -> code.Deserialization
    sink method "parse_encoded_gid" -> code.Deserialization
    sink method "locate" -> code.Deserialization
    sink method "locate_many" -> code.Deserialization
    sink method "locate_signed" -> code.Deserialization
    sink method "decode" -> code.Deserialization
  }
}
