import code.{HtmlRender}

adapter ruby {
  package "builder" {
    sink method "tag!" -> code.HtmlRender
    sink method "text!" -> code.HtmlRender
    sink method "method_missing" -> code.HtmlRender
    sink method "declare!" -> code.HtmlRender
    sink method "instruct!" -> code.HtmlRender
    sink method "cdata!" -> code.HtmlRender
    sink method "cdata_value!" -> code.HtmlRender
    sink method "comment!" -> code.HtmlRender
  }
}
