import code.{LogOutput, FileUse, StoredDataRead}

adapter ruby {
  package "meta_request" {
    sink method "debug" -> code.LogOutput
    sink method "info" -> code.LogOutput
    sink method "warn" -> code.LogOutput
    sink method "error" -> code.LogOutput
    sink method "fatal" -> code.LogOutput
    sink method "unknown" -> code.LogOutput
    sink method "write" -> code.FileUse
    source method "events_json" -> code.StoredDataRead
  }
}
