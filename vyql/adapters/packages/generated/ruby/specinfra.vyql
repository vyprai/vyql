import code.{CommandExecution, FilePathAccess, FileUse, Deserialization}

adapter ruby {
  package "specinfra" {
    sink method "run_command" -> code.CommandExecution
    sink method "spawn_command" -> code.CommandExecution
    sink method "docker_run!" -> code.CommandExecution
    sink method "send_file" -> code.FilePathAccess
    sink method "send_directory" -> code.FilePathAccess
    sink method "scp_upload!" -> code.FilePathAccess
    sink method "check_contains" -> code.FileUse
    control method "escape" -> core.ShellEscape
    sink method "parse" -> code.Deserialization
  }
}
