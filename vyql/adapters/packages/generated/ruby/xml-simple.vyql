import code.{Deserialization}

adapter ruby {
  package "xml-simple" {
    sink method "xml_in" -> code.Deserialization
    sink method "save_storable" -> code.Deserialization
    sink method "restore_storable" -> code.Deserialization
    sink method "save_mem_copy" -> code.Deserialization
    sink method "restore_mem_copy" -> code.Deserialization
  }
}
