import code.{SecretValue}
adapter ruby {
  package "google-apis-iamcredentials_v1" {
    source method "generate_service_account_access_token" -> code.SecretValue
    source method "generate_service_account_id_token" -> code.SecretValue
    source method "sign_service_account_blob" -> code.SecretValue
    source method "sign_service_account_jwt" -> code.SecretValue
  }
}
