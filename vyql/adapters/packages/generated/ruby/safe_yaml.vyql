import code.{Deserialization}
adapter ruby {
  package "safe_yaml" {
    sink method "load" -> code.Deserialization
    sink method "load_file" -> code.Deserialization
    sink method "safe_load" -> code.Deserialization
    sink method "safe_load_file" -> code.Deserialization
    sink method "unsafe_load_file" -> code.Deserialization
  }
}
