import code.{Deserialization}
import core.{HtmlEscape}

adapter ruby {
  package "loofah" {
    sink method "parse" -> code.Deserialization
    sink method "html4_document" -> code.Deserialization
    sink method "html4_fragment" -> code.Deserialization
    sink method "html5_document" -> code.Deserialization
    sink method "html5_fragment" -> code.Deserialization
    sink method "xml_document" -> code.Deserialization
    sink method "xml_fragment" -> code.Deserialization

    control method "sanitize" -> core.HtmlEscape
    control method "sanitize_css" -> core.HtmlEscape
    control method "scrub_html4_document" -> core.HtmlEscape
    control method "scrub_html4_fragment" -> core.HtmlEscape
    control method "scrub_html5_document" -> core.HtmlEscape
    control method "scrub_html5_fragment" -> core.HtmlEscape
    control method "scrub_xml_document" -> core.HtmlEscape
    control method "scrub_xml_fragment" -> core.HtmlEscape
    control method "scrub!" -> core.HtmlEscape
    control method "strip_tags" -> core.HtmlEscape
  }
}
