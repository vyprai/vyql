import code.{Deserialization}
adapter ruby {
  package "i18n" {
    sink method "parse" -> code.Deserialization
    sink method "load_file" -> code.Deserialization
    sink method "load_rb" -> code.Deserialization
    sink method "load_yml" -> code.Deserialization
    sink method "load_json" -> code.Deserialization
  }
}
