import code.{FilePathAccess, HtmlRender}
import core.{UserControlledData}

adapter ruby {
  package "letter_opener_web" {
    source method "LettersController.params" -> core.UserControlledData
    sink method "LettersController.show" -> code.HtmlRender
    sink method "LettersController.attachment" -> code.FilePathAccess
  }
}
