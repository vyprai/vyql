module bindings.ruby.migration.m3271f7a0;

binding weakCipher0 {
  requires {
    dependency("ruby-rc4")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "encrypt!"
  emit issue code.WeakCipher at node
}
