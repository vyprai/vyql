import code.{CodeEval, NetworkConnect}

adapter ruby {
  package "debugger" {
    sink method "debug_eval" -> code.CodeEval
    sink method "debug_silent_eval" -> code.CodeEval
    sink method "start_remote" -> code.NetworkConnect
    sink method "start_control" -> code.NetworkConnect
    sink method "start_client" -> code.NetworkConnect
  }
}
