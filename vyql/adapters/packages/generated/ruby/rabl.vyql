import code.{CodeEval, HtmlRender, TemplateRender}

adapter ruby {
  package "rabl" {
    sink method "render" -> code.HtmlRender
    sink method "extends" -> code.TemplateRender
    sink method "partial" -> code.TemplateRender
    sink method "compile" -> code.CodeEval
    control method "escape_output" -> core.HtmlEscape
    control method "escape_value" -> core.HtmlEscape
  }
}
