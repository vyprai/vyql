import code.{LogOutput}
adapter ruby {
  package "term-ansicolor" {
    sink method "apply_code" -> code.LogOutput
    sink method "apply_attribute" -> code.LogOutput
    sink method "color" -> code.LogOutput
    sink method "on_color" -> code.LogOutput
    sink method "move_to" -> code.LogOutput
    sink method "move_to_column" -> code.LogOutput
    sink method "move_to_line" -> code.LogOutput
    sink method "move_up" -> code.LogOutput
    sink method "move_down" -> code.LogOutput
    sink method "move_forward" -> code.LogOutput
    sink method "move_backward" -> code.LogOutput
    sink method "move_to_next_line" -> code.LogOutput
    sink method "move_to_previous_line" -> code.LogOutput
    sink method "move_home" -> code.LogOutput
    sink method "clear_screen" -> code.LogOutput
    sink method "erase_in_display" -> code.LogOutput
    sink method "erase_in_line" -> code.LogOutput
    sink method "scroll_up" -> code.LogOutput
    sink method "scroll_down" -> code.LogOutput
    sink method "save_position" -> code.LogOutput
    sink method "restore_position" -> code.LogOutput
    sink method "return_to_position" -> code.LogOutput
    sink method "show_cursor" -> code.LogOutput
    sink method "hide_cursor" -> code.LogOutput
    sink method "move_command" -> code.LogOutput
  }
}
