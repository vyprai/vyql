module bindings.ruby.migration.m7688ad65;

binding weakCipher6 {
  requires {
    dependency("savon")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "ssl_ciphers"
  emit issue code.WeakCipher at node
}
