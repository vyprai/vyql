module bindings.ruby.migration.mede61e8c;

binding weakHash1 {
  requires {
    dependency("authlogic")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "Authlogic::CryptoProviders::MD5.encrypt"
  emit issue code.WeakHash at node
}
