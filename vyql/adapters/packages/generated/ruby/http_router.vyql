import code.{HttpInput, RedirectTarget}
adapter ruby {
  package "http_router" {
    source method "add_route" -> code.HttpInput
    source method "url" -> code.HttpInput
    source method "path" -> code.HttpInput
    flag code.RedirectTarget on any {
      method "process_destination_path"
    }
    flag code.RedirectTarget on any {
      method "rewrite_partial_path_info"
    }
    flag code.RedirectTarget on any {
      method "rewrite_path_info"
    }
    flag code.RedirectTarget on any {
      method "raw_url"
    }
    flag code.RedirectTarget on any {
      method "raw_path"
    }
    flag code.RedirectTarget on any {
      method "raw_call"
    }
  }
}
