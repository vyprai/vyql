import core.{UserControlledData}

adapter ruby {
  package "classifier-reborn" {
    source method "add_item" -> core.UserControlledData
    source method "classify" -> core.UserControlledData
    source method "classify_with_score" -> core.UserControlledData
    source method "search" -> core.UserControlledData
    source method "find_related" -> core.UserControlledData
    source method "validate" -> core.UserControlledData
    source method "word_hash" -> core.UserControlledData
  }
}
