module bindings.ruby.migration.m01a849b2;

binding htmlEscape3 {
  requires {
    dependency("github-markup")
  }
  query pattern callExpr where callee.method == "Github::Markup::CommandImplementation.sanitize"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}
