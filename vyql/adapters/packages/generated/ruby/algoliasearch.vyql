import code.{NetworkSend, HttpInput}
import core.{UserControlledData}

adapter ruby {
  package "algoliasearch" {
    sink method "search" -> code.NetworkSend
    sink method "delete_by_query" -> code.NetworkSend
    sink method "delete_by_query!" -> code.NetworkSend
    sink method "set_settings" -> code.NetworkSend
    sink method "post" -> code.NetworkSend
  }
}
