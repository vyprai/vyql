import code.{NosqlQuery, StoredDataRead, Deserialization}
import core.{UserControlledData}

adapter ruby {
  package "mongoid" {
    sink method "read" -> code.NosqlQuery
    sink method "find" -> code.NosqlQuery
    sink method "where" -> code.NosqlQuery

    source method "connect_to" -> code.StoredDataRead
    source method "connect_to" -> core.UserControlledData
    source method "load!" -> code.StoredDataRead
    source method "load!" -> core.UserControlledData
    source method "load_configuration" -> code.StoredDataRead
    source method "load_configuration" -> core.UserControlledData

    sink method "instance" -> code.Deserialization
    sink method "execute_build" -> code.Deserialization
    sink method "execute_from_db" -> code.Deserialization
  }
}
