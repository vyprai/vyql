module bindings.ruby.migration.m5a5b369b;

binding weakHash1 {
  requires {
    dependency("rubyntlm")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "lm_hash"
  emit issue code.WeakHash at node
}
