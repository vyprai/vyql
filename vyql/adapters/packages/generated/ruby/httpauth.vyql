import code.{SecretValue}
import core.{AuthenticationCheck}

adapter ruby {
  package "httpauth" {
    source method "pack_authorization" -> code.SecretValue
    source method "unpack_authorization" -> code.SecretValue
    source method "get_credentials" -> code.SecretValue
    control method "pack_challenge" -> core.AuthenticationCheck
    control method "unpack_challenge" -> core.AuthenticationCheck
  }
}
