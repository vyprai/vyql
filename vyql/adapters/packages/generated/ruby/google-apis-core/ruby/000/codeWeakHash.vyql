module bindings.ruby.migration.mbafa908f;

binding weakHash0 {
  requires {
    dependency("google-apis-core")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "google.apis.core.hash"
  emit issue code.WeakHash at node
}
