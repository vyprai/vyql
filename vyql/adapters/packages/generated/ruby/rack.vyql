import core.{HtmlEscape, InputValidation, PathCanonicalization}
adapter ruby {
  package "rack" {
    control method "Rack::Utils.escape" -> core.InputValidation
    control method "Rack::Utils.escape_path" -> core.PathCanonicalization
    control method "Rack::Utils.unescape_path" -> core.PathCanonicalization
    control method "Rack::Utils.unescape" -> core.InputValidation
    control method "Rack::Utils.escape_html" -> core.HtmlEscape
  }
}
