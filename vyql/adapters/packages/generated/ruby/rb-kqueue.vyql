import code.{CommandExecution, FilePathAccess, NetworkData}
adapter ruby {
  package "rb-kqueue" {
    source method "watch_stream_for_read" -> code.NetworkData
    source method "watch_socket_for_read" -> code.NetworkData
    source method "watch_stream_for_write" -> code.NetworkData
    source method "watch_socket_for_write" -> code.NetworkData
    sink method "watch_file" -> code.FilePathAccess
    sink method "watch_process" -> code.CommandExecution
  }
}
