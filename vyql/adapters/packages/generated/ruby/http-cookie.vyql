import code.{Deserialization, HttpInput, SqlExecution}

adapter ruby {
  package "http-cookie" {
    source method "HTTP::Cookie.parse" -> code.HttpInput
    sink method "HTTP::CookieJar.load" -> code.Deserialization
    sink method "HTTP::CookieJar::MozillaStore.execute" -> code.SqlExecution
    sink method "HTTP::CookieJar::MozillaStore.prepare" -> code.SqlExecution
  }
}
