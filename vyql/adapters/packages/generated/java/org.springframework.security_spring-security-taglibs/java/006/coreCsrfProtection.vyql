binding csrfProtection6 {
  requires {
    dependency("org.springframework.security:spring-security-taglibs")
  }
  query pattern callExpr where callee.method == "doEndTag"
  emit check core.CsrfProtection at call {
    covers path {
      from: call
      to: call
    }
  }
}
