import code.{HttpInput, UrlFetch}

adapter java {
  package "org.apache.httpcomponents:fluent-hc" {
    sink method "Get" -> code.UrlFetch
    sink method "Head" -> code.UrlFetch
    sink method "Post" -> code.UrlFetch
    sink method "Patch" -> code.UrlFetch
    sink method "Put" -> code.UrlFetch
    sink method "Trace" -> code.UrlFetch
    sink method "Delete" -> code.UrlFetch
    sink method "Options" -> code.UrlFetch
    sink method "bodyString" -> code.UrlFetch
    sink method "body" -> code.UrlFetch
    sink method "execute" -> code.UrlFetch
  }
}
