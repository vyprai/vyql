import code.{SqlExecution, Deserialization}
import core.{InputValidation}

adapter java {
  package "cn.hutool:hutool-all" {
    sink method "query" -> code.SqlExecution
    sink method "execute" -> code.SqlExecution
    sink method "parse" -> code.Deserialization
    control method "match" -> core.InputValidation
  }
}
