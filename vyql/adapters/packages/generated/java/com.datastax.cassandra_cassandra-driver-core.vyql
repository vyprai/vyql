import code.{SqlExecution}
import core.{SqlParameterization}

adapter java {
  package "com.datastax.cassandra:cassandra-driver-core" {
    sink method "execute" -> code.SqlExecution
    sink method "executeAsync" -> code.SqlExecution
    control method "prepare" -> core.SqlParameterization
    control method "prepareAsync" -> core.SqlParameterization
  }
}
