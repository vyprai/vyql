adapter java {
  package "com.datastax.cassandra:cassandra-driver-mapping" {
    sink method "saveQuery" -> code.SqlExecution
    sink method "saveQueryAsync" -> code.SqlExecution
    sink method "getQuery" -> code.SqlExecution
    sink method "getQueryAsync" -> code.SqlExecution
    sink method "deleteQuery" -> code.SqlExecution
    sink method "deleteQueryAsync" -> code.SqlExecution
    sink method "modifyQueryString" -> code.SqlExecution
  }
}
