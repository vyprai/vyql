import code.{HttpInput}
import core.{AuthenticationCheck, AuthorizationCheck}
adapter java {
  package "io.quarkus:quarkus-resteasy" {
    source method "extractUriInfo" -> code.HttpInput
    source method "extractHttpHeaders" -> code.HttpInput
    source method "extractCookies" -> code.HttpInput
    source method "extractRequestHeaders" -> code.HttpInput
    control method "filter" -> core.AuthenticationCheck
    control method "filter" -> core.AuthorizationCheck
  }
}
