module bindings.java.migration.m299dbf4d;

binding authorizationCheck0 {
  requires {
    dependency("org.thymeleaf.extras:thymeleaf-extras-springsecurity5")
  }
  query pattern callExpr where callee.method == "authorizeUsingAccessExpression"
  emit check core.AuthorizationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}
