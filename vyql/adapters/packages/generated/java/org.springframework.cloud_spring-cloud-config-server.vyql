import code.{WeakCipher}
import core.{UserControlledData}

adapter java {
  package "org.springframework.cloud:spring-cloud-config-server" {
    source method "encrypt" -> core.UserControlledData
    source method "decrypt" -> core.UserControlledData
    flag code.WeakCipher on any {
      method "validateEncryptionWeakness"
    }
  }
}
