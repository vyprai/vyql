import code.{Deserialization}

adapter java {
  package "com.esotericsoftware:kryo" {
    sink method "readObject" -> code.Deserialization
    sink method "readObjectOrNull" -> code.Deserialization
    sink method "readClassAndObject" -> code.Deserialization
    sink method "read" -> code.Deserialization
  }
}
