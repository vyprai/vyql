binding authorizationCheck5 {
  requires {
    dependency("io.quarkus:quarkus-resteasy")
  }
  query pattern callExpr where callee.method == "filter"
  emit check core.AuthorizationCheck at call {
    covers path {
      from: call
      to: call
    }
  }
