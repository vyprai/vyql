import code.{HttpInput, RedirectTarget}

adapter java {
  package "com.google.oauth-client:google-oauth-client-jetty" {
    source method "handle" -> code.HttpInput
    source method "queryToMap" -> code.HttpInput
    mark method "getRedirectUri" -> code.RedirectTarget
    mark method "setCallbackPath" -> code.RedirectTarget
    mark method "setLandingPages" -> code.RedirectTarget
  }
}
