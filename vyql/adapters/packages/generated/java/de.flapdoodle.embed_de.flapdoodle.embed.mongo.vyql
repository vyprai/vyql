import code.{NetworkConnect, NetworkSend, SecretValue}
adapter java {
  package "de.flapdoodle.embed:de.flapdoodle.embed.mongo" {
    sink method "sendShutdown" -> code.NetworkConnect
    sink method "sendShutdown" -> code.NetworkSend
    sink method "sendShutdownLegacy" -> code.NetworkConnect
    sink method "sendShutdownLegacy" -> code.NetworkSend
    source method "password" -> code.SecretValue
    source method "passwordAsString" -> code.SecretValue
  }
}
