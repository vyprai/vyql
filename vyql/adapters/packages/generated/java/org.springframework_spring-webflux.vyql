adapter java {
  package "org.springframework:spring-webflux" {
    source method "extract" -> code.HttpInput
    source method "getHeaders" -> code.HttpInput
    source method "getCookies" -> code.HttpInput
    sink method "send" -> code.NetworkSend
    sink method "write" -> code.ResponseHeaderWrite
    sink method "parse" -> code.Deserialization
    control method "validate" -> core.InputValidation
  }
}
