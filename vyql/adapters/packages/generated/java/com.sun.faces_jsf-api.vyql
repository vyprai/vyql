import code.{CodeEval, HttpInput, ResponseHeaderWrite}
import core.{InputValidation}

adapter java {
  package "com.sun.faces:jsf-api" {
    control method "javax.faces.component.MethodBindingValidator.validate" -> core.InputValidation
    source method "javax.faces.application.Resource.getRequestPath" -> code.HttpInput
    sink method "javax.faces.application.Resource.getResponseHeaders" -> code.ResponseHeaderWrite
    sink method "javax.faces.component.UIComponent.setValueExpression" -> code.CodeEval
    sink method "javax.faces.component.UICommand.setAction" -> code.CodeEval
    sink method "javax.faces.component.UICommand.setActionListener" -> code.CodeEval
  }
}
