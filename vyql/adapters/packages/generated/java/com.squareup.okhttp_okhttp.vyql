import code.{HttpInput, UrlFetch}
adapter java {
  package "com.squareup.okhttp:okhttp" {
    source method "parse" -> code.HttpInput
    source method "query" -> code.HttpInput
    source method "queryParameter" -> code.HttpInput
    sink method "execute" -> code.UrlFetch
    sink method "enqueue" -> code.UrlFetch
  }
}
