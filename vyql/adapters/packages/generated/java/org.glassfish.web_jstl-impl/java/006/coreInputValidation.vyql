module bindings.java.migration.mddb29b43;

binding inputValidation6 {
  requires {
    dependency("org.glassfish.web:jstl-impl")
  }
  query pattern callExpr where callee.method == "setEscapeXml"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
