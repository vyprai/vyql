import code.{NetworkSend, NetworkConnect, Deserialization}
import core.{InputValidation, AuthenticationCheck}

adapter java {
  package "org.eclipse.jetty:jetty-client" {
    sink method "send" -> code.NetworkSend
    sink method "connect" -> code.NetworkConnect
    sink method "parse" -> code.Deserialization
    control method "sanitize" -> core.InputValidation
    control method "authenticate" -> core.AuthenticationCheck
  }
}
