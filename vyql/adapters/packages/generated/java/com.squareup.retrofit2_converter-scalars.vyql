adapter java {
  package "com.squareup.retrofit2:converter-scalars" {
    source method "ScalarResponseBodyConverters.StringResponseBodyConverter.convert" -> core.UserControlledData
    source method "ScalarResponseBodyConverters.BooleanResponseBodyConverter.convert" -> core.UserControlledData
    source method "ScalarResponseBodyConverters.ByteResponseBodyConverter.convert" -> core.UserControlledData
    source method "ScalarResponseBodyConverters.CharacterResponseBodyConverter.convert" -> core.UserControlledData
    source method "ScalarResponseBodyConverters.DoubleResponseBodyConverter.convert" -> core.UserControlledData
    source method "ScalarResponseBodyConverters.FloatResponseBodyConverter.convert" -> core.UserControlledData
    source method "ScalarResponseBodyConverters.IntegerResponseBodyConverter.convert" -> core.UserControlledData
    source method "ScalarResponseBodyConverters.LongResponseBodyConverter.convert" -> core.UserControlledData
    source method "ScalarResponseBodyConverters.ShortResponseBodyConverter.convert" -> core.UserControlledData
  }
}
