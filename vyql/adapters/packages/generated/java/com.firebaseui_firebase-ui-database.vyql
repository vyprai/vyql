import code.{DatabaseRead, Deserialization}
adapter java {
  package "com.firebaseui:firebase-ui-database" {
    sink method "parseSnapshot" -> code.Deserialization
    sink method "setQuery" -> code.DatabaseRead
    sink method "setIndexedQuery" -> code.DatabaseRead
    sink method "DatabasePagingSource" -> code.DatabaseRead
    sink method "FirebaseArray" -> code.DatabaseRead
    sink method "FirebaseIndexArray" -> code.DatabaseRead
  }
}
