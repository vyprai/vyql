adapter java {
  package "org.apache.cxf:cxf-rt-rs-client" {
    source method "WebClient.query" -> core.UserControlledData
    source method "WebClient.header" -> core.UserControlledData
    source method "WebClient.headers" -> core.UserControlledData
    source method "WebClient.cookie" -> code.Cookie
    source method "WebClient.getResponse" -> code.HttpInput

    sink method "WebClient.invoke" -> code.NetworkSend
    sink method "WebClient.post" -> code.NetworkSend
    sink method "WebClient.put" -> code.NetworkSend
    sink method "WebClient.get" -> code.NetworkSend
    sink method "WebClient.head" -> code.NetworkSend
    sink method "WebClient.options" -> code.NetworkSend
    sink method "WebClient.delete" -> code.NetworkSend
    sink method "WebClient.form" -> code.NetworkSend
    sink method "WebClient.create" -> code.NetworkConnect
  }
}
