module bindings.java.migration.m229c4bb8;

binding redirectTarget3 {
  requires {
    dependency("com.google.oauth-client:google-oauth-client-jetty")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "setCallbackPath"
  emit issue code.RedirectTarget at node
  emit sink code.RedirectTargetSink at node
}
