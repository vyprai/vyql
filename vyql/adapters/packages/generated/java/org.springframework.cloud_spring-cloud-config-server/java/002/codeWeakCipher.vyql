module bindings.java.migration.mcdb35e01;

binding weakCipher2 {
  requires {
    dependency("org.springframework.cloud:spring-cloud-config-server")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "validateEncryptionWeakness"
  emit issue code.WeakCipher at node
}
