module bindings.java.migration.mb4f5005b;

binding weakHash0 {
  requires {
    dependency("org.mvel:mvel2")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "org.mvel.mvel2.hash"
  emit issue code.WeakHash at node
}
