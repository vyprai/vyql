import code.{Deserialization, XmlParse}
import core.{HtmlEscape}

adapter java {
  package "org.json:json" {
    sink method "toJSONObject" -> code.Deserialization
    sink method "toJSONArray" -> code.Deserialization
    sink method "rowToJSONObject" -> code.Deserialization
    sink method "parse" -> code.XmlParse
    sink method "JSONObject" -> code.Deserialization
    sink method "JSONArray" -> code.Deserialization
    control method "escape" -> core.HtmlEscape
  }
}
