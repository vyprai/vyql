import code.{FilePathAccess, UrlFetch}

adapter java {
  package "com.thoughtworks.paranamer:paranamer" {
    sink method "JavadocParanamer" -> code.FilePathAccess
    sink method "getRawJavadoc" -> code.FilePathAccess
    sink method "UrlJavadocProvider" -> code.UrlFetch
    sink method "urlToStream" -> code.UrlFetch
    sink method "DirJavadocProvider" -> code.FilePathAccess
    sink method "ZipJavadocProvider" -> code.FilePathAccess
  }
}
