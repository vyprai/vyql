import code.{FilePathAccess, StoredDataRead, StoredDataWrite}
adapter java {
  package "org.fusesource.leveldbjni:leveldbjni-all" {
    sink method "put" -> code.StoredDataWrite
    sink method "write" -> code.StoredDataWrite
    source method "get" -> code.StoredDataRead
    source method "iterator" -> code.StoredDataRead
    sink method "delete" -> code.StoredDataWrite
    sink method "open" -> code.FilePathAccess
    sink method "destroy" -> code.FilePathAccess
    sink method "repair" -> code.FilePathAccess
  }
}
