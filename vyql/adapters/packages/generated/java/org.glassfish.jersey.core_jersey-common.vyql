import code.{SecretValue, FilePathAccess}
adapter java {
  package "org.glassfish.jersey.core:jersey-common" {
    source method "trustStorePassword" -> code.SecretValue
    source method "keyStorePassword" -> code.SecretValue
    source method "keyPassword" -> code.SecretValue
    sink method "trustStoreFile" -> code.FilePathAccess
    sink method "keyStoreUrl" -> code.FilePathAccess
    sink method "keyStoreFile" -> code.FilePathAccess
  }
}
