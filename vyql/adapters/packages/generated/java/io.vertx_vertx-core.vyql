import code.{FilePathAccess}

adapter java {
  package "io.vertx:vertx-core" {
    sink method "write" -> code.FilePathAccess
    sink method "read" -> code.FilePathAccess
    sink method "open" -> code.FilePathAccess
    sink method "readFile" -> code.FilePathAccess
    sink method "writeFile" -> code.FilePathAccess
    sink method "delete" -> code.FilePathAccess
    sink method "readDir" -> code.FilePathAccess
    sink method "copy" -> code.FilePathAccess
    sink method "move" -> code.FilePathAccess
  }
}
