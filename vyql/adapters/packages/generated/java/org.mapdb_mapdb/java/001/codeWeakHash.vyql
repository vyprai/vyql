module bindings.java.migration.mb3bb1fc9;

binding weakHash1 {
  requires {
    dependency("org.mapdb:mapdb")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "org.mapdb.mapdb.hash"
  emit issue code.WeakHash at node
}
