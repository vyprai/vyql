module bindings.java.migration.m88c293c3;

binding authorizationCheck4 {
  requires {
    dependency("org.eclipse.jetty:jetty-security")
  }
  query pattern callExpr where callee.method == "isAuthorized"
  emit check core.AuthorizationCheck at call {
    covers path {
      from: call
      to: call
    }
  }
}
