import core.{UserControlledData}

adapter java {
  package "org.springframework.cloud:spring-cloud-spring-service-connector" {
    source method "CassandraClusterFactory" -> core.UserControlledData
    source method "CloudDataSourceFactory" -> core.UserControlledData
    source method "MailSenderFactory" -> core.UserControlledData
    source method "GenericCloudServiceConnectorFactory" -> core.UserControlledData
    source method "MongoDbFactoryFactory" -> core.UserControlledData
  }
}
