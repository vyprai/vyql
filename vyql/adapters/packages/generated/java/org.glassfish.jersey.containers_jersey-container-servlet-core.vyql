import code.{HttpInput, HtmlRender}
adapter java {
  package "org.glassfish.jersey.containers:jersey-container-servlet-core" {
    source method "service" -> code.HttpInput
    source method "doFilter" -> code.HttpInput
    source method "initContainerRequest" -> code.HttpInput
    source method "getHttpServletRequest" -> code.HttpInput
    sink method "service" -> code.HtmlRender
    sink method "doFilter" -> code.HtmlRender
    sink method "getHttpServletResponse" -> code.HtmlRender
    sink method "write" -> code.HtmlRender
  }
}
