module bindings.java.migration.m9d33e323;

binding inputValidation3 {
  requires {
    dependency("org.glassfish.jersey.ext:jersey-bean-validation")
  }
  query pattern callExpr where callee.method == "onValidate"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
