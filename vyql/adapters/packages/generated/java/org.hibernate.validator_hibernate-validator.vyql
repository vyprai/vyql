adapter java {
  package "org.hibernate.validator:hibernate-validator" {
    control method "validate" -> core.InputValidation
    control method "protocol" -> core.InputValidation
    control method "host" -> core.InputValidation
    control method "port" -> core.InputValidation
    control method "regexp" -> core.InputValidation
    control method "flags" -> core.InputValidation
    sink method "scriptEvaluatorFactory" -> code.CodeEval
  }
}
