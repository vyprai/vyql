import code.{NetworkData}
import core.{UserControlledData}

adapter java {
  package "com.amazonaws:aws-java-sdk-core" {
    source method "setHeaders" -> core.UserControlledData
    source method "setResourcePath" -> core.UserControlledData
    source method "withParameter" -> core.UserControlledData
    source method "getAwsResponse" -> code.NetworkData
    source method "getHttpResponse" -> code.NetworkData
    source method "setRawResponseContent" -> code.NetworkData
  }
}
