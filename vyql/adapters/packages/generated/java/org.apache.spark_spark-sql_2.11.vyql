adapter java {
  package "org.apache.spark:spark-sql_2.11" {
    sink method "open" -> code.SqlExecution
    control method "where" -> core.SqlParameterization
    sink method "decode" -> code.Deserialization
    flag code.WeakHash on any {
      path "org.apache.spark.spark.sql_2.11.hash"
    }
  }
}
