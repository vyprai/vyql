import code.{HttpInput, RedirectTarget, HtmlRender}
adapter java {
  package "javax.portlet:portlet-api" {
    source method "getReader" -> code.HttpInput
    flag code.RedirectTarget on any {
      method "sendRedirect"
    }
    sink method "write" -> code.HtmlRender
    sink method "append" -> code.HtmlRender
  }
}
