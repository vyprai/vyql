import code.{Deserialization, RegexCompile}
import core.{InputValidation}

adapter java {
  package "com.sun.jersey:jersey-core" {
    control method "UriComponent.validate" -> core.InputValidation
    control method "UriComponent.decode" -> core.InputValidation
    control method "UriTemplate.match" -> core.InputValidation
    control method "UriPattern.match" -> core.InputValidation
    flag code.RegexCompile on any {
      method "UriPattern.compile"
    }
    sink method "UriTemplateParser.parse" -> code.Deserialization
    sink method "ServiceFinder.parse" -> code.Deserialization
  }
}
