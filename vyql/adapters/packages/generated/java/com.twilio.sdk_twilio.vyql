import code.{NetworkConnect, NetworkSend, SecretValue}
import core.{InputValidation}

adapter java {
  package "com.twilio.sdk:twilio" {
    source method "Twilio.init" -> code.SecretValue
    sink method "AccountCreator.create" -> code.NetworkConnect
    sink method "AccountCreator.create" -> code.NetworkSend
    sink method "AccountReader.read" -> code.NetworkConnect
    sink method "AccountReader.read" -> code.NetworkSend
    sink method "AccountUpdater.update" -> code.NetworkConnect
    sink method "AccountUpdater.update" -> code.NetworkSend
    sink method "AccountDeleter.delete" -> code.NetworkConnect
    sink method "AccountDeleter.delete" -> code.NetworkSend
    control method "RequestValidator.validate" -> core.InputValidation
  }
}
