import code.{FilePathAccess, StoredDataRead, StoredDataWrite}
adapter java {
  package "com.amazonaws:aws-java-sdk-s3" {
    source method "getObject" -> code.StoredDataRead
    source method "listObjects" -> code.StoredDataRead
    source method "listObjectsV2" -> code.StoredDataRead
    source method "listVersions" -> code.StoredDataRead
    sink method "putObject" -> code.StoredDataWrite
    sink method "deleteObject" -> code.FilePathAccess
    sink method "deleteObjects" -> code.FilePathAccess
    sink method "createBucket" -> code.FilePathAccess
    sink method "deleteBucket" -> code.FilePathAccess
  }
}
