import code.{SecretValue, FilePathAccess, UrlFetch}

adapter java {
  package "org.apache.maven:maven-artifact" {
    source method "getPassword" -> code.SecretValue
    source method "setPassword" -> code.SecretValue
    sink method "setFile" -> code.FilePathAccess
    sink method "setDownloadUrl" -> code.UrlFetch
  }
}
