import code.{SqlExecution}

adapter java {
  package "javax.persistence:javax.persistence-api" {
    sink method "executeUpdate" -> code.SqlExecution
    sink method "createQuery" -> code.SqlExecution
    sink method "createNativeQuery" -> code.SqlExecution
    sink method "createNamedStoredProcedureQuery" -> code.SqlExecution
    sink method "createStoredProcedureQuery" -> code.SqlExecution
  }
}
