module bindings.java.migration.mf0bf139c;

binding inputValidation3 {
  requires {
    dependency("org.eclipse.jetty:jetty-client")
  }
  query pattern callExpr where callee.method == "sanitize"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
