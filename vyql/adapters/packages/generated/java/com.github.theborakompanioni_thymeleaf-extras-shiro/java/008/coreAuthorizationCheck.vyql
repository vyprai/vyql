module bindings.java.migration.m3a2a5a26;

binding authorizationCheck8 {
  requires {
    dependency("com.github.theborakompanioni:thymeleaf-extras-shiro")
  }
  query pattern callExpr where callee.method == "hasAllPermissions"
  emit check core.AuthorizationCheck at call {
    covers path {
      from: call
      to: call
    }
  }
}
