module bindings.java.generated.m3a2a5a26;

binding authorizationCheck3 {
  requires {
    dependency("com.github.theborakompanioni:thymeleaf-extras-shiro")
  }
  query pattern callExpr where callee.method == "lacksRole"
  emit check core.AuthorizationCheck at call {
    covers endpoint {
      anchor: call
    }
