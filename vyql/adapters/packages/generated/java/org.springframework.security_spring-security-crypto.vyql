import code.{WeakHash, WeakCipher, SecretValue}
import core.{AuthenticationCheck}

adapter java {
  package "org.springframework.security:spring-security-crypto" {
    flag code.WeakHash on any {
      method "PasswordEncoder.encode"
    }
    control method "PasswordEncoder.matches" -> core.AuthenticationCheck

    flag code.WeakCipher on any {
      method "BytesEncryptor.encrypt"
    }
    source method "BytesEncryptor.decrypt" -> code.SecretValue

    flag code.WeakCipher on any {
      method "TextEncryptor.encrypt"
    }
    source method "TextEncryptor.decrypt" -> code.SecretValue
  }
}
