import core.{InputValidation}

adapter java {
  package "org.glassfish.jersey.ext:jersey-bean-validation" {
    control method "validate" -> core.InputValidation
    control method "validateValue" -> core.InputValidation
    control method "validateResourceAndInputParams" -> core.InputValidation
    control method "onValidate" -> core.InputValidation
    control method "validateResult" -> core.InputValidation
    control method "validateGetter" -> core.InputValidation
    control method "validateMethod" -> core.InputValidation
  }
}
