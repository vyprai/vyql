import code.{Deserialization}
import core.{InputValidation}

adapter java {
  package "com.alibaba:fastjson" {
    sink method "parse" -> code.Deserialization
    sink method "parseObject" -> code.Deserialization
    sink method "readObject" -> code.Deserialization
    control method "validate" -> core.InputValidation
  }
}
