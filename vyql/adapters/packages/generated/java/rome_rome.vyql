import code.{Deserialization, FilePathAccess}

adapter java {
  package "rome:rome" {
    sink method "parse" -> code.Deserialization
    sink method "build" -> code.Deserialization
    sink method "read" -> code.Deserialization
    sink method "XmlReader" -> code.Deserialization
    sink method "SyndFeedInput" -> code.Deserialization
    sink method "SAXBuilder" -> code.Deserialization
    sink method "setFeedParser" -> code.Deserialization
    sink method "createParser" -> code.Deserialization
  }
}
