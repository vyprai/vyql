import code.{Deserialization}

adapter java {
  package "com.fasterxml.jackson.datatype:jackson-datatype-hppc" {
    sink method "findBeanDeserializer" -> code.Deserialization
    sink method "findCollectionLikeDeserializer" -> code.Deserialization
    sink method "findMapLikeDeserializer" -> code.Deserialization
    sink method "deserialize" -> code.Deserialization
    sink method "deserializeWithType" -> code.Deserialization
    sink method "deserializeContents" -> code.Deserialization
  }
}
