import code.{SecretValue, NetworkData}
import core.{UserControlledData}

adapter java {
  package "com.alibaba.cloud:spring-cloud-starter-alibaba-nacos-discovery" {
    source method "getSecretKey" -> code.SecretValue
    source method "getPassword" -> code.SecretValue
    source method "setSecretKey" -> code.SecretValue
    source method "setPassword" -> code.SecretValue
    source method "getNetworkInterface" -> core.UserControlledData
    source method "setNetworkInterface" -> core.UserControlledData
  }
}
