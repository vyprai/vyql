import code.{RedirectTarget, StoredDataRead}
import core.{AuthenticationCheck, AuthorizationCheck}

adapter kotlin {
  package "org.springframework.social:spring-social-security" {
    control method "configure" -> core.AuthenticationCheck
    control method "configure" -> core.AuthorizationCheck

    source method "SocialUser" -> core.UserControlledData
    source method "SocialAuthenticationToken" -> core.UserControlledData

    flag code.RedirectTarget on any {
      method "postLoginUrl"
    }
    flag code.RedirectTarget on any {
      method "alwaysUsePostLoginUrl"
    }
    flag code.RedirectTarget on any {
      method "postFailureUrl"
    }
    flag code.RedirectTarget on any {
      method "signupUrl"
    }
    flag code.RedirectTarget on any {
      method "connectionAddedRedirectUrl"
    }
    flag code.RedirectTarget on any {
      method "defaultFailureUrl"
    }
    flag code.RedirectTarget on any {
      method "setSignupUrl"
    }
    flag code.RedirectTarget on any {
      method "setDefaultFailureUrl"
    }
    flag code.RedirectTarget on any {
      method "setConnectionAddedRedirectUrl"
    }
    flag code.RedirectTarget on any {
      method "setPostLoginUrl"
    }
    flag code.RedirectTarget on any {
      method "setPostFailureUrl"
    }
  }
}
