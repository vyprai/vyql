import code.{Deserialization, FilePathAccess}

adapter kotlin {
  package "org.codehaus.groovy:groovy-json" {
    sink method "parse" -> code.Deserialization
    sink method "parseText" -> code.Deserialization
    sink method "parseFile" -> code.FilePathAccess
    control method "unescape" -> core.InputValidation
  }
}
