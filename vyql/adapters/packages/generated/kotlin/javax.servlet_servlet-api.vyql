import code.{CliArgument, HttpInput, NetworkConnect, NetworkData, NetworkSend, RedirectTarget, ResponseHeaderWrite, StoredDataRead}
import core.{HtmlEscape, InputValidation, PathCanonicalization, SqlParameterization, UserControlledData}

adapter kotlin {
  package "javax.servlet:servlet-api" {

    source method "getParameter" -> code.HttpInput
    source method "getParameterValues" -> code.HttpInput
    source method "getParameterMap" -> code.HttpInput
    source method "getReader" -> code.HttpInput
    source method "getInputStream" -> code.HttpInput
    source method "getAttribute" -> code.HttpInput
    source method "getHeader" -> code.HttpInput
    source method "getHeaders" -> code.HttpInput
    source method "getHeaderNames" -> code.HttpInput
    source method "getCookies" -> code.HttpInput
    source method "getQueryString" -> code.HttpInput
    source method "getRequestURI" -> code.HttpInput
    source method "getRequestURL" -> code.HttpInput
    source method "getPathInfo" -> code.HttpInput
    source method "getServletPath" -> code.HttpInput

    source method "getName" -> code.HttpInput
    source method "getValue" -> code.HttpInput

    sink method "getWriter" -> code.HtmlRender
    sink method "getOutputStream" -> code.HtmlRender
    mark method "sendRedirect" -> code.RedirectTarget
    sink method "addHeader" -> code.ResponseHeaderWrite
    sink method "setHeader" -> code.ResponseHeaderWrite
    sink method "forward" -> code.FilePathAccess
    sink method "include" -> code.FilePathAccess

    control method "encodeURL" -> core.InputValidation
    control method "encodeRedirectURL" -> core.InputValidation
  }
}
