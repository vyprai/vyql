import code.{NetworkConnect, NetworkSend, Deserialization}
import core.{InputValidation}

adapter kotlin {
  package "org.eclipse.jetty:jetty-client" {
    sink method "send" -> code.NetworkSend
    sink method "connect" -> code.NetworkConnect
    sink method "parse" -> code.Deserialization
    control method "sanitize" -> core.InputValidation
  }
}
