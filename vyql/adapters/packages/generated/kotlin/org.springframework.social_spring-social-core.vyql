import core.{AuthorizationCheck}

adapter kotlin {
  package "org.springframework.social:spring-social-core" {
    source method "getSecret" -> code.SecretValue
    source method "getAccessToken" -> code.SecretValue
    source method "getRefreshToken" -> code.SecretValue
    source method "getAuthorizationHeaderValue" -> code.SecretValue
    control method "isAuthorized" -> core.AuthorizationCheck
    source method "queryParam" -> core.UserControlledData
    source method "queryParams" -> core.UserControlledData
  }
}
