import code.{NetworkData, NetworkSend}
adapter kotlin {
  package "io.netty:netty-buffer" {
    source method "read" -> code.NetworkData
    sink method "write" -> code.NetworkSend
    source method "readByte" -> code.NetworkData
    source method "readShort" -> code.NetworkData
    source method "readInt" -> code.NetworkData
    source method "readLong" -> code.NetworkData
    source method "getBytes" -> code.NetworkData
    sink method "setBytes" -> code.NetworkSend
  }
}
