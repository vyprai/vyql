import code.{SqlExecution}

adapter kotlin {
  package "org.mybatis:mybatis-spring" {
    sink method "selectOne" -> code.SqlExecution
    sink method "selectMap" -> code.SqlExecution
    sink method "selectCursor" -> code.SqlExecution
    sink method "selectList" -> code.SqlExecution
    sink method "select" -> code.SqlExecution
    sink method "insert" -> code.SqlExecution
    sink method "update" -> code.SqlExecution
    sink method "delete" -> code.SqlExecution
  }
}
