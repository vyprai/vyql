adapter kotlin {
  package "com.google.api-client:google-api-client" {
    sink method "parse" -> code.Deserialization
    sink method "load" -> code.Deserialization
    sink method "queue" -> code.NetworkSend
    sink method "execute" -> code.NetworkSend
    sink method "upload" -> code.NetworkSend
    sink method "directUpload" -> code.NetworkSend
    sink method "extractCertificateProviderCommand" -> code.CommandExecution
    sink method "runCertificateProviderCommand" -> code.CommandExecution
    source method "parseQuery" -> core.UserControlledData
  }
}
