import core.{UserControlledData}

adapter kotlin {
  package "org.apache.struts:struts2-core" {
    source method "withParameters" -> code.HttpInput
    source method "getParameters" -> code.HttpInput
    flag code.SessionId on any {
      method "withSession"
    }
    flag code.SessionId on any {
      method "getSession"
    }
    source method "withServletRequest" -> code.HttpInput
    source method "getServletRequest" -> code.HttpInput
    sink method "withServletResponse" -> code.ResponseHeaderWrite
    sink method "getServletResponse" -> code.ResponseHeaderWrite
  }
}
