import code.{SqlExecution}
import core.{InputValidation}

adapter kotlin {
  package "com.github.miemiedev:mybatis-paginator" {
    sink method "getPageSQL" -> code.SqlExecution
    sink method "getCountSQL" -> code.SqlExecution
    sink method "getLimitString" -> code.SqlExecution
    sink method "getCountString" -> code.SqlExecution
    sink method "getSortString" -> code.SqlExecution
    control method "isSQLInjection" -> core.InputValidation
  }
}
