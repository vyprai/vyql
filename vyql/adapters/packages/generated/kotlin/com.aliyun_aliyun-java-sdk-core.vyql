import code.{Deserialization, SecretValue}
import core.{UserControlledData}
adapter kotlin {
  package "com.aliyun:aliyun-java-sdk-core" {
    source method "getQueryParameters" -> core.UserControlledData
    source method "getBodyParameters" -> core.UserControlledData
    source method "getSecurityToken" -> code.SecretValue
    source method "putQueryParameter" -> core.UserControlledData
    source method "putBodyParameter" -> core.UserControlledData
    source method "putHeaderParameter" -> core.UserControlledData
    source method "setSecurityToken" -> code.SecretValue
    sink method "read" -> code.Deserialization
  }
}
