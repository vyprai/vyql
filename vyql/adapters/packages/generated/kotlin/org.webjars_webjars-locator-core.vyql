import code.{ArchiveEntryWrite, FilePathAccess}

adapter kotlin {
  package "org.webjars:webjars-locator-core" {
    sink method "extractWebJarTo" -> code.ArchiveEntryWrite
    sink method "extractAllWebJarsTo" -> code.ArchiveEntryWrite
    sink method "extractAllNodeModulesTo" -> code.ArchiveEntryWrite
    sink method "extractAllBowerComponentsTo" -> code.ArchiveEntryWrite
    sink method "extractWebJarsTo" -> code.ArchiveEntryWrite
    sink method "getFullPath" -> code.FilePathAccess
    sink method "getFullPathExact" -> code.FilePathAccess
    sink method "listAssets" -> code.FilePathAccess
  }
}
