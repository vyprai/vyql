import code.{Deserialization, HttpInput}
adapter kotlin {
  package "com.vaadin.external.google:android-json" {
    sink method "readObject" -> code.Deserialization
    sink method "readArray" -> code.Deserialization
    sink method "nextValue" -> code.Deserialization
    sink method "nextString" -> code.Deserialization
    sink method "next" -> code.Deserialization
    sink method "JSONArray" -> code.Deserialization
    sink method "JSONObject" -> code.Deserialization
  }
}
