import code.{FilePathAccess, UrlFetch}

adapter kotlin {
  package "net.coobird:thumbnailator" {
    sink method "fromFilenames" -> code.FilePathAccess
    sink method "fromFiles" -> code.FilePathAccess
    sink method "fromURLs" -> code.UrlFetch
    sink method "read" -> code.FilePathAccess
    sink method "write" -> code.FilePathAccess
  }
}
