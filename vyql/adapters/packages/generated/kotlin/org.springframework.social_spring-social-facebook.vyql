import code.{NetworkData, NetworkSend}
adapter kotlin {
  package "org.springframework.social:spring-social-facebook" {
    source method "fetchObject" -> code.NetworkData
    source method "fetchConnections" -> code.NetworkData
    source method "fetchImage" -> code.NetworkData
    sink method "publish" -> code.NetworkSend
    sink method "post" -> code.NetworkSend
    sink method "delete" -> code.NetworkSend
  }
}
