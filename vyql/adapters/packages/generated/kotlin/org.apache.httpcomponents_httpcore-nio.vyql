import code.{NetworkData, HttpInput, NetworkSend}
adapter kotlin {
  package "org.apache.httpcomponents:httpcore-nio" {
    source method "read" -> code.NetworkData
    source method "write" -> code.NetworkData
    source method "getHttpRequest" -> code.HttpInput
    sink method "getHttpResponse" -> code.NetworkSend
    source method "requestReceived" -> code.HttpInput
    sink method "responseReady" -> code.NetworkSend
    source method "inputReady" -> code.NetworkData
    source method "outputReady" -> code.NetworkData
  }
}
