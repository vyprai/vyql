import code.{RedirectTarget}
adapter kotlin {
  package "org.apache.shiro:shiro-spring" {
    flag code.RedirectTarget on any {
      method "setLoginUrl"
    }
    flag code.RedirectTarget on any {
      method "setSuccessUrl"
    }
    flag code.RedirectTarget on any {
      method "setUnauthorizedUrl"
    }
  }
}
