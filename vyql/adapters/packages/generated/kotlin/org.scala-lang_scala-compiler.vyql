import code.{CodeEval, CommandExecution, Deserialization, LogOutput}

adapter kotlin {
  package "org.scala-lang:scala-compiler" {
    sink method "parse" -> code.Deserialization
    sink method "run" -> code.CodeEval
    sink method "compile" -> code.CodeEval
    sink method "spawn" -> code.CommandExecution
    sink method "process" -> code.CommandExecution
    sink method "write" -> code.LogOutput
  }
}
