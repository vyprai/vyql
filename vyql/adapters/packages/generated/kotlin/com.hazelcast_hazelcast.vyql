import code.{Deserialization, SecretValue}
import core.{InputValidation}

adapter kotlin {
  package "com.hazelcast:hazelcast" {
    sink method "parse" -> code.Deserialization
    sink method "create" -> code.Deserialization
    source method "getSecretKey" -> code.SecretValue
    source method "setSecretKey" -> code.SecretValue
    source method "getToken" -> code.SecretValue
    source method "setToken" -> code.SecretValue
    control method "urlEncode" -> core.InputValidation
  }
}
