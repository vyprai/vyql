import code.{StoredDataRead, SecretValue}
import core.{UserControlledData, AuthenticationCheck}

adapter kotlin {
  package "com.firebaseui:firebase-ui-auth" {
    source method "query" -> code.StoredDataRead
    source method "setScopes" -> core.UserControlledData
    source method "setCustomParameters" -> core.UserControlledData
    source method "setCredentialManagerEnabled" -> core.UserControlledData
    source method "setLockOrientation" -> core.UserControlledData
    source method "setResetPasswordSettings" -> core.UserControlledData
    control method "AuthUI.Builder.build" -> core.AuthenticationCheck
  }
}
