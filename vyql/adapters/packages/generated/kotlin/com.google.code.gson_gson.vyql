import code.{Deserialization, FilePathAccess}

adapter kotlin {
  package "com.google.code.gson:gson" {
    sink method "read" -> code.Deserialization
    sink method "parse" -> code.Deserialization
    sink method "fromJson" -> code.Deserialization
    sink method "parseString" -> code.Deserialization
    sink method "parseReader" -> code.Deserialization
  }
}
