import code.{Cookie, SecretValue, StoredDataRead, StoredDataWrite}

adapter kotlin {
  package "org.springframework.session:spring-session-core" {
    source method "readCookieValues" -> code.Cookie
    source method "writeCookieValue" -> code.Cookie
    source method "createSession" -> code.SecretValue
    source method "findById" -> code.StoredDataRead
    sink method "save" -> code.StoredDataWrite
    sink method "setAttribute" -> code.StoredDataWrite
    source method "changeSessionId" -> code.SecretValue
  }
}
