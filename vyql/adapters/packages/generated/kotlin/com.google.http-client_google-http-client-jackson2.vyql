import code.{Deserialization}

adapter kotlin {
  package "com.google.http-client:google-http-client-jackson2" {
    sink method "createJsonParser" -> code.Deserialization
    sink method "nextToken" -> code.Deserialization
    sink method "getCurrentToken" -> code.Deserialization
    sink method "skipChildren" -> code.Deserialization
    sink method "getText" -> code.Deserialization
    sink method "getByteValue" -> code.Deserialization
    sink method "getFloatValue" -> code.Deserialization
    sink method "getIntValue" -> code.Deserialization
    sink method "getLongValue" -> code.Deserialization
    sink method "getShortValue" -> code.Deserialization
  }
}
