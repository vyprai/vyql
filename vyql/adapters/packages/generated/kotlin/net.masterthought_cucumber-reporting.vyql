import code.{Deserialization, FilePathAccess}
import core.{HtmlEscape, InputValidation}

adapter kotlin {
  package "net.masterthought:cucumber-reporting" {
    sink method "parseJsonFiles" -> code.Deserialization
    sink method "parseForFeature" -> code.Deserialization
    sink method "processClassificationFile" -> code.Deserialization
    sink method "Configuration" -> code.FilePathAccess
    control method "toValidFileName" -> core.InputValidation
    control method "escape" -> core.HtmlEscape
  }
}
