import code.{Cookie, FilePathAccess, SecretValue, UrlFetch}

adapter kotlin {
  package "org.glassfish.jersey.core:jersey-common" {
    source method "trustStorePassword" -> code.SecretValue
    source method "keyStorePassword" -> code.SecretValue
    source method "keyPassword" -> code.SecretValue
    sink method "trustStoreFile" -> code.FilePathAccess
    sink method "keyStoreFile" -> code.FilePathAccess
    sink method "trustStoreUrl" -> code.UrlFetch
    sink method "keyStoreUrl" -> code.UrlFetch
    source method "trustStoreBytes" -> code.SecretValue
    source method "keyStoreBytes" -> code.SecretValue
    sink method "parse" -> code.UrlFetch
    source method "getValueOf" -> code.Cookie
  }
}
