import code.{Deserialization, NetworkSend}
adapter kotlin {
  package "com.fasterxml.jackson.dataformat:jackson-dataformat-cbor" {
    sink method "CBORParser" -> code.Deserialization
    sink method "nextToken" -> code.Deserialization
    sink method "nextFieldName" -> code.Deserialization
    sink method "nextTextValue" -> code.Deserialization
    sink method "nextIntValue" -> code.Deserialization
    sink method "nextLongValue" -> code.Deserialization
    sink method "nextBooleanValue" -> code.Deserialization
    sink method "readBinaryValue" -> code.Deserialization

    sink method "writeFieldName" -> code.NetworkSend
    sink method "writeFieldId" -> code.NetworkSend
    sink method "writeStartArray" -> code.NetworkSend
    sink method "writeEndArray" -> code.NetworkSend
    sink method "writeStartObject" -> code.NetworkSend
    sink method "writeEndObject" -> code.NetworkSend
    sink method "writeArray" -> code.NetworkSend
    sink method "writeString" -> code.NetworkSend
    sink method "writeRawUTF8String" -> code.NetworkSend
    sink method "writeUTF8String" -> code.NetworkSend
    sink method "writeRaw" -> code.NetworkSend
    sink method "writeRawValue" -> code.NetworkSend
    sink method "writeNumber" -> code.NetworkSend
    sink method "writeBoolean" -> code.NetworkSend
    sink method "writeNull" -> code.NetworkSend
    sink method "writeBinary" -> code.NetworkSend
  }
}
