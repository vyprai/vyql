import code.{NetworkSend, NetworkConnect}
adapter kotlin {
  package "com.sun.jersey:jersey-client" {
    sink method "head" -> code.NetworkSend
    sink method "get" -> code.NetworkSend
    sink method "put" -> code.NetworkSend
    sink method "post" -> code.NetworkSend
    sink method "delete" -> code.NetworkSend
    sink method "handle" -> code.NetworkSend
    sink method "setReadTimeout" -> code.NetworkConnect
    sink method "setConnectTimeout" -> code.NetworkConnect
  }
}
