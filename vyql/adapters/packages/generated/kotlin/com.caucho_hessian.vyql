import code.{Deserialization}

adapter kotlin {
  package "com.caucho:hessian" {
    sink method "readObject" -> code.Deserialization
    sink method "readString" -> code.Deserialization
    sink method "readCall" -> code.Deserialization
    sink method "readMethod" -> code.Deserialization
    sink method "readReply" -> code.Deserialization
    sink method "startReply" -> code.Deserialization
  }
}
