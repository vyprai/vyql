adapter kotlin {
  package "org.hibernate:hibernate-validator" {
    sink method "hash" -> code.SqlExecution
    control method "prepareValidatedExecutableTypes" -> core.SqlParameterization
    control method "normalize" -> core.InputValidation
    flag code.WeakHash on any {
      method "hash"
    }
    flag code.RegexCompile on any {
      method "regexp"
    }
  }
}
