import code.{HttpInput, NetworkConnect, NetworkSend, UrlFetch}

adapter kotlin {
  package "org.jboss.resteasy:resteasy-client" {
    sink method "createClientInvocation" -> code.UrlFetch
    sink method "invoke" -> code.NetworkConnect
    sink method "invoke" -> code.NetworkSend
    source method "readFrom" -> code.HttpInput
  }
}
