import code.{CommandExecution, Deserialization, NetworkSend, CodeEval, NetworkData, FilePathAccess}

adapter kotlin {
  package "org.seleniumhq.selenium:selenium-remote-driver" {
    sink method "send" -> code.NetworkSend
    sink method "execute" -> code.CodeEval
    sink method "fromJson" -> code.Deserialization
    source method "addRequestHandler" -> code.NetworkData
  }
}
