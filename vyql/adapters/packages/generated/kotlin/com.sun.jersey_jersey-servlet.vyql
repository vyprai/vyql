import code.{HttpInput, HtmlRender, ResponseHeaderWrite}
import core.{UserControlledData}

adapter kotlin {
  package "com.sun.jersey:jersey-servlet" {
    source method "service" -> code.HttpInput
    source method "filterFormParameters" -> core.UserControlledData
    source method "createRequest" -> code.HttpInput
    source method "onHeader" -> code.HttpInput
    sink method "write" -> code.HtmlRender
    sink method "writeStatusAndHeaders" -> code.ResponseHeaderWrite
    sink method "writeHeaders" -> code.ResponseHeaderWrite
    sink method "writeStatus" -> code.ResponseHeaderWrite
  }
}
