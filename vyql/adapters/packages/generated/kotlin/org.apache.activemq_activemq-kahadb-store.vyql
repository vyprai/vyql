import code.{StoredDataRead, StoredDataWrite}

adapter kotlin {
  package "org.apache.activemq:activemq-kahadb-store" {
    sink method "addMessage" -> code.StoredDataWrite
    sink method "removeMessage" -> code.StoredDataWrite
    source method "recover" -> code.StoredDataRead
    source method "recoverNextMessages" -> code.StoredDataRead
  }
}
