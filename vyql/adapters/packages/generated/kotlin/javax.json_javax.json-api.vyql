import code.{Deserialization}
adapter kotlin {
  package "javax.json:javax.json-api" {
    sink method "read" -> code.Deserialization
    sink method "readObject" -> code.Deserialization
    sink method "readArray" -> code.Deserialization
    sink method "readValue" -> code.Deserialization
    sink method "getArray" -> code.Deserialization
    sink method "getObject" -> code.Deserialization
    sink method "getValue" -> code.Deserialization
    sink method "apply" -> code.Deserialization
    sink method "replace" -> code.Deserialization
    sink method "add" -> code.Deserialization
    sink method "remove" -> code.Deserialization
  }
}
