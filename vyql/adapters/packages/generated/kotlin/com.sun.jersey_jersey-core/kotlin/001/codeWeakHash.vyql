module bindings.kotlin.migration.meafcdfaf;

binding weakHash1 {
  requires {
    dependency("com.sun.jersey:jersey-core")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "com.sun.jersey.jersey.core.hash"
  emit issue code.WeakHash at node
}
