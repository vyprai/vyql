import code.{HttpInput, Deserialization}
adapter kotlin {
  package "org.eclipse.jetty:jetty-http" {
    sink method "parse" -> code.Deserialization
    source method "query" -> code.HttpInput
    source method "getPath" -> code.HttpInput
    source method "getPathQuery" -> code.HttpInput
    source method "getQuery" -> code.HttpInput
    source method "getDecodedPath" -> code.HttpInput
  }
}
