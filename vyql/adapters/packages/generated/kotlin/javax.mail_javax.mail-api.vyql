import code.{Deserialization, NetworkSend, FilePathAccess, ResponseHeaderWrite}
import core.{UserControlledData}

adapter kotlin {
  package "javax.mail:javax.mail-api" {
    sink method "parse" -> code.Deserialization
    sink method "send" -> code.NetworkSend
    sink method "setFileName" -> code.FilePathAccess
    sink method "writeTo" -> code.FilePathAccess
    sink method "setHeader" -> code.ResponseHeaderWrite
    sink method "addHeader" -> code.ResponseHeaderWrite
    source method "read" -> core.UserControlledData
    source method "getHeader" -> core.UserControlledData
    source method "getAllHeaders" -> core.UserControlledData
    source method "getMatchingHeaders" -> core.UserControlledData
    source method "getNonMatchingHeaders" -> core.UserControlledData
  }
}
