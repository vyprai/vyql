import code.{CodeEval, NetworkConnect, Deserialization, UrlFetch}

adapter kotlin {
  package "org.jboss.arquillian.protocol:arquillian-protocol-servlet" {
    sink method "invoke" -> code.CodeEval
    sink method "execute" -> code.NetworkConnect
    sink method "execute" -> code.UrlFetch
    sink method "execute" -> code.Deserialization
  }
}
