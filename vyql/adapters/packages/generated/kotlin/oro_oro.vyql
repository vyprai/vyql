import code.{RegexCompile}
import core.{UserControlledData}

adapter kotlin {
  package "oro:oro" {
    flag code.RegexCompile on any {
      method "compile"
    }
    source method "match" -> core.UserControlledData
    source method "contains" -> core.UserControlledData
    flag code.RegexCompile on any {
      method "substitute"
    }
  }
}
