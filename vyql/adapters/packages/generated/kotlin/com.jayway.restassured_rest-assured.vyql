import code.{Deserialization, XmlParse}
import core.{InputValidation}

adapter kotlin {
  package "com.jayway.restassured:rest-assured" {
    sink method "parse" -> code.Deserialization
    sink method "validate" -> code.XmlParse
    control method "disableLoadingOfExternalDtd" -> core.InputValidation
  }
}
