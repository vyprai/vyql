module bindings.kotlin.migration.m089379ee;

binding sessionId2 {
  requires {
    dependency("org.apache.struts:struts2-core")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "withSession"
  emit issue code.SessionId at node
  emit sink code.SessionIdSink at node
}
