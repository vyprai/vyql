import core.{AuthenticationCheck, AuthorizationCheck}

adapter kotlin {
  package "org.springframework.security:spring-security-data" {
    control method "setPermissionEvaluator" -> core.AuthorizationCheck
    control method "getAuthentication" -> core.AuthenticationCheck
    control method "setTrustResolver" -> core.AuthenticationCheck
    control method "setRoleHierarchy" -> core.AuthorizationCheck
  }
}
