import code.{Deserialization, HtmlRender}
import core.{HtmlEscape}

adapter kotlin {
  package "com.samskivert:jmustache" {
    sink method "compile" -> code.Deserialization
    sink method "parse" -> code.Deserialization
    sink method "write" -> code.HtmlRender
    control method "escape" -> core.HtmlEscape
    control method "simple" -> core.HtmlEscape
  }
}
