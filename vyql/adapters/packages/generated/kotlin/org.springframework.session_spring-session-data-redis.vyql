import code.{StoredDataRead, StoredDataWrite}

adapter kotlin {
  package "org.springframework.session:spring-session-data-redis" {
    source method "createSession" -> code.StoredDataRead
    source method "findById" -> code.StoredDataRead
    source method "getAttribute" -> code.StoredDataRead
    sink method "save" -> code.StoredDataWrite
    sink method "setAttribute" -> code.StoredDataWrite
  }
}
