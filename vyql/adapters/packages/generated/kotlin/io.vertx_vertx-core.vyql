import code.{FileUse, FilePathAccess, StoredDataRead}
import core.{UserControlledData}

adapter kotlin {
  package "io.vertx:vertx-core" {
    source method "send" -> core.UserControlledData
    source method "addAll" -> core.UserControlledData
    source method "setAll" -> core.UserControlledData
    sink method "write" -> code.FileUse
    source method "read" -> code.StoredDataRead
    sink method "open" -> code.FilePathAccess
  }
}
