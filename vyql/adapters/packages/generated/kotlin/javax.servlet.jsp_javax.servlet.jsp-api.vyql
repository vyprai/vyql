import code.{HttpInput, ExpressionEval, SessionId}
import core.{InputValidation, UserControlledData}

adapter kotlin {
  package "javax.servlet.jsp:javax.servlet.jsp-api" {
    control method "validate" -> core.InputValidation
    source method "getRequestURI" -> core.UserControlledData
    source method "getRequest" -> code.HttpInput
    flag code.SessionId on any {
      method "getSession"
    }
    sink method "getExpressionEvaluator" -> code.ExpressionEval
  }
}
