import code.{Deserialization, NetworkData}

adapter kotlin {
  package "net.sf.supercsv:super-csv" {
    source method "read" -> code.NetworkData
    source method "readColumns" -> code.NetworkData

    sink method "ParseBigDecimal" -> code.Deserialization
    sink method "ParseBool" -> code.Deserialization
    sink method "ParseChar" -> code.Deserialization
    sink method "ParseDate" -> code.Deserialization
    sink method "ParseDouble" -> code.Deserialization
    sink method "ParseEnum" -> code.Deserialization
    sink method "ParseInt" -> code.Deserialization
    sink method "ParseLong" -> code.Deserialization
  }
}
