adapter kotlin {
  package "jdom:jdom" {
    sink method "build(org.w3c.dom.Document)" -> code.Deserialization
    sink method "build(org.xml.sax.InputSource)" -> code.Deserialization
    sink method "build(java.io.InputStream)" -> code.Deserialization
    sink method "build(java.io.File)" -> code.Deserialization
    sink method "build(java.net.URL)" -> code.Deserialization
    sink method "build(java.io.Reader)" -> code.Deserialization
    sink method "build(java.lang.String)" -> code.Deserialization
  }
}
