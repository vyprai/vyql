import code.{UrlFetch, FilePathAccess, RedirectTarget}
adapter kotlin {
  package "com.lowagie:itext" {
    sink method "Jpeg.<init>(java.net.URL)" -> code.UrlFetch
    sink method "Image.<init>(java.net.URL)" -> code.UrlFetch
    sink method "Image.getInstance(java.net.URL)" -> code.UrlFetch
    flag code.RedirectTarget on any {
      method "Chunk.setRemoteGoto"
    }
    flag code.RedirectTarget on any {
      method "Chunk.setAnchor"
    }
    sink method "DocWriter.write" -> code.FilePathAccess
  }
}
