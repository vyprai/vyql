import code.{LogOutput}
import core.{UserControlledData}

adapter kotlin {
  package "com.amazonaws:aws-lambda-java-core" {
    source method "handleRequest" -> core.UserControlledData
    source method "getAwsRequestId" -> core.UserControlledData
    source method "getLogGroupName" -> core.UserControlledData
    source method "getLogStreamName" -> core.UserControlledData
    source method "getFunctionName" -> core.UserControlledData
    source method "getFunctionVersion" -> core.UserControlledData
    source method "getInvokedFunctionArn" -> core.UserControlledData
    source method "getIdentity" -> core.UserControlledData
    source method "getClientContext" -> core.UserControlledData
    source method "getXrayTraceId" -> core.UserControlledData
    source method "getTenantId" -> core.UserControlledData
    sink method "log" -> code.LogOutput
  }
}
