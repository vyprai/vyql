import code.{NosqlQuery, StoredDataWrite}

adapter perl {
  package "Meerkat" {
    sink method "create" -> code.StoredDataWrite
    sink method "find_id" -> code.NosqlQuery
    sink method "find_one" -> code.NosqlQuery
    sink method "find" -> code.NosqlQuery
    sink method "remove" -> code.StoredDataWrite
    sink method "reinsert" -> code.StoredDataWrite
  }
}
