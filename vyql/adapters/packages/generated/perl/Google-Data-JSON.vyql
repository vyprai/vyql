import code.{Deserialization, FilePathAccess}

adapter perl {
  package "Google-Data-JSON" {
    sink method "new" -> code.Deserialization
    sink method "new" -> code.FilePathAccess
    sink method "gdata" -> code.Deserialization
    sink method "gdata" -> code.FilePathAccess
    sink method "xml_to_hash" -> code.Deserialization
    sink method "xml_to_json" -> code.Deserialization
    sink method "json_to_hash" -> code.Deserialization
    sink method "json_to_xml" -> code.Deserialization
  }
}
