import code.{CommandExecution, Deserialization, FilePathAccess, HttpInput, StoredDataRead}
import core.{UserControlledData}

adapter perl {
  package "OrePAN2" {
    source method "inject_from_file" -> core.UserControlledData
    source method "inject_from_http" -> code.HttpInput
    sink method "_run" -> code.CommandExecution
    sink method "_modules_from_parser" -> code.Deserialization
    sink method "_parser_for_url" -> code.Deserialization
    sink method "list_archive_files" -> code.FilePathAccess
    source method "load" -> code.StoredDataRead
  }
}
