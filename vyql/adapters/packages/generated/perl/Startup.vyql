import code.{FileUse, FilePathAccess}
import core.{InputValidation, PathCanonicalization}

adapter perl {
  package "Startup" {
    sink method "open_log" -> code.FileUse
    sink method "log_path" -> code.FileUse
    sink method "_mkpath" -> code.FilePathAccess
    control method "_realpath" -> core.PathCanonicalization
  }
}
