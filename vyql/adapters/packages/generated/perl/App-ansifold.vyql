import core.{UserControlledData}
adapter perl {
  package "App-ansifold" {
    source method "ansifold" -> core.UserControlledData
    source method "ansiexpand" -> core.UserControlledData
    source method "ansicolrm" -> core.UserControlledData
    source method "ansicut" -> core.UserControlledData
    source method "options" -> core.UserControlledData
    source method "params" -> core.UserControlledData
    source method "perform" -> core.UserControlledData
    source method "doit" -> core.UserControlledData
  }
}
