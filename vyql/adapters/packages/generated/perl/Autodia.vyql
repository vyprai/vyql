import code.{Deserialization, FilePathAccess, CodeEval}
import core.{HtmlEscape}

adapter perl {
  package "Autodia" {
    sink method "add_inputfile" -> code.FilePathAccess
    sink method "_parse" -> code.Deserialization
    sink method "_parse_file" -> code.Deserialization
    control method "xml_escape" -> core.HtmlEscape
  }
}
