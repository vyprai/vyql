import code.{CommandExecution}
import core.{UserControlledData}

adapter perl {
  package "Make" {
    sink method "exec" -> code.CommandExecution
    sink method "shell" -> code.CommandExecution
    source method "parse" -> core.UserControlledData
    source method "parse_makefile" -> core.UserControlledData
    source method "parse_cmdline" -> core.UserControlledData
    source method "parse_args" -> core.UserControlledData
    source method "tokenize" -> core.UserControlledData
    source method "evaluate_macro" -> core.UserControlledData
  }
}
