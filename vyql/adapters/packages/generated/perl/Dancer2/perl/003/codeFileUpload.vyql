module bindings.perl.migration.mc8fb1e7e;

binding fileUpload3 {
  requires {
    dependency("Dancer2")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "uploads"
  emit issue code.FileUpload at node
  emit source code.FileUploadSource at node
}
