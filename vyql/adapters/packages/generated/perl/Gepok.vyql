import code.{HttpInput, FilePathAccess, NetworkSend, CommandExecution, SecretValue}

adapter perl {
  package "Gepok" {
    source method "_prepare_env" -> code.HttpInput
    sink method "_write_sock" -> code.NetworkSend
    sink method "run" -> code.CommandExecution
    sink method "pid_path" -> code.FilePathAccess
    sink method "scoreboard_path" -> code.FilePathAccess
    sink method "error_log_path" -> code.FilePathAccess
    sink method "access_log_path" -> code.FilePathAccess
    source method "ssl_key_file" -> code.SecretValue
    source method "ssl_cert_file" -> code.SecretValue
    source method "ssl_ca_file" -> code.SecretValue
    source method "ssl_ca_path" -> code.SecretValue
  }
}
