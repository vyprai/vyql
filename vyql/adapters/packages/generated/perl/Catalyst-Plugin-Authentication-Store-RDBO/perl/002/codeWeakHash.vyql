module bindings.perl.migration.mb1af140d;

binding weakHash2 {
  requires {
    dependency("Catalyst-Plugin-Authentication-Store-RDBO")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "hash_algorithm"
  emit issue code.WeakHash at node
}
