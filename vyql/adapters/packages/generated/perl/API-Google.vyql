import code.{UrlFetch, SecretValue}

adapter perl {
  package "API-Google" {
    sink method "api_query" -> code.UrlFetch
    sink method "refresh_access_token" -> code.UrlFetch
    source method "client_id" -> code.SecretValue
    source method "client_secret" -> code.SecretValue
    source method "get_refresh_token_from_storage" -> code.SecretValue
    source method "get_access_token_from_storage" -> code.SecretValue
    source method "set_access_token_to_storage" -> code.SecretValue
  }
}
