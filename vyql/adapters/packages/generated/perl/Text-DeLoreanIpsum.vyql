import code.{WeakRandomValue}
adapter perl {
  package "Text-DeLoreanIpsum" {
    flag code.WeakRandomValue on any {
      method "get_character"
    }
    flag code.WeakRandomValue on any {
      method "get_word"
    }
    flag code.WeakRandomValue on any {
      method "get_sentence"
    }
    flag code.WeakRandomValue on any {
      method "get_paragraph"
    }
  }
}
