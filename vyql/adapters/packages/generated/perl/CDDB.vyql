import code.{NetworkConnect, NetworkSend, NetworkData, Deserialization}
adapter perl {
  package "CDDB" {
    sink method "connect" -> code.NetworkConnect
    sink method "command" -> code.NetworkSend
    source method "getline" -> code.NetworkData
    sink method "parse_cdinfo" -> code.Deserialization
    sink method "parse_xmcd_file" -> code.Deserialization
    sink method "get_discs_by_query" -> code.NetworkSend
    sink method "submit_disc" -> code.NetworkSend
  }
}
