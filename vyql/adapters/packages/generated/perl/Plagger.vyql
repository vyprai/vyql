import code.{CommandExecution, Deserialization}

adapter perl {
  package "Plagger" {
    sink method "system" -> code.CommandExecution
    sink method "spawn" -> code.CommandExecution
    sink method "load" -> code.Deserialization
    sink method "Load" -> code.Deserialization
    sink method "LoadFile" -> code.Deserialization
    sink method "parse" -> code.Deserialization
    sink method "parse_arguments" -> code.Deserialization
  }
}
