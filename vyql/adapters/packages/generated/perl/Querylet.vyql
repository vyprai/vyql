adapter perl {
  package "Querylet" {
    sink method "set_query" -> code.SqlExecution
    sink method "set_dbh" -> code.SqlExecution
    sink method "set_output_filename" -> code.FilePathAccess
    source method "input" -> core.UserControlledData
    source method "set_input_type" -> core.UserControlledData
    control method "bind_next_param" -> core.SqlParameterization
  }
}
