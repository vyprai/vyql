import code.{Deserialization, NetworkData}

adapter perl {
  package "Thrift" {
    sink method "readMessageBegin" -> code.Deserialization
    sink method "readMessageEnd" -> code.Deserialization
    sink method "readStructBegin" -> code.Deserialization
    sink method "readStructEnd" -> code.Deserialization
    sink method "readFieldBegin" -> code.Deserialization
    sink method "readFieldEnd" -> code.Deserialization
    sink method "readMapBegin" -> code.Deserialization
    sink method "readListBegin" -> code.Deserialization
    sink method "readSetBegin" -> code.Deserialization
    sink method "readBool" -> code.Deserialization
    sink method "readByte" -> code.Deserialization
    sink method "readI16" -> code.Deserialization
    sink method "readI32" -> code.Deserialization
    sink method "readI64" -> code.Deserialization
    sink method "readDouble" -> code.Deserialization
    sink method "readString" -> code.Deserialization

    source method "__recv" -> code.NetworkData
    source method "__send" -> code.NetworkData

    source method "writeMessageBegin" -> code.NetworkData
    source method "writeMessageEnd" -> code.NetworkData
    source method "writeStructBegin" -> code.NetworkData
    source method "writeStructEnd" -> code.NetworkData
    source method "writeFieldBegin" -> code.NetworkData
    source method "writeFieldEnd" -> code.NetworkData
    source method "writeFieldStop" -> code.NetworkData
    source method "writeMapBegin" -> code.NetworkData
    source method "writeListBegin" -> code.NetworkData
    source method "writeSetBegin" -> code.NetworkData
    source method "writeBool" -> code.NetworkData
    source method "writeByte" -> code.NetworkData
    source method "writeI16" -> code.NetworkData
    source method "writeI32" -> code.NetworkData
    source method "writeI64" -> code.NetworkData
    source method "writeDouble" -> code.NetworkData
    source method "writeString" -> code.NetworkData

    source method "send_addValue" -> code.NetworkData
    source method "recv_addValue" -> code.NetworkData
    source method "send_getValues" -> code.NetworkData
    source method "recv_getValues" -> code.NetworkData

    source method "readAll" -> code.NetworkData

  }
}
