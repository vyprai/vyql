import code.{CommandExecution, FilePathAccess}
import core.{InputValidation, ShellEscape}

adapter perl {
  package "Sjis" {
    control method "Sjis::escape_script" -> core.InputValidation
    control method "_escapeshellcmd_MSWin32" -> core.ShellEscape
    control method "_escapeshellcmd_MacOS" -> core.ShellEscape
    control method "_escapeshellcmd" -> core.ShellEscape
    sink method "_systemx" -> code.CommandExecution
    sink method "_open_r" -> code.FilePathAccess
  }
}
