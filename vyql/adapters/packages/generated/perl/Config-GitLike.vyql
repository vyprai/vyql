import code.{FilePathAccess, Deserialization}
adapter perl {
  package "Config-GitLike" {
    sink method "load_dirs" -> code.FilePathAccess
    sink method "load_global" -> code.FilePathAccess
    sink method "load_user" -> code.FilePathAccess
    sink method "load_file" -> code.FilePathAccess
    sink method "parse_content" -> code.Deserialization
    sink method "_write_config" -> code.FilePathAccess
  }
}
