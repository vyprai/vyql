import code.{CommandExecution, FilePathAccess, NetworkConnect}
import core.{InputValidation, UserControlledData}

adapter perl {
  package "CGI-Safe" {
    control method "new" -> core.InputValidation
    control method "set" -> core.InputValidation
    source method "get_path" -> core.UserControlledData
    source method "get_shell" -> core.UserControlledData
  }
}
