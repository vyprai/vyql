import code.{CommandExecution}

adapter perl {
  package "Git" {
    sink method "command" -> code.CommandExecution
    sink method "command_oneline" -> code.CommandExecution
    sink method "command_output_pipe" -> code.CommandExecution
    sink method "command_input_pipe" -> code.CommandExecution
    sink method "command_close_pipe" -> code.CommandExecution
    sink method "command_bidi_pipe" -> code.CommandExecution
    sink method "command_close_bidi_pipe" -> code.CommandExecution
    sink method "command_noisy" -> code.CommandExecution
  }
}
