import code.{Cookie}
import core.{InputValidation}

adapter perl {
  package "Starch" {
    control method "cookie_secure" -> core.InputValidation
    control method "cookie_http_only" -> core.InputValidation
    source method "cookie_args" -> code.Cookie
    source method "cookie_set_args" -> code.Cookie
    source method "cookie_delete_args" -> code.Cookie
  }
}
