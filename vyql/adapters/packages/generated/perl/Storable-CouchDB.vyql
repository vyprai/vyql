import code.{NosqlQuery, NetworkConnect, StoredDataRead, StoredDataWrite}
import core.{UserControlledData}

adapter perl {
  package "Storable-CouchDB" {
    sink method "store" -> code.NosqlQuery
    sink method "retrieve" -> code.NosqlQuery
    sink method "delete" -> code.NosqlQuery
    sink method "new" -> code.NetworkConnect
    source method "new" -> core.UserControlledData
  }
}
