module bindings.perl.migration.mc570794f;

binding weakHash1 {
  requires {
    dependency("Nitesi")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "Nitesi::Account::Password::password"
  emit issue code.WeakHash at node
}
