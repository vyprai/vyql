import code.{DatabaseRead, SqlExecution}

adapter perl {
  package "MendeleySQLite" {
    sink method "_execute_sql" -> code.SqlExecution
    sink method "get_all_keywords" -> code.DatabaseRead
    sink method "get_all_tags" -> code.DatabaseRead
    sink method "get_all_tags_for_document" -> code.DatabaseRead
    sink method "get_all_keywords_for_document" -> code.DatabaseRead
    sink method "get_document" -> code.DatabaseRead
    sink method "get_all_document_ids" -> code.DatabaseRead
    sink method "set_keyword_for_document" -> code.SqlExecution
    sink method "set_tag_for_document" -> code.SqlExecution
  }
}
