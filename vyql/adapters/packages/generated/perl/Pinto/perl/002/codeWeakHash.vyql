module bindings.perl.migration.m979e51fd;

binding weakHash2 {
  requires {
    dependency("Pinto")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "pinto.hash"
  emit issue code.WeakHash at node
}
