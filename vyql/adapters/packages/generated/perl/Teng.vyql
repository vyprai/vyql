import code.{SqlExecution}
adapter perl {
  package "Teng" {
    sink method "connect" -> code.SqlExecution
    sink method "execute" -> code.SqlExecution
    sink method "search" -> code.SqlExecution
    sink method "search_named" -> code.SqlExecution
    sink method "search_by_sql" -> code.SqlExecution
    sink method "single_by_sql" -> code.SqlExecution
    sink method "replace" -> code.SqlExecution
  }
}
