import code.{Deserialization}

adapter perl {
  package "URPM" {
    sink method "parse_synthesis" -> code.Deserialization
    sink method "parse_hdlist" -> code.Deserialization
    sink method "parse_rpms_build_headers" -> code.Deserialization
    sink method "parse_headers" -> code.Deserialization
    sink method "parse_pubkeys" -> code.Deserialization
  }
}
