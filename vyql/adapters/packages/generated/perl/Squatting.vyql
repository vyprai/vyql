import code.{HttpInput, RedirectTarget, ResponseHeaderWrite, TemplateRender}

adapter perl {
  package "Squatting" {
    source method "service" -> code.HttpInput
    mark method "redirect" -> code.RedirectTarget
    sink method "render" -> code.TemplateRender
    sink method "headers" -> code.ResponseHeaderWrite
    sink method "AUTOLOAD" -> code.TemplateRender
  }
}
