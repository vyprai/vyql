import code.{FilePathAccess}

adapter perl {
  package "Data-RecordStore" {
    sink method "open_store" -> code.FilePathAccess
    sink method "reopen_store" -> code.FilePathAccess
    sink method "lock" -> code.FilePathAccess
    sink method "unlock" -> code.FilePathAccess
    sink method "_make_path" -> code.FilePathAccess
  }
  package "Data-RecordStore::Silo" {
    sink method "syswrite" -> code.FilePathAccess
    sink method "open_silo" -> code.FilePathAccess
    sink method "reopen_silo" -> code.FilePathAccess
  }
}
