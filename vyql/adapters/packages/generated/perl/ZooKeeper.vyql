import code.{FilePathAccess, StoredDataWrite}
adapter perl {
  package "ZooKeeper" {
    sink method "create" -> code.FilePathAccess
    sink method "create" -> code.StoredDataWrite
    sink method "set" -> code.StoredDataWrite
    sink method "delete" -> code.FilePathAccess
    sink method "get_children" -> code.FilePathAccess
    sink method "watcher" -> code.FilePathAccess
  }
}
