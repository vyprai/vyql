import code.{NetworkData, NetworkConnect, NetworkSend, Deserialization}
adapter perl {
  package "ZeroMQ" {
    source method "recv" -> code.NetworkData
    source method "zmq_recv" -> code.NetworkData
    sink method "send" -> code.NetworkSend
    sink method "zmq_send" -> code.NetworkSend
    sink method "zmq_bind" -> code.NetworkConnect
    sink method "zmq_connect" -> code.NetworkConnect
    sink method "register_read_type" -> code.Deserialization
  }
}
