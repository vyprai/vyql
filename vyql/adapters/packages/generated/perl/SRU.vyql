import code.{HttpInput, XmlParse}
import core.{HtmlEscape}
adapter perl {
  package "SRU" {
    source method "SRU::Request.newFromCGI" -> code.HttpInput
    control method "SRU::Utils::XML.escape" -> core.HtmlEscape
    sink method "SRU::Utils::XML.element" -> code.XmlParse
    sink method "SRU::Utils::XML.elementNoEscape" -> code.XmlParse
  }
}
