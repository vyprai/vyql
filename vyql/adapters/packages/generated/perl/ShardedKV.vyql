import code.{SqlExecution}

adapter perl {
  package "ShardedKV" {
    sink method "prepare_table" -> code.SqlExecution
    sink method "_run_sql" -> code.SqlExecution
    sink method "_make_get_query" -> code.SqlExecution
    sink method "_make_set_query" -> code.SqlExecution
    sink method "_make_delete_query" -> code.SqlExecution
  }
}
