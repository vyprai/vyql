import code.{FilePathAccess}
import core.{HtmlEscape, InputValidation}

adapter perl {
  package "String-Util" {
    control method "htmlesc" -> core.HtmlEscape
    control method "jsquote" -> core.InputValidation
    control method "sanitize" -> core.InputValidation
    sink method "file_get_contents" -> code.FilePathAccess
  }
}
