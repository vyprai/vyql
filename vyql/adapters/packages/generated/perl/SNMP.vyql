import code.{NetworkData, NetworkConnect}
adapter perl {
  package "SNMP" {
    source method "snmp_get" -> code.NetworkData
    sink method "snmp_get" -> code.NetworkConnect
    source method "snmp_getnext" -> code.NetworkData
    sink method "snmp_getnext" -> code.NetworkConnect
    source method "snmp_set" -> code.NetworkData
    sink method "snmp_set" -> code.NetworkConnect
    source method "snmp_trap" -> code.NetworkData
    sink method "snmp_trap" -> code.NetworkConnect
  }
}
