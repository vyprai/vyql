import code.{SqlExecution}
adapter perl {
  package "Otogiri" {
    sink method "search_by_sql" -> code.SqlExecution
    sink method "single" -> code.SqlExecution
    sink method "fast_insert" -> code.SqlExecution
    sink method "delete" -> code.SqlExecution
    sink method "update" -> code.SqlExecution
    sink method "do" -> code.SqlExecution
  }
}
