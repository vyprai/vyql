import code.{Deserialization, HttpInput}
adapter perl {
  package "OpenFrame" {
    sink method "req2cookie_tin" -> code.Deserialization
    sink method "params2hash" -> code.Deserialization
    sink method "parse_multipart_data" -> code.Deserialization
    source method "cookies" -> code.HttpInput
    source method "get" -> code.HttpInput
  }
}
