import code.{Deserialization, XmlParse}
import core.{HtmlEscape}

adapter perl {
  package "DAIA" {
    sink method "parse" -> code.Deserialization
    sink method "parse_xml" -> code.XmlParse
    sink method "parse_json" -> code.Deserialization
    control method "xml_escape_value" -> core.HtmlEscape
  }
}
