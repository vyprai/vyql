import code.{CommandExecution, CodeEval, Deserialization, FilePathAccess}
import core.{UserControlledData}

adapter perl {
  package "CSS" {
    sink method "read_file" -> code.FilePathAccess
    source method "read_string" -> core.UserControlledData
    sink method "parse_string" -> code.Deserialization
    sink method "parse_string" -> code.CodeEval
  }
}
