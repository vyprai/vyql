import code.{Deserialization}
adapter perl {
  package "Kwalify" {
    sink method "validate" -> code.Deserialization
    sink method "validate_text" -> code.Deserialization
    sink method "validate_str" -> code.Deserialization
    sink method "validate_int" -> code.Deserialization
    sink method "validate_float" -> code.Deserialization
    sink method "validate_number" -> code.Deserialization
    sink method "validate_bool" -> code.Deserialization
    sink method "validate_scalar" -> code.Deserialization
    sink method "validate_date" -> code.Deserialization
    sink method "validate_time" -> code.Deserialization
    sink method "validate_timestamp" -> code.Deserialization
    sink method "validate_any" -> code.Deserialization
    sink method "validate_seq" -> code.Deserialization
    sink method "validate_map" -> code.Deserialization
  }
}
