import code.{CliArgument, NetworkConnect, NetworkSend, SecretValue}
adapter perl {
  package "WWW-Formspring" {
    source method "profile_ask" -> code.CliArgument
    source method "get_request_token" -> code.CliArgument
    source method "get_access_token" -> code.CliArgument
    source method "inbox_block" -> code.CliArgument
    source method "inbox_random" -> code.CliArgument
    source method "profile_details" -> code.CliArgument
    source method "search_profiles" -> code.CliArgument
    sink method "_unauth_connect" -> code.NetworkConnect
    sink method "_auth_connect" -> code.NetworkConnect
    sink method "_unauth_connect" -> code.NetworkSend
    sink method "_auth_connect" -> code.NetworkSend
    sink method "profile_ask" -> code.NetworkSend
    sink method "get_request_token" -> code.NetworkSend
    sink method "get_access_token" -> code.NetworkSend
    sink method "inbox_block" -> code.NetworkSend
    sink method "inbox_random" -> code.NetworkSend
    sink method "profile_details" -> code.NetworkSend
    sink method "search_profiles" -> code.NetworkSend
  }
}
