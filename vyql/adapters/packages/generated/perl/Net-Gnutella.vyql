import code.{Deserialization, NetworkSend}

adapter perl {
  package "Net-Gnutella" {
    sink method "parse" -> code.Deserialization
    sink method "send_error" -> code.NetworkSend
    sink method "send_file" -> code.NetworkSend
    sink method "send_packet" -> code.NetworkSend
    sink method "send_page" -> code.NetworkSend
  }
}
