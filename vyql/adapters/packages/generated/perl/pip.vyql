import code.{ArchiveEntryWrite, CommandExecution, FilePathAccess, UrlFetch}
adapter perl {
  package "pip" {
    sink method "read_archive" -> code.ArchiveEntryWrite
    sink method "run" -> code.CommandExecution
    sink method "fetch_any" -> code.UrlFetch
    sink method "read_any" -> code.FilePathAccess
    sink method "read_p5i" -> code.FilePathAccess
    sink method "read_p5z" -> code.FilePathAccess
  }
}
