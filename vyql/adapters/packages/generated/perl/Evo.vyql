import code.{FilePathAccess, FileUse}
adapter perl {
  package "Evo" {
    sink method "mkdir" -> code.FilePathAccess
    sink method "symlink" -> code.FilePathAccess
    sink method "link" -> code.FilePathAccess
    sink method "utimes" -> code.FilePathAccess
    sink method "stat" -> code.FilePathAccess
    sink method "sysopen" -> code.FilePathAccess
    sink method "syswrite" -> code.FileUse
    sink method "sysread" -> code.FileUse
    sink method "unlink" -> code.FilePathAccess
    sink method "remove_tree" -> code.FilePathAccess
    sink method "flock" -> code.FileUse
    sink method "append" -> code.FileUse
    sink method "read_ref" -> code.FileUse
    sink method "write_many" -> code.FileUse
    sink method "find_files" -> code.FileUse
    sink method "traverse" -> code.FileUse
  }
}
