import code.{SqlExecution, StoredDataRead}

adapter perl {
  package "CPANDB" {
    source method "dsn" -> code.StoredDataRead
    source method "dbh" -> code.StoredDataRead
    sink method "prepare" -> code.SqlExecution
    sink method "selectall_hashref" -> code.SqlExecution
    sink method "selectrow_hashref" -> code.SqlExecution
  }
}
