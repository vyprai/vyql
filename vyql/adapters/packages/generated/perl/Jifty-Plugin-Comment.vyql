import code.{Cookie}
import core.{HtmlEscape, InputValidation}

adapter perl {
  package "Jifty-Plugin-Comment" {
    source method "fetch_comment_cookie" -> code.Cookie
    source method "from_cookie" -> code.Cookie
    control method "scrub_html" -> core.HtmlEscape
    control method "validate_title" -> core.InputValidation
    control method "validate_web_site" -> core.InputValidation
  }
}
