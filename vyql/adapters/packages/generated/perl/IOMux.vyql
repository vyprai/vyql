import code.{NetworkData, FilePathAccess, NetworkConnect, StoredDataRead}
adapter perl {
  package "IOMux" {
    sink method "open" -> FilePathAccess
    source method "readline" -> code.NetworkData
    source method "readSize" -> code.NetworkData
    source method "muxConnection" -> code.NetworkData
    sink method "fileno" -> FilePathAccess
    sink method "socket" -> NetworkConnect
    sink method "write" -> NetworkConnect
    sink method "writeSize" -> NetworkConnect
  }
}
