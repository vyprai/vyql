module bindings.perl.migration.mcba1ed5b;

binding weakRandomValue2 {
  requires {
    dependency("Text-DeLoreanIpsum")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "get_sentence"
  emit issue code.WeakRandomValue at node
}
