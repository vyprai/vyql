adapter scala {
  package "javax.jcr:jcr" {
    sink method "addNode" -> code.FilePathAccess
    sink method "setProperty" -> code.StoredDataWrite
    sink method "getNode" -> code.FilePathAccess
    sink method "getProperty" -> code.FilePathAccess
    sink method "getCorrespondingNodePath" -> code.FilePathAccess
    sink method "move" -> code.FilePathAccess
    sink method "copy" -> code.FilePathAccess
    sink method "restore" -> code.FilePathAccess
    sink method "restoreByLabel" -> code.FilePathAccess
  }
}
