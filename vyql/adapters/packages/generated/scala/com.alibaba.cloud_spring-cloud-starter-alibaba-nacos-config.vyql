import code.{StoredDataRead}

adapter scala {
  package "com.alibaba.cloud:spring-cloud-starter-alibaba-nacos-config" {
    source method "loadApplicationConfiguration" -> code.StoredDataRead
    source method "loadNacosConfiguration" -> code.StoredDataRead
    source method "loadNacosDataIfPresent" -> code.StoredDataRead
    source method "loadNacosPropertySource" -> code.StoredDataRead
  }
}
