import code.{ResponseHeaderWrite}

adapter scala {
  package "io.github.jhipster:jhipster-framework" {
    sink method "createAlert" -> code.ResponseHeaderWrite
    sink method "createEntityCreationAlert" -> code.ResponseHeaderWrite
    sink method "createEntityUpdateAlert" -> code.ResponseHeaderWrite
    sink method "createEntityDeletionAlert" -> code.ResponseHeaderWrite
    sink method "createFailureAlert" -> code.ResponseHeaderWrite
  }
}
