import code.{CodeEval, XmlParse}
import core.{HtmlEscape}

adapter scala {
  package "org.tuckey:urlrewritefilter" {
    sink method "parseClass" -> code.CodeEval
    sink method "invokeRunMethod" -> code.CodeEval
    sink method "loadDom" -> code.XmlParse
    control method "escape" -> core.HtmlEscape
  }
}
