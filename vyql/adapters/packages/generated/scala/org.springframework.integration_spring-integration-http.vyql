import code.{HttpInput, NetworkSend, FileUse}

adapter scala {
  package "org.springframework.integration:spring-integration-http" {
    source method "read" -> code.HttpInput
    sink method "write" -> code.NetworkSend
    sink method "send" -> code.NetworkSend
    source method "inboundControllerAdapter" -> code.HttpInput
    source method "inboundControllerGateway" -> code.HttpInput
    source method "inboundChannelAdapter" -> code.HttpInput
    source method "inboundGateway" -> code.HttpInput
    sink method "outboundChannelAdapter" -> code.NetworkSend
    sink method "outboundGateway" -> code.NetworkSend
  }
}
