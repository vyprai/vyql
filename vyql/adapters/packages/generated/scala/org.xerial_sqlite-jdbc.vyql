import code.{SqlExecution, Deserialization, FilePathAccess}
import core.{InputValidation}

adapter scala {
  package "org.xerial:sqlite-jdbc" {
    sink method "exec" -> code.SqlExecution
    sink method "prepare" -> code.SqlExecution
    sink method "connect" -> code.FilePathAccess
    sink method "parse" -> code.Deserialization
    control method "escape" -> core.InputValidation
  }
}
