adapter scala {
  package "net.minidev:json-smart" {
    sink method "parse" -> code.Deserialization
    sink method "parseKeepingOrder" -> code.Deserialization
    sink method "parseWithException" -> code.Deserialization
    sink method "parseStrict" -> code.Deserialization
    sink method "isValidJsonStrict" -> code.Deserialization
    sink method "isValidJson" -> code.Deserialization
  }
}
