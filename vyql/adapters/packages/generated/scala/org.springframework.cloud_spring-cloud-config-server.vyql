import code.{SecretValue, HttpInput}
import core.{InputValidation}

adapter scala {
  package "org.springframework.cloud:spring-cloud-config-server" {
    source method "encrypt" -> code.SecretValue
    source method "decrypt" -> code.SecretValue
    control method "validateEncryptionWeakness" -> core.InputValidation
    control method "stripFormData" -> core.InputValidation
  }
}
