import core.{AuthenticationCheck, AuthorizationCheck}

adapter scala {
  package "com.github.theborakompanioni:thymeleaf-extras-shiro" {
    control method "isAuthenticated" -> core.AuthenticationCheck
    control method "isNotAuthenticated" -> core.AuthenticationCheck
    control method "isUser" -> core.AuthenticationCheck
    control method "isGuest" -> core.AuthenticationCheck
    control method "hasPermission" -> core.AuthorizationCheck
    control method "lacksPermission" -> core.AuthorizationCheck
    control method "hasAnyPermissions" -> core.AuthorizationCheck
    control method "hasAllPermissions" -> core.AuthorizationCheck
    control method "hasRole" -> core.AuthorizationCheck
    control method "lacksRole" -> core.AuthorizationCheck
    control method "hasAnyRoles" -> core.AuthorizationCheck
    control method "hasAllRoles" -> core.AuthorizationCheck
  }
}
