import code.{FilePathAccess, SecretValue, UrlFetch, WeakRandomValue}
import core.{InputValidation}

adapter scala {
  package "org.apache.activemq:activemq-spring" {
    sink method "resourceFromString" -> code.UrlFetch
    sink method "setKeyStore" -> code.FilePathAccess
    sink method "setTrustStore" -> code.FilePathAccess
    source method "setKeyStoreKeyPassword" -> code.SecretValue
    source method "setTrustStorePassword" -> code.SecretValue
    flag code.WeakRandomValue on any {
      method "setSecureRandomAlgorithm"
    }
    control method "validateUrlAllowed" -> core.InputValidation
  }
}
