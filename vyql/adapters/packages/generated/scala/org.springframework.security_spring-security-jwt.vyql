import code.{Deserialization, CodeEval, SecretValue}
import core.{UserControlledData}

adapter scala {
  package "org.springframework.security:spring-security-jwt" {
    source method "decode" -> core.UserControlledData
    sink method "decode" -> code.Deserialization
    source method "decodeAndVerify" -> core.UserControlledData
    sink method "decodeAndVerify" -> code.Deserialization
    sink method "encode" -> code.CodeEval
    source method "sign" -> code.SecretValue
    source method "loadPrivateKey" -> code.SecretValue
    source method "parseKeyPair" -> code.SecretValue
    source method "parsePublicKey" -> code.SecretValue
    source method "parseSSHPublicKey" -> code.SecretValue
  }
}
