import code.{HttpInput, HtmlRender}
import core.{UserControlledData}
adapter scala {
  package "javax.servlet:servlet-api" {
    source method "doFilter" -> core.UserControlledData
    source method "service" -> core.UserControlledData
    source method "parseQueryString" -> code.HttpInput
    source method "parsePostData" -> code.HttpInput
    source method "getReader" -> code.HttpInput
    sink method "getWriter" -> code.HtmlRender
  }
}
