import code.{UrlFetch}
import core.{UserControlledData}

adapter scala {
  package "com.loopj.android:android-async-http" {
    sink method "get" -> code.UrlFetch
    source method "get" -> core.UserControlledData
    sink method "post" -> code.UrlFetch
    source method "post" -> core.UserControlledData
    sink method "put" -> code.UrlFetch
    source method "put" -> core.UserControlledData
    sink method "delete" -> code.UrlFetch
    source method "delete" -> core.UserControlledData
  }
}
