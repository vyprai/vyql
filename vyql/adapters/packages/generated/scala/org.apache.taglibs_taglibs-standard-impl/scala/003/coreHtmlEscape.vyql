module bindings.scala.migration.m1e854f50;

binding htmlEscape3 {
  requires {
    dependency("org.apache.taglibs:taglibs-standard-impl")
  }
  query pattern callExpr where callee.method == "escape"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}
