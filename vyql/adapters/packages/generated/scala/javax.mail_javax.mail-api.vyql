import code.{Deserialization, FilePathAccess, NetworkSend, NetworkData}
import core.{InputValidation}

adapter scala {
  package "javax.mail:javax.mail-api" {
    sink method "parseString" -> code.Deserialization
    sink method "setFileName" -> code.FilePathAccess
    sink method "writeTo" -> code.NetworkSend
    source method "getHeader" -> code.NetworkData
    sink method "send" -> code.NetworkSend
    sink method "load" -> code.Deserialization
    control method "validate" -> core.InputValidation
  }
}
