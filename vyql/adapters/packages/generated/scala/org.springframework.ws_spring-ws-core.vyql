import code.{CommandExecution, Deserialization, FilePathAccess, NetworkConnect, NetworkSend, UrlFetch, XmlParse, HttpInput}
import core.{HtmlEscape, InputValidation, SqlParameterization}

adapter scala {
  package "org.springframework.ws:spring-ws-core" {
    source method "read" -> code.NetworkData
    sink method "write" -> code.NetworkSend
    sink method "send" -> code.NetworkSend
    sink method "parse" -> code.Deserialization
    sink method "getPayloadSource" -> code.XmlParse
    sink method "writeTo" -> code.NetworkSend
    source method "getRequest" -> code.HttpInput
    sink method "getResponse" -> code.NetworkSend
    control method "escapeAction" -> core.InputValidation
  }
}
