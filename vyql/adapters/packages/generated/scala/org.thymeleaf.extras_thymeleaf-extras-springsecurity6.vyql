import core.{AuthenticationCheck, AuthorizationCheck}

adapter scala {
  package "org.thymeleaf.extras:thymeleaf-extras-springsecurity6" {
    control method "authorizeUsingAccessExpression" -> core.AuthorizationCheck
    control method "authorizeUsingUrlCheck" -> core.AuthorizationCheck
    control method "isAuthenticated" -> core.AuthenticationCheck
    control method "isFullyAuthenticated" -> core.AuthenticationCheck
    control method "authorizeUsingAccessControlList" -> core.AuthorizationCheck
    control method "url" -> core.AuthorizationCheck
  }
}
