import code.{StoredDataRead, StoredDataWrite}
adapter scala {
  package "com.amazonaws:aws-java-sdk-s3" {
    sink method "putObject" -> code.StoredDataWrite
    sink method "deleteObject" -> code.StoredDataWrite
    sink method "createBucket" -> code.StoredDataWrite
    sink method "deleteBucket" -> code.StoredDataWrite
    source method "getObject" -> code.StoredDataRead
    source method "listObjects" -> code.StoredDataRead
    source method "listObjectsV2" -> code.StoredDataRead
    source method "listBuckets" -> code.StoredDataRead
    source method "getObjectMetadata" -> code.StoredDataRead
  }
}
