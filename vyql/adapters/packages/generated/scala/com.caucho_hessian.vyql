import code.{Deserialization}
adapter scala {
  package "com.caucho:hessian" {
    sink method "readObject" -> code.Deserialization
    sink method "readMethod" -> code.Deserialization
    sink method "parseTag" -> code.Deserialization
    sink method "parseString" -> code.Deserialization
    sink method "parseInt" -> code.Deserialization
    sink method "parseLong" -> code.Deserialization
    sink method "parseDouble" -> code.Deserialization
    sink method "parseDate" -> code.Deserialization
    sink method "parseBytes" -> code.Deserialization
  }
}
