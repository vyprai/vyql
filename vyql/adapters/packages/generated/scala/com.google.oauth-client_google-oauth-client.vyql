import code.{Deserialization, SecretValue}
import core.{InputValidation}

adapter scala {
  package "com.google.oauth-client:google-oauth-client" {
    source method "getAccessToken" -> code.SecretValue
    source method "getRefreshToken" -> code.SecretValue
    sink method "parse" -> code.Deserialization
    control method "escape" -> core.InputValidation
  }
}
