import code.{FilePathAccess, ArchiveEntryWrite, FileUse}
import core.{UserControlledData}

adapter scala {
  package "net.lingala.zip4j:zip4j" {
    sink method "addFile" -> code.FilePathAccess
    sink method "addFiles" -> code.FilePathAccess
    sink method "addStream" -> code.ArchiveEntryWrite
    source method "addStream" -> core.UserControlledData
    sink method "extractAll" -> code.FilePathAccess
    sink method "extractAll" -> code.FileUse
    sink method "extractFile" -> code.FilePathAccess
    sink method "extractFile" -> code.FileUse
    sink method "removeFile" -> code.ArchiveEntryWrite
    sink method "removeFiles" -> code.ArchiveEntryWrite
    sink method "renameFile" -> code.ArchiveEntryWrite
    sink method "renameFiles" -> code.ArchiveEntryWrite
    sink method "mergeSplitFiles" -> code.FilePathAccess
    sink method "mergeSplitFiles" -> code.ArchiveEntryWrite
  }
}
