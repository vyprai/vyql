import code.{HttpInput, Cookie}
adapter scala {
  package "io.quarkus:quarkus-resteasy" {
    source method "extractUriInfo" -> code.HttpInput
    source method "extractHttpHeaders" -> code.HttpInput
    source method "extractCookies" -> code.Cookie
    source method "extractAccepts" -> code.HttpInput
    source method "extractLanguages" -> code.HttpInput
    source method "extractRequestHeaders" -> code.HttpInput
  }
}
