import code.{FilePathAccess, UrlFetch}
adapter scala {
  package "org.apache.ivy:ivy" {
    sink method "configure" -> code.FilePathAccess
    sink method "configure" -> code.UrlFetch
    sink method "check" -> code.UrlFetch
    sink method "resolve" -> code.FilePathAccess
    sink method "resolve" -> code.UrlFetch
    sink method "retrieve" -> code.FilePathAccess
    sink method "publish" -> code.FilePathAccess
  }
}
