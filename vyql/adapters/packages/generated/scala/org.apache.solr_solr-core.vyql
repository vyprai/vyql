import code.{CommandExecution, Deserialization, HttpInput}

adapter scala {
  package "org.apache.solr:solr-core" {
    source method "call" -> code.HttpInput
    sink method "call" -> code.Deserialization
    sink method "runImpl" -> code.CommandExecution
    sink method "getParsedSchema" -> code.Deserialization
  }
}
