import code.{NetworkData}
adapter scala {
  package "io.netty:netty-all" {
    source method "readBoolean" -> code.NetworkData
    source method "readByte" -> code.NetworkData
    source method "readBytes" -> code.NetworkData
    source method "readChar" -> code.NetworkData
    source method "readDouble" -> code.NetworkData
    source method "readFloat" -> code.NetworkData
    source method "readInt" -> code.NetworkData
    source method "readLong" -> code.NetworkData
    source method "readMedium" -> code.NetworkData
    source method "readShort" -> code.NetworkData
    source method "readSlice" -> code.NetworkData
    source method "readUnsignedByte" -> code.NetworkData
    source method "readUnsignedInt" -> code.NetworkData
    source method "readUnsignedMedium" -> code.NetworkData
    source method "readUnsignedShort" -> code.NetworkData
  }
}
