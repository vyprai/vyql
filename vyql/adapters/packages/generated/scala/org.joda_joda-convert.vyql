import code.{Deserialization}

adapter scala {
  package "org.joda:joda-convert" {
    sink method "parse" -> code.Deserialization
    sink method "parseRenameFile" -> code.Deserialization
    sink method "parseBase64Binary" -> code.Deserialization
    sink method "parseCharacter" -> code.Deserialization
    sink method "parseBoolean" -> code.Deserialization
    sink method "parseAtomicBoolean" -> code.Deserialization
    sink method "parseLocale" -> code.Deserialization
  }
}
