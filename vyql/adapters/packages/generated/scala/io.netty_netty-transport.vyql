import code.{NetworkConnect, NetworkSend, NetworkData, NetworkDisconnect}

adapter scala {
  package "io.netty:netty-transport" {
    sink method "bind" -> code.NetworkConnect
    sink method "connect" -> code.NetworkConnect
    source method "read" -> code.NetworkData
    sink method "write" -> code.NetworkSend
    sink method "disconnect" -> code.NetworkDisconnect
  }
}
