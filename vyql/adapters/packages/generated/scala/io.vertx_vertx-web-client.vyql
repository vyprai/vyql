import code.{NetworkConnect}

adapter scala {
  package "io.vertx:vertx-web-client" {
    sink method "send" -> code.NetworkConnect
    sink method "requestAbs" -> code.NetworkConnect
    sink method "getAbs" -> code.NetworkConnect
    sink method "postAbs" -> code.NetworkConnect
    sink method "putAbs" -> code.NetworkConnect
    sink method "deleteAbs" -> code.NetworkConnect
    sink method "patchAbs" -> code.NetworkConnect
    sink method "headAbs" -> code.NetworkConnect
  }
}
