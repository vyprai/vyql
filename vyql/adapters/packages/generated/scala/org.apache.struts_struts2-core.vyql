import code.{HttpInput}
import core.{InputValidation, UserControlledData}

adapter scala {
  package "org.apache.struts:struts2-core" {
    source method "getParameters" -> code.HttpInput
    source method "getServletRequest" -> code.HttpInput
    source method "getSession" -> code.HttpInput
    source method "getServletPath" -> core.UserControlledData
    source method "getUri" -> core.UserControlledData
    control method "validate" -> core.InputValidation
    control method "parseIfModifiedSince" -> core.InputValidation
  }
}
