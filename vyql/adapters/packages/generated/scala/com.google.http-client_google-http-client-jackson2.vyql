import code.{Deserialization}
adapter scala {
  package "com.google.http-client:google-http-client-jackson2" {
    sink method "JacksonParser.nextToken" -> code.Deserialization
    sink method "JacksonParser.getCurrentToken" -> code.Deserialization
    sink method "JacksonParser.skipChildren" -> code.Deserialization
    sink method "JacksonParser.getByteValue" -> code.Deserialization
    sink method "JacksonParser.getDoubleValue" -> code.Deserialization
    sink method "JacksonParser.getText" -> code.Deserialization
    sink method "JacksonParser.getFloatValue" -> code.Deserialization
    sink method "JacksonParser.getIntValue" -> code.Deserialization
    sink method "JacksonFactory.createJsonParser" -> code.Deserialization
  }
}
