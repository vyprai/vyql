import code.{CodeEval, RawMemoryCopySize, PointerFree, PointerUse}

adapter scala {
  package "net.java.dev.jna:jna" {
    flag code.RawMemoryCopySize on any {
      method "read"
    }
    flag code.RawMemoryCopySize on any {
      method "write"
    }
    flag code.PointerFree on any {
      method "free"
    }
    flag code.PointerUse on any {
      method "malloc"
    }
    flag code.PointerUse on any {
      method "getByteBuffer"
    }
    sink method "load" -> code.CodeEval
    sink method "loadLibrary" -> code.CodeEval
  }
}
