import code.{HttpInput, RedirectTarget}

adapter scala {
  package "org.apache.tomcat:tomcat-jsp-api" {
    flag code.RedirectTarget on any {
      method "forward"
    }
    flag code.RedirectTarget on any {
      method "include"
    }
    source method "getRequestURI" -> code.HttpInput
    source method "getQueryString" -> code.HttpInput
  }
}
