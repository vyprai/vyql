import code.{CodeEval, NosqlQuery, Deserialization}
adapter scala {
  package "org.mongodb:mongo-java-driver" {
    sink method "eval" -> code.CodeEval
    sink method "doEval" -> code.CodeEval
    sink method "command" -> code.NosqlQuery
    sink method "executeCommand" -> code.NosqlQuery
    sink method "parse" -> code.Deserialization
  }
}
