adapter scala {
  package "ch.qos.logback:logback-access" {
    source method "getRequestURI" -> code.HttpInput
    source method "getQueryString" -> code.HttpInput
    source method "getRequestHeader" -> code.HttpInput
    source method "getRequestParameterMap" -> code.HttpInput
    source method "buildRequestParameterMap" -> code.HttpInput
    source method "getSessionID" -> code.HttpInput
  }
}
