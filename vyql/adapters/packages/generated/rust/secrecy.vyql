import code.{SecretValue}
adapter rust {
  package "secrecy" {
    source method "new" -> code.SecretValue
    source method "init_with_mut" -> code.SecretValue
    source method "init_with" -> code.SecretValue
    source method "expose_secret" -> code.SecretValue
    source method "expose_secret_mut" -> code.SecretValue
  }
}
