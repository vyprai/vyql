module bindings.rust.migration.m9bafc7e4;

binding weakHash2 {
  requires {
    dependency("fxhash")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "hash_word"
  emit issue code.WeakHash at node
}
