import code.{ExpressionEval}

adapter rust {
  package "serialize-to-javascript" {
    sink method "escape_json_parse" -> code.ExpressionEval
    sink method "into_javascript_string_literal" -> code.ExpressionEval
    sink method "new" -> code.ExpressionEval
    sink method "render" -> code.ExpressionEval
  }
}
