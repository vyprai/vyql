import code.{WeakRandomValue}
adapter rust {
  package "aead" {
    mark method "encrypt_in_place" -> code.WeakRandomValue
    mark method "decrypt_in_place" -> code.WeakRandomValue
    mark method "encrypt_in_place_detached" -> code.WeakRandomValue
    mark method "decrypt_in_place_detached" -> code.WeakRandomValue
  }
}
