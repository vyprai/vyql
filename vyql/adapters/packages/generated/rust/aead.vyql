import code.{WeakRandomValue}
adapter rust {
  package "aead" {
    flag code.WeakRandomValue on any {
      method "encrypt_in_place"
    }
    flag code.WeakRandomValue on any {
      method "decrypt_in_place"
    }
    flag code.WeakRandomValue on any {
      method "encrypt_in_place_detached"
    }
    flag code.WeakRandomValue on any {
      method "decrypt_in_place_detached"
    }
  }
}
