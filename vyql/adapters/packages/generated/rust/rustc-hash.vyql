import code.{WeakHash}

adapter rust {
  package "rustc-hash" {
    flag code.WeakHash on any {
      method "FxHasher.write"
    }
    flag code.WeakHash on any {
      method "FxHasher.write_u8"
    }
    flag code.WeakHash on any {
      method "FxHasher.write_u16"
    }
    flag code.WeakHash on any {
      method "FxHasher.write_u32"
    }
    flag code.WeakHash on any {
      method "FxHasher.write_u64"
    }
    flag code.WeakHash on any {
      method "FxHasher.write_u128"
    }
    flag code.WeakHash on any {
      method "FxHasher.write_usize"
    }
    flag code.WeakHash on any {
      method "FxHasher.write_str"
    }
    flag code.WeakHash on any {
      method "FxHasher.finish"
    }
    flag code.WeakHash on any {
      method "FxBuildHasher.build_hasher"
    }
  }
}
