import core.{InputValidation}

adapter rust {
  package "constant_time_eq" {
    control method "constant_time_eq" -> core.InputValidation
    control method "constant_time_eq_16" -> core.InputValidation
    control method "constant_time_eq_32" -> core.InputValidation
    control method "constant_time_eq_64" -> core.InputValidation
  }
}
