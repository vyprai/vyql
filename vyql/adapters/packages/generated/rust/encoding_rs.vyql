import code.{Deserialization}

adapter rust {
  package "encoding_rs" {
    sink method "decode_to_utf8" -> code.Deserialization
    sink method "decode_to_str" -> code.Deserialization
    sink method "decode_to_string" -> code.Deserialization
    sink method "decode_to_str_without_replacement" -> code.Deserialization
    sink method "decode_to_string_without_replacement" -> code.Deserialization
    sink method "decode_to_utf16" -> code.Deserialization
  }
}
