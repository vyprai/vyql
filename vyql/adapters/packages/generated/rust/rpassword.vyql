import code.{SecretValue}

adapter rust {
  package "rpassword" {
    source method "read_password" -> code.SecretValue
    source method "read_password_with_config" -> code.SecretValue
    source method "prompt_password" -> code.SecretValue
    source method "prompt_password_with_config" -> code.SecretValue
    source method "read_password_from_bufread" -> code.SecretValue
    source method "prompt_password_from_bufread" -> code.SecretValue
  }
}
