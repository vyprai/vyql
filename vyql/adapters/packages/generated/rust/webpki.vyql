import core.{CertificateValidation}

adapter rust {
  package "webpki" {
    control method "verify_is_valid_tls_server_cert" -> core.CertificateValidation
    control method "verify_is_valid_tls_server_cert_ext" -> core.CertificateValidation
    control method "verify_is_valid_tls_client_cert" -> core.CertificateValidation
    control method "verify_is_valid_tls_client_cert_ext" -> core.CertificateValidation
  }
}
