adapter rust {
  package "wry" {
    source method "with_url_and_headers" -> code.HttpInput
    source method "with_url" -> code.HttpInput
    source method "with_headers" -> code.HttpInput
    source method "url" -> code.HttpInput
    source method "cookies_for_url" -> code.SecretValue
    source method "cookies" -> code.SecretValue
    sink method "load_url" -> code.UrlFetch
    source method "set_cookie" -> code.SecretValue
    source method "delete_cookie" -> code.SecretValue
  }
}
