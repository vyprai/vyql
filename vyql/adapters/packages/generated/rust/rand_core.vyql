import code.{WeakRandomValue}
adapter rust {
  package "rand_core" {
    flag code.WeakRandomValue on any {
      method "next_u32"
    }
    flag code.WeakRandomValue on any {
      method "next_u64"
    }
    flag code.WeakRandomValue on any {
      method "fill_bytes"
    }
    flag code.WeakRandomValue on any {
      method "try_next_u32"
    }
    flag code.WeakRandomValue on any {
      method "try_next_u64"
    }
    flag code.WeakRandomValue on any {
      method "try_fill_bytes"
    }
  }
}
