module bindings.rust.migration.m73dfb5cd;

binding weakHash1 {
  requires {
    dependency("sha1")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "compress"
  emit issue code.WeakHash at node
}
