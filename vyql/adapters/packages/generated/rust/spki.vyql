import code.{FilePathAccess, FileUse}

adapter rust {
  package "spki" {
    sink method "read_public_key_der_file" -> code.FilePathAccess
    sink method "read_public_key_pem_file" -> code.FilePathAccess
    sink method "write_public_key_der_file" -> code.FileUse
    sink method "write_public_key_pem_file" -> code.FileUse
  }
}
