import code.{StoredDataRead}

adapter rust {
  package "whoami" {
    source method "account" -> code.StoredDataRead
    source method "account_os" -> code.StoredDataRead
    source method "username" -> code.StoredDataRead
    source method "username_os" -> code.StoredDataRead
    source method "realname" -> code.StoredDataRead
    source method "realname_os" -> code.StoredDataRead
    source method "hostname" -> code.StoredDataRead
    source method "devicename" -> code.StoredDataRead
    source method "devicename_os" -> code.StoredDataRead
    source method "distro" -> code.StoredDataRead
  }
}
