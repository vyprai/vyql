adapter rust {
  package "security-framework-sys" {
    flag code.WeakRandomValue on any {
      method "SecRandomCopyBytes"
    }
    source method "SecKeyCreateRandomKey" -> code.SecretValue
    source method "SecCertificateCreateWithData" -> core.UserControlledData
    flag code.CleartextChannel on any {
      method "SSLCreateContext"
    }
  }
}
