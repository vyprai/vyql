import code.{WeakHash}

adapter rust {
  package "fxhash" {
    flag code.WeakHash on any {
      method "write"
    }
    flag code.WeakHash on any {
      method "finish"
    }
    flag code.WeakHash on any {
      method "hash_word"
    }
    flag code.WeakHash on any {
      method "write_u8"
    }
    flag code.WeakHash on any {
      method "write_u16"
    }
    flag code.WeakHash on any {
      method "write_u32"
    }
    flag code.WeakHash on any {
      method "write_u64"
    }
    flag code.WeakHash on any {
      method "write_usize"
    }
    flag code.WeakHash on any {
      method "write32"
    }
    flag code.WeakHash on any {
      method "write64"
    }
  }
}
