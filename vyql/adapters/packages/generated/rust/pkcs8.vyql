import code.{SecretValue, FilePathAccess}
adapter rust {
  package "pkcs8" {
    source method "from_pkcs8_encrypted_der" -> code.SecretValue
    source method "from_pkcs8_encrypted_pem" -> code.SecretValue
    sink method "read_pkcs8_der_file" -> code.FilePathAccess
    sink method "read_pkcs8_pem_file" -> code.FilePathAccess
    source method "from_pkcs8_der" -> code.SecretValue
    source method "from_pkcs8_pem" -> code.SecretValue
    source method "to_pkcs8_encrypted_der" -> code.SecretValue
    source method "to_pkcs8_encrypted_pem" -> code.SecretValue
    sink method "write_pkcs8_der_file" -> code.FilePathAccess
    sink method "write_pkcs8_pem_file" -> code.FilePathAccess
    source method "encrypt" -> code.SecretValue
    source method "encrypt_with_params" -> code.SecretValue
    source method "new" -> code.SecretValue
    source method "to_pkcs8_der" -> code.SecretValue
    source method "to_pkcs8_pem" -> code.SecretValue
    source method "decrypt" -> code.SecretValue
  }
}
