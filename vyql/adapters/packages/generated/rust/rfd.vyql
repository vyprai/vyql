import code.{FilePathAccess, ArchiveEntryWrite, CommandExecution}
adapter rust {
  package "rfd" {
    sink method "run" -> code.CommandExecution
    sink method "pick_file" -> code.FilePathAccess
    sink method "pick_files" -> code.FilePathAccess
    sink method "save_file" -> code.ArchiveEntryWrite
    sink method "pick_folder" -> code.FilePathAccess
    sink method "pick_folders" -> code.FilePathAccess
    sink method "pick_file_or_folder" -> code.FilePathAccess
    sink method "pick_files_or_folders" -> code.FilePathAccess
    sink method "pick_file_async" -> code.FilePathAccess
    sink method "pick_files_async" -> code.FilePathAccess
    sink method "pick_folder_async" -> code.FilePathAccess
    sink method "pick_folders_async" -> code.FilePathAccess
    sink method "pick_file_or_folder_async" -> code.FilePathAccess
    sink method "pick_files_or_folders_async" -> code.FilePathAccess
    sink method "save_file_async" -> code.ArchiveEntryWrite
    sink method "write" -> code.ArchiveEntryWrite
    sink method "read" -> code.FilePathAccess
  }
}
