import code.{WeakRandomValue}

adapter rust {
  package "getrandom" {
    flag code.WeakRandomValue on any {
      method "fill"
    }
    flag code.WeakRandomValue on any {
      method "fill_uninit"
    }
    flag code.WeakRandomValue on any {
      method "u32"
    }
    flag code.WeakRandomValue on any {
      method "u64"
    }
  }
}
