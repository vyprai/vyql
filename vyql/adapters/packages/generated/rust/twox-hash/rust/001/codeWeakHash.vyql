module bindings.rust.migration.m62f8a4cd;

binding weakHash1 {
  requires {
    dependency("twox-hash")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "oneshot_with_seed"
  emit issue code.WeakHash at node
}
