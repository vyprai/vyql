import code.{ExpressionEval}

adapter rust {
  package "deranged" {
    sink method "new_unchecked" -> code.ExpressionEval
    sink method "unchecked_add" -> code.ExpressionEval
    sink method "unchecked_sub" -> code.ExpressionEval
    sink method "unchecked_mul" -> code.ExpressionEval
    sink method "unchecked_div" -> code.ExpressionEval
    sink method "unchecked_rem" -> code.ExpressionEval
    sink method "unchecked_neg" -> code.ExpressionEval
    sink method "unchecked_shl" -> code.ExpressionEval
    sink method "unchecked_shr" -> code.ExpressionEval
  }
}
