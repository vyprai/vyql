import code.{Deserialization, StoredDataRead}

adapter rust {
  package "windows-metadata" {
    sink method "Blob.read_utf8" -> code.Deserialization
    sink method "Blob.read_utf16" -> code.Deserialization
    sink method "Blob.read_method_signature" -> code.Deserialization
    sink method "Blob.read_type_signature" -> code.Deserialization
    sink method "Blob.read_compressed" -> code.Deserialization
    source method "File.new" -> code.StoredDataRead
  }
}
