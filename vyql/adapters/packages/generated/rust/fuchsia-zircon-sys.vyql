import code.{CommandExecution, NetworkData, NetworkSend, PrivilegedOp, SecretValue, StoredDataWrite}
import core.{UserControlledData}

adapter rust {
  package "fuchsia-zircon-sys" {
    source method "zx_channel_read" -> core.UserControlledData
    source method "zx_channel_read_etc" -> core.UserControlledData
    sink method "zx_channel_write" -> code.StoredDataWrite
    sink method "zx_channel_write_etc" -> code.StoredDataWrite
    source method "zx_cprng_draw" -> code.SecretValue
    source method "zx_debug_read" -> core.UserControlledData
    sink method "zx_debug_send_command" -> code.CommandExecution
    sink method "zx_debug_write" -> code.StoredDataWrite
    source method "zx_fifo_read" -> core.UserControlledData
    sink method "zx_fifo_write" -> code.StoredDataWrite
    source method "zx_process_read_memory" -> core.UserControlledData
    sink method "zx_process_write_memory" -> code.StoredDataWrite
    mark method "zx_resource_create" -> code.PrivilegedOp
    source method "zx_socket_read" -> code.NetworkData
    sink method "zx_socket_write" -> code.NetworkSend
    source method "zx_vmo_read" -> core.UserControlledData
    sink method "zx_vmo_write" -> code.StoredDataWrite
  }
}
