import code.{Deserialization}

adapter rust {
  package "rustls-pemfile" {
    sink method "certs" -> code.Deserialization
    sink method "private_key" -> code.Deserialization
    sink method "csr" -> code.Deserialization
    sink method "crls" -> code.Deserialization
    sink method "rsa_private_keys" -> code.Deserialization
    sink method "pkcs8_private_keys" -> code.Deserialization
    sink method "ec_private_keys" -> code.Deserialization
    sink method "public_keys" -> code.Deserialization
  }
}
