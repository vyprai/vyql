import code.{FilePathAccess, FileUse}
adapter rust {
  package "fs2" {
    sink method "duplicate" -> code.FilePathAccess
    sink method "lock_shared" -> code.FileUse
    sink method "lock_exclusive" -> code.FileUse
    sink method "try_lock_shared" -> code.FileUse
    sink method "try_lock_exclusive" -> code.FileUse
    sink method "unlock" -> code.FileUse
    sink method "free_space" -> code.FilePathAccess
    sink method "allocated_size" -> code.FilePathAccess
    sink method "allocate" -> code.FileUse
  }
}
