import core.{UserControlledData}
adapter rust {
  package "flume" {
    source method "send" -> core.UserControlledData
    source method "send_deadline" -> core.UserControlledData
    source method "send_timeout" -> core.UserControlledData
    source method "recv" -> core.UserControlledData
    source method "recv_deadline" -> core.UserControlledData
    source method "recv_timeout" -> core.UserControlledData
  }
}
