import code.{CommandExecution, NetworkConnect, NetworkSend, FilePathAccess, FileUse}

adapter rust {
  package "ndk-sys" {
    sink method "system" -> code.CommandExecution
    sink method "connect" -> code.NetworkConnect
    sink method "send" -> code.NetworkSend
    sink method "recv" -> code.NetworkConnect
    sink method "read" -> code.FilePathAccess
    sink method "write" -> code.FileUse
  }
}
