import core.{UserControlledData}

adapter rust {
  package "async-channel" {
    source method "send" -> core.UserControlledData
    source method "try_send" -> core.UserControlledData
    source method "send_blocking" -> core.UserControlledData
    source method "recv" -> core.UserControlledData
    source method "try_recv" -> core.UserControlledData
    source method "recv_blocking" -> core.UserControlledData
  }
}
