import code.{HttpInput}

adapter rust {
  package "axum-core" {
    source method "from_request" -> code.HttpInput
    source method "from_request_parts" -> code.HttpInput
    source method "extract_without_state" -> code.HttpInput
    source method "extract_body_without_state" -> code.HttpInput
    source method "extract_with_state" -> code.HttpInput
    source method "extract_parts_without_state" -> code.HttpInput
    source method "extract_parts_with_state" -> code.HttpInput
    source method "new" -> code.HttpInput
    source method "into_data_stream" -> code.HttpInput
  }
}
