import code.{WeakRandomValue}

adapter rust {
  package "oorandom" {
    flag code.WeakRandomValue on any {
      method "rand_u32"
    }
    flag code.WeakRandomValue on any {
      method "rand_i32"
    }
    flag code.WeakRandomValue on any {
      method "rand_float"
    }
    flag code.WeakRandomValue on any {
      method "rand_range"
    }
    flag code.WeakRandomValue on any {
      method "rand_u64"
    }
    flag code.WeakRandomValue on any {
      method "rand_i64"
    }
    flag code.WeakRandomValue on any {
      method "new"
    }
    flag code.WeakRandomValue on any {
      method "new_inc"
    }
    flag code.WeakRandomValue on any {
      method "from_state"
    }
  }
}
