import code.{Deserialization}
adapter rust {
  package "kuchiki" {
    sink method "parse_html" -> code.Deserialization
    sink method "parse_html_with_options" -> code.Deserialization
    sink method "parse_fragment" -> code.Deserialization
    sink method "parse_fragment_with_options" -> code.Deserialization
    sink method "compile" -> code.Deserialization
  }
}
