module bindings.rust.migration.m3f30e7df;

binding weakHash1 {
  requires {
    dependency("ahash")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "finish"
  emit issue code.WeakHash at node
}
