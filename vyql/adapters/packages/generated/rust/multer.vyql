import core.{UserControlledData}

adapter rust {
  package "multer" {
    source method "parse" -> core.UserControlledData
    source method "bytes" -> core.UserControlledData
    source method "chunk" -> core.UserControlledData
    source method "text" -> core.UserControlledData
    source method "file_name" -> core.UserControlledData
    source method "name" -> core.UserControlledData
    source method "content_type" -> core.UserControlledData
  }
}
