import code.{Deserialization}

adapter rust {
  package "untrusted" {
    sink method "new" -> code.Deserialization
    sink method "read_byte" -> code.Deserialization
    sink method "read_bytes" -> code.Deserialization
    sink method "read_bytes_to_end" -> code.Deserialization
    sink method "as_slice_less_safe" -> code.Deserialization
  }
}
