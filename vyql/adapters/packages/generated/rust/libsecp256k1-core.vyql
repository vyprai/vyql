import code.{Deserialization}
adapter rust {
  package "libsecp256k1-core" {
    sink method "read" -> code.Deserialization
    sink method "read_constructed_sequence" -> code.Deserialization
    sink method "read_len" -> code.Deserialization
    sink method "read_integer" -> code.Deserialization
    sink method "read_seq_len_lax" -> code.Deserialization
    sink method "read_len_lax" -> code.Deserialization
    sink method "read_integer_lax" -> code.Deserialization
  }
}
