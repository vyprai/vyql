import code.{NetworkBind, NetworkConnect, NetworkData, NetworkSend}
adapter rust {
  package "socket2" {
    sink method "connect" -> code.NetworkConnect
    sink method "connect_timeout" -> code.NetworkConnect
    sink method "bind" -> code.NetworkBind
    sink method "listen" -> code.NetworkBind
    sink method "accept" -> code.NetworkBind
    sink method "accept_raw" -> code.NetworkBind
    sink method "send" -> code.NetworkSend
    sink method "send_to" -> code.NetworkSend
    sink method "send_vectored" -> code.NetworkSend
    sink method "send_to_vectored" -> code.NetworkSend
    source method "recv" -> code.NetworkData
    source method "recv_from" -> code.NetworkData
    source method "recv_out_of_band" -> code.NetworkData
    source method "recv_with_flags" -> code.NetworkData
    source method "recv_vectored" -> code.NetworkData
    source method "recv_from_vectored" -> code.NetworkData
  }
}
