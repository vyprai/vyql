import code.{WeakHash}

adapter rust {
  package "md5" {
    flag code.WeakHash on any {
      method "new"
    }
    flag code.WeakHash on any {
      method "consume"
    }
    flag code.WeakHash on any {
      method "finalize"
    }
    flag code.WeakHash on any {
      method "compute"
    }
  }
}
