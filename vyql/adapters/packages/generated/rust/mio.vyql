import code.{NetworkData, NetworkConnect, NetworkBind}
adapter rust {
  package "mio" {
    source method "recv" -> code.NetworkData
    source method "recv_from" -> code.NetworkData
    source method "peek_from" -> code.NetworkData
    source method "read" -> code.NetworkData
    source method "send" -> code.NetworkData
    source method "send_to" -> code.NetworkData
    source method "write" -> code.NetworkData
    sink method "connect" -> code.NetworkConnect
    sink method "bind" -> code.NetworkBind
  }
}
