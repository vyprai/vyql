adapter rust {
  package "region" {
    flag code.PrivilegedOp on any {
      method "alloc_pages"
    }
    flag code.PrivilegedOp on any {
      method "protect"
    }
    flag code.PrivilegedOp on any {
      method "lock"
    }
    flag code.PrivilegedOp on any {
      method "unlock"
    }
  }
}
