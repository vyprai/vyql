import code.{Deserialization, NetworkData, NetworkSend}
import core.{AuthenticationCheck}

adapter rust {
  package "schannel" {
    sink method "import_pkcs12" -> code.Deserialization
    control method "validate" -> core.AuthenticationCheck
    source method "read" -> code.NetworkData
    sink method "write" -> code.NetworkSend
  }
}
