module bindings.rust.migration.m92f6cbf2;

binding privilegedOp2 {
  requires {
    dependency("region")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "lock"
  emit issue code.PrivilegedOp at node
  emit sink code.PrivilegedOpSink at node
}
