module bindings.rust.migration.m3799e2cf;

binding weakHash2 {
  requires {
    dependency("linked-hash-map")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "with_hasher"
  emit issue code.WeakHash at node
}
