module bindings.rust.migration.mdaef6e21;

binding weakHash1 {
  requires {
    dependency("crc32fast")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "update"
  emit issue code.WeakHash at node
}
