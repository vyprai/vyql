import code.{CodeEval, Deserialization}
import core.{InputValidation}

adapter rust {
  package "js-sys" {
    sink method "eval" -> code.CodeEval
    sink method "parse" -> code.Deserialization
    control method "decode_uri" -> core.InputValidation
    control method "decode_uri_component" -> core.InputValidation
    control method "encode_uri" -> core.InputValidation
    control method "encode_uri_component" -> core.InputValidation
  }
}
