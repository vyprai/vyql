import code.{CodeEval}
adapter rust {
  package "dispatch" {
    sink method "dispatch_async_f" -> code.CodeEval
    sink method "dispatch_sync_f" -> code.CodeEval
    sink method "dispatch_after_f" -> code.CodeEval
    sink method "dispatch_apply_f" -> code.CodeEval
    sink method "dispatch_once_f" -> code.CodeEval
    sink method "dispatch_group_async_f" -> code.CodeEval
    sink method "dispatch_group_notify_f" -> code.CodeEval
    sink method "dispatch_barrier_async_f" -> code.CodeEval
    sink method "dispatch_barrier_sync_f" -> code.CodeEval
  }
}
