import code.{StdinInput}

adapter rust {
  package "console" {
    source method "read_char" -> code.StdinInput
    source method "read_key" -> code.StdinInput
    source method "read_key_raw" -> code.StdinInput
    source method "read_line" -> code.StdinInput
    source method "read_line_initial_text" -> code.StdinInput
    source method "read_secure_line" -> code.StdinInput
  }
}
