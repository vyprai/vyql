import code.{NetworkSend}
import core.{UserControlledData}

adapter rust {
  package "futures-io" {
    source method "poll_read" -> core.UserControlledData
    source method "poll_read_vectored" -> core.UserControlledData
    source method "poll_fill_buf" -> core.UserControlledData
    sink method "poll_write" -> code.NetworkSend
    sink method "poll_write_vectored" -> code.NetworkSend
  }
}
