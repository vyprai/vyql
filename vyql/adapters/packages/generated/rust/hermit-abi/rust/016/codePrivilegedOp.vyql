module bindings.rust.migration.m7bc32aa6;

binding privilegedOp16 {
  requires {
    dependency("hermit-abi")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "ioctl"
  emit issue code.PrivilegedOp at node
  emit sink code.PrivilegedOpSink at node
}
