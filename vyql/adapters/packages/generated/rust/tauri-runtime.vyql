import code.{Cookie, FilePathAccess, NetworkConnect, RedirectTarget, UrlFetch}
import core.{InputValidation, UserControlledData}

adapter rust {
  package "tauri-runtime" {
    mark method "navigate" -> code.RedirectTarget
    sink method "navigate" -> code.UrlFetch
    source method "set_cookie" -> code.Cookie
    source method "delete_cookie" -> code.Cookie
    sink method "data_directory" -> code.FilePathAccess
    sink method "proxy_url" -> code.NetworkConnect
    sink method "proxy_url" -> code.UrlFetch
    source method "url" -> core.UserControlledData
    source method "cookies_for_url" -> code.Cookie
    source method "cookies" -> code.Cookie
    source method "opener" -> core.UserControlledData
    control method "use_https_scheme" -> core.InputValidation
  }
}
