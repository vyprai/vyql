import code.{WeakHash}
adapter rust {
  package "twox-hash" {
    flag code.WeakHash on any {
      method "oneshot"
    }
    flag code.WeakHash on any {
      method "oneshot_with_seed"
    }
    flag code.WeakHash on any {
      method "oneshot_with_secret"
    }
    flag code.WeakHash on any {
      method "oneshot_with_seed_and_secret"
    }
  }
}
