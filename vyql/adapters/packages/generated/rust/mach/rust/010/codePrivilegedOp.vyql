module bindings.rust.migration.mfb74f871;

binding privilegedOp10 {
  requires {
    dependency("mach")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "clock_set_attributes"
  emit issue code.PrivilegedOp at node
  emit sink code.PrivilegedOpSink at node
}
