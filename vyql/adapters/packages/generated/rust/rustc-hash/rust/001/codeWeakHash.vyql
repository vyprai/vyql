module bindings.rust.migration.mac101614;

binding weakHash1 {
  requires {
    dependency("rustc-hash")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "FxHasher.write_u8"
  emit issue code.WeakHash at node
}
