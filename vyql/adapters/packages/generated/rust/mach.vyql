import code.{PrivilegedOp}

adapter rust {
  package "mach" {
    flag code.PrivilegedOp on any {
      method "mach_vm_read"
    }
    flag code.PrivilegedOp on any {
      method "mach_vm_read_list"
    }
    flag code.PrivilegedOp on any {
      method "mach_vm_write"
    }
    flag code.PrivilegedOp on any {
      method "mach_vm_copy"
    }
    flag code.PrivilegedOp on any {
      method "mach_vm_read_overwrite"
    }
    flag code.PrivilegedOp on any {
      method "task_resume"
    }
    flag code.PrivilegedOp on any {
      method "task_suspend"
    }
    flag code.PrivilegedOp on any {
      method "thread_suspend"
    }
    flag code.PrivilegedOp on any {
      method "thread_resume"
    }
    flag code.PrivilegedOp on any {
      method "clock_set_time"
    }
    flag code.PrivilegedOp on any {
      method "clock_set_attributes"
    }
    flag code.PrivilegedOp on any {
      method "mach_port_extract_right"
    }
    flag code.PrivilegedOp on any {
      method "mach_msg_send"
    }
  }
}
