module bindings.rust.migration.m52982397;

binding privilegedOp12 {
  requires {
    dependency("fuchsia-zircon-sys")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "zx_resource_create"
  emit issue code.PrivilegedOp at node
  emit sink code.PrivilegedOpSink at node
}
