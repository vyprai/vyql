module bindings.rust.migration.mc6133410;

binding weakHash0 {
  requires {
    dependency("cranelift-codegen-shared")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "simple_hash"
  emit issue code.WeakHash at node
}
