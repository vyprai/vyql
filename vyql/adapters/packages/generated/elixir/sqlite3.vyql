import code.{CommandExecution, SqlExecution}

adapter elixir {
  package "sqlite3" {
    sink method "sql_exec" -> code.SqlExecution
    sink method "sql_bind_and_exec" -> code.SqlExecution
    sink method "sql_exec_script" -> code.SqlExecution
    sink method "prepare" -> code.SqlExecution
    sink method "prepared_bind" -> code.SqlExecution
    sink method "prepared_step" -> code.SqlExecution
    sink method "prepared_reset" -> code.SqlExecution
    sink method "prepared_clear_bindings" -> code.SqlExecution
    sink method "prepared_finalize" -> code.SqlExecution
    sink method "prepared_columns" -> code.SqlExecution
    sink method "sql_exec_async" -> code.SqlExecution
  }
}
