import code.{FilePathAccess}

adapter elixir {
  package "exts" {
    sink method "load" -> code.FilePathAccess
    sink method "load!" -> code.FilePathAccess
    sink method "dump" -> code.FilePathAccess
    sink method "dump!" -> code.FilePathAccess
    sink method "info" -> code.FilePathAccess
  }
}
