import code.{NetworkSend, NetworkData}

adapter elixir {
  package "maxwell" {
    sink method "Maxwell.Conn.put_path" -> code.NetworkSend
    sink method "Maxwell.Conn.put_query_string" -> code.NetworkSend
    sink method "Maxwell.Conn.put_req_body" -> code.NetworkSend
    source method "Maxwell.Conn.get_resp_headers" -> code.NetworkData
    source method "Maxwell.Conn.get_resp_body" -> code.NetworkData
  }
}
