module bindings.elixir.migration.m8b02ce7c;

binding weakHash0 {
  requires {
    dependency("ex_hash_ring")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "ExHashRing.Hash.of"
  emit issue code.WeakHash at node
}
