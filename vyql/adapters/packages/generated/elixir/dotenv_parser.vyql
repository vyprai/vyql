import code.{FilePathAccess, Deserialization}

adapter elixir {
  package "dotenv_parser" {
    sink method "load_file" -> code.FilePathAccess
    sink method "load_data" -> code.Deserialization
    sink method "parse_file" -> code.FilePathAccess
    sink method "parse_data" -> code.Deserialization
  }
}
