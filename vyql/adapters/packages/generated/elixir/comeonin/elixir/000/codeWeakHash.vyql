module bindings.elixir.migration.m06f34b81;

binding weakHash0 {
  requires {
    dependency("comeonin")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "add_hash"
  emit issue code.WeakHash at node
}
