import code.{NetworkConnect, NetworkSend, SecretValue}

adapter elixir {
  package "nerves_hub_cli" {
    source method "NervesHubCLI.Shell.request_auth" -> code.SecretValue
    source method "NervesHubCLI.Shell.password_get" -> code.SecretValue
    sink method "NervesHubCLI.API.request" -> code.NetworkConnect
    sink method "NervesHubCLI.API.request" -> code.NetworkSend
    sink method "NervesHubCLI.API.file_request" -> code.NetworkConnect
    sink method "NervesHubCLI.API.file_request" -> code.NetworkSend
    source method "NervesHubCLI.API.headers" -> code.SecretValue
  }
}
