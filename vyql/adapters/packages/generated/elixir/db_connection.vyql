import code.{SqlExecution, StoredDataRead}
adapter elixir {
  package "db_connection" {
    sink method "prepare" -> code.SqlExecution
    sink method "prepare!" -> code.SqlExecution
    sink method "prepare_execute" -> code.SqlExecution
    sink method "prepare_execute!" -> code.SqlExecution
    sink method "execute" -> code.SqlExecution
    sink method "execute!" -> code.SqlExecution
    sink method "transaction" -> code.SqlExecution
    source method "run" -> code.StoredDataRead
  }
}
