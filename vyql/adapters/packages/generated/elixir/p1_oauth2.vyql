import code.{SecretValue}
import core.{AuthenticationCheck, AuthorizationCheck}

adapter elixir {
  package "p1_oauth2" {
    control method "authorize_password" -> core.AuthenticationCheck
    control method "authorize_client_credentials" -> core.AuthenticationCheck
    control method "authorize_code_grant" -> core.AuthenticationCheck
    control method "authorize_code_request" -> core.AuthenticationCheck
    source method "issue_code" -> code.SecretValue
    source method "issue_token" -> code.SecretValue
    source method "issue_token_and_refresh" -> code.SecretValue
    control method "verify_access_token" -> core.AuthorizationCheck
    control method "verify_access_code" -> core.AuthorizationCheck
    control method "refresh_access_token" -> core.AuthenticationCheck
    source method "refresh_access_token" -> code.SecretValue
  }
}
