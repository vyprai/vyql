import code.{WeakRandomValue}
adapter elixir {
  package "quickrand" {
    flag code.WeakRandomValue on any {
      method "lcg35x_32"
    }
    flag code.WeakRandomValue on any {
      method "mwc256"
    }
    flag code.WeakRandomValue on any {
      method "mwc256_64"
    }
    flag code.WeakRandomValue on any {
      method "mwc256_128"
    }
    flag code.WeakRandomValue on any {
      method "seed_algorithms"
    }
  }
}
