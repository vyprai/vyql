import code.{HtmlRender}
import core.{HtmlEscape, UserControlledData}

adapter elixir {
  package "phoenix_gon" {
    source method "PhoenixGon.Controller.put_gon" -> core.UserControlledData
    source method "PhoenixGon.Controller.update_gon" -> core.UserControlledData
    sink method "PhoenixGon.View.render_gon_script" -> code.HtmlRender
    control method "PhoenixGon.View.escape_assets" -> core.HtmlEscape
  }
}
