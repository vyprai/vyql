import code.{SqlExecution, Deserialization, NetworkData, NetworkSend}

adapter elixir {
  package "tds" {
    sink method "query" -> code.SqlExecution
    sink method "query!" -> code.SqlExecution
    sink method "query_multi" -> code.SqlExecution
    sink method "execute" -> code.SqlExecution
    sink method "execute!" -> code.SqlExecution
    sink method "parse" -> code.Deserialization
    sink method "send" -> code.NetworkSend
    source method "recv" -> code.NetworkData
  }
}
