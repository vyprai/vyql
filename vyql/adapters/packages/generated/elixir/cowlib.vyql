import code.{Deserialization}
adapter elixir {
  package "cowlib" {
    sink method "parse_event" -> code.Deserialization
    sink method "parse_expected_size" -> code.Deserialization
    sink method "parse_hd_value" -> code.Deserialization
    sink method "parse_settings_key_val" -> code.Deserialization
    sink method "decode_field_section" -> code.Deserialization
    sink method "parse_cookie_trim" -> code.Deserialization
    sink method "parse_set_cookie_attrs" -> code.Deserialization
    sink method "perf_parse_multipart" -> code.Deserialization
  }
}
