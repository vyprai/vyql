import code.{Deserialization, NetworkConnect, NetworkData, NetworkSend}

adapter elixir {
  package "tortoise" {
    sink method "Tortoise.Transport.SSL.connect" -> code.NetworkConnect
    source method "Tortoise.Transport.SSL.recv" -> code.NetworkData
    sink method "Tortoise.Transport.SSL.send" -> code.NetworkSend
    sink method "Tortoise.publish" -> code.NetworkSend
    sink method "Tortoise.publish_sync" -> code.NetworkSend
    source method "Tortoise.Handler.handle_message" -> code.NetworkData
    sink method "Tortoise.Decodable.decode" -> code.Deserialization
  }
}
