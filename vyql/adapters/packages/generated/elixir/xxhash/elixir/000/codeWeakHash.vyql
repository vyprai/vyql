module bindings.elixir.migration.mb208f223;

binding weakHash0 {
  requires {
    dependency("xxhash")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "xxh32"
  emit issue code.WeakHash at node
}
