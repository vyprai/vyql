import code.{Deserialization, DatabaseRead}

adapter elixir {
  package "mmdb2_decoder" {
    sink method "parse_database" -> code.Deserialization
    sink method "decode" -> code.Deserialization
    sink method "decode_binary" -> code.Deserialization
    sink method "lookup" -> code.DatabaseRead
    sink method "lookup!" -> code.DatabaseRead
    sink method "lookup_pointer" -> code.DatabaseRead
    sink method "lookup_pointer!" -> code.DatabaseRead
    sink method "pipe_lookup" -> code.DatabaseRead
    sink method "pipe_lookup!" -> code.DatabaseRead
  }
}
