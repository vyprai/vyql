module bindings.elixir.migration.macc32cec;

binding weakHash0 {
  requires {
    dependency("surface")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "surface.hash"
  emit issue code.WeakHash at node
}
