import code.{ExpressionEval, StoredDataWrite, StoredDataRead, Deserialization}
adapter elixir {
  package "goldrush" {
    sink method "compile" -> code.ExpressionEval
    sink method "insert" -> code.StoredDataWrite
    source method "lookup" -> code.StoredDataRead
    source method "lookup_element" -> code.StoredDataRead
    sink method "deleteall" -> code.Deserialization
  }
}
