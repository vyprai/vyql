import code.{NetworkConnect, NetworkSend, Deserialization}
adapter elixir {
  package "tirexs" {
    sink method "head" -> code.NetworkConnect
    sink method "get" -> code.NetworkConnect
    sink method "put" -> code.NetworkConnect
    sink method "post" -> code.NetworkConnect
    sink method "delete" -> code.NetworkConnect
    sink method "head" -> code.NetworkSend
    sink method "get" -> code.NetworkSend
    sink method "put" -> code.NetworkSend
    sink method "post" -> code.NetworkSend
    sink method "delete" -> code.NetworkSend
    sink method "decode" -> code.Deserialization
  }
}
