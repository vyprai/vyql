import code.{NetworkData, NetworkSend, StoredDataRead, StoredDataWrite}
import core.{HtmlEscape}

adapter elixir {
  package "ex_aws_s3" {
    source method "ExAws.S3.download_file" -> code.StoredDataRead
    source method "ExAws.S3.get_object" -> code.NetworkData
    sink method "ExAws.S3.upload" -> code.StoredDataWrite
    sink method "ExAws.S3.request" -> code.NetworkSend
    control method "ExAws.S3.escape_xml_string" -> core.HtmlEscape
  }
}
