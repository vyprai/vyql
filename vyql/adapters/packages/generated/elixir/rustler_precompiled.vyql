import code.{CliArgument, FilePathAccess, UrlFetch}
import core.{InputValidation}

adapter elixir {
  package "rustler_precompiled" {
    source method "run" -> code.CliArgument
    sink method "available_nif_urls" -> code.UrlFetch
    sink method "download_or_reuse_nif_file" -> code.UrlFetch
    sink method "download_or_reuse_nif_file" -> code.FilePathAccess
    control method "check_file_integrity" -> core.InputValidation
    control method "check_integrity_from_map" -> core.InputValidation
    control method "compare_checksum" -> core.InputValidation
  }
}
