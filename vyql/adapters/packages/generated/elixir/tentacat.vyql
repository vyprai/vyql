import code.{Deserialization, UrlFetch, NetworkSend, NetworkConnect}

adapter elixir {
  package "tentacat" {
    sink method "process_response_body" -> code.Deserialization
    sink method "delete" -> code.UrlFetch
    sink method "delete" -> code.NetworkSend
    sink method "delete" -> code.NetworkConnect
    sink method "post" -> code.UrlFetch
    sink method "post" -> code.NetworkSend
    sink method "post" -> code.NetworkConnect
    sink method "patch" -> code.UrlFetch
    sink method "patch" -> code.NetworkSend
    sink method "patch" -> code.NetworkConnect
    sink method "put" -> code.UrlFetch
    sink method "put" -> code.NetworkSend
    sink method "put" -> code.NetworkConnect
    sink method "get" -> code.UrlFetch
    sink method "get" -> code.NetworkSend
    sink method "get" -> code.NetworkConnect
    sink method "json_request" -> code.UrlFetch
    sink method "json_request" -> code.NetworkSend
    sink method "raw_request" -> code.UrlFetch
    sink method "raw_request" -> code.NetworkSend
  }
}
