module bindings.elixir.migration.mce11883d;

binding weakCipher7 {
  requires {
    dependency("ockam_vault_software")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "aead_aes_gcm_decrypt"
  emit issue code.WeakCipher at node
}
