import code.{SqlExecution}

adapter elixir {
  package "sqlitex" {
    sink method "exec" -> code.SqlExecution
    sink method "exec!" -> code.SqlExecution
    sink method "query" -> code.SqlExecution
    sink method "query!" -> code.SqlExecution
    sink method "query_rows" -> code.SqlExecution
    sink method "query_rows!" -> code.SqlExecution
  }
}
