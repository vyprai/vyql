import code.{SqlExecution}

adapter elixir {
  package "ecto_shorts" {
    sink method "find" -> code.SqlExecution
    sink method "create" -> code.SqlExecution
    sink method "find_or_create" -> code.SqlExecution
    sink method "find_and_update" -> code.SqlExecution
    sink method "find_and_upsert" -> code.SqlExecution
    sink method "stream" -> code.SqlExecution
    sink method "aggregate" -> code.SqlExecution
    sink method "get" -> code.SqlExecution
    sink method "delete" -> code.SqlExecution
  }
}
