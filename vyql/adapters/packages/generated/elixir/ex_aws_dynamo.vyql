import code.{NosqlQuery, Deserialization}
adapter elixir {
  package "ex_aws_dynamo" {
    sink method "query" -> code.NosqlQuery
    sink method "scan" -> code.NosqlQuery
    sink method "get_item" -> code.NosqlQuery
    sink method "put_item" -> code.NosqlQuery
    sink method "update_item" -> code.NosqlQuery
    sink method "delete_item" -> code.NosqlQuery
    sink method "batch_get_item" -> code.NosqlQuery
    sink method "batch_write_item" -> code.NosqlQuery
    sink method "transact_get_items" -> code.NosqlQuery
    sink method "transact_write_items" -> code.NosqlQuery
    sink method "decode" -> code.Deserialization
  }
}
