import code.{StoredDataWrite, StoredDataRead}
import core.{InputValidation}

adapter elixir {
  package "exvcr" {
    sink method "save" -> code.StoredDataWrite
    source method "load" -> code.StoredDataRead
    control method "filter_sensitive_data" -> core.InputValidation
    control method "strip_query_params" -> core.InputValidation
    control method "remove_blacklisted_headers" -> core.InputValidation
  }
}
