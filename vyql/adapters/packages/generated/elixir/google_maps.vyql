import code.{NetworkSend}

adapter elixir {
  package "google_maps" {
    sink method "place_query" -> code.NetworkSend
    sink method "get" -> code.NetworkSend
    sink method "directions" -> code.NetworkSend
    sink method "distance" -> code.NetworkSend
    sink method "elevation" -> code.NetworkSend
    sink method "geocode" -> code.NetworkSend
    sink method "place_autocomplete" -> code.NetworkSend
    sink method "place_nearby" -> code.NetworkSend
    sink method "place_details" -> code.NetworkSend
    sink method "timezone" -> code.NetworkSend
  }
}
