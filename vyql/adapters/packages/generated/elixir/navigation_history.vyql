import code.{HttpInput, StoredDataWrite}

adapter elixir {
  package "navigation_history" {
    source method "NavigationHistory.Tracker.call" -> code.HttpInput
    source method "NavigationHistory.Tracker.track_history" -> code.HttpInput
    source method "NavigationHistory.last_path" -> code.HttpInput
    source method "NavigationHistory.last_paths" -> code.HttpInput
    sink method "NavigationHistory.Helpers.save_paths" -> code.StoredDataWrite
  }
}
