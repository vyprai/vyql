import code.{WeakRandomValue}

adapter elixir {
  package "misc_random" {
    flag code.WeakRandomValue on any {
      path "Misc.Random.seed"
    }
    flag code.WeakRandomValue on any {
      path "Misc.Random.seed_random"
    }
    flag code.WeakRandomValue on any {
      path "Misc.Random.string"
    }
    flag code.WeakRandomValue on any {
      path "Misc.Random.number"
    }
  }
}
