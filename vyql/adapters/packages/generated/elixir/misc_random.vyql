import code.{WeakRandomValue}

adapter elixir {
  package "misc_random" {
    mark path "Misc.Random.seed" -> code.WeakRandomValue
    mark path "Misc.Random.seed_random" -> code.WeakRandomValue
    mark path "Misc.Random.string" -> code.WeakRandomValue
    mark path "Misc.Random.number" -> code.WeakRandomValue
  }
}
