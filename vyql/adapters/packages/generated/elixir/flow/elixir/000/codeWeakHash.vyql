module bindings.elixir.migration.m3ec0d887;

binding weakHash0 {
  requires {
    dependency("flow")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "flow.hash"
  emit issue code.WeakHash at node
}
