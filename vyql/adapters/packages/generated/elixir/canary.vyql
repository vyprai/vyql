import core.{AuthorizationCheck}

adapter elixir {
  package "canary" {
    control method "authorize_resource" -> core.AuthorizationCheck
    control method "load_resource" -> core.AuthorizationCheck
    control method "load_and_authorize_resource" -> core.AuthorizationCheck
    control method "check_authorization" -> core.AuthorizationCheck
    control method "handle_unauthorized" -> core.AuthorizationCheck
    control method "authorize_controller" -> core.AuthorizationCheck
    control method "do_authorize_controller" -> core.AuthorizationCheck
    control method "verify_authorized_resource" -> core.AuthorizationCheck
    control method "verify_resource" -> core.AuthorizationCheck
  }
}
