module bindings.elixir.migration.mdd984bf2;

binding weakHash0 {
  requires {
    dependency("argon2_elixir")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "hash_pwd_salt"
  emit issue code.WeakHash at node
}
