adapter elixir {
  package "goth" {
    source method "start_link" -> code.SecretValue
    source method "fetch" -> code.SecretValue
    source method "fetch!" -> code.SecretValue
    source method "Token.fetch" -> code.SecretValue
    source method "Token.jwt_encode" -> code.SecretValue
    sink method "Token.request_with_finch" -> code.NetworkConnect
  }
}
