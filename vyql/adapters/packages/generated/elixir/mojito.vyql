import code.{NetworkConnect, NetworkSend}
adapter elixir {
  package "mojito" {
    sink method "connect" -> code.NetworkConnect
    sink method "request" -> code.NetworkSend
    sink method "head" -> code.NetworkSend
    sink method "get" -> code.NetworkSend
    sink method "post" -> code.NetworkSend
    sink method "put" -> code.NetworkSend
    sink method "patch" -> code.NetworkSend
    sink method "delete" -> code.NetworkSend
    sink method "options" -> code.NetworkSend
  }
}
