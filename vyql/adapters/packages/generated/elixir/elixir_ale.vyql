import code.{CommandExecution, PrivilegedOp}

adapter elixir {
  package "elixir_ale" {
    flag code.PrivilegedOp on any {
      method "Elixir.ElixirALE.GPIO.write"
    }
    source method "Elixir.ElixirALE.GPIO.read" -> core.UserControlledData
    flag code.PrivilegedOp on any {
      method "Elixir.ElixirALE.I2C.write"
    }
    flag code.PrivilegedOp on any {
      method "Elixir.ElixirALE.I2C.write_device"
    }
    flag code.PrivilegedOp on any {
      method "Elixir.ElixirALE.I2C.write_read"
    }
    flag code.PrivilegedOp on any {
      method "Elixir.ElixirALE.I2C.write_read_device"
    }
    source method "Elixir.ElixirALE.I2C.read" -> core.UserControlledData
    source method "Elixir.ElixirALE.I2C.read_device" -> core.UserControlledData
    source method "Elixir.ElixirALE.I2C.write_read" -> core.UserControlledData
    source method "Elixir.ElixirALE.I2C.write_read_device" -> core.UserControlledData
  }
}
