module bindings.elixir.migration.m579a90dc;

binding weakHash0 {
  requires {
    dependency("blake2")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "blake2.hash"
  emit issue code.WeakHash at node
}
