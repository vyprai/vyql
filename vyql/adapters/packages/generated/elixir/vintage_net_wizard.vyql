import code.{HttpInput, ResponseHeaderWrite, NetworkConnect}
import core.{UserControlledData, InputValidation}

adapter elixir {
  package "vintage_net_wizard" {
    source method "VintageNetWizard.Web.API.get_body" -> code.HttpInput
    source method "VintageNetWizard.WiFiConfiguration.json_to_network_config" -> core.UserControlledData
    sink method "VintageNetWizard.Web.API.send_json" -> code.ResponseHeaderWrite
    control method "VintageNetWizard.WiFiConfiguration.Params.validate_password" -> core.InputValidation
    control method "VintageNetWizard.WiFiConfiguration.Params.validate_peap_password" -> core.InputValidation
  }
}
