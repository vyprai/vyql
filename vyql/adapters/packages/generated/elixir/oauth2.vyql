import code.{UrlFetch, SecretValue, RedirectTarget}

adapter elixir {
  package "oauth2" {
    flag code.RedirectTarget on any {
      method "authorize_url"
    }
    source method "get_token" -> code.SecretValue
    source method "refresh_token" -> code.SecretValue
    source method "basic_auth" -> code.SecretValue
    sink method "get" -> code.UrlFetch
    sink method "post" -> code.UrlFetch
    sink method "put" -> code.UrlFetch
    sink method "patch" -> code.UrlFetch
    sink method "delete" -> code.UrlFetch
  }
}
