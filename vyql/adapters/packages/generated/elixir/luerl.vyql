adapter elixir {
  package "luerl" {
    source method "load" -> core.UserControlledData
    sink method "path_loadfile" -> code.FilePathAccess
    sink method "run" -> code.CodeEval
    sink method "decode_table" -> code.Deserialization
    sink method "decode_userdata" -> code.Deserialization
    sink method "decode_luafunc" -> code.Deserialization
    sink method "decode_erlfunc" -> code.Deserialization
    sink method "decode_erlmfa" -> code.Deserialization
  }
}
