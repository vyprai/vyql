import code.{NetworkData, NetworkSend, FilePathAccess}
adapter elixir {
  package "circuits_i2c" {
    sink method "open" -> code.FilePathAccess
    source method "read" -> code.NetworkData
    sink method "write" -> code.NetworkSend
    source method "write!" -> code.NetworkData
    sink method "write!" -> code.NetworkSend
    source method "write_read" -> code.NetworkData
    sink method "write_read" -> code.NetworkSend
    source method "write_read!" -> code.NetworkData
    sink method "write_read!" -> code.NetworkSend
  }
}
