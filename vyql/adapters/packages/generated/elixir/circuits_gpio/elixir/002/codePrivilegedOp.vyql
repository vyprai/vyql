module bindings.elixir.migration.m59dae0ab;

binding privilegedOp2 {
  requires {
    dependency("circuits_gpio")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "open_gpio"
  emit issue code.PrivilegedOp at node
  emit sink code.PrivilegedOpSink at node
}
