import code.{PrivilegedOp}
import core.{UserControlledData}

adapter elixir {
  package "circuits_gpio" {
    source method "read_gpio" -> core.UserControlledData
    flag code.PrivilegedOp on any {
      method "write_gpio"
    }
    flag code.PrivilegedOp on any {
      method "open_gpio"
    }
  }
}
