import code.{SecretValue}
import core.{AuthenticationCheck, InputValidation}

adapter elixir {
  package "addict" {
    source method "Addict.Configs.secret_key" -> code.SecretValue
    control method "Addict.Interactors.Login.call" -> core.AuthenticationCheck
    control method "Addict.Interactors.ResetPassword.validate_params" -> core.InputValidation
  }
}
