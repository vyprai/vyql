import code.{NetworkConnect, NetworkSend, ResponseHeaderWrite, StdinInput, UrlFetch}
import core.{UserControlledData}

adapter elixir {
  package "reverse_proxy_plug" {
    source method "call" -> core.UserControlledData
    source method "read_body" -> code.StdinInput
    sink method "request" -> code.NetworkConnect
    sink method "request" -> code.NetworkSend
    sink method "response" -> code.ResponseHeaderWrite
    sink method "prepare_url" -> code.UrlFetch
  }
}
