adapter elixir {
  package "hackney" {
    sink method "connect" -> code.NetworkConnect
    sink method "connect_direct" -> code.NetworkConnect
    sink method "request" -> code.UrlFetch
    sink method "do_request" -> code.UrlFetch
    sink method "connect_via_connect_proxy" -> code.NetworkConnect
    sink method "connect_via_socks5_proxy" -> code.NetworkConnect
    sink method "connect_pool_ssl" -> code.NetworkConnect
    sink method "start_conn_with_socket_internal" -> code.NetworkConnect
    sink method "start_conn_with_socket" -> code.NetworkConnect
    sink method "do_connect" -> code.NetworkConnect
  }
}
