import core.{AuthenticationCheck}

adapter elixir {
  package "pow" {
    source method "Pow.Plug.create_user" -> core.UserControlledData
    source method "Pow.Plug.update_user" -> core.UserControlledData
    source method "Pow.Plug.change_user" -> core.UserControlledData
    control method "Pow.Plug.authenticate_user" -> core.AuthenticationCheck
  }
}
