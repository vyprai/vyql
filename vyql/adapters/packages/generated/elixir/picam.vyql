import code.{CliArgument, FilePathAccess, NetworkSend}
adapter elixir {
  package "picam" {
    sink method "Picam.Camera.start_stream" -> code.NetworkSend
    sink method "Picam.Camera.capture_still" -> code.FilePathAccess
    source method "parse_args" -> code.CliArgument
    source method "parse_config_line" -> code.CliArgument
    sink method "output_jpeg" -> code.NetworkSend
  }
}
