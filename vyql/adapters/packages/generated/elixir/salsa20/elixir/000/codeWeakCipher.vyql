module bindings.elixir.migration.m57dab393;

binding weakCipher0 {
  requires {
    dependency("salsa20")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
