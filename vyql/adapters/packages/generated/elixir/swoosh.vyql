import code.{FilePathAccess, HtmlRender, NetworkSend, ResponseHeaderWrite}

adapter elixir {
  package "swoosh" {
    sink method "html_body" -> code.HtmlRender
    sink method "text_body" -> code.NetworkSend
    sink method "header" -> code.ResponseHeaderWrite
    sink method "attachment" -> code.FilePathAccess
  }
}
