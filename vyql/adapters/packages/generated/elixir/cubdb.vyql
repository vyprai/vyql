import code.{DatabaseRead, StoredDataWrite, FilePathAccess}

adapter elixir {
  package "cubdb" {
    sink method "fetch" -> code.DatabaseRead
    sink method "put" -> code.StoredDataWrite
    sink method "put_new" -> code.StoredDataWrite
    sink method "put_and_delete_multi" -> code.StoredDataWrite
    sink method "put_multi" -> code.StoredDataWrite
    sink method "delete" -> code.StoredDataWrite
    sink method "delete_multi" -> code.StoredDataWrite
    sink method "back_up" -> code.FilePathAccess
  }
}
