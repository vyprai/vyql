import code.{NetworkData, NetworkSend, Deserialization}
import core.{AuthorizationCheck, InputValidation}

adapter elixir {
  package "ex_aws_sqs" {
    control method "add_permission" -> core.AuthorizationCheck
    sink method "send_message" -> code.NetworkSend
    source method "receive_message" -> code.NetworkData
    control method "set_queue_attributes" -> core.InputValidation
    sink method "parse" -> code.Deserialization
  }
}
