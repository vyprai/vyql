import code.{SecretValue}
import core.{AuthenticationCheck, AuthorizationCheck}

adapter elixir {
  package "guardian_db" {
    control method "on_verify" -> core.AuthenticationCheck
    control method "on_revoke" -> core.AuthorizationCheck
    control method "revoke_all" -> core.AuthorizationCheck
    source method "find_by_claims" -> code.SecretValue
    source method "create" -> code.SecretValue
    source method "destroy_token" -> code.SecretValue
    source method "destroy_by_sub" -> code.SecretValue
  }
}
