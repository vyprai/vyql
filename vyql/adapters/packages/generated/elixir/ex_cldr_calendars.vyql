import code.{Deserialization}

adapter elixir {
  package "ex_cldr_calendars" {
    sink method "parse_date" -> code.Deserialization
    sink method "parse_week_date" -> code.Deserialization
    sink method "parse_naive_datetime" -> code.Deserialization
    sink method "parse_utc_datetime" -> code.Deserialization
  }
}
