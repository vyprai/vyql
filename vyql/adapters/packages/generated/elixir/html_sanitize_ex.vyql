import core.{HtmlEscape}

adapter elixir {
  package "html_sanitize_ex" {
    control method "sanitize" -> core.HtmlEscape
    control method "noscrub" -> core.HtmlEscape
    control method "basic_html" -> core.HtmlEscape
    control method "html5" -> core.HtmlEscape
    control method "markdown_html" -> core.HtmlEscape
    control method "strip_tags" -> core.HtmlEscape
  }
}
