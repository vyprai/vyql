import code.{Deserialization}

adapter elixir {
  package "exprotobuf" {
    sink method "parse" -> code.Deserialization
    sink method "parse_files!" -> code.Deserialization
    sink method "parse_string!" -> code.Deserialization
    sink method "decode" -> code.Deserialization
    sink method "decode_delimited" -> code.Deserialization
  }
}
