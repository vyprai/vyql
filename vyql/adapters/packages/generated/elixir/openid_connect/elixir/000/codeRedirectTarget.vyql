module bindings.elixir.migration.m3bcc9343;

binding redirectTarget0 {
  requires {
    dependency("openid_connect")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "authorization_uri"
  emit issue code.RedirectTarget at node
  emit sink code.RedirectTargetSink at node
}
