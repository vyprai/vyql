import code.{NetworkData, RedirectTarget, WeakRandomValue}
import core.{AuthenticationCheck, AuthorizationCheck}

adapter elixir {
  package "plug_attack" {
    source method "call" -> code.NetworkData
    flag code.RedirectTarget on any {
      method "block_action"
    }
    control method "allow_action" -> core.AuthenticationCheck
    flag code.WeakRandomValue on any {
      method "throttle"
    }
    control method "fail2ban" -> core.AuthorizationCheck
  }
}
