import code.{CommandExecution}
import core.{UserControlledData}
adapter elixir {
  package "ffmpex" {
    source method "add_input_file" -> core.UserControlledData
    source method "add_output_file" -> core.UserControlledData
    source method "add_global_option" -> core.UserControlledData
    source method "add_file_option" -> core.UserControlledData
    source method "add_stream_option" -> core.UserControlledData
  }
}
