module bindings.elixir.migration.m6b07d79b;

binding privilegedOp3 {
  requires {
    dependency("elixir_ale")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "Elixir.ElixirALE.I2C.write_device"
  emit issue code.PrivilegedOp at node
  emit sink code.PrivilegedOpSink at node
}
