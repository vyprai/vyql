import core.{AuthenticationCheck}

adapter elixir {
  package "plug_basic_auth" {
    control method "init" -> core.AuthenticationCheck
    control method "call" -> core.AuthenticationCheck
    control method "is_authorized" -> core.AuthenticationCheck
    source method "get_credentials" -> core.UserControlledData
    source method "parse_auth" -> core.UserControlledData
  }
}
