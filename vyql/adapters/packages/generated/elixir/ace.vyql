import code.{Deserialization, NetworkSend}

adapter elixir {
  package "ace" {
    sink method "Ace.HTTP2.Frame.parse" -> code.Deserialization
    sink method "Ace.HTTP2.send" -> code.NetworkSend
    sink method "Ace.HPACK.decode" -> code.Deserialization
    sink method "Ace.HPACK.encode" -> code.NetworkSend
  }
}
