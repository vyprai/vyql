import code.{NetworkSend}
adapter elixir {
  package "scenic_driver_nerves_rpi" {
    sink method "send_puts" -> code.NetworkSend
    sink method "send_write" -> code.NetworkSend
    sink method "send_inspect" -> code.NetworkSend
    sink method "send_static_texture_miss" -> code.NetworkSend
    sink method "send_dynamic_texture_miss" -> code.NetworkSend
    sink method "send_font_miss" -> code.NetworkSend
    sink method "send_key" -> code.NetworkSend
    sink method "send_codepoint" -> code.NetworkSend
    sink method "send_cursor_pos" -> code.NetworkSend
    sink method "send_mouse_button" -> code.NetworkSend
    sink method "send_scroll" -> code.NetworkSend
    sink method "send_cursor_enter" -> code.NetworkSend
  }
}
