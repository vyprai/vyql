import code.{Deserialization}
import core.{HtmlEscape}

adapter elixir {
  package "earmark_parser" {
    sink method "parse" -> code.Deserialization
    sink method "parse_markdown" -> code.Deserialization
    sink method "parse_lines" -> code.Deserialization
    control method "escape" -> core.HtmlEscape
  }
}
