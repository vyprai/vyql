import code.{FilePathAccess, RegexCompile}

adapter csharp {
  package "materialdesignextensions" {
    flag code.RegexCompile on any {
      method "ParseFilterRegularExpressions"
    }
    sink method "CreateNewDirectory" -> code.FilePathAccess
    sink method "SelectDirectory" -> code.FilePathAccess
    sink method "SelectFile" -> code.FilePathAccess
  }
}
