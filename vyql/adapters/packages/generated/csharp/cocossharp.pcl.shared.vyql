import code.{WeakCipher}

adapter csharp {
  package "cocossharp.pcl.shared" {
    flag code.WeakCipher on any {
      method "Lidgren.Network.NetXorEncryption.Encrypt"
    }
    flag code.WeakCipher on any {
      method "Lidgren.Network.NetXorEncryption.Decrypt"
    }
    flag code.WeakCipher on any {
      method "Lidgren.Network.NetXtea.EncryptBlock"
    }
    flag code.WeakCipher on any {
      method "Lidgren.Network.NetXtea.DecryptBlock"
    }
  }
}
