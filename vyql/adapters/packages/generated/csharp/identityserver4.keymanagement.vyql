import code.{FilePathAccess, StoredDataRead, StoredDataWrite}
adapter csharp {
  package "identityserver4.keymanagement" {
    sink method "PersistKeysToFileSystem" -> code.FilePathAccess
    sink method "StoreKeyAsync" -> code.StoredDataWrite
