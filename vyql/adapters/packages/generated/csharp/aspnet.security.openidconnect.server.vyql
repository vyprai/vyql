import code.{Deserialization}
import core.{InputValidation}

adapter csharp {
  package "aspnet.security.openidconnect.server" {
    sink method "DeserializeAccessTokenContext" -> code.Deserialization
    sink method "DeserializeAuthorizationCodeContext" -> code.Deserialization
    sink method "DeserializeIdentityTokenContext" -> code.Deserialization
    sink method "DeserializeRefreshTokenContext" -> code.Deserialization

    control method "Validate" -> core.InputValidation
  }
}
