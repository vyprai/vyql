import code.{Deserialization, FilePathAccess}
adapter csharp {
  package "cyotek.drawing.bitmapfont" {
    sink method "Load" -> code.Deserialization
    sink method "LoadBinary" -> code.Deserialization
    sink method "LoadText" -> code.Deserialization
    sink method "LoadXml" -> code.Deserialization
    sink method "LoadFontFromBinaryFile" -> code.FilePathAccess
    sink method "LoadFontFromFile" -> code.FilePathAccess
    sink method "LoadFontFromTextFile" -> code.FilePathAccess
    sink method "LoadFontFromXmlFile" -> code.FilePathAccess
  }
}
