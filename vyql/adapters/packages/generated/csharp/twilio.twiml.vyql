import code.{RedirectTarget}
import core.{AuthenticationCheck}

adapter csharp {
  package "twilio.twiml" {
    flag code.RedirectTarget on any {
      method "TwilioResponse.Redirect"
    }
    flag code.RedirectTarget on any {
      method "Redirect.ctor"
    }
    control method "RequestValidator.IsValidRequest" -> core.AuthenticationCheck
  }
}
