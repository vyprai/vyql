import code.{SqlExecution, StoredDataRead}
import core.{SqlParameterization}

adapter csharp {
  package "sqlite-net-pcl" {
    sink method "Execute" -> code.SqlExecution
    sink method "ExecuteScalar``1" -> code.SqlExecution
    sink method "Query``1" -> code.SqlExecution
    sink method "Insert" -> code.SqlExecution
    sink method "Update" -> code.SqlExecution
    sink method "Delete" -> code.SqlExecution
    sink method "CreateTable``1" -> code.SqlExecution
    sink method "CreateTables" -> code.SqlExecution
    sink method "CreateIndex" -> code.SqlExecution
    sink method "DropTable``1" -> code.SqlExecution
    sink method "CreateCommand" -> code.SqlExecution
    source method "Get``1" -> code.StoredDataRead
    source method "Find``1" -> code.StoredDataRead
    source method "DeferredQuery``1" -> code.StoredDataRead
    source method "Table``1" -> code.StoredDataRead
    control method "Quote" -> core.SqlParameterization
  }
}
