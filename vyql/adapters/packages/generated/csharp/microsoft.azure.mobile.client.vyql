import code.{DatabaseRead, SecretValue, StoredDataWrite, WeakHash}
import core.{AuthenticationCheck}

adapter csharp {
  package "microsoft.azure.mobile.client" {
    control method "LoginAsyncOverride" -> core.AuthenticationCheck
    control method "MobileServiceAuthentication" -> core.AuthenticationCheck
    control method "MobileServicePKCEAuthentication" -> core.AuthenticationCheck
    control method "MobileServiceTokenAuthentication" -> core.AuthenticationCheck
    mark method "GetSha256Hash" -> code.WeakHash
    sink method "UpsertAsync" -> code.StoredDataWrite
    sink method "DeleteAsync" -> code.StoredDataWrite
    sink method "QueryAsync" -> code.DatabaseRead
    sink method "ReadAsync" -> code.DatabaseRead
  }
}
