import code.{FilePathAccess, FileUse}
adapter csharp {
  package "spring.social.dropbox" {
    sink method "CreateFolder" -> code.FilePathAccess
    sink method "Delete" -> code.FilePathAccess
    sink method "Move" -> code.FilePathAccess
    sink method "Copy" -> code.FilePathAccess
    sink method "UploadFile" -> code.FileUse
    sink method "DownloadFile" -> code.FileUse
    sink method "Restore" -> code.FilePathAccess
    sink method "Search" -> code.FilePathAccess
    sink method "GetShareableLink" -> code.FilePathAccess
    sink method "GetMediaLink" -> code.FilePathAccess
    sink method "DownloadThumbnail" -> code.FileUse
    sink method "GetMetadata" -> code.FilePathAccess
    sink method "GetRevisions" -> code.FilePathAccess
  }
}
