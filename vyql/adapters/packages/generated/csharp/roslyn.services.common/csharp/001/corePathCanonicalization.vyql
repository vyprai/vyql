module bindings.csharp.migration.md3e72d6d;

binding pathCanonicalization1 {
  requires {
    dependency("roslyn.services.common")
  }
  query pattern callExpr where callee.method == "ResolveRelativePath"
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
  }
}
