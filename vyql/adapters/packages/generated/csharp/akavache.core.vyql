import code.{StoredDataRead, StoredDataWrite, UrlFetch}

adapter csharp {
  package "akavache.core" {
    sink method "Insert" -> code.StoredDataWrite
    sink method "InsertObject``1" -> code.StoredDataWrite
    source method "Get" -> code.StoredDataRead
    source method "GetObject``1" -> code.StoredDataRead
    sink method "DownloadUrl" -> code.UrlFetch
  }
}
