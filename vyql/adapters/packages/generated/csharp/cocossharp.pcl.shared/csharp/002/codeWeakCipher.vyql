module bindings.csharp.migration.m3fba08c6;

binding weakCipher2 {
  requires {
    dependency("cocossharp.pcl.shared")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "Lidgren.Network.NetXtea.EncryptBlock"
  emit issue code.WeakCipher at node
}
