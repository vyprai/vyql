module bindings.csharp.migration.me666ff19;

binding weakHash4 {
  requires {
    dependency("microsoft.azure.mobile.client")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "GetSha256Hash"
  emit issue code.WeakHash at node
}
