module bindings.csharp.migration.md1519ec6;

binding weakHash10 {
  requires {
    dependency("system.net.ftpclient")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "GetMD5"
  emit issue code.WeakHash at node
}
