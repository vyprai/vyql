module bindings.csharp.migration.m5333e552;

binding shellEscape2 {
  requires {
    dependency("dotnet-aspnet-codegenerator")
  }
  query pattern callExpr where callee.method == "EscapeAndConcatenate"
  emit check core.ShellEscape at call {
    covers path {
      from: call
      to: call
    }
