module bindings.csharp.migration.m05dca8db;

binding redirectTarget2 {
  requires {
    dependency("microsoft.aspnetcore.blazor.browser")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "NavigateToCore"
  emit issue code.RedirectTarget at node
  emit sink code.RedirectTargetSink at node
}
