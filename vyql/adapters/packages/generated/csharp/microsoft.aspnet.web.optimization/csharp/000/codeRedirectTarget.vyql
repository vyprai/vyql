module bindings.csharp.migration.mc0c2b5ed;

binding redirectTarget0 {
  requires {
    dependency("microsoft.aspnet.web.optimization")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "ResolveBundleUrl"
  emit issue code.RedirectTarget at node
  emit sink code.RedirectTargetSink at node
}
