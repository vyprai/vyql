import core.{UserControlledData}
import code.{HtmlRender}

adapter csharp {
  package "twilio.mvc" {
    source method "AccountSid" -> core.UserControlledData
    source method "From" -> core.UserControlledData
    source method "FromCity" -> core.UserControlledData
    source method "FromState" -> core.UserControlledData
    source method "FromZip" -> core.UserControlledData
    source method "FromCountry" -> core.UserControlledData
    source method "ToCity" -> core.UserControlledData
    source method "ToState" -> core.UserControlledData
    source method "ToZip" -> core.UserControlledData
    source method "ToCountry" -> core.UserControlledData
    source method "SmsSid" -> core.UserControlledData
    source method "Body" -> core.UserControlledData
    source method "MessageStatus" -> core.UserControlledData
    source method "CallSid" -> core.UserControlledData
    source method "CallStatus" -> core.UserControlledData
    source method "ApiVersion" -> core.UserControlledData
    source method "Direction" -> core.UserControlledData
    source method "ForwardedFrom" -> core.UserControlledData
    source method "CallerName" -> core.UserControlledData
    source method "Digits" -> core.UserControlledData
    source method "RecordingUrl" -> core.UserControlledData
    sink method "TwiML" -> code.HtmlRender
  }
}
