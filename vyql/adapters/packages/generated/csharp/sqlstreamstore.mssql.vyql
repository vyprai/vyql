import code.{SqlExecution}

adapter csharp {
  package "sqlstreamstore.mssql" {
    sink method "MsSqlStreamStore" -> code.SqlExecution
    sink method "MsSqlStreamStoreV3" -> code.SqlExecution
    sink method "CreateSchema" -> code.SqlExecution
    sink method "CreateSchemaIfNotExists" -> code.SqlExecution
    sink method "Migrate" -> code.SqlExecution
    sink method "DropAll" -> code.SqlExecution
  }
}
