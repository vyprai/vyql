module bindings.csharp.migration.mf90978f3;

binding redirectTarget3 {
  requires {
    dependency("nancy.authentication.forms")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "UserLoggedInRedirectResponse"
  emit issue code.RedirectTarget at node
  emit sink code.RedirectTargetSink at node
}
