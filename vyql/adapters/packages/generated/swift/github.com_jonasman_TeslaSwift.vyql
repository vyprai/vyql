import code.{CommandExecution, NetworkData}
import core.{AuthenticationCheck}

adapter swift {
  package "github.com/jonasman/TeslaSwift" {
    control method "authenticateWeb" -> core.AuthenticationCheck
    control method "authenticateWebNativeURL" -> core.AuthenticationCheck
    control method "authenticateWebNative" -> core.AuthenticationCheck
    control method "refreshToken" -> core.AuthenticationCheck
    control method "revokeToken" -> core.AuthenticationCheck
    control method "logout" -> core.AuthenticationCheck
    control method "urlToSendPublicKeyToVehicle" -> core.AuthenticationCheck

    sink method "sendCommandToVehicle" -> code.CommandExecution
    sink method "sendSignedCommandToVehicle" -> code.CommandExecution

    source method "openStream" -> code.NetworkData
    source method "getEnergySiteStatus" -> code.NetworkData
    source method "getEnergySiteLiveStatus" -> code.NetworkData
  }
}
