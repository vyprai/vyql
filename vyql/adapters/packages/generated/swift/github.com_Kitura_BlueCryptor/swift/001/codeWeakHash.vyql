module bindings.swift.migration.mc9a64198;

binding weakHash1 {
  requires {
    dependency("github.com/Kitura/BlueCryptor")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "digest"
  emit issue code.WeakHash at node
}
