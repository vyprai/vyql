import code.{NetworkConnect, NetworkSend, NetworkDisconnect, SecretValue}
import core.{UserControlledData}

adapter swift {
  package "github.com/aciidb0mb3r/SwiftMQTT" {
    sink method "connect" -> code.NetworkConnect
    sink method "publish" -> code.NetworkSend
    sink method "subscribe" -> code.NetworkConnect
    sink method "unSubscribe" -> code.NetworkDisconnect
    sink method "disconnect" -> code.NetworkDisconnect
  }
}
