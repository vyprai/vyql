import code.{NetworkSend, NosqlQuery, SecretValue, StoredDataRead, StoredDataWrite}

adapter swift {
  package "github.com/vapor-community/google-cloud-kit" {
    source method "access" -> code.SecretValue
    sink method "send" -> code.NetworkSend
    sink method "query" -> code.NosqlQuery
    source method "getMedia" -> code.StoredDataRead
    sink method "createSimpleUpload" -> code.StoredDataWrite
  }
}
