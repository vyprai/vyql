import code.{StoredDataRead, StoredDataWrite}
adapter swift {
  package "github.com/mergesort/Bodega" {
    sink method "write(_:key:)" -> code.StoredDataWrite
    sink method "write(_:)" -> code.StoredDataWrite
    source method "read(key:)" -> code.StoredDataRead
    source method "readDataAndKeys(keys:)" -> code.StoredDataRead
    source method "readAllData()" -> code.StoredDataRead
    source method "readAllDataAndKeys()" -> code.StoredDataRead
  }
}
