import code.{FileUse, ArchiveEntryWrite, FilePathAccess}
adapter swift {
  package "github.com/dduan/Pathos" {
    sink method "readString" -> code.FileUse
    sink method "readUTF8String" -> code.FileUse
    sink method "readBytes" -> code.FileUse
    sink method "readSymlink" -> code.FileUse
    sink method "write" -> code.ArchiveEntryWrite
    sink method "glob" -> code.FilePathAccess
    sink method "copy" -> code.ArchiveEntryWrite
    sink method "move" -> code.ArchiveEntryWrite
    sink method "makeSymlink" -> code.ArchiveEntryWrite
    sink method "makeTemporaryDirectory" -> code.ArchiveEntryWrite
    sink method "workingDirectory" -> code.FilePathAccess
    sink method "setWorkingDirectory" -> code.FilePathAccess
    sink method "home" -> code.FilePathAccess
    sink method "real" -> code.FilePathAccess
  }
}
