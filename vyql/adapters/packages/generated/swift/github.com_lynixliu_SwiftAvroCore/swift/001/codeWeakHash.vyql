module bindings.swift.migration.m29981eb1;

binding weakHash1 {
  requires {
    dependency("github.com/lynixliu/SwiftAvroCore")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "compress"
  emit issue code.WeakHash at node
}
