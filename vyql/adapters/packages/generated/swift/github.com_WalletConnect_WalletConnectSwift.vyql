import code.{SecretValue, NetworkConnect}
adapter swift {
  package "github.com/WalletConnect/WalletConnectSwift" {
    source method "personal_sign" -> code.SecretValue
    source method "eth_sign" -> code.SecretValue
    source method "eth_signTypedData" -> code.SecretValue
    source method "eth_sendTransaction" -> code.SecretValue
    source method "eth_signTransaction" -> code.SecretValue
    source method "eth_sendRawTransaction" -> code.SecretValue
    sink method "send" -> code.NetworkConnect
  }
}
