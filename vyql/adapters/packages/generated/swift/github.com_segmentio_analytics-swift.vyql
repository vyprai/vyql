import code.{NetworkConnect, UrlFetch, Deserialization}

adapter swift {
  package "github.com/segmentio/analytics-swift" {
    sink method "openURL" -> code.UrlFetch
    sink method "requestFactory" -> code.NetworkConnect
    sink method "add" -> code.Deserialization
    sink method "setValue" -> code.Deserialization
  }
}
