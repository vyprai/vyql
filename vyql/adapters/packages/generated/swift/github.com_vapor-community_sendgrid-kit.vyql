import code.{NetworkSend, FileUpload}
adapter swift {
  package "github.com/vapor-community/sendgrid-kit" {
    sink method "send" -> code.NetworkSend
    sink method "validateEmail" -> code.NetworkSend
    mark method "uploadBulkEmailValidationFile" -> code.FileUpload
    sink method "uploadBulkEmailValidationFile" -> code.NetworkSend
  }
}
