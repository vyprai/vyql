import code.{ExpressionEval, HtmlRender}
adapter swift {
  package "github.com/pointfreeco/swift-html" {
    sink method "oncopy" -> code.ExpressionEval
    sink method "ondragstart" -> code.ExpressionEval
    sink method "onbeforeunload" -> code.ExpressionEval
    sink method "onhashchange" -> code.ExpressionEval
    sink method "onunload" -> code.ExpressionEval
    sink method "onsearch" -> code.ExpressionEval
    sink method "onload" -> code.ExpressionEval
    sink method "onloadeddata" -> code.ExpressionEval
    sink method "onloadedmetadata" -> code.ExpressionEval
    sink method "onloadstart" -> code.ExpressionEval
    sink method "_xmlRender" -> code.HtmlRender
  }
}
