adapter swift {
  package "github.com/Mattijah/QKMRZParser" {
    sink method "parse" -> code.Deserialization
    source method "documentType" -> core.UserControlledData
    source method "countryCode" -> core.UserControlledData
    source method "surnames" -> core.UserControlledData
    source method "givenNames" -> core.UserControlledData
    source method "documentNumber" -> core.UserControlledData
    source method "nationalityCountryCode" -> core.UserControlledData
    source method "birthdate" -> core.UserControlledData
    source method "sex" -> core.UserControlledData
    source method "expiryDate" -> core.UserControlledData
    source method "personalNumber" -> core.UserControlledData
    source method "personalNumber2" -> core.UserControlledData
    source method "isDocumentNumberValid" -> core.UserControlledData
    source method "isBirthdateValid" -> core.UserControlledData
    source method "isExpiryDateValid" -> core.UserControlledData
    source method "isPersonalNumberValid" -> core.UserControlledData
    source method "allCheckDigitsValid" -> core.UserControlledData
    source method "lastName" -> core.UserControlledData
    source method "issuanceDepartment" -> core.UserControlledData
    source method "issuanceOffice" -> core.UserControlledData
    source method "issueDate" -> core.UserControlledData
    source method "issuanceDepartment2" -> core.UserControlledData
    source method "firstName" -> core.UserControlledData
  }
}
