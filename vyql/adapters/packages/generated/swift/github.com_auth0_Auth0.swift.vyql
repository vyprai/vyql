import core.{AuthenticationCheck}

adapter swift {
  package "github.com/auth0/Auth0.swift" {
    source method "authentication" -> code.SecretValue
    source method "webAuth" -> core.UserControlledData
    source method "authorizeWithRequestUri" -> core.UserControlledData
    source method "credentials" -> code.SecretValue
    source method "store" -> code.SecretValue
    source method "sessionTransferToken" -> code.SecretValue
    control method "clearSession" -> core.AuthenticationCheck
    source method "getEntry" -> code.StoredDataRead
    sink method "setEntry" -> code.StoredDataWrite
    sink method "deleteEntry" -> code.StoredDataWrite
    control method "mfa" -> core.AuthenticationCheck
    source method "users" -> code.SecretValue
  }
}
