module bindings.swift.migration.mf434d638;

binding redirectTarget2 {
  requires {
    dependency("github.com/p2/OAuth2")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "handleRedirectURL"
  emit issue code.RedirectTarget at node
  emit sink code.RedirectTargetSink at node
}
