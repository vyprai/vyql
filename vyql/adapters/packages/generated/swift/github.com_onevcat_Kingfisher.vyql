import code.{FileUse, FilePathAccess}

adapter swift {
  package "github.com/onevcat/Kingfisher" {
    sink method "store" -> code.FileUse
    sink method "storeToDisk" -> code.FileUse
    sink method "removeImage" -> code.FileUse
    sink method "retrieveImage" -> code.FileUse
    sink method "retrieveImageInDiskCache" -> code.FileUse
    sink method "clearDiskCache" -> code.FileUse
    sink method "cleanExpiredDiskCache" -> code.FileUse
    sink method "cachePath" -> code.FilePathAccess
  }
}
