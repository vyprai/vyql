adapter swift {
  package "github.com/SwiftGen/StencilSwiftKit" {
    sink method "parse" -> code.Deserialization
    sink method "parseString" -> code.Deserialization
    sink method "parseStringArgument" -> code.Deserialization
    sink method "parseBool" -> code.Deserialization
    sink method "parseEnum" -> code.Deserialization
    source method "enrich" -> core.UserControlledData
  }
}
