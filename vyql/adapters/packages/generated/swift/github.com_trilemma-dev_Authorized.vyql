import code.{SecretValue}
import core.{AuthenticationCheck, AuthorizationCheck, UserControlledData}

adapter swift {
  package "github.com/trilemma-dev/Authorized" {
    control method "requestRights" -> core.AuthorizationCheck
    control method "checkRights" -> core.AuthorizationCheck
    source method "retrieveInfo" -> code.SecretValue
    control method "destroyRights" -> core.AuthorizationCheck
    control method "createOrUpdateDefinition" -> core.AuthorizationCheck
    control method "removeDefinition" -> core.AuthorizationCheck
  }
}
