import code.{SecretValue, StoredDataWrite, StoredDataRead}

adapter swift {
  package "github.com/kishikawakatsumi/KeychainAccess" {
    source method "get" -> code.SecretValue
    source method "getString" -> code.SecretValue
    source method "getData" -> code.SecretValue
    source method "getSharedPassword" -> code.SecretValue
    source method "set" -> code.SecretValue
    source method "setSharedPassword" -> code.SecretValue
    sink method "remove" -> code.StoredDataWrite
    sink method "removeAll" -> code.StoredDataWrite
    source method "contains" -> code.StoredDataRead
  }
}
