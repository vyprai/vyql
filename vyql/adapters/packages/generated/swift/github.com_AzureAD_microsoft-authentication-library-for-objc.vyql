import code.{SecretValue}
import core.{UserControlledData, AuthenticationCheck}

adapter swift {
  package "github.com/AzureAD/microsoft-authentication-library-for-objc" {
    source method "signIn" -> core.UserControlledData
    source method "signUp" -> core.UserControlledData
    source method "resetPassword" -> core.UserControlledData
    source method "getNativeAuthUserAccount" -> code.SecretValue
  }
}
