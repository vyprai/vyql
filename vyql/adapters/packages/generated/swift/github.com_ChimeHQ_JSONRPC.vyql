import code.{Deserialization, NetworkData, NetworkSend}
import core.{UserControlledData}

adapter swift {
  package "github.com/ChimeHQ/JSONRPC" {
    source method "recv" -> code.NetworkData
    sink method "send" -> code.NetworkSend
    sink method "decode" -> code.Deserialization
    sink method "sendDataRequest" -> code.NetworkSend
    sink method "sendRequest" -> code.NetworkSend
    sink method "sendNotification" -> code.NetworkSend
  }
}
