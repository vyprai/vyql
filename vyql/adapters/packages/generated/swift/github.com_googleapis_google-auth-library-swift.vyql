import code.{NetworkSend, SecretValue}
adapter swift {
  package "github.com/googleapis/google-auth-library-swift" {
    source method "oAuthToken" -> code.SecretValue
    source method "oAuthTokenSecret" -> code.SecretValue
    source method "AccessToken" -> code.SecretValue
    source method "RefreshToken" -> code.SecretValue
    source method "saveToken" -> code.SecretValue
    sink method "performRequest" -> code.NetworkSend
  }
}
