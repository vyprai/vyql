import code.{RegexCompile}
adapter swift {
  package "github.com/getGuaka/StringScanner" {
    flag code.RegexCompile on any {
      method "peek(untilPattern:)"
    }
    flag code.RegexCompile on any {
      method "scan(untilPattern:)"
    }
    flag code.RegexCompile on any {
      method "matches(_:options:)"
    }
    flag code.RegexCompile on any {
      method "groups(_:options:)"
    }
  }
}
