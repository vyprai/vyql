import code.{Deserialization, FilePathAccess}

adapter swift {
  package "github.com/kelvin13/swift-png" {
    sink method "open" -> code.FilePathAccess
    sink method "read" -> code.FilePathAccess
    sink method "write" -> code.FilePathAccess
    sink method "decompress" -> code.FilePathAccess
    sink method "compress" -> code.FilePathAccess
    sink method "extract" -> code.Deserialization
    sink method "push" -> code.Deserialization
    sink method "unpack" -> code.Deserialization
    sink method "signature" -> code.Deserialization
    sink method "chunk" -> code.Deserialization
  }
}
