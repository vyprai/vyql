import code.{StoredDataRead, StoredDataWrite}

adapter swift {
  package "github.com/juliand665/UserDefault" {
    source method "init" -> code.StoredDataRead
    source method "loadValue" -> code.StoredDataRead
    sink method "saveValue" -> code.StoredDataWrite
    sink method "clear" -> code.StoredDataWrite
  }
}
