import code.{Deserialization, WeakCipher}
import core.{InputValidation}

adapter swift {
  package "github.com/airsidemobile/JOSESwift" {
    sink method "deserialize" -> code.Deserialization
    flag code.WeakCipher on any {
      method "decrypt"
    }
    control method "validate" -> core.InputValidation
  }
}
