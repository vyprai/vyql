import code.{SecretValue, Deserialization}

adapter swift {
  package "github.com/leif-ibsen/SwiftECC" {
    source method "makeKeyPair" -> code.SecretValue
    source method "sharedSecret" -> code.SecretValue
    source method "init" -> code.SecretValue
    sink method "decodePoint" -> code.Deserialization
  }
}
