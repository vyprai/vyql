module bindings.swift.migration.m07c946ba;

binding redirectTarget6 {
  requires {
    dependency("github.com/supabase-community/storage-swift")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "getPublicUrl"
  emit issue code.RedirectTarget at node
  emit sink code.RedirectTargetSink at node
}
