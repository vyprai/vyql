module bindings.swift.migration.m6e375a2a;

binding privilegedOp1 {
  requires {
    dependency("github.com/tmandry/AXSwift")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "performAction"
  emit issue code.PrivilegedOp at node
  emit sink code.PrivilegedOpSink at node
}
