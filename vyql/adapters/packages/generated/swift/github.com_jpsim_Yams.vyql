import code.{Deserialization}
adapter swift {
  package "github.com/jpsim/Yams" {
    sink method "load" -> code.Deserialization
    sink method "load_all" -> code.Deserialization
    sink method "compose" -> code.Deserialization
    sink method "compose_all" -> code.Deserialization
    sink method "decode" -> code.Deserialization
  }
}
