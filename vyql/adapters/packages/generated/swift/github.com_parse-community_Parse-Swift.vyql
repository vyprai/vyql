import code.{NosqlQuery, NetworkSend, SecretValue, DatabaseRead}
import core.{AuthenticationCheck, AuthorizationCheck}

adapter swift {
  package "github.com/parse-community/Parse-Swift" {
    sink method "send" -> code.NetworkSend
    sink method "query" -> code.NosqlQuery
    sink method "find" -> code.NosqlQuery
    sink method "first" -> code.NosqlQuery
    sink method "count" -> code.NosqlQuery
    sink method "save" -> code.NosqlQuery
    sink method "create" -> code.NosqlQuery
    sink method "delete" -> code.NosqlQuery
    source method "initialize" -> code.SecretValue
    control method "getReadAccess" -> core.AuthorizationCheck
    control method "getWriteAccess" -> core.AuthorizationCheck
    control method "updateAuthentication" -> core.AuthenticationCheck
  }
}
