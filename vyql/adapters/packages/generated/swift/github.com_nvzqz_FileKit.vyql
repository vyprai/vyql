import code.{FilePathAccess, FileUse}

adapter swift {
  package "github.com/nvzqz/FileKit" {
    sink method "read" -> code.FilePathAccess
    sink method "write" -> code.FilePathAccess
    sink method "create" -> code.FilePathAccess
    sink method "delete" -> code.FilePathAccess
    sink method "move" -> code.FilePathAccess
    sink method "copy" -> code.FilePathAccess
    sink method "symlink" -> code.FilePathAccess
    sink method "hardlink" -> code.FilePathAccess
    sink method "inputStream" -> code.FileUse
    sink method "outputStream" -> code.FileUse
    sink method "symlinkFile" -> code.FilePathAccess
    sink method "hardlinkFile" -> code.FilePathAccess
    sink method "createFile" -> code.FilePathAccess
    sink method "deleteFile" -> code.FilePathAccess
    sink method "moveFile" -> code.FilePathAccess
    sink method "copyFile" -> code.FilePathAccess
  }
}
