import code.{FilePathAccess, NetworkConnect}

adapter swift {
  package "github.com/tuist/xcodeproj" {
    sink method "write" -> code.FilePathAccess
    sink method "writeWorkspace" -> code.FilePathAccess
    sink method "writePBXProj" -> code.FilePathAccess
    sink method "writeSharedData" -> code.FilePathAccess
    sink method "writeUserData" -> code.FilePathAccess
    sink method "writeSchemes" -> code.FilePathAccess
    sink method "writeBreakPoints" -> code.FilePathAccess
    sink method "addSwiftPackage" -> code.NetworkConnect
  }
}
