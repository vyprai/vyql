import core.{UserControlledData, AuthorizationCheck}

adapter swift {
  package "github.com/pointfreeco/composable-core-location" {
    source method "requestAlwaysAuthorization" -> core.UserControlledData
    source method "requestLocation" -> core.UserControlledData
    source method "requestWhenInUseAuthorization" -> core.UserControlledData
    source method "requestTemporaryFullAccuracyAuthorization" -> core.UserControlledData
    source method "startMonitoringForRegion" -> core.UserControlledData
    source method "startMonitoringSignificantLocationChanges" -> core.UserControlledData
    source method "startMonitoringVisits" -> core.UserControlledData
    source method "startUpdatingHeading" -> core.UserControlledData
    source method "startUpdatingLocation" -> core.UserControlledData
    control method "accuracyAuthorization" -> core.AuthorizationCheck
    control method "authorizationStatus" -> core.AuthorizationCheck
  }
}
