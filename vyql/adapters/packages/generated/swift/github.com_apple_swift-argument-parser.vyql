import code.{CliArgument, CommandExecution}

adapter swift {
  package "github.com/apple/swift-argument-parser" {
    source method "parse" -> code.CliArgument
    source method "parseOrExit" -> code.CliArgument
    source method "asyncParse" -> code.CliArgument
    source method "asyncParseAsRoot" -> code.CliArgument
    sink method "shellCommand" -> code.CommandExecution
  }
}
