import code.{StoredDataRead, StoredDataWrite, RedirectTarget}
adapter swift {
  package "github.com/supabase-community/storage-swift" {
    sink method "upload" -> code.StoredDataWrite
    sink method "update" -> code.StoredDataWrite
    sink method "move" -> code.StoredDataWrite
    source method "download" -> code.StoredDataRead
    flag code.RedirectTarget on any {
      method "createSignedURL"
    }
    flag code.RedirectTarget on any {
      method "getPublicURL"
    }
    flag code.RedirectTarget on any {
      method "getPublicUrl"
    }
    source method "list" -> code.StoredDataRead
    source method "listBuckets" -> code.StoredDataRead
    source method "getBucket" -> code.StoredDataRead
    sink method "createBucket" -> code.StoredDataWrite
    sink method "emptyBucket" -> code.StoredDataWrite
    sink method "deleteBucket" -> code.StoredDataWrite
  }
}
