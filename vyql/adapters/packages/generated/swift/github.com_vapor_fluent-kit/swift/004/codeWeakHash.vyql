module bindings.swift.migration.m9c81201c;

binding weakHash4 {
  requires {
    dependency("github.com/vapor/fluent-kit")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "update"
  emit issue code.WeakHash at node
}
