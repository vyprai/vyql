module bindings.swift.migration.mb0e718b5;

binding weakHash1 {
  requires {
    dependency("github.com/iosdevzone/IDZSwiftCommonCrypto")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "SHA1"
  emit issue code.WeakHash at node
}
