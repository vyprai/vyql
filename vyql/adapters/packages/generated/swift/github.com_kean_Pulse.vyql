import code.{NetworkData, FilePathAccess, StoredDataWrite}

adapter swift {
  package "github.com/kean/Pulse" {
    source method "dataTask" -> code.NetworkData
    source method "uploadTask" -> code.NetworkData
    source method "downloadTask" -> code.NetworkData
    source method "streamTask" -> code.NetworkData
    source method "webSocketTask" -> code.NetworkData
    source method "dataTaskPublisher" -> code.NetworkData
    source method "data" -> code.NetworkData
    source method "upload" -> code.NetworkData
    source method "download" -> code.NetworkData
    source method "bytes" -> code.NetworkData

    sink method "export" -> code.FilePathAccess
    sink method "storeRequest" -> code.StoredDataWrite
  }
}
