module bindings.swift.migration.m1d687958;

binding privilegedOp1 {
  requires {
    dependency("github.com/trilemma-dev/Blessed")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "authorizeAndBless"
