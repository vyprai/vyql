import code.{NetworkSend, SecretValue}

adapter swift {
  package "github.com/mironal/TwitterAPIKit" {
    sink method "postOAuthRequestToken" -> code.NetworkSend
    source method "postOAuthRequestToken" -> code.SecretValue
    sink method "postOAuthAccessToken" -> code.NetworkSend
    source method "postOAuthAccessToken" -> code.SecretValue
    sink method "postInvalidateAccessToken" -> code.NetworkSend
    sink method "postOAuth2BearerTokenData" -> code.NetworkSend
    source method "postOAuth2BearerTokenData" -> code.SecretValue
    sink method "postOAuth2BearerToken" -> code.NetworkSend
    source method "postOAuth2BearerToken" -> code.SecretValue
    sink method "postInvalidateOAuth2BearerToken" -> code.NetworkSend
    sink method "postOAuth2AccessTokenData" -> code.NetworkSend
    source method "postOAuth2AccessTokenData" -> code.SecretValue
    sink method "postOAuth2AccessToken" -> code.NetworkSend
    source method "postOAuth2AccessToken" -> code.SecretValue
    sink method "postOAuth2RefreshTokenData" -> code.NetworkSend
    source method "postOAuth2RefreshTokenData" -> code.SecretValue
    sink method "postOAuth2RefreshToken" -> code.NetworkSend
    source method "postOAuth2RefreshToken" -> code.SecretValue
    sink method "postOAuth2RevokeToken" -> code.NetworkSend
    sink method "send" -> code.NetworkSend
  }
}
