import code.{Deserialization, NetworkData, NetworkSend, NetworkConnect, NetworkBind}
adapter swift {
  package "github.com/Building42/Telegraph" {
    sink method "parse" -> code.Deserialization
    source method "read" -> code.NetworkData
    sink method "write" -> code.NetworkSend
    sink method "send" -> code.NetworkSend
    sink method "connect" -> code.NetworkConnect
    sink method "start" -> code.NetworkBind
  }
}
