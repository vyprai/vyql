import code.{CliArgument}

adapter swift {
  package "github.com/kylef/Commander" {
    source method "ArgumentParser.init" -> code.CliArgument
    source method "ArgumentParser.shift" -> code.CliArgument
    source method "ArgumentParser.shiftValue" -> code.CliArgument
    source method "ArgumentParser.shiftValues" -> code.CliArgument
    source method "ArgumentParser.hasOption" -> code.CliArgument
    source method "ArgumentParser.hasFlag" -> code.CliArgument
    source method "ArgumentParser.parse" -> code.CliArgument
    source method "Group.run" -> code.CliArgument
    source method "CommandRunner.run" -> code.CliArgument
  }
}
