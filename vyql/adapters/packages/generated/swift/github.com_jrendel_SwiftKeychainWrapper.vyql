import code.{SecretValue, StoredDataRead, StoredDataWrite}
adapter swift {
  package "github.com/jrendel/SwiftKeychainWrapper" {
    source method "string" -> code.SecretValue
    source method "object" -> code.SecretValue
    source method "integer" -> code.SecretValue
    source method "float" -> code.SecretValue
    source method "double" -> code.SecretValue
    source method "bool" -> code.SecretValue
    source method "data" -> code.SecretValue
    source method "dataRef" -> code.SecretValue

    source method "set" -> code.SecretValue
  }
}
