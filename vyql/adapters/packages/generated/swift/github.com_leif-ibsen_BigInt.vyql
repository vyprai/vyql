import code.{WeakRandomValue}

adapter swift {
  package "github.com/leif-ibsen/BigInt" {
    flag code.WeakRandomValue on any {
      method "randomLessThan"
    }
    flag code.WeakRandomValue on any {
      method "randomFrom"
    }
    flag code.WeakRandomValue on any {
      method "randomTo"
    }
  }
}
