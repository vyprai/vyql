import code.{Deserialization, NetworkSend, SecretValue, WeakHash}
import core.{AuthenticationCheck}

adapter swift {
  package "github.com/argentlabs/web3.swift" {
    sink method "decodeData" -> code.Deserialization
    sink method "send" -> code.NetworkSend
    source method "sign" -> code.SecretValue
    control method "authenticate" -> core.AuthenticationCheck
  }
}
