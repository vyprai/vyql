module bindings.swift.migration.m7a39b48f;

binding weakHash1 {
  requires {
    dependency("github.com/vapor/auth")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "hash"
  emit issue code.WeakHash at node
}
