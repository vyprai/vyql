import code.{Deserialization, NetworkConnect, NetworkSend, FilePathAccess, NetworkData}

adapter swift {
  package "github.com/MarcoDotIO/OpenAIKit" {
    sink method "parseSRT" -> code.Deserialization
    sink method "parseWebVTT" -> code.Deserialization
    sink method "connect" -> code.NetworkConnect
    source method "decodeBase64Image" -> core.UserControlledData
    sink method "generateCompletion" -> code.NetworkSend
    sink method "generateChatCompletion" -> code.NetworkSend
    sink method "createImage" -> code.NetworkSend
    sink method "generateImageEdits" -> code.NetworkSend
    sink method "generateImageVariations" -> code.NetworkSend
    sink method "createEmbeddings" -> code.NetworkSend
    sink method "createTranscription" -> code.NetworkSend
    sink method "createTranslation" -> code.NetworkSend
    sink method "uploadFile" -> code.NetworkSend
    source method "retrieveFileContent" -> code.NetworkData
    sink method "send" -> code.NetworkSend
  }
}
