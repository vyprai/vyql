import code.{HttpInput, Deserialization, FileUse, NetworkConnect}
adapter swift {
  package "github.com/RxSwiftCommunity/RxAlamofire" {
    source method "urlRequest" -> code.HttpInput
    source method "request" -> code.HttpInput
    sink method "requestResponse" -> code.Deserialization
    sink method "response" -> code.Deserialization
    sink method "requestData" -> code.Deserialization
    sink method "data" -> code.Deserialization
    sink method "requestString" -> code.Deserialization
    sink method "string" -> code.Deserialization
    sink method "requestJSON" -> code.Deserialization
    sink method "json" -> code.Deserialization
    sink method "requestDecodable" -> code.Deserialization
    sink method "decodable" -> code.Deserialization
    sink method "upload" -> code.FileUse
    sink method "download" -> code.FileUse
  }
}
