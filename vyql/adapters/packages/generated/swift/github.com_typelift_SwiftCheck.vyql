import code.{WeakRandomValue}

adapter swift {
  package "github.com/typelift/SwiftCheck" {
    flag code.WeakRandomValue on any {
      method "randomBound"
    }
    flag code.WeakRandomValue on any {
      method "random"
    }
    flag code.WeakRandomValue on any {
      method "randomInRange"
    }
  }
}
