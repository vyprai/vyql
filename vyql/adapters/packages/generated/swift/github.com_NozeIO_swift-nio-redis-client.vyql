import code.{NetworkSend, NetworkData}

adapter swift {
  package "github.com/NozeIO/swift-nio-redis-client" {
    sink method "subscribe" -> code.NetworkSend
    sink method "psubscribe" -> code.NetworkSend
    sink method "unsubscribe" -> code.NetworkSend
    sink method "punsubscribe" -> code.NetworkSend
    sink method "enqueueCommandCall" -> code.NetworkSend
    source method "onMessage" -> code.NetworkData
  }
}
