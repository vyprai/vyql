import code.{NetworkSend}

adapter swift {
  package "github.com/orlandos-nl/DNSClient" {
    sink method "sendQuery" -> code.NetworkSend
    sink method "initiateAQuery" -> code.NetworkSend
    sink method "initiateAAAAQuery" -> code.NetworkSend
    sink method "initiateNSQuery" -> code.NetworkSend
    sink method "initiateSOAQuery" -> code.NetworkSend
  }
}
