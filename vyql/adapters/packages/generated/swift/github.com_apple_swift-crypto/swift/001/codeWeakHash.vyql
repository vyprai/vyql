module bindings.swift.migration.ma63f91f2;

binding weakHash1 {
  requires {
    dependency("github.com/apple/swift-crypto")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "Digest"
  emit issue code.WeakHash at node
}
