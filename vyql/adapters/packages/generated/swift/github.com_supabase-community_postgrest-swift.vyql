import code.{SqlExecution}
adapter swift {
  package "github.com/supabase-community/postgrest-swift" {
    sink method "from" -> code.SqlExecution
    sink method "rpc" -> code.SqlExecution
    sink method "execute" -> code.SqlExecution
    sink method "select" -> code.SqlExecution
    sink method "insert" -> code.SqlExecution
    sink method "update" -> code.SqlExecution
    sink method "delete" -> code.SqlExecution
    sink method "not" -> code.SqlExecution
    sink method "eq" -> code.SqlExecution
    sink method "neq" -> code.SqlExecution
    sink method "gt" -> code.SqlExecution
    sink method "gte" -> code.SqlExecution
    sink method "lt" -> code.SqlExecution
    sink method "lte" -> code.SqlExecution
    sink method "like" -> code.SqlExecution
    sink method "ilike" -> code.SqlExecution
    sink method "contains" -> code.SqlExecution
    sink method "overlaps" -> code.SqlExecution
    sink method "textSearch" -> code.SqlExecution
    sink method "fts" -> code.SqlExecution
    sink method "plfts" -> code.SqlExecution
    sink method "phfts" -> code.SqlExecution
    sink method "wfts" -> code.SqlExecution
    sink method "filter" -> code.SqlExecution
    sink method "match" -> code.SqlExecution
  }
}
