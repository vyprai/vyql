module bindings.swift.migration.m8d7a68d4;

binding fileUpload2 {
  requires {
    dependency("github.com/vapor-community/sendgrid-kit")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "uploadBulkEmailValidationFile"
  emit issue code.FileUpload at node
  emit source code.FileUploadSource at node
}
