import core.{UserControlledData}
import code.{HttpInput, FilePathAccess, FileUse}

adapter swift {
  package "github.com/hummingbird-project/hummingbird" {
    source method "query" -> core.UserControlledData
    source method "collateBody" -> code.HttpInput
    sink method "loadFile" -> code.FilePathAccess
    sink method "writeFile" -> code.FileUse
  }
}
