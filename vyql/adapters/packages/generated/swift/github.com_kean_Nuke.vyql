import code.{NetworkData, Deserialization, FilePathAccess, StoredDataRead, StoredDataWrite}

adapter swift {
  package "github.com/kean/Nuke" {
    source method "DataLoader.loadData" -> code.NetworkData
    sink method "ImageDecoding.decodePartiallyDownloadedData" -> code.Deserialization
    sink method "ImageDecoders.Video.decode" -> code.Deserialization
    sink method "DataCache.url" -> code.FilePathAccess
    sink method "DataCache.filename" -> code.FilePathAccess
    sink method "DataCache.storeData" -> code.StoredDataWrite
    source method "DataCache.cachedData" -> code.StoredDataRead
    sink method "DataCache.removeData" -> code.FilePathAccess
  }
}
