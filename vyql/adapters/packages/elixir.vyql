import code.{HttpInput, ExternalApiResponse, SecretValue, SqlExecution, NosqlQuery, CommandExecution, CodeEval, Deserialization, FilePathAccess, ArchiveEntryWrite, UrlFetch, XmlParse, XpathQuery, LdapQuery, HtmlRender, TemplateRender, RegexCompile}
import core.{HtmlEscape, SqlParameterization, ShellEscape, PathCanonicalization, XmlHardening, SafeDeserialization, XpathEscape, LdapEscape, RedirectAllowlist, AuthenticationCheck, AuthorizationCheck, CsrfProtection}

adapter elixir {
  package "phoenix" {
    source "params" -> HttpInput
  }
  package "plug" {
    source "conn.params" -> HttpInput
    source "Plug.Conn.get_req_header" -> HttpInput
    control "Plug.CSRFProtection" -> CsrfProtection
  }
  package "elixir" {
    source "System.get_env" -> SecretValue
    sink path "System.cmd" -> CommandExecution
    sink path "Code.eval_string" -> CodeEval
    sink path "Code.eval_file" -> CodeEval
    sink path "File.read" -> FilePathAccess
    sink path "Regex.compile" -> RegexCompile
    control "Path.expand" -> PathCanonicalization
  }
  package "req" {
    source method "body" -> ExternalApiResponse
    sink path "Req.get" -> UrlFetch
  }
  package "httpoison" {
    source method "body" -> ExternalApiResponse
    sink path "HTTPoison.get" -> UrlFetch
  }
  package "ecto_sql" {
    sink path "Ecto.Adapters.SQL.query" -> SqlExecution
    sink method "query!" -> SqlExecution
    control method "parameters" -> SqlParameterization
  }
  package "mongodb_driver" {
    sink method "find" -> NosqlQuery
  }
  package "plug_crypto" {
    sink path "Plug.Crypto.non_executable_binary_to_term" -> Deserialization
  }
  package "erl_tar" {
    sink method "extract" -> ArchiveEntryWrite
  }
  package "sweet_xml" {
    sink path "SweetXml.parse" -> XmlParse
    sink path "SweetXml.xpath" arg 1 -> XpathQuery
    control "SweetXml.parse" val "dtd=false" -> XmlHardening
    control "escape_xpath" -> XpathEscape
  }
  package "eldap" {
    sink method "search" arg 1 -> LdapQuery
    control "encode_for_ldap" -> LdapEscape
  }
  package "phoenix_html" {
    sink path "Phoenix.HTML.raw" -> HtmlRender
    control "Phoenix.HTML.html_escape" -> HtmlEscape
    control "Phoenix.HTML.safe_to_string" -> HtmlEscape
  }
  package "phoenix_view" {
    sink method "render" -> TemplateRender
  }
  package "guardian" {
    control "Guardian.Plug.EnsureAuthenticated" -> AuthenticationCheck
  }
  package "bodyguard" {
    control "Bodyguard.permit" -> AuthorizationCheck
  }
}
