module bindings.javascript.migration.m5c270092;

binding pathCanonicalization54 {
  requires {
    dependency("path")
  }
  query pattern callExpr where callee.path ~= "path.normalize" and args.any.literal contains ".."
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
  }
}
