module bindings.csharp.migration.m2a0e231a;

binding authorizationCheck33 {
  requires {
    dependency("Microsoft.AspNetCore.Authorization")
  }
  query pattern callExpr where callee.path ~= "AuthorizeAttribute"
  emit check core.AuthorizationCheck at call {
    covers path {
      from: call
      to: call
    }
  }
}
