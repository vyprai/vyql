module bindings.csharp.migration.m2a0e231a;

binding csrfProtection32 {
  requires {
    dependency("Microsoft.AspNetCore.Mvc")
  }
  query pattern callExpr where callee.path ~= "ValidateAntiForgeryToken"
  emit check core.CsrfProtection at call {
    covers endpoint {
      anchor: call
    }
  }
}
