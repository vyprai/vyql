module bindings.csharp.migration.m2a0e231a;

binding xmlHardening21 {
  requires {
    dependency("System.Xml")
  }
  query pattern callExpr where callee.path ~= "XmlReaderSettings" and args.any.literal contains "DtdProcessing=Prohibit"
  emit check core.XmlHardening at call {
    covers path {
      from: call
      to: call
    }
  }
}
