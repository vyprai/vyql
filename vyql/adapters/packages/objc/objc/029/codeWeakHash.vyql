module bindings.objc.migration.m942721f9;

binding weakHash29 {
  requires {
    dependency("CommonCrypto")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "CC_MD5"
  emit issue code.WeakHash at node
}
