module bindings.objc.migration.m942721f9;

binding weakCipher31 {
  requires {
    dependency("CommonCrypto")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "CCCrypt" and node.token contains "DES"
  emit issue code.WeakCipher at node
}
