module bindings.objc.migration.m942721f9;

binding certValidationDisabled3 {
  requires {
    dependency("AFNetworking")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "setAllowsAnyHTTPSCertificate" and node.token contains "true"
  emit issue code.CertValidationDisabled at node
}
