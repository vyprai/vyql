  query pattern presenceNode where node.scope == "function" and node.context.name contains "__post_init_code" and node.token contains "self.authorization_code.code_challenge" and node.token contains "self.code_verifier" and node.token contains "new_code_challenge!=self.authorization_code.code_challenge" and not (node.token contains "ifnotself.authorization_code.code_challengeandself.code_verifier")
