binding xmlHardening79 {
  requires {
    dependency("defusedxml")
  }
  query pattern callExpr where callee.path ~= "defusedxml.ElementTree.fromstring"
  emit check core.XmlHardening at call {
    covers path {
      from: call
      to: call
    }
