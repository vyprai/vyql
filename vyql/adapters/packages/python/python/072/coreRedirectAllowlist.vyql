binding redirectAllowlist72 {
  requires {
    dependency("hyperlink")
  }
  query pattern callExpr where callee.path ~= "to_uri.normalize.to_text"
  emit check core.RedirectAllowlist at call {
    covers path {
      from: call
      to: call
    }
  }
}
