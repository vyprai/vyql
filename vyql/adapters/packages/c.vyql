import code.{HttpInput, SecretValue, SqlExecution, CommandExecution, CodeEval, Deserialization, FilePathAccess, ArchiveEntryWrite, UrlFetch, XmlParse, XpathQuery, LdapQuery, HtmlRender, RegexCompile, WeakHash, WeakCipher, CleartextChannel, CertValidationDisabled}
import core.{HtmlEscape, SqlParameterization, ShellEscape, PathCanonicalization, XmlHardening, XpathEscape, LdapEscape}

adapter c {
  package "libc" {
    source "getenv" -> SecretValue
    source "recv" -> HttpInput
    sink path "system" -> CommandExecution
    sink path "popen" -> CommandExecution
    sink path "fopen" -> FilePathAccess
    sink path "fwrite" -> HtmlRender
    sink path "regcomp" arg 1 -> RegexCompile
    control "realpath" -> PathCanonicalization
    control "wordexp" -> ShellEscape
  }
  package "mongoose" {
    source "mg_get_http_var" -> HttpInput
  }
  package "libevent" {
    source "evhttp_find_header" -> HttpInput
  }
  package "fcgi" {
    source "FCGX_GetParam" -> HttpInput
  }
  package "mysqlclient" {
    sink path "mysql_query" arg 1 -> SqlExecution
    control "mysql_real_escape_string" -> SqlParameterization
  }
  package "sqlite" {
    sink path "sqlite3_exec" arg 1 -> SqlExecution
    control "sqlite3_prepare_v2" -> SqlParameterization
  }
  package "libpq" {
    sink path "PQexec" arg 1 -> SqlExecution
    control "PQescapeStringConn" -> SqlParameterization
  }
  package "libdl" {
    sink path "dlopen" -> CodeEval
  }
  package "json-c" {
    sink path "json_tokener_parse" -> Deserialization
  }
  package "libarchive" {
    sink path "archive_read_extract" -> ArchiveEntryWrite
  }
  package "libcurl" {
    sink path "curl_easy_setopt" arg 2 -> UrlFetch
    mark "curl_easy_setopt" val "http://" nval "127.0" -> CleartextChannel
    mark "curl_easy_setopt" val "CURLOPT_SSL_VERIFYPEER=0" -> CertValidationDisabled
  }
  package "libxml2" {
    sink path "xmlReadMemory" -> XmlParse
    sink path "xmlParseFile" -> XmlParse
    sink path "xmlXPathEvalExpression" -> XpathQuery
    control "xmlReadMemory" val "XML_PARSE_NONET" -> XmlHardening
    control "htmlEscape" -> HtmlEscape
    control "xmlEncodeEntitiesReentrant" -> HtmlEscape
  }
  package "openldap" {
    sink path "ldap_search_ext_s" arg 3 -> LdapQuery
    control "ldap_escape" -> LdapEscape
  }
  package "openssl" {
    mark "MD5_Init" -> WeakHash
    mark "SHA1_Init" -> WeakHash
    mark "EVP_des_ede3_cbc" -> WeakCipher
  }
}
