import code.{HttpInput, ExternalApiResponse, SecretValue, SqlExecution, NosqlQuery, CommandExecution, CodeEval, Deserialization, FilePathAccess, ArchiveEntryWrite, UrlFetch, XmlParse, XpathQuery, LdapQuery, HtmlRender, TemplateRender, RegexCompile}
import core.{HtmlEscape, SqlParameterization, ShellEscape, PathCanonicalization, XmlHardening, SafeDeserialization, XpathEscape, LdapEscape, RedirectAllowlist, AuthenticationCheck, AuthorizationCheck, CsrfProtection}

adapter ruby {
  package "rails" {
    source "params" -> HttpInput
    sink method "render" -> TemplateRender
    control "redirect_back_or_to" -> RedirectAllowlist
    control "protect_from_forgery" -> CsrfProtection
  }
  package "rack" {
    source "request.params" -> HttpInput
    source "env" -> HttpInput
  }
  package "dotenv" {
    source "ENV" -> SecretValue
  }
  package "faraday" {
    source method "body" -> ExternalApiResponse
    sink path "Faraday.get" -> UrlFetch
  }
  package "activerecord" {
    sink method "find_by_sql" -> SqlExecution
    sink method "where" -> SqlExecution
    control "sanitize_sql_array" -> SqlParameterization
  }
  package "pg" {
    sink method "execute" -> SqlExecution
  }
  package "mysql2" {
    sink method "execute" -> SqlExecution
  }
  package "mongo" {
    sink method "find" -> NosqlQuery
  }
  package "ruby" {
    sink path "system" -> CommandExecution
    sink path "eval" -> CodeEval
    sink path "Marshal.load" -> Deserialization
    sink path "File.read" -> FilePathAccess
    sink path "Regexp.new" -> RegexCompile
    control "File.expand_path" -> PathCanonicalization
  }
  package "open3" {
    sink path "Open3.capture3" -> CommandExecution
  }
  package "psych" {
    sink path "YAML.load" -> Deserialization
    control "YAML.safe_load" -> SafeDeserialization
  }
  package "rubyzip" {
    sink method "extract" -> ArchiveEntryWrite
  }
  package "httparty" {
    sink path "HTTParty.get" -> UrlFetch
  }
  package "nokogiri" {
    sink method "parse" -> XmlParse
    sink method "xpath" -> XpathQuery
    control "Nokogiri.XML" val "NONET" -> XmlHardening
  }
  package "net-ldap" {
    sink method "search" arg 1 -> LdapQuery
    control "ldap_escape" -> LdapEscape
  }
  package "erb" {
    control "ERB.Util.html_escape" -> HtmlEscape
  }
  package "cgi" {
    control "CGI.escapeHTML" -> HtmlEscape
  }
  package "rails-html-sanitizer" {
    control method "sanitize" -> HtmlEscape
  }
  package "shellwords" {
    control "Shellwords.escape" -> ShellEscape
  }
  package "devise" {
    control method "authenticate_user!" -> AuthenticationCheck
  }
  package "pundit" {
    control method "authorize" -> AuthorizationCheck
  }
}
