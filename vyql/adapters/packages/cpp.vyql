import code.{HttpInput, SecretValue, SqlExecution, NosqlQuery, CommandExecution, CodeEval, Deserialization, FilePathAccess, ArchiveEntryWrite, UrlFetch, XmlParse, XpathQuery, LdapQuery, HtmlRender, TemplateRender, RegexCompile, WeakHash, WeakCipher, CleartextChannel, CertValidationDisabled}
import core.{HtmlEscape, SqlParameterization, ShellEscape, PathCanonicalization, XmlHardening, SafeDeserialization, XpathEscape, LdapEscape, AuthenticationCheck, AuthorizationCheck}

adapter cpp {
  package "libc" {
    source "getenv" -> SecretValue
    sink path "std.system" -> CommandExecution
  }
  package "crow" {
    source "crow.request" -> HttpInput
  }
  package "cpp-httplib" {
    source "httplib.Request" -> HttpInput
  }
  package "pistache" {
    source "Pistache.Rest.Request" -> HttpInput
  }
  package "cpr" {
    source method "body" -> HttpInput
    sink method "Get" -> UrlFetch
  }
  package "mysqlclient" {
    sink path "mysql_query" arg 1 -> SqlExecution
    control "mysql_real_escape_string" -> SqlParameterization
  }
  package "sqlite" {
    sink path "sqlite3_exec" arg 1 -> SqlExecution
    control "sqlite3_prepare_v2" -> SqlParameterization
  }
  package "libpq" {
    sink path "PQexec" arg 1 -> SqlExecution
    control "PQescapeStringConn" -> SqlParameterization
  }
  package "mongocxx" {
    sink method "find" -> NosqlQuery
  }
  package "boost" {
    sink path "boost.process" -> CommandExecution
    control "boost.filesystem.canonical" -> PathCanonicalization
    control "boost.process.quote" -> ShellEscape
  }
  package "libdl" {
    sink path "dlopen" -> CodeEval
  }
  package "yaml-cpp" {
    sink method "Load" -> Deserialization
  }
  package "nlohmann-json" {
    sink method "parse" -> Deserialization
  }
  package "std" {
    sink path "std.ifstream" -> FilePathAccess
    sink path "std.regex" -> RegexCompile
    control "std.filesystem.canonical" -> PathCanonicalization
  }
  package "libarchive" {
    sink method "extract" -> ArchiveEntryWrite
  }
  package "libcurl" {
    sink path "curl_easy_setopt" arg 2 -> UrlFetch
    flag CleartextChannel on any {
      path "curl_easy_setopt"
      has "http://"
      lacks "127.0"
    }
    flag CertValidationDisabled on any {
      path "curl_easy_setopt"
      has "CURLOPT_SSL_VERIFYPEER=0"
    }
  }
  package "libxml2" {
    sink path "xmlReadMemory" -> XmlParse
    sink path "xmlXPathEvalExpression" -> XpathQuery
    control "xmlReadMemory" val "XML_PARSE_NONET" -> XmlHardening
  }
  package "openldap" {
    sink path "ldap_search_ext_s" arg 3 -> LdapQuery
    control "ldap_escape" -> LdapEscape
  }
  package "inja" {
    sink method "render" -> TemplateRender
    control "inja.escape" -> HtmlEscape
  }
  package "openssl" {
    flag WeakHash on any {
      path "EVP_md5"
    }
    flag WeakHash on any {
      path "EVP_sha1"
    }
    flag WeakCipher on any {
      path "EVP_des_ede3_cbc"
    }
  }
  package "jwt-cpp" {
    control "jwt.verify" -> AuthenticationCheck
  }
  package "poco" {
    control "poco.authorize" -> AuthorizationCheck
  }
}
