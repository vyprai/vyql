module bindings.c.migration.m2816daee;

binding certValidationDisabled23 {
  requires {
    dependency("libcurl")
  }
  query pattern presenceNode where node.kind == "any" and node.path ~= "curl_easy_setopt" and node.token contains "CURLOPT_SSL_VERIFYPEER=0"
  emit issue code.CertValidationDisabled at node
}
