module bindings.c.migration.m2816daee;

binding weakHash33 {
  requires {
    dependency("openssl")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "SHA1_Init"
  emit issue code.WeakHash at node
}
