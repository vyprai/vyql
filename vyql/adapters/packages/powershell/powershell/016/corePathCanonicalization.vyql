module bindings.powershell.migration.m92132a18;

binding pathCanonicalization16 {
  requires {
    dependency("Microsoft.PowerShell.Management")
  }
  query pattern callExpr where callee.path ~= "Resolve-Path"
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
  }
}
