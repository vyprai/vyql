module bindings.java.migration.m9ef49b0f;

binding pathCanonicalization41 {
  requires {
    dependency("commons-io")
  }
  query pattern callExpr where callee.path ~= "FilenameUtils.normalize"
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
  }
}
