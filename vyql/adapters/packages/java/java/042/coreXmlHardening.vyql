module bindings.java.migration.m9ef49b0f;

binding xmlHardening42 {
  requires {
    dependency("javax.xml.parsers")
  }
  query pattern callExpr where callee.path ~= "DocumentBuilderFactory.setFeature"
  emit check core.XmlHardening at call {
    covers path {
      from: call
      to: call
    }
  }
}
