module bindings.java.migration.m9ef49b0f;

binding unparameterizedSqlQueryParser14 {
  requires {
    dependency("neo.dbaccess")
  }
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "function_name:execute" and node.token contains "call_path:t.getConnection.prepareStatement" and node.token contains "call_path:st.executeQuery" and not (node.scopeCall.any contains "setString")
  emit issue code.UnparameterizedSqlQueryParser at node
}
