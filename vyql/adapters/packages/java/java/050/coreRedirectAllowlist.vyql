module bindings.java.migration.m9ef49b0f;

binding redirectAllowlist50 {
  requires {
    dependency("commons-validator")
  }
  query pattern callExpr where callee.path ~= "UrlValidator.isValid"
  emit check core.RedirectAllowlist at call {
    covers path {
      from: call
      to: call
    }
  }
}
