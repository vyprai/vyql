// ruby framework adapter (docs/07) — framework→concept content.
// frameworks: rails, sinatra, grape, hanami, padrino
adapter ruby {
  meta { fidelity: resolved }

  source "ARGV" -> code.CliArgument
  source "gets" -> code.StdinInput
  source "STDIN" -> code.StdinInput
  source "params" -> code.HttpInput
  source "cookies" -> code.HttpInput
  source "session" -> code.HttpInput
  source "request.params" -> code.HttpInput
  source "request.body" -> code.HttpInput
  source "request.query_parameters" -> code.HttpInput
  source "request.request_parameters" -> code.HttpInput
  source "request.GET" -> code.HttpInput
  source "request.POST" -> code.HttpInput
  source "request.env" -> code.HttpInput
  source "request.headers" -> code.HttpInput
  source "request.path_parameters" -> code.HttpInput
  source "request.raw_post" -> code.HttpInput
  source path "analysis.parameter.entry" val "function_name:process" val "param_name:target" -> code.HttpInput
  source "request.query_string" -> code.HttpInput

  // stored / second-order data — ActiveRecord reads (CWE-79 stored XSS when rendered
  // via raw/html_safe). AR-specific finders only (bare .find/.first hit Array too).
  source method "find_by" -> code.DatabaseRead
  source method "find_by_sql" -> code.DatabaseRead
  source method "where" -> code.DatabaseRead
  source method "pluck" -> code.DatabaseRead
  source "ENV" -> code.SecretValue
  source "Rails.application.secrets" -> code.SecretValue
  source "credentials" -> code.SecretValue
  flag code.HardcodedSecret in module {
    lang "ruby"
    assign contains_any ["config.secret_token="]
    not assign contains_any ["config.secret_token=ENV", "config.secret_token=Rails.application.credentials", "config.secret_token=credentials"]
    not expr "Rails.env=='test'"
    not call path "ENV.fetch"
    not call path "ENV.[]"
    not call path "SecureRandom.hex"
  }

  sink method "where" -> code.SqlExecution
  sink method "execute" -> code.SqlExecution
  sink method "find_by_sql" -> code.SqlExecution
  sink method "exec_query" -> code.SqlExecution
  sink method "select_all" -> code.SqlExecution
  sink method "select_rows" -> code.SqlExecution
  sink method "select_values" -> code.SqlExecution
  sink method "select_one" -> code.SqlExecution
  sink method "delete_all" -> code.SqlExecution
  sink method "update_all" -> code.SqlExecution
  sink method "pluck" -> code.SqlExecution
  sink method "count_by_sql" -> code.SqlExecution
  sink method "order" -> code.SqlExecution
  sink method "group" -> code.SqlExecution
  sink method "having" -> code.SqlExecution
  sink method "from" -> code.SqlExecution
  sink method "joins" -> code.SqlExecution
  sink method "exec_update" -> code.SqlExecution
  sink method "exec_delete" -> code.SqlExecution
  sink method "exec_insert" -> code.SqlExecution
  sink method "find" -> code.ObjectLookupByUserInput
  sink method "find_by_id" -> code.ObjectLookupByUserInput
  sink method "find_by!" -> code.ObjectLookupByUserInput
  // CSRF (CWE-352, RF-003) — security-sensitive state-changing operations (low-FP scope)
  sink method "change_password" -> code.StateChangingOp
  sink method "update_password" -> code.StateChangingOp
  sink method "reset_password" -> code.StateChangingOp
  sink method "change_email" -> code.StateChangingOp
  sink method "transfer_funds" -> code.StateChangingOp
  sink method "delete_account" -> code.StateChangingOp
  sink method "grant_role" -> code.StateChangingOp
  sink method "make_admin" -> code.StateChangingOp
  flag code.AuthenticationRequiredOp on any {
    path "change_password"
  }
  flag code.AuthenticationRequiredOp on any {
    path "update_password"
  }
  flag code.AuthenticationRequiredOp on any {
    path "reset_password"
  }
  flag code.AuthenticationRequiredOp on any {
    path "change_email"
  }
  flag code.AuthenticationRequiredOp on any {
    path "transfer_funds"
  }
  flag code.AuthenticationRequiredOp on any {
    path "delete_account"
  }
  flag code.AuthenticationRequiredOp on any {
    path "grant_role"
  }
  flag code.AuthenticationRequiredOp on any {
    path "make_admin"
  }
  // CSRF protection — explicit token verification (guards RF-003 via a PROTECTS edge)
  control "protect_from_forgery" -> core.CsrfProtection
  control "verify_authenticity_token" -> core.CsrfProtection
  control "validate_csrf_token" -> core.CsrfProtection
  control "authenticate_user!" -> core.AuthenticationCheck
  control "require_auth" -> core.AuthenticationCheck
  control "ensure_authenticated" -> core.AuthenticationCheck
  control "signed_in?" -> core.AuthenticationCheck
  control "action_auth_level" -> core.AuthorizationCheck
  // authorization checks (guards BIZ-001) — Pundit/CanCan predicates (path-sensitive via B1).
  control "authorize" -> core.AuthorizationCheck
  control "authorize!" -> core.AuthorizationCheck
  control "check_ownership" -> core.OwnershipCheck
  control "require_owner" -> core.OwnershipCheck
  control "owns_resource?" -> core.OwnershipCheck
  // Sequel raw SQL (DB.fetch / DB.run / DB['...'])
  sink path "DB.fetch" -> code.SqlExecution
  sink path "DB.run" -> code.SqlExecution
  sink path "DB.execute" -> code.SqlExecution
  sink path "system" -> code.CommandExecution
  sink path "exec" -> code.CommandExecution
  sink path "spawn" -> code.CommandExecution
  sink path "Kernel.system" -> code.CommandExecution
  sink path "Kernel.exec" -> code.CommandExecution
  sink path "Kernel.spawn" -> code.CommandExecution
  sink path "Kernel.open" -> code.RubyPipeOpenCommandExecution
  sink path "IO.popen" -> code.CommandExecution
  sink path "IO.foreach" -> code.CommandExecution
  sink path "URI.open" -> code.CommandExecution
  sink path "Open3.capture2" -> code.CommandExecution
  sink path "Open3.capture2e" -> code.CommandExecution
  sink path "Open3.capture3" -> code.CommandExecution
  sink path "Open3.popen2" -> code.CommandExecution
  sink path "Open3.popen3" -> code.CommandExecution
  sink path "Open3.pipeline" -> code.CommandExecution
  sink path "Process.spawn" -> code.CommandExecution
  sink path "PTY.spawn" -> code.CommandExecution
  sink path "syscall" -> code.CommandExecution
  sink path "eval" -> code.CodeEval
  sink path "instance_eval" -> code.CodeEval
  sink path "class_eval" -> code.CodeEval
  sink path "module_eval" -> code.CodeEval
  sink path "instance_exec" -> code.CodeEval
  sink path "class_exec" -> code.CodeEval
  sink path "binding.eval" -> code.CodeEval
  sink path "Marshal.load" -> code.Deserialization
  sink path "Marshal.restore" -> code.Deserialization
  sink path "YAML.load" -> code.Deserialization
  sink path "YAML.load_stream" -> code.Deserialization
  sink path "Psych.load" -> code.Deserialization
  sink path "Oj.load" -> code.Deserialization
  sink path "JSON.load" -> code.Deserialization
  sink path "ActiveSupport.JSON.decode" -> code.Deserialization
  sink path "Net.HTTP.get" -> code.UrlFetch
  sink path "Net.HTTP.get_response" -> code.UrlFetch
  sink path "Net.HTTP.start" -> code.UrlFetch
  sink path "Net.HTTP.post" -> code.UrlFetch
  sink path "HTTParty.get" -> code.UrlFetch
  sink path "HTTParty.post" -> code.UrlFetch
  sink path "RestClient.get" -> code.UrlFetch
  sink path "RestClient.post" -> code.UrlFetch
  sink path "open" -> code.UrlFetch
  sink path "URI.open" -> code.UrlFetch
  sink path "URI.parse" -> code.UrlFetch
  sink path "Faraday.get" -> code.UrlFetch
  sink path "Faraday.post" -> code.UrlFetch
  sink path "Excon.get" -> code.UrlFetch
  sink path "Typhoeus.get" -> code.UrlFetch
  sink path "HTTP.get" -> code.UrlFetch
  sink path "File.read" -> code.FilePathAccess
  sink path "File.open" -> code.FilePathAccess
  sink path "File.write" -> code.FilePathAccess
  sink path "File.delete" -> code.FilePathAccess
  sink path "File.new" -> code.FilePathAccess
  sink path "IO.read" -> code.FilePathAccess
  sink path "IO.write" -> code.FilePathAccess
  sink path "FileUtils.cp" -> code.FilePathAccess
  sink path "FileUtils.mv" -> code.FilePathAccess
  sink path "FileUtils.rm" -> code.FilePathAccess
  sink path "Dir.glob" -> code.FilePathAccess
  sink path "Dir.entries" -> code.FilePathAccess
  sink path "send_file" -> code.FilePathAccess
  sink path "send_data" -> code.FilePathAccess
  sink path "require" -> code.DynamicCodeLoad
  sink path "load" -> code.DynamicCodeLoad
  // unrestricted upload (CWE-434) — common uploaded file helpers and direct writes.
  sink path "uploaded_file.save" -> code.UnsafeUpload
  sink path "file.save" -> code.UnsafeUpload
  sink path "File.write" -> code.UnsafeUpload
  sink method "extract" -> code.ArchiveEntryWrite
  sink path "Zip.File.extract" -> code.ArchiveEntryWrite
  sink path "raw" -> code.HtmlRender
  sink path "html_safe" -> code.HtmlRender
  sink path "render" -> code.HtmlRender
  sink path "content_tag" -> code.HtmlRender
  sink exact "concat" -> code.HtmlRender
  sink path "safe_concat" -> code.HtmlRender
  flag code.ErbHrefInterpolationHtmlEscapeMissing on any {
    path "analysis.erb.unescaped_href_interpolation"
    fact template "erb"
    fact attr "href"
  }
  flag code.ErbHrefUrlHtmlEscapeOnly on any {
    path "analysis.erb.html_escaped_url_href"
    fact template "erb"
    fact attr "href"
    fact value "url-like"
  }
  flag code.RailsRawTranslationHtmlInterpolationXss on call {
    path "raw"
    operand {
      path "t"
    }
    lacks call contains_any ["content_tag", "ERB::Util.html_escape", "ERB::Util.h", "CGI.escapeHTML", "Rack.Utils.escape_html"]
  }
  flag code.StoredHtmlWrite in function {
    lang "ruby"
    name "cama_comments_render_html"
    has "#{comment.content}"
    lacks "sanitize comment.content"
  }
  flag code.UnparameterizedSqlQueryParser in function {
    lang "ruby"
    has "find_by(params"
    lacks "find_by(email:"
  }
  flag code.ChefUserManagementWithoutAdminGuard in class {
    lang "ruby"
    name "Users"
    has "Chef::WebUIUser.cdb_load"
    has "@user.cdb_save"
    has "@user.cdb_destroy"
    lacks "before :is_admin"
  }
  flag code.PersistentConnectionReuseAfterInterruptedResponse in function {
    lang "ruby"
    name "request"
    has "datum=response(datum)"
    has "datum[:persistent]"
    has "reset"
    lacks "@persistent_socket_reusable"
  }
  flag code.UnvalidatedCoordinateSqlInterpolation in function {
    literal "BETWEEN"
    lang "ruby"
    function contains_any ["within_bounding_box", "bounding_box", "bbox"]
    token param_name contains_any ["sw_lat", "southwest_lat", "south_lat", "min_lat", "lat_min"]
    token param_name contains_any ["ne_lat", "northeast_lat", "north_lat", "max_lat", "lat_max"]
    token param_name contains_any ["sw_lng", "sw_lon", "southwest_lng", "southwest_lon", "west_lng", "west_lon", "min_lng", "min_lon", "lng_min", "lon_min"]
    token param_name contains_any ["ne_lng", "ne_lon", "northeast_lng", "northeast_lon", "east_lng", "east_lon", "max_lng", "max_lon", "lng_max", "lon_max"]
    not call path contains_any ["sw_lat.to_f", "southwest_lat.to_f", "south_lat.to_f", "min_lat.to_f", "lat_min.to_f"]
    not call path contains_any ["ne_lat.to_f", "northeast_lat.to_f", "north_lat.to_f", "max_lat.to_f", "lat_max.to_f"]
  }
  flag code.UnboundedNaturalLanguageScheduleParse in function {
    lang "ruby"
    function equals "parse"
    call path "s.strip"
    call path "Parser.parse"
    call path "opts.merge"
    call path "slots.to_crons"
    not call path "s.length"
  }
  sink path "ERB.new" -> code.TemplateRender
  sink path "Erubi.new" -> code.TemplateRender
  sink path "Erubis.new" -> code.TemplateRender
  sink path "Liquid.Template.parse" -> code.TemplateRender
  sink path "Tilt.new" -> code.TemplateRender
  sink path "redirect_to" -> code.RedirectTarget
  sink path "redirect" -> code.RedirectTarget
  flag code.ClockworkWebJobCsrf in class {
    lang "ruby"
    name "HomeController"
    has "params[:job]"
    has "params[:enable]"
    has "ClockworkWeb.enable(job)"
    has "ClockworkWeb.disable(job)"
    lacks "protect_from_forgery"
  }
  flag code.RailsBasicAuthWeakCsrfStrategy in class {
    lang "ruby"
    class base "ActionController.Base"
    call path "protect_from_forgery"
    call path "http_basic_authenticate_with"
    not call arg "protect_from_forgery:with=exception"
  }
  flag code.ColorscoreImagemagickCommandInjection in function {
    lang "ruby"
    name "initialize"
    has "`convert #{image_path}"
    has "-colors #{colors}"
    has "-depth #{depth}"
    lacks "shellescape"
    lacks "colors.to_i"
    lacks "depth.to_i"
  }
  flag code.WindowsBacktickDiffCommandInjection in function {
    lang "ruby"
    has "WINDOWS"
    has "sprintf"
    has "diff_options.join(' ')"
    has "@paths.map"
    has "cmd"
    lacks "Open3.capture3"
    lacks "Shellwords"
    lacks "shellescape"
  }
  flag code.PostEditReportPrivateContentLeak in function {
    lang "ruby"
    name "report_post_edits"
    has "FROM post_revisions pr"
    has "JOIN posts p"
    has "report.data << revision"
    lacks "Archetype.private_message"
    lacks "secure_category"
  }
  flag code.UnescapedQueueQueryStringXss in function {
    lang "ruby"
    name "url_path"
    has "?queues=#{@queues.join(\",\")}"
    lacks "CGI.escape(@queues.join"
  }
  // HTTP response splitting / header injection (CWE-113).
  sink path "response.set_header" arg 1 -> code.ResponseHeaderWrite
  sink path "headers.__setitem__" arg 1 -> code.ResponseHeaderWrite
  // log injection (CWE-117) + secret-in-log (CWE-532).
  sink path "Rails.logger.info" arg all -> code.LogOutput
  sink path "Rails.logger.warn" arg all -> code.LogOutput
  sink path "Rails.logger.error" arg all -> code.LogOutput
  sink path "logger.info" arg all -> code.LogOutput
  sink path "logger.warn" arg all -> code.LogOutput
  sink path "logger.error" arg all -> code.LogOutput
  flag code.LogWrite on any {
    path "Rails.logger.info"
  }
  flag code.LogWrite on any {
    path "Rails.logger.warn"
  }
  flag code.LogWrite on any {
    path "Rails.logger.error"
  }
  flag code.LogWrite on any {
    path "logger.info"
  }
  flag code.LogWrite on any {
    path "logger.warn"
  }
  flag code.LogWrite on any {
    path "logger.error"
  }
  // CSV/formula injection (CWE-1236).
  sink path "csv.write_row" arg all -> code.CsvCell
  sink path "CSV.generate_line" arg all -> code.CsvCell
  sink path "CSV.open" arg all -> code.CsvCell

  // controls (sanitizers/validators) — neutralize a flow that passes through them
  control "CGI.escapeHTML" -> core.HtmlEscape
  control "ERB.Util.html_escape" -> core.HtmlEscape
  control "ERB.Util.h" -> core.HtmlEscape
  control "Rack.Utils.escape_html" -> core.HtmlEscape
  control "Shellwords.escape" -> core.ShellEscape
  control "Shellwords.shelljoin" -> core.ShellEscape

  // regex compile (ReDoS, CWE-1333) — tainted PATTERN arg0
  sink path "Regexp.new" -> code.RegexCompile
  sink path "Regexp.compile" -> code.RegexCompile
  flag code.RegexMatch on any {
    path "__regex.match"
  }
  flag code.CatastrophicRegex in module {
    lang "ruby"
    literal contains_any ["(?:[^\\\"]|\\\\.)*?", "(?:[^\\\"]|\\\\.)*)"]
    not literal contains_any ["(?:[^\\\"]|\\\\\")*?", "(?:[^\\\"]|\\\\\")*)"]
  }
  flag code.CatastrophicRegex in class {
    lang "ruby"
    literal contains_any ["\\A/([^/]+)/?([^/]+)?\\z", "^/([^/]+)/?([^/]+)?$"]
    call path contains_any ["path.match", "path.match.to_a"]
    not call path "path.split"
    not call path contains_any ["model_id.include", "model_id.include?"]
  }
  flag code.RubyLineAnchorValidationBypass in function {
    lang "ruby"
    name "legal?"
    has "string.to_s"
    has "/^[0-9a-f]{24}$/i"
  }
  flag code.RubyFfiWindowsPosixLibrarySearchPath in function {
    call path "FFI.DynamicLibrary.open"
    lang "ruby"
    function "ffi_lib"
    call path "File.exist?"
    literal "/usr/lib/"
    literal "/usr/local/lib/"
    not call path "FFI.Platform.windows?"
  }

  // mass assignment (CWE-915) — request body -> bulk bind
  sink method "update_attributes" -> code.MassAssign
  sink method "assign_attributes" -> code.MassAssign

  // weak cipher (CWE-327) — named broken ciphers + named-value on Cipher.new("des-cbc")
  flag code.WeakCipher on any {
    path "OpenSSL.Cipher.DES"
  }
  flag code.WeakCipher on any {
    path "OpenSSL.Cipher.RC4"
  }
  flag code.WeakCipher on any {
    path "OpenSSL.Cipher.new"
    has "des"
  }
  flag code.WeakCipher on any {
    path "OpenSSL.Cipher.new"
    has "rc4"
  }
  flag code.WeakCipher on any {
    path "OpenSSL.Cipher.new"
    has "rc2"
  }
  flag code.WeakCipher on any {
    path "OpenSSL.Cipher.new"
    has "bf"
  }
  flag code.WeakCipher on any {
    path "OpenSSL.Cipher.new"
    has "ecb"
  }
  flag code.StaticIv on any {
    path "OpenSSL.Cipher.new"
    has "0000000000000000"
  }
  flag code.StaticIv on any {
    path "cipher.iv"
    has "0000000000000000"
  }

  // weak hash (CWE-327) — MD5/SHA1 digests
  flag code.WeakHash on any {
    path "Digest.MD5"
  }
  flag code.WeakHash on any {
    path "Digest.SHA1"
  }
  flag code.WeakHash on any {
    path "OpenSSL.Digest.MD5"
  }
  flag code.WeakHash on any {
    path "OpenSSL.Digest.SHA1"
  }

  // JWT signature not verified (CWE-347) — JWT.decode(token, nil, false) / algorithm "none"
  flag code.JwtUnverified on any {
    path "JWT.decode"
    has "false"
  }
  flag code.JwtUnverified on any {
    path "JWT.decode"
    fact algorithm "none"
  }
  flag code.JwtUnverified on any {
    path "JWT.encode"
    fact algorithm "none"
  }
  flag code.CsrfDisabled on any {
    path "skip_before_action"
    has "verify_authenticity_token"
  }
  flag code.CertValidationDisabled on any {
    path "verify_mode"
    has "VERIFY_NONE"
  }
  flag code.CertValidationDisabled in function {
    lang "ruby"
    has "SSLContext.new"
    has "ca_file"
    lacks "verify_mode"
  }
  flag code.CertValidationDisabled in function {
    lang "ruby"
    token function_name "create_client_from_token"
    selector "@opts"
    field "verify_ssl=OpenSSL::SSL::VERIFY_NONE"
    call path "detect_version"
    call path "Kubeclient.Client.new"
  }
  flag code.CertValidationDisabled in function {
    lang "ruby"
    call path "Fog.Kubevirt.Compute.new"
    field "kubevirt_verify_ssl=ca_cert.present?"
    lacks field "kubevirt_verify_ssl=true"
  }
  flag code.InsecurePermission on any {
    path "File.chmod"
    has "0777"
  }
  flag code.InsecurePermission on any {
    path "File.chmod"
    has "0666"
  }
  flag code.NetworkFilteringDisabled on any {
    path "command"
    has "bridge-nf-call-iptables"
    has "echo 0"
  }
  flag code.NetworkFilteringDisabled on any {
    path "command"
    has "bridge-nf-call-ip6tables"
    has "echo 0"
  }
  flag code.NetworkFilteringDisabled on any {
    path "command"
    has "bridge-nf-call-arptables"
    has "echo 0"
  }
  flag code.InsecureTempFile on any {
    path "File.open"
    has "/tmp/"
    has "w"
  }
  flag code.ResourceHandle on any {
    path "TCPSocket.open"
  }
  flag code.ResourceHandle on any {
    path "File.open"
  }
  control method "close" -> core.ResourceRelease

  // XPath injection (CWE-643) — Nokogiri doc.xpath(expr) / at_xpath(expr) (distinctive)
  sink method "xpath" -> code.XpathQuery
  sink method "at_xpath" -> code.XpathQuery

  // cleartext channel (CWE-319) — http:// URL to an HTTP client (loopback excluded; low sev)
  flag code.CleartextChannel on any {
    path "HTTParty"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "RestClient"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "open"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "URI.open"
    has "http://"
    lacks "127.0"
  }

  // character-filter: gsub is always global.
  filter method "gsub" global
  flag code.PolymorphicTypeSelectionReview in function {
    lang "ruby"
    has "polymorphic_as"
    has "_type="
    has "params[\"#{polymorphic_as}_type\"]"
    has "model.send"
    lacks "valid_polymorphic_class"
  }
  flag code.ReconfirmationDirtyTrackingRace in function {
    lang "ruby"
    name "postpone_email_change_until_confirmation_and_regenerate_confirmation_token"
    has "self.unconfirmed_email = self.email"
    has "self.email = self.devise_email_in_database"
    has "self.confirmation_token = nil"
    has "generate_confirmation_token"
    lacks "devise_unconfirmed_email_will_change!"
  }
  sink path "search" arg 1 -> code.LdapQuery
  sink path "Net::LDAP" arg 1 -> code.LdapQuery
  sink method "search" arg 1 -> code.LdapQuery
  flag code.WeakRandomValue on any {
    path "Random.rand"
  }
  flag code.WeakRandomValue on any {
    path "rand"
  }
  flag code.InsecureCookie on any {
    path "set_cookie"
    has "false"
  }
  control "validate_role" -> core.InputValidation
  control "ldap_escape" -> core.LdapEscape
  control "xpath_escape" -> core.XpathEscape
  control "File.basename" -> core.PathCanonicalization
}
