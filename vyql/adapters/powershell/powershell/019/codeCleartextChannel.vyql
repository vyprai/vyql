module bindings.powershell.migration.m390f1180;

binding cleartextChannel19 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "wget" and node.token contains "http://" and not (node.token contains "127.0")
  emit issue code.CleartextChannel at node
}
