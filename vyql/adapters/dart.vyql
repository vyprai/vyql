// dart framework adapter (docs/07) — Flutter / dart:io / sqflite / shelf.
// Method calls are selector chains normalized to dotted paths (db.rawQuery).
adapter dart {
  meta { fidelity: resolved }

  // untrusted input
  source "Platform.environment" -> code.EnvVariable
  source "stdin.readLineSync" -> code.StdinInput
  source ".queryParameters" -> code.HttpInput
  source "request.params" -> code.HttpInput
  source "request.headers" -> code.HttpInput
  source ".requestedUri" -> code.HttpInput
  source method "getAll" -> code.StoredDataRead
  source method "getString" -> code.StoredDataRead
  source method "getBool" -> code.StoredDataRead
  source method "getInt" -> code.StoredDataRead
  source method "getDouble" -> code.StoredDataRead
  source method "getStringList" -> code.StoredDataRead

  // persistent storage / preferences
  sink method "setValue" -> code.StoredDataWrite
  sink method "setString" -> code.StoredDataWrite
  sink method "setBool" -> code.StoredDataWrite
  sink method "setInt" -> code.StoredDataWrite
  sink method "setDouble" -> code.StoredDataWrite
  sink method "setStringList" -> code.StoredDataWrite
  sink method "clear" -> code.StoredDataWrite
  sink method "remove" -> code.StoredDataWrite

  // SQL — sqflite raw queries
  sink method "rawQuery" -> code.SqlExecution
  sink method "rawInsert" -> code.SqlExecution
  sink method "rawUpdate" -> code.SqlExecution
  sink method "rawDelete" -> code.SqlExecution
  sink method "execute" -> code.SqlExecution

  // SSRF — package:http / dio (tainted URL)
  sink path "http.get" -> code.UrlFetch
  sink path "http.post" -> code.UrlFetch
  sink path "http.put" -> code.UrlFetch
  sink path "http.head" -> code.UrlFetch
  sink path "http.read" -> code.UrlFetch
  sink path "http.delete" -> code.UrlFetch

  // command execution — dart:io Process (the shell command is arg0 with runInShell)
  sink path "Process.run" arg all collection -> code.CommandExecution
  sink path "Process.runSync" arg all collection -> code.CommandExecution
  sink path "Process.start" arg all collection -> code.CommandExecution

  // path / file — dart:io (the path is the constructor arg0)
  sink path "File" -> code.FilePathAccess
  sink path "Directory" -> code.FilePathAccess
  sink method "extractEntry" -> code.ArchiveEntryWrite
  sink method "extractFile" -> code.ArchiveEntryWrite
  sink path "extractArchiveToDisk" arg all -> code.ArchiveEntryWrite

  // weak hash (CWE-328) — package:crypto md5/sha1.
  mark "md5.convert" -> code.WeakHash
  mark "sha1.convert" -> code.WeakHash
  mark "ParametersWithIV" val "0000000000000000" -> code.StaticIv

  // XSS (CWE-79) — shelf/HTML response writers (the rendered body is the arg)
  sink method "write" arg all -> code.HtmlRender
  sink method "writeln" arg all -> code.HtmlRender

  // LDAP (CWE-90) — package:dartdap search (filter is arg1)
  sink method "search" arg 1 -> code.LdapQuery

  // XPath (CWE-643) — package:xml / xpath evaluate (expression is arg0)
  sink method "evaluate" arg 0 -> code.XpathQuery

  // trust boundary (CWE-501) — untrusted data into the session
  sink method "setAttribute" arg all -> code.TrustBoundary
  sink method "putValue" arg all -> code.TrustBoundary
  sink method "findById" -> code.ObjectLookupByUserInput
  sink method "getUser" -> code.ObjectLookupByUserInput
  sink method "getAccount" -> code.ObjectLookupByUserInput
  mark "changePassword" -> code.AuthenticationRequiredOp
  mark "updatePassword" -> code.AuthenticationRequiredOp
  mark "resetPassword" -> code.AuthenticationRequiredOp
  mark "changeEmail" -> code.AuthenticationRequiredOp
  mark "transferFunds" -> code.AuthenticationRequiredOp
  mark "deleteAccount" -> code.AuthenticationRequiredOp
  mark "grantRole" -> code.AuthenticationRequiredOp
  mark "makeAdmin" -> code.AuthenticationRequiredOp

  // regex compile (ReDoS)
  sink path "RegExp" -> code.RegexCompile

  // insecure cookie (CWE-614) — dart:io Cookie configured insecurely
  mark "setSecure" val "false" -> code.InsecureCookie
  mark "setHttpOnly" val "false" -> code.InsecureCookie
  mark "http.get" val "http://" nval "127.0" -> code.CleartextChannel
  mark "http.post" val "http://" nval "127.0" -> code.CleartextChannel
  mark "http.put" val "http://" nval "127.0" -> code.CleartextChannel
  mark "http.head" val "http://" nval "127.0" -> code.CleartextChannel
  mark "http.read" val "http://" nval "127.0" -> code.CleartextChannel
  mark "http.delete" val "http://" nval "127.0" -> code.CleartextChannel
  mark "badCertificateCallback" val "true" -> code.CertValidationDisabled
  mark "Socket.connect" -> code.ResourceHandle
  mark "File.open" -> code.ResourceHandle
  mark "File.openRead" -> code.ResourceHandle
  mark "File.openWrite" -> code.ResourceHandle
  control method "close" -> core.ResourceRelease

  // weak cipher (CWE-327) — pointycastle BlockCipher with a broken algorithm
  mark "BlockCipher" val "DES" -> code.WeakCipher
  mark "BlockCipher" val "RC4" -> code.WeakCipher
  mark "BlockCipher" val "Blowfish" -> code.WeakCipher

  // insecure randomness (CWE-330) — dart:math Random() (Random.secure() is safe)
  mark exact "Random" -> code.WeakRandomValue

  // controls — sanitizers/validators defined in each generated case's preamble
  control "escapeHtml" -> core.HtmlEscape
  control "escapeXPath" -> core.XpathEscape
  control "encodeForLDAP" -> core.LdapEscape
  control "escapeShell" -> core.ShellEscape
  control "safePath" -> core.PathCanonicalization
  control "validateRole" -> core.InputValidation
  control "requireAuth" -> core.AuthenticationCheck
  control "ensureAuthenticated" -> core.AuthenticationCheck
  control "isAuthenticated" -> core.AuthenticationCheck
  control "checkOwnership" -> core.OwnershipCheck
  control "requireOwner" -> core.OwnershipCheck
}
