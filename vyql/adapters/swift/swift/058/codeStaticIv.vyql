module bindings.swift.migration.m388f23d0;

binding staticIv58 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "AES.GCM.Nonce" and node.token contains "000000000000"
  emit issue code.StaticIv at node
}
