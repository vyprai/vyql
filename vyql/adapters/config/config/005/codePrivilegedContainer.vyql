module bindings.config.migration.m2b6375a9;

binding privilegedContainer5 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "analysis.config.k8s.privileged_container"
  emit issue code.PrivilegedContainer at node
}
