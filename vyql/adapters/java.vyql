  flag code.JenkinsDescriptorPropertyFileValidationMissingPost in function {
    class base "ParameterDescriptor"
    function contains_any ["doCheckPropertyKey", "doCheckDefaultPropertyFile", "doCheckDefaultPropertyKey"]
    token identifier "QueryParameter"
    call path "doCheckPropertyFile"
    not annotation "POST"
    not annotation "RequirePOST"
