// java framework adapter (docs/07) — framework→concept content.
// frameworks: servlet, spring-mvc, jax-rs, jdbc, jpa, spring-jdbc
adapter java {
  meta { match: contains, fidelity: resolved }

  // Handler/framework-supplied params + servlet inputs
  source "System.console.readLine" -> code.StdinInput
  source path "analysis.parameter.entry" val "annotation:GetMapping" -> code.HttpInput
  source path "analysis.parameter.entry" val "annotation:PostMapping" -> code.HttpInput
  source path "analysis.parameter.entry" val "annotation:PutMapping" -> code.HttpInput
  source path "analysis.parameter.entry" val "annotation:DeleteMapping" -> code.HttpInput
  source path "analysis.parameter.entry" val "annotation:PatchMapping" -> code.HttpInput
  source path "analysis.parameter.entry" val "annotation:RequestMapping" -> code.HttpInput
  source path "analysis.parameter.entry" val "annotation:GET" -> code.HttpInput
  source path "analysis.parameter.entry" val "annotation:POST" -> code.HttpInput
  source path "analysis.parameter.entry" val "annotation:PUT" -> code.HttpInput
  source path "analysis.parameter.entry" val "annotation:DELETE" -> code.HttpInput
  source path "analysis.parameter.entry" val "annotation:HEAD" -> code.HttpInput
  source path "analysis.parameter.entry" val "annotation:OPTIONS" -> code.HttpInput
  source path "analysis.parameter.entry" val "annotation:Get" -> code.HttpInput
  source path "analysis.parameter.entry" val "annotation:Post" -> code.HttpInput
  source path "analysis.parameter.entry" val "annotation:Put" -> code.HttpInput
  source path "analysis.parameter.entry" val "annotation:Delete" -> code.HttpInput
  source path "analysis.parameter.entry" val "class_annotation:RestController" -> code.HttpInput
  source path "analysis.parameter.entry" val "class_annotation:Controller" -> code.HttpInput
  source path "analysis.parameter.entry" val "class_annotation:RequestMapping" -> code.HttpInput
  source path "analysis.parameter.entry" val "class_annotation:Path" -> code.HttpInput
  source path "analysis.parameter.entry" val "function_name:isValid" val "has_param_type:ConstraintValidatorContext" val "param_index:0" -> code.HttpInput
  // Servlet / Spring request inputs (receiver name varies → substring match)
  source ".getParameter" -> code.HttpInput
  source ".getParameterValues" -> code.HttpInput
  source ".getParameterMap" -> code.HttpInput
  source ".getHeader" -> code.HttpInput
  source ".getHeaders" -> code.HttpInput
  source ".getQueryString" -> code.HttpInput
  source ".getCookies" -> code.HttpInput
  source ".getInputStream" -> code.HttpInput
  source ".getReader" -> code.HttpInput
  source ".getPathInfo" -> code.HttpInput
  source ".getRequestURI" -> code.HttpInput
  source ".getPart" -> code.HttpInput
  // AOP-intercepted method arguments (org.aopalliance MethodInvocation.getArguments) carry the
  // intercepted business call's runtime data — untrusted in an interceptor (e.g. @DS SpEL
  // routing evaluates them, CVE-2026-7045). Surfaces only if they reach a sink.
  source method "getArguments" -> code.HttpInput
  source receiver "getName" on "ZipEntry" -> code.ArchiveEntryName
  // Android intent / deep-link inputs (attacker-controlled IPC entry points)
  source ".getStringExtra" -> code.IntentInput
  source ".getStringArrayExtra" -> code.IntentInput
  source ".getCharSequenceExtra" -> code.IntentInput
  source ".getBundleExtra" -> code.IntentInput
  source ".getDataString" -> code.IntentInput
  source ".getQueryParameter" -> code.IntentInput
  source ".getQueryParameters" -> code.IntentInput
  source ".getLastPathSegment" -> code.IntentInput

  // receiver-type tracking — a variable assigned `new FileWriter(...)` carries that type so
  // its `.write()` is recognised as a FILE write (not the response-writer XSS sink above).
  type "FileWriter" -> FileWriter
  type "BufferedWriter" -> BufferedWriter
  type "FileOutputStream" -> FileOutputStream
  type "OutputStreamWriter" -> OutputStreamWriter
  type "RandomAccessFile" -> RandomAccessFile
  type "StringWriter" -> StringWriter
  type "CharArrayWriter" -> CharArrayWriter
  type "ByteArrayOutputStream" -> ByteArrayOutputStream
  type "CSVWriter" -> CSVWriter

  // Offset/length range checks must avoid additive overflow before a native or buffer
  // operation consumes the range. The patched idiom checks `offset > len - length`.
  flag code.IntegerSizeArithmetic in function {
    has "expr:offset+length>b.length"
    has "call_path:write"
    lacks "expr:offset>b.length-length"
  }
  flag code.IntegerSizeArithmetic in function {
    has "function_name:crypt_raw"
    has "expr:1<<log_rounds"
    lacks "call:roundsForLogRounds"
  }
  flag code.UnvalidatedRatingRange in function {
    has "function_name:rateTopic"
    has "call_path:registry.rateResource"
    has "call_path:genericArtifact.getPath"
    lacks "MAX_RATE"
    lacks "MIN_RATE"
  }
  flag code.FrameworkRequestBeforeSessionValidation in function {
    has "function_name:doFilter"
    has "call_path:Meteor.build"
    has "call_path:httpReq.getParameter"
    has "call_path:pushContext.getSessionManager.getPushSession"
    has "call_path:httpResp.sendError"
    has "call:RequestImpl"
    has "call_order:Meteor.build>Collections.emptyList"
    has "call_order:Collections.emptyList>httpReq.getParameter"
    lacks "call_order:httpResp.setContentType>Meteor.build"
  }
  flag code.UnvalidatedModelSelection in function {
    has "function_name:addResults"
    has "call_path:request.getParameter"
    has "literal:classifier"
    has "call_path:response.addHeader"
    has "call_path:ners.get.classifyToString"
    lacks "identifier:nerModel"
  }
  flag code.IntegerSizeArithmetic on any {
    path "__binop.shl"
    has "log_rounds"
    has "1"
    lacks "1L"
  }
  flag code.PremasterSecretLengthReview in function {
    has "function_name:safeDecryptPreMasterSecret"
    has "call:doFinal"
    has "call:createSecret"
    has "M[0]"
    lacks "expr:m.length==48"
  }
  flag code.RequestHostUrlValidationBypass in function {
    has "call:getServerName"
    has "call:getHost"
    has "call:equals"
    lacks "call:contains"
  }
  flag code.MultiOptionUrlValidationBypass in function {
    has "function_name:isValidURL"
    has "call_path:isURLRelative"
    has "call_path:buildAbsoluteURL"
    lacks "call_path:validateCallbackURL"
  }
  flag code.ResponseWriterScriptWindowIdXss in function {
    has "function_name:encodeBegin"
    has "call_path:writer.write"
    has "dswh.init"
    has "windowId"
    lacks "call_path:writer.writeText"
  }
  flag code.MissingSessionRotationAfterAuthentication in function {
    has "call:setAuthentication"
    has "call:getSession"
    lacks "call:invalidate"
  }
  flag code.ExpiredCachedAuthTokenReuse in function {
    has "call_path:accessTokenCache.timeout.isBefore"
    has "call_path:ZonedDateTime.now"
    has "selector:accessTokenCache.resource"
    has "call_path:accessToken.getExpiresAtAsInstant"
    has "call_path:expiresAt.minus"
    lacks "call_path:accessTokenCache.timeout.isAfter"
  }
  flag code.PublicKeyHashBindingReview in function {
    has "function_name:correctlySpends"
    has "call:fromPublicOnly"
    has "call:verify"
    has "hashFor"
    lacks "call:sha256hash160"
  }
  flag code.LdapCrlCredentialReuse in function {
    has "function_name:prepareConnectionFactory"
    has "call_path:ConnectionConfig.copy"
    has "call_path:cc.setLdapUrl"
    has "call:DefaultConnectionFactory"
    lacks "call_path:cc.setConnectionInitializers"
  }
  flag code.SessionStoredRedirectTarget in function {
    has "function_name:determineTargetUrl"
    has "SimpleUrlAuthenticationSuccessHandler"
    has "session.getAttribute"
    has "targetUrlSessionAttribute"
    has "targetUrl.substring"
    lacks "Util.isSafeToRedirectTo"
  }
  flag code.JmxRmiRegistryExposure in function {
    has "function_name:createJMXServer"
    has "RMIExporter.EXPORTER_ATTRIBUTE"
    has "configureRMIRegistry"
    has "JMXConnectorServerFactory.newJMXConnectorServer"
    lacks "LocateRegistry.createRegistry"
    lacks "RMIJRMPServerImpl"
  }
  flag code.NodetoolArchiveCommandPrivilegeEscalation in function {
    has "function_name:enableFullQueryLogger"
    has "archiveCommand"
    has "fqlOptions.archive_command"
    has "FullQueryLogger.instance.enableWithoutClean"
    lacks "allow_nodetool_archive_command"
  }
  flag code.CommandStringWrapperExecution in function {
    has "literal:/bin/sh"
    has "literal:-c"
    has "identifier:scriptPath"
    has "expr:scriptPath+ALERT_TITLE_OPTION"
    has "call_path:ProcessUtils.executeScript"
    lacks "call_path:File"
    lacks "call:exists"
    lacks "call:isFile"
  }
  flag code.CommonsCompressBzip2FallbackSortMissing in function {
    has "function_name:blockSort"
    has "call:mainSort"
    has "call:randomiseBlock"
    has "expr:this.workDone>this.workLimit"
    lacks "call:fallbackSort"
  }
  flag code.CordysRequestParamXssFilterDisabled in function {
    has "function_name:jackson2ObjectMapperBuilderCustomizer"
    has "call_path:jacksonObjectMapperBuilder.deserializerByType"
    has "call_path:StringUtils.trim"
    has "call_path:jsonParser.getValueAsString"
    has "call_path:HtmlUtils.htmlEscape"
    has "identifier:escape"
    lacks "call:shouldEscapeXss"
    lacks "identifier:xssFilterUrlList"
  }
  flag code.DotcmsSqlUtilBlacklistBypass in function {
    has "function_name:sanitizeParameter"
    has "call_path:StringEscapeUtils.escapeSql"
    has "identifier:EVIL_SQL_WORDS"
    has "call:isValidSQLCharacter"
    lacks "call:sanitizeSQL"
    lacks "identifier:EVIL_SQL_CONDITION_WORDS"
  }
  flag code.DotcmsFormsOrderBySqlInjection in function {
    has "class_name:ViewFormHandlerAction"
    has "function_name:_loadStructures"
    has "call_path:req.getParameter"
    has "call_path:StructureFactory.getStructuresByUser"
    lacks "call_path:SQLUtil.sanitizeSortBy"
  }
  flag code.UnescapedExceptionMessageMarkup in function {
    has "function_name:parseURL"
    has "call_path:CssFouffa"
    lacks "call:getMessage"
  }
  flag code.UnescapedDiagnosticHtml in function {
    has "call_path:IOUtils.toString"
    has "literal:text/html"
    has "call_path:Fault"
    lacks "call_path:MessageUtils.isRequestor"
    lacks "call_path:StringEscapeUtils.escapeHtml"
    lacks "call_path:HtmlUtils.htmlEscape"
  }
  flag code.JenkinsProjectDisplayNameXss in function {
    has "function_name:getName"
    has "call_path:project.getFullDisplayName"
    lacks "call_path:StringEscapeUtils.escapeHtml"
    lacks "call_path:Util.escape"
  }
  flag code.JenkinsPluginForkedDirectoryBrowserWithoutCsp on any {
    path exact "DirectoryBrowserSupport"
    has "Compare Html Report"
    has "graph.gif"
  }
  sink path "analysis.function.return" val "function_name:determineTargetUrl" val "SimpleUrlAuthenticationSuccessHandler" -> code.RedirectTarget
  control "Util.isSafeToRedirectTo" -> core.RedirectAllowlist

  // SQL — JDBC Statement / Connection / JPA / Spring JdbcTemplate + Android SQLite
  sink method "executeQuery" -> code.SqlExecution
  sink method "executeUpdate" -> code.SqlExecution
  sink method "execute" -> code.SqlExecution
  sink method "executeBatch" -> code.SqlExecution
  sink method "addBatch" -> code.SqlExecution
  sink method "rawQuery" -> code.SqlExecution
  sink method "execSQL" -> code.SqlExecution
  // Android WebView: tainted URL/JS loaded or evaluated (CWE-749)
  sink method "loadUrl" -> code.WebViewLoad
  sink method "loadData" -> code.WebViewLoad
  sink method "loadDataWithBaseURL" arg 1 -> code.WebViewLoad
  sink method "postUrl" -> code.WebViewLoad
  sink method "evaluateJavascript" -> code.WebViewLoad
  // open redirect (CWE-601) — HttpServletResponse.sendRedirect(location); Java had no
  // redirect sink (go/ruby/js do), so request-derived redirect targets were never flagged.
  sink method "sendRedirect" -> code.RedirectTarget
  // exposing a native bridge to WebView content (presence)
  flag code.WebViewJsInterface on any {
    path "addJavascriptInterface"
  }
  sink method "executeLargeUpdate" -> code.SqlExecution
  sink method "prepareStatement" -> code.SqlExecution
  sink method "prepareCall" -> code.SqlExecution
  sink method "createQuery" -> code.SqlExecution
  sink method "createNativeQuery" -> code.SqlExecution
  sink method "queryForObject" -> code.SqlExecution
  sink method "queryForList" -> code.SqlExecution
  sink method "query" -> code.SqlExecution
  // Spring JdbcTemplate query/update family (CWE-89) — all take the SQL as arg 0.
  sink method "queryForRowSet" -> code.SqlExecution
  sink method "queryForMap" -> code.SqlExecution
  sink method "queryForInt" -> code.SqlExecution
  sink method "queryForLong" -> code.SqlExecution
  sink method "queryForStream" -> code.SqlExecution
  sink method "batchUpdate" -> code.SqlExecution
  // Driver/parser helpers that return hand-built SQL literal casts instead of
  // routing text through the shared quoting routine.
  flag code.UnparameterizedSqlQueryParser on any {
    path exact "analysis.function.return"
    has "function_name:toString"
    has "::uuid"
  }
  flag code.UnparameterizedSqlQueryParser on any {
    path exact "analysis.function.return"
    has "function_name:toString"
    has "::point"
  }
  flag code.UnparameterizedSqlQueryParser on any {
    path exact "analysis.function.return"
    has "function_name:toString"
    has "::box"
  }

  // Command execution. arg all: the tainted value can be the command, an argument, or the
  // environment array — Runtime.exec(cmd) / exec(cmdarray, envp), ProcessBuilder(a, b, …),
  // ProcessBuilder.command(list) — so any tainted argument triggers.
  sink method "exec" arg all -> code.CommandExecution
  sink path "Runtime.getRuntime.exec" arg all -> code.CommandExecution
  sink path "ProcessBuilder" arg all -> code.CommandExecution
  sink method "command" arg all -> code.CommandExecution

  // Deserialization
  sink method "readObject" -> code.Deserialization
  sink method "readUnshared" -> code.Deserialization
  sink path "XMLDecoder" -> code.Deserialization
  sink path "XMLDecoder.readObject" -> code.Deserialization
  // Jackson polymorphic / SnakeYAML — untrusted document into a deserializer
  sink method "readValue" -> code.Deserialization
  sink path "yaml.load" -> code.Deserialization
  sink path "Yaml.load" -> code.Deserialization
  flag code.DeserializableInvocationHandler in class {
    has "class_base:InvocationHandler"
    has "call:getMethod"
    has "call:invokeMethod"
    lacks "function_name:readResolve"
    lacks "function_name:readObject"
    lacks "call:NotSerializableException"
  }
  flag code.GsonObjectTypeAdapterRecursiveRead in function {
    has "selector:ObjectTypeAdapter.FACTORY"
    has "identifier:read"
    has "call:read"
    has "call_path:list.add"
    has "call_path:map.put"
    lacks "call:tryBeginNesting"
    lacks "call:readTerminal"
  }
  flag code.UnrestrictedRequestParamDeserialization in function {
    has "function_name:createXStream"
    has "call_path:XStream"
    has "call:registerConverter"
    lacks "call:addDefaultPermissions"
    lacks "call:addPermissions"
    lacks "call:addPermission"
    lacks "call:denyPermission"
  }
  package "org.yaml.snakeyaml" {
    flag code.UnsafeYamlConstructor in class {
      has "class_base:Constructor"
    }
    flag code.UnsafeYamlConstructor on any {
      path exact "org.yaml.snakeyaml.constructor.Constructor"
    }
  }

  // XXE
  sink method "parse" -> code.XmlParse
  sink method "newDocumentBuilder" -> code.XmlParse
  // structural XXE — precise parser-factory construction, flagged unless hardened
  flag code.XmlParserCreate on any {
    method "newSAXParser"
  }
  flag code.XmlParserCreate on any {
    method "newDocumentBuilder"
  }
  flag code.XmlParserCreate on any {
    method "createXMLReader"
  }
  flag code.XmlParserCreate on any {
    method "createXMLStreamReader"
  }
  flag code.XmlParserCreate on any {
    method "createXMLEventReader"
  }
  flag code.XmlParserCreate on any {
    method "newTransformer"
  }
  flag code.XmlParserCreate in function {
    has "call_path:SAXReader"
    has "call_path:reader.read"
    lacks "literal:http://apache.org/xml/features/nonvalidating/load-external-dtd"
    lacks "literal:http://xml.org/sax/features/external-general-entities"
    lacks "literal:http://xml.org/sax/features/external-parameter-entities"
  }
  flag code.XmlParserCreate in function {
    has "call_path:getTaskUnmarshaller.unmarshal"
    lacks "call_path:getXMLStreamReader"
  }
  flag code.CheckstyleExternalParameterEntitiesXxe in function {
    has "function_name:setFeaturesBySystemProperty"
    has "class_name:LoadExternalDtdFeatureProvider"
    has "call_path:factory.setFeature"
    has "identifier:LOAD_EXTERNAL_DTD"
    has "identifier:EXTERNAL_GENERAL_ENTITIES"
    lacks "identifier:EXTERNAL_PARAMETER_ENTITIES"
  }

  // Path / file. `new File(parent, child)` puts the tainted child path at arg 1, and
  // Paths.get(first, …more) / Files.write(path, …) likewise vary the path position — arg all.
  sink path "File" arg all -> code.FilePathAccess
  sink path "Paths.get" arg all -> code.FilePathAccess
  sink path "FileInputStream" -> code.FilePathAccess
  sink path "FileOutputStream" -> code.FilePathAccess
  sink path "FileReader" -> code.FilePathAccess
  sink path "FileWriter" -> code.FilePathAccess
  sink path "RandomAccessFile" -> code.FilePathAccess
  sink path "Files.readAllBytes" -> code.FilePathAccess
  sink path "Files.readAllLines" -> code.FilePathAccess
  sink path "Files.newInputStream" -> code.FilePathAccess
  sink path "Files.newOutputStream" -> code.FilePathAccess
  sink path "Files.newBufferedReader" -> code.FilePathAccess
  sink path "Files.newBufferedWriter" -> code.FilePathAccess
  sink path "Files.write" -> code.FilePathAccess
  sink path "Files.lines" -> code.FilePathAccess
  sink path "Files.delete" -> code.FilePathAccess
  sink path "Files.copy" -> code.FilePathAccess
  sink path "Paths.get" -> code.FilePathAccess
  sink method "extractEntry" -> code.ArchiveEntryWrite
  sink method "transferTo" -> code.UnsafeUpload

  // SSRF
  sink receiver "openConnection" -> code.UrlFetch
  sink method "getForObject" -> code.UrlFetch
  sink method "getForEntity" -> code.UrlFetch
  sink method "findById" -> code.ObjectLookupByUserInput
  sink method "getReferenceById" -> code.ObjectLookupByUserInput
  sink method "getAccount" -> code.ObjectLookupByUserInput
  sink method "getOrder" -> code.ObjectLookupByUserInput
  flag code.AuthenticationRequiredOp on any {
    path "changePassword"
  }
  flag code.AuthenticationRequiredOp on any {
    path "updatePassword"
  }
  flag code.AuthenticationRequiredOp on any {
    path "resetPassword"
  }
  flag code.AuthenticationRequiredOp on any {
    path "changeEmail"
  }
  flag code.AuthenticationRequiredOp on any {
    path "transferFunds"
  }
  flag code.AuthenticationRequiredOp on any {
    path "deleteAccount"
  }
  flag code.AuthenticationRequiredOp on any {
    path "grantRole"
  }
  flag code.AuthenticationRequiredOp on any {
    path "makeAdmin"
  }

  // Code eval / scripting
  sink method "eval" -> code.CodeEval

  // XPath injection (CWE-643) — javax.xml.xpath: XPath.evaluate(expr, doc) / XPath.compile(expr)
  // and the JAXP XPathExpression returned by compile. The expression string (arg 0) is injectable.
  sink method "evaluate" arg 0 on XPath -> code.XpathQuery
  sink method "compile" arg 0 on XPath -> code.XpathQuery
  sink path "XPath.evaluate" arg 0 -> code.XpathQuery
  sink path "XPath.compile" arg 0 -> code.XpathQuery

  // LDAP injection (CWE-90) — JNDI DirContext.search(name, filter, controls): the FILTER
  // (arg 1) is injectable. Typed sink (on DirContext) + unambiguous dotted ctor forms.
  sink method "search" arg 1 on DirContext -> code.LdapQuery
  sink path "InitialDirContext.search" arg 1 -> code.LdapQuery
  sink path "InitialLdapContext.search" arg 1 -> code.LdapQuery

  // controls (sanitizers/validators)
  // authorization checks (guards BIZ-001) — Spring Security predicates (path-sensitive via B1).
  control "hasPermission" -> core.AuthorizationCheck
  control "hasAuthority" -> core.AuthorizationCheck
  control "hasRole" -> core.AuthorizationCheck
  control "checkPermission" -> core.AuthorizationCheck
  control method "hasPermission" -> core.AuthorizationCheck
  control method "hasAuthority" -> core.AuthorizationCheck
  control method "hasRole" -> core.AuthorizationCheck
  control method "checkPermission" -> core.AuthorizationCheck
  control "analysis.function.context" val "annotation:RequiresPermissions" -> core.AuthorizationCheck
  control "analysis.function.context" val "annotation:PreAuthorize" -> core.AuthorizationCheck
  flag code.SensitiveOperation on any {
    path "Login.accurevLoginFromGlobalConfig"
  }
  // Accumulo-style permission gates: a bare can* call is not a guard unless its false
  // result stops the operation. Surface ignored results for review; treat throw-on-false
  // contexts as authorization checks.
  flag code.IgnoredAuthorizationResult in function {
    has "call:canFlush"
    lacks "call:ThriftSecurityException"
  }
  flag code.IgnoredAuthorizationResult in function {
    has "call:canPerformSystemActions"
    lacks "call:ThriftSecurityException"
  }
  flag code.IgnoredAuthorizationResult in function {
    has "call:canAlterNamespace"
    lacks "call:ThriftSecurityException"
  }
  flag code.IgnoredAuthorizationResult in function {
    has "call:canAlterTable"
    lacks "call:ThriftSecurityException"
  }
  flag code.IgnoredAuthorizationResult in function {
    has "call:canObtainDelegationToken"
    lacks "call:ThriftSecurityException"
  }
  control "analysis.function.context" val "call:canFlush" val "call:ThriftSecurityException" -> core.AuthorizationCheck
  control "analysis.function.context" val "call:canPerformSystemActions" val "call:ThriftSecurityException" -> core.AuthorizationCheck
  control "analysis.function.context" val "call:canAlterNamespace" val "call:ThriftSecurityException" -> core.AuthorizationCheck
  control "analysis.function.context" val "call:canAlterTable" val "call:ThriftSecurityException" -> core.AuthorizationCheck
  control "analysis.function.context" val "call:canObtainDelegationToken" val "call:ThriftSecurityException" -> core.AuthorizationCheck
  flag code.CredentialedEndpointReview in function {
    has "function_name:doTest"
    has "call:setCredentialsId"
    has "call:accurevLoginFromGlobalConfig"
    lacks "call:hasPermission"
    lacks "call:checkPermission"
  }
  flag code.CredentialedEndpointReview in function {
    has "function_name:doFill"
    has "call:getBzmUtils"
    lacks "call:checkPermission"
  }
  flag code.CredentialedEndpointReview in function {
    has "function_name:doFillCredentialsIdItems"
    has "call:lookupCredentials"
    lacks "call:hasPermission"
    lacks "call:checkPermission"
  }
  flag code.JenkinsDescriptorConfigEnumerationMissingPermission in function {
    has "function_name:doFillConnectionIdItems"
    has "call:getHostConnections"
    lacks "call:hasPermission"
    lacks "call:checkPermission"
  }
  flag code.JenkinsDescriptorConfigEnumerationMissingPermission in function {
    has "function_name:doFillCredentialsIdItems"
    has "call:lookupCredentials"
    lacks "call:hasPermission"
    lacks "call:checkPermission"
  }
  flag code.CodeDxJenkinsRemoteValidationMissingPostPermission in function {
    has "function_name:doCheckUrl"
    has "call:buildClient"
    has "call:getProjects"
    lacks "annotation:POST"
    lacks "call:checkPermissionForRemoteRequests"
  }
  flag code.CodeDxJenkinsRemoteValidationMissingPostPermission in function {
    has "function_name:doCheckSelfSignedCertificateFingerprint"
    has "call:buildClient"
    has "call:getProjects"
    lacks "annotation:POST"
    lacks "call:checkPermissionForRemoteRequests"
  }
  flag code.CodeDxJenkinsRemoteValidationMissingPostPermission in function {
    has "function_name:doFillProjectIdItems"
    has "call:buildClient"
    has "call:getProjects"
    lacks "annotation:POST"
    lacks "call:checkPermissionForRemoteRequests"
  }
  flag code.JenkinsRemoteValidationMissingPermission in function {
    has "function_name:doTestDynatraceConnection"
    has "annotation:RequirePOST"
    has "call:DynatraceClient"
    has "call:getSystemProfiles"
    lacks "call:checkPermission"
    lacks "call:hasPermission"
  }
  flag code.JenkinsRemoteValidationMissingPermission in function {
    has "function_name:doCheck"
    has "annotation:RequirePOST"
    has "call:DynatraceClient"
    has "call:getSystemProfiles"
    lacks "call:checkPermission"
    lacks "call:hasPermission"
  }
  flag code.JenkinsRemoteValidationMissingPostPermission in function {
    has "function_name:doTest"
    has "call:testConnection"
    has "call:CrowdConfigurationService"
    lacks "annotation:POST"
    lacks "call:checkPermission"
    lacks "call:hasPermission"
  }
  flag code.JenkinsRemoteValidationMissingPostPermission in function {
    has "function_name:doCheck"
    has "call:testConnection"
    has "call:CrowdConfigurationService"
    lacks "annotation:POST"
    lacks "call:checkPermission"
    lacks "call:hasPermission"
  }
  flag code.JenkinsRemotingCallableSystemPropertiesLeak in class {
    has "class_base:Callable"
    has "function_name:call"
    has "function_name:checkRoles"
    has "call_path:System.getProperties"
    lacks "class_base:MasterToSlaveCallable"
    lacks "call:Roles.SLAVE"
  }
  flag code.SecretDatabindingReview on any {
    path exact "analysis.parameter.entry"
    has "param_name:awsSecretKey"
    has "param_type:Secret"
  }
  flag code.SecretDatabindingReview in function {
    has "function_name:setAkid"
    lacks "call:fromString"
  }
  flag code.SecretDatabindingReview in function {
    has "function_name:setSkid"
    lacks "call:fromString"
  }
  flag code.JenkinsPlaintextDataboundCredential on any {
    path exact "analysis.parameter.entry"
    has "annotation:DataBoundConstructor"
    has "param_name:apilogin"
    has "param_type:String"
    lacks "param_type:Secret"
  }
  flag code.JenkinsPlaintextDataboundCredential on any {
    path exact "analysis.parameter.entry"
    has "annotation:DataBoundConstructor"
    has "param_name:apitoken"
    has "param_type:String"
    lacks "param_type:Secret"
  }
  flag code.JenkinsCredentialsStartupLoadContextExposure in class {
    has "class_name:SystemCredentialsProvider"
    has "function_name:SystemCredentialsProvider"
    has "call_path:xml.unmarshal"
    has "call_path:DomainCredentials.migrateListToMap"
    has "function_name:getInstance"
    lacks "annotation:Initializer"
    lacks "function_name:forceLoadDuringStartup"
  }
  flag code.JdbcCredentialAttributeExposure in function {
    has "function_name:connect"
    has "call:tokenizeDatabase"
    has "call:tokenizeURLProperties"
    has "call:NetConnection"
    lacks "call:appendDatabaseAttributes"
  }
  flag code.SensitiveOperation in function {
    has "function_name:doConfigure"
    has "call:configure"
    has "call:save"
    lacks "call:checkPermission"
  }
  flag code.SensitiveOperation in function {
    has "function_name:doAttachPublicIP"
    has "call:getNode"
    has "call:attachPublicIP"
    lacks "call:checkPermission"
  }
  flag code.PluginManagementMissingAuthorization in function {
    has "annotation:PostMapping"
    has "call_path:pluginService.localInstall"
    lacks "annotation:RequiresPermissions"
    lacks "annotation:PreAuthorize"
    lacks "call:checkPermission"
    lacks "call:hasPermission"
  }
  flag code.PluginManagementMissingAuthorization in function {
    has "annotation:PostMapping"
    has "call_path:pluginService.uninstall"
    lacks "annotation:RequiresPermissions"
    lacks "annotation:PreAuthorize"
    lacks "call:checkPermission"
    lacks "call:hasPermission"
  }
  flag code.StateChangingOp in function {
    has "function_name:doFill"
    lacks "call:checkPermission"
    lacks "annotation:POST"
    lacks "annotation:RequirePOST"
  }
  flag code.AbsolutePathDisclosure in function {
    has "selector:Constants.MC_REALPATH"
    has "selector:Constants.MC_RELATIVE_PATH"
    has "call:FileReader"
    lacks "call:FileNotFoundException"
  }
  // Jenkins project workspace access requires an explicit item permission check in
  // descriptor/form-validation paths.
  flag code.SensitiveOperation on any {
    method "getSomeWorkspace"
  }
  control method "requireAuth" -> core.AuthenticationCheck
  control method "ensureAuthenticated" -> core.AuthenticationCheck
  control method "isAuthenticated" -> core.AuthenticationCheck
  control method "authenticate" -> core.AuthenticationCheck
  control method "checkOwnership" -> core.OwnershipCheck
  control method "requireOwner" -> core.OwnershipCheck
  control method "isOwner" -> core.OwnershipCheck
  flag code.LockAcquire on any {
    method "lock"
  }
  control method "unlock" -> core.LockRelease
  control "validateRole" -> core.InputValidation
  // XXE hardening — a parser factory configured to disallow DOCTYPE / external entities,
  // dominating the parse (value-matched feature flag).
  control "setFeature" val "disallow-doctype-decl" -> core.XmlHardening
  control "setFeature" val "external-general-entities" nval "true" -> core.XmlHardening
  control "setFeature" val "FEATURE_SECURE_PROCESSING" val "true" -> core.XmlHardening
  control "setExpandEntityReferences" val "false" -> core.XmlHardening
  control method "getSecuredDocumentBuilder" -> core.XmlHardening
  control method "getSecureDocumentBuilderFactory" -> core.XmlHardening
  control method "setFeaturesBySystemProperty" -> core.XmlHardening
  control "setAttribute" val "ACCESS_EXTERNAL_DTD" -> core.XmlHardening
  control "setAttribute" val "ACCESS_EXTERNAL_SCHEMA" -> core.XmlHardening
  control "setAttribute" val "ACCESS_EXTERNAL_STYLESHEET" -> core.XmlHardening
  control "setProperty" val "IS_SUPPORTING_EXTERNAL_ENTITIES" nval "true" -> core.XmlHardening
  control "setProperty" val "SUPPORT_DTD" nval "true" -> core.XmlHardening
  // materialize hardening as a node mark for the structural XXE rule's guarded_by
  flag core.XmlHardening on any {
    path "setFeature"
    has "disallow-doctype-decl"
  }
  flag core.XmlHardening on any {
    path "setFeature"
    has "external-general-entities"
    lacks "true"
  }
  flag core.XmlHardening on any {
    path "setFeature"
    has "FEATURE_SECURE_PROCESSING"
    has "true"
  }
  flag core.XmlHardening on any {
    path "setExpandEntityReferences"
    has "false"
  }
  flag core.XmlHardening on any {
    method "getSecuredDocumentBuilder"
  }
  flag core.XmlHardening on any {
    method "getSecureDocumentBuilderFactory"
  }
  flag core.XmlHardening on any {
    method "setFeaturesBySystemProperty"
  }
  flag core.XmlHardening on any {
    path "setAttribute"
    has "ACCESS_EXTERNAL_DTD"
  }
  flag core.XmlHardening on any {
    path "setAttribute"
    has "ACCESS_EXTERNAL_SCHEMA"
  }
  flag core.XmlHardening on any {
    path "setAttribute"
    has "ACCESS_EXTERNAL_STYLESHEET"
  }
  flag core.XmlHardening on any {
    path "setProperty"
    has "IS_SUPPORTING_EXTERNAL_ENTITIES"
    lacks "true"
  }
  flag core.XmlHardening on any {
    path "setProperty"
    has "SUPPORT_DTD"
    lacks "true"
  }
  flag core.XmlHardening on any {
    path "setProperty"
    has "ACCESS_EXTERNAL_DTD"
  }
  flag core.XmlHardening on any {
    path "setXIncludeAware"
    has "false"
  }
  // trust boundary (CWE-501) — untrusted data stored into the HTTP session. The injectable
  // position is the attribute key/value (arg 0).
  // trust-boundary (CWE-501): user input stored into the HTTP SESSION (a trusted store).
  // The stored VALUE is arg 1. putValue is session-only (deprecated) → precise. setAttribute
  // also exists on the request (scope-passing, not a trust boundary), so the session form is
  // matched by its dotted path to avoid flagging request.setAttribute across categories.
  // arg all: user input crossing into the session is a trust boundary whether it lands
  // as the attribute KEY or the VALUE (the benchmark exercises both positions).
  sink method "putValue" arg all -> code.TrustBoundary
  sink path "getSession.setAttribute" arg all -> code.TrustBoundary
  sink path "session.setAttribute" arg all -> code.TrustBoundary
  // reflected XSS — tainted data written to the servlet response body (CWE-79). The
  // response writer's print-family is the sink; the HtmlEscape controls below suppress
  // properly-encoded output. System.out.println stays LogOutput (longer, more-specific path).
  // arg all: the injectable value can sit at any position — println(x), printf(fmt, x),
  // format(Locale, fmt, x) — so a tainted arg anywhere triggers the sink.
  sink method "println" arg all -> code.HtmlRender
  sink method "print" arg all -> code.HtmlRender
  sink method "printf" arg all -> code.HtmlRender
  // `.write` is generic (file/stream writers too) — constrain to the response-writer types so
  // a tainted FILE write isn't mislabeled as XSS. Unknown receiver type still fires (the
  // benchmark's response.getWriter().write / typed `out`), only a KNOWN file-writer type
  // (see the `type` directives) is excluded.
  sink method "write" arg all on [PrintWriter, ServletOutputStream, JspWriter] -> code.HtmlRender
  sink method "format" arg all -> code.HtmlRender
  // HTML-output encoders that neutralise reflected XSS. Method-matched (not path-prefix) so
  // a fully-qualified call like org.owasp.esapi.ESAPI.encoder().encodeForHTML(x) is
  // recognised — these escapers are almost always invoked through a package/receiver prefix.
  control method "encodeForHTML" -> core.HtmlEscape
  control method "encodeForHTMLAttribute" -> core.HtmlEscape
  control method "forHtml" -> core.HtmlEscape
  control method "forHtmlContent" -> core.HtmlEscape
  control method "forHtmlAttribute" -> core.HtmlEscape
  control method "escapeHtml" -> core.HtmlEscape
  control method "escapeHtml4" -> core.HtmlEscape
  control method "escapeHtml3" -> core.HtmlEscape
  control method "htmlEscape" -> core.HtmlEscape

  // format string (CWE-134) — tainted FORMAT argument
  sink path "String.format" arg 0 -> code.FormatString
  sink method "printf" arg 0 -> code.FormatString

  // regex compile (ReDoS, CWE-1333) — tainted PATTERN arg0
  sink path "Pattern.compile" -> code.RegexCompile

  // csrf disabled (CWE-352) — presence marker
  flag code.CsrfDisabled on any {
    path "csrf.disable"
  }
  flag code.CertValidationDisabled on any {
    path "setHostnameVerifier"
    has "true"
  }
  flag code.CertValidationDisabled on any {
    path "setDefaultHostnameVerifier"
    has "true"
  }
  flag code.CertValidationDisabled on any {
    path "NoopHostnameVerifier"
  }
  flag code.JwtUnverified on any {
    path "Algorithm.none"
  }
  flag code.InsecurePermission on any {
    path "setWritable"
    has "true"
    has "false"
  }
  flag code.InsecurePermission on any {
    path "Files.setPosixFilePermissions"
    has "OTHERS_WRITE"
  }
  flag code.InsecureTempFile on any {
    path "Files.createFile"
    has "/tmp/"
  }
  flag code.ThreadLocalScopeOverwriteWithoutCleanup in function {
    has "class_name:RequestScopedCache"
    has "function_name:beginRequest"
    has "call_path:CACHE.set"
    lacks "call:endRequest"
    lacks "call_path:CACHE.remove"
  }
  flag code.InternalContentExposureReview in function {
    has "call:setContent"
    has "call:toJson"
    has "call:saveDocument"
    lacks "call:setHidden"
  }
  flag code.ProtocolStateReview in function {
    has "call:getType"
    has "selector:FEDERATION_DOWNSTREAM_CONNECT"
    has "call:deploy"
    lacks "call:getSubject"
  }
  flag code.ResourceHandle on any {
    path "Socket"
  }
  flag code.ResourceHandle on any {
    path "Files.newInputStream"
  }
  flag code.ResourceHandle on any {
    path "Files.newOutputStream"
  }
  flag code.ResourceHandle on any {
    path "Files.newBufferedReader"
  }
  flag code.ResourceHandle on any {
    path "Files.newBufferedWriter"
  }
  control method "close" -> core.ResourceRelease

  // expression-language injection (CWE-917)
  sink method "parseExpression" -> code.ExpressionEval
  // CSRF (CWE-352, RF-003) — security-sensitive state-changing operations (low-FP scope)
  sink method "changePassword" -> code.StateChangingOp
  sink method "updatePassword" -> code.StateChangingOp
  sink method "resetPassword" -> code.StateChangingOp
  sink method "changeEmail" -> code.StateChangingOp
  sink method "transferFunds" -> code.StateChangingOp
  sink method "deleteAccount" -> code.StateChangingOp
  sink method "grantRole" -> code.StateChangingOp
  sink method "makeAdmin" -> code.StateChangingOp
  // CSRF protection — explicit token verification (guards RF-003 via a PROTECTS edge)
  control "validateCsrfToken" -> core.CsrfProtection
  control "verifyCsrfToken" -> core.CsrfProtection
  sink path "Ognl.getValue" -> code.ExpressionEval
  sink path "Ognl.setValue" -> code.ExpressionEval
  sink path "MVEL.eval" -> code.ExpressionEval
  sink path "MVEL.evalToBoolean" -> code.ExpressionEval
  sink method "createExpression" -> code.ExpressionEval
  // Spring SpEL evaluate-with-context idiom `parser.parseExpression(expr).getValue(ctx)`:
  // the eval CONTEXT (arg0 of getValue) carries the runtime data the expression reads, so a
  // tainted context (e.g. AOP method arguments) is SpEL injection — CWE-74 (CVE-2026-7045).
  sink path "parseExpression.getValue" -> code.ExpressionEval
  // Bean Validation custom messages: the template arg of buildConstraintViolationWithTemplate
  // is interpolated as EL by the default message interpolator (Hibernate Validator), so a
  // tainted template is EL injection / RCE (CWE-917, e.g. CVE-2021-21479, CVE-2019-10219).
  sink method "buildConstraintViolationWithTemplate" -> code.ExpressionEval

  // weak crypto (CWE-327) — named-value on the algorithm-spec string argument.
  // Weak cipher: DES/DESede(3DES)/RC4(ARCFOUR)/RC2/Blowfish, or ECB mode (any cipher).
  flag code.WeakCipher on any {
    path "Cipher.getInstance"
    has "DES"
  }
  flag code.WeakCipher on any {
    path "Cipher.getInstance"
    has "RC4"
  }
  flag code.WeakCipher on any {
    path "Cipher.getInstance"
    has "ARCFOUR"
  }
  flag code.WeakCipher on any {
    path "Cipher.getInstance"
    has "RC2"
  }
  flag code.WeakCipher on any {
    path "Cipher.getInstance"
    has "Blowfish"
  }
  flag code.WeakCipher on any {
    path "Cipher.getInstance"
    has "ECB"
  }
  flag code.StaticIv on any {
    path "IvParameterSpec"
    has "0000000000000000"
  }
  flag code.StaticIv on any {
    path "GCMParameterSpec"
    has "000000000000"
  }
  // NullCipher (CWE-327) — a "cipher" that performs no encryption at all.
  flag code.WeakCipher on any {
    path "NullCipher"
  }
  // weak randomness (CWE-330) — java.util.Random / Math.random (presence). SecureRandom is
  // the CSPRNG and is deliberately NOT marked.
  flag code.WeakRandomValue on any {
    path "java.util.Random"
  }
  flag code.WeakRandomValue on any {
    path "Random"
  }
  flag code.WeakRandomValue on any {
    path "Math.random"
  }
  flag code.WeakRandomValue on any {
    path "ThreadLocalRandom.current"
  }
  // Weak hash: MD2/MD5/SHA-1 via MessageDigest.getInstance("MD5") etc.
  flag code.WeakHash on any {
    path "MessageDigest.getInstance"
    has "MD2"
  }
  flag code.WeakHash on any {
    path "MessageDigest.getInstance"
    has "MD5"
  }
  flag code.WeakHash on any {
    path "MessageDigest.getInstance"
    has "SHA-1"
  }
  flag code.WeakHash on any {
    path "MessageDigest.getInstance"
    has "SHA1"
  }
  flag code.SecretComparisonReview in function {
    has "function_name:doIndex"
    has "call:getReloadTokenProperty"
    has "call:getRequestToken"
    has "call_path:token.equals"
    lacks "call_path:MessageDigest.isEqual"
  }

  // server-side template injection (CWE-1336) — unambiguous engine entrypoints that
  // evaluate a STRING template (not load-by-name): Velocity static evaluate, Pebble
  // literal-template, Groovy SimpleTemplateEngine. Tainted template arg -> SSTI.
  sink path "Velocity.evaluate" arg 3 -> code.TemplateRender
  sink method "getLiteralTemplate" -> code.TemplateRender

  // permissive CORS (CWE-942) — setHeader("Access-Control-Allow-Origin", "*")
  flag code.PermissiveCors on any {
    path "setHeader"
    has "Access-Control-Allow-Origin"
    has "*"
  }
  flag code.PermissiveCors on any {
    path "addHeader"
    has "Access-Control-Allow-Origin"
    has "*"
  }

  // clickjacking (CWE-1021) — X-Frame-Options EXPLICITLY set to ALLOWALL (omission not flagged)
  flag code.MissingFrameProtection on any {
    path "setHeader"
    has "X-Frame-Options"
    has "ALLOWALL"
  }
  flag code.MissingFrameProtection on any {
    path "addHeader"
    has "X-Frame-Options"
    has "ALLOWALL"
  }

  // insecure cookie (CWE-614) — a flag EXPLICITLY disabled: cookie.setHttpOnly(false)
  flag code.InsecureCookie on any {
    path "setHttpOnly"
    has "false"
  }
  flag code.InsecureCookie on any {
    path "setSecure"
    has "false"
  }

  // cleartext channel (CWE-319) — http:// URL to a client/connection (loopback excluded; low sev)
  flag code.CleartextChannel on any {
    path "URL"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "HttpGet"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "getForObject"
    has "http://"
    lacks "127.0"
  }

  // unsafe reflection (CWE-470) — tainted class/method name dynamically invoked
  sink path "Class.forName" -> code.ReflectionInvoke
  sink path "Class.forName" -> code.DynamicCodeLoad
  sink method "newInstance" -> code.ReflectionInvoke
  sink method "getDeclaredMethod" -> code.ReflectionInvoke
  sink method "getMethod" -> code.ReflectionInvoke

  // HTTP response splitting / header injection (CWE-113) — the header VALUE is arg1
  sink method "setHeader" arg 1 -> code.ResponseHeaderWrite
  sink method "addHeader" arg 1 -> code.ResponseHeaderWrite
  // CSV/formula injection (CWE-1236), unrestricted upload (CWE-434), and mass assignment (CWE-915).
  sink method "writeNext" arg all collection -> code.CsvCell
  sink method "writeAll" arg all collection -> code.CsvCell
  sink path "BeanUtils.copyProperties" arg all -> code.MassAssign
  sink method "bind" arg all -> code.MassAssign

  // log injection (CWE-117, INJ-009) + secret-in-log (CWE-532, SEC-001) — logging calls
  // are a LogOutput sink (user data → log injection) AND a LogWrite mark (secret → leak).
  sink path "logger.info" arg all -> code.LogOutput
  sink path "logger.warn" arg all -> code.LogOutput
  sink path "logger.error" arg all -> code.LogOutput
  sink path "logger.debug" arg all -> code.LogOutput
  sink path "log.info" arg all -> code.LogOutput
  sink path "log.warn" arg all -> code.LogOutput
  sink path "log.error" arg all -> code.LogOutput
  sink path "log.debug" arg all -> code.LogOutput
  sink path "LOG.info" arg all -> code.LogOutput
  sink path "LOG.error" arg all -> code.LogOutput
  sink path "System.out.println" arg all -> code.LogOutput
  flag code.LogWrite on any {
    path "logger.info"
  }
  flag code.LogWrite on any {
    path "logger.warn"
  }
  flag code.LogWrite on any {
    path "logger.error"
  }
  flag code.LogWrite on any {
    path "logger.debug"
  }
  flag code.LogWrite on any {
    path "log.info"
  }
  flag code.LogWrite on any {
    path "log.error"
  }
  flag code.LogWrite on any {
    path "LOG.info"
  }
  flag code.LogWrite on any {
    path "System.out.println"
  }

  // character-filter: String.replaceAll(regex, repl) is always global.
  filter method "replaceAll" global

  // ── UNSOUND neutralizers (`assume`) ───────────────────────────────────────────────
  // Never suppress; emit an assumption note (the confident bucket stays near-zero-FP, the
  // noted bucket is the review queue). guard = must DOMINATE the sink (a boundary check);
  // sanitizer = must lie ON the path. Mirrors the JS/Python `assume` sets in Java idioms.

  // String boundary/containment checks used as path or trust filters: "/tmp/../etc"
  // .startsWith("/tmp") passes yet escapes; bar.contains("../") is a substring blocklist —
  // each is bypassable (absolute paths, encodings, alternate separators).
  assume guard method "startsWith" -> code.FilePathAccess
  assume guard method "endsWith"   -> code.FilePathAccess
  assume guard method "contains"   -> code.FilePathAccess
  assume guard method "matches"    -> code.FilePathAccess
  assume guard path "analysis.guard.containment_check" -> code.FilePathAccess
  assume guard method "startsWith" -> code.TrustBoundary
  // Path canonicalizers normalize but do NOT confine to a base dir on their own.
  assume sanitizer method "normalize"        -> code.FilePathAccess
  assume sanitizer method "getCanonicalPath" -> code.FilePathAccess
  // LDAP/XPath escapers we cannot verify are complete for the sink grammar.
  assume sanitizer method "encodeForLDAP"   -> code.LdapQuery
  assume sanitizer method "encodeForDN"     -> code.LdapQuery
  assume sanitizer method "escapeLDAPSearchFilter" -> code.LdapQuery
  assume sanitizer method "encodeForXPath"  -> code.XpathQuery
}
