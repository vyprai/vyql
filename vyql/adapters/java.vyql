  flag code.SecretDatabindingReview on any {
    path exact "analysis.parameter.entry"
    param name "awsSecretKey"
    param type "Secret"
  }
  flag code.SecretDatabindingReview in function {
    function "setAkid"
    not call "fromString"
  }
  flag code.SecretDatabindingReview in function {
    function "setSkid"
    not call "fromString"
  }
  flag code.JenkinsPlaintextDataboundCredential on any {
    path exact "analysis.parameter.entry"
    annotation "DataBoundConstructor"
    param name "apilogin"
    param type "String"
    not param type "Secret"
  }
  flag code.JenkinsPlaintextDataboundCredential on any {
    path exact "analysis.parameter.entry"
    annotation "DataBoundConstructor"
    param name "apitoken"
    param type "String"
    not param type "Secret"
  }
  flag code.JenkinsPlaintextDataboundCredential in function {
    has "@DataBoundConstructor"
    has "StringrepoPassword"
    has "this.repoPassword=repoPassword;"
    lacks "Secret.fromString(repoPassword)"
    lacks "SecretrepoPassword"
  }
  flag code.JenkinsPlaintextDataboundCredential in function {
    has "@DataBoundConstructor"
    has "Stringpassword"
    has "this.password=password;"
    lacks "Secret.fromString(password)"
    lacks "Secretpassword"
