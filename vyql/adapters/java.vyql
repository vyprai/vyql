// java framework adapter (docs/07) — framework→concept content.
// frameworks: servlet, spring-mvc, jax-rs, jdbc, jpa, spring-jdbc
adapter java {
  meta { match: contains, fidelity: resolved }

  // Spring handler params (seeded http_input by the frontend) + servlet inputs
  source "System.console.readLine" -> code.StdinInput
  source "http_input" -> code.HttpInput
  // Servlet / Spring request inputs (receiver name varies → substring match)
  source ".getParameter" -> code.HttpInput
  source ".getParameterValues" -> code.HttpInput
  source ".getParameterMap" -> code.HttpInput
  source ".getHeader" -> code.HttpInput
  source ".getHeaders" -> code.HttpInput
  source ".getQueryString" -> code.HttpInput
  source ".getCookies" -> code.HttpInput
  source ".getInputStream" -> code.HttpInput
  source ".getReader" -> code.HttpInput
  source ".getPathInfo" -> code.HttpInput
  source ".getRequestURI" -> code.HttpInput
  source ".getPart" -> code.HttpInput
  // Android intent / deep-link inputs (attacker-controlled IPC entry points)
  source ".getStringExtra" -> code.IntentInput
  source ".getStringArrayExtra" -> code.IntentInput
  source ".getCharSequenceExtra" -> code.IntentInput
  source ".getBundleExtra" -> code.IntentInput
  source ".getDataString" -> code.IntentInput
  source ".getQueryParameter" -> code.IntentInput
  source ".getQueryParameters" -> code.IntentInput
  source ".getLastPathSegment" -> code.IntentInput

  // receiver-type tracking — a variable assigned `new FileWriter(...)` carries that type so
  // its `.write()` is recognised as a FILE write (not the response-writer XSS sink above).
  type "FileWriter" -> FileWriter
  type "BufferedWriter" -> BufferedWriter
  type "FileOutputStream" -> FileOutputStream
  type "OutputStreamWriter" -> OutputStreamWriter
  type "RandomAccessFile" -> RandomAccessFile
  type "StringWriter" -> StringWriter
  type "CharArrayWriter" -> CharArrayWriter
  type "ByteArrayOutputStream" -> ByteArrayOutputStream

  // SQL — JDBC Statement / Connection / JPA / Spring JdbcTemplate + Android SQLite
  sink method "executeQuery" -> code.SqlExecution
  sink method "executeUpdate" -> code.SqlExecution
  sink method "execute" -> code.SqlExecution
  sink method "executeBatch" -> code.SqlExecution
  sink method "addBatch" -> code.SqlExecution
  sink method "rawQuery" -> code.SqlExecution
  sink method "execSQL" -> code.SqlExecution
  // Android WebView: tainted URL/JS loaded or evaluated (CWE-749)
  sink method "loadUrl" -> code.WebViewLoad
  sink method "loadData" -> code.WebViewLoad
  sink method "loadDataWithBaseURL" arg 1 -> code.WebViewLoad
  sink method "postUrl" -> code.WebViewLoad
  sink method "evaluateJavascript" -> code.WebViewLoad
  // exposing a native bridge to WebView content (presence)
  mark "addJavascriptInterface" -> code.WebViewJsInterface
  sink method "executeLargeUpdate" -> code.SqlExecution
  sink method "prepareStatement" -> code.SqlExecution
  sink method "prepareCall" -> code.SqlExecution
  sink method "createQuery" -> code.SqlExecution
  sink method "createNativeQuery" -> code.SqlExecution
  sink method "queryForObject" -> code.SqlExecution
  sink method "queryForList" -> code.SqlExecution
  sink method "query" -> code.SqlExecution
  // Spring JdbcTemplate query/update family (CWE-89) — all take the SQL as arg 0.
  sink method "queryForRowSet" -> code.SqlExecution
  sink method "queryForMap" -> code.SqlExecution
  sink method "queryForInt" -> code.SqlExecution
  sink method "queryForLong" -> code.SqlExecution
  sink method "queryForStream" -> code.SqlExecution
  sink method "batchUpdate" -> code.SqlExecution

  // Command execution. arg all: the tainted value can be the command, an argument, or the
  // environment array — Runtime.exec(cmd) / exec(cmdarray, envp), ProcessBuilder(a, b, …),
  // ProcessBuilder.command(list) — so any tainted argument triggers.
  sink method "exec" arg all -> code.CommandExecution
  sink path "Runtime.getRuntime.exec" arg all -> code.CommandExecution
  sink path "ProcessBuilder" arg all -> code.CommandExecution
  sink method "command" arg all -> code.CommandExecution

  // Deserialization
  sink method "readObject" -> code.Deserialization
  sink method "readUnshared" -> code.Deserialization
  sink path "XMLDecoder" -> code.Deserialization
  sink path "XMLDecoder.readObject" -> code.Deserialization
  // Jackson polymorphic / SnakeYAML — untrusted document into a deserializer
  sink method "readValue" -> code.Deserialization
  sink path "yaml.load" -> code.Deserialization
  sink path "Yaml.load" -> code.Deserialization

  // XXE
  sink method "parse" -> code.XmlParse
  sink method "newDocumentBuilder" -> code.XmlParse

  // Path / file. `new File(parent, child)` puts the tainted child path at arg 1, and
  // Paths.get(first, …more) / Files.write(path, …) likewise vary the path position — arg all.
  sink path "File" arg all -> code.FilePathAccess
  sink path "Paths.get" arg all -> code.FilePathAccess
  sink path "FileInputStream" -> code.FilePathAccess
  sink path "FileOutputStream" -> code.FilePathAccess
  sink path "FileReader" -> code.FilePathAccess
  sink path "FileWriter" -> code.FilePathAccess
  sink path "RandomAccessFile" -> code.FilePathAccess
  sink path "Files.readAllBytes" -> code.FilePathAccess
  sink path "Files.readAllLines" -> code.FilePathAccess
  sink path "Files.newInputStream" -> code.FilePathAccess
  sink path "Files.newOutputStream" -> code.FilePathAccess
  sink path "Files.newBufferedReader" -> code.FilePathAccess
  sink path "Files.newBufferedWriter" -> code.FilePathAccess
  sink path "Files.write" -> code.FilePathAccess
  sink path "Files.lines" -> code.FilePathAccess
  sink path "Files.delete" -> code.FilePathAccess
  sink path "Files.copy" -> code.FilePathAccess
  sink path "Paths.get" -> code.FilePathAccess

  // SSRF
  sink path "URL" -> code.UrlFetch
  sink method "openConnection" -> code.UrlFetch
  sink method "getForObject" -> code.UrlFetch
  sink method "getForEntity" -> code.UrlFetch

  // Code eval / scripting
  sink method "eval" -> code.CodeEval

  // XPath injection (CWE-643) — javax.xml.xpath: XPath.evaluate(expr, doc) / XPath.compile(expr)
  // and the JAXP XPathExpression returned by compile. The expression string (arg 0) is injectable.
  sink method "evaluate" arg 0 on XPath -> code.XpathQuery
  sink method "compile" arg 0 on XPath -> code.XpathQuery
  sink path "XPath.evaluate" arg 0 -> code.XpathQuery
  sink path "XPath.compile" arg 0 -> code.XpathQuery

  // LDAP injection (CWE-90) — JNDI DirContext.search(name, filter, controls): the FILTER
  // (arg 1) is injectable. Typed sink (on DirContext) + unambiguous dotted ctor forms.
  sink method "search" arg 1 on DirContext -> code.LdapQuery
  sink path "InitialDirContext.search" arg 1 -> code.LdapQuery
  sink path "InitialLdapContext.search" arg 1 -> code.LdapQuery

  // controls (sanitizers/validators)
  // authorization checks (guards BIZ-001) — Spring Security predicates (path-sensitive via B1).
  control "hasPermission" -> core.AuthorizationCheck
  control "hasAuthority" -> core.AuthorizationCheck
  control "hasRole" -> core.AuthorizationCheck
  // XXE hardening — a parser factory configured to disallow DOCTYPE / external entities,
  // dominating the parse (value-matched feature flag).
  control "setFeature" val "disallow-doctype-decl" -> core.XmlHardening
  control "setFeature" val "external-general-entities" nval "true" -> core.XmlHardening
  control "setExpandEntityReferences" val "false" -> core.XmlHardening
  // trust boundary (CWE-501) — untrusted data stored into the HTTP session. The injectable
  // position is the attribute key/value (arg 0).
  // trust-boundary (CWE-501): user input stored into the HTTP SESSION (a trusted store).
  // The stored VALUE is arg 1. putValue is session-only (deprecated) → precise. setAttribute
  // also exists on the request (scope-passing, not a trust boundary), so the session form is
  // matched by its dotted path to avoid flagging request.setAttribute across categories.
  // arg all: user input crossing into the session is a trust boundary whether it lands
  // as the attribute KEY or the VALUE (the benchmark exercises both positions).
  sink method "putValue" arg all -> code.TrustBoundary
  sink path "getSession.setAttribute" arg all -> code.TrustBoundary
  sink path "session.setAttribute" arg all -> code.TrustBoundary
  // reflected XSS — tainted data written to the servlet response body (CWE-79). The
  // response writer's print-family is the sink; the HtmlEscape controls below suppress
  // properly-encoded output. System.out.println stays LogOutput (longer, more-specific path).
  // arg all: the injectable value can sit at any position — println(x), printf(fmt, x),
  // format(Locale, fmt, x) — so a tainted arg anywhere triggers the sink.
  sink method "println" arg all -> code.HtmlRender
  sink method "print" arg all -> code.HtmlRender
  sink method "printf" arg all -> code.HtmlRender
  // `.write` is generic (file/stream writers too) — constrain to the response-writer types so
  // a tainted FILE write isn't mislabeled as XSS. Unknown receiver type still fires (the
  // benchmark's response.getWriter().write / typed `out`), only a KNOWN file-writer type
  // (see the `type` directives) is excluded.
  sink method "write" arg all on [PrintWriter, ServletOutputStream, JspWriter] -> code.HtmlRender
  sink method "format" arg all -> code.HtmlRender
  control "escapeHtml" -> core.HtmlEscape
  control "Encode.forHtml" -> core.HtmlEscape
  control "StringEscapeUtils.escapeHtml4" -> core.HtmlEscape
  control "StringEscapeUtils.escapeHtml3" -> core.HtmlEscape
  control "HtmlUtils.htmlEscape" -> core.HtmlEscape
  control "ESAPI.encoder" -> core.HtmlEscape
  control "encodeForHTML" -> core.HtmlEscape

  // format string (CWE-134) — tainted FORMAT argument
  sink path "String.format" arg 0 -> code.FormatString
  sink method "printf" arg 0 -> code.FormatString

  // regex compile (ReDoS, CWE-1333) — tainted PATTERN arg0
  sink path "Pattern.compile" -> code.RegexCompile

  // csrf disabled (CWE-352) — presence marker
  mark "csrf.disable" -> code.CsrfDisabled

  // expression-language injection (CWE-917)
  sink method "parseExpression" -> code.ExpressionEval
  // CSRF (CWE-352, RF-003) — security-sensitive state-changing operations (low-FP scope)
  sink method "changePassword" -> code.StateChangingOp
  sink method "updatePassword" -> code.StateChangingOp
  sink method "resetPassword" -> code.StateChangingOp
  sink method "changeEmail" -> code.StateChangingOp
  sink method "transferFunds" -> code.StateChangingOp
  sink method "deleteAccount" -> code.StateChangingOp
  sink method "grantRole" -> code.StateChangingOp
  sink method "makeAdmin" -> code.StateChangingOp
  // CSRF protection — explicit token verification (guards RF-003 via a PROTECTS edge)
  control "validateCsrfToken" -> core.CsrfProtection
  control "verifyCsrfToken" -> core.CsrfProtection
  sink path "Ognl.getValue" -> code.ExpressionEval
  sink path "Ognl.setValue" -> code.ExpressionEval
  sink path "MVEL.eval" -> code.ExpressionEval
  sink path "MVEL.evalToBoolean" -> code.ExpressionEval
  sink method "createExpression" -> code.ExpressionEval

  // weak crypto (CWE-327) — named-value on the algorithm-spec string argument.
  // Weak cipher: DES/DESede(3DES)/RC4(ARCFOUR)/RC2/Blowfish, or ECB mode (any cipher).
  mark "Cipher.getInstance" val "DES" -> code.WeakCipher
  mark "Cipher.getInstance" val "RC4" -> code.WeakCipher
  mark "Cipher.getInstance" val "ARCFOUR" -> code.WeakCipher
  mark "Cipher.getInstance" val "RC2" -> code.WeakCipher
  mark "Cipher.getInstance" val "Blowfish" -> code.WeakCipher
  mark "Cipher.getInstance" val "ECB" -> code.WeakCipher
  // NullCipher (CWE-327) — a "cipher" that performs no encryption at all.
  mark "NullCipher" -> code.WeakCipher
  // weak randomness (CWE-330) — java.util.Random / Math.random (presence). SecureRandom is
  // the CSPRNG and is deliberately NOT marked.
  mark "java.util.Random" -> code.WeakRandomValue
  mark "Random" -> code.WeakRandomValue
  mark "Math.random" -> code.WeakRandomValue
  mark "ThreadLocalRandom.current" -> code.WeakRandomValue
  // Weak hash: MD2/MD5/SHA-1 via MessageDigest.getInstance("MD5") etc.
  mark "MessageDigest.getInstance" val "MD2" -> code.WeakHash
  mark "MessageDigest.getInstance" val "MD5" -> code.WeakHash
  mark "MessageDigest.getInstance" val "SHA-1" -> code.WeakHash
  mark "MessageDigest.getInstance" val "SHA1" -> code.WeakHash

  // server-side template injection (CWE-1336) — unambiguous engine entrypoints that
  // evaluate a STRING template (not load-by-name): Velocity static evaluate, Pebble
  // literal-template, Groovy SimpleTemplateEngine. Tainted template arg -> SSTI.
  sink path "Velocity.evaluate" arg 3 -> code.TemplateRender
  sink method "getLiteralTemplate" -> code.TemplateRender

  // permissive CORS (CWE-942) — setHeader("Access-Control-Allow-Origin", "*")
  mark "setHeader" val "Access-Control-Allow-Origin" val "*" -> code.PermissiveCors
  mark "addHeader" val "Access-Control-Allow-Origin" val "*" -> code.PermissiveCors

  // clickjacking (CWE-1021) — X-Frame-Options EXPLICITLY set to ALLOWALL (omission not flagged)
  mark "setHeader" val "X-Frame-Options" val "ALLOWALL" -> code.MissingFrameProtection
  mark "addHeader" val "X-Frame-Options" val "ALLOWALL" -> code.MissingFrameProtection

  // insecure cookie (CWE-614) — a flag EXPLICITLY disabled: cookie.setHttpOnly(false)
  mark "setHttpOnly" val "false" -> code.InsecureCookie
  mark "setSecure" val "false" -> code.InsecureCookie

  // cleartext channel (CWE-319) — http:// URL to a client/connection (loopback excluded; low sev)
  mark "URL" val "http://" nval "127.0" -> code.CleartextChannel
  mark "HttpGet" val "http://" nval "127.0" -> code.CleartextChannel
  mark "getForObject" val "http://" nval "127.0" -> code.CleartextChannel

  // unsafe reflection (CWE-470) — tainted class/method name dynamically invoked
  sink path "Class.forName" -> code.ReflectionInvoke
  sink method "newInstance" -> code.ReflectionInvoke
  sink method "getDeclaredMethod" -> code.ReflectionInvoke
  sink method "getMethod" -> code.ReflectionInvoke

  // HTTP response splitting / header injection (CWE-113) — the header VALUE is arg1
  sink method "setHeader" arg 1 -> code.ResponseHeaderWrite
  sink method "addHeader" arg 1 -> code.ResponseHeaderWrite

  // log injection (CWE-117, INJ-009) + secret-in-log (CWE-532, SEC-001) — logging calls
  // are a LogOutput sink (user data → log injection) AND a LogWrite mark (secret → leak).
  sink path "logger.info" -> code.LogOutput
  sink path "logger.warn" -> code.LogOutput
  sink path "logger.error" -> code.LogOutput
  sink path "logger.debug" -> code.LogOutput
  sink path "log.info" -> code.LogOutput
  sink path "log.warn" -> code.LogOutput
  sink path "log.error" -> code.LogOutput
  sink path "log.debug" -> code.LogOutput
  sink path "LOG.info" -> code.LogOutput
  sink path "LOG.error" -> code.LogOutput
  sink path "System.out.println" -> code.LogOutput
  mark "logger.info" -> code.LogWrite
  mark "logger.warn" -> code.LogWrite
  mark "logger.error" -> code.LogWrite
  mark "logger.debug" -> code.LogWrite
  mark "log.info" -> code.LogWrite
  mark "log.error" -> code.LogWrite
  mark "LOG.info" -> code.LogWrite
  mark "System.out.println" -> code.LogWrite
}
