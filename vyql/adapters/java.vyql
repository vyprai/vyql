  flag code.JenkinsCredentialsStartupLoadContextExposure in class {
    class name "SystemCredentialsProvider"
    function "SystemCredentialsProvider"
    call path "xml.unmarshal"
    call path "DomainCredentials.migrateListToMap"
    function "getInstance"
    not annotation "Initializer"
    not function "forceLoadDuringStartup"
  }
  flag code.JdbcCredentialAttributeExposure in function {
    function "connect"
    call "tokenizeDatabase"
    call "tokenizeURLProperties"
    call "NetConnection"
    not call "appendDatabaseAttributes"
  }
  flag code.SensitiveOperation in function {
    function "doConfigure"
    call "configure"
    call "save"
    not call "checkPermission"
  }
  flag code.SensitiveOperation in function {
    function "doAttachPublicIP"
    call "getNode"
    call "attachPublicIP"
    not call "checkPermission"
  }
  flag code.PluginManagementMissingAuthorization in function {
    annotation "PostMapping"
    call path "pluginService.localInstall"
    not annotation "RequiresPermissions"
    not annotation "PreAuthorize"
    not call "checkPermission"
    not call "hasPermission"
  }
  flag code.PluginManagementMissingAuthorization in function {
    annotation "PostMapping"
    call path "pluginService.uninstall"
    not annotation "RequiresPermissions"
    not annotation "PreAuthorize"
    not call "checkPermission"
    not call "hasPermission"
  }
  flag code.StateChangingOp in function {
    function "doFill"
    not call "checkPermission"
    not annotation "POST"
    not annotation "RequirePOST"
  }
  flag code.AbsolutePathDisclosure in function {
    selector "Constants.MC_REALPATH"
    selector "Constants.MC_RELATIVE_PATH"
    call "FileReader"
    not call "FileNotFoundException"
  }
  flag code.CanonicalPathStringPrefixContainment in function {
    function "getValidDirectoryPath"
    call "getCanonicalPath"
    call "startsWith"
    not call "toPath"
  }
  // Jenkins project workspace access requires an explicit item permission check in
  // descriptor/form-validation paths.
  flag code.SensitiveOperation on any {
    method "getSomeWorkspace"
  }
  control method "requireAuth" -> core.AuthenticationCheck
  control method "ensureAuthenticated" -> core.AuthenticationCheck
  control method "isAuthenticated" -> core.AuthenticationCheck
  control method "authenticate" -> core.AuthenticationCheck
  control method "checkOwnership" -> core.OwnershipCheck
  control method "requireOwner" -> core.OwnershipCheck
  control method "isOwner" -> core.OwnershipCheck
  flag code.LockAcquire on any {
    method "lock"
  }
  control method "unlock" -> core.LockRelease
  control "validateRole" -> core.InputValidation
  // XXE hardening — a parser factory configured to disallow DOCTYPE / external entities,
  // dominating the parse (value-matched feature flag).
  control "setFeature" val "disallow-doctype-decl" -> core.XmlHardening
  control "setFeature" val "external-general-entities" nval "true" -> core.XmlHardening
  control "setFeature" val "FEATURE_SECURE_PROCESSING" val "true" -> core.XmlHardening
  control "setExpandEntityReferences" val "false" -> core.XmlHardening
  control method "getSecuredDocumentBuilder" -> core.XmlHardening
  control method "getSecureDocumentBuilderFactory" -> core.XmlHardening
  control method "setFeaturesBySystemProperty" -> core.XmlHardening
  control "setAttribute" val "ACCESS_EXTERNAL_DTD" -> core.XmlHardening
  control "setAttribute" val "ACCESS_EXTERNAL_SCHEMA" -> core.XmlHardening
  control "setAttribute" val "ACCESS_EXTERNAL_STYLESHEET" -> core.XmlHardening
  control "setProperty" val "IS_SUPPORTING_EXTERNAL_ENTITIES" nval "true" -> core.XmlHardening
  control "setProperty" val "SUPPORT_DTD" nval "true" -> core.XmlHardening
  // materialize hardening as a node mark for the structural XXE rule's guarded_by
  flag core.XmlHardening on any {
    path "setFeature"
    has "disallow-doctype-decl"
  }
  flag core.XmlHardening on any {
    path "setFeature"
    has "external-general-entities"
    lacks "true"
  }
  flag core.XmlHardening on any {
    path "setFeature"
    has "FEATURE_SECURE_PROCESSING"
    has "true"
  }
  flag core.XmlHardening on any {
    path "setExpandEntityReferences"
    has "false"
  }
  flag core.XmlHardening on any {
    method "getSecuredDocumentBuilder"
  }
  flag core.XmlHardening on any {
    method "getSecureDocumentBuilderFactory"
  }
  flag core.XmlHardening on any {
    method "setFeaturesBySystemProperty"
  }
  flag core.XmlHardening on any {
    path "setAttribute"
    has "ACCESS_EXTERNAL_DTD"
  }
  flag core.XmlHardening on any {
    path "setAttribute"
    has "ACCESS_EXTERNAL_SCHEMA"
  }
  flag core.XmlHardening on any {
    path "setAttribute"
    has "ACCESS_EXTERNAL_STYLESHEET"
  }
  flag core.XmlHardening on any {
    path "setProperty"
    has "IS_SUPPORTING_EXTERNAL_ENTITIES"
    lacks "true"
  }
  flag core.XmlHardening on any {
    path "setProperty"
    has "SUPPORT_DTD"
    lacks "true"
  }
  flag core.XmlHardening on any {
    path "setProperty"
    has "ACCESS_EXTERNAL_DTD"
  }
  flag core.XmlHardening on any {
    path "setXIncludeAware"
    has "false"
  }
  // trust boundary (CWE-501) — untrusted data stored into the HTTP session. The injectable
  // position is the attribute key/value (arg 0).
  // trust-boundary (CWE-501): user input stored into the HTTP SESSION (a trusted store).
  // The stored VALUE is arg 1. putValue is session-only (deprecated) → precise. setAttribute
  // also exists on the request (scope-passing, not a trust boundary), so the session form is
  // matched by its dotted path to avoid flagging request.setAttribute across categories.
  // arg all: user input crossing into the session is a trust boundary whether it lands
  // as the attribute KEY or the VALUE (the benchmark exercises both positions).
  sink method "putValue" arg all -> code.TrustBoundary
  sink path "getSession.setAttribute" arg all -> code.TrustBoundary
  sink path "session.setAttribute" arg all -> code.TrustBoundary
  // reflected XSS — tainted data written to the servlet response body (CWE-79). The
  // response writer's print-family is the sink; the HtmlEscape controls below suppress
  // properly-encoded output. System.out.println stays LogOutput (longer, more-specific path).
  // arg all: the injectable value can sit at any position — println(x), printf(fmt, x),
  // format(Locale, fmt, x) — so a tainted arg anywhere triggers the sink.
  sink method "println" arg all -> code.HtmlRender
  sink method "print" arg all -> code.HtmlRender
  sink method "printf" arg all -> code.HtmlRender
  // `.write` is generic (file/stream writers too) — constrain to the response-writer types so
  // a tainted FILE write isn't mislabeled as XSS. Unknown receiver type still fires (the
  // benchmark's response.getWriter().write / typed `out`), only a KNOWN file-writer type
  // (see the `type` directives) is excluded.
  sink method "write" arg all on [PrintWriter, ServletOutputStream, JspWriter] -> code.HtmlRender
  sink method "format" arg all -> code.HtmlRender
  // HTML-output encoders that neutralise reflected XSS. Method-matched (not path-prefix) so
  // a fully-qualified call like org.owasp.esapi.ESAPI.encoder().encodeForHTML(x) is
  // recognised — these escapers are almost always invoked through a package/receiver prefix.
  control method "encodeForHTML" -> core.HtmlEscape
  control method "encodeForHTMLAttribute" -> core.HtmlEscape
  control method "forHtml" -> core.HtmlEscape
  control method "forHtmlContent" -> core.HtmlEscape
  control method "forHtmlAttribute" -> core.HtmlEscape
  control method "escapeHtml" -> core.HtmlEscape
  control method "escapeHtml4" -> core.HtmlEscape
  control method "escapeHtml3" -> core.HtmlEscape
  control method "htmlEscape" -> core.HtmlEscape

  // format string (CWE-134) — tainted FORMAT argument
  sink path "String.format" arg 0 -> code.FormatString
  sink method "printf" arg 0 -> code.FormatString

  // regex compile (ReDoS, CWE-1333) — tainted PATTERN arg0
  sink path "Pattern.compile" -> code.RegexCompile

  // csrf disabled (CWE-352) — presence marker
  flag code.CsrfDisabled on any {
    path "csrf.disable"
  }
  flag code.CertValidationDisabled on any {
    path "setHostnameVerifier"
    has "true"
  }
  flag code.CertValidationDisabled on any {
    path "setDefaultHostnameVerifier"
    has "true"
  }
  flag code.CertValidationDisabled on any {
    path "NoopHostnameVerifier"
  }
  flag code.JavaMailSmtpSslIdentityVerificationMissing in function {
    function "createSession"
    call path "props.put"
    literal "mail.smtp.socketFactory.class"
    literal "javax.net.ssl.SSLSocketFactory"
    literal "mail.smtp.socketFactory.fallback"
    lacks literal "mail.smtp.ssl.checkserveridentity"
  }
  flag code.JwtUnverified on any {
    path "Algorithm.none"
  }
  flag code.InsecurePermission on any {
    path "setWritable"
    has "true"
    has "false"
  }
  flag code.InsecurePermission on any {
    path "Files.setPosixFilePermissions"
    has "OTHERS_WRITE"
  }
  flag code.InsecureTempFile on any {
    path "Files.createFile"
    has "/tmp/"
  }
  flag code.ThreadLocalScopeOverwriteWithoutCleanup in function {
    class name "RequestScopedCache"
    function "beginRequest"
    call path "CACHE.set"
    not call "endRequest"
    not call path "CACHE.remove"
  }
  flag code.InternalContentExposureReview in function {
    call "setContent"
    call "toJson"
    call "saveDocument"
    not call "setHidden"
  }
  flag code.ProtocolStateReview in function {
    call "getType"
    selector "FEDERATION_DOWNSTREAM_CONNECT"
    call "deploy"
    not call "getSubject"
  }
  flag code.ResourceHandle on any {
    path "Socket"
  }
  flag code.ResourceHandle on any {
    path "Files.newInputStream"
  }
  flag code.ResourceHandle on any {
    path "Files.newOutputStream"
  }
  flag code.ResourceHandle on any {
    path "Files.newBufferedReader"
  }
  flag code.ResourceHandle on any {
    path "Files.newBufferedWriter"
  }
  control method "close" -> core.ResourceRelease

  // expression-language injection (CWE-917)
  sink method "parseExpression" -> code.ExpressionEval
  // CSRF (CWE-352, RF-003) — security-sensitive state-changing operations (low-FP scope)
  sink method "changePassword" -> code.StateChangingOp
  sink method "updatePassword" -> code.StateChangingOp
  sink method "resetPassword" -> code.StateChangingOp
  sink method "changeEmail" -> code.StateChangingOp
  sink method "transferFunds" -> code.StateChangingOp
  sink method "deleteAccount" -> code.StateChangingOp
  sink method "grantRole" -> code.StateChangingOp
  sink method "makeAdmin" -> code.StateChangingOp
  // CSRF protection — explicit token verification (guards RF-003 via a PROTECTS edge)
  control "validateCsrfToken" -> core.CsrfProtection
  control "verifyCsrfToken" -> core.CsrfProtection
  sink path "Ognl.getValue" -> code.ExpressionEval
  sink path "Ognl.setValue" -> code.ExpressionEval
  sink path "MVEL.eval" -> code.ExpressionEval
  sink path "MVEL.evalToBoolean" -> code.ExpressionEval
  sink method "createExpression" -> code.ExpressionEval
  // Spring SpEL evaluate-with-context idiom `parser.parseExpression(expr).getValue(ctx)`:
  // the eval CONTEXT (arg0 of getValue) carries the runtime data the expression reads, so a
  // tainted context (e.g. AOP method arguments) is SpEL injection — CWE-74 (CVE-2026-7045).
  sink path "parseExpression.getValue" -> code.ExpressionEval
  // Bean Validation custom messages: the template arg of buildConstraintViolationWithTemplate
  // is interpolated as EL by the default message interpolator (Hibernate Validator), so a
  // tainted template is EL injection / RCE (CWE-917, e.g. CVE-2021-21479, CVE-2019-10219).
  sink method "buildConstraintViolationWithTemplate" -> code.ExpressionEval

  // weak crypto (CWE-327) — named-value on the algorithm-spec string argument.
  // Weak cipher: DES/DESede(3DES)/RC4(ARCFOUR)/RC2/Blowfish, or ECB mode (any cipher).
  flag code.WeakCipher on any {
    path "Cipher.getInstance"
    has "DES"
  }
  flag code.WeakCipher on any {
    path "Cipher.getInstance"
    has "RC4"
  }
  flag code.WeakCipher on any {
    path "Cipher.getInstance"
    has "ARCFOUR"
  }
  flag code.WeakCipher on any {
    path "Cipher.getInstance"
    has "RC2"
  }
  flag code.WeakCipher on any {
    path "Cipher.getInstance"
    has "Blowfish"
  }
  flag code.WeakCipher on any {
    path "Cipher.getInstance"
    has "ECB"
  }
  flag code.StaticIv on any {
    path "IvParameterSpec"
    has "0000000000000000"
  }
  flag code.StaticIv on any {
    path "GCMParameterSpec"
    has "000000000000"
  }
  // NullCipher (CWE-327) — a "cipher" that performs no encryption at all.
  flag code.WeakCipher on any {
    path "NullCipher"
  }
  // weak randomness (CWE-330) — java.util.Random / Math.random (presence). SecureRandom is
  // the CSPRNG and is deliberately NOT marked.
  flag code.WeakRandomValue on any {
    path "java.util.Random"
  }
  flag code.WeakRandomValue on any {
    path "Random"
  }
  flag code.WeakRandomValue on any {
    path "Math.random"
  }
  flag code.WeakRandomValue on any {
    path "ThreadLocalRandom.current"
  }
  // Weak hash: MD2/MD5/SHA-1 via MessageDigest.getInstance("MD5") etc.
  flag code.WeakHash on any {
    path "MessageDigest.getInstance"
    has "MD2"
  }
  flag code.WeakHash on any {
    path "MessageDigest.getInstance"
    has "MD5"
  }
  flag code.WeakHash on any {
    path "MessageDigest.getInstance"
    has "SHA-1"
  }
  flag code.WeakHash on any {
    path "MessageDigest.getInstance"
    has "SHA1"
  }
  flag code.SecretComparisonReview in function {
    function "doIndex"
    call "getReloadTokenProperty"
    call "getRequestToken"
    call path "token.equals"
    not call path "MessageDigest.isEqual"
  }

  // server-side template injection (CWE-1336) — unambiguous engine entrypoints that
  // evaluate a STRING template (not load-by-name): Velocity static evaluate, Pebble
  // literal-template, Groovy SimpleTemplateEngine. Tainted template arg -> SSTI.
  sink path "Velocity.evaluate" arg 3 -> code.TemplateRender
  sink method "getLiteralTemplate" -> code.TemplateRender

  // permissive CORS (CWE-942) — setHeader("Access-Control-Allow-Origin", "*")
  flag code.PermissiveCors on any {
    path "setHeader"
    has "Access-Control-Allow-Origin"
    has "*"
  }
  flag code.PermissiveCors on any {
    path "addHeader"
    has "Access-Control-Allow-Origin"
    has "*"
  }

  // clickjacking (CWE-1021) — X-Frame-Options EXPLICITLY set to ALLOWALL (omission not flagged)
  flag code.MissingFrameProtection on any {
    path "setHeader"
    has "X-Frame-Options"
    has "ALLOWALL"
  }
  flag code.MissingFrameProtection on any {
    path "addHeader"
    has "X-Frame-Options"
    has "ALLOWALL"
  }

  // insecure cookie (CWE-614) — a flag EXPLICITLY disabled: cookie.setHttpOnly(false)
  flag code.InsecureCookie on any {
    path "setHttpOnly"
    has "false"
  }
  flag code.InsecureCookie on any {
    path "setSecure"
    has "false"
  }

  // cleartext channel (CWE-319) — http:// URL to a client/connection (loopback excluded; low sev)
  flag code.CleartextChannel on any {
    path "URL"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "HttpGet"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "getForObject"
    has "http://"
    lacks "127.0"
  }

  // unsafe reflection (CWE-470) — tainted class/method name dynamically invoked
  sink path "Class.forName" -> code.ReflectionInvoke
  sink path "Class.forName" -> code.DynamicCodeLoad
  sink method "newInstance" -> code.ReflectionInvoke
  sink method "getDeclaredMethod" -> code.ReflectionInvoke
  sink method "getMethod" -> code.ReflectionInvoke

  // HTTP response splitting / header injection (CWE-113) — the header VALUE is arg1
  sink method "setHeader" arg 1 -> code.ResponseHeaderWrite
  sink method "addHeader" arg 1 -> code.ResponseHeaderWrite
  // CSV/formula injection (CWE-1236), unrestricted upload (CWE-434), and mass assignment (CWE-915).
  sink method "writeNext" arg all collection -> code.CsvCell
  sink method "writeAll" arg all collection -> code.CsvCell
  sink path "BeanUtils.copyProperties" arg all -> code.MassAssign
  sink method "bind" arg all -> code.MassAssign

  // log injection (CWE-117, INJ-009) + secret-in-log (CWE-532, SEC-001) — logging calls
  // are a LogOutput sink (user data → log injection) AND a LogWrite mark (secret → leak).
  sink path "logger.info" arg all -> code.LogOutput
  sink path "logger.warn" arg all -> code.LogOutput
  sink path "logger.error" arg all -> code.LogOutput
  sink path "logger.debug" arg all -> code.LogOutput
  sink path "log.info" arg all -> code.LogOutput
  sink path "log.warn" arg all -> code.LogOutput
  sink path "log.error" arg all -> code.LogOutput
  sink path "log.debug" arg all -> code.LogOutput
  sink path "LOG.info" arg all -> code.LogOutput
  sink path "LOGGER.info" arg all -> code.LogOutput
  sink path "LOG.error" arg all -> code.LogOutput
  sink path "System.out.println" arg all -> code.LogOutput
  sink method "logInfo" arg all -> code.LogOutput
  sink method "logWarning" arg all -> code.LogOutput
  sink method "logException" arg all -> code.LogOutput
  sink path "logger.info" arg all -> code.LogWrite
  sink path "logger.warn" arg all -> code.LogWrite
  sink path "logger.error" arg all -> code.LogWrite
  sink path "logger.debug" arg all -> code.LogWrite
  sink path "log.info" arg all -> code.LogWrite
  sink path "log.warn" arg all -> code.LogWrite
  sink path "log.error" arg all -> code.LogWrite
  sink path "log.debug" arg all -> code.LogWrite
  sink path "LOG.info" arg all -> code.LogWrite
  sink path "LOGGER.info" arg all -> code.LogWrite
  sink path "LOG.error" arg all -> code.LogWrite
  sink path "System.out.println" arg all -> code.LogWrite
  sink method "logInfo" arg all -> code.LogWrite
  sink method "logWarning" arg all -> code.LogWrite
  sink method "logException" arg all -> code.LogWrite
  flag code.LogWrite on any {
    path "logger.info"
  }
  flag code.LogWrite on any {
    path "logger.warn"
  }
  flag code.LogWrite on any {
    path "logger.error"
  }
  flag code.LogWrite on any {
    path "logger.debug"
  }
  flag code.LogWrite on any {
    path "log.info"
  }
  flag code.LogWrite on any {
    path "log.error"
  }
  flag code.LogWrite on any {
    path "LOG.info"
  }
  flag code.LogWrite on any {
    path "System.out.println"
  }
  flag code.LogWrite on any {
    path "logInfo"
  }
  flag code.LogWrite on any {
    path "logWarning"
  }
  flag code.LogWrite on any {
    path "logException"
  }

  // character-filter: String.replaceAll(regex, repl) is always global.
  filter method "replaceAll" global

  // ── UNSOUND neutralizers (`assume`) ───────────────────────────────────────────────
  // Never suppress; emit an assumption note (the confident bucket stays near-zero-FP, the
  // noted bucket is the review queue). guard = must DOMINATE the sink (a boundary check);
  // sanitizer = must lie ON the path. Mirrors the JS/Python `assume` sets in Java idioms.

  // String boundary/containment checks used as path or trust filters: "/tmp/../etc"
  // .startsWith("/tmp") passes yet escapes; bar.contains("../") is a substring blocklist —
  // each is bypassable (absolute paths, encodings, alternate separators).
  assume guard method "startsWith" -> code.FilePathAccess
  assume guard method "endsWith"   -> code.FilePathAccess
  assume guard method "contains"   -> code.FilePathAccess
  assume guard method "matches"    -> code.FilePathAccess
  assume guard path "analysis.guard.containment_check" -> code.FilePathAccess
  assume guard method "startsWith" -> code.TrustBoundary
  // Path canonicalizers normalize but do NOT confine to a base dir on their own.
  assume sanitizer method "normalize"        -> code.FilePathAccess
  assume sanitizer method "getCanonicalPath" -> code.FilePathAccess
  // LDAP/XPath escapers we cannot verify are complete for the sink grammar.
  assume sanitizer method "encodeForLDAP"   -> code.LdapQuery
  assume sanitizer method "encodeForDN"     -> code.LdapQuery
  assume sanitizer method "escapeLDAPSearchFilter" -> code.LdapQuery
  assume sanitizer method "encodeForXPath"  -> code.XpathQuery
}
