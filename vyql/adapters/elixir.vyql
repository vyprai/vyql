// elixir framework adapter (docs/07) — framework→concept content.
// frameworks: phoenix, plug, ecto. Module calls normalize to dotted paths
// (System.cmd).
adapter elixir {
  meta { fidelity: resolved }

  source path "analysis.parameter.entry" val "first_param:conn" nval "param_index:0" nval "param_name:_" -> code.HttpInput
  source path "analysis.parameter.entry" val "first_param:_conn" nval "param_index:0" nval "param_name:_" -> code.HttpInput
  source "conn.params" -> code.HttpInput
  source "conn.body_params" -> code.HttpInput
  source "conn.query_params" -> code.HttpInput
  source "conn.path_params" -> code.HttpInput
  source "conn.cookies" -> code.HttpInput
  source "conn.req_headers" -> code.HttpInput

  // command execution — System.shell takes the shell string as arg0 (tainted);
  // System.cmd("sh", ["-c", cmd]) buries the command in an args list, so prefer
  // the shell-string form so the tainted payload lands in arg0.
  sink path "System.cmd" arg all -> code.CommandExecution
  sink path "System.shell" -> code.CommandExecution
  sink path "os.cmd" -> code.CommandExecution
  sink method "cmd" arg all -> code.CommandExecution
  sink method "shell" -> code.CommandExecution

  // SQL — Ecto raw query / fragment (SQL.query takes Repo as arg0, query as arg1)
  sink path "Ecto.Adapters.SQL.query" arg 1 -> code.SqlExecution
  sink path "Ecto.Adapters.SQL.query!" arg 1 -> code.SqlExecution
  sink method "query" arg 1 -> code.SqlExecution
  sink method "query!" arg 1 -> code.SqlExecution
  sink method "fragment" -> code.SqlExecution
  sink method "get_user" -> code.ObjectLookupByUserInput
  sink method "get_account" -> code.ObjectLookupByUserInput
  sink method "get_order" -> code.ObjectLookupByUserInput
  sink method "get_by_id" -> code.ObjectLookupByUserInput
  flag code.AuthenticationRequiredOp on any {
    path "change_password"
  }
  flag code.AuthenticationRequiredOp on any {
    path "update_password"
  }
  flag code.AuthenticationRequiredOp on any {
    path "reset_password"
  }
  flag code.AuthenticationRequiredOp on any {
    path "change_email"
  }
  flag code.AuthenticationRequiredOp on any {
    path "transfer_funds"
  }
  flag code.AuthenticationRequiredOp on any {
    path "delete_account"
  }
  flag code.AuthenticationRequiredOp on any {
    path "grant_role"
  }
  flag code.AuthenticationRequiredOp on any {
    path "make_admin"
  }
  flag code.PortRequestResponseCorrelationMissing in function {
    lang "elixir"
    call path "Port.command"
    call path "Jason.encode!"
    call path "get_response"
    lacks "uid_counter"
    lacks "expected_uid"
    lacks "extract_uid"
  }

  // code evaluation / dynamic (CWE-95) + deserialization (CWE-502)
  sink path "Code.eval_string" -> code.CodeEval
  sink path "Code.eval_quoted" -> code.CodeEval
  sink path "Code.compile_string" -> code.CodeEval
  sink path "erlang.binary_to_term" -> code.Deserialization
  sink path ":erlang.binary_to_term" -> code.Deserialization
  sink path "Regex.compile" -> code.RegexCompile
  sink path "Regex.compile!" -> code.RegexCompile

  // path / file — the tainted path is the first argument.
  sink path "File.read" -> code.FilePathAccess
  sink path "File.read!" -> code.FilePathAccess
  sink path "File.write" -> code.FilePathAccess
  sink path "File.write!" -> code.FilePathAccess
  sink path "File.open" -> code.FilePathAccess
  sink path "File.open!" -> code.FilePathAccess
  sink path "File.rm" -> code.FilePathAccess
  sink path "File.rm!" -> code.FilePathAccess
  sink path "File.stream!" -> code.FilePathAccess
  sink path "File.cp" -> code.FilePathAccess
  sink path "File.cp!" -> code.FilePathAccess
  sink path "File.rename" -> code.FilePathAccess
  sink path "File.rename!" -> code.FilePathAccess
  sink path "File.chmod" -> code.FilePathAccess
  sink path "File.chmod!" -> code.FilePathAccess
  flag code.InsecurePermission on any {
    path "File.chmod"
    has "0o777"
  }
  flag code.InsecurePermission on any {
    path "File.chmod!"
    has "0o777"
  }
  flag code.InsecurePermission on any {
    path "File.chmod"
    has "511"
  }
  flag code.InsecurePermission on any {
    path "File.chmod!"
    has "511"
  }

  // weak hash (CWE-328) — :crypto.hash(:md5|:sha, …). `:sha` is SHA-1; exclude
  // :sha224/:sha256/:sha384/:sha512 (safe) via nval so they don't substring-match.
  flag code.WeakHash on any {
    path ":crypto.hash"
    has ":md5"
  }
  flag code.WeakHash on any {
    path ":crypto.hash"
    has ":sha"
    lacks ":sha2"
    lacks ":sha3"
    lacks ":sha5"
  }

  // weak cipher (CWE-327) — :crypto.crypto_one_time(:des_*|:rc4|:blowfish_*, …); AES safe.
  flag code.WeakCipher on any {
    path ":crypto.crypto_one_time"
    has ":des"
  }
  flag code.WeakCipher on any {
    path ":crypto.crypto_one_time"
    has ":rc4"
  }
  flag code.WeakCipher on any {
    path ":crypto.crypto_one_time"
    has ":blowfish"
  }
  flag code.StaticIv on any {
    path ":crypto.crypto_one_time"
    has "0000000000000000"
  }
  flag code.StaticIv on any {
    path "crypto_one_time"
    has "0000000000000000"
  }
  flag code.WeakCipher on any {
    path ":crypto.block_encrypt"
    has ":des"
  }
  flag code.WeakCipher on any {
    path ":crypto.block_encrypt"
    has ":blowfish"
  }

  // insecure randomness (CWE-330) — :rand.uniform / :random.uniform; the secure form
  // :crypto.strong_rand_bytes does NOT start with `:rand`, so no path collision.
  flag code.WeakRandomValue on any {
    path ":rand.uniform"
  }
  flag code.WeakRandomValue on any {
    path ":rand.normal"
  }
  flag code.WeakRandomValue on any {
    path ":random.uniform"
  }

  // insecure cookie (CWE-614) — Plug.Conn.put_resp_cookie(conn, name, val, secure: false).
  flag code.InsecureCookie on any {
    path "put_resp_cookie"
    has "false"
  }
  flag code.CleartextChannel on any {
    path "HTTPoison.get"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "HTTPoison.post"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "HTTPoison.request"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "Req.get"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "Req.request"
    has "http://"
    lacks "127.0"
  }

  // trust boundary (CWE-501) — untrusted data written into the session (arg2 = value).
  sink method "put_session" arg 2 -> code.TrustBoundary
  sink path "Plug.Conn.put_session" arg 2 -> code.TrustBoundary

  // LDAP (CWE-90) — :eldap / ldap search, the filter is arg1.
  sink method "search" arg 1 -> code.LdapQuery

  // XPath (CWE-643) — SweetXml.xpath(doc, expr): the expression is arg1.
  sink path "SweetXml.xpath" arg 1 -> code.XpathQuery
  sink method "xpath" arg 1 -> code.XpathQuery

  // XSS — Phoenix.HTML.raw bypasses auto-escaping; send_resp body is arg2.
  sink path "raw" -> code.HtmlRender
  sink path "Phoenix.HTML.raw" -> code.HtmlRender

  // controls — sanitizers/validators defined in each generated case's preamble
  control "escape_html" -> core.HtmlEscape
  control "escape_xpath" -> core.XpathEscape
  control "encode_for_ldap" -> core.LdapEscape
  control "escape_shell" -> core.ShellEscape
  control "safe_path" -> core.PathCanonicalization
  control "validate_role" -> core.InputValidation
  control "require_auth" -> core.AuthenticationCheck
  control "ensure_authenticated" -> core.AuthenticationCheck
  control "authenticated?" -> core.AuthenticationCheck
  control "check_ownership" -> core.OwnershipCheck
  control "require_owner" -> core.OwnershipCheck
  control "owner?" -> core.OwnershipCheck
}
