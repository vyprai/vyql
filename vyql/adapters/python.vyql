  // XPath injection (CWE-643) — lxml: tree.xpath(expr) / etree.XPath(expr) compile a
  // tainted query string. `.xpath` is a distinctive lxml method; taint-gated.
  sink method "xpath" -> code.XpathQuery
  sink path "etree.XPath" -> code.XpathQuery
  sink path "XPath" -> code.XpathQuery
  // elementpath.select(root, expr): the XPath expression is arg 1.
  sink path "elementpath.select" arg 1 -> code.XpathQuery
  sink path "elementpath.iter_select" arg 1 -> code.XpathQuery
  // NOTE: ElementTree .findall/.iterfind/.findtext are intentionally NOT marked — the names
  // collide with re.findall / str / BeautifulSoup, mislabeling regex as XPath, and no
  // benchmark true-positive depends on them (elementpath.select + .xpath cover the real cases).

  // controls (sanitizers/validators) — neutralize a flow that passes through them
  control "shlex.quote" -> core.ShellEscape
  // os.path.basename strips all directory components (the Python basename canonicalizer).
  control "os.path.basename" -> core.PathCanonicalization
  control "xpath_literal" -> core.XpathEscape
  control "pipes.quote" -> core.ShellEscape
  control "html.escape" -> core.HtmlEscape
  control "escape" -> core.HtmlEscape
  control "cgi.escape" -> core.HtmlEscape
  control "escape_for_html" -> core.HtmlEscape
  control "markupsafe.escape" -> core.HtmlEscape
  control "bleach.clean" -> core.HtmlEscape
  control "django.utils.html.escape" -> core.HtmlEscape
  control "yaml.safe_load" -> core.SafeDeserialization
  control "ldap.filter.escape_filter_chars" -> core.LdapEscape
  control "ldap3.utils.conv.escape_filter_chars" -> core.LdapEscape
  // Boundary check for realpath/common workspace guards: `resolved.startswith(base + os.sep)`
  // requires a path separator after the base, unlike plain prefix checks.
  control method "startswith" val "os.sep" -> core.PathAccessCheck
  control "analysis.path.access_check" val "path.resolve.parents" -> core.PathAccessCheck
  control "analysis.function.context" val "name=get_or_launch" val "SAFE_SEED_RE.match(seed)" val "os.path.join(self._data_dir,seed_key)" -> core.PathAccessCheck
  // pathlib containment guard: `candidate.resolve().relative_to(root)` raises
  // ValueError when the candidate escapes root, and is the patched idiom for
  // Windows-safe prompt file containment in CVE-2026-10044.
  control receiver method "relative_to" -> core.PathCanonicalization
  control method "relative_to" -> core.PathAccessCheck
  control "SAFE_SEED_RE.match" -> core.PathAccessCheck
  flag core.PathAccessCheck on binop {
    path exact "__binop.in"
    operand {
      path exact "__object_literal"
    }
  }

  // UNSOUND neutralizers (`assume`) — never suppress; emit an assumption note. The dominant
  // Python OWASP idiom is the `if '<bad>' in tainted:` substring blocklist, recognized
  // structurally in the lowering (an operator, not a call). These cover the method/path forms:
  // prefix/suffix checks and path canonicalizers that do NOT confine to a base directory.
  assume guard method "startswith" -> code.FilePathAccess
  assume guard method "endswith"   -> code.FilePathAccess
  assume guard path "analysis.guard.containment_check" -> code.FilePathAccess
  assume sanitizer path "os.path.normpath" -> code.FilePathAccess
  assume sanitizer path "os.path.realpath" -> code.FilePathAccess
  assume sanitizer path "posixpath.normpath" -> code.FilePathAccess

  // regex compile (ReDoS, CWE-1333) — tainted PATTERN arg0
  flag code.PackageVersionSpecifierValidationReview on any {
    path exact "re.compile"
    has "^black([^A-Z0-9._-]+.*)$"
  }
  sink path "re.compile" -> code.RegexCompile
  sink path "re.match" -> code.RegexCompile
  sink path "re.search" -> code.RegexCompile
  sink path "re.sub" -> code.RegexCompile
  sink path "re.findall" -> code.RegexCompile
  // Static catastrophic regex: a repeated segment that can consume an optional slash
  // creates ambiguous partitions for long event strings.
  sink path "re.match" val "+/?)+" -> code.CatastrophicRegex
  // Cleo table style tags: nested optional attribute groups allow exponential
  // backtracking on attacker-controlled table cell text.
  sink path "re.match" val "(\\w+=[\\w,]+;?)*" val "(\\w+=\\w+;?)*" -> code.CatastrophicRegex
  // CairoSVG rgb()/rgba() ReDoS: whitespace-star groups on both sides of a lazy
  // capture let long unterminated whitespace inputs backtrack catastrophically.
  sink path "re.compile" val "[ \\n\\r\\t]*(.+?)[ \\n\\r\\t]*" -> code.CatastrophicRegex
  // Flask-RESTX email regex ReDoS: [^@]+ can consume dots both outside and
  // inside a repeated dot-label group, creating ambiguous domain partitions.
  sink path "re.compile" val "[^@]+(?:\\.[^@]+)*" -> code.CatastrophicRegex

  // weak crypto (CWE-327/328) — presence marker on the call node
  flag code.WeakHash on any {
    path "hashlib.md5"
  }
  flag code.WeakHash on any {
    path "hashlib.sha1"
  }
  flag code.WeakHash on any {
    path "hashlib.md4"
  }
  flag code.WeakHash on any {
    path "hashlib.md2"
  }
  // hashlib.new("md5") — algorithm by name (value-matched). "sha1"/"md5"/… only, never the
  // bare "sha" substring (it would match the strong sha224/256/384/512 family).
  flag code.WeakHash on any {
    path "hashlib.new"
    has "md5"
  }
  flag code.WeakHash on any {
    path "hashlib.new"
    has "md4"
  }
  flag code.WeakHash on any {
    path "hashlib.new"
    has "md2"
  }
  flag code.WeakHash on any {
    path "hashlib.new"
    has "sha1"
  }

  // insecure file permission (CWE-732) — world-writable / overly-broad mode. Restrictive
  // modes (0o600/0o640/0o644) are not matched. octal forms 0o777 and 0o666 are covered.
  flag code.InsecurePermission on any {
    path "os.chmod"
    has "0o777"
  }
  flag code.InsecurePermission on any {
    path "os.chmod"
    has "0o666"
  }
  flag code.InsecurePermission on any {
    path "os.fchmod"
    has "0o777"
  }
  flag code.InsecurePermission on any {
    path "os.fchmod"
    has "0o666"
  }
  flag code.InsecurePermission on any {
    path "os.open"
    has "0o777"
  }
  flag code.InsecurePermission on any {
    path "os.open"
    has "0o666"
  }
  flag code.InsecurePermission on any {
    path "Path.chmod"
    has "0o777"
  }
  flag code.InsecurePermission on any {
    method "mkdir"
    fact parents "True"
    fact exist_ok "True"
    not fact mode ""
  }

  // resource lifecycle (CWE-772, RES-001) — a raw socket handle that must be closed on
  // every path. close() is receiver-agnostic (control method). Context-manager (`with`)
  // forms don't lower the alloc, so they aren't flagged.
  flag code.ResourceHandle on any {
    path "socket.socket"
  }
  control method "close" -> core.ResourceRelease

  // weak randomness (CWE-330) — presence of the non-crypto `random` module PRNG. Secure
