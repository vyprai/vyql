  // CSV injection (CWE-1236)
  sink method "writerow" collection -> code.CsvCell
  sink method "writerows" collection -> code.CsvCell

  // weak cipher (CWE-327) — named broken ciphers
  flag code.WeakCipher on any {
    path "DES.new"
  }
  flag code.WeakCipher on any {
    path "ARC4.new"
  }
  flag code.WeakCipher on any {
    path "Blowfish.new"
  }
  flag code.WeakCipher on any {
    path "DES3.new"
  }
  // PyCrypto/PyCryptodome AES.new defaults to ECB when no MODE_* argument is supplied.
  flag code.WeakCipher on any {
    path exact "AES.new"
    lacks "MODE_"
  }
  // ECB mode (CWE-327) — pycryptodome AES.MODE_ECB constant or cryptography modes.ECB().
  // The mode is a member access / call (not a string), so match the path on the Attr/Call.
  flag code.WeakCipher on any {
    path "AES.MODE_ECB"
  }
  flag code.WeakCipher on any {
    path "DES.MODE_ECB"
  }
  flag code.WeakCipher on any {
    path "DES3.MODE_ECB"
  }
  flag code.WeakCipher on any {
    path "modes.ECB"
  }
  flag code.StaticIv on any {
    path "AES.new"
    has "0000000000000000"
  }
  flag code.StaticIv on any {
    path "DES3.new"
    has "00000000"
  }
  flag code.StaticIv on any {
    path "Cipher"
    has "0000000000000000"
  }
  flag code.StaticIv on any {
    path "IvParameterSpec"
    has "0000000000000000"
  }

  // insecure temp file (CWE-377) — tempfile.mktemp is documented-insecure (race)
  flag code.InsecureTempFile on any {
    path "tempfile.mktemp"
  }
  flag code.InsecureTempFile on any {
    path "os.path.join"
    has "/var/tmp/"
  }
  flag code.InsecureTempFile on any {
    path "open"
    has "/tmp/"
    has "w"
  }
  flag code.InsecureTempFile on any {
    path "open"
    has "/var/tmp/"
    has "w"
  }
  flag code.InsecureTempFile on any {
    path "open"
    has ".lxc-attach-script"
    has "w"
  }
  flag code.InsecureTempFile on any {
    path "open"
    has "lxc-attach-script.log"
    has "a"
  }
  flag code.InsecureTempFile on any {
    path "open"
    has "lxc-attach-script.err"
    has "a"
  }

  // TLS cert validation disabled (CWE-295) — requests/httpx verify=False
  flag code.CertValidationDisabled on any {
    path "requests"
    fact verify "False"
  }
  flag code.CertValidationDisabled on any {
    path "httpx"
    fact verify "False"
  }
  flag code.CertValidationDisabled in function {
    fact use_ssl "False"
    has "Tls("
    fact validate "ssl.CERT_REQUIRED"
    has "Server("
  }

  // JWT signature not verified (CWE-347) — pyjwt alg none / verify off
  flag code.JwtUnverified on any {
    path "jwt.decode"
    fact algorithms "none"
  }
  flag code.JwtUnverified on any {
    path "jwt.decode"
    fact verify_signature "False"
  }
  flag code.JwtUnverified on any {
    path "jwt.decode"
    fact verify "False"
  }
  flag code.JwtUnverified on any {
    path "jwt.encode"
    fact algorithm "none"
  }
  flag code.HeaderControlledJwkReview in function {
    name "_prepare_algorithm_key"
    has "key is None and \"jwk\" in header"
    has "key = header[\"jwk\"]"
    has "prepare_key(key)"
  }
  flag code.HeaderControlledJwkReview in function {
    name "prepare_key"
    has "key is None and \"jwk\" in header"
    has "key = header[\"jwk\"]"
    has "prepare_key(key)"
  }
  flag code.ConfigExposureReview in function {
    name "to_dict"
    has "self.__dict__.items"
    has "storage[k] = v"
    lacks "api"
  }

  // cleartext channel (CWE-319) — http:// URL to an HTTP client, excluding loopback
  // dev traffic (127.0.x); still FP-prone for other internal hosts → low sev.
  flag code.CleartextChannel on any {
    path "requests"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "httpx"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "urllib.request.urlopen"
    has "http://"
    lacks "127.0"
  }

  // insecure cookie (CWE-614) — a security flag EXPLICITLY disabled. Pure omission is
  // not flagged (too many false positives from framework defaults / cookie deletions).
  flag code.InsecureCookie on any {
    path "set_cookie"
    fact httponly "False"
  }
  flag code.InsecureCookie on any {
    path "set_cookie"
    fact secure "False"
  }

  // permissive CORS (CWE-942) — headers.add("Access-Control-Allow-Origin", "*")
  // or flask-cors CORS(app, origins="*") / cross_origin(origins="*").
  flag code.PermissiveCors on any {
    path "headers.add"
    has "Access-Control-Allow-Origin"
    has "*"
  }
  flag code.PermissiveCors on any {
    path "CORS"
    fact origins "*"
  }
  flag code.PermissiveCors on any {
    path "cross_origin"
    fact origins "*"
  }

  // clickjacking (CWE-1021) — X-Frame-Options EXPLICITLY set to ALLOWALL via a header
  // call (omission / subscript-assignment not flagged).
  flag code.MissingFrameProtection on any {
    path "headers.add"
    has "X-Frame-Options"
    has "ALLOWALL"
  }
  flag code.MissingFrameProtection on any {
    path "headers.setdefault"
    has "X-Frame-Options"
    has "ALLOWALL"
  }

  // character-filter: re.sub(pattern, repl, s) is always global.
  filter path "re.sub" global
  filter path "re.subn" global
}
