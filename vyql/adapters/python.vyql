// python framework adapter (docs/07) — framework→concept content.
// frameworks: flask, django, fastapi, starlette, aiohttp, tornado, bottle, pyramid, sanic, falcon, webapp2
adapter python {
  meta { fidelity: resolved }

  source path "analysis.parameter.entry" val "decorator_method:get" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:post" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:put" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:delete" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:patch" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:head" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:options" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:route" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:websocket" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:api_route" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:filter" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "function_name:resolve_" nval "param_name:self" nval "param_name:cls" nval "param_name:info" nval "param_name:root" nval "param_name:parent" nval "param_name:_" -> code.HttpInput

  source "request.form" -> code.HttpInput
  source "request.query_string" -> code.HttpInput
  source "request.full_path" -> code.HttpInput
  source "request.url" -> code.HttpInput
  // request stored on an object (e.g. a wrapper `self.request = flask.request`, then
  // `self.request.form.get(...)`): the same accessors under a `.request.` prefix.
  source "self.request.form" -> code.HttpInput
  source "self.request.args" -> code.HttpInput
  source "self.request.values" -> code.HttpInput
  source "self.request.cookies" -> code.HttpInput
  source "self.request.headers" -> code.HttpInput
  source "self.request.get_json" -> code.HttpInput
  source "self.request.json" -> code.HttpInput
  source "self.request.data" -> code.HttpInput
  source "self.request.files" -> code.HttpInput
  source "self.request.get_data" -> code.HttpInput
  source "request.args" -> code.HttpInput
  source "request.values" -> code.HttpInput
  source "request.cookies" -> code.HttpInput
  source "request.get_json" -> code.HttpInput
  source "request.json" -> code.HttpInput
  source "request.data" -> code.HttpInput
  source "request.headers" -> code.HttpInput
  source "request.files" -> code.HttpInput
  source "request.stream" -> code.HttpInput
  source "request.get_data" -> code.HttpInput
  source "request.view_args" -> code.HttpInput
  source "request.GET" -> code.HttpInput
  source "request.POST" -> code.HttpInput
  source "request.body" -> code.HttpInput
  source "request.COOKIES" -> code.HttpInput
  source path "analysis.function.context.source" val "traceback.format_exc" val "<pre" nval "cgi.escape" nval "html.escape" nval "markupsafe.escape" -> code.HttpInput
  source path "analysis.function.context.source" val "traceback.format_exc" val "<html" nval "cgi.escape" nval "html.escape" nval "markupsafe.escape" -> code.HttpInput
  // Bugsink ingestion helper: envelope event_id is request-controlled and must be
  // constrained to a filename-safe UUID before being joined under the ingest store.
  source path "analysis.function.context.source" val "name=get_filename_for_event_id" val "event_id" val "os.path.join" val "INGEST_STORE_BASE_DIR" nval "uuid.UUID(event_id).hex" -> code.HttpInput
  // calibre RocketBook table-of-contents item names are archive member names.
  source path "analysis.function.context.source" val "name=get_text" val "toc_item.name.decode('utf-8')" val "os.path.join(output_dir,toc_item.name.decode('utf-8'))" nval "get_safe_path" -> code.ArchiveEntryName
  source path "analysis.function.context.source" val "name=get_image" val "toc_item.name.decode('utf-8')" val "os.path.join(output_dir,toc_item.name.decode('utf-8'))" nval "get_safe_path" -> code.ArchiveEntryName
  flag code.ArchiveSymlinkFilterBypass in function {
    name "safe_extract"
    has "tar.getmembers()"
    has "os.path.join(path,member.name)"
    has "is_within_directory(path,member_path)"
    has "tar.extractall(path,members,numeric_owner=numeric_owner)"
    lacks "member.issym()"
    lacks "member.islnk()"
    lacks "member.linkname"
  }
  flag code.LockFileCreateMissingNoFollow in function {
    lang "python"
    function contains_any ["acquire", "lock"]
    call path "os.open"
    selector "os.O_CREAT"
    selector "os.O_EXCL"
    not literal "O_NOFOLLOW"
  }
  source path "analysis.function.context.source" val "name=generate_auth_token" val "RemoteAuthToken.user_id==user_id" val "auth_token.user_id=user_id" nval "current_user.id!=user_id" -> code.HttpInput
  source path "analysis.function.context.source" val "name=delete_auth_token" val "RemoteAuthToken.user_id==user_id" val "delete()" nval "current_user.id!=user_id" -> code.HttpInput
  flag code.EmmettUnhandledCookieParseException in function {
    name "cookies"
    has "forcookieinself.headers.get(\"cookie\",\"\").split(\";\"):"
    has "cookies.load(cookie)"
    lacks "exceptException"
    lacks "continue"
  }
  flag code.DnsUdpResponseValidationAfterLoop in function {
    name "udp"
    has ".recvfrom"
    has "dns.message.from_wire"
    has "q.is_response"
    has "from_address==destination"
    has "break"
    lacks "ignore_errors"
    lacks "exceptdns.message.Truncated"
  }
  source "request.META" -> code.HttpInput
  source "request.FILES" -> code.HttpInput
  source "request.path_info" -> code.HttpInput
  source "request.query_params" -> code.HttpInput
  source "request.path_params" -> code.HttpInput
  source "request.data" -> code.HttpInput
  source "request.query" -> code.HttpInput
  source "request.post" -> code.HttpInput
  source "request.match_info" -> code.HttpInput
  source "request.rel_url" -> code.HttpInput
  source "request.read" -> code.HttpInput
  source "request.text" -> code.HttpInput
  source "request.multipart" -> code.HttpInput
  source "self.get_argument" -> code.HttpInput
  source "self.get_query_argument" -> code.HttpInput
  source "self.get_body_argument" -> code.HttpInput
  source "self.get_arguments" -> code.HttpInput
  source "self.request.arguments" -> code.HttpInput
  source "self.request.body" -> code.HttpInput
  source "self.get_cookie" -> code.HttpInput
  source "self.request.query_arguments" -> code.HttpInput
  source "request.forms" -> code.HttpInput
  source "request.params" -> code.HttpInput
  source "request.matchdict" -> code.HttpInput
  source "request.json_body" -> code.HttpInput
  source "request.query_parameters" -> code.HttpInput
  source "request.urlargs" -> code.HttpInput
  source "ctx.request.json" -> code.HttpInput
  source "req.params" -> code.HttpInput
  source "req.media" -> code.HttpInput
  source path "analysis.function.context.source" val "class_bases=serializers.ModelSerializer" val "fields" val "is_superuser" val "validated_data" val "objects.create" nval "pop('is_superuser'" nval "pop(\"is_superuser\"" -> code.HttpInput
  source path "analysis.function.context.source" val "class_bases=serializers.ModelSerializer" val "fields" val "is_superuser" val "validated_data" val "super().update" nval "pop('is_superuser'" nval "pop(\"is_superuser\"" -> code.HttpInput
  source "req.get_param" -> code.HttpInput
  source "req.stream" -> code.HttpInput
  source "sys.argv" -> code.CliArgument
  flag code.AbsolutePathDisclosure in function {
    name "configure"
    has "CASE_DEMO_NONRANDOM_UUID_BASE"
    has "sys.argv[0]"
    has "command_original_path.resolve()"
    has "command_resolved_path.relative_to"
    has "demo_uuid_base_parts.append(str(command_resolved_path))"
    lacks "_is_relative_to(command_resolved_path,venv_resolved_path)"
    lacks "demo_uuid_base_parts.append(str(command_original_path))"
  }
  flag code.SensitiveConfigInfoLog in function {
    name "load_config"
    has "yaml.safe_load"
    has "LOG.info"
    has "Config file:"
    lacks "LOG.debug(\"Config file:"
  }
  flag code.TyperPrettyExceptionLocalsSecretExposure in module {
    lang "python"
    call path "typer.Typer"
    literal contains_any ["GH_TOKEN", "GITHUB_TOKEN", "TOKEN"]
    not call arg contains "typer.Typer:pretty_exceptions_show_locals=False"
  }
  flag code.CkanSolrConnectionErrorDisclosure in function {
    name "run"
    has "conn.search(**query)"
    has "pysolr.SolrError"
    has "raise SearchError"
    has "SOLR returned an error running query"
    has "query, e"
    lacks "SolrConnectionError"
    lacks "Failed to connect to server"
  }
  flag code.CloakserveFingerprintSeedPathTraversal in function {
    name "get_or_launch"
    has "os.path.join(self._data_dir,seed_key)"
    has "os.makedirs(user_data_dir"
    has "shutil.rmtree"
    lacks "SAFE_SEED_RE.match(seed)"
    lacks "_safe_rmtree"
  }
  flag code.EmailAttachmentFilenamePathTraversal in function {
    has "include_attachment_data=True"
    has "for a in m['attachment']:"
    has "out_path / a['filename']"
    has "out_filepath.open('wb')"
    has "base64.b64decode(a['raw'])"
    lacks "pathlib.Path(a['filename']).name"
    lacks "os.path.basename(a['filename'])"
  }
  flag code.InternalAssetRoutePathTraversal in function {
    path exact "analysis.function.context"
    has "path.startswith(\"/__emmett__\")"
    has "file_name = path[12:]"
    has "os.path.join(os.path.dirname(__file__), \"..\", \"assets\", file_name)"
    has "self._static_response(static_file)"
    lacks "os.path.realpath"
    lacks "static_file.startswith"
    lacks ".relative_to"
  }
  flag code.AnsibleSnmpFactsCredentialsNoLogMissing in function {
    name "main"
    has "AnsibleModule"
    fact authkey "dict(type='str')"
    fact privkey "dict(type='str')"
    has "cmdgen.UsmUserData"
    not fact authkey "dict(type='str',no_log=True)"
    not fact privkey "dict(type='str',no_log=True)"
  }
  source "input" -> code.StdinInput
  source "sys.stdin" -> code.StdinInput
  source "fileinput.input" -> code.StdinInput
  source method "[]" val "-8:" -> code.ShortSecurityIdentifier
  flag code.WerkzeugDebugConsoleExposure in function {
    has "app.run"
    fact host "'0.0.0.0'"
    fact debug "True"
    not fact use_evalex "False"
  }
  source "os.environ.get" val "HTTP_PROXY" -> code.HttpInput
  source "os.getenv" val "HTTP_PROXY" -> code.HttpInput
  source "os.environ" -> code.SecretValue
  source "os.getenv" -> code.SecretValue
  source "config.get" -> code.SecretValue
  source "settings.SECRET_KEY" -> code.SecretValue
  flag code.HardcodedSecret in function {
    has "app.config[\"SECRET_KEY\"]=\""
    lacks "os.environ"
    lacks "os.getenv"
    lacks "secrets."
    lacks "build_secret_key()"
  }
  flag code.HardcodedSecret in function {
    has "app.config['SECRET_KEY']=\""
    lacks "os.environ"
    lacks "os.getenv"
    lacks "secrets."
    lacks "build_secret_key()"
  }
  flag code.HardcodedSecret in function {
    has "app.config[\"SECRET_KEY\"]='"
    lacks "os.environ"
    lacks "os.getenv"
    lacks "secrets."
    lacks "build_secret_key()"
  }
  flag code.HardcodedSecret in function {
    has "app.config['SECRET_KEY']='"
    lacks "os.environ"
    lacks "os.getenv"
    lacks "secrets."
    lacks "build_secret_key()"
  }
  flag code.AutoActiveSignupAccount in function {
    name "signup"
    has "UserStatus.ACTIVE"
    has "UserRole.USER"
    has "generate_keypair"
    has "create_user_with_keypair"
    lacks "UserStatus.INACTIVE"
  }

  // stored / second-order data — DB cursor reads (CWE-79 stored XSS when later rendered
  // unescaped). Only unambiguous cursor fetch methods are marked (bare .get/.all/.first
  // are too common on dicts/lists to mark without heavy FP).
  source method "fetchall" -> code.DatabaseRead
  source method "fetchone" -> code.DatabaseRead
  source method "fetchmany" -> code.DatabaseRead
  // PII sources are now a CROSS-LANGUAGE configurable taxonomy — see adapters/pii.vyql.

  sink method "execute" -> code.SqlExecution
  sink method "executemany" -> code.SqlExecution
  sink method "executescript" -> code.SqlExecution
  sink method "executescript" -> code.SqlExecution
  sink method "raw" -> code.SqlExecution
  sink method "extra" -> code.SqlExecution
  sink path "sqlalchemy.text" -> code.SqlExecution
  sink path "session.execute" -> code.SqlExecution
  sink path "connection.execute" -> code.SqlExecution
  sink path "db.execute" -> code.SqlExecution
  sink path "cursor.execute" -> code.SqlExecution
  sink path "RawSQL" -> code.SqlExecution
  sink path "django.db.connection.cursor" -> code.SqlExecution
  flag code.McpSqlExecutionMissingValidation in function {
    name "execute_sql_for_mcp"
    has "QueryRequest("
    fact sql "sql"
    has "self.execute_query(query_request,auth_context)"
    lacks "validate_sql_security"
    lacks "DorisSecurityManager"
  }
  // asyncpg raw query methods (CWE-89)
  sink method "fetch" -> code.SqlExecution
  sink method "fetchrow" -> code.SqlExecution
  sink method "fetchval" -> code.SqlExecution
  // CSRF (CWE-352, RF-003) — security-sensitive state-changing operations. Scoped to
  // high-impact mutations (not generic .save/.update) to stay low-FP. The guarded reject
  // is a graph spec: linking a CSRF token check to its endpoint in code needs CFG analysis.
  sink method "change_password" -> code.StateChangingOp
  sink method "changePassword" -> code.StateChangingOp
  sink method "update_password" -> code.StateChangingOp
  sink method "reset_password" -> code.StateChangingOp
  sink method "change_email" -> code.StateChangingOp
  sink method "transfer_funds" -> code.StateChangingOp
  sink method "transferFunds" -> code.StateChangingOp
  sink method "delete_account" -> code.StateChangingOp
  sink method "grant_role" -> code.StateChangingOp
  sink method "make_admin" -> code.StateChangingOp
  flag code.AuthenticationRequiredOp on any {
    path "change_password"
  }
  flag code.AuthenticationRequiredOp on any {
    path "changePassword"
  }
  flag code.AuthenticationRequiredOp on any {
    path "update_password"
  }
  flag code.AuthenticationRequiredOp on any {
    path "reset_password"
  }
  flag code.AuthenticationRequiredOp on any {
    path "change_email"
  }
  flag code.AuthenticationRequiredOp on any {
    path "transfer_funds"
  }
  flag code.AuthenticationRequiredOp on any {
    path "transferFunds"
  }
  flag code.AuthenticationRequiredOp on any {
    path "delete_account"
  }
  flag code.AuthenticationRequiredOp on any {
    path "grant_role"
  }
  flag code.AuthenticationRequiredOp on any {
    path "make_admin"
  }
  // CSRF protection — explicit token verification (guards RF-003 via a PROTECTS edge)
  control "validate_csrf_token" -> core.CsrfProtection
  control "verify_authenticity_token" -> core.CsrfProtection
  control method "login_required" -> core.AuthenticationCheck
  control method "require_auth" -> core.AuthenticationCheck
  control method "ensure_authenticated" -> core.AuthenticationCheck
  control method "is_authenticated" -> core.AuthenticationCheck
  control method "authenticate" -> core.AuthenticationCheck
  // authorization checks (guards BIZ-001) — high-precision permission predicates. With B1
  // the labelled check suppresses only the sinks it DOMINATES (path-sensitive).
  control "has_perm" -> core.AuthorizationCheck
  control "has_permission" -> core.AuthorizationCheck
  control "permission_required" -> core.AuthorizationCheck
  control "user_passes_test" -> core.AuthorizationCheck
  flag code.EffectiveUidRootCheckBypass in function {
    name "run"
    has "os.geteuid()==0"
    has "superuser privileges"
    not name "run_worker"
    lacks "os.getuid()==0"
  }
  flag code.AccessPolicyReview in function {
    name "create_shelf"
    has "ub.Shelf()"
    has "create_edit_shelf"
    has "page=\"shelfcreate\""
    lacks "role_edit_shelfs"
  }
  flag code.CodeCheckerGuidelineRulesMissingViewCheck in function {
    name "getGuidelineRules"
    has "rules_of_guideline"
    has "checkers_by_labels"
    lacks "self.__require_view()guideline_rules=defaultdict(list)"
  }
  flag code.TokenCacheAuthorizationBypass on any {
    path "DIRAC.FrameworkSystem.Utilities.TokenManagementUtilities.getCachedToken"
  }
  flag code.FlaskEntityDetailMissingAuthorization in function {
    token decorator_method "route"
    has ".query.get_or_404"
    has "jsonify"
    has "permissions"
    lacks "current_user.admin"
    lacks "has_permission"
    lacks "permission_required"
  }
  flag code.OverbroadRolePermissionGrant in module {
    lang "python"
    token assign_item contains_any [
      "viewer_scopes:CONFIG_READ",
      "viewer_scopes:CONFIG_UPDATE",
      "viewer_scopes:ADMIN",
      "read_only_scopes:CONFIG_READ",
      "read_only_scopes:CONFIG_UPDATE",
      "guest_scopes:CONFIG_READ",
      "public_scopes:CONFIG_READ"
    ]
  }
  control method "check_ownership" -> core.OwnershipCheck
  control method "require_owner" -> core.OwnershipCheck
  control method "is_owner" -> core.OwnershipCheck
  // SSRF / open-redirect allowlist validators — guard the fetch/redirect they dominate
  // (validators gate via control flow; B1 connects them to the sink). Django's
  // url_has_allowed_host_and_scheme / is_safe_url is the canonical redirect check.
  control "url_has_allowed_host_and_scheme" -> core.RedirectAllowlist
  control "is_safe_url" -> core.RedirectAllowlist
  control "is_safe_redirect_url" -> core.RedirectAllowlist
  control "is_allowed_url" -> core.AllowlistValidation
  control "is_allowed_host" -> core.AllowlistValidation
  control method "login" -> core.InputValidation
  control method "authenticate" -> core.InputValidation
  control method "authenticate_user" -> core.InputValidation
  control method "sign_in" -> core.InputValidation
  control method "log_in" -> core.InputValidation
  control method "check_credentials" -> core.InputValidation
  control method "verify_credentials" -> core.InputValidation
  control method "validate_credentials" -> core.InputValidation
  control method "check_password" -> core.InputValidation
  control method "verify_password" -> core.InputValidation
  control "analysis.function.result" val "marker:validator" -> core.InputValidation
  control "validate_url" -> core.AllowlistValidation
  control "_validate_url" -> core.AllowlistValidation
  control "analysis.function.context" val "socket.getaddrinfo" val "ipaddress.ip_address" val "is_private" val "is_loopback" val "is_link_local" -> core.AllowlistValidation
  control "validate_python_code" -> core.CodeExecutionValidation
  // XXE hardening — a parser configured to not resolve external entities / fetch network,
  // dominating the parse it is passed to (value-matched config).
  control "etree.XMLParser" val "resolve_entities=False" -> core.XmlHardening
  control "etree.XMLParser" val "no_network=True" -> core.XmlHardening
  control "lxml.etree.XMLParser" val "resolve_entities=False" -> core.XmlHardening
  control "XMLParser" val "resolve_entities=False" -> core.XmlHardening
  control "objectify.makeparser" val "resolve_entities=False" -> core.XmlHardening
  control "lxml.objectify.makeparser" val "resolve_entities=False" -> core.XmlHardening
  // log injection (CWE-117, INJ-009) + secret-in-log (CWE-532, SEC-001) — logging calls
  // are a LogOutput sink (user data) AND a LogWrite mark (secret).
  sink path "logging.info" -> code.LogOutput
  sink path "logging.warning" -> code.LogOutput
  sink path "logging.error" -> code.LogOutput
  sink path "logging.debug" -> code.LogOutput
  sink path "logger.info" -> code.LogOutput
  sink path "logger.warning" -> code.LogOutput
  sink path "logger.error" -> code.LogOutput
  sink path "logger.debug" -> code.LogOutput
  sink path "log.info" -> code.LogOutput
  sink path "log.error" -> code.LogOutput
  flag code.UnneutralizedDiagnosticValue in function {
    name "parsedkim"
    has "_warnmsg"
    has "Unknown DKIM key type"
    has "dkim['k']"
    lacks "_warnmsg(\"Unknown DKIM key type\")"
  }
  flag code.RequestPathPercentSLogInjection in function {
    lang "python"
    call path contains_any ["LOG.debug", "logger.debug", "logging.debug", "log.debug"]
    attr path "request.path"
    call arg contains_any ["LOG.debug:Request to '%s'", "logger.debug:request path %s", "logging.debug:path %s", "log.debug:path %s"]
    not call arg contains_any ["LOG.debug:Request to '%r'", "logger.debug:request path %r", "logging.debug:path %r", "log.debug:path %r"]
    not call path contains_any ["repr", "escape", "sanitize"]
  }
  flag code.LogWrite on any {
    path "logging.info"
  }
  flag code.LogWrite on any {
    path "logging.warning"
  }
  flag code.LogWrite on any {
    path "logging.error"
  }
  flag code.LogWrite on any {
    path "logging.debug"
  }
  flag code.LogWrite on any {
    path "logger.info"
  }
  flag code.LogWrite on any {
    path "logger.error"
  }
  flag code.LogWrite on any {
    path "log.info"
  }
  flag code.LogWrite on any {
    path "LOG.debug"
  }
  flag code.LogWrite on any {
    path "LOG.info"
  }
  flag code.LogWrite on any {
    path "LOG.warning"
  }
  flag code.LogWrite on any {
    path "LOG.error"
  }
  flag code.CredentialAttributeLogExposure in function {
    lang "python"
    call path contains_any ["LOG.debug", "logger.debug", "logging.debug"]
    selector contains_any ["loc.accesskey", "loc.secretkey"]
    token identifier contains_any ["accesskey", "access_key", "secretkey", "secret_key"]
  }
  sink path "os.system" -> code.CommandExecution
  sink path "os.popen" -> code.CommandExecution
  sink path "os.popen2" -> code.CommandExecution
  sink path "os.popen3" -> code.CommandExecution
  sink path "os.popen4" -> code.CommandExecution
  sink path "subprocess.call" collection first -> code.CommandExecution
  sink path "subprocess.run" collection first -> code.CommandExecution
  sink path "subprocess.Popen" collection first -> code.CommandExecution
  sink path "subprocess.call" collection 2 val "-c" -> code.CommandExecution
  sink path "subprocess.run" collection 2 val "-c" -> code.CommandExecution
  sink path "subprocess.Popen" collection 2 val "-c" -> code.CommandExecution
  sink path "subprocess.Popen" val "self.args" val "tag.filename" nval "--" -> code.CommandOptionInjection
  sink path "subprocess.Popen" val "self.args" val "filename" nval "--" -> code.CommandOptionInjection
  sink path "subprocess.check_output" collection first -> code.CommandExecution
  sink path "subprocess.check_call" collection first -> code.CommandExecution
  sink path "subprocess.check_output" collection 2 val "-c" -> code.CommandExecution
  sink path "subprocess.check_call" collection 2 val "-c" -> code.CommandExecution
  sink path "subprocess.getoutput" -> code.CommandExecution
  sink path "subprocess.getstatusoutput" -> code.CommandExecution
  sink path "commands.getoutput" -> code.CommandExecution
  sink path "commands.getstatusoutput" -> code.CommandExecution
  flag code.CommandStringWrapperExecution in function {
    lang "python"
    call path contains_any [
      "subprocess.run",
      "subprocess.call",
      "subprocess.Popen",
      "subprocess.check_output",
      "subprocess.check_call",
    ]
    fact shell "True"
    assign contains_any [
      "command=f\"",
      "command=f'",
      "cmd=f\"",
      "cmd=f'",
      "shell_command=f\"",
      "shell_command=f'",
