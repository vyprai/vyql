// python framework adapter (docs/07) — framework→concept content.
// frameworks: flask, django, fastapi, starlette, aiohttp, tornado, bottle, pyramid, sanic, falcon, webapp2
adapter python {
  meta { fidelity: resolved }

  source path "analysis.parameter.entry" val "decorator_method:get" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:post" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:put" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:delete" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:patch" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:head" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:options" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:route" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:websocket" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "decorator_method:api_route" nval "param_name:self" nval "param_name:cls" -> code.HttpInput
  source path "analysis.parameter.entry" val "function_name:resolve_" nval "param_name:self" nval "param_name:cls" nval "param_name:info" nval "param_name:root" nval "param_name:parent" nval "param_name:_" -> code.HttpInput

  source "request.form" -> code.HttpInput
  source "request.query_string" -> code.HttpInput
  source "request.full_path" -> code.HttpInput
  source "request.url" -> code.HttpInput
  // request stored on an object (e.g. a wrapper `self.request = flask.request`, then
  // `self.request.form.get(...)`): the same accessors under a `.request.` prefix.
  source "self.request.form" -> code.HttpInput
  source "self.request.args" -> code.HttpInput
  source "self.request.values" -> code.HttpInput
  source "self.request.cookies" -> code.HttpInput
  source "self.request.headers" -> code.HttpInput
  source "self.request.get_json" -> code.HttpInput
  source "self.request.json" -> code.HttpInput
  source "self.request.data" -> code.HttpInput
  source "self.request.files" -> code.HttpInput
  source "self.request.get_data" -> code.HttpInput
  source "request.args" -> code.HttpInput
  source "request.values" -> code.HttpInput
  source "request.cookies" -> code.HttpInput
  source "request.get_json" -> code.HttpInput
  source "request.json" -> code.HttpInput
  source "request.data" -> code.HttpInput
  source "request.headers" -> code.HttpInput
  source "request.files" -> code.HttpInput
  source "request.stream" -> code.HttpInput
  source "request.get_data" -> code.HttpInput
  source "request.view_args" -> code.HttpInput
  source "request.GET" -> code.HttpInput
  source "request.POST" -> code.HttpInput
  source "request.body" -> code.HttpInput
  source "request.COOKIES" -> code.HttpInput
  source path "analysis.function.context.source" val "traceback.format_exc" val "<pre" nval "cgi.escape" nval "html.escape" nval "markupsafe.escape" -> code.HttpInput
  source path "analysis.function.context.source" val "traceback.format_exc" val "<html" nval "cgi.escape" nval "html.escape" nval "markupsafe.escape" -> code.HttpInput
  source "request.META" -> code.HttpInput
  source "request.FILES" -> code.HttpInput
  source "request.path_info" -> code.HttpInput
  source "request.query_params" -> code.HttpInput
  source "request.path_params" -> code.HttpInput
  source "request.data" -> code.HttpInput
  source "request.query" -> code.HttpInput
  source "request.post" -> code.HttpInput
  source "request.match_info" -> code.HttpInput
  source "request.rel_url" -> code.HttpInput
  source "request.read" -> code.HttpInput
  source "request.text" -> code.HttpInput
  source "request.multipart" -> code.HttpInput
  source "self.get_argument" -> code.HttpInput
  source "self.get_query_argument" -> code.HttpInput
  source "self.get_body_argument" -> code.HttpInput
  source "self.get_arguments" -> code.HttpInput
  source "self.request.arguments" -> code.HttpInput
  source "self.request.body" -> code.HttpInput
  source "self.get_cookie" -> code.HttpInput
  source "self.request.query_arguments" -> code.HttpInput
  source "request.forms" -> code.HttpInput
  source "request.params" -> code.HttpInput
  source "request.matchdict" -> code.HttpInput
  source "request.json_body" -> code.HttpInput
  source "request.query_parameters" -> code.HttpInput
  source "request.urlargs" -> code.HttpInput
  source "ctx.request.json" -> code.HttpInput
  source "req.params" -> code.HttpInput
  source "req.media" -> code.HttpInput
  source path "analysis.function.context.source" val "class_bases=serializers.ModelSerializer" val "fields" val "is_superuser" val "validated_data" val "objects.create" nval "pop('is_superuser'" nval "pop(\"is_superuser\"" -> code.HttpInput
  source path "analysis.function.context.source" val "class_bases=serializers.ModelSerializer" val "fields" val "is_superuser" val "validated_data" val "super().update" nval "pop('is_superuser'" nval "pop(\"is_superuser\"" -> code.HttpInput
  source "req.get_param" -> code.HttpInput
  source "req.stream" -> code.HttpInput
  source "sys.argv" -> code.CliArgument
  source "input" -> code.StdinInput
  source "sys.stdin" -> code.StdinInput
  source "fileinput.input" -> code.StdinInput
  source method "[]" val "-8:" -> code.ShortSecurityIdentifier
  source "os.environ.get" val "HTTP_PROXY" -> code.HttpInput
  source "os.getenv" val "HTTP_PROXY" -> code.HttpInput
  source "os.environ" -> code.SecretValue
  source "os.getenv" -> code.SecretValue
  source "config.get" -> code.SecretValue
  source "settings.SECRET_KEY" -> code.SecretValue

  // stored / second-order data — DB cursor reads (CWE-79 stored XSS when later rendered
  // unescaped). Only unambiguous cursor fetch methods are marked (bare .get/.all/.first
  // are too common on dicts/lists to mark without heavy FP).
  source method "fetchall" -> code.DatabaseRead
  source method "fetchone" -> code.DatabaseRead
  source method "fetchmany" -> code.DatabaseRead
  // PII sources are now a CROSS-LANGUAGE configurable taxonomy — see adapters/pii.vyql.

  sink method "execute" -> code.SqlExecution
  sink method "executemany" -> code.SqlExecution
  sink method "executescript" -> code.SqlExecution
  sink method "executescript" -> code.SqlExecution
  sink method "raw" -> code.SqlExecution
  sink method "extra" -> code.SqlExecution
  sink path "sqlalchemy.text" -> code.SqlExecution
  sink path "session.execute" -> code.SqlExecution
  sink path "connection.execute" -> code.SqlExecution
  sink path "db.execute" -> code.SqlExecution
  sink path "cursor.execute" -> code.SqlExecution
  sink path "RawSQL" -> code.SqlExecution
  sink path "django.db.connection.cursor" -> code.SqlExecution
  // asyncpg raw query methods (CWE-89)
  sink method "fetch" -> code.SqlExecution
  sink method "fetchrow" -> code.SqlExecution
  sink method "fetchval" -> code.SqlExecution
  // CSRF (CWE-352, RF-003) — security-sensitive state-changing operations. Scoped to
  // high-impact mutations (not generic .save/.update) to stay low-FP. The guarded reject
  // is a graph spec: linking a CSRF token check to its endpoint in code needs CFG analysis.
  sink method "change_password" -> code.StateChangingOp
  sink method "changePassword" -> code.StateChangingOp
  sink method "update_password" -> code.StateChangingOp
  sink method "reset_password" -> code.StateChangingOp
  sink method "change_email" -> code.StateChangingOp
  sink method "transfer_funds" -> code.StateChangingOp
  sink method "transferFunds" -> code.StateChangingOp
  sink method "delete_account" -> code.StateChangingOp
  sink method "grant_role" -> code.StateChangingOp
  sink method "make_admin" -> code.StateChangingOp
  mark "change_password" -> code.AuthenticationRequiredOp
  mark "changePassword" -> code.AuthenticationRequiredOp
  mark "update_password" -> code.AuthenticationRequiredOp
  mark "reset_password" -> code.AuthenticationRequiredOp
  mark "change_email" -> code.AuthenticationRequiredOp
  mark "transfer_funds" -> code.AuthenticationRequiredOp
  mark "transferFunds" -> code.AuthenticationRequiredOp
  mark "delete_account" -> code.AuthenticationRequiredOp
  mark "grant_role" -> code.AuthenticationRequiredOp
  mark "make_admin" -> code.AuthenticationRequiredOp
  // CSRF protection — explicit token verification (guards RF-003 via a PROTECTS edge)
  control "validate_csrf_token" -> core.CsrfProtection
  control "verify_authenticity_token" -> core.CsrfProtection
  control method "login_required" -> core.AuthenticationCheck
  control method "require_auth" -> core.AuthenticationCheck
  control method "ensure_authenticated" -> core.AuthenticationCheck
  control method "is_authenticated" -> core.AuthenticationCheck
  control method "authenticate" -> core.AuthenticationCheck
  // authorization checks (guards BIZ-001) — high-precision permission predicates. With B1
  // the labelled check suppresses only the sinks it DOMINATES (path-sensitive).
  control "has_perm" -> core.AuthorizationCheck
  control "has_permission" -> core.AuthorizationCheck
  control "permission_required" -> core.AuthorizationCheck
  control "user_passes_test" -> core.AuthorizationCheck
  control method "check_ownership" -> core.OwnershipCheck
  control method "require_owner" -> core.OwnershipCheck
  control method "is_owner" -> core.OwnershipCheck
  // SSRF / open-redirect allowlist validators — guard the fetch/redirect they dominate
  // (validators gate via control flow; B1 connects them to the sink). Django's
  // url_has_allowed_host_and_scheme / is_safe_url is the canonical redirect check.
  control "url_has_allowed_host_and_scheme" -> core.RedirectAllowlist
  control "is_safe_url" -> core.RedirectAllowlist
  control "is_safe_redirect_url" -> core.RedirectAllowlist
  control "is_allowed_url" -> core.AllowlistValidation
  control "is_allowed_host" -> core.AllowlistValidation
  control method "login" -> core.InputValidation
  control method "authenticate" -> core.InputValidation
  control method "authenticate_user" -> core.InputValidation
  control method "sign_in" -> core.InputValidation
  control method "log_in" -> core.InputValidation
  control method "check_credentials" -> core.InputValidation
  control method "verify_credentials" -> core.InputValidation
  control method "validate_credentials" -> core.InputValidation
  control method "check_password" -> core.InputValidation
  control method "verify_password" -> core.InputValidation
  control "analysis.function.result" val "marker:validator" -> core.InputValidation
  control "validate_url" -> core.AllowlistValidation
  // XXE hardening — a parser configured to not resolve external entities / fetch network,
  // dominating the parse it is passed to (value-matched config).
  control "etree.XMLParser" val "resolve_entities=False" -> core.XmlHardening
  control "etree.XMLParser" val "no_network=True" -> core.XmlHardening
  control "lxml.etree.XMLParser" val "resolve_entities=False" -> core.XmlHardening
  control "XMLParser" val "resolve_entities=False" -> core.XmlHardening
  // log injection (CWE-117, INJ-009) + secret-in-log (CWE-532, SEC-001) — logging calls
  // are a LogOutput sink (user data) AND a LogWrite mark (secret).
  sink path "logging.info" -> code.LogOutput
  sink path "logging.warning" -> code.LogOutput
  sink path "logging.error" -> code.LogOutput
  sink path "logging.debug" -> code.LogOutput
  sink path "logger.info" -> code.LogOutput
  sink path "logger.warning" -> code.LogOutput
  sink path "logger.error" -> code.LogOutput
  sink path "logger.debug" -> code.LogOutput
  sink path "log.info" -> code.LogOutput
  sink path "log.error" -> code.LogOutput
  mark "logging.info" -> code.LogWrite
  mark "logging.warning" -> code.LogWrite
  mark "logging.error" -> code.LogWrite
  mark "logging.debug" -> code.LogWrite
  mark "logger.info" -> code.LogWrite
  mark "logger.error" -> code.LogWrite
  mark "log.info" -> code.LogWrite
  sink path "os.system" -> code.CommandExecution
  sink path "os.popen" -> code.CommandExecution
  sink path "os.popen2" -> code.CommandExecution
  sink path "os.popen3" -> code.CommandExecution
  sink path "os.popen4" -> code.CommandExecution
  sink path "subprocess.call" collection first -> code.CommandExecution
  sink path "subprocess.run" collection first -> code.CommandExecution
  sink path "subprocess.Popen" collection first -> code.CommandExecution
  sink path "subprocess.call" collection 2 val "-c" -> code.CommandExecution
  sink path "subprocess.run" collection 2 val "-c" -> code.CommandExecution
  sink path "subprocess.Popen" collection 2 val "-c" -> code.CommandExecution
  sink path "subprocess.Popen" val "self.args" val "tag.filename" nval "--" -> code.CommandOptionInjection
  sink path "subprocess.Popen" val "self.args" val "filename" nval "--" -> code.CommandOptionInjection
  sink path "subprocess.check_output" collection first -> code.CommandExecution
  sink path "subprocess.check_call" collection first -> code.CommandExecution
  sink path "subprocess.check_output" collection 2 val "-c" -> code.CommandExecution
  sink path "subprocess.check_call" collection 2 val "-c" -> code.CommandExecution
  sink path "subprocess.getoutput" -> code.CommandExecution
  sink path "subprocess.getstatusoutput" -> code.CommandExecution
  sink path "commands.getoutput" -> code.CommandExecution
  sink path "commands.getstatusoutput" -> code.CommandExecution
  sink path "module.run_command" val "apt-key" val "--recv" -> code.SecurityKeyTrustOperation
  sink path "pty.spawn" -> code.CommandExecution
  sink path "os.execv" -> code.CommandExecution
  sink path "os.execve" -> code.CommandExecution
  sink path "os.execvp" -> code.CommandExecution
  sink path "os.execvpe" -> code.CommandExecution
  sink path "os.spawnv" -> code.CommandExecution
  sink path "os.spawnl" -> code.CommandExecution
  sink path "asyncio.create_subprocess_shell" -> code.CommandExecution
  sink path "asyncio.create_subprocess_exec" arg all collection -> code.CommandExecution
  sink path "popen2.popen2" -> code.CommandExecution
  sink path "popen2.popen3" -> code.CommandExecution
  sink path "eval" -> code.CodeEval
  sink path "exec" -> code.CodeEval
  sink path "execfile" -> code.CodeEval
  sink path "compile" -> code.CodeEval
  sink path "code.interact" -> code.CodeEval
  sink path "code.InteractiveInterpreter" -> code.CodeEval
  // unsafe YAML deserialization (CWE-502) — yaml.load with the full/unsafe Loader can
  // construct arbitrary objects. safe_load / SafeLoader is the SafeDeserialization control.
  sink path "yaml.load" -> code.Deserialization
  sink path "yaml.full_load" -> code.Deserialization
  sink path "yaml.unsafe_load" -> code.Deserialization
  sink path "yaml.load_all" -> code.Deserialization
  sink path "pickle.load" -> code.Deserialization
  sink path "pickle.loads" -> code.Deserialization
  sink path "cPickle.load" -> code.Deserialization
  sink path "cPickle.loads" -> code.Deserialization
  sink path "_pickle.load" -> code.Deserialization
  sink path "_pickle.loads" -> code.Deserialization
  sink path "marshal.load" -> code.Deserialization
  sink path "marshal.loads" -> code.Deserialization
  sink path "dill.load" -> code.Deserialization
  sink path "dill.loads" -> code.Deserialization
  sink path "jsonpickle.decode" -> code.Deserialization
  sink path "shelve.open" -> code.Deserialization
  sink path "joblib.load" -> code.Deserialization
  sink path "numpy.load" -> code.Deserialization
  sink path "pandas.read_pickle" -> code.Deserialization
  sink path "etree.parse" -> code.XmlParse
  sink path "etree.fromstring" -> code.XmlParse
  sink path "etree.XML" -> code.XmlParse
  sink path "lxml.etree.parse" -> code.XmlParse
  sink path "lxml.etree.fromstring" -> code.XmlParse
  sink path "xml.dom.minidom.parse" -> code.XmlParse
  sink path "xml.dom.minidom.parseString" -> code.XmlParse
  sink path "xml.sax.parse" -> code.XmlParse
  sink path "xml.sax.parseString" -> code.XmlParse
  sink path "ElementTree.parse" -> code.XmlParse
  sink path "ElementTree.fromstring" -> code.XmlParse
  sink path "xmlrpc.client.loads" -> code.XmlParse
  sink path "xmltodict.parse" -> code.XmlParse
  sink path "requests.get" -> code.UrlFetch
  sink path "requests.post" -> code.UrlFetch
  sink path "requests.put" -> code.UrlFetch
  sink path "requests.delete" -> code.UrlFetch
  sink path "requests.head" -> code.UrlFetch
  sink path "requests.patch" -> code.UrlFetch
  sink path "requests.options" -> code.UrlFetch
  sink path "requests.request" -> code.UrlFetch
  sink path "session.get" -> code.UrlFetch
  sink path "session.post" -> code.UrlFetch
  sink path "session.request" -> code.UrlFetch
  sink path "urllib.request.urlopen" -> code.UrlFetch
  sink path "urllib.request.Request" -> code.UrlFetch
  sink path "urllib.urlopen" -> code.UrlFetch
  sink path "urllib2.urlopen" -> code.UrlFetch
  sink path "urllib2.Request" -> code.UrlFetch
  sink path "urllib3.request" -> code.UrlFetch
  sink path "urllib3.ProxyManager" -> code.UrlFetch
  sink path "urllib3.PoolManager" -> code.UrlFetch
  sink path "httpx.get" -> code.UrlFetch
  sink path "httpx.post" -> code.UrlFetch
  sink path "httpx.request" -> code.UrlFetch
  sink path "httpx.Client" -> code.UrlFetch
  sink path "httpx.stream" -> code.UrlFetch
  sink path "aiohttp.request" -> code.UrlFetch
  sink path "aiohttp.ClientSession" -> code.UrlFetch
  sink path "session.request" -> code.UrlFetch
  sink path "pycurl.Curl" -> code.UrlFetch
  sink path "treq.get" -> code.UrlFetch
  sink path "treq.post" -> code.UrlFetch
  // trust boundary (CWE-501): user input stored into the server-trusted Flask session
  // (`flask.session[key] = value`, lowered to __setitem__). A tainted KEY or VALUE is the
  // violation (arg all) — UNLESS it passed through a validator/authenticator first (the
  // InputValidation controls below), which is the legitimate `session['user'] = login(...)`
  // pattern. The TrustBoundary rule's `unless sanitized_by core.InputValidation` clears it.
  sink path "session.__setitem__" arg all -> code.TrustBoundary
  // HTTP response splitting / header injection (CWE-113).
  sink path "headers.add" arg 1 -> code.ResponseHeaderWrite
  sink path "headers.setdefault" arg 1 -> code.ResponseHeaderWrite
  sink path "set_header" arg 1 -> code.ResponseHeaderWrite
  sink path "response.set_header" arg 1 -> code.ResponseHeaderWrite
  // mass assignment (CWE-915) — framework/model bulk bind from request data.
  sink path "User.update" -> code.MassAssign
  sink path "User.objects.create" arg all -> code.MassAssign
  sink path "Model.objects.create" arg all -> code.MassAssign
  sink path "serializer.save" arg all -> code.MassAssign
  sink path "analysis.function.context.sink" val "class_bases=serializers.ModelSerializer" val "fields" val "is_superuser" val "validated_data" val "objects.create" nval "pop('is_superuser'" nval "pop(\"is_superuser\"" -> code.MassAssign
  sink path "analysis.function.context.sink" val "class_bases=serializers.ModelSerializer" val "fields" val "is_superuser" val "validated_data" val "super().update" nval "pop('is_superuser'" nval "pop(\"is_superuser\"" -> code.MassAssign

  sink path "open" -> code.FilePathAccess
  sink path "io.open" -> code.FilePathAccess
  sink path "os.open" -> code.FilePathAccess
  sink path "codecs.open" -> code.FilePathAccess
  sink path "__import__" -> code.DynamicCodeLoad
  sink path "importlib.import_module" -> code.DynamicCodeLoad
  sink path "imp.load_source" -> code.DynamicCodeLoad
  sink path "SourceFileLoader" -> code.DynamicCodeLoad
  sink path "os.remove" -> code.FilePathAccess
  sink path "os.unlink" -> code.FilePathAccess
  sink path "os.rename" -> code.FilePathAccess
  sink path "os.replace" -> code.FilePathAccess
  sink path "os.makedirs" -> code.FilePathAccess
  sink path "os.mkdir" -> code.FilePathAccess
  sink path "os.rmdir" -> code.FilePathAccess
  sink path "shutil.copy" -> code.FilePathAccess
  sink path "shutil.copyfile" -> code.FilePathAccess
  sink path "shutil.move" -> code.FilePathAccess
  sink path "shutil.rmtree" -> code.FilePathAccess
  sink path "send_file" -> code.FilePathAccess
  sink path "send_from_directory" -> code.FilePathAccess
  sink path "flask.send_file" -> code.FilePathAccess
  sink path "zipfile.ZipFile.extractall" -> code.FilePathAccess
  sink path "tarfile.open" -> code.FilePathAccess
  sink method "extract" -> code.ArchiveEntryWrite
  sink method "extractall" -> code.ArchiveEntryWrite
  // os.path predicates/normalizers fed a tainted path (CWE-22): the path is arg 0.
  sink path "os.path.exists" -> code.FilePathAccess
  sink path "os.path.isfile" -> code.FilePathAccess
  sink path "os.path.isdir" -> code.FilePathAccess
  sink path "os.path.islink" -> code.FilePathAccess
  sink path "os.path.getsize" -> code.FilePathAccess
  sink path "os.stat" -> code.FilePathAccess
  sink path "os.lstat" -> code.FilePathAccess
  sink path "os.scandir" -> code.FilePathAccess
  sink path "os.listdir" -> code.FilePathAccess
  sink path "fileinput.FileInput" -> code.FilePathAccess
  // unrestricted upload (CWE-434) — uploaded-file save/copy destination or filename.
  sink path "uploaded_file.save" -> code.UnsafeUpload
  sink path "file.save" -> code.UnsafeUpload
  sink path "werkzeug.datastructures.FileStorage.save" -> code.UnsafeUpload
  // pathlib operations on a tainted Path object — the path is the RECEIVER, so the call
  // node carries the taint (e.g. `(Path(DIR)/userinput).exists()` / `.read_text()`).
  sink receiver "exists" -> code.FilePathAccess
  sink receiver "is_file" -> code.FilePathAccess
  sink receiver "is_dir" -> code.FilePathAccess
  sink receiver "read_text" -> code.FilePathAccess
  sink receiver "read_bytes" -> code.FilePathAccess
  sink receiver "write_text" -> code.FilePathAccess
  sink receiver "write_bytes" -> code.FilePathAccess
  sink receiver "iterdir" -> code.FilePathAccess
  sink receiver "unlink" -> code.FilePathAccess
  sink path "render_template_string" -> code.HtmlRender
  sink path "flask.render_template_string" -> code.HtmlRender
  sink path "analysis.function.context.sink" val "traceback.format_exc" val "<pre" nval "cgi.escape" nval "html.escape" nval "markupsafe.escape" -> code.HtmlRender
  sink path "analysis.function.context.sink" val "traceback.format_exc" val "<html" nval "cgi.escape" nval "html.escape" nval "markupsafe.escape" -> code.HtmlRender
  sink path "analysis.function.return" val "decorator_method:get" nval "abort" nval "jsonify" nval "redirect" nval "render_template" nval "render_template_string" nval "send_file" nval "send_from_directory" nval "url_for" nval "FileResponse" nval "Response" nval "HttpResponse" nval "make_response" -> code.HtmlRender
  sink path "analysis.function.return" val "decorator_method:post" nval "abort" nval "jsonify" nval "redirect" nval "render_template" nval "render_template_string" nval "send_file" nval "send_from_directory" nval "url_for" nval "FileResponse" nval "Response" nval "HttpResponse" nval "make_response" -> code.HtmlRender
  sink path "analysis.function.return" val "decorator_method:put" nval "abort" nval "jsonify" nval "redirect" nval "render_template" nval "render_template_string" nval "send_file" nval "send_from_directory" nval "url_for" nval "FileResponse" nval "Response" nval "HttpResponse" nval "make_response" -> code.HtmlRender
  sink path "analysis.function.return" val "decorator_method:delete" nval "abort" nval "jsonify" nval "redirect" nval "render_template" nval "render_template_string" nval "send_file" nval "send_from_directory" nval "url_for" nval "FileResponse" nval "Response" nval "HttpResponse" nval "make_response" -> code.HtmlRender
  sink path "analysis.function.return" val "decorator_method:patch" nval "abort" nval "jsonify" nval "redirect" nval "render_template" nval "render_template_string" nval "send_file" nval "send_from_directory" nval "url_for" nval "FileResponse" nval "Response" nval "HttpResponse" nval "make_response" -> code.HtmlRender
  sink path "analysis.function.return" val "decorator_method:head" nval "abort" nval "jsonify" nval "redirect" nval "render_template" nval "render_template_string" nval "send_file" nval "send_from_directory" nval "url_for" nval "FileResponse" nval "Response" nval "HttpResponse" nval "make_response" -> code.HtmlRender
  sink path "analysis.function.return" val "decorator_method:options" nval "abort" nval "jsonify" nval "redirect" nval "render_template" nval "render_template_string" nval "send_file" nval "send_from_directory" nval "url_for" nval "FileResponse" nval "Response" nval "HttpResponse" nval "make_response" -> code.HtmlRender
  sink path "analysis.function.return" val "decorator_method:route" nval "abort" nval "jsonify" nval "redirect" nval "render_template" nval "render_template_string" nval "send_file" nval "send_from_directory" nval "url_for" nval "FileResponse" nval "Response" nval "HttpResponse" nval "make_response" -> code.HtmlRender
  sink path "analysis.function.return" val "decorator_method:websocket" nval "abort" nval "jsonify" nval "redirect" nval "render_template" nval "render_template_string" nval "send_file" nval "send_from_directory" nval "url_for" nval "FileResponse" nval "Response" nval "HttpResponse" nval "make_response" -> code.HtmlRender
  sink path "analysis.function.return" val "decorator_method:api_route" nval "abort" nval "jsonify" nval "redirect" nval "render_template" nval "render_template_string" nval "send_file" nval "send_from_directory" nval "url_for" nval "FileResponse" nval "Response" nval "HttpResponse" nval "make_response" -> code.HtmlRender
  // the response BODY reflected to the browser (Flask make_response / Response / HttpResponse).
  // and the synthetic http_response wrapping a route handler's return value).
  sink path "make_response" -> code.HtmlRender
  sink path "Response" nval "text/plain" nval "application/json" -> code.HtmlRender
  sink path "HttpResponse" -> code.HtmlRender
  sink path "Markup" -> code.HtmlRender
  sink path "markupsafe.Markup" -> code.HtmlRender
  sink path "mark_safe" -> code.HtmlRender
  sink path "django.utils.safestring.mark_safe" -> code.HtmlRender
  sink path "format_html" -> code.HtmlRender
  sink path "jinja2.Template" -> code.HtmlRender
  sink path "Template.render" -> code.HtmlRender
  sink path "mako.template.Template" -> code.HtmlRender
  sink path "Environment.from_string" -> code.HtmlRender
  sink path "Template" -> code.TemplateRender
  sink path "jinja2.Template" -> code.TemplateRender
  sink path "jinja2.Environment.from_string" -> code.TemplateRender
  sink path "mako.template.Template" -> code.TemplateRender
  sink path "Environment.from_string" -> code.TemplateRender
  sink path "render_template_string" -> code.TemplateRender
  mark exact "analysis.function.context" val "Formatter().parse" val "." nval "format_spec" -> code.IncompleteTemplateValidation
  mark exact "analysis.function.context" val "Formatter().parse" val "[" nval "format_spec" -> code.IncompleteTemplateValidation
  mark exact "analysis.function.context" val "Formatter().parse" val "." val "format_spec" nval "{" nval "}" -> code.IncompleteTemplateValidation
  mark exact "analysis.function.context" val "Formatter().parse" val "[" val "format_spec" nval "{" nval "}" -> code.IncompleteTemplateValidation
  mark exact "analysis.function.context" val "name=parse" val "query_expr.parseString" val "repr(" val ".replace(" val "__default_field__" val "ILIKE" -> code.UnparameterizedSqlQueryParser
  mark exact "analysis.function.context" val "name=parse" val "query_expr.parseString" val "repr(" val ".replace(" val "__default_field__" val "::jsonb" -> code.UnparameterizedSqlQueryParser
  mark exact "analysis.function.context" val "name=parse" val "query_expr.parseString" val "repr(" val ".replace(" val "__default_field__" val "=ANY(" -> code.UnparameterizedSqlQueryParser
  mark exact "analysis.function.context" val "_original_transport" val "_reader._transport" val "_writer._transport" nval "_reader._buffer.clear" -> code.ProtocolStateReview
  mark exact "analysis.function.context" val "name=_recv_packet" val "MSG_USERAUTH_LAST" val "process_packet(pkttype,seq,packet" nval "Invalid request received before" -> code.ProtocolStateReview
  sink path "redirect" -> code.RedirectTarget
  sink path "flask.redirect" -> code.RedirectTarget
  sink path "HttpResponseRedirect" -> code.RedirectTarget
  sink path "django.shortcuts.redirect" -> code.RedirectTarget
  sink path "starlette.responses.RedirectResponse" -> code.RedirectTarget
  sink path "RedirectResponse" -> code.RedirectTarget
  sink path "ldap.search" -> code.LdapQuery
  sink path "ldap.search_s" -> code.LdapQuery
  sink path "ldap.search_ext" -> code.LdapQuery
  // ldap3 Connection.search(search_base, search_filter, …) — the FILTER is arg index 1.
  sink path "ldap3.Connection.search" arg 1 -> code.LdapQuery
  sink path "connection.search" arg 1 -> code.LdapQuery
  sink path "conn.search" arg 1 -> code.LdapQuery
  sink path "collection.find" -> code.NosqlQuery
  sink path "collection.find_one" -> code.NosqlQuery
  sink path "db.eval" -> code.NosqlQuery
  sink path "collection.where" -> code.NosqlQuery
  sink path "find" -> code.NosqlQuery
  sink path "aggregate" -> code.NosqlQuery
  sink method "get_user" -> code.ObjectLookupByUserInput
  sink method "get_account" -> code.ObjectLookupByUserInput
  sink method "get_order" -> code.ObjectLookupByUserInput
  sink method "find_by_id" -> code.ObjectLookupByUserInput
  sink method "get_by_id" -> code.ObjectLookupByUserInput

  // XPath injection (CWE-643) — lxml: tree.xpath(expr) / etree.XPath(expr) compile a
  // tainted query string. `.xpath` is a distinctive lxml method; taint-gated.
  sink method "xpath" -> code.XpathQuery
  sink path "etree.XPath" -> code.XpathQuery
  sink path "XPath" -> code.XpathQuery
  // elementpath.select(root, expr): the XPath expression is arg 1.
  sink path "elementpath.select" arg 1 -> code.XpathQuery
  sink path "elementpath.iter_select" arg 1 -> code.XpathQuery
  // NOTE: ElementTree .findall/.iterfind/.findtext are intentionally NOT marked — the names
  // collide with re.findall / str / BeautifulSoup, mislabeling regex as XPath, and no
  // benchmark true-positive depends on them (elementpath.select + .xpath cover the real cases).

  // controls (sanitizers/validators) — neutralize a flow that passes through them
  control "shlex.quote" -> core.ShellEscape
  // os.path.basename strips all directory components (the Python basename canonicalizer).
  control "os.path.basename" -> core.PathCanonicalization
  control "xpath_literal" -> core.XpathEscape
  control "pipes.quote" -> core.ShellEscape
  control "html.escape" -> core.HtmlEscape
  control "cgi.escape" -> core.HtmlEscape
  control "escape_for_html" -> core.HtmlEscape
  control "markupsafe.escape" -> core.HtmlEscape
  control "bleach.clean" -> core.HtmlEscape
  control "django.utils.html.escape" -> core.HtmlEscape
  control "yaml.safe_load" -> core.SafeDeserialization
  control "ldap.filter.escape_filter_chars" -> core.LdapEscape
  control "ldap3.utils.conv.escape_filter_chars" -> core.LdapEscape
  // Boundary check for realpath/common workspace guards: `resolved.startswith(base + os.sep)`
  // requires a path separator after the base, unlike plain prefix checks.
  control method "startswith" val "os.sep" -> core.PathAccessCheck
  control "analysis.path.access_check" val "path.resolve.parents" -> core.PathAccessCheck
  // pathlib containment guard: `candidate.resolve().relative_to(root)` raises
  // ValueError when the candidate escapes root, and is the patched idiom for
  // Windows-safe prompt file containment in CVE-2026-10044.
  control receiver method "relative_to" -> core.PathCanonicalization
  control method "relative_to" -> core.PathAccessCheck

  // UNSOUND neutralizers (`assume`) — never suppress; emit an assumption note. The dominant
  // Python OWASP idiom is the `if '<bad>' in tainted:` substring blocklist, recognized
  // structurally in the lowering (an operator, not a call). These cover the method/path forms:
  // prefix/suffix checks and path canonicalizers that do NOT confine to a base directory.
  assume guard method "startswith" -> code.FilePathAccess
  assume guard method "endswith"   -> code.FilePathAccess
  assume guard path "analysis.guard.containment_check" -> code.FilePathAccess
  assume sanitizer path "os.path.normpath" -> code.FilePathAccess
  assume sanitizer path "os.path.realpath" -> code.FilePathAccess
  assume sanitizer path "posixpath.normpath" -> code.FilePathAccess

  // regex compile (ReDoS, CWE-1333) — tainted PATTERN arg0
  sink path "re.compile" -> code.RegexCompile
  sink path "re.match" -> code.RegexCompile
  sink path "re.search" -> code.RegexCompile
  sink path "re.sub" -> code.RegexCompile
  sink path "re.findall" -> code.RegexCompile
  // Static catastrophic regex: a repeated segment that can consume an optional slash
  // creates ambiguous partitions for long event strings.
  sink path "re.match" val "+/?)+" -> code.CatastrophicRegex

  // weak crypto (CWE-327/328) — presence marker on the call node
  mark "hashlib.md5" -> code.WeakHash
  mark "hashlib.sha1" -> code.WeakHash
  mark "hashlib.md4" -> code.WeakHash
  mark "hashlib.md2" -> code.WeakHash
  // hashlib.new("md5") — algorithm by name (value-matched). "sha1"/"md5"/… only, never the
  // bare "sha" substring (it would match the strong sha224/256/384/512 family).
  mark "hashlib.new" val "md5" -> code.WeakHash
  mark "hashlib.new" val "md4" -> code.WeakHash
  mark "hashlib.new" val "md2" -> code.WeakHash
  mark "hashlib.new" val "sha1" -> code.WeakHash

  // insecure file permission (CWE-732) — world-writable / overly-broad mode. Restrictive
  // modes (0o600/0o640/0o644) are not matched. octal forms 0o777 and 0o666 are covered.
  mark "os.chmod" val "0o777" -> code.InsecurePermission
  mark "os.chmod" val "0o666" -> code.InsecurePermission
  mark "os.fchmod" val "0o777" -> code.InsecurePermission
  mark "os.fchmod" val "0o666" -> code.InsecurePermission
  mark "os.open" val "0o777" -> code.InsecurePermission
  mark "os.open" val "0o666" -> code.InsecurePermission
  mark "Path.chmod" val "0o777" -> code.InsecurePermission
  mark method "mkdir" val "parents=True" val "exist_ok=True" nval "mode=" -> code.InsecurePermission

  // resource lifecycle (CWE-772, RES-001) — a raw socket handle that must be closed on
  // every path. close() is receiver-agnostic (control method). Context-manager (`with`)
  // forms don't lower the alloc, so they aren't flagged.
  mark "socket.socket" -> code.ResourceHandle
  control method "close" -> core.ResourceRelease

  // weak randomness (CWE-330) — presence of the non-crypto `random` module PRNG. Secure
  // RNG (secrets.*, os.urandom, SystemRandom) is deliberately NOT marked.
  mark "random.random" -> code.WeakRandomValue
  mark "random.randint" -> code.WeakRandomValue
  mark "random.randrange" -> code.WeakRandomValue
  mark "random.getrandbits" -> code.WeakRandomValue
  mark "random.randbytes" -> code.WeakRandomValue
  mark "random.choice" -> code.WeakRandomValue
  mark "random.choices" -> code.WeakRandomValue
  mark "random.sample" -> code.WeakRandomValue
  mark "random.uniform" -> code.WeakRandomValue
  mark "random.normalvariate" -> code.WeakRandomValue
  mark "random.gauss" -> code.WeakRandomValue
  mark "random.betavariate" -> code.WeakRandomValue
  mark "random.gammavariate" -> code.WeakRandomValue
  mark "random.expovariate" -> code.WeakRandomValue
  mark "random.lognormvariate" -> code.WeakRandomValue
  mark "random.paretovariate" -> code.WeakRandomValue
  mark "random.weibullvariate" -> code.WeakRandomValue
  mark "random.vonmisesvariate" -> code.WeakRandomValue
  mark "random.triangular" -> code.WeakRandomValue
  mark "random.shuffle" -> code.WeakRandomValue

  // csrf disabled (CWE-352) — presence marker
  mark "csrf_exempt" -> code.CsrfDisabled

  // CSV injection (CWE-1236)
  sink method "writerow" collection -> code.CsvCell
  sink method "writerows" collection -> code.CsvCell

  // weak cipher (CWE-327) — named broken ciphers
  mark "DES.new" -> code.WeakCipher
  mark "ARC4.new" -> code.WeakCipher
  mark "Blowfish.new" -> code.WeakCipher
  mark "DES3.new" -> code.WeakCipher
  // ECB mode (CWE-327) — pycryptodome AES.MODE_ECB constant or cryptography modes.ECB().
  // The mode is a member access / call (not a string), so match the path on the Attr/Call.
  mark "AES.MODE_ECB" -> code.WeakCipher
  mark "DES.MODE_ECB" -> code.WeakCipher
  mark "DES3.MODE_ECB" -> code.WeakCipher
  mark "modes.ECB" -> code.WeakCipher
  mark "AES.new" val "0000000000000000" -> code.StaticIv
  mark "DES3.new" val "00000000" -> code.StaticIv
  mark "Cipher" val "0000000000000000" -> code.StaticIv
  mark "IvParameterSpec" val "0000000000000000" -> code.StaticIv

  // insecure temp file (CWE-377) — tempfile.mktemp is documented-insecure (race)
  mark "tempfile.mktemp" -> code.InsecureTempFile
  mark "open" val "/tmp/" val "w" -> code.InsecureTempFile
  mark "open" val ".lxc-attach-script" val "w" -> code.InsecureTempFile
  mark "open" val "lxc-attach-script.log" val "a" -> code.InsecureTempFile
  mark "open" val "lxc-attach-script.err" val "a" -> code.InsecureTempFile

  // TLS cert validation disabled (CWE-295) — requests/httpx verify=False
  mark "requests" val "verify=False" -> code.CertValidationDisabled
  mark "httpx" val "verify=False" -> code.CertValidationDisabled
  mark exact "analysis.function.context" val "use_ssl=False" val "Tls(" val "validate=ssl.CERT_REQUIRED" val "Server(" -> code.CertValidationDisabled

  // JWT signature not verified (CWE-347) — pyjwt alg none / verify off
  mark "jwt.decode" val "algorithms=none" -> code.JwtUnverified
  mark "jwt.decode" val "verify_signature=False" -> code.JwtUnverified
  mark "jwt.decode" val "verify=False" -> code.JwtUnverified
  mark "jwt.encode" val "algorithm=none" -> code.JwtUnverified

  // cleartext channel (CWE-319) — http:// URL to an HTTP client, excluding loopback
  // dev traffic (127.0.x); still FP-prone for other internal hosts → low sev.
  mark "requests" val "http://" nval "127.0" -> code.CleartextChannel
  mark "httpx" val "http://" nval "127.0" -> code.CleartextChannel
  mark "urllib.request.urlopen" val "http://" nval "127.0" -> code.CleartextChannel

  // insecure cookie (CWE-614) — a security flag EXPLICITLY disabled. Pure omission is
  // not flagged (too many false positives from framework defaults / cookie deletions).
  mark "set_cookie" val "httponly=False" -> code.InsecureCookie
  mark "set_cookie" val "secure=False" -> code.InsecureCookie

  // permissive CORS (CWE-942) — headers.add("Access-Control-Allow-Origin", "*")
  // or flask-cors CORS(app, origins="*") / cross_origin(origins="*").
  mark "headers.add" val "Access-Control-Allow-Origin" val "*" -> code.PermissiveCors
  mark "CORS" val "origins=*" -> code.PermissiveCors
  mark "cross_origin" val "origins=*" -> code.PermissiveCors

  // clickjacking (CWE-1021) — X-Frame-Options EXPLICITLY set to ALLOWALL via a header
  // call (omission / subscript-assignment not flagged).
  mark "headers.add" val "X-Frame-Options" val "ALLOWALL" -> code.MissingFrameProtection
  mark "headers.setdefault" val "X-Frame-Options" val "ALLOWALL" -> code.MissingFrameProtection

  // character-filter: re.sub(pattern, repl, s) is always global.
  filter path "re.sub" global
  filter path "re.subn" global
}
