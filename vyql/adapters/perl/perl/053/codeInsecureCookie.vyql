module bindings.perl.migration.mfca40a44;

binding insecureCookie53 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "httponly" and node.token contains "false"
  emit issue code.InsecureCookie at node
}
