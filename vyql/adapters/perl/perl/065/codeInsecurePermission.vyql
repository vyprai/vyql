module bindings.perl.migration.mfca40a44;

binding insecurePermission65 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "chmod" and node.token contains "0777"
  emit issue code.InsecurePermission at node
}
