module bindings.perl.migration.mfca40a44;

binding resourceHandle70 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "IO.Socket.INET.new"
  emit issue code.ResourceHandle at node
  emit sink code.ResourceHandleSink at node
}
