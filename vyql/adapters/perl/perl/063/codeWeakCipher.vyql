module bindings.perl.migration.mfca40a44;

binding weakCipher63 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "Crypt.DES"
  emit issue code.WeakCipher at node
}
