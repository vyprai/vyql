// Cross-language audit-review labeling for scan flags.
//
// Marks privileged/state-changing operations (code.SensitiveOperation) and resource
// acquisitions (code.ResourceReview). No CONFIRMED rule consumes these concepts, so they
// are inert in normal scans (zero effect on default output / benchmarks). The possibility
// tier surfaces each for the AI/triage pass:
//   - SensitiveOperation → "verify this operation enforces access control" (authz CVEs)
//   - ResourceReview     → "verify this resource is bounded and released" (resource/DoS)
// Kept high-signal (destructive/privileged ops, acquisition calls) rather than every CRUD
// call, to keep the AI pass's review set tractable. cross_language: these recur by name.
adapter auditreview {
  meta { fidelity: syntactic, cross_language: true, auto_apply: graph }

  // --- privileged / destructive operations (authz review) ---
  // NOTE: bare delete/remove/destroy/drop omitted — too generic (match every collection
  // method AND the JS `delete` operator). Keep specific destructive + privileged verbs.
  flag code.SensitiveOperation on any {
    method "deleteById"
  }
  flag code.SensitiveOperation on any {
    method "deleteAll"
  }
  flag code.SensitiveOperation on any {
    method "dropTable"
  }
  flag code.SensitiveOperation on any {
    method "truncateTable"
  }
  flag code.SensitiveOperation on any {
    method "deleteUser"
  }
  flag code.SensitiveOperation on any {
    method "grant"
  }
  flag code.SensitiveOperation on any {
    method "revoke"
  }
  flag code.SensitiveOperation on any {
    method "setRole"
  }
  flag code.SensitiveOperation on any {
    method "addRole"
  }
  flag code.SensitiveOperation on any {
    method "setPermission"
  }
  flag code.SensitiveOperation on any {
    method "setPermissions"
  }
  flag code.SensitiveOperation on any {
    method "makeAdmin"
  }
  flag code.SensitiveOperation on any {
    method "setAdmin"
  }
  flag code.SensitiveOperation on any {
    method "update"
    has "password"
  }
  flag code.SensitiveOperation on any {
    method "update!"
    has "password"
  }
  flag code.SensitiveOperation on any {
    method "elevate"
  }
  flag code.SensitiveOperation on any {
    method "impersonate"
  }
  flag code.SensitiveOperation on any {
    method "assumeRole"
  }
  flag code.SensitiveOperation on any {
    method "promote"
  }
  flag code.SensitiveOperation on any {
    method "run_post_create"
  }
  flag code.SensitiveOperation on any {
    method "obtainLDAPServer"
  }
  flag code.SensitiveOperation on any {
    method "loadUserByUsername"
  }

  // --- resource acquisition / unbounded reads (resource-DoS review) ---
  flag code.ResourceReview on any {
    method "ReadAll"
  }
  flag code.ResourceReview on any {
    method "readAll"
  }
  flag code.ResourceReview on any {
    method "read_to_end"
  }
  flag code.ResourceReview on any {
    method "read_to_string"
  }
  flag code.ResourceReview on any {
    method "Accept"
  }
  flag code.ResourceReview on any {
    path "net.Dial"
  }
  flag code.ResourceReview on any {
    path "net.Listen"
  }
  flag code.ResourceReview on any {
    path "exec.Command"
  }
  flag code.ResourceReview on any {
    method "spawn"
  }
  flag code.ResourceReview on any {
    method "fork"
  }
  flag code.ResourceReview on any {
    path "fopen"
  }
  flag code.ResourceReview on any {
    path "opendir"
  }
  flag code.ResourceReview on any {
    path "socket"
  }

  // --- structured input decoders (format-validation review) ---
  flag code.StructuredInputDecode on any {
    method "parseOctetString"
  }
  flag code.StructuredInputDecode on any {
    method "parseBitString"
  }
}
