module bindings.lua.migration.ma99d12f7;

binding weakCipher69 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "crypto.cipher" and node.token contains "RC4"
  emit issue code.WeakCipher at node
}
