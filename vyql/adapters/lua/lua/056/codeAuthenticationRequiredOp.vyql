module bindings.lua.migration.ma99d12f7;

binding authenticationRequiredOp56 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "change_password"
  emit issue code.AuthenticationRequiredOp at node
}
