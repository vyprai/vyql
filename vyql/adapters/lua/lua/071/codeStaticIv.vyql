module bindings.lua.migration.ma99d12f7;

binding staticIv71 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "crypto.cipher" and node.token contains "0000000000000000"
  emit issue code.StaticIv at node
}
