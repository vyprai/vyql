// kotlin framework adapter (docs/07) — framework→concept content.
// frameworks: spring-boot, ktor, android, jdbc
adapter kotlin {
  meta { match: contains, fidelity: resolved }

  // Spring handler params (seeded http_input) + servlet inputs
  source "http_input" -> code.HttpInput
  source ".getParameter" -> code.HttpInput
  source ".getHeader" -> code.HttpInput
  source ".queryParameters" -> code.HttpInput
  // Android intent / deep-link inputs
  source ".getStringExtra" -> code.IntentInput
  source ".getCharSequenceExtra" -> code.IntentInput
  source ".getBundleExtra" -> code.IntentInput
  source ".getDataString" -> code.IntentInput
  source ".getQueryParameter" -> code.IntentInput
  source ".getLastPathSegment" -> code.IntentInput

  // command execution
  sink method "exec" -> code.CommandExecution
  sink path "ProcessBuilder" -> code.CommandExecution

  // Android WebView (CWE-749)
  sink method "loadUrl" -> code.WebViewLoad
  sink method "loadData" -> code.WebViewLoad
  sink method "loadDataWithBaseURL" arg 1 -> code.WebViewLoad
  sink method "evaluateJavascript" -> code.WebViewLoad
  mark "addJavascriptInterface" -> code.WebViewJsInterface

  // SQL — JDBC + Android SQLite
  sink method "executeQuery" -> code.SqlExecution
  sink method "executeUpdate" -> code.SqlExecution
  sink method "execute" -> code.SqlExecution
  sink method "execSQL" -> code.SqlExecution
  sink method "rawQuery" -> code.SqlExecution
  sink method "prepareStatement" -> code.SqlExecution
  sink method "createQuery" -> code.SqlExecution
  sink method "findById" -> code.ObjectLookupByUserInput
  sink method "getReferenceById" -> code.ObjectLookupByUserInput
  sink method "getUser" -> code.ObjectLookupByUserInput
  sink method "getAccount" -> code.ObjectLookupByUserInput
  mark "changePassword" -> code.AuthenticationRequiredOp
  mark "updatePassword" -> code.AuthenticationRequiredOp
  mark "resetPassword" -> code.AuthenticationRequiredOp
  mark "changeEmail" -> code.AuthenticationRequiredOp
  mark "transferFunds" -> code.AuthenticationRequiredOp
  mark "deleteAccount" -> code.AuthenticationRequiredOp
  mark "grantRole" -> code.AuthenticationRequiredOp
  mark "makeAdmin" -> code.AuthenticationRequiredOp

  // path / file
  sink path "File" -> code.FilePathAccess
  sink path "FileInputStream" -> code.FilePathAccess
  sink method "readText" -> code.FilePathAccess
  sink method "readBytes" -> code.FilePathAccess
  sink method "extractEntry" -> code.ArchiveEntryWrite

  // code eval / dynamic
  sink method "loadClass" -> code.CodeEval

  // SSRF — java.net URL.openConnection + OkHttp newCall: the tainted URL is the
  // RECEIVER of these no-arg methods (`URL(u).openConnection()`). `readText` is NOT
  // used — it is also File.readText, a path-access sink.
  sink receiver "openConnection" -> code.UrlFetch
  sink receiver "newCall" -> code.UrlFetch

  // regex compile (ReDoS) — tainted PATTERN (arg) or receiver (`u.toRegex()`)
  sink path "Pattern.compile" -> code.RegexCompile
  sink path "Regex" -> code.RegexCompile
  sink receiver "toRegex" -> code.RegexCompile

  // deserialization (CWE-502) — Java ObjectInputStream + Jackson
  sink method "readObject" -> code.Deserialization
  sink method "readValue" -> code.Deserialization

  // weak crypto (CWE-327) — JCA (same API as Java), val-matched on algorithm
  mark "MessageDigest.getInstance" val "MD2" -> code.WeakHash
  mark "MessageDigest.getInstance" val "MD5" -> code.WeakHash
  mark "MessageDigest.getInstance" val "SHA-1" -> code.WeakHash
  mark "MessageDigest.getInstance" val "SHA1" -> code.WeakHash
  mark "Cipher.getInstance" val "DES" -> code.WeakCipher
  mark "Cipher.getInstance" val "RC4" -> code.WeakCipher
  mark "Cipher.getInstance" val "Blowfish" -> code.WeakCipher
  mark "IvParameterSpec" val "0000000000000000" -> code.StaticIv

  // XSS (CWE-79) — servlet response writers (JVM-shared with Java)
  sink method "println" arg all -> code.HtmlRender
  sink method "print" arg all -> code.HtmlRender
  sink method "write" arg all -> code.HtmlRender
  // insecure randomness (CWE-330)
  mark "java.util.Random" -> code.WeakRandomValue
  mark "Random" -> code.WeakRandomValue
  mark "Math.random" -> code.WeakRandomValue
  // insecure cookie (CWE-614)
  mark "setHttpOnly" val "false" -> code.InsecureCookie
  mark "setSecure" val "false" -> code.InsecureCookie
  // trust boundary (CWE-501) — untrusted data into the session
  sink method "setAttribute" arg all -> code.TrustBoundary
  sink method "putValue" arg all -> code.TrustBoundary
  // LDAP (CWE-90) / XPath (CWE-643) — JNDI DirContext.search(filter@arg1), javax.xml XPath
  sink method "search" arg 1 -> code.LdapQuery
  sink method "evaluate" arg 0 -> code.XpathQuery

  // controls
  control "encodeForHTML" -> core.HtmlEscape
  control "escapeHtml4" -> core.HtmlEscape
  control "escapeHtml" -> core.HtmlEscape
  control "encodeForLDAP" -> core.LdapEscape
  control "escapeShell" -> core.ShellEscape
  control "safePath" -> core.PathCanonicalization
  control "validateRole" -> core.InputValidation
  control "canonicalPath" -> core.PathCanonicalization
  control "getCanonicalPath" -> core.PathCanonicalization
  control method "requireAuth" -> core.AuthenticationCheck
  control method "ensureAuthenticated" -> core.AuthenticationCheck
  control method "isAuthenticated" -> core.AuthenticationCheck
  control method "authenticate" -> core.AuthenticationCheck
  control method "checkOwnership" -> core.OwnershipCheck
  control method "requireOwner" -> core.OwnershipCheck
  control method "isOwner" -> core.OwnershipCheck

  // csrf disabled (CWE-352) — presence marker
  mark "csrf.disable" -> code.CsrfDisabled
  mark "NoopHostnameVerifier" -> code.CertValidationDisabled
  mark "Algorithm.none" -> code.JwtUnverified
  mark "setWritable" val "true" val "false" -> code.InsecurePermission
  mark "Files.setPosixFilePermissions" val "OTHERS_WRITE" -> code.InsecurePermission
  mark "Files.createFile" val "/tmp/" -> code.InsecureTempFile
  mark "Socket" -> code.ResourceHandle
  mark "FileInputStream" -> code.ResourceHandle
  mark "FileOutputStream" -> code.ResourceHandle
  control method "close" -> core.ResourceRelease
  mark "URL" val "http://" nval "127.0" -> code.CleartextChannel
  mark "setHeader" val "Access-Control-Allow-Origin" val "*" -> code.PermissiveCors
  mark "setHeader" val "X-Frame-Options" val "ALLOWALL" -> code.MissingFrameProtection

  // expression-language injection (CWE-917)
  sink method "parseExpression" -> code.ExpressionEval
}
