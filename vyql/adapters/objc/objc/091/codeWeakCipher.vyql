module bindings.objc.migration.mccadd221;

binding weakCipher91 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "CCCrypt" and node.token contains "Blowfish"
  emit issue code.WeakCipher at node
}
