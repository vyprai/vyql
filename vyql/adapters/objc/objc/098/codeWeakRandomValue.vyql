module bindings.objc.migration.mccadd221;

binding weakRandomValue98 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "arc4random_uniform"
  emit issue code.WeakRandomValue at node
}
