module bindings.objc.migration.mccadd221;

binding staticIv94 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "CCCryptorCreate" and node.token contains "0000000000000000"
  emit issue code.StaticIv at node
}
