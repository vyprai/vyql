module bindings.objc.migration.mccadd221;

binding indexAccess43 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "__subscript"
  emit issue code.IndexAccess at node
  emit sink code.IndexAccessSink at node
}
