// swift framework adapter (docs/07) — framework→concept content.
// frameworks: vapor, foundation, sqlite3, ios
adapter swift {
  meta { match: contains, fidelity: resolved }

  // untrusted input
  source "CommandLine.arguments" -> code.CliArgument
  source ".environment" -> code.EnvVariable
  source "readLine" -> code.StdinInput
  source ".query" -> code.HttpInput
  source ".parameters" -> code.HttpInput
  source ".queryParameters" -> code.HttpInput
  source ".headers" -> code.HttpInput
  // iOS deep-link / WKScriptMessage entry-point params, seeded by the frontend.
  source "url_scheme_input" -> code.URLSchemeInput
  // iOS clipboard (any app can seed the pasteboard)
  source "UIPasteboard.general.string" -> code.PasteboardInput
  source "UIPasteboard.general.strings" -> code.PasteboardInput
  source ".generalPasteboard.string" -> code.PasteboardInput

  // iOS WKWebView: tainted JS/HTML evaluated or loaded (CWE-749)
  sink method "evaluateJavaScript" -> code.WebViewLoad
  sink method "loadHTMLString" -> code.WebViewLoad
  sink method "stringByEvaluatingJavaScriptFromString" -> code.WebViewLoad
  flag code.WebViewJsInterface on any {
    path "add.name"
  }

  // SQL — sqlite3 C API (query is arg1) + ORM execute (raw query is arg0)
  sink path "sqlite3_exec" arg 1 -> code.SqlExecution
  sink path "sqlite3_prepare_v2" arg 1 -> code.SqlExecution
  sink path "sqlite3_prepare" arg 1 -> code.SqlExecution
  sink method "execute" -> code.SqlExecution
  sink method "run" -> code.SqlExecution

  // command execution — Process + libc system/popen (the command string is arg0)
  sink path "Process" -> code.CommandExecution
  sink method "launch" -> code.CommandExecution
  sink path "system" -> code.CommandExecution
  sink path "popen" -> code.CommandExecution

  // path / file
  sink method "contentsOfFile" -> code.FilePathAccess
  sink method "contents" -> code.FilePathAccess
  sink path "FileHandle" -> code.FilePathAccess
  sink method "extractEntry" -> code.ArchiveEntryWrite

  // SSRF
  sink path "URL" -> code.UrlFetch
  sink path "URLRequest" -> code.UrlFetch

  // regex compile (ReDoS) — tainted PATTERN
  sink path "NSRegularExpression" -> code.RegexCompile

  // XSS (CWE-79) — Vapor/HTML response writers (the rendered body is the arg)
  sink method "write" arg all -> code.HtmlRender
  sink method "send" arg all -> code.HtmlRender

  // LDAP (CWE-90) — directory search (filter is arg1)
  sink method "search" arg 1 -> code.LdapQuery

  // XPath (CWE-643) — XML/XPath evaluate (expression is arg0)
  sink method "evaluate" arg 0 -> code.XpathQuery

  // trust boundary (CWE-501) — untrusted data into the session
  sink method "setAttribute" arg all -> code.TrustBoundary
  sink method "putValue" arg all -> code.TrustBoundary
  sink method "findById" -> code.ObjectLookupByUserInput
  sink method "getUser" -> code.ObjectLookupByUserInput
  sink method "getAccount" -> code.ObjectLookupByUserInput
  flag code.AuthenticationRequiredOp on any {
    path "changePassword"
  }
  flag code.AuthenticationRequiredOp on any {
    path "updatePassword"
  }
  flag code.AuthenticationRequiredOp on any {
    path "resetPassword"
  }
  flag code.AuthenticationRequiredOp on any {
    path "changeEmail"
  }
  flag code.AuthenticationRequiredOp on any {
    path "transferFunds"
  }
  flag code.AuthenticationRequiredOp on any {
    path "deleteAccount"
  }
  flag code.AuthenticationRequiredOp on any {
    path "grantRole"
  }
  flag code.AuthenticationRequiredOp on any {
    path "makeAdmin"
  }
  flag code.ClearanceKitPolicyApplyBeforeAdapterStart in module {
    has "lang=swift"
    has "server.applyPolicyToFilter()server.applyAllowlistToFilter()server.applyJailRulesToFilter()"
    has "adapter.start(initialRules:initialRules,onXProtectChanged:{server.handleXProtectChange()})"
    lacks "adapter.start(initialRules:initialRules,onXProtectChanged:{server.handleXProtectChange()})server.applyPolicyToFilter()"
  }

  // weak hash (CWE-328) — CryptoKit Insecure.* + CommonCrypto CC_MD5/CC_SHA1
  flag code.WeakHash on any {
    path "Insecure.MD5"
  }
  flag code.WeakHash on any {
    path "Insecure.SHA1"
  }
  flag code.WeakHash on any {
    path "CC_MD5"
  }
  flag code.WeakHash on any {
    path "CC_SHA1"
  }

  // weak cipher (CWE-327) — broken block cipher selected by algorithm name
  flag code.WeakCipher on any {
    path "Cipher"
    has "DES"
  }
  flag code.WeakCipher on any {
    path "Cipher"
    has "RC4"
  }
  flag code.WeakCipher on any {
    path "Cipher"
    has "Blowfish"
  }
  flag code.StaticIv on any {
    path "Cipher"
    has "0000000000000000"
  }
  flag code.StaticIv on any {
    path "AES.GCM.Nonce"
    has "000000000000"
  }

  // insecure randomness (CWE-330) — arc4random / Int.random (SecRandomCopyBytes is safe)
  flag code.WeakRandomValue on any {
    path "arc4random"
  }
  flag code.WeakRandomValue on any {
    path "arc4random_uniform"
  }

  // insecure cookie (CWE-614) — cookie configured insecurely (setter-method idiom)
  flag code.InsecureCookie on any {
    path "setSecure"
    has "false"
  }
  flag code.InsecureCookie on any {
    path "setHttpOnly"
    has "false"
  }
  flag code.CertValidationDisabled on any {
    path "allowsAnyHTTPSCertificate"
    has "true"
  }
  flag code.CertValidationDisabled on any {
    path "serverTrustPolicy"
    has "disableEvaluation"
  }
  flag code.CleartextChannel on any {
    path "URL"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "URLRequest"
    has "http://"
    lacks "127.0"
  }
  flag code.PermissiveCors on any {
    path "setHeader"
    has "Access-Control-Allow-Origin"
    has "*"
  }
  flag code.MissingFrameProtection on any {
    path "setHeader"
    has "X-Frame-Options"
    has "ALLOWALL"
  }
  flag code.ResourceHandle on any {
    path "FileHandle.forReadingAtPath"
  }
  flag code.ResourceHandle on any {
    path "FileHandle.forWritingAtPath"
  }
  control method "closeFile" -> core.ResourceRelease

  // memory safety
  flag code.UnboundedCopySmell on any {
    path "BIO_puts"
  }

  // controls — sanitizers/validators defined in each generated case's preamble
  control "escapeHtml" -> core.HtmlEscape
  control "escapeXPath" -> core.XpathEscape
  control "encodeForLDAP" -> core.LdapEscape
  control "escapeShell" -> core.ShellEscape
  control "safePath" -> core.PathCanonicalization
  control "validateRole" -> core.InputValidation
  control "requireAuth" -> core.AuthenticationCheck
  control "ensureAuthenticated" -> core.AuthenticationCheck
  control "checkOwnership" -> core.OwnershipCheck
  control "requireOwner" -> core.OwnershipCheck

  // NOTE: addingPercentEncoding maps to no wired neutralizer (OutputEncoding is unused
  // by any rule and percent-encoding doesn't neutralize cmd/SQL/HTML) — omitted.
  // NOTE: Leaf #unsafeHTML XSS is template syntax (not Swift source) — out of scope, like Vue v-html.
}
