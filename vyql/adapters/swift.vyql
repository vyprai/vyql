// swift framework adapter (docs/07) — framework→concept content.
// frameworks: vapor, foundation, sqlite3, ios
adapter swift {
  meta { match: contains, fidelity: resolved }

  // untrusted input
  source "CommandLine.arguments" -> code.CliArgument
  source ".environment" -> code.EnvVariable
  source "readLine" -> code.StdinInput
  source ".query" -> code.HttpInput
  source ".parameters" -> code.HttpInput
  source ".queryParameters" -> code.HttpInput
  // iOS clipboard (any app can seed the pasteboard)
  source "UIPasteboard.general.string" -> code.PasteboardInput
  source "UIPasteboard.general.strings" -> code.PasteboardInput
  source ".generalPasteboard.string" -> code.PasteboardInput

  // iOS WKWebView: tainted JS/HTML evaluated or loaded (CWE-749)
  sink method "evaluateJavaScript" -> code.WebViewLoad
  sink method "loadHTMLString" -> code.WebViewLoad
  sink method "stringByEvaluatingJavaScriptFromString" -> code.WebViewLoad

  // SQL — sqlite3 C API (query is arg1)
  sink path "sqlite3_exec" arg 1 -> code.SqlExecution
  sink path "sqlite3_prepare_v2" arg 1 -> code.SqlExecution
  sink path "sqlite3_prepare" arg 1 -> code.SqlExecution
  sink method "execute" -> code.SqlExecution
  sink method "run" -> code.SqlExecution

  // command execution
  sink path "Process" -> code.CommandExecution
  sink method "launch" -> code.CommandExecution
  sink path "system" -> code.CommandExecution
  sink path "popen" -> code.CommandExecution

  // path / file
  sink method "contentsOfFile" -> code.FilePathAccess
  sink method "contents" -> code.FilePathAccess
  sink path "FileHandle" -> code.FilePathAccess

  // SSRF
  sink path "URL" -> code.UrlFetch
  sink path "URLRequest" -> code.UrlFetch

  // regex compile (ReDoS) — tainted PATTERN
  sink path "NSRegularExpression" -> code.RegexCompile

  // weak crypto (CWE-327) — CryptoKit Insecure.* + CommonCrypto CC_MD5/CC_SHA1
  mark "Insecure.MD5" -> code.WeakHash
  mark "Insecure.SHA1" -> code.WeakHash
  mark "CC_MD5" -> code.WeakHash
  mark "CC_SHA1" -> code.WeakHash

  // NOTE: addingPercentEncoding maps to no wired neutralizer (OutputEncoding is unused
  // by any rule and percent-encoding doesn't neutralize cmd/SQL/HTML) — omitted.
  // NOTE: Leaf #unsafeHTML XSS is template syntax (not Swift source) — out of scope, like Vue v-html.
}
