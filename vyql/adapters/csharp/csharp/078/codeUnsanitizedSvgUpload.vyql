binding unsanitizedSvgUpload78 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "csharp" and containsAny(node.token, ["param_type:Stream", "param_type:IFormFile", "param_type:IBrowserFile"]) and containsAny(node.token, ["call_path:Upload", "call_path:UploadAsync", "call_path:Save", "call_path:SaveAsync", "call_path:Write", "call_path:WriteAsync", "call_path:CopyTo"]) and containsAny(node.token, ["selector:.Name", "selector:.FileName", "selector:.NormalizedName", "selector:.ContentType", "selector:.Extension"]) and containsAny(node.token, ["identifier:file", "identifier:stream", "identifier:content", "identifier:upload"]) and not (containsAny(node.token, ["call_path:SanitizeSvg", "call_path:sanitizeSvg", "call_path:svgSanitize", "call_path:XmlReader.Create", "call_path:XDocument.Load", "call_path:HtmlSanitizer"]))
