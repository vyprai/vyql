module bindings.csharp.migration.m1caa8bf2;

binding dotNetArchiveOrRenamePathTraversal75 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=csharp" and node.token contains "name=RenameAsync" and node.token contains "Path.Combine(path.Directory.Parent.FullName,name)" and node.token contains "Directory.Move(path.Directory.FullName,newPath.FullName)" and not (node.token contains "Path.GetFullPath(newPath.FullName)") and not (node.token contains "StartsWith(path.RootVolume.RootDirectory")
  emit issue code.DotNetArchiveOrRenamePathTraversal at node
}
