module bindings.csharp.migration.m1caa8bf2;

binding assemblyLoadPathTraversal73 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "function_name:GetType" and node.token contains "AssemblyLoadContext.Default.LoadFromAssemblyPath" and node.token contains "AppContext.BaseDirectory+splitName[1].Trim()+\".dll\"" and not (node.token contains "path.Contains(\"..\")") and not (node.token contains "path.Contains(':')")
  emit issue code.AssemblyLoadPathTraversal at node
}
