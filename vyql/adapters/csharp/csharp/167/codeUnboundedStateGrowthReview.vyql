module bindings.csharp.migration.m1caa8bf2;

binding unboundedStateGrowthReview167 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=csharp" and node.token contains "name=GetValidity" and node.token contains "GetValidity(node.ChildNodes[i])" and not (node.token contains "MaxValidationDepth")
  emit issue code.UnboundedStateGrowthReview at node
}
