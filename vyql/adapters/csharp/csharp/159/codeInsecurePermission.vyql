module bindings.csharp.migration.m1caa8bf2;

binding insecurePermission159 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "UnixFileMode.OtherWrite"
  emit issue code.InsecurePermission at node
}
