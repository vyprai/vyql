binding httpInput11 {
  query pattern callExpr where callee.analysis ~= "parameter.entry" and args.any.context.className contains "" and args.any.literal contains "Controller" and args.any.context.functionVisibility contains "public" and not args.any.context.methodAttribute contains "NonAction"
