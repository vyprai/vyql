// perl framework adapter (docs/07) — framework→concept content.
// frameworks: CGI.pm, DBI, mod_perl, vanilla
adapter perl {
  meta { match: contains, fidelity: resolved }

  // untrusted input
  source ".param" -> code.HttpInput
  source "param" -> code.HttpInput
  source ".url_param" -> code.HttpInput
  source ".http" -> code.HttpInput
  source "ENV" -> code.EnvVariable
  source "ARGV" -> code.CliArgument
  source "STDIN" -> code.HttpInput

  // command execution
  sink path "system" -> code.CommandExecution
  sink path "exec" -> code.CommandExecution
  sink path "qx" -> code.CommandExecution
  sink path "readpipe" -> code.CommandExecution

  // code evaluation
  sink path "eval" -> code.CodeEval
  sink path "require" arg all -> code.DynamicCodeLoad

  // SQL — DBI
  sink method "do" -> code.SqlExecution
  sink method "prepare" -> code.SqlExecution
  sink method "selectall_arrayref" -> code.SqlExecution
  sink method "selectrow_array" -> code.SqlExecution
  sink method "selectrow_arrayref" -> code.SqlExecution
  sink method "selectall_hashref" -> code.SqlExecution

  // path / file — perl `open(my $fh, '<', PATH)` puts the path in a later arg,
  // so flag ANY tainted argument (the filehandle/mode args are constant).
  sink path "open" arg all -> code.FilePathAccess
  sink path "opendir" arg all -> code.FilePathAccess
  sink path "unlink" arg all -> code.FilePathAccess
  sink path "sysopen" arg all -> code.FilePathAccess
  sink path "Archive.Extract.extract" arg all -> code.ArchiveEntryWrite
  sink method "extractMember" arg all -> code.ArchiveEntryWrite

  // SSRF — LWP::Simple / LWP::UserAgent / HTTP::Tiny (URL is the call argument)
  sink path "getstore" -> code.UrlFetch
  sink path "getprint" -> code.UrlFetch
  sink path "mirror" -> code.UrlFetch
  sink method "request" -> code.UrlFetch
  flag code.CleartextChannel on any {
    path "getstore"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "getprint"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "mirror"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "request"
    has "http://"
    lacks "127.0"
  }

  // XSS (CWE-79) — print to the response filehandle / CGI writers
  sink path "print" arg all -> code.HtmlRender
  sink path "printf" arg all -> code.HtmlRender
  sink path "say" arg all -> code.HtmlRender

  // LDAP (CWE-90) — Net::LDAP search (filter is a named arg; flag any tainted arg)
  sink method "search" arg all -> code.LdapQuery

  // XPath (CWE-643) — XML::XPath find/findnodes (expression is the arg)
  sink method "find" -> code.XpathQuery
  sink method "findnodes" -> code.XpathQuery
  sink method "findvalue" -> code.XpathQuery

  // trust boundary (CWE-501) — untrusted data written into the session
  sink method "param" arg all -> code.TrustBoundary
  sink method "find_by_id" -> code.ObjectLookupByUserInput
  sink method "get_user" -> code.ObjectLookupByUserInput
  sink method "get_account" -> code.ObjectLookupByUserInput
  flag code.AuthenticationRequiredOp on any {
    path "change_password"
  }
  flag code.AuthenticationRequiredOp on any {
    path "update_password"
  }
  flag code.AuthenticationRequiredOp on any {
    path "reset_password"
  }
  flag code.AuthenticationRequiredOp on any {
    path "change_email"
  }
  flag code.AuthenticationRequiredOp on any {
    path "transfer_funds"
  }
  flag code.AuthenticationRequiredOp on any {
    path "delete_account"
  }
  flag code.AuthenticationRequiredOp on any {
    path "grant_role"
  }
  flag code.AuthenticationRequiredOp on any {
    path "make_admin"
  }

  // insecure cookie (CWE-614) — cookie secure/httponly setter turned off
  flag code.InsecureCookie on any {
    path "secure"
    has "false"
  }
  flag code.InsecureCookie on any {
    path "httponly"
    has "false"
  }

  // weak hash (CWE-328/327) — Digest::MD5 / Digest::SHA1 (`::` normalized to `.`)
  flag code.WeakHash on any {
    path "md5_hex"
  }
  flag code.WeakHash on any {
    path "md5_base64"
  }
  flag code.WeakHash on any {
    path "Digest.MD5"
  }
  flag code.WeakHash on any {
    path "sha1_hex"
  }
  flag code.WeakHash on any {
    path "Digest.SHA1"
  }

  // weak cipher (CWE-327) — Crypt::CBC / Crypt::DES with a broken algorithm.
  flag code.WeakCipher on any {
    path "Crypt.CBC.new"
    has "DES"
  }
  flag code.WeakCipher on any {
    path "Crypt.CBC.new"
    has "RC4"
  }
  flag code.WeakCipher on any {
    path "Crypt.CBC.new"
    has "Blowfish"
  }
  flag code.StaticIv on any {
    path "Crypt.CBC.new"
    has "0000000000000000"
  }
  flag code.WeakCipher on any {
    path "Crypt.DES"
  }

  // insecure randomness (CWE-330) — perl builtin rand() (Crypt::URandom is safe)
  flag code.WeakRandomValue on any {
    path "rand"
  }
  flag code.InsecurePermission on any {
    path "chmod"
    has "0777"
  }
  flag code.InsecurePermission on any {
    path "chmod"
    has "0666"
  }
  flag code.InsecureTempFile on any {
    path "tmpnam"
  }
  flag code.InsecureTempFile on any {
    path "POSIX.tmpnam"
  }
  flag code.ResourceHandle on any {
    path "open"
  }
  flag code.ResourceHandle on any {
    path "IO.Socket.INET.new"
  }
  control "close" -> core.ResourceRelease

  // deserialization (CWE-502) — Storable
  sink path "Storable.thaw" -> code.Deserialization
  sink method "thaw" -> code.Deserialization
  sink path "retrieve" -> code.Deserialization

  // XXE (CWE-611) — XML::LibXML parser
  sink method "parse_string" -> code.XmlParse
  sink method "parse_file" -> code.XmlParse
  sink method "load_xml" -> code.XmlParse

  // controls (sanitizers) — defined in each generated case's preamble
  control "quotemeta" -> core.ShellEscape
  control "encode_entities" -> core.HtmlEscape
  control "escapeHTML" -> core.HtmlEscape
  control "escapeHtml" -> core.HtmlEscape
  control "escapeXPath" -> core.XpathEscape
  control "encodeForLDAP" -> core.LdapEscape
  control "escapeShell" -> core.ShellEscape
  control "safePath" -> core.PathCanonicalization
  control "validateRole" -> core.InputValidation
  control "require_auth" -> core.AuthenticationCheck
  control "ensure_authenticated" -> core.AuthenticationCheck
  control "check_ownership" -> core.OwnershipCheck
  control "require_owner" -> core.OwnershipCheck
}
