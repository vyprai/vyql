module bindings.auditreview.migration.mbf0d19ec;

binding resourceReview28 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "net.Listen"
  emit issue code.ResourceReview at node
}
