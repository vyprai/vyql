module bindings.auditreview.migration.mbf0d19ec;

binding sensitiveOperation3 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.method == "truncateTable"
  emit issue code.SensitiveOperation at node
}
