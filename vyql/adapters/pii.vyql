// PII / regulated-data taxonomy — the CONFIGURABLE list of field/getter names that
// denote personally-identifiable or regulated data. This is the single editable source
// of truth (VyQL data, no rebuild needed); it labels matching field reads / getters as
// code.PiiValue across EVERY language (`cross_language`), so `user.ssn` / `getSsn()` in
// any frontend become PII taint sources. A finding is raised only when this value reaches
// a log/output sink (rule VYQL-PII-001). Keep the taxonomy NARROW — high-signal
// identifiers only; broad terms (name/email/phone/address) cause false positives.
adapter pii {
  meta { fidelity: resolved, cross_language: true }

  // national / government identifiers
  source method "ssn" -> code.PiiValue
  source method "social_security_number" -> code.PiiValue
  source method "passport_number" -> code.PiiValue
  source method "drivers_license" -> code.PiiValue
  source method "tax_id" -> code.PiiValue
  source method "national_id" -> code.PiiValue

  // financial
  source method "credit_card" -> code.PiiValue
  source method "credit_card_number" -> code.PiiValue
  source method "card_number" -> code.PiiValue
  source method "cvv" -> code.PiiValue
  source method "bank_account" -> code.PiiValue
  source method "iban" -> code.PiiValue
  source method "routing_number" -> code.PiiValue

  // health / sensitive
  source method "date_of_birth" -> code.PiiValue
  source method "medical_record_number" -> code.PiiValue

  // common getter spellings for the above (Java/JS style)
  source method "get_ssn" -> code.PiiValue
  source method "getSsn" -> code.PiiValue
  source method "get_credit_card" -> code.PiiValue
  source method "getCreditCard" -> code.PiiValue
  source method "getCardNumber" -> code.PiiValue
  source method "getPassportNumber" -> code.PiiValue
}
