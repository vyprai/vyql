module bindings.solidity.migration.m88e544d8;

binding rsaPkcs1DigestSuffixOnlyVerification15 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "solidity" and node.token contains "RSAVerify.rsarecover(modulus,exponent,sig)" and node.token contains "SHA1.sha1(data)==result.readBytes20(result.length-20)" and not (node.token contains "RSAPKCS1Verify.verifySHA1") and not (node.token contains "result[0]!=0x00||result[1]!=0x01") and not (node.token contains "DigestInfo")
  emit issue code.RsaPkcs1DigestSuffixOnlyVerification at node
}
