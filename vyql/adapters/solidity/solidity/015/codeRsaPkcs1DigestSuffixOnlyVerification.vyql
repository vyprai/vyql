module bindings.solidity.migration.m88e544d8;

binding rsaPkcs1DigestSuffixOnlyVerification15 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=solidity" and node.token contains "RSAVerify.rsarecover(modulus,exponent,sig)" and node.token contains "SHA1.sha1(data)==result.readBytes20(result.length-20)" and not (node.token contains "RSAPKCS1Verify.verifySHA1") and not (node.token contains "result[0]!=0x00||result[1]!=0x01") and not (node.token contains "DigestInfo")
  emit issue code.RsaPkcs1DigestSuffixOnlyVerification at node
}
