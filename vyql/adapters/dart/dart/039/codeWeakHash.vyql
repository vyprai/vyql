module bindings.dart.migration.m1c398214;

binding weakHash39 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "md5.convert"
  emit issue code.WeakHash at node
