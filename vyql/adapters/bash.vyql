// bash framework adapter (docs/07) — framework→concept content.
// A shell command is modeled as a call (program -> path); $1/$QUERY_STRING
// expansions are seeded as shell_input sources by the frontend.
adapter bash {
  meta {
    fidelity: resolved
    source_var_event: shell_input
    source_var_exact: ["1", "2", "3", "4", "5", "6", "7", "8", "9", "@", "*", "QUERY_STRING", "REQUEST_URI", "REQUEST_METHOD"]
    source_var_prefix: ["HTTP_", "REQUEST_", "CONTENT_", "PATH_INFO", "REMOTE_"]
  }

  // untrusted input: positional params + CGI environment ($1, $QUERY_STRING, …)
  source "shell_input" -> code.HttpInput

  // code evaluation
  sink path "eval" arg 0 -> code.CodeEval

  // command execution via an interpreter -c
  sink path "bash" arg 1 -> code.CommandExecution
  sink path "sh" arg 1 -> code.CommandExecution
  sink path "zsh" arg 1 -> code.CommandExecution
  sink path "ksh" arg 1 -> code.CommandExecution

  // code eval via language interpreters (-c/-e/-r take the script)
  sink path "python" arg 1 -> code.CodeEval
  sink path "python3" arg 1 -> code.CodeEval
  flag code.PythonTripleQuoteShellInterpolation in module {
    has "lang=bash"
    has "input=$(cat)"
    has "python3-c\""
    has "json.loads('''$input''')"
    lacks "<<'PYEOF'"
    lacks "os.environ.get('CC_INPUT')"
  }
  sink path "perl" arg 1 -> code.CodeEval
  sink path "php" arg 1 -> code.CodeEval
  sink path "node" arg 1 -> code.CodeEval

  // SSRF — fetching a tainted URL (any argument position may carry it)
  sink path "curl" -> code.UrlFetch
  sink path "wget" -> code.UrlFetch
  sink path "grep" arg all -> code.RegexCompile
  sink path "egrep" arg all -> code.RegexCompile
  flag code.CleartextChannel on any {
    path "curl"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "wget"
    has "http://"
    lacks "127.0"
  }

  // file inclusion (sourcing an untrusted path)
  sink path "source" -> code.FileInclude
  sink path "." -> code.FileInclude

  // file/path access through common shell utilities
  sink path "cat" arg all -> code.FilePathAccess
  sink path "less" arg all -> code.FilePathAccess
  sink path "head" arg all -> code.FilePathAccess
  sink path "tail" arg all -> code.FilePathAccess
  sink path "rm" arg all -> code.FilePathAccess
  sink path "cp" arg all -> code.FilePathAccess
  sink path "mv" arg all -> code.FilePathAccess
  sink path "chmod" arg all -> code.FilePathAccess
  sink path "chown" arg all -> code.FilePathAccess
  sink path "tar" arg all -> code.FilePathAccess

  // weak hash — md5sum / sha1sum utilities.
  flag code.WeakHash on any {
    path "md5sum"
  }
  flag code.WeakHash on any {
    path "sha1sum"
  }

  // unsafe permission/temp-file idioms.
  flag code.InsecurePermission on any {
    path "chmod"
    has "777"
  }
  flag code.InsecurePermission on any {
    path "chmod"
    has "666"
  }
  flag code.InsecurePermission on any {
    path "chmod"
    has "a+w"
  }
  flag code.InsecureTempFile on any {
    path "mktemp"
    has "-u"
  }

  // SQL via CLI clients (-e/-c queries)
  sink path "mysql" arg all -> code.SqlExecution
  sink path "psql" arg all -> code.SqlExecution
  sink path "sqlite3" arg all -> code.SqlExecution
}
