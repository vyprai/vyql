// csharp framework adapter (docs/07) — framework→concept content.
// frameworks: asp.net, asp.net-core, ado.net, dapper, ef-core
adapter csharp {
  meta { match: contains, fidelity: resolved }

  // MVC controller action parameters and Razor bound properties.
  source "Environment.GetCommandLineArgs" -> code.CliArgument
  source "Console.ReadLine" -> code.StdinInput
  source path "analysis.parameter.entry" val "method_attribute:HttpGet" -> code.HttpInput
  source path "analysis.parameter.entry" val "method_attribute:HttpPost" -> code.HttpInput
  source path "analysis.parameter.entry" val "method_attribute:HttpPut" -> code.HttpInput
  source path "analysis.parameter.entry" val "method_attribute:HttpDelete" -> code.HttpInput
  source path "analysis.parameter.entry" val "method_attribute:HttpPatch" -> code.HttpInput
  source path "analysis.parameter.entry" val "method_attribute:HttpHead" -> code.HttpInput
  source path "analysis.parameter.entry" val "method_attribute:Route" -> code.HttpInput
  source path "analysis.parameter.entry" val "class_attribute:ApiController" -> code.HttpInput
  source path "analysis.parameter.entry" val "class_attribute:Route" -> code.HttpInput
  source path "analysis.parameter.entry" val "class_name:" val "Controller" val "function_visibility:public" nval "method_attribute:NonAction" -> code.HttpInput
  source path "analysis.parameter.entry" val "class_base:Controller" val "function_visibility:public" nval "method_attribute:NonAction" -> code.HttpInput
  source path "analysis.parameter.entry" val "class_base:ControllerBase" val "function_visibility:public" nval "method_attribute:NonAction" -> code.HttpInput
  source path "analysis.parameter.entry" val "class_base:ApiController" val "function_visibility:public" nval "method_attribute:NonAction" -> code.HttpInput
  source path "analysis.property.entry" val "property_attribute:BindProperty" val "SupportsGet" val "true" -> code.HttpInput
  source path "analysis.property.entry" val "property_attribute:BindPropertyAttribute" val "SupportsGet" val "true" -> code.HttpInput

  // ASP.NET request inputs (receiver name varies → substring match)
  source ".QueryString" -> code.HttpInput
  source ".Form" -> code.HttpInput
  source ".Params" -> code.HttpInput
  source ".Query" -> code.HttpInput
  source ".Headers" -> code.HttpInput
  source ".Cookies" -> code.HttpInput
  source ".RequestUri" -> code.HttpInput
  source ".ReadAsStringAsync" -> code.HttpInput
  source ".ReadToEnd" -> code.HttpInput

  // SQL — ADO.NET command ctors take the query as arg0; Dapper uses methods
  sink path "SqlCommand" -> code.SqlExecution
  sink path "MySqlCommand" -> code.SqlExecution
  sink path "NpgsqlCommand" -> code.SqlExecution
  sink path "OracleCommand" -> code.SqlExecution
  sink path "SqliteCommand" -> code.SqlExecution
  sink path "SQLiteCommand" -> code.SqlExecution
  sink path "OleDbCommand" -> code.SqlExecution
  sink path "SqlDataAdapter" -> code.SqlExecution
  sink method "ExecuteSqlRaw" -> code.SqlExecution
  sink method "FromSqlRaw" -> code.SqlExecution
  sink method "Query" -> code.SqlExecution
  sink method "QueryAsync" -> code.SqlExecution
  sink method "Execute" -> code.SqlExecution
  sink method "ExecuteAsync" -> code.SqlExecution
  // Dapper single-row / scalar / multi variants (raw SQL is arg0)
  sink method "QueryFirst" -> code.SqlExecution
  sink method "QueryFirstAsync" -> code.SqlExecution
  sink method "QueryFirstOrDefault" -> code.SqlExecution
  sink method "QuerySingle" -> code.SqlExecution
  sink method "QuerySingleAsync" -> code.SqlExecution
  sink method "QueryMultiple" -> code.SqlExecution
  sink method "ExecuteScalar" -> code.SqlExecution
  sink method "ExecuteScalarAsync" -> code.SqlExecution

  // command execution
  sink path "Process.Start" -> code.CommandExecution
  sink path "ProcessStartInfo" -> code.CommandExecution
  // the command line is usually assigned to the .Arguments property, not passed to the
  // ProcessStartInfo ctor — model that property write as the injectable cmdi position.
  sink path "Arguments" -> code.CommandExecution
  sink path "StartInfo.Arguments" -> code.CommandExecution

  // deserialization
  sink method "Deserialize" -> code.Deserialization
  sink path "BinaryFormatter" -> code.Deserialization
  sink path "LosFormatter" -> code.Deserialization
  sink path "NetDataContractSerializer" -> code.Deserialization

  // path / file
  sink path "File.ReadAllText" -> code.FilePathAccess
  sink path "File.ReadAllBytes" -> code.FilePathAccess
  sink path "File.ReadAllLines" -> code.FilePathAccess
  sink path "File.WriteAllText" -> code.FilePathAccess
  sink path "File.WriteAllBytes" -> code.UnsafeUpload
  sink path "File.Delete" -> code.FilePathAccess
  sink path "File.Exists" -> code.FilePathAccess
  sink path "File.Open" -> code.FilePathAccess
  sink path "File.OpenText" -> code.FilePathAccess
  sink path "File.OpenRead" -> code.FilePathAccess
  sink path "File.Copy" -> code.FilePathAccess
  sink path "File.Move" -> code.FilePathAccess
  sink path "FileStream" -> code.FilePathAccess
  sink path "StreamReader" -> code.FilePathAccess
  sink path "Assembly.Load" -> code.DynamicCodeLoad
  sink path "Assembly.LoadFrom" -> code.DynamicCodeLoad
  sink path "Assembly.LoadFile" -> code.DynamicCodeLoad
  flag code.AssemblyLoadPathTraversal in function {
    function "GetType"
    has "AssemblyLoadContext.Default.LoadFromAssemblyPath"
    has "AppContext.BaseDirectory+splitName[1].Trim()+\".dll\""
    lacks "path.Contains(\"..\")"
    lacks "path.Contains(':')"
  }
  flag code.DotNetArchiveOrRenamePathTraversal in function {
    lang "csharp"
    name "ExtractAsync"
    has "Path.Combine(rootPath,entry.FullName)"
    has "entry.ExtractToFile(file,true)"
    lacks "Path.GetFullPath(file)"
    lacks "StartsWith(rootPath"
  }
  flag code.DotNetArchiveOrRenamePathTraversal in function {
    lang "csharp"
    name "RenameAsync"
    has "Path.Combine(path.Directory.Parent.FullName,name)"
    has "Directory.Move(path.Directory.FullName,newPath.FullName)"
    lacks "Path.GetFullPath(newPath.FullName)"
    lacks "StartsWith(path.RootVolume.RootDirectory"
  }
  flag code.DotNetArchiveOrRenamePathTraversal in function {
    lang "csharp"
    name "RenameAsync"
    has "Path.Combine(path.File.DirectoryName,name)"
    has "File.Move(path.File.FullName,newPath.FullName)"
    lacks "Path.GetFullPath(newPath.FullName)"
    lacks "StartsWith(path.RootVolume.RootDirectory"
  }
  sink path "ExtractToFile" -> code.ArchiveEntryWrite
  flag code.UnsanitizedSvgUpload in function {
    lang "csharp"
    param type contains_any ["Stream", "IFormFile", "IBrowserFile"]
    call path contains_any ["Upload", "UploadAsync", "Save", "SaveAsync", "Write", "WriteAsync", "CopyTo"]
    selector contains_any [".Name", ".FileName", ".NormalizedName", ".ContentType", ".Extension"]
    token identifier contains_any ["file", "stream", "content", "upload"]
    not call path contains_any ["SanitizeSvg", "sanitizeSvg", "svgSanitize", "XmlReader.Create", "XDocument.Load", "HtmlSanitizer"]
  }

  // SSRF
  sink method "DownloadString" -> code.UrlFetch
  sink method "DownloadData" -> code.UrlFetch
  sink method "GetAsync" -> code.UrlFetch
  sink path "WebClient" -> code.UrlFetch
  sink method "FindAsync" -> code.ObjectLookupByUserInput
  sink method "Find" -> code.ObjectLookupByUserInput
  sink method "GetUser" -> code.ObjectLookupByUserInput
  sink method "GetAccount" -> code.ObjectLookupByUserInput
  sink method "GetOrder" -> code.ObjectLookupByUserInput
  flag code.AuthenticationRequiredOp on any {
    path "ChangePassword"
  }
  flag code.AuthenticationRequiredOp on any {
    path "UpdatePassword"
  }
  flag code.AuthenticationRequiredOp on any {
    path "ResetPassword"
  }
  flag code.AuthenticationRequiredOp on any {
    path "ChangeEmail"
  }
  flag code.AuthenticationRequiredOp on any {
    path "TransferFunds"
  }
  flag code.AuthenticationRequiredOp on any {
    path "DeleteAccount"
  }
  flag code.AuthenticationRequiredOp on any {
    path "GrantRole"
  }
  flag code.AuthenticationRequiredOp on any {
    path "MakeAdmin"
  }

  // reflected XSS — Response.Write, Razor @Html.Raw, Blazor MarkupString
  sink path "Response.Write" -> code.HtmlRender
  sink method "Raw" -> code.HtmlRender
  sink path "MarkupString" -> code.HtmlRender
  flag code.HtmlSanitizerLogicReview on any {
    method "LoadHtml"
  }
  // BTCPay ConfirmModel(title, description, action): the Description (arg 1) is rendered as
  // RAW HTML in the Confirm view, so an untrusted value interpolated into it is reflected XSS.
  sink path "ConfirmModel" arg 1 -> code.HtmlRender
  // Open redirect: ASP.NET-style redirect APIs and ABP's single-argument RedirectSafelyAsync
  // take a destination URL/path as arg0.
  sink path "Response.Redirect" -> code.RedirectTarget
  sink method "Redirect" -> code.RedirectTarget
  sink method "RedirectPermanent" -> code.RedirectTarget
  sink method "RedirectPreserveMethod" -> code.RedirectTarget
  sink method "RedirectPermanentPreserveMethod" -> code.RedirectTarget
  sink method "RedirectSafelyAsync" -> code.RedirectTarget
  flag code.UnencodedUrlQueryParameter in function {
    function "ConstructValidateUrl"
    has "QueryItems.Add"
    has "ArtifactParameterName"
    has "serviceTicket"
    lacks "HttpUtility.UrlEncode(serviceTicket)"
  }
  // HTTP response splitting / header injection (CWE-113).
  sink path "Response.Headers.Add" arg 1 -> code.ResponseHeaderWrite
  sink path "Response.Headers.Append" arg 1 -> code.ResponseHeaderWrite
  // HttpClient/RestSharp header write WITHOUT CRLF validation (CWE-113 response splitting).
  sink method "TryAddWithoutValidation" arg 1 -> code.ResponseHeaderWrite
  // log injection (CWE-117) + secret-in-log (CWE-532).
  sink method "LogInformation" arg all -> code.LogOutput
  sink method "LogWarning" arg all -> code.LogOutput
  sink method "LogError" arg all -> code.LogOutput
  sink method "LogDebug" arg all -> code.LogOutput
  flag code.LogWrite on any {
    path "LogInformation"
  }
  flag code.LogWrite on any {
    path "LogWarning"
  }
  flag code.LogWrite on any {
    path "LogError"
  }
  flag code.LogWrite on any {
    path "LogDebug"
  }
  // CSV/formula injection (CWE-1236) and ASP.NET MVC mass assignment (CWE-915).
  sink method "WriteField" arg all -> code.CsvCell
  sink method "WriteRecords" arg all -> code.CsvCell
  sink method "TryUpdateModelAsync" arg all -> code.MassAssign
  sink method "UpdateModel" arg all -> code.MassAssign

  // XXE (CWE-611) — legacy parsers that resolve external entities by default
  // (XmlDocument/XmlReader/XPathDocument). LINQ-to-XML (XDocument/XElement) prohibits
  // DTDs by default, so it is deliberately NOT mapped here.
  sink path "XmlReader.Create" -> code.XmlParse
  sink method "LoadXml" -> code.XmlParse
  sink path "XmlDocument.Load" -> code.XmlParse
  sink path "XPathDocument" -> code.XmlParse

  // controls
  control "HttpUtility.HtmlEncode" -> core.HtmlEscape
  control "WebUtility.HtmlEncode" -> core.HtmlEscape
  control "HtmlEncoder.Encode" -> core.HtmlEscape
  control "AntiXss.HtmlEncode" -> core.HtmlEscape
  control "Path.GetFullPath" -> core.PathCanonicalization
  control "Path.GetFileName" -> core.PathCanonicalization
  control method "RequireAuth" -> core.AuthenticationCheck
  control method "EnsureAuthenticated" -> core.AuthenticationCheck
  control method "IsAuthenticated" -> core.AuthenticationCheck
  control method "Authenticate" -> core.AuthenticationCheck
  control method "CheckOwnership" -> core.OwnershipCheck
  control method "RequireOwner" -> core.OwnershipCheck
  control method "IsOwner" -> core.OwnershipCheck
  flag code.LockAcquire on any {
    path "Monitor.Enter"
  }
  flag code.LockAcquire on any {
    path "lock"
  }
  control "Monitor.Exit" -> core.LockRelease

  // regex compile (ReDoS, CWE-1333) — tainted PATTERN arg0
  sink path "Regex" -> code.RegexCompile

  // weak crypto (CWE-327) — broken cipher/hash constructors (presence)
  flag code.WeakCipher on any {
    path "DES.Create"
  }
  flag code.WeakCipher on any {
    path "TripleDES.Create"
  }
  flag code.WeakCipher on any {
    path "RC2.Create"
  }
  flag code.WeakCipher on any {
    path "DESCryptoServiceProvider"
  }
  flag code.WeakCipher on any {
    path "TripleDESCryptoServiceProvider"
  }
  flag code.WeakCipher on any {
    path "RC2CryptoServiceProvider"
  }
  // ECB mode (CWE-327) — CipherMode.ECB assigned to a cipher's .Mode.
  flag code.WeakCipher on any {
    path "CipherMode.ECB"
  }
  flag code.StaticIv on any {
    path "CreateEncryptor"
    has "0000000000000000"
  }
  flag code.StaticIv on any {
    path "AesGcm"
    has "000000000000"
  }
  flag code.CertValidationDisabled on any {
    path "DangerousAcceptAnyServerCertificateValidator"
  }
  flag code.CertValidationDisabled on any {
    path "ServerCertificateCustomValidationCallback"
    has "true"
  }
  flag code.JwtUnverified on any {
    path "TokenValidationParameters"
    has "RequireSignedTokens=false"
  }
  flag code.JwtUnverified on any {
    path "TokenValidationParameters"
    has "ValidateIssuerSigningKey=false"
  }
  flag code.SamlFirstSignatureOnlyBypass in function {
    lang "csharp"
    name "VerifySignature"
    has "signedDocument.GetElementsByTagName"
    has "nodeList[0]"
    has "signedXml.LoadXml"
    has "signedXml.CheckSignature"
    lacks "VerifyAllSignatures"
    lacks "signatureNodes"
  }
  flag code.CsrfDisabled on any {
    path "IgnoreAntiforgeryToken"
  }
  flag code.InsecurePermission on any {
    path "UnixFileMode.OtherWrite"
  }
  flag code.UncheckedEncodedLengthArithmetic in function {
    lang "csharp"
    has "ReadVarUInt32"
    has "(int)input.ReadVarUInt32()"
    lacks "checked"
  }
  flag code.UncheckedEncodedLengthArithmetic in function {
    lang "csharp"
    has "ReadVarUInt32"
    has "input.ReadVarUInt32()<<1"
    lacks "checked"
  }
  flag code.UncheckedEncodedLengthArithmetic in function {
    lang "csharp"
    has "input.SkipBytes(count*sizeof("
    lacks "checked(count*sizeof("
  }
  flag code.UncheckedEncodedLengthArithmetic in function {
    lang "csharp"
    name "SkipBytes"
    has "position+=count"
    lacks "checked(position+count)"
  }
  flag code.UncheckedEncodedLengthArithmetic in function {
    lang "csharp"
    has "currentLength+=count"
    lacks "checked(stackFrame.currentLength+count)"
  }
  flag code.UncheckedEncodedLengthArithmetic in function {
    lang "csharp"
    has "value.Length<<1"
    lacks "checked(value.Length*2)"
  }
  flag code.UnboundedStateGrowthReview in function {
    lang "csharp"
    name "GetOrAddNode"
    has "GetOrAddNode(subKey)"
    lacks "MaxStateDepth"
  }
  flag code.UnboundedStateGrowthReview in function {
    lang "csharp"
    name "GetValidity"
    has "GetValidity(node.ChildNodes[i])"
    lacks "MaxValidationDepth"
  }
  flag code.CsharpEnumParseMissCacheGrowth in function {
    lang "csharp"
    has "ConcurrentDictionary<string,Enum>"
    has "GetOrAdd(lowerStringValue"
    has "TryParseStringValueToEnum_Uncached"
    has "returnparseSucceededForDictionary?(Enum)parsedValueForDictionary:null;"
    lacks "BuildCacheDictionaryForParseStringValue"
    lacks "TryGetValue(lowerStringValue"
  }
  flag code.TimeBoundAccessTokenReview in function {
    lang "csharp"
    has "BlobSasBuilder"
    has "ExpiresOn"
    has "AddHours(1)"
    has "GenerateSasUri"
    lacks "AddMinutes(tokenDuration)"
  }
  flag code.RequestTokenCacheCleanupBypass in function {
    lang "csharp"
    name "AddParameterToEndpoint"
    has "ParameterBasedFrom<IToken<IUser>>"
    has "returnthis.AuthenticateToken(context,database);"
    has "returntoken.User;"
    has "this._tokenCache.Value=null;"
  }
  flag code.ResourceHandle on any {
    path "File.Open"
  }
  flag code.ResourceHandle on any {
    path "File.OpenRead"
  }
  flag code.ResourceHandle on any {
    path "TcpClient"
  }
  control method "Close" -> core.ResourceRelease
  control method "Dispose" -> core.ResourceRelease
  flag code.WeakHash on any {
    path "MD5.Create"
  }
  flag code.WeakHash on any {
    path "SHA1.Create"
  }
  flag code.WeakHash on any {
    path "MD5CryptoServiceProvider"
  }
  flag code.WeakHash on any {
    path "SHA1CryptoServiceProvider"
  }
  flag code.WeakHash on any {
    path "SHA1Managed"
  }

  // XPath injection (CWE-643) — SelectNodes/SelectSingleNode/XPathSelectElements (distinctive XML)
  sink method "SelectNodes" -> code.XpathQuery
  sink method "SelectSingleNode" -> code.XpathQuery
  sink method "XPathSelectElements" -> code.XpathQuery
  sink method "XPathSelectElement" -> code.XpathQuery

  // LDAP injection (CWE-90) — new DirectorySearcher(filter) constructor (filter arg 0)
  sink path "DirectorySearcher" -> code.LdapQuery

  // trust boundary (CWE-501) — untrusted data into the HTTP session
  sink method "SetAttribute" arg all -> code.TrustBoundary
  sink method "Add" arg all -> code.TrustBoundary

  // insecure cookie (CWE-614) — HttpCookie configured insecurely (setter idiom,
  // val-matched; property-write `c.Secure = false` is not modeled as a call)
  flag code.InsecureCookie on any {
    path "SetSecure"
    has "false"
  }
  flag code.InsecureCookie on any {
    path "SetHttpOnly"
    has "false"
  }

  // insecure randomness (CWE-330) — System.Random is not cryptographically secure.
  // The secure API RandomNumberGenerator.Create() does NOT path-collide with "Random"
  // (segment "RandomNumberGenerator" != "Random").
  flag code.WeakRandomValue on any {
    path "Random"
  }

  // controls — sanitizers/validators defined in each generated case's preamble
  control "escapeHtml" -> core.HtmlEscape
  control "escapeXPath" -> core.XpathEscape
  control "encodeForLDAP" -> core.LdapEscape
  control "escapeShell" -> core.ShellEscape
  control "safePath" -> core.PathCanonicalization
  control "validateRole" -> core.InputValidation

  // cleartext channel (CWE-319) — http:// URL to a client (loopback excluded; low sev)
  flag code.CleartextChannel on any {
    path "Uri"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "GetStringAsync"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "GetAsync"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "DownloadString"
    has "http://"
    lacks "127.0"
  }

  // character-filter: Regex.Replace(input, pattern, repl) is global.
  filter path "Regex.Replace" global

  // ServiceStack (dependency-gated): the HTML-format response writer reflects the request
  // URL into an HTML page and writes it to the output stream. ResolveAbsoluteUrl is the
  // request-derived source; the stream WriteAsync of the built HTML body is the XSS sink.
  // Scoped to the servicestack package so the otherwise-generic WriteAsync stays safe.
  // RestSharp (dependency-gated): the HeaderParameter ctor accepts a header VALUE (arg 1) that
  // becomes an HTTP request header unvalidated — a CRLF value is response splitting (CWE-113).
  // This is the exact operation CVE-2024-45302 hardened (the ctor now rejects \r\n\t), so it is
  // the header-injection sink (like `new SqlCommand(q)` is a SQL sink).
  package "restsharp" {
    sink path "HeaderParameter" arg 1 -> code.ResponseHeaderWrite
  }
  package "servicestack" {
    source method "ResolveAbsoluteUrl" -> code.HttpInput
    sink method "WriteAsync" -> code.HtmlRender
  }
}
