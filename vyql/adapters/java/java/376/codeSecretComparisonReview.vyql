module bindings.java.migration.m420f6b67;

binding secretComparisonReview376 {
  query pattern presenceNode where node.scope == "function" and containsAny(node.token, ["function_name:validate", "function_name:verify", "function_name:check", "function_name:authenticate"]) and node.context.callPath contains "computeSignature" and node.context.callPath contains "signature.equals" and not (node.context.callPath contains "constantTimeEquals") and not (node.context.callPath contains "MessageDigest.isEqual")
  emit issue code.SecretComparisonReview at node
}
