binding secretComparisonReview376 {
  query pattern presenceNode where node.scope == "function" and containsAny(node.token, ["function_name:validate", "function_name:verify", "function_name:check", "function_name:authenticate"]) and node.token contains "call_path:computeSignature" and node.token contains "call_path:signature.equals" and not (node.token contains "call_path:constantTimeEquals") and not (node.token contains "call_path:MessageDigest.isEqual")
  emit issue code.SecretComparisonReview at node
}
