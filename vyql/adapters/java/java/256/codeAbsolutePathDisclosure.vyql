module bindings.java.migration.m420f6b67;

binding absolutePathDisclosure256 {
  query pattern presenceNode where node.scope == "function" and node.token contains "selector:Constants.MC_REALPATH" and node.token contains "selector:Constants.MC_RELATIVE_PATH" and node.token contains "call:FileReader" and not (node.token contains "call:FileNotFoundException")
  emit issue code.AbsolutePathDisclosure at node
}
