module bindings.java.migration.m420f6b67;

binding jenkinsCredentialEndpointMissingPostPermission221 {
  query pattern presenceNode where node.scope == "function" and containsAny(node.token, ["function_name:doCreateApiToken", "function_name:doCheckRepoAccess", "function_name:doTestGithubAccess"]) and containsAny(node.token, ["call_path:createToken", "call_path:getRepository", "call_path:getMyself"]) and not (containsAny(node.token, ["call_path:checkPermission", "call_path:hasPermission"])) and not (containsAny(node.token, ["annotation:POST", "annotation:RequirePOST"]))
  emit issue code.JenkinsCredentialEndpointMissingPostPermission at node
}
