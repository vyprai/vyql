  query unstable.legacyFlag as node where node.scope == "function" and containsAny(node.token, ["function_name:doCreateApiToken", "function_name:doCheckRepoAccess", "function_name:doTestGithubAccess"]) and containsAny(node.token, ["call_path:createToken", "call_path:getRepository", "call_path:getMyself"]) and not (containsAny(node.token, ["call_path:checkPermission", "call_path:hasPermission"])) and not (containsAny(node.token, ["annotation:POST", "annotation:RequirePOST"]))
