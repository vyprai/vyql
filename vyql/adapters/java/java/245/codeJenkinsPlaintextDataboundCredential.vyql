module bindings.java.migration.m420f6b67;

binding jenkinsPlaintextDataboundCredential245 {
  query pattern presenceNode where node.kind == "any" and node.analysis == "parameter.entry" and node.context.annotation contains "DataBoundConstructor" and node.context.paramName contains "apitoken" and node.context.paramType contains "String" and not (node.context.paramType contains "Secret")
  emit issue code.JenkinsPlaintextDataboundCredential at node
