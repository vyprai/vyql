module bindings.java.migration.m420f6b67;

binding jenkinsCredentialsStartupLoadContextExposure249 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "class" and node.token contains "class_name:SystemCredentialsProvider" and node.token contains "function_name:SystemCredentialsProvider" and node.token contains "call_path:xml.unmarshal" and node.token contains "call_path:DomainCredentials.migrateListToMap" and node.token contains "function_name:getInstance" and not (node.token contains "annotation:Initializer") and not (node.token contains "function_name:forceLoadDuringStartup")
  emit issue code.JenkinsCredentialsStartupLoadContextExposure at node
}
