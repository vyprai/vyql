module bindings.java.migration.m420f6b67;

binding xmlHardening282 {
  query pattern callExpr where callee.path ~= "setFeature" and args.any.literal contains "disallow-doctype-decl"
  emit check core.XmlHardening at call {
    advisory: true
    covers sameReceiver {
      anchor: callee.receiver
    }
  }
}
