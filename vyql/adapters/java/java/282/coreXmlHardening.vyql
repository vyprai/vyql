module bindings.java.migration.m420f6b67;

binding xmlHardening282 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "setFeature" and node.token contains "disallow-doctype-decl"
  emit check core.XmlHardening at node {
    advisory: true
  }
}
