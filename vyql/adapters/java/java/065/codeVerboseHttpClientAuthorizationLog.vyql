module bindings.java.migration.m420f6b67;

binding verboseHttpClientAuthorizationLog65 {
  query pattern presenceNode where node.scope == "function" and node.token contains "call_path:RestAdapter.Builder" and node.token contains "call:setLogLevel" and node.token contains "call:setLog" and node.token contains "selector:RestAdapter.LogLevel.FULL" and not (node.token contains "selector:RestAdapter.LogLevel.BASIC") and not (node.token contains "selector:RestAdapter.LogLevel.NONE")
  emit issue code.VerboseHttpClientAuthorizationLog at node
}
