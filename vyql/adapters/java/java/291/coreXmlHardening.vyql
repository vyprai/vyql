module bindings.java.migration.m420f6b67;

binding xmlHardening291 {
  query pattern callExpr where callee.path ~= "setAttribute" and args.any.literal contains "ACCESS_EXTERNAL_STYLESHEET"
  emit check core.XmlHardening at call {
    advisory: true
    covers sameReceiver {
      anchor: callee.receiver
    }
  }
}
