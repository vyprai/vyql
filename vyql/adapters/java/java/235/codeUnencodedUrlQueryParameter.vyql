module bindings.java.migration.m420f6b67;

binding unencodedUrlQueryParameter235 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and containsAny(node.token, ["function_name:generateURL", "function_name:getRenderer"]) and node.token contains "call_path:StringBuilder" and node.token contains "call_path:append" and containsAny(node.token, ["literal:?jobFilter=", "literal:&nodeFilter=", "literal:&launcherFilter="]) and containsAny(node.token, ["call_path:getJobFilter", "call_path:getNodeFilter", "call_path:getLauncherFilter"]) and not (containsAny(node.token, ["call_path:URLEncoder.encode", "call_path:Util.rawEncode", "call_path:encodeURIComponent"]))
  emit issue code.UnencodedUrlQueryParameter at node
}
