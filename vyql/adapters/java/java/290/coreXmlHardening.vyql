module bindings.java.migration.m420f6b67;

binding xmlHardening290 {
  query pattern callExpr where callee.path ~= "setAttribute" and args.any.literal contains "ACCESS_EXTERNAL_SCHEMA"
  emit check core.XmlHardening at call {
    advisory: true
    covers sameReceiver {
      anchor: callee.receiver
    }
  }
}
