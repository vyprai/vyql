module bindings.java.migration.m420f6b67;

binding weakHash371 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "MessageDigest.getInstance" and node.token contains "MD2"
  emit issue code.WeakHash at node
}
