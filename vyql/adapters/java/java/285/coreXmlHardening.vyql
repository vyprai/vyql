module bindings.java.migration.m420f6b67;

binding xmlHardening285 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "setExpandEntityReferences" and node.token contains "false"
  emit check core.XmlHardening at node {
    advisory: true
  }
}
