module bindings.java.migration.m420f6b67;

binding secretComparisonReview377 {
  query pattern presenceNode where node.scope == "function" and containsAny(node.context.functionName, ["matches", "validate", "verify", "check", "authenticate"]) and containsAny(node.context.callPath, ["StringUtils.equals", "Objects.equals"]) and containsAny(node.context.callPath, ["sha1", "sha256", "computeSignature", "computeDigest", "digest"]) and containsAny(node.context.callArg, ["StringUtils.equals:computed", "StringUtils.equals:digest", "StringUtils.equals:signature", "Objects.equals:computed", "Objects.equals:digest", "Objects.equals:signature"]) and not (containsAny(node.context.callPath, ["MessageDigest.isEqual", "constantTimeEquals", "isEqual"]))
  emit issue code.SecretComparisonReview at node
}
