module bindings.java.migration.m420f6b67;

binding secretComparisonReview377 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and containsAny(node.token, ["function_name:matches", "function_name:validate", "function_name:verify", "function_name:check", "function_name:authenticate"]) and containsAny(node.token, ["call_path:StringUtils.equals", "call_path:Objects.equals"]) and containsAny(node.token, ["call_path:sha1", "call_path:sha256", "call_path:computeSignature", "call_path:computeDigest", "call_path:digest"]) and containsAny(node.token, ["call_arg:StringUtils.equals:computed", "call_arg:StringUtils.equals:digest", "call_arg:StringUtils.equals:signature", "call_arg:Objects.equals:computed", "call_arg:Objects.equals:digest", "call_arg:Objects.equals:signature"]) and not (containsAny(node.token, ["call_path:MessageDigest.isEqual", "call_path:constantTimeEquals", "call_path:isEqual"]))
  emit issue code.SecretComparisonReview at node
}
