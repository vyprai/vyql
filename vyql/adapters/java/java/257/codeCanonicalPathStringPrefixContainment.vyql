module bindings.java.migration.m420f6b67;

binding canonicalPathStringPrefixContainment257 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "function_name:getValidDirectoryPath" and node.token contains "call:getCanonicalPath" and node.token contains "call:startsWith" and not (node.scopeCall.any contains "toPath")
