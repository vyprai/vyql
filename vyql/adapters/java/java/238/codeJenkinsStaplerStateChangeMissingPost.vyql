module bindings.java.migration.m420f6b67;

binding jenkinsStaplerStateChangeMissingPost238 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and containsAny(node.token, ["function_name:doSave", "function_name:doSubmit", "function_name:doConfigure"]) and containsAny(node.token, ["call:bindJSON", "call:save", "call:configure"]) and node.token contains "call:checkPermission" and not (node.token contains "annotation:RequirePOST") and not (node.token contains "annotation:POST")
  emit issue code.JenkinsStaplerStateChangeMissingPost at node
}
