binding credentialedEndpointReview216 {
  query pattern presenceNode where node.scope == "function" and node.token contains "function_name:doTest" and node.token contains "call:setCredentialsId" and node.token contains "call:accurevLoginFromGlobalConfig" and not (node.scopeCall.any contains "hasPermission") and not (node.scopeCall.any contains "checkPermission")
  emit issue code.CredentialedEndpointReview at node
}
