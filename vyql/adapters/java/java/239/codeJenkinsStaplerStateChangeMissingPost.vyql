  query pattern presenceNode where node.scope == "function" and containsAny(node.token, ["function_name:doRemove", "function_name:doDelete"]) and containsAny(node.token, ["call:removeTemplateById", "call:delete", "call:remove"]) and node.context.call contains "checkPermission" and not (node.context.annotation contains "RequirePOST") and not (node.context.annotation contains "POST")
