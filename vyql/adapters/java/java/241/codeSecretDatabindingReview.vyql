module bindings.java.migration.m420f6b67;

binding secretDatabindingReview241 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path == "analysis.parameter.entry" and node.token contains "param_name:awsSecretKey" and node.token contains "param_type:Secret"
  emit issue code.SecretDatabindingReview at node
}
