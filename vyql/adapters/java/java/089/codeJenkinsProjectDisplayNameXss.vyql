module bindings.java.migration.m420f6b67;

binding jenkinsProjectDisplayNameXss89 {
  query pattern presenceNode where node.scope == "function" and node.token contains "function_name:getName" and node.token contains "call_path:project.getFullDisplayName" and not (node.token contains "call_path:StringEscapeUtils.escapeHtml") and not (node.token contains "call_path:Util.escape")
  emit issue code.JenkinsProjectDisplayNameXss at node
}
