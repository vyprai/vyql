binding stateChangingOp255 {
  query pattern presenceNode where node.scope == "function" and node.token contains "function_name:doFill" and not (node.scopeCall.any contains "checkPermission") and not (node.token contains "annotation:POST") and not (node.token contains "annotation:RequirePOST")
  emit issue code.StateChangingOp at node
  emit sink code.StateChangingOpSink at node
}
