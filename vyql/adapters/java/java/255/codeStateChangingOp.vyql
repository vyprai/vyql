binding stateChangingOp255 {
  query pattern presenceNode where node.scope == "function" and node.context.functionName contains "doFill" and not (node.scopeCall.any contains "checkPermission") and not (node.context.annotation contains "POST") and not (node.context.annotation contains "RequirePOST")
  emit issue code.StateChangingOp at node
  emit sink code.StateChangingOpSink at node
}
