module bindings.java.migration.m420f6b67;

binding stateChangingOp255 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "function_name:doFill" and not (node.scopeCall.any contains "checkPermission") and not (node.token contains "annotation:POST") and not (node.token contains "annotation:RequirePOST")
  emit issue code.StateChangingOp at node
  emit sink code.StateChangingOpSink at node
}
