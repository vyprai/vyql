module bindings.java.migration.m420f6b67;

binding credentialedEndpointReview217 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "function_name:doFill" and node.token contains "call:getBzmUtils" and not (node.scopeCall.any contains "checkPermission")
  emit issue code.CredentialedEndpointReview at node
}
