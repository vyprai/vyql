module bindings.java.migration.m420f6b67;

binding jdbcCredentialAttributeExposure250 {
  query pattern presenceNode where node.scope == "function" and node.token contains "function_name:connect" and node.token contains "call:tokenizeDatabase" and node.token contains "call:tokenizeURLProperties" and node.token contains "call:NetConnection" and not (node.scopeCall.any contains "appendDatabaseAttributes")
  emit issue code.JdbcCredentialAttributeExposure at node
}
