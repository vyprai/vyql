module bindings.java.migration.m420f6b67;

binding xmlHardening293 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "setProperty" and node.token contains "SUPPORT_DTD" and not (node.token contains "true")
  emit check core.XmlHardening at node {
    advisory: true
  }
}
