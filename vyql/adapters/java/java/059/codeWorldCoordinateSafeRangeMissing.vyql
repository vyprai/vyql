module bindings.java.migration.m420f6b67;

binding worldCoordinateSafeRangeMissing59 {
  query pattern presenceNode where node.scope == "function" and node.token contains "param_type:BlockVector3" and containsAny(node.token, ["call:getBlockAt", "call:setBlock", "call:getBlock", "call:getFullBlock", "call:getBiome", "call:setBiome", "call:generateTree", "call:canPlaceAt", "call:applySideEffects", "call:simulateItemUse", "call:checkLoadedChunk"]) and not (containsAny(node.scopeCall.any, [testCoords, checkCoords, validateCoords])) and not (node.token contains "literal:30000000")
  emit issue code.WorldCoordinateSafeRangeMissing at node
}
