module bindings.java.migration.m420f6b67;

binding internalContentExposureReview332 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "call:setContent" and node.token contains "call:toJson" and node.token contains "call:saveDocument" and not (node.scopeCall.any contains "setHidden")
  emit issue code.InternalContentExposureReview at node
}
