module bindings.java.migration.m420f6b67;

binding xmlHardening295 {
  query pattern callExpr where callee.path ~= "setXIncludeAware" and args.any.literal contains "false"
  emit check core.XmlHardening at call {
    advisory: true
    covers sameReceiver {
      anchor: callee.receiver
    }
  }
}
