module bindings.java.migration.m420f6b67;

binding jenkinsPlaintextDataboundCredential248 {
  query pattern presenceNode where node.scope == "function" and node.token contains "function_name:configure" and node.token contains "call_path:formData.getString" and node.token contains "call_path:save" and containsAny(node.token, ["identifier:privateToken", "identifier:apiToken", "identifier:accessToken", "identifier:secret", "identifier:password", "identifier:credential"]) and containsAny(node.token, ["literal:privateToken", "literal:apiToken", "literal:accessToken", "literal:secret", "literal:password", "literal:credential"]) and not (node.token contains "call_path:Secret.fromString")
  emit issue code.JenkinsPlaintextDataboundCredential at node
}
