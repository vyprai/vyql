module bindings.java.migration.m420f6b67;

binding tempFileDirectoryCreationRace329 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "call_path:File.createTempFile" and node.token contains "call_path:delete" and containsAny(node.token, ["call_path:mkdir", "call_path:mkdirs"]) and not (node.token contains "call_path:Files.createTempDirectory")
  emit issue code.TempFileDirectoryCreationRace at node
}
