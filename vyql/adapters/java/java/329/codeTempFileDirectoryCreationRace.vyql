module bindings.java.migration.m420f6b67;

binding tempFileDirectoryCreationRace329 {
  query pattern presenceNode where node.scope == "function" and node.token contains "call_path:File.createTempFile" and node.token contains "call_path:delete" and containsAny(node.token, ["call_path:mkdir", "call_path:mkdirs"]) and not (node.token contains "call_path:Files.createTempDirectory")
  emit issue code.TempFileDirectoryCreationRace at node
}
