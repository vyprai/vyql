module bindings.java.migration.m420f6b67;

binding tempFileDirectoryCreationRace329 {
  query pattern presenceNode where node.scope == "function" and node.context.callPath contains "File.createTempFile" and node.context.callPath contains "delete" and containsAny(node.context.callPath, ["mkdir", "mkdirs"]) and not (node.context.callPath contains "Files.createTempDirectory")
  emit issue code.TempFileDirectoryCreationRace at node
}
