module bindings.java.migration.m420f6b67;

binding jenkinsPluginForkedDirectoryBrowserWithoutCsp91 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path == "DirectoryBrowserSupport" and node.token contains "Compare Html Report" and node.token contains "graph.gif"
  emit issue code.JenkinsPluginForkedDirectoryBrowserWithoutCsp at node
}
