binding unescapedDiagnosticHtml85 {
  query pattern presenceNode where node.scope == "function" and node.context.callPath contains "IOUtils.toString" and node.context.literal contains "text/html" and node.context.callPath contains "Fault" and not (node.context.callPath contains "MessageUtils.isRequestor") and not (node.context.callPath contains "StringEscapeUtils.escapeHtml") and not (node.context.callPath contains "HtmlUtils.htmlEscape")
