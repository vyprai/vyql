binding jenkinsRemoteValidationMissingPermission228 {
  query pattern presenceNode where node.scope == "function" and node.token contains "function_name:doTestConnection" and node.token contains "call:testConnection" and not (node.scopeCall.any contains "checkPermission") and not (node.scopeCall.any contains "hasPermission")
  emit issue code.JenkinsRemoteValidationMissingPermission at node
