binding jenkinsRemoteValidationMissingPermission226 {
  query pattern presenceNode where node.scope == "function" and node.token contains "function_name:doTestDynatraceConnection" and node.token contains "annotation:RequirePOST" and node.token contains "call:DynatraceClient" and node.token contains "call:getSystemProfiles" and not (node.scopeCall.any contains "checkPermission") and not (node.scopeCall.any contains "hasPermission")
