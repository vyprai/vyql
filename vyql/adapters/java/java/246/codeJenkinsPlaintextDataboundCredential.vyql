module bindings.java.migration.m420f6b67;

binding jenkinsPlaintextDataboundCredential246 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "@DataBoundConstructor" and node.token contains "StringrepoPassword" and node.token contains "this.repoPassword=repoPassword;" and not (node.token contains "Secret.fromString(repoPassword)") and not (node.token contains "SecretrepoPassword")
  emit issue code.JenkinsPlaintextDataboundCredential at node
}
