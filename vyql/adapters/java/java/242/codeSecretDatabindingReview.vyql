module bindings.java.migration.m420f6b67;

binding secretDatabindingReview242 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "function_name:setAkid" and not (node.scopeCall.any contains "fromString")
