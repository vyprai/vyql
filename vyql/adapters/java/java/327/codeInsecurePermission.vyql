module bindings.java.migration.m420f6b67;

binding insecurePermission327 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "function_name:createTempFile" and node.token contains "call_path:File.createTempFile" and not (node.token contains "call_path:setWritable") and not (node.token contains "call_path:Files.setPosixFilePermissions")
  emit issue code.InsecurePermission at node
}
