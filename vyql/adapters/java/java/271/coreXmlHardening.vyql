module bindings.java.migration.m420f6b67;

binding xmlHardening271 {
  query pattern callExpr where callee.path ~= "setFeature" and args.any.literal contains "external-general-entities" and not args.any.literal contains "true"
  emit check core.XmlHardening at call {
    covers path {
      from: call
      to: call
    }
  }
}
