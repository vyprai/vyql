module bindings.java.migration.m420f6b67;

binding authorizationCheck211 {
  query pattern callExpr where callee.path ~= "analysis.function.context" and args.any.literal contains "call:canFlush" and args.any.literal contains "call:ThriftSecurityException"
  emit check core.AuthorizationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}
