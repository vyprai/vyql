binding embeddedDotSegmentFilenameWrite236 {
  query pattern presenceNode where node.scope == "function" and containsAny(node.token, ["call_path:getFilename", "call_path:getOriginalFilename"]) and containsAny(node.token, ["call_path:Files.copy", "call_path:Files.write", "call_path:FileUtils.copyInputStreamToFile", "call_path:MultipartFile.transferTo"]) and containsAny(node.token, ["call_path:createTempFile", "call_path:resolve", "call_path:new File"]) and containsAny(node.token, ["call_path:getCanonicalPath", "call_path:normalize", "call_path:toRealPath"]) and containsAny(node.token, ["call_arg:filename.equals:..", "call_arg:fileName.equals:.."]) and not (containsAny(node.token, ["call_arg:filename.contains:..", "call_arg:fileName.contains:.."]))
  emit issue code.EmbeddedDotSegmentFilenameWrite at node
}
