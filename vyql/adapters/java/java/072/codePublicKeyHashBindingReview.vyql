module bindings.java.migration.m420f6b67;

binding publicKeyHashBindingReview72 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "function_name:correctlySpends" and node.token contains "call:fromPublicOnly" and node.token contains "call:verify" and node.token contains "hashFor" and not (node.scopeCall.any contains "sha256hash160")
  emit issue code.PublicKeyHashBindingReview at node
}
