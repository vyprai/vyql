module bindings.java.migration.m420f6b67;

binding protocolStateReview333 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "call:getType" and node.token contains "selector:FEDERATION_DOWNSTREAM_CONNECT" and node.token contains "call:deploy" and not (node.scopeCall.any contains "getSubject")
  emit issue code.ProtocolStateReview at node
}
