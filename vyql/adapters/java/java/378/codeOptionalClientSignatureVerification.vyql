module bindings.java.migration.m420f6b67;

binding optionalClientSignatureVerification378 {
  query pattern presenceNode where node.scope == "function" and containsAny(node.token, ["function_name:authenticate", "function_name:verify", "function_name:validate", "function_name:check"]) and node.context.call contains "getSignature" and node.context.callPath contains "Signature.getInstance" and node.context.call contains "initVerify" and node.context.call contains "verify" and containsAny(node.token, ["expr:signature!=null", "expr:sigBytes!=null", "expr:clientSignature!=null"]) and not (containsAny(node.token, ["expr:signature==null", "expr:sigBytes==null", "expr:clientSignature==null"])) and not (node.context.literal contains "Client signature required") and not (node.context.literal contains "signature required") and not (node.context.literal contains "missing signature")
  emit issue code.OptionalClientSignatureVerification at node
}
