module bindings.java.migration.m420f6b67;

binding premasterSecretLengthReview63 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "function_name:safeDecryptPreMasterSecret" and node.token contains "call:doFinal" and node.token contains "call:createSecret" and node.token contains "M[0]" and not (node.token contains "expr:m.length==48")
  emit issue code.PremasterSecretLengthReview at node
}
