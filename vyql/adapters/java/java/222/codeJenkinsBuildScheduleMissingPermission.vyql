binding jenkinsBuildScheduleMissingPermission222 {
  query pattern presenceNode where node.scope == "function" and node.context.functionName contains "doBuild" and node.context.callPath contains "Jenkins.get.getQueue.schedule" and node.context.identifier contains "project" and not (node.scopeCall.any contains "hasPermission") and not (node.scopeCall.any contains "checkPermission") and not (node.context.selector contains "Item.BUILD")
