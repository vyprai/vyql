binding jenkinsBuildScheduleMissingPermission222 {
  query pattern presenceNode where node.scope == "function" and node.token contains "function_name:doBuild" and node.token contains "call_path:Jenkins.get.getQueue.schedule" and node.token contains "identifier:project" and not (node.scopeCall.any contains "hasPermission") and not (node.scopeCall.any contains "checkPermission") and not (node.token contains "selector:Item.BUILD")
