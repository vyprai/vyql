module bindings.java.migration.m420f6b67;

binding ldapCrlCredentialReuse74 {
  query pattern presenceNode where node.scope == "function" and node.token contains "function_name:prepareConnectionFactory" and node.token contains "call_path:ConnectionConfig.copy" and node.token contains "call_path:cc.setLdapUrl" and node.token contains "call:DefaultConnectionFactory" and not (node.token contains "call_path:cc.setConnectionInitializers")
  emit issue code.LdapCrlCredentialReuse at node
}
