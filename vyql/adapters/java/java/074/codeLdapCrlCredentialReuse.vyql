binding ldapCrlCredentialReuse74 {
  query pattern presenceNode where node.scope == "function" and node.context.functionName contains "prepareConnectionFactory" and node.context.callPath contains "ConnectionConfig.copy" and node.context.callPath contains "cc.setLdapUrl" and node.context.call contains "DefaultConnectionFactory" and not (node.context.callPath contains "cc.setConnectionInitializers")
