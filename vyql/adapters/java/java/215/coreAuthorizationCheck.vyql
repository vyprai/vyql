module bindings.java.migration.m420f6b67;

binding authorizationCheck215 {
  query pattern callExpr where callee.analysis ~= "function.context" and args.any.context.call contains "canObtainDelegationToken" and args.any.context.call contains "ThriftSecurityException"
  emit check core.AuthorizationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}
