module bindings.java.migration.m420f6b67;

binding missingSessionRotationAfterAuthentication70 {
  query pattern presenceNode where node.scope == "function" and containsAny(node.token, ["function_name:doFinishLogin", "function_name:finishLogin", "function_name:doLogin", "function_name:login"]) and node.context.call contains "setAuthentication" and not (node.scopeCall.any contains "invalidate")
  emit issue code.MissingSessionRotationAfterAuthentication at node
}
