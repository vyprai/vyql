binding missingSessionRotationAfterAuthentication70 {
  query pattern presenceNode where node.scope == "function" and containsAny(node.context.functionName, ["doFinishLogin", "finishLogin", "doLogin", "login"]) and node.context.call contains "setAuthentication" and not (node.scopeCall.any contains "invalidate")
  emit issue code.MissingSessionRotationAfterAuthentication at node
}
