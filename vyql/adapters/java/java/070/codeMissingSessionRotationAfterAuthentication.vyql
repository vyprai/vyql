module bindings.java.migration.m420f6b67;

binding missingSessionRotationAfterAuthentication70 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and containsAny(node.token, ["function_name:doFinishLogin", "function_name:finishLogin", "function_name:doLogin", "function_name:login"]) and node.token contains "call:setAuthentication" and not (node.scopeCall.any contains "invalidate")
  emit issue code.MissingSessionRotationAfterAuthentication at node
}
