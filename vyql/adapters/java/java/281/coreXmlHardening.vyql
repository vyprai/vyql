module bindings.java.migration.m420f6b67;

binding xmlHardening281 {
  query pattern callExpr where callee.path ~= "setProperty" and args.any.literal contains "SUPPORT_DTD" and not args.any.literal contains "true"
  emit check core.XmlHardening at call {
    covers sameReceiver {
      anchor: callee.receiver
    }
  }
}
