module bindings.java.migration.m420f6b67;

binding xmlHardening272 {
  query pattern callExpr where callee.path ~= "setFeature" and args.any.literal contains "FEATURE_SECURE_PROCESSING" and args.any.literal contains "true"
  emit check core.XmlHardening at call {
    covers sameReceiver {
      anchor: callee.receiver
    }
  }
}
