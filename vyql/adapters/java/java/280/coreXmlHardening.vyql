module bindings.java.generated.m420f6b67;

binding xmlHardening280 {
  query pattern callExpr where callee.path ~= "setProperty" and args.any.literal contains "IS_SUPPORTING_EXTERNAL_ENTITIES" and not args.any.literal contains "true"
  emit check core.XmlHardening at call {
    covers sameReceiver {
      anchor: callee.receiver
    }
  }
}
