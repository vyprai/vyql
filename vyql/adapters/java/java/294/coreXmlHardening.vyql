module bindings.java.migration.m420f6b67;

binding xmlHardening294 {
  query pattern callExpr where callee.path ~= "setProperty" and args.any.literal contains "ACCESS_EXTERNAL_DTD"
  emit check core.XmlHardening at call {
    advisory: true
    covers path {
      from: call
      to: call
    }
  }
}
