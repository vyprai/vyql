module bindings.java.migration.m420f6b67;

binding secretComparisonReview375 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "function_name:doIndex" and node.token contains "call:getReloadTokenProperty" and node.token contains "call:getRequestToken" and node.token contains "call_path:token.equals" and not (node.token contains "call_path:MessageDigest.isEqual")
  emit issue code.SecretComparisonReview at node
}
