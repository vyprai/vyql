binding secretComparisonReview375 {
  query pattern presenceNode where node.scope == "function" and node.token contains "function_name:doIndex" and node.token contains "call:getReloadTokenProperty" and node.token contains "call:getRequestToken" and node.token contains "call_path:token.equals" and not (node.token contains "call_path:MessageDigest.isEqual")
