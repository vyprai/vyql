// rust framework adapter (docs/07) — framework→concept content.
// scoped paths (std::env::var) normalize to dotted (std.env.var) and match by
// substring/suffix; format!/+ build tainted strings.
adapter rust {
  meta { match: contains, fidelity: resolved }

  // untrusted input
  source "env.var" -> code.EnvVariable
  source "env.vars" -> code.EnvVariable
  source "env.args" -> code.CliArgument
  source path "analysis.parameter.entry" val "attr_name:get" -> code.HttpInput
  source path "analysis.parameter.entry" val "attr_name:post" -> code.HttpInput
  source path "analysis.parameter.entry" val "attr_name:put" -> code.HttpInput
  source path "analysis.parameter.entry" val "attr_name:delete" -> code.HttpInput
  source path "analysis.parameter.entry" val "attr_name:patch" -> code.HttpInput
  source path "analysis.parameter.entry" val "attr_name:head" -> code.HttpInput
  source path "analysis.parameter.entry" val "attr_name:route" -> code.HttpInput
  source path "analysis.parameter.entry" val "attr_name:handler" -> code.HttpInput

  // command execution — Command::new(prog) + .arg(x)/.args(x)
  sink path "Command.new" -> code.CommandExecution
  sink method "arg" -> code.CommandExecution
  sink method "args" -> code.CommandExecution
  flag code.TemplateInstallScriptHostExecution in function {
    lang "rust"
    has "installScript"
    has "final_script"
    lacks "spawn_installer_container"
  }
  flag code.UnsafeMutableAlias in function {
    lang "rust"
    has "&mut"
    has "as *const"
    has "as *mut"
  }
  flag code.FfiEnumLayoutRisk on any {
    path exact "analysis.rust.enum"
    token kind "enum"
    token repr "C"
  }
  flag code.UnsafeAutoTraitImpl on any {
    path exact "analysis.rust.unsafe_impl"
    trait "Send"
    not bound "Send"
  }
  flag code.UnsafeAutoTraitImpl on any {
    path exact "analysis.rust.unsafe_impl"
    trait "Sync"
    not bound "Sync"
    not bound "Send"
  }
  flag code.UncheckedFfiLengthNarrowing in function {
    lang "rust"
    has "avail_in=input.len()asc_uint"
    has "avail_out=output.len()asc_uint"
    has "BZ2_bz"
    lacks ".min(c_uint::MAXasusize)asc_uint"
  }
  flag code.UninitializedBufferExposure in function {
    lang "rust"
    has "with_capacity"
    has "as_mut_ptr"
    has "from_raw_parts_mut"
    has "read_exact"
    has "set_len"
  }
  flag code.UninitializedBufferExposure in function {
    lang "rust"
    has "Vec::with_capacity"
    has "set_len"
    has "read_exact(&mut"
    lacks "resize"
  }
  flag code.UninitializedBufferExposure in function {
    lang "rust"
    has "as_mut_ptr"
    has "from_raw_parts_mut"
    has ".read("
    has "set_len"
  }
  flag code.UninitializedBufferExposure on any {
    path exact "analysis.rust.uninitialized"
  }
  flag code.ClaxonResidualPartitionBufferExposure in function {
    lang "rust"
    name "decode_residual"
    has "letn_partitions=1u32<<order;"
    has "letn_samples=block_size>>order;"
    has "letmutlen=n_samples-n_warm_up;"
    has "buffer[start..start+lenasusize]"
    has "decode_rice_partition(input,slice)"
    has "decode_rice2_partition(input,slice)"
    lacks "block_size&(n_partitions-1)asu16!=0"
    lacks "n_samples_per_partition"
  }
  flag code.UnboundedResourceOperation in function {
    lang "rust"
    has ".next().await"
    lacks "timeout"
  }
  flag code.ConduitHyperUnboundedBodyToBytes in function {
    lang "rust"
    name "blocking_handler"
    has "request.into_parts()"
    has "hyper::body::to_bytes(body).await?"
    has "Request::from_parts(parts, full_body)"
    lacks "check_content_length"
    lacks "size_hint"
  }
  flag code.CookieMaxAgeDurationSecondsPanic in function {
    lang "rust"
    name "parse_inner"
    has "\"max-age\",Some(v)"
    has "v.parse()"
    has "Duration::seconds(val)"
    lacks "Duration::max_value().num_seconds()"
    lacks "cmp::min"
  }
  flag code.CallFutureRawWeakStateRef in function {
    lang "rust"
    name "poll"
    has "letstate_ptr=Weak::into_raw(Arc::downgrade(&self_ref.state));letmutstate=self_ref.state.write().unwrap();"
    has "state.waker.is_none()"
    has "ic0::call_new"
  }
  flag code.WindowsReservedDeviceNameBypass in function {
    lang "rust"
    has "path.file_stem()"
    has "stemstr.to_uppercase().as_str()"
    has "\"COM0\""
    has "\"COM9\""
    has "manually::open"
    lacks "\"COM¹\""
  }
  flag code.WindowsReservedDeviceNameBypass in function {
    lang "rust"
    has "path.file_stem()"
    has "stemstr.to_uppercase().as_str()"
    has "\"LPT0\""
    has "\"LPT9\""
    has "manually::open"
    lacks "\"LPT¹\""
  }
  flag code.ArchiveMarkerSymlinkOverwrite in function {
    lang "rust"
    has "PACKAGE_SOURCE_LOCK"
    has "entry.unpack_in(parent)"
    has "OpenOptions::new().create(true)"
    has "write!(ok,\"ok\")"
    lacks "entry_path.file_name()"
    lacks "create_new(true)"
  }
  flag code.StateMutationBeforeOperationPreconditions in function {
    lang "rust"
    name "apply_smart_op_tx"
    has "self.ensure_smart_account_at_round(&tx.from,current_round);"
    has "self.debit(&tx.from,tx.fee)?;"
    has "self.increment_nonce(&tx.from);"
    has "SmartOpType::Stake{amount}=>{"
    has "returnErr(CoinError::ValidationError(\"belowminimumstake\".into()))"
    has "ok_or_else(||CoinError::ValidationError(\"nostaketounstake\".into()))?"
    lacks "tx.fee.saturating_add(*amount)"
  }
  flag code.PeerLimitUnderflow in function {
    lang "rust"
    name "poll"
    has "DiscoveryMessage::Handshake"
    has "self.peer_list_limit = Some(limit);"
    has "self.peer_list_limit.unwrap() as usize - 1"
    has "self.get_peer_contacts("
    lacks ".saturating_sub(1)"
    lacks ".min(self.config.update_limit)"
  }
  flag code.RegexLineCommentStripWithoutCharWhitelist in function {
    lang "rust"
    name "strip_comments"
    has "Regex::new"
    has "(?m)//.*$"
    has "replace_all"
    lacks "verify_string"
    lacks "is_permitted_char"
    lacks "strip_comments_and_verify"
  }
  flag code.CryptoMissingOptimizationBarrier in function {
    lang "rust"
    name "sub"
    has "underflow_mask=((borrow>>63)^1).wrapping_sub(1)"
    has "constants::L[i]&underflow_mask"
    lacks "read_volatile"
    lacks "black_box(underflow_mask)"
  }
  flag code.Luks2AttachedHeaderActivation in function {
    lang "rust"
    name "mount_data_disk"
    has "cryptsetupluksOpen--typeluks2-d-$root_hd$name"
    lacks "open_encrypted_volume"
    lacks "--header"
    lacks "luksHeaderBackup"
    lacks "validate_luks2_headers"
  }

  // SSRF — HTTP clients (reqwest / ureq / surf); the URL is the call argument
  sink path "reqwest.get" -> code.UrlFetch
  sink path "reqwest.post" -> code.UrlFetch
  sink path "reqwest.Client.get" -> code.UrlFetch
  sink path "reqwest.Client.post" -> code.UrlFetch
  sink path "ureq.get" -> code.UrlFetch
  sink path "ureq.post" -> code.UrlFetch
  sink path "ureq.request" -> code.UrlFetch
  sink path "surf.get" -> code.UrlFetch
  sink path "surf.post" -> code.UrlFetch
  flag code.IncompleteIpDenylist in function {
    lang "rust"
    has "is_private"
    has "is_loopback"
    has "is_link_local"
    has "is_multicast"
    has "is_documentation"
    lacks "is_unspecified"
  }
  flag code.IncompleteIpDenylist in function {
    lang "rust"
    has "is_private"
    has "is_loopback"
    has "is_link_local"
    has "is_multicast"
    has "is_documentation"
    lacks "is_broadcast"
  }
  flag code.CleartextChannel on any {
    path "reqwest.get"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "reqwest.post"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "reqwest.Client.get"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "reqwest.Client.post"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "ureq.get"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "ureq.post"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "ureq.request"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "surf.get"
    has "http://"
    lacks "127.0"
  }
  flag code.CleartextChannel on any {
    path "surf.post"
    has "http://"
    lacks "127.0"
  }

  // regex compile (ReDoS) — tainted PATTERN
  sink path "Regex.new" -> code.RegexCompile
  sink path "RegexBuilder.new" -> code.RegexCompile

  // XSS — maud PreEscaped bypasses HTML escaping; response body writers render
  // the tainted string into the HTML response (the body is the call argument).
  sink path "maud.PreEscaped" -> code.HtmlRender
  sink path "PreEscaped" -> code.HtmlRender
  sink method "render_html" -> code.HtmlRender
  sink method "body" -> code.HtmlRender
  sink method "html" -> code.HtmlRender

  // weak crypto (CWE-327) — broken hash/cipher crates (presence)
  flag code.WeakHash on any {
    path "md5.compute"
  }
  flag code.WeakHash on any {
    path "Md5.new"
  }
  flag code.WeakHash on any {
    path "Sha1.new"
  }
  flag code.WeakHash on any {
    path "sha1.Sha1"
  }
  flag code.WeakCipher on any {
    path "Des.new"
  }
  flag code.WeakCipher on any {
    path "Rc4.new"
  }
  flag code.StaticIv on any {
    path "new_from_slices"
    has "0000000000000000"
  }

  // LDAP (CWE-90) — the search FILTER is arg1 (base is arg0)
  sink method "search" arg 1 -> code.LdapQuery
  // XPath (CWE-643) — the expression is arg0
  sink method "evaluate" arg 0 -> code.XpathQuery
  // trust boundary (CWE-501) — untrusted data written into the session map
  sink method "insert" arg all -> code.TrustBoundary
  sink method "set_attribute" arg all -> code.TrustBoundary

  // insecure cookie (CWE-614) — Cookie configured insecurely
  flag code.InsecureCookie on any {
    path "set_secure"
    has "false"
  }
  flag code.InsecureCookie on any {
    path "set_http_only"
    has "false"
  }
  flag code.PermissiveCors on any {
    path exact "CorsLayer.new.allow_origin.allow_methods.allow_headers"
    has "Any"
  }

  // insecure randomness (CWE-330) — non-CSPRNG. `OsRng` is the secure form and
  // its path does NOT start with these tokens, so the safe case carries no mark.
  flag code.WeakRandomValue on any {
    path "rand.random"
  }
  flag code.WeakRandomValue on any {
    path "rand.thread_rng"
  }
  flag code.WeakRandomValue on any {
    path "thread_rng"
  }
  flag code.WeakRandomValue on any {
    path "StdRng.seed_from_u64"
  }

  // controls (sanitizers) — neutralize a flow
  control "shell_escape.escape" -> core.ShellEscape
  control "html_escape.encode_text" -> core.HtmlEscape
  control "html_escape.encode_safe" -> core.HtmlEscape
  control "htmlescape.encode_minimal" -> core.HtmlEscape
  control "ammonia.clean" -> core.HtmlEscape
  // sanitizers/validators defined in each generated case's preamble
  control "escape_html" -> core.HtmlEscape
  control "escape_xpath" -> core.XpathEscape
  control "encode_for_ldap" -> core.LdapEscape
  control "escape_shell" -> core.ShellEscape
  control "safe_path" -> core.PathCanonicalization
  control "validate_role" -> core.InputValidation

  // SQL
  sink path "sqlx.query" -> code.SqlExecution
  sink method "query" -> code.SqlExecution
  sink method "query_as" -> code.SqlExecution
  sink method "sql_query" -> code.SqlExecution
  sink method "execute" -> code.SqlExecution

  // path / file
  sink path "File.open" -> code.FilePathAccess
  sink path "File.create" -> code.FilePathAccess
  sink path "fs.read" -> code.FilePathAccess
  sink path "fs.read_to_string" -> code.FilePathAccess
  sink path "fs.write" -> code.FilePathAccess
  sink path "fs.remove_file" -> code.FilePathAccess
  sink method "read_to_string" -> code.FilePathAccess
  sink method "extract_entry" -> code.ArchiveEntryWrite
  sink method "extract" -> code.ArchiveEntryWrite

  // deserialization
  sink path "serde_json.from_str" -> code.Deserialization
  sink path "serde_yaml.from_str" -> code.Deserialization
  flag code.UncheckedDecodeResult on any {
    path exact "b62_decode.expect"
  }
  sink method "find_by_id" -> code.ObjectLookupByUserInput
  sink method "get_user" -> code.ObjectLookupByUserInput
  sink method "get_account" -> code.ObjectLookupByUserInput
  flag code.AuthenticationRequiredOp on any {
    path "change_password"
  }
  flag code.AuthenticationRequiredOp on any {
    path "update_password"
  }
  flag code.AuthenticationRequiredOp on any {
    path "reset_password"
  }
  flag code.AuthenticationRequiredOp on any {
    path "change_email"
  }
  flag code.AuthenticationRequiredOp on any {
    path "transfer_funds"
  }
  flag code.AuthenticationRequiredOp on any {
    path "delete_account"
  }
  flag code.AuthenticationRequiredOp on any {
    path "grant_role"
  }
  flag code.AuthenticationRequiredOp on any {
    path "make_admin"
  }
  flag code.CertValidationDisabled on any {
    path "danger_accept_invalid_certs"
    has "true"
  }
  flag code.InsecurePermission on any {
    method "mode"
    has "0o777"
  }
  flag code.InsecurePermission on any {
    method "mode"
    has "0o666"
  }
  flag code.InsecurePermission on any {
    path "Permissions.from_mode"
    has "0o777"
  }
  flag code.InsecurePermission on any {
    path "Permissions.from_mode"
    has "0o666"
  }
  flag code.InsecurePermission on any {
    path "platform_lib.mode_t.from"
    has "S_IRWXO"
  }
  flag code.SecretConfigFilePermissionMissing in function {
    lang "rust"
    has "config_dest.push(\"ignition\");"
    has "config_dest.push(\"config.ign\");"
    has "create_dir_all(&config_dest)"
    has "OpenOptions::new()"
    has ".create_new(true)"
    has "copy(&mutconfig_in,&mutconfig_out)"
    lacks "set_permissions"
    lacks "Permissions::from_mode"
    lacks ".chmod("
    lacks ".set_mode("
  }
  flag code.InsecureTempFile on any {
    path "File.create"
    has "/tmp/"
  }
  flag code.IndexAccess on any {
    path "__subscript"
  }
  flag code.NullableDeref on any {
    path "__unary.deref"
  }
  control "require_auth" -> core.AuthenticationCheck
  control "ensure_authenticated" -> core.AuthenticationCheck
  control "check_ownership" -> core.OwnershipCheck
  control "require_owner" -> core.OwnershipCheck
}
