// rust framework adapter (docs/07) — framework→concept content.
// scoped paths (std::env::var) normalize to dotted (std.env.var) and match by
// substring/suffix; format!/+ build tainted strings.
adapter rust {
  meta { match: contains, fidelity: resolved }

  // untrusted input
  source "env.var" -> code.EnvVariable
  source "env.vars" -> code.EnvVariable
  source "env.args" -> code.CliArgument
  source path "analysis.parameter.entry" val "attr_name:get" -> code.HttpInput
  source path "analysis.parameter.entry" val "attr_name:post" -> code.HttpInput
  source path "analysis.parameter.entry" val "attr_name:put" -> code.HttpInput
  source path "analysis.parameter.entry" val "attr_name:delete" -> code.HttpInput
  source path "analysis.parameter.entry" val "attr_name:patch" -> code.HttpInput
  source path "analysis.parameter.entry" val "attr_name:head" -> code.HttpInput
  source path "analysis.parameter.entry" val "attr_name:route" -> code.HttpInput
  source path "analysis.parameter.entry" val "attr_name:handler" -> code.HttpInput

  // command execution — Command::new(prog) + .arg(x)/.args(x)
  sink path "Command.new" -> code.CommandExecution
  sink method "arg" -> code.CommandExecution
  sink method "args" -> code.CommandExecution
  mark exact "analysis.function.context" val "lang=rust" val "installScript" val "final_script" nval "spawn_installer_container" -> code.TemplateInstallScriptHostExecution
  mark exact "analysis.function.context" val "lang=rust" val "&mut" val "as *const" val "as *mut" -> code.UnsafeMutableAlias
  mark exact "analysis.rust.enum" val "kind:enum" val "repr:C" -> code.FfiEnumLayoutRisk
  mark exact "analysis.rust.unsafe_impl" val "trait:Send" nval "bound:Send" -> code.UnsafeAutoTraitImpl
  mark exact "analysis.rust.unsafe_impl" val "trait:Sync" nval "bound:Sync" nval "bound:Send" -> code.UnsafeAutoTraitImpl
  mark exact "analysis.function.context" val "lang=rust" val "avail_in=input.len()asc_uint" val "avail_out=output.len()asc_uint" val "BZ2_bz" nval ".min(c_uint::MAXasusize)asc_uint" -> code.UncheckedFfiLengthNarrowing
  mark exact "analysis.function.context" val "lang=rust" val "with_capacity" val "as_mut_ptr" val "from_raw_parts_mut" val "read_exact" val "set_len" -> code.UninitializedBufferExposure
  mark exact "analysis.function.context" val "lang=rust" val "Vec::with_capacity" val "set_len" val "read_exact(&mut" nval "resize" -> code.UninitializedBufferExposure
  mark exact "analysis.function.context" val "lang=rust" val "as_mut_ptr" val "from_raw_parts_mut" val ".read(" val "set_len" -> code.UninitializedBufferExposure
  mark exact "analysis.rust.uninitialized" -> code.UninitializedBufferExposure
  mark exact "analysis.function.context" val "lang=rust" val "name=decode_residual" val "letn_partitions=1u32<<order;" val "letn_samples=block_size>>order;" val "letmutlen=n_samples-n_warm_up;" val "buffer[start..start+lenasusize]" val "decode_rice_partition(input,slice)" val "decode_rice2_partition(input,slice)" nval "block_size&(n_partitions-1)asu16!=0" nval "n_samples_per_partition" -> code.ClaxonResidualPartitionBufferExposure
  mark exact "analysis.function.context" val "lang=rust" val ".next().await" nval "timeout" -> code.UnboundedResourceOperation
  mark exact "analysis.function.context" val "lang=rust" val "name=blocking_handler" val "request.into_parts()" val "hyper::body::to_bytes(body).await?" val "Request::from_parts(parts, full_body)" nval "check_content_length" nval "size_hint" -> code.ConduitHyperUnboundedBodyToBytes
  mark exact "analysis.function.context" val "lang=rust" val "name=parse_inner" val "\"max-age\",Some(v)" val "v.parse()" val "Duration::seconds(val)" nval "Duration::max_value().num_seconds()" nval "cmp::min" -> code.CookieMaxAgeDurationSecondsPanic
  mark exact "analysis.function.context" val "lang=rust" val "name=poll" val "letstate_ptr=Weak::into_raw(Arc::downgrade(&self_ref.state));letmutstate=self_ref.state.write().unwrap();" val "state.waker.is_none()" val "ic0::call_new" -> code.CallFutureRawWeakStateRef
  mark exact "analysis.function.context" val "lang=rust" val "path.file_stem()" val "stemstr.to_uppercase().as_str()" val "\"COM0\"" val "\"COM9\"" val "manually::open" nval "\"COM¹\"" -> code.WindowsReservedDeviceNameBypass
  mark exact "analysis.function.context" val "lang=rust" val "path.file_stem()" val "stemstr.to_uppercase().as_str()" val "\"LPT0\"" val "\"LPT9\"" val "manually::open" nval "\"LPT¹\"" -> code.WindowsReservedDeviceNameBypass
  mark exact "analysis.function.context" val "lang=rust" val "PACKAGE_SOURCE_LOCK" val "entry.unpack_in(parent)" val "OpenOptions::new().create(true)" val "write!(ok,\"ok\")" nval "entry_path.file_name()" nval "create_new(true)" -> code.ArchiveMarkerSymlinkOverwrite
  mark exact "analysis.function.context" val "lang=rust" val "name=apply_smart_op_tx" val "self.ensure_smart_account_at_round(&tx.from,current_round);" val "self.debit(&tx.from,tx.fee)?;" val "self.increment_nonce(&tx.from);" val "SmartOpType::Stake{amount}=>{" val "returnErr(CoinError::ValidationError(\"belowminimumstake\".into()))" val "ok_or_else(||CoinError::ValidationError(\"nostaketounstake\".into()))?" nval "tx.fee.saturating_add(*amount)" -> code.StateMutationBeforeOperationPreconditions
  mark exact "analysis.function.context" val "lang=rust" val "name=poll" val "DiscoveryMessage::Handshake" val "self.peer_list_limit = Some(limit);" val "self.peer_list_limit.unwrap() as usize - 1" val "self.get_peer_contacts(" nval ".saturating_sub(1)" nval ".min(self.config.update_limit)" -> code.PeerLimitUnderflow

  // SSRF — HTTP clients (reqwest / ureq / surf); the URL is the call argument
  sink path "reqwest.get" -> code.UrlFetch
  sink path "reqwest.post" -> code.UrlFetch
  sink path "reqwest.Client.get" -> code.UrlFetch
  sink path "reqwest.Client.post" -> code.UrlFetch
  sink path "ureq.get" -> code.UrlFetch
  sink path "ureq.post" -> code.UrlFetch
  sink path "ureq.request" -> code.UrlFetch
  sink path "surf.get" -> code.UrlFetch
  sink path "surf.post" -> code.UrlFetch
  mark exact "analysis.function.context" val "lang=rust" val "is_private" val "is_loopback" val "is_link_local" val "is_multicast" val "is_documentation" nval "is_unspecified" -> code.IncompleteIpDenylist
  mark exact "analysis.function.context" val "lang=rust" val "is_private" val "is_loopback" val "is_link_local" val "is_multicast" val "is_documentation" nval "is_broadcast" -> code.IncompleteIpDenylist
  mark "reqwest.get" val "http://" nval "127.0" -> code.CleartextChannel
  mark "reqwest.post" val "http://" nval "127.0" -> code.CleartextChannel
  mark "reqwest.Client.get" val "http://" nval "127.0" -> code.CleartextChannel
  mark "reqwest.Client.post" val "http://" nval "127.0" -> code.CleartextChannel
  mark "ureq.get" val "http://" nval "127.0" -> code.CleartextChannel
  mark "ureq.post" val "http://" nval "127.0" -> code.CleartextChannel
  mark "ureq.request" val "http://" nval "127.0" -> code.CleartextChannel
  mark "surf.get" val "http://" nval "127.0" -> code.CleartextChannel
  mark "surf.post" val "http://" nval "127.0" -> code.CleartextChannel

  // regex compile (ReDoS) — tainted PATTERN
  sink path "Regex.new" -> code.RegexCompile
  sink path "RegexBuilder.new" -> code.RegexCompile

  // XSS — maud PreEscaped bypasses HTML escaping; response body writers render
  // the tainted string into the HTML response (the body is the call argument).
  sink path "maud.PreEscaped" -> code.HtmlRender
  sink path "PreEscaped" -> code.HtmlRender
  sink method "render_html" -> code.HtmlRender
  sink method "body" -> code.HtmlRender
  sink method "html" -> code.HtmlRender

  // weak crypto (CWE-327) — broken hash/cipher crates (presence)
  mark "md5.compute" -> code.WeakHash
  mark "Md5.new" -> code.WeakHash
  mark "Sha1.new" -> code.WeakHash
  mark "sha1.Sha1" -> code.WeakHash
  mark "Des.new" -> code.WeakCipher
  mark "Rc4.new" -> code.WeakCipher
  mark "new_from_slices" val "0000000000000000" -> code.StaticIv

  // LDAP (CWE-90) — the search FILTER is arg1 (base is arg0)
  sink method "search" arg 1 -> code.LdapQuery
  // XPath (CWE-643) — the expression is arg0
  sink method "evaluate" arg 0 -> code.XpathQuery
  // trust boundary (CWE-501) — untrusted data written into the session map
  sink method "insert" arg all -> code.TrustBoundary
  sink method "set_attribute" arg all -> code.TrustBoundary

  // insecure cookie (CWE-614) — Cookie configured insecurely
  mark "set_secure" val "false" -> code.InsecureCookie
  mark "set_http_only" val "false" -> code.InsecureCookie
  mark exact "CorsLayer.new.allow_origin.allow_methods.allow_headers" val "Any" -> code.PermissiveCors

  // insecure randomness (CWE-330) — non-CSPRNG. `OsRng` is the secure form and
  // its path does NOT start with these tokens, so the safe case carries no mark.
  mark "rand.random" -> code.WeakRandomValue
  mark "rand.thread_rng" -> code.WeakRandomValue
  mark "thread_rng" -> code.WeakRandomValue
  mark "StdRng.seed_from_u64" -> code.WeakRandomValue

  // controls (sanitizers) — neutralize a flow
  control "shell_escape.escape" -> core.ShellEscape
  control "html_escape.encode_text" -> core.HtmlEscape
  control "html_escape.encode_safe" -> core.HtmlEscape
  control "htmlescape.encode_minimal" -> core.HtmlEscape
  control "ammonia.clean" -> core.HtmlEscape
  // sanitizers/validators defined in each generated case's preamble
  control "escape_html" -> core.HtmlEscape
  control "escape_xpath" -> core.XpathEscape
  control "encode_for_ldap" -> core.LdapEscape
  control "escape_shell" -> core.ShellEscape
  control "safe_path" -> core.PathCanonicalization
  control "validate_role" -> core.InputValidation

  // SQL
  sink path "sqlx.query" -> code.SqlExecution
  sink method "query" -> code.SqlExecution
  sink method "query_as" -> code.SqlExecution
  sink method "sql_query" -> code.SqlExecution
  sink method "execute" -> code.SqlExecution

  // path / file
  sink path "File.open" -> code.FilePathAccess
  sink path "File.create" -> code.FilePathAccess
  sink path "fs.read" -> code.FilePathAccess
  sink path "fs.read_to_string" -> code.FilePathAccess
  sink path "fs.write" -> code.FilePathAccess
  sink path "fs.remove_file" -> code.FilePathAccess
  sink method "read_to_string" -> code.FilePathAccess
  sink method "extract_entry" -> code.ArchiveEntryWrite
  sink method "extract" -> code.ArchiveEntryWrite

  // deserialization
  sink path "serde_json.from_str" -> code.Deserialization
  sink path "serde_yaml.from_str" -> code.Deserialization
  mark exact "b62_decode.expect" -> code.UncheckedDecodeResult
  sink method "find_by_id" -> code.ObjectLookupByUserInput
  sink method "get_user" -> code.ObjectLookupByUserInput
  sink method "get_account" -> code.ObjectLookupByUserInput
  mark "change_password" -> code.AuthenticationRequiredOp
  mark "update_password" -> code.AuthenticationRequiredOp
  mark "reset_password" -> code.AuthenticationRequiredOp
  mark "change_email" -> code.AuthenticationRequiredOp
  mark "transfer_funds" -> code.AuthenticationRequiredOp
  mark "delete_account" -> code.AuthenticationRequiredOp
  mark "grant_role" -> code.AuthenticationRequiredOp
  mark "make_admin" -> code.AuthenticationRequiredOp
  mark "danger_accept_invalid_certs" val "true" -> code.CertValidationDisabled
  mark method "mode" val "0o777" -> code.InsecurePermission
  mark method "mode" val "0o666" -> code.InsecurePermission
  mark "Permissions.from_mode" val "0o777" -> code.InsecurePermission
  mark "Permissions.from_mode" val "0o666" -> code.InsecurePermission
  mark "platform_lib.mode_t.from" val "S_IRWXO" -> code.InsecurePermission
  mark exact "analysis.function.context" val "lang=rust" val "config_dest.push(\"ignition\");" val "config_dest.push(\"config.ign\");" val "create_dir_all(&config_dest)" val "OpenOptions::new()" val ".create_new(true)" val "copy(&mutconfig_in,&mutconfig_out)" nval "set_permissions" nval "Permissions::from_mode" nval ".chmod(" nval ".set_mode(" -> code.SecretConfigFilePermissionMissing
  mark "File.create" val "/tmp/" -> code.InsecureTempFile
  mark "__subscript" -> code.IndexAccess
  mark "__unary.deref" -> code.NullableDeref
  control "require_auth" -> core.AuthenticationCheck
  control "ensure_authenticated" -> core.AuthenticationCheck
  control "check_ownership" -> core.OwnershipCheck
  control "require_owner" -> core.OwnershipCheck
}
