module bindings.python.migration.m21017d75;

binding lockFileCreateMissingNoFollow48 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=python" and containsAny(node.token, ["function_name:acquire", "function_name:lock"]) and node.token contains "call_path:os.open" and node.token contains "selector:os.O_CREAT" and node.token contains "selector:os.O_EXCL" and not (node.token contains "literal:O_NOFOLLOW")
  emit issue code.LockFileCreateMissingNoFollow at node
}
