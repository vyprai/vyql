binding publicUploadChunkPathTraversal452 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=python" and containsAny(node.token, ["name=Chunk", "name=chunk"]) and containsAny(node.token, ["literal:/api/uploadChunked/public", "literal:/uploadChunked/public"]) and node.token contains "call_path:request.form.get" and node.token contains "literal:checkSum" and node.token contains "call_path:os.path.join" and node.token contains "call_path:open" and not (node.token contains "call_path:re.sub") and not (node.token contains "call_path:os.path.realpath.startswith")
