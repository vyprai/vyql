module bindings.python.migration.m21017d75;

binding headerControlledJwkReview648 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "name=prepare_key" and node.token contains "key is None and \"jwk\" in header" and node.token contains "key = header[\"jwk\"]" and node.token contains "prepare_key(key)"
  emit issue code.HeaderControlledJwkReview at node
}
