binding weakJwtSecret646 {
  query pattern presenceNode where node.kind == "call" and node.path ~= "jwt.decode" and containsAny(node.token, ["call_arg:secret", "call_arg:jwt-secret", "call_arg:change-me", "call_arg:changeme", "call_arg:password"])
  emit issue code.WeakJwtSecret at node
