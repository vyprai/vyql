module bindings.python.migration.m21017d75;

binding pickleUnsafeImportBlocklistGap313 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "function_name:unsafe_imports" and containsAny(node.token, ["literal:runpy", "literal:cProfile", "literal:marshal", "literal:types", "literal:subprocess", "literal:os"]) and not (node.token contains "literal:pydoc")
  emit issue code.PickleUnsafeImportBlocklistGap at node
}
