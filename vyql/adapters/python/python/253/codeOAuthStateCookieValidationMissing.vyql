module bindings.python.migration.m21017d75;

binding oAuthStateCookieValidationMissing253 {
  query pattern presenceNode where node.scope == "function" and containsAny(node.token, ["function_name:verify_and_process", "function_name:oauth_callback", "function_name:auth_callback", "function_name:callback"]) and node.token contains "literal:state" and node.token contains "call_path:request.query_params.get" and containsAny(node.token, ["call:process_login", "call:exchange_code", "call:fetch_token"]) and not (node.token contains "literal:sso_state")
  emit issue code.OAuthStateCookieValidationMissing at node
}
