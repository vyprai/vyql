module bindings.python.migration.m21017d75;

binding pickleLoadsJoblibModelLoader310 {
  query pattern presenceNode where node.scope == "function" and containsAny(node.token, ["function_name:load", "function_name:load_model", "function_name:from_pretrained", "function_name:restore"]) and node.token contains "call_path:pickle.loads" and node.token contains "call_path:joblib.load" and not (node.token contains "call_path:RestrictedUnpickler") and not (node.token contains "call_path:safe_load")
  emit issue code.PickleLoadsJoblibModelLoader at node
}
