module bindings.python.migration.m21017d75;

binding pickleLoadsJoblibModelLoader310 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and containsAny(node.token, ["function_name:load", "function_name:load_model", "function_name:from_pretrained", "function_name:restore"]) and node.token contains "call_path:pickle.loads" and node.token contains "call_path:joblib.load" and not (node.token contains "call_path:RestrictedUnpickler") and not (node.token contains "call_path:safe_load")
  emit issue code.PickleLoadsJoblibModelLoader at node
}
