module bindings.python.migration.m21017d75;

binding pickleLoadsJoblibModelLoader310 {
  query pattern presenceNode where node.scope == "function" and containsAny(node.token, ["function_name:load", "function_name:load_model", "function_name:from_pretrained", "function_name:restore"]) and node.context.callPath contains "pickle.loads" and node.context.callPath contains "joblib.load" and not (node.context.callPath contains "RestrictedUnpickler") and not (node.context.callPath contains "safe_load")
  emit issue code.PickleLoadsJoblibModelLoader at node
}
