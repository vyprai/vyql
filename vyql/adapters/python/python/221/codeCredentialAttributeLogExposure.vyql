module bindings.python.migration.m21017d75;

binding credentialAttributeLogExposure221 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "python" and containsAny(node.context.callPath, ["LOG.debug", "logger.debug", "logging.debug"]) and containsAny(node.context.selector, ["loc.accesskey", "loc.secretkey"]) and containsAny(node.context.identifier, ["accesskey", "access_key", "secretkey", "secret_key"])
  emit issue code.CredentialAttributeLogExposure at node
}
