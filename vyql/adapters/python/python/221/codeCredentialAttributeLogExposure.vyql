module bindings.python.migration.m21017d75;

binding credentialAttributeLogExposure221 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=python" and containsAny(node.token, ["call_path:LOG.debug", "call_path:logger.debug", "call_path:logging.debug"]) and containsAny(node.token, ["selector:loc.accesskey", "selector:loc.secretkey"]) and containsAny(node.token, ["identifier:accesskey", "identifier:access_key", "identifier:secretkey", "identifier:secret_key"])
  emit issue code.CredentialAttributeLogExposure at node
}
