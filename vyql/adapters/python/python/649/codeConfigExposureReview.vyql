module bindings.python.migration.m21017d75;

binding configExposureReview649 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "name=to_dict" and node.token contains "self.__dict__.items" and node.token contains "storage[k] = v" and not (node.token contains "api")
  emit issue code.ConfigExposureReview at node
}
