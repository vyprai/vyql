module bindings.python.migration.m21017d75;

binding unboundedRouteFilenameCacheAccess456 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "python" and node.token contains "decorator_method:route" and containsAny(node.token, ["param_name:file_name", "param_name:filename", "param_name:camera_name", "param_name:path"]) and containsAny(node.token, ["call_path:secure_filename", "call_path:werkzeug.utils.secure_filename"]) and node.context.callPath contains "os.path.join" and containsAny(node.token, ["identifier:CACHE_DIR", "identifier:cache_dir", "identifier:preview_dir"]) and not (containsAny(node.token, ["expr:len(file_name)>1000", "expr:len(file_name)>=1000", "expr:1000<len(file_name)", "expr:1000<=len(file_name)", "expr:len(filename)>1000", "expr:len(filename)>=1000", "expr:1000<len(filename)", "expr:1000<=len(filename)"]))
  emit issue code.UnboundedRouteFilenameCacheAccess at node
}
