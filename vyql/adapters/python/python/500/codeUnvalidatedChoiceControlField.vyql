binding unvalidatedChoiceControlField500 {
  query pattern presenceNode where node.scope == "function" and node.token contains "name=set_transaction_type" and node.token contains "ifargs.transaction_type:" and node.token contains "args.transaction_type=\"selling\"" and node.token contains "args.transaction_type=\"buying\"" and not (node.token contains "args.transaction_typein[\"buying\",\"selling\"]")
