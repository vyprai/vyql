module bindings.python.migration.m21017d75;

binding passwordHashMissingUserBalance258 {
  query pattern presenceNode where node.scope == "function" and containsAny(node.token, ["function_name:auth_user_db", "function_name:authenticate", "function_name:login"]) and node.context.callPath contains "find_user" and node.context.attrPath contains "user.is_active" and node.context.callPath contains "check_password_hash" and node.context.callPath contains "update_user_auth_stat" and node.context.callPath contains "LOGMSG_WAR_SEC_LOGIN_FAILED.format" and not (containsAny(node.token, ["literal:pbkdf2:", "literal:argon2", "literal:bcrypt", "literal:scrypt"])) and not (containsAny(node.identifier, [dummy, DUMMY, fake, FAKE, balance, BALANCE]))
  emit issue code.PasswordHashMissingUserBalance at node
}
