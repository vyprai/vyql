module bindings.python.migration.m21017d75;

binding passwordHashMissingUserBalance258 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and containsAny(node.token, ["function_name:auth_user_db", "function_name:authenticate", "function_name:login"]) and node.token contains "call_path:find_user" and node.token contains "attr_path:user.is_active" and node.token contains "call_path:check_password_hash" and node.token contains "call_path:update_user_auth_stat" and node.token contains "call_path:LOGMSG_WAR_SEC_LOGIN_FAILED.format" and not (containsAny(node.token, ["literal:pbkdf2:", "literal:argon2", "literal:bcrypt", "literal:scrypt"])) and not (containsAny(node.identifier, [dummy, DUMMY, fake, FAKE, balance, BALANCE]))
  emit issue code.PasswordHashMissingUserBalance at node
}
