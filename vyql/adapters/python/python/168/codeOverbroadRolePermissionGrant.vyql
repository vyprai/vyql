module bindings.python.migration.m21017d75;

binding overbroadRolePermissionGrant168 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "module" and node.token contains "lang=python" and containsAny(node.token, ["assign_item:viewer_scopes:CONFIG_READ", "assign_item:viewer_scopes:CONFIG_UPDATE", "assign_item:viewer_scopes:ADMIN", "assign_item:read_only_scopes:CONFIG_READ", "assign_item:read_only_scopes:CONFIG_UPDATE", "assign_item:guest_scopes:CONFIG_READ", "assign_item:public_scopes:CONFIG_READ"])
  emit issue code.OverbroadRolePermissionGrant at node
}
