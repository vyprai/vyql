module bindings.python.migration.m21017d75;

binding commandStringWrapperExecution244 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "python" and containsAny(node.token, ["call_path:subprocess.run", "call_path:subprocess.call", "call_path:subprocess.Popen", "call_path:subprocess.check_output", "call_path:subprocess.check_call"]) and node.token contains "shell=True" and containsAny(node.token, ["assign:command=f\"", "assign:command=f'", "assign:cmd=f\"", "assign:cmd=f'", "assign:shell_command=f\"", "assign:shell_command=f'"]) and containsAny(node.token, ["call_arg:subprocess.run:command", "call_arg:subprocess.call:command", "call_arg:subprocess.Popen:command", "call_arg:subprocess.check_output:command", "call_arg:subprocess.check_call:command", "call_arg:subprocess.run:cmd", "call_arg:subprocess.call:cmd", "call_arg:subprocess.Popen:cmd", "call_arg:subprocess.check_output:cmd", "call_arg:subprocess.check_call:cmd", "call_arg:subprocess.run:shell_command", "call_arg:subprocess.call:shell_command", "call_arg:subprocess.Popen:shell_command", "call_arg:subprocess.check_output:shell_command", "call_arg:subprocess.check_call:shell_command"]) and not (containsAny(node.token, ["call_path:shlex.quote", "call_path:shlex.join", "call_path:subprocess.list2cmdline"])) and not (node.identifier contains "pkgmgr")
  emit issue code.CommandStringWrapperExecution at node
}
