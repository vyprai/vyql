module bindings.python.migration.m21017d75;

binding cloudStackBaremetalMacCommandInjection265 {
  query pattern presenceNode where node.scope == "function" and node.token contains "name=notify_provisioning_done" and node.token contains "/baremetal/provisiondone/<mac>" and node.token contains "server.notify_provisioning_done(mac)" and not (node.token contains "is_a_mac(mac)")
  emit issue code.CloudStackBaremetalMacCommandInjection at node
}
