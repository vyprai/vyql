module bindings.python.migration.m21017d75;

binding samlRelayStateOpenRedirect250 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "name=decode_relay_state" and node.token contains "urlparse(relay_state)" and node.token contains "parts.scheme or parts.netloc" and node.token contains "parts.path.startswith(\"/\")" and node.token contains "next_url = relay_state" and not (node.token contains "is_safe_url") and not (node.token contains "get_account_adapter")
  emit issue code.SamlRelayStateOpenRedirect at node
}
