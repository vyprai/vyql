module bindings.python.migration.m21017d75;

binding effectiveUidRootCheckBypass163 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "name=run" and node.token contains "os.geteuid()==0" and node.token contains "superuser privileges" and not (node.token contains "name=run_worker") and not (node.token contains "os.getuid()==0")
  emit issue code.EffectiveUidRootCheckBypass at node
}
