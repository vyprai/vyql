module bindings.python.migration.m21017d75;

binding hardcodedSecret108 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "app.config['SECRET_KEY']=\"" and not (node.token contains "os.environ") and not (node.token contains "os.getenv") and not (node.token contains "secrets.") and not (node.token contains "build_secret_key()")
  emit issue code.HardcodedSecret at node
}
