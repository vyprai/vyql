module bindings.python.migration.m21017d75;

binding werkzeugDebugConsoleExposure100 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "app.run" and node.token contains "host='0.0.0.0'" and node.token contains "debug=True" and not (node.token contains "use_evalex=False")
