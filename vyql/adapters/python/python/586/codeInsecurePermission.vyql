module bindings.python.migration.m21017d75;

binding insecurePermission586 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "Path.chmod" and node.token contains "0o777"
  emit issue code.InsecurePermission at node
}
