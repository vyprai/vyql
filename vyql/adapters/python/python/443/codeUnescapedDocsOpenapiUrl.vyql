module bindings.python.generated.m21017d75;

binding unescapedDocsOpenapiUrl443 {
  query pattern presenceNode where node.scope == "function" and node.context.name contains "swagger_dashboard" and node.token contains "req.query_params.get(\"version\")" and node.token contains "openapi_url=root_path+f\"{self.openapi_url}?version={version}\"" and node.token contains "get_swagger_ui_html" and not (node.token contains "quote(version,safe='')")
  emit issue code.UnescapedDocsOpenapiUrl at node
}
