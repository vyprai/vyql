module bindings.python.migration.m21017d75;

binding commandLineAssemblyReview248 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "name=_fork" and node.token contains "path.replace" and node.token contains "href" and node.token contains "os.execv" and node.token contains "\"-c\"" and not (node.token contains "shlex.quote(href)")
  emit issue code.CommandLineAssemblyReview at node
}
