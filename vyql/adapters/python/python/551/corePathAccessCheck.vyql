module bindings.python.migration.m21017d75;

binding pathAccessCheck551 {
  query pattern callExpr where callee.path ~= "analysis.function.context" and args.any.literal contains "name=get_or_launch" and args.any.literal contains "SAFE_SEED_RE.match(seed)" and args.any.literal contains "os.path.join(self._data_dir,seed_key)"
  emit check core.PathAccessCheck at call {
    covers path {
      from: call
      to: call
    }
  }
}
