module bindings.python.migration.m21017d75;

binding staticIv628 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "DES3.new" and node.token contains "00000000"
