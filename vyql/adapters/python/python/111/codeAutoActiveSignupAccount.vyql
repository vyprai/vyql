module bindings.python.migration.m21017d75;

binding autoActiveSignupAccount111 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "name=signup" and node.token contains "UserStatus.ACTIVE" and node.token contains "UserRole.USER" and node.token contains "generate_keypair" and node.token contains "create_user_with_keypair" and not (node.token contains "UserStatus.INACTIVE")
  emit issue code.AutoActiveSignupAccount at node
}
