binding unescapedHtmlOptionRenderer442 {
  query pattern presenceNode where node.scope == "function" and node.token contains "name=body" and node.token contains "class_name=WaterfallHelp" and node.token contains "request.args" and node.token contains "show_reload_input" and node.token contains "value=\"%s\"" and node.token contains "<td>%s</td>" and not (node.token contains "html.escape(value)") and not (node.token contains "html.escape(name)")
