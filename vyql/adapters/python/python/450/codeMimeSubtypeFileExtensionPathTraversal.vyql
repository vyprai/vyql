module bindings.python.migration.m21017d75;

binding mimeSubtypeFileExtensionPathTraversal450 {
  query pattern presenceNode where node.scope == "function" and node.token contains "name=connect" and node.token contains "content_type.split('/',1)" and node.token contains "subtype" and node.token contains "self.ext='.'+subtype.replace('jpeg','jpg')" and not (node.token contains "mimetypes.guess_extension")
  emit issue code.MimeSubtypeFileExtensionPathTraversal at node
}
