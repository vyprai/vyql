  query pattern presenceNode where node.scope == "function" and node.context.language == "python" and containsAny(node.context.functionName, ["validate_redirect", "is_safe_url", "safe_redirect"]) and node.context.callPath contains "urlsplit" and node.context.attrPath contains "request.host_url" and node.context.callPath contains "current_app.config.get" and containsAny(node.context.binary, ["__binop.not in"]) and containsAny(node.context.binary, ["__binop.ne"]) and not (containsAny(node.context.callPath, ["ord", "url.startswith", "url.replace", "quote", "urlquote"])) and not (containsAny(node.context.binary, ["__binop.le"]))
