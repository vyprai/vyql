module bindings.python.migration.m21017d75;

binding insecurePermission581 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "os.chmod" and node.token contains "0o666"
  emit issue code.InsecurePermission at node
