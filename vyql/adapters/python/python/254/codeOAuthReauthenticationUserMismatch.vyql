module bindings.python.migration.m21017d75;

binding oAuthReauthenticationUserMismatch254 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=python" and containsAny(node.token, ["function_name:oauth_verify_response", "function_name:verify_response", "function_name:reauth"]) and node.token contains "call_path:_oauth_response_common" and node.token contains "call_path:session.__setitem__" and containsAny(node.token, ["call_path:redirect", "call_path:flask.redirect"]) and containsAny(node.token, ["literal:fs_paa", "literal:REAUTHENTICATION_SUCCESSFUL", "literal:POST_OAUTH_VERIFY_VIEW"]) and not (containsAny(node.token, ["binary:user.email==current_user.email", "binary:current_user.email==user.email", "binary:user.id==current_user.id", "binary:current_user.id==user.id"]))
  emit issue code.OAuthReauthenticationUserMismatch at node
}
