module bindings.python.migration.m21017d75;

binding snsCertificateUrlTrustBypass256 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "name=_get_cert_url" and node.token contains "SigningCertURL" and node.token contains "cert_url.startswith(\"https://\")" and node.token contains "urlparse(cert_url)" and node.token contains "settings.EVENT_CERT_DOMAINS" and node.token contains "url_obj.netloc.split(\".\")[-len(parts) :] == parts" and node.token contains "return cert_url" and not (node.token contains "SES_REGEX_CERT_URL.match(cert_url)") and not (node.token contains "SimpleNotificationService")
  emit issue code.SnsCertificateUrlTrustBypass at node
}
