binding protocolStateReview502 {
  query pattern presenceNode where node.scope == "function" and node.token contains "name=_recv_packet" and node.token contains "MSG_USERAUTH_LAST" and node.token contains "process_packet(pkttype,seq,packet" and not (node.token contains "Invalid request received before")
