module bindings.python.migration.m21017d75;

binding protocolStateReview502 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "name=_recv_packet" and node.token contains "MSG_USERAUTH_LAST" and node.token contains "process_packet(pkttype,seq,packet" and not (node.token contains "Invalid request received before")
