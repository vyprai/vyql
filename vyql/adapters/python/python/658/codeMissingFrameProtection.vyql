module bindings.python.migration.m21017d75;

binding missingFrameProtection658 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "headers.add" and node.token contains "X-Frame-Options" and node.token contains "ALLOWALL"
  emit issue code.MissingFrameProtection at node
}
