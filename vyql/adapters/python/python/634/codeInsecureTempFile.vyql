module bindings.python.migration.m21017d75;

binding insecureTempFile634 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "open" and node.token contains "/var/tmp/" and node.token contains "w"
  emit issue code.InsecureTempFile at node
}
