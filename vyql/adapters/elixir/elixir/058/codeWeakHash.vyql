module bindings.elixir.migration.m728b8a72;

binding weakHash58 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= ":crypto.hash" and node.token contains ":sha" and not (node.token contains ":sha2") and not (node.token contains ":sha3") and not (node.token contains ":sha5")
  emit issue code.WeakHash at node
}
