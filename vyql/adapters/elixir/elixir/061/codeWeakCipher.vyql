module bindings.elixir.migration.m728b8a72;

binding weakCipher61 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= ":crypto.crypto_one_time" and node.token contains ":blowfish"
  emit issue code.WeakCipher at node
}
