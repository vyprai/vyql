  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=c" and node.token contains "read_and_decode_block_header" and node.token contains "blockSize" and node.token contains "malloc_from_callbacks(blockSize" and node.token contains "onRead(pUserData,pRawData,blockSize)" and not (node.token contains "hasKnownFileSize") and not (node.token contains "fileSize-runningFilePos")
