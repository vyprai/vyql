module bindings.c.migration.mce54b166;

binding weakHash177 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "SHA1_Init"
  emit issue code.WeakHash at node
}
