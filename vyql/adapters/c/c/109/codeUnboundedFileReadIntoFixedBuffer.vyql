module bindings.c.migration.mce54b166;

binding unboundedFileReadIntoFixedBuffer109 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=c" and node.token contains "chartemp[" and node.token contains "for(;;)" and node.token contains "temp[i]=fgetc(" and not (node.token contains "i>=") and not (node.token contains "realloc(")
  emit issue code.UnboundedFileReadIntoFixedBuffer at node
