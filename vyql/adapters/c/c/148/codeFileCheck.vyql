module bindings.c.migration.mce54b166;

binding fileCheck148 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "stat"
  emit issue code.FileCheck at node
}
