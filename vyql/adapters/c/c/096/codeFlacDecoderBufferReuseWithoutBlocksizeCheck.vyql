module bindings.c.migration.mce54b166;

binding flacDecoderBufferReuseWithoutBlocksizeCheck96 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=c" and node.token contains "name=flac_buffer_copy" and node.token contains "call_path:memcpy" and node.token contains "selector:frame.header.blocksize" and node.token contains "attr_path:pflac.wbuffer" and node.token contains "attr_path:pflac.rbuffer" and node.token contains "binary:frame->header.blocksize>FLAC__MAX_BLOCK_SIZE" and not (node.token contains "attr_path:pflac.wbuffer_size") and not (node.token contains "binary:frame->header.blocksize>pflac->wbuffer_size")
  emit issue code.FlacDecoderBufferReuseWithoutBlocksizeCheck at node
}
