module bindings.c.migration.mce54b166;

binding cipherWithoutIntegrityHash188 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=c" and node.token contains "crypto_cipher" and node.token contains "crypto_hash" and node.token contains "tmp_cipher" and node.token contains "tmp_hash" and node.token contains "strcmp(str,\"none\")==0" and not (node.token contains "strcmp(tmp_cipher,\"none\")!=0") and not (node.token contains "strcmp(tmp_hash,\"none\")==0")
  emit issue code.CipherWithoutIntegrityHash at node
}
