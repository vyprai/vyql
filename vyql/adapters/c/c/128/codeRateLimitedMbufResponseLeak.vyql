module bindings.c.migration.mce54b166;

binding rateLimitedMbufResponseLeak128 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=c" and node.token contains "param_type:mbuf" and node.token contains "call_path:tcp_challenge_ack_check" and node.token contains "call_path:tcp_respond" and not (node.token contains "call_path:m_freem")
  emit issue code.RateLimitedMbufResponseLeak at node
}
