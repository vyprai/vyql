module bindings.c.migration.mce54b166;

binding privilegedEntryPointReview120 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "name=perform_http_xact" and node.token contains "CREATION_NOTIFICATION" and node.token contains "run_post_create" and not (node.token contains "client_uid!=0")
  emit issue code.PrivilegedEntryPointReview at node
}
