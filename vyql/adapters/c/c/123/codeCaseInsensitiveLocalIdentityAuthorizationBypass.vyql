module bindings.c.migration.mce54b166;

binding caseInsensitiveLocalIdentityAuthorizationBypass123 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=c" and node.token contains "name=cupsdIsAuthorized" and node.token contains "_cups_strcasecmp(username,name)" and not (node.token contains "strcmp(pw->pw_name,name)")
  emit issue code.CaseInsensitiveLocalIdentityAuthorizationBypass at node
}
