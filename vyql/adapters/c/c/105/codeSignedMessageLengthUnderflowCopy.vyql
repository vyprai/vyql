  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=c" and node.token contains "name=crypto_sign_open" and node.token contains "*mlen=smlen-(unsignedlonglong)sizeof(CROSS_sig_t)" and node.token contains "memcpy((unsignedchar*)m,(constunsignedchar*)sm,(size_t)*mlen)" and not (node.token contains "smlen<(size_t)sizeof(CROSS_sig_t)")
