module bindings.c.migration.mce54b166;

binding isolateLevelIncrementWithoutCap94 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=c" and node.token contains "name=fribidi_get_par_embedding_levels_ex" and node.token contains "call_path:FRIBIDI_IS_ISOLATE" and node.token contains "assign:RL_ISOLATE_LEVEL=isolate_level++" and node.token contains "assign:base_level_per_iso_level[]=new_level" and node.token contains "index:run_per_isolate_level[]" and not (node.token contains "binary:isolate_level<FRIBIDI_BIDI_MAX_EXPLICIT_LEVEL-1")
  emit issue code.IsolateLevelIncrementWithoutCap at node
}
