module bindings.c.migration.mce54b166;

binding missingPostCopyBoundsCheck83 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=c" and node.token contains "name=patch" and node.token contains "newpos+=x" and node.token contains "memcpy(newData+newpos,extraPtr,y)" and not (node.token contains "newpos+y>newDataLength")
  emit issue code.MissingPostCopyBoundsCheck at node
}
