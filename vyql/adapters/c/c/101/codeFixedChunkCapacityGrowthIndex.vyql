module bindings.c.generated.mce54b166;

binding fixedChunkCapacityGrowthIndex101 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "c" and containsAny(node.context.binary, ["level>=ms->c.len", "level>=ctx->c.len", "level>=state->c.len", "idx>=capacity", "index>=capacity", "level>=capacity"]) and containsAny(node.context.assign, [".len=20", "capacity=16", "capacity=32", "capacity=64"]) and node.context.callPath contains "realloc" and containsAny(node.context.indexKey, ["level", "idx", "index"]) and not (containsAny(node.context.assign, [".len=20+level", ".len=level+20", "capacity=idx+1", "capacity=index+1", "capacity=level+1"]))
  emit issue code.FixedChunkCapacityGrowthIndex at node
}
