module bindings.c.migration.mce54b166;

binding ecPointIdentityElementMissing89 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=c" and node.token contains "param_type:PointZZ_p" and containsAny(node.token, ["name=pointZZ_pDouble", "name=pointZZ_pAdd"]) and node.token contains "call_path:mpz_invert" and not (containsAny(node.scopeCall.any, [IsIdentityElement, SetToIdentityElement, is_at_infinity, set_at_infinity, isInfinity, setInfinity]))
  emit issue code.EcPointIdentityElementMissing at node
}
