module bindings.c.migration.mce54b166;

binding ecPointIdentityElementMissing89 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "c" and node.context.paramType contains "PointZZ_p" and containsAny(node.token, ["name=pointZZ_pDouble", "name=pointZZ_pAdd"]) and node.context.callPath contains "mpz_invert" and not (containsAny(node.scopeCall.any, [IsIdentityElement, SetToIdentityElement, is_at_infinity, set_at_infinity, isInfinity, setInfinity]))
  emit issue code.EcPointIdentityElementMissing at node
}
