module bindings.c.migration.mce54b166;

binding numericParserMissingProgressCheck87 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=c" and node.token contains "fio_atol((char**)&tmp)" and node.token contains "fio_atof((char**)&tmp)" and node.token contains "JSON_NUMERAL[*tmp]" and node.token contains "tmp=pos" and not (node.token contains "tmp==pos")
  emit issue code.NumericParserMissingProgressCheck at node
}
