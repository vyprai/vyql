module bindings.c.migration.mce54b166;

binding uncheckedPythonCapiHashError102 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=c" and node.token contains "name=CBORTag_hash" and node.token contains "PyObject_Hash(tmp)" and node.token contains "PySet_Discard(running_hashes,self_id)" and node.token contains "PySequence_Length(running_hashes)" and not (node.token contains "ret==-1")
  emit issue code.UncheckedPythonCapiHashError at node
}
