module bindings.c.migration.mce54b166;

binding ecPointIdentityElementMissing90 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "c" and node.context.paramType contains "PointZZ_p" and containsAny(node.context.name, ["pointZZ_pMul"]) and node.context.callPath contains "pointZZ_pDouble" and node.context.callPath contains "pointZZ_pAdd" and not (containsAny(node.context.scopeCall, [IsIdentityElement, SetToIdentityElement, is_at_infinity, set_at_infinity, isInfinity, setInfinity]))
  emit issue code.EcPointIdentityElementMissing at node
}
