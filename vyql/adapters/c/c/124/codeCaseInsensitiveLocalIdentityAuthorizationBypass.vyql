module bindings.c.migration.mce54b166;

binding caseInsensitiveLocalIdentityAuthorizationBypass124 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=c" and node.token contains "name=cupsdIsAuthorized" and node.token contains "_cups_strcasecmp(username,ownername)" and not (node.token contains "strcmp(pw->pw_name,ownername)")
  emit issue code.CaseInsensitiveLocalIdentityAuthorizationBypass at node
}
