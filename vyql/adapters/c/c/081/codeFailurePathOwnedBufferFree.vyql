module bindings.c.migration.mce54b166;

binding failurePathOwnedBufferFree81 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "analysis.lifetime.release_then_return" and node.token contains "release=delete" and node.token contains "return=false" and node.token contains "storage=nonlocal"
  emit issue code.FailurePathOwnedBufferFree at node
}
