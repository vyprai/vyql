module bindings.c.migration.mce54b166;

binding pythonUnicodeEscapeWideUnderallocation104 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=c" and node.token contains "name=unicodeescape_string" and node.token contains "PyString_FromStringAndSize(NULL,2+6*size+1)" and node.token contains "ch>=0x10000" and node.token contains "*p++='U'" and not (node.token contains "10*size")
  emit issue code.PythonUnicodeEscapeWideUnderallocation at node
}
