module bindings.c.migration.mce54b166;

binding cWebRequestFilePathTraversal38 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=c" and node.token contains "http_request_param_get" and node.token contains "http_request_get_query_string" and node.token contains "file_read" and node.token contains "file_write" and node.token contains "unlink" and not (node.token contains "page_name_is_good(page)") and not (node.token contains "strstr(page,\"..\")") and not (node.token contains "strchr(page,'/')")
  emit issue code.CWebRequestFilePathTraversal at node
}
