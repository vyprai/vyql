binding pairwiseConstraintIntersectionDos88 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "c" and containsAny(node.token, ["call_path:intersect_nodes", "call_path:name_constraints_intersect_nodes"]) and containsAny(node.token, ["call_path:node_list_add", "call_path:name_constraints_node_list_add"]) and containsAny(node.token, ["selector:permitted.size", "selector:permitted2.size", "selector:removed.size"]) and containsAny(node.token, ["binary:i<permitted2->size", "binary:j<removed.size", "binary:j<permitted2->size"]) and not (containsAny(node.token, ["call_path:ensure_sorted", "call_path:compare_name_constraint_nodes"])) and not (node.context.selector contains "sorted_view")
  emit issue code.PairwiseConstraintIntersectionDos at node
}
