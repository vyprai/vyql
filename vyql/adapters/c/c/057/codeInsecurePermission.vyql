module bindings.c.migration.mce54b166;

binding insecurePermission57 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "open" and node.token contains "0666"
  emit issue code.InsecurePermission at node
}
