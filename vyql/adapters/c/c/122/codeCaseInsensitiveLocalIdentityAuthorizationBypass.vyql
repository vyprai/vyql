binding caseInsensitiveLocalIdentityAuthorizationBypass122 {
  query pattern presenceNode where node.scope == "function" and node.token contains "lang=c" and node.token contains "name=cupsdCheckGroup" and node.token contains "_cups_strcasecmp(username,group->gr_mem[i])" and not (node.token contains "strcmp(user->pw_name,group->gr_mem[i])")
  emit issue code.CaseInsensitiveLocalIdentityAuthorizationBypass at node
}
