module bindings.c.migration.mce54b166;

binding fat12SuccessorEntryBoundsBypass84 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.scope == "function" and node.token contains "lang=c" and node.token contains "name=set_fat" and node.token contains "fs->fat_bits" and node.token contains "cluster*3/2" and node.token contains "get_fat(&subseqEntry,fs->fat,cluster+1,fs)" and node.token contains "cluster!=fs->clusters-1" and not (node.token contains "cluster!=fs->clusters+1")
  emit issue code.Fat12SuccessorEntryBoundsBypass at node
}
