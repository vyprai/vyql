module bindings.bash.migration.m59952d5d;

pattern adapterMetadata {
  unstable: {
    owner: "migration"
    reason: "v1 adapter metadata has no stable v2 declaration form yet"
    adapter: "bash"
    meta: {
      fidelity: "resolved"
      source_var_event: "shell_input"
      source_var_exact: ["1", "2", "3", "4", "5", "6", "7", "8", "9", "@", "*", "QUERY_STRING", "REQUEST_URI", "REQUEST_METHOD"]
      source_var_prefix: ["HTTP_", "REQUEST_", "CONTENT_", "PATH_INFO", "REMOTE_"]
    }
  }
}
