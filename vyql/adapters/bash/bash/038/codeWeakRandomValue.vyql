module bindings.bash.migration.m59952d5d;

binding weakRandomValue38 {
  unstable: {
    owner: "migration"
    reason: "v1 flag predicates depend on legacy token/path matching not yet promoted to stable v2 facts"
  }
  query unstable.legacyFlag as node where node.kind == "any" and node.path ~= "RANDOM"
  emit issue code.WeakRandomValue at node
}
