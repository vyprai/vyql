// Path/file family — traversal and remote/local file inclusion.
package vypr.path;

rule Traversal {
  meta { id: "VYQL-PATH-001", severity: high, cwe: [CWE_22] }
  taint core.UserControlledData -> code.FilePathAccess
  unless sanitized_by core.PathCanonicalization
  unless guarded_by core.PathAccessCheck
}

rule FileInclusion {
  meta { id: "VYQL-PATH-002", severity: high, cwe: [CWE_98] }
  taint core.UserControlledData -> code.FileInclude
}

// Insecure temporary file (CWE-377) — predictable-name / race-prone temp APIs
// (mktemp/tmpnam/tempnam). Presence rule: their use is the weakness, no taint needed.
rule InsecureTempFile {
  meta { id: "VYQL-PATH-003", severity: low, cwe: [CWE_377] }
  match code.InsecureTempFile as t
}
