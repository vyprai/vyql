// Request forgery family — SSRF, open redirect, CSRF (OWASP A10 / A01).
module vypr.request_forgery;

rule Ssrf {
  meta { id: "VYQL-RF-001", severity: high, cwe: [CWE_918, CWE_20] }
  taint core.UserControlledData -> code.UrlFetch
  unless sanitized_by core.AllowlistValidation
  unless guarded_by core.AllowlistValidation
}

rule IncompleteIpDenylist {
  meta { id: "VYQL-RF-004", severity: high, cwe: [CWE_918] }
  match code.IncompleteIpDenylist as guard
}

rule IncompleteServerPortValidation {
  meta { id: "VYQL-RF-005", severity: medium, cwe: [CWE_918], confidence_floor: low }
  match code.IncompleteServerPortValidation as guard
}

rule RequestHostUrlValidationBypass {
  meta { id: "VYQL-RF-010", severity: high, cwe: [CWE_918, CWE_20], confidence_floor: medium }
  match code.RequestHostUrlValidationBypass as guard
}

rule ChamiloUnsafeGuzzleUrlFetch {
  meta { id: "VYQL-RF-014", severity: high, cwe: [CWE_918], confidence_floor: medium }
  match code.ChamiloUnsafeGuzzleUrlFetch as fetch
}

rule SnsCertificateUrlTrustBypass {
  meta { id: "VYQL-RF-025", severity: high, cwe: [CWE_295, CWE_918], confidence_floor: high }
  match code.SnsCertificateUrlTrustBypass as verifier
}

rule ClockworkWebJobCsrf {
  meta { id: "VYQL-RF-015", severity: medium, cwe: [CWE_352], confidence_floor: high }
  match code.ClockworkWebJobCsrf as action
}

rule BestWebSoftContactFormSettingsCsrf {
  meta { id: "VYQL-RF-021", severity: medium, cwe: [CWE_352], confidence_floor: high }
  match code.BestWebSoftContactFormSettingsCsrf as action
}

rule WordPressOptionUpdateMissingCsrf {
  meta { id: "VYQL-RF-028", severity: medium, cwe: [CWE_352], confidence_floor: high }
  match code.WordPressOptionUpdateMissingCsrf as action
}

rule CloudBaseOpenUrlSsrf {
  meta { id: "VYQL-RF-016", severity: high, cwe: [CWE_918], confidence_floor: high }
  match code.CloudBaseOpenUrlSsrf as action
}

rule ServerSideBrowserActiveHtmlRendering {
  meta { id: "VYQL-RF-026", severity: high, cwe: [CWE_918, CWE_79, CWE_200], confidence_floor: high }
  match code.ServerSideBrowserActiveHtmlRendering as render
}

rule SvgNestedResourceValidationBypass {
  meta { id: "VYQL-RF-027", severity: critical, cwe: [CWE_611, CWE_918, CWE_502, CWE_22], confidence_floor: high }
  match code.SvgNestedResourceValidationBypass as render
}

rule CodeServerPathProxyPortConfusedProxy {
  meta { id: "VYQL-RF-019", severity: high, cwe: [CWE_441, CWE_918], confidence_floor: high }
  match code.CodeServerPathProxyPortConfusedProxy as proxy
}

rule MultiOptionUrlValidationBypass {
  meta { id: "VYQL-RF-012", severity: medium, cwe: [CWE_601], confidence_floor: medium }
  match code.MultiOptionUrlValidationBypass as guard
}

rule OpenRedirect {
  meta { id: "VYQL-RF-002", severity: medium, cwe: [CWE_601], benchmark: redirect }
  taint core.UserControlledData -> code.RedirectTarget
  unless sanitized_by core.RedirectAllowlist
  unless guarded_by core.RedirectAllowlist
}

rule SessionStoredRedirectTarget {
  meta { id: "VYQL-RF-013", severity: medium, cwe: [CWE_601], confidence_floor: medium }
  match code.SessionStoredRedirectTarget as redirect
}

rule MethodGatedRedirectValidationBypass {
  meta { id: "VYQL-RF-008", severity: high, cwe: [CWE_601], confidence_floor: medium }
  match code.MethodGatedRedirectValidationBypass as bypass
}

rule ChecksumErrorLogoutRedirect {
  meta { id: "VYQL-RF-009", severity: medium, cwe: [CWE_601], confidence_floor: medium }
  match code.ChecksumErrorLogoutRedirect as redirect
}

rule PhpMyAdminSetupRedirectorOpenRedirect {
  meta { id: "VYQL-RF-020", severity: medium, cwe: [CWE_601], confidence_floor: high }
  match code.PhpMyAdminSetupRedirectorOpenRedirect as redirect
}

rule OwnCloudLoginRedirectUrlOpenRedirect {
  meta { id: "VYQL-RF-022", severity: medium, cwe: [CWE_601], confidence_floor: high }
  match code.OwnCloudLoginRedirectUrlOpenRedirect as redirect
}

rule SamlRelayStateOpenRedirect {
  meta { id: "VYQL-RF-024", severity: medium, cwe: [CWE_601], confidence_floor: high }
  match code.SamlRelayStateOpenRedirect as redirect
}

rule PathMatcherNormalizationOrderBypass {
  meta { id: "VYQL-RF-011", severity: medium, cwe: [CWE_601, CWE_22], confidence_floor: medium }
  match code.PathMatcherNormalizationOrderBypass as matcher
}

rule IncompleteCsrfTokenValidation {
  meta { id: "VYQL-RF-006", severity: medium, cwe: [CWE_352], confidence_floor: medium }
  match code.IncompleteCsrfTokenValidation as guard
}

rule MissingHttpMethodAssertion {
  meta { id: "VYQL-RF-007", severity: medium, cwe: [CWE_352, CWE_749], confidence_floor: medium }
  match code.MissingHttpMethodAssertion as action
}

rule CobblerDjangoStateChangeGetCsrf {
  meta { id: "VYQL-RF-017", severity: high, cwe: [CWE_352], confidence_floor: high }
  match code.CobblerDjangoStateChangeGetCsrf as action
}

rule CodeDxJenkinsRemoteValidationMissingPostPermission {
  meta { id: "VYQL-RF-018", severity: medium, cwe: [CWE_352, CWE_862, CWE_918], confidence_floor: high }
  match code.CodeDxJenkinsRemoteValidationMissingPostPermission as endpoint
}

rule JenkinsRemoteValidationMissingPostPermission {
  meta { id: "VYQL-RF-023", severity: medium, cwe: [CWE_352, CWE_862, CWE_918], confidence_floor: high }
  match code.JenkinsRemoteValidationMissingPostPermission as endpoint
}

rule JenkinsStaplerStateChangeMissingPost {
  meta { id: "VYQL-RF-028", severity: high, cwe: [CWE_352], confidence_floor: high }
  match code.JenkinsStaplerStateChangeMissingPost as endpoint
}

rule Csrf {
  meta { id: "VYQL-RF-003", severity: medium, cwe: [CWE_352] }
  taint core.UserControlledData -> code.StateChangingOp
  unless guarded_by core.CsrfProtection
}
