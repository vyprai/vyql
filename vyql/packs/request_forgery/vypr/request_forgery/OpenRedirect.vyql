module vypr.request_forgery;

rule OpenRedirect {
  meta {
    benchmark: redirect
    cwe: [CWE_601]
    id: "VYQL-RF-002"
    severity: medium
  }
  taint core.UserControlledData -> code.RedirectTargetSink
  unless path coveredBy core.RedirectAllowlist
  unless endpoint coveredBy core.RedirectAllowlist
}
