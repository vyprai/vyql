// Mobile weakness rules. Intent/deep-link data flowing to OS/SQL/file sinks reuses
// the injection rules (IntentInput refines core.UserControlledData); these cover the
// mobile-specific WebView surface.
module vypr.mobile;

// Untrusted data loaded or evaluated in a WebView — loadUrl/loadData/evaluateJavascript
// (CWE-749). A tainted URL can be `javascript:` (XSS) or a phishing/redirect target.
rule WebViewInjection {
  meta { id: "VYQL-MOB-001", severity: high, cwe: [CWE_749] }
  taint core.UserControlledData -> code.WebViewLoad
}

// A native bridge exposed to WebView content — addJavascriptInterface (CWE-749). If the
// WebView ever loads untrusted content the exposed methods are reachable from JS (RCE).
rule WebViewJsBridge {
  meta { id: "VYQL-MOB-002", severity: medium, cwe: [CWE_749] }
  match code.WebViewJsInterface as w
}

// Android component exported to other apps without a permission (CWE-926) — an
// attack surface other installed apps can invoke (AndroidManifest android:exported).
rule ExportedComponent {
  meta { id: "VYQL-MOB-003", severity: medium, cwe: [CWE_926] }
  match code.ExportedComponent as e
}

// Cleartext network allowed by configuration (CWE-319) — Android
// usesCleartextTraffic="true" or iOS ATS NSAllowsArbitraryLoads.
rule CleartextConfig {
  meta { id: "VYQL-MOB-004", severity: medium, cwe: [CWE_319] }
  match code.CleartextConfig as c
}

// Debuggable production build (CWE-489) — android:debuggable="true" exposes the
// app to runtime tampering / data extraction.
rule DebuggableApp {
  meta { id: "VYQL-MOB-005", severity: medium, cwe: [CWE_489] }
  match code.DebuggableApp as d
}

// Android app backup/restore allowed by configuration (CWE-922). Android backs up
// app data by default unless android:allowBackup="false"; sensitive preferences can
// otherwise be restored onto a device and bypass local protection.
rule BackupAllowedConfig {
  meta { id: "VYQL-MOB-006", severity: medium, cwe: [CWE_922] }
  match code.BackupAllowedConfig as b
}
