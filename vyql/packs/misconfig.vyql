// Security-misconfiguration rules (presence/config). docs/05 rule packs.
module vypr.misconfig;

// CSRF protection explicitly disabled / exempted (CWE-352) — a PRESENCE rule.
rule CsrfDisabled {
  meta { id: "VYQL-CFG-001", severity: high, cwe: [CWE_352] }
  match code.CsrfDisabled as c
}

// User-controlled value used as the session identifier — session fixation (CWE-384).
rule SessionFixation {
  meta { id: "VYQL-CFG-002", severity: medium, cwe: [CWE_384] }
  taint core.UserControlledData -> code.SessionId
}

// Permissive CORS — Access-Control-Allow-Origin: * (CWE-942), value-matched presence.
rule PermissiveCors {
  meta { id: "VYQL-CFG-003", severity: medium, cwe: [CWE_942] }
  match code.PermissiveCors as c
}

// TLS certificate validation disabled — verify=False / rejectUnauthorized:false /
// InsecureSkipVerify:true (CWE-295), named-value presence.
rule CertValidationDisabled {
  meta { id: "VYQL-CFG-004", severity: high, cwe: [CWE_295] }
  match code.CertValidationDisabled as c
}

// JWT signature not verified — alg "none" / verify disabled (CWE-347), named-value presence.
rule JwtUnverified {
  meta { id: "VYQL-CFG-005", severity: high, cwe: [CWE_347] }
  match code.JwtUnverified as c
}

// Cleartext channel — an http:// URL to an HTTP client (CWE-319), value-matched presence.
rule CleartextChannel {
  meta { id: "VYQL-CFG-006", severity: low, cwe: [CWE_319] }
  match code.CleartextChannel as c
}

// Insecure cookie — set without the HttpOnly flag (CWE-614), value-ABSENCE presence.
rule InsecureCookie {
  meta { id: "VYQL-CFG-007", severity: low, cwe: [CWE_614], benchmark: securecookie }
  match code.InsecureCookie as c
}

// World-writable / overly-broad file permission — chmod 0o777, FileMode(0o777),
// umask(0) (CWE-732), value-matched presence. Restrictive modes (0o600/0o640/0o644)
// are not matched.
rule InsecurePermission {
  meta { id: "VYQL-CFG-008", severity: medium, cwe: [CWE_732] }
  match code.InsecurePermission as p
}

// Clickjacking — frame protection explicitly disabled: X-Frame-Options ALLOWALL,
// helmet frameguard off, CSP frame-ancestors * (CWE-1021), value-matched presence.
// Pure omission is NOT flagged (framework defaults vary) — only explicit disabling.
rule MissingFrameProtection {
  meta { id: "VYQL-CFG-009", severity: medium, cwe: [CWE_1021] }
  match code.MissingFrameProtection as f
}

// IaC / container misconfig (presence over the config frontend — Dockerfile/K8s/Terraform).
rule PrivilegedContainer {
  meta { id: "VYQL-CFG-010", severity: high, cwe: [CWE_250] }
  match code.PrivilegedContainer as c
}
rule HostNamespaceShare {
  meta { id: "VYQL-CFG-011", severity: medium, cwe: [CWE_653] }
  match code.HostNamespaceShare as h
}
rule PublicNetworkExposure {
  meta { id: "VYQL-CFG-012", severity: high, cwe: [CWE_284] }
  match code.PublicNetworkExposure as n
}
rule WildcardIamPolicy {
  meta { id: "VYQL-CFG-013", severity: high, cwe: [CWE_284] }
  match code.WildcardIamPolicy as w
}

// Trust-boundary violation (CWE-501) — untrusted data stored into the HTTP session.
rule TrustBoundary {
  meta { id: "VYQL-CFG-014", severity: medium, cwe: [CWE_501], benchmark: trustbound }
  // data that passed through a validator/authenticator (login(), an @vyql:validator
  // function) before reaching the store is no longer an untrusted-data violation.
  taint core.UserControlledData -> code.TrustBoundary
    unless sanitized_by core.InputValidation
}

// Network policy enforcement explicitly disabled. Linux bridge netfilter sysctls
// set to 0 bypass iptables/ip6tables/arptables filtering for bridged traffic.
rule NetworkFilteringDisabled {
  meta { id: "VYQL-CFG-015", severity: high, cwe: [CWE_284] }
  match code.NetworkFilteringDisabled as n
}
