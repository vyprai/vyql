// Numeric and size-computation weakness rules. These are partial by design: the
// finding states the exploit condition rather than claiming full range proof.
module vypr.numeric;

rule TaintedSizeComputation {
  meta { id: "VYQL-NUM-001", severity: medium, cwe: [CWE_190] }
  taint core.UserControlledData -> code.SizeComputation
}

rule TaintedDivisionDenominator {
  meta { id: "VYQL-NUM-002", severity: medium, cwe: [CWE_369] }
  taint core.UserControlledData -> code.DivisionDenominator
}

rule TaintedIntegerSizeArithmetic {
  meta { id: "VYQL-NUM-003", severity: low, cwe: [CWE_190], confidence_floor: low }
  taint core.UserControlledData -> code.IntegerSizeArithmetic
  unless guarded_by core.IntegerOverflowGuard
}

rule UnderwidthFormattedIndex {
  meta { id: "VYQL-NUM-004", severity: medium, cwe: [CWE_192, CWE_125], confidence_floor: medium }
  match code.UnderwidthFormattedIndex as idx
}

rule UncheckedEncodedLengthArithmetic {
  meta { id: "VYQL-NUM-005", severity: medium, cwe: [CWE_190, CWE_835], confidence_floor: medium }
  match code.UncheckedEncodedLengthArithmetic as arithmetic
}

rule PointerOffsetBoundsCheck {
  meta { id: "VYQL-NUM-006", severity: medium, cwe: [CWE_20, CWE_125, CWE_190], confidence_floor: medium }
  match code.PointerOffsetBoundsCheck as bounds
}

rule UnsignedIndexConversionGuardBypass {
  meta { id: "VYQL-NUM-007", severity: medium, cwe: [CWE_190, CWE_129], confidence_floor: medium }
  match code.UnsignedIndexConversionGuardBypass as idx
}

rule UncheckedFfiLengthNarrowing {
  meta { id: "VYQL-NUM-008", severity: medium, cwe: [CWE_190], confidence_floor: medium }
  match code.UncheckedFfiLengthNarrowing as narrowing
}

rule RubyCgiEscapeHtmlLengthOverflow {
  meta { id: "VYQL-NUM-009", severity: high, cwe: [CWE_190, CWE_787], confidence_floor: high }
  match code.RubyCgiEscapeHtmlLengthOverflow as overflow
}

rule CgifAddframeSignedFrameCountOverflow {
  meta { id: "VYQL-NUM-010", severity: medium, cwe: [CWE_190], confidence_floor: high }
  match code.CgifAddframeSignedFrameCountOverflow as overflow
}

rule ChGoCompressedSizeUint32Overflow {
  meta { id: "VYQL-NUM-011", severity: medium, cwe: [CWE_190, CWE_444], confidence_floor: high }
  match code.ChGoCompressedSizeUint32Overflow as overflow
}

rule CimgPnmDimensionProductOverflow {
  meta { id: "VYQL-NUM-012", severity: high, cwe: [CWE_190, CWE_787], confidence_floor: high }
  match code.CimgPnmDimensionProductOverflow as overflow
}

rule PeerLimitUnderflow {
  meta { id: "VYQL-NUM-013", severity: medium, cwe: [CWE_191], confidence_floor: high }
  match code.PeerLimitUnderflow as underflow
}

rule OffsetLengthBoundsOverflow {
  meta { id: "VYQL-NUM-014", severity: high, cwe: [CWE_190, CWE_125], confidence_floor: high }
  match code.OffsetLengthBoundsOverflow as overflow
}
