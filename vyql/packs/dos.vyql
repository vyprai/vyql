// Denial-of-service weakness rules. docs/05 rule packs.
module vypr.dos;

// Untrusted data compiled as a regex pattern — ReDoS (CWE-1333).
rule ReDoS {
  meta { id: "VYQL-DOS-001", severity: medium, cwe: [CWE_1333] }
  taint core.UserControlledData -> code.RegexCompile
}

// Untrusted data matched against a regex pattern with static catastrophic-backtracking
// structure — ReDoS (CWE-1333).
rule StaticRegexReDoS {
  meta { id: "VYQL-DOS-002", severity: medium, cwe: [CWE_1333], confidence_floor: low }
  taint core.UserControlledData -> code.RegexMatch
}
