// Secrets — sensitive values reaching a log/persistence sink (OWASP A09).
module vypr.secrets;

rule SecretInLog {
  meta { id: "VYQL-SEC-001", severity: medium, cwe: [CWE_532] }
  taint code.SecretValue -> code.LogWrite
}

// Hardcoded secret in source/config (CWE-798) — a presence rule over the text-pattern frontend.
rule HardcodedSecret {
  meta { id: "VYQL-SEC-002", severity: high, cwe: [CWE_798] }
  match code.HardcodedSecret as s
}

rule RequestPolicyStripped {
  meta { id: "VYQL-SEC-003", severity: medium, cwe: [CWE_200, CWE_441, CWE_524], confidence_floor: medium }
  match code.RequestPolicyStripped as s
}

rule AbsolutePathDisclosure {
  meta { id: "VYQL-SEC-004", severity: medium, cwe: [CWE_200], confidence_floor: medium }
  match code.AbsolutePathDisclosure as p
}

rule InheritedProcessEnvironmentLeak {
  meta { id: "VYQL-SEC-005", severity: medium, cwe: [CWE_200, CWE_212], confidence_floor: medium }
  match code.InheritedProcessEnvironmentLeak as p
}

rule LdapCrlCredentialReuse {
  meta { id: "VYQL-SEC-006", severity: high, cwe: [CWE_200, CWE_522], confidence_floor: medium }
  match code.LdapCrlCredentialReuse as p
}

rule SensitiveConfigInfoLog {
  meta { id: "VYQL-SEC-007", severity: medium, cwe: [CWE_200, CWE_532], confidence_floor: medium }
  match code.SensitiveConfigInfoLog as p
}

rule CinnyServiceWorkerMediaAuthLeak {
  meta { id: "VYQL-SEC-008", severity: high, cwe: [CWE_20, CWE_200, CWE_522], confidence_floor: high }
  match code.CinnyServiceWorkerMediaAuthLeak as p
}

rule CkanSolrConnectionErrorDisclosure {
  meta { id: "VYQL-SEC-009", severity: medium, cwe: [CWE_209, CWE_200, CWE_522], confidence_floor: high }
  match code.CkanSolrConnectionErrorDisclosure as p
}

rule KubernetesCurlAuthorizationHeaderLogLeak {
  meta { id: "VYQL-SEC-010", severity: medium, cwe: [CWE_532], confidence_floor: high }
  match code.KubernetesCurlAuthorizationHeaderLogLeak as p
}

rule CoderAgentManifestInfoLog {
  meta { id: "VYQL-SEC-011", severity: high, cwe: [CWE_532], confidence_floor: high }
  match code.CoderAgentManifestInfoLog as p
}

rule AnsibleSnmpFactsCredentialsNoLogMissing {
  meta { id: "VYQL-SEC-012", severity: medium, cwe: [CWE_532], confidence_floor: high }
  match code.AnsibleSnmpFactsCredentialsNoLogMissing as p
}

rule JenkinsRemotingCallableSystemPropertiesLeak {
  meta { id: "VYQL-SEC-013", severity: medium, cwe: [CWE_200, CWE_862], confidence_floor: high }
  match code.JenkinsRemotingCallableSystemPropertiesLeak as p
}

rule ContainerdCriImageEnvAliasLeak {
  meta { id: "VYQL-SEC-014", severity: medium, cwe: [CWE_200, CWE_668], confidence_floor: high }
  match code.ContainerdCriImageEnvAliasLeak as p
}

rule JenkinsPlaintextDataboundCredential {
  meta { id: "VYQL-SEC-015", severity: medium, cwe: [CWE_312, CWE_522], confidence_floor: high }
  match code.JenkinsPlaintextDataboundCredential as p
}

rule JenkinsCredentialsStartupLoadContextExposure {
  meta { id: "VYQL-SEC-016", severity: high, cwe: [CWE_200], confidence_floor: high }
  match code.JenkinsCredentialsStartupLoadContextExposure as p
}

rule DefaultExternalRelaySecretExposure {
  meta { id: "VYQL-SEC-017", severity: medium, cwe: [CWE_200], confidence_floor: medium }
  match code.DefaultExternalRelaySecretExposure as p
}

rule JdbcCredentialAttributeExposure {
  meta { id: "VYQL-SEC-019", severity: medium, cwe: [CWE_200, CWE_522], confidence_floor: high }
  match code.JdbcCredentialAttributeExposure as p
}

rule WindowsRemotePathCredentialLeak {
  meta { id: "VYQL-SEC-020", severity: high, cwe: [CWE_200, CWE_522], confidence_floor: high }
  match code.WindowsRemotePathCredentialLeak as p
}

rule MessageBusSecretConfigExposure {
  meta { id: "VYQL-SEC-021", severity: high, cwe: [CWE_200, CWE_522], confidence_floor: high }
  match code.MessageBusSecretConfigExposure as p
}

rule SessionKeyTemplateExposure {
  meta { id: "VYQL-SEC-022", severity: high, cwe: [CWE_200, CWE_522], confidence_floor: high }
  match code.SessionKeyTemplateExposure as p
}

// PII / regulated data written to a log — GDPR / privacy exposure (CWE-532). A taint flow
// from a high-signal PII field/getter into a log sink. The data-flow engine over a PII
// taint kind (distinct from secrets / untrusted input).
rule PiiInLog {
  meta { id: "VYQL-PII-001", severity: medium, cwe: [CWE_532] }
  taint code.PiiValue -> code.LogWrite
}
