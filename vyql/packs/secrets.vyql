// Secrets — sensitive values reaching a log/persistence sink (OWASP A09).
module vypr.secrets;

rule SecretInLog {
  meta { id: "VYQL-SEC-001", severity: medium, cwe: [CWE_532] }
  taint code.SecretValue -> code.LogWrite
}

// Hardcoded secret in source/config (CWE-798) — a presence rule over the text-pattern frontend.
rule HardcodedSecret {
  meta { id: "VYQL-SEC-002", severity: high, cwe: [CWE_798] }
  match code.HardcodedSecret as s
}

rule RequestPolicyStripped {
  meta { id: "VYQL-SEC-003", severity: medium, cwe: [CWE_200, CWE_441, CWE_524], confidence_floor: medium }
  match code.RequestPolicyStripped as s
}

rule AbsolutePathDisclosure {
  meta { id: "VYQL-SEC-004", severity: medium, cwe: [CWE_200], confidence_floor: medium }
  match code.AbsolutePathDisclosure as p
}

rule JenkinsCredentialsStartupLoadContextExposure {
  meta { id: "VYQL-SEC-016", severity: high, cwe: [CWE_200], confidence_floor: high }
  match code.JenkinsCredentialsStartupLoadContextExposure as p
}

rule DefaultExternalRelaySecretExposure {
  meta { id: "VYQL-SEC-017", severity: medium, cwe: [CWE_200], confidence_floor: medium }
  match code.DefaultExternalRelaySecretExposure as p
}

// PII / regulated data written to a log — GDPR / privacy exposure (CWE-532). A taint flow
// from a high-signal PII field/getter into a log sink. The data-flow engine over a PII
// taint kind (distinct from secrets / untrusted input).
rule PiiInLog {
  meta { id: "VYQL-PII-001", severity: medium, cwe: [CWE_532] }
  taint code.PiiValue -> code.LogWrite
}
