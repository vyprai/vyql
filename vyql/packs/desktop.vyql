// Desktop (Electron) weakness rules.
module vypr.desktop;

// A BrowserWindow renderer configured with nodeIntegration enabled or
// contextIsolation disabled — untrusted web content can then execute Node /
// reach the main process (CWE-829). Named-value presence rule.
rule InsecureElectronConfig {
  meta { id: "VYQL-DSK-001", severity: high, cwe: [CWE_829] }
  match code.ElectronNodeIntegration as c
}

rule ElectronPrivilegedUrlNodeIntegration {
  meta { id: "VYQL-DSK-002", severity: high, cwe: [CWE_829, CWE_94], confidence_floor: high }
  match code.ElectronPrivilegedUrlNodeIntegration as c
}
