// Authentication and object-ownership coverage. These rules intentionally stay
// explicit about what is observed: a sensitive operation without an auth guard,
// or user-controlled object identifiers flowing into direct lookups.
module vypr.auth;

rule MissingAuthentication {
  meta { id: "VYQL-AUTH-001", severity: high, cwe: [CWE_306], confidence_floor: low }
  match code.AuthenticationRequiredOp as op
  unless guarded_by core.AuthenticationCheck
}

rule InsecureDirectObjectReference {
  meta { id: "VYQL-AUTH-002", severity: high, cwe: [CWE_639] }
  taint core.UserControlledData -> code.ObjectLookupByUserInput
  unless guarded_by core.OwnershipCheck
}

// A privileged operation (OS command execution) that sits inside an HTTP request
// handler but is not preceded by an authentication check on every path. This is the
// missing-authentication pattern as a context+control query, not a dataflow one: we
// don't require the request data to *flow into* the command — only that an
// unauthenticated remote caller can reach the operation. `colocated code.HttpInput`
// scopes this to HTTP-exposed code (so CLI tools that run commands are not flagged),
// and `guarded_by core.AuthenticationCheck` suppresses handlers where an auth check
// dominates the operation. confidence_floor low: auth is sometimes enforced by
// upstream middleware the analysis cannot see.
rule UnauthenticatedRemoteCommand {
  meta { id: "VYQL-AUTH-003", severity: high, cwe: [CWE_306, CWE_862], confidence_floor: low }
  match code.CommandExecution as op
  where op colocated code.HttpInput
  unless guarded_by core.AuthenticationCheck
}
