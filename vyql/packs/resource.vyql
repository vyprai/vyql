// Resource lifecycle (B2 type-state). A handle allocated but not released on every path
// to function exit is a leak — closed_by is a POST-dominance check over the structured CFG.
module vypr.resource;

rule ResourceLeak {
  meta { id: "VYQL-RES-001", severity: medium, cwe: [CWE_772] }
  match code.ResourceHandle as h
  unless closed_by core.ResourceRelease
}

rule OwnerFieldClearedBeforeFree {
  meta { id: "VYQL-RES-002", severity: medium, cwe: [CWE_401], confidence_floor: low }
  match code.OwnerFieldClear as clear
  where dominates(clear, code.OwnerFree)
}

rule RequestTokenCacheCleanupBypass {
  meta { id: "VYQL-RES-003", severity: high, cwe: [CWE_772] }
  match code.RequestTokenCacheCleanupBypass as cache
}

rule CallFutureWeakStateLeak {
  meta { id: "VYQL-RES-004", severity: high, cwe: [CWE_401, CWE_400] }
  match code.CallFutureRawWeakStateRef as raw
}
