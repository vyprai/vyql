// Input validation failures that are not naturally modeled as interpreter
// injection. These rules catch rejected/unchecked parse states and similar
// boundary validation defects.
module vypr.validation;

rule UncheckedDecodeResult {
  meta { id: "VYQL-VAL-001", severity: medium, cwe: [CWE_20], confidence_floor: medium }
  match code.UncheckedDecodeResult as decode
}

rule UnvalidatedRatingRange {
  meta { id: "VYQL-VAL-002", severity: medium, cwe: [CWE_20], confidence_floor: medium }
  match code.UnvalidatedRatingRange as rating
}

rule FrameworkRequestBeforeSessionValidation {
  meta { id: "VYQL-VAL-003", severity: high, cwe: [CWE_20], confidence_floor: medium }
  match code.FrameworkRequestBeforeSessionValidation as request
}

rule CommandOptionArgumentValidation {
  meta { id: "VYQL-VAL-004", severity: high, cwe: [CWE_20], confidence_floor: medium }
  match code.CommandOptionInjection as command
}

rule CommandStringWrapperInputValidation {
  meta { id: "VYQL-VAL-005", severity: high, cwe: [CWE_20], confidence_floor: high }
  match code.CommandStringWrapperExecution as command
}

rule RegexLineCommentStripWithoutCharWhitelist {
  meta { id: "VYQL-VAL-006", severity: high, cwe: [CWE_20], confidence_floor: high }
  match code.RegexLineCommentStripWithoutCharWhitelist as parser
}

rule UnvalidatedChoiceControlField {
  meta { id: "VYQL-VAL-007", severity: medium, cwe: [CWE_20], confidence_floor: medium }
  match code.UnvalidatedChoiceControlField as choice
}

rule ExpressParamArrayValuePollution {
  meta { id: "VYQL-VAL-008", severity: medium, cwe: [CWE_20, CWE_235], confidence_floor: high }
  match code.ExpressParamArrayValuePollution as param
}

rule UnicodeNormalizationAfterFilterBypass {
  meta { id: "VYQL-VAL-009", severity: medium, cwe: [CWE_176, CWE_74], confidence_floor: high }
  match code.UnicodeNormalizationAfterFilterBypass as normalizer
}

rule MultipleDropdownScalarFallbackMissing {
  meta { id: "VYQL-VAL-010", severity: high, cwe: [CWE_20], confidence_floor: high }
  match code.MultipleDropdownScalarFallbackMissing as dropdown
}

rule DeviceStatusStateMachineBypass {
  meta { id: "VYQL-VAL-011", severity: high, cwe: [CWE_20, CWE_841, CWE_787], confidence_floor: high }
  match code.DeviceStatusStateMachineBypass as status
}

rule CaptchaValidationTruthyReturnBypass {
  meta { id: "VYQL-VAL-012", severity: medium, cwe: [CWE_20, CWE_287], confidence_floor: high }
  match code.CaptchaValidationTruthyReturnBypass as validator
}

rule UrlPathParameterCaseNormalizationBypass {
  meta { id: "VYQL-VAL-013", severity: high, cwe: [CWE_178, CWE_863], confidence_floor: high }
  match code.UrlPathParameterCaseNormalizationBypass as params
}

rule XmlLeadByteNameValidationMissing {
  meta { id: "VYQL-VAL-014", severity: high, cwe: [CWE_20, CWE_125], confidence_floor: high }
  match code.XmlLeadByteNameValidationMissing as tokenizer
}

rule DnsInterfaceNewlineValidationMissing {
  meta { id: "VYQL-VAL-015", severity: high, cwe: [CWE_20, CWE_74], confidence_floor: high }
  match code.DnsInterfaceNewlineValidationMissing as config
}

rule GitPackSignatureSearchParsingBypass {
  meta { id: "VYQL-VAL-016", severity: high, cwe: [CWE_20, CWE_115], confidence_floor: high }
  match code.GitPackSignatureSearchParsingBypass as parser
}

rule UnvalidatedDependencyMapKeyDeserialization {
  meta { id: "VYQL-VAL-017", severity: high, cwe: [CWE_20], confidence_floor: high }
  match code.UnvalidatedDependencyMapKeyDeserialization as field
}
