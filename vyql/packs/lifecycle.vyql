// Lifecycle / typestate rules beyond generic resource leaks.
module vypr.lifecycle;

rule LockNotReleased {
  meta { id: "VYQL-LIFE-001", severity: medium, cwe: [CWE_667] }
  match code.LockAcquire as l
  unless closed_by core.LockRelease
}

rule CiliumBroadTcFilterCleanup {
  meta { id: "VYQL-LIFE-002", severity: high, cwe: [CWE_755, CWE_284], confidence_floor: high }
  match code.CiliumBroadTcFilterCleanup as c
}

rule RecursiveJsonMarshalUnderLock {
  meta { id: "VYQL-LIFE-003", severity: low, cwe: [CWE_667], confidence_floor: medium }
  match code.RecursiveJsonMarshalUnderLock as m
}

rule StateMutationBeforeOperationPreconditions {
  meta { id: "VYQL-LIFE-004", severity: high, cwe: [CWE_696, CWE_460], confidence_floor: high }
  match code.StateMutationBeforeOperationPreconditions as op
}
