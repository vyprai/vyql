// Smart-contract weakness rules (Solidity). docs/05 rule packs.
package vypr.smartcontract;

// An attacker-controlled address/value reaching a low-level external call —
// arbitrary external call / value transfer (CWE-829).
rule ExternalCall {
  meta { id: "VYQL-SC-001", severity: high, cwe: [CWE_829] }
  taint core.UserControlledData -> code.ExternalCall
}

// Attacker-reachable selfdestruct / privileged destruct (CWE-284).
rule PrivilegedDestruct {
  meta { id: "VYQL-SC-002", severity: critical, cwe: [CWE_284] }
  taint core.UserControlledData -> code.PrivilegedOp
}

// Authorization decided by tx.origin — phishing-vulnerable (CWE-477). Presence:
// using tx.origin (instead of msg.sender) for auth is the anti-pattern itself.
rule TxOriginAuth {
  meta { id: "VYQL-SC-003", severity: high, cwe: [CWE_477] }
  match code.TxOriginAuth
}

// Reentrancy (CWE-841) — an external call BEFORE a state write on a CFG path violates
// checks-effects-interactions: the callee can re-enter before storage is updated. A
// temporal order-rule (B2 type-state) over the structured CFG.
rule Reentrancy {
  meta { id: "VYQL-SC-004", severity: high, cwe: [CWE_841] }
  order code.ExternalCall before code.StateWrite
}
