// Identity & privilege — escalation paths and toxic combinations (docs/09).
module vypr.identity;

rule ExternalToAdmin {
  meta { id: "VYQL-IDN-001", severity: critical }
  assume identity.ExternalPrincipal -> identity.AdminPrivilege
}

rule AnonymousToAdmin {
  meta { id: "VYQL-IDN-002", severity: critical }
  assume identity.Anonymous -> identity.AdminPrivilege
}

rule CiToSuperAdmin {
  meta { id: "VYQL-IDN-003", severity: high }
  assume identity.CiPrincipal -> identity.SuperAdminPrivilege
}

// Toxic combination: an internet-reachable workload whose identity can escalate
// to admin — a single match composing the reach and assume solvers.
rule ToxicWorkloadExposure {
  meta { id: "VYQL-IDN-004", severity: critical }
  match identity.WorkloadIdentity as w
  where reach(cloud.Internet, w.workload) and assume(w, identity.AdminPrivilege)
}
