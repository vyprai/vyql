// Cloud posture — public exposure of sensitive data stores (docs/09).
module vypr.cloud;

rule PublicSensitiveDatabase {
  meta { id: "VYQL-CLD-001", severity: critical }
  reach cloud.Internet -> cloud.Database
  where cloud.Database holds_asset_kind [data.Pii]
}

rule PublicObjectStore {
  meta { id: "VYQL-CLD-002", severity: high }
  reach cloud.Internet -> cloud.ObjectStore
}

rule PublicSecretStore {
  meta { id: "VYQL-CLD-003", severity: critical }
  reach cloud.Internet -> cloud.SecretStore
}

rule PublicStorageSensitive {
  meta { id: "VYQL-CLD-004", severity: critical }
  match cloud.PublicStorage as s
  where s holds_asset_kind [data.Pii]
}
