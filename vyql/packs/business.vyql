// Business logic — declared-model Mode 1 (docs/12): unauthorized actions and
// invalid state transitions.
module vypr.business;

rule UnauthorizedRefund {
  meta { id: "VYQL-BIZ-001", severity: high }
  match business.Refund as a
  unless guarded_by core.AuthorizationCheck
}

rule InvalidRefundTransition {
  meta { id: "VYQL-BIZ-002", severity: high }
  match transition * -> Refunded on Order as t
}
