// Memory-safety weakness rules. These are exploitability-aware: taint rules mean
// attacker-controlled data reaches a memory-sensitive operand; match rules are
// assumption-gated smells with exploit conditions attached by adapters.
module vypr.memory;

rule TaintedUnboundedCopy {
  meta { id: "VYQL-MEM-001", severity: high, cwe: [CWE_787, CWE_120] }
  taint core.UserControlledData -> code.UnboundedCopy
}

rule PotentialUnboundedCopy {
  meta { id: "VYQL-MEM-002", severity: medium, cwe: [CWE_787, CWE_120], confidence_floor: low }
  match code.UnboundedCopySmell as c
}

rule TaintedRawMemoryCopySize {
  meta { id: "VYQL-MEM-003", severity: high, cwe: [CWE_787] }
  taint core.UserControlledData -> code.RawMemoryCopySize
}

rule PotentialRawMemoryCopySize {
  meta { id: "VYQL-MEM-016", severity: medium, cwe: [CWE_119, CWE_787], confidence_floor: low }
  match code.RawMemoryCopySize as c
}

rule MissingPostCopyBoundsCheck {
  meta { id: "VYQL-MEM-020", severity: high, cwe: [CWE_787], confidence_floor: medium }
  match code.MissingPostCopyBoundsCheck as c
}

rule UnderallocatedFormattedAddressList {
  meta { id: "VYQL-MEM-021", severity: high, cwe: [CWE_787], confidence_floor: medium }
  match code.UnderallocatedFormattedAddressList as c
}

rule PythonUnicodeEscapeWideUnderallocation {
  meta { id: "VYQL-MEM-030", severity: high, cwe: [CWE_787], confidence_floor: high }
  match code.PythonUnicodeEscapeWideUnderallocation as c
}

rule ContikiSicslowpanFragmentOffsetOobWrite {
  meta { id: "VYQL-MEM-028", severity: high, cwe: [CWE_787], confidence_floor: high }
  match code.ContikiSicslowpanFragmentOffsetOobWrite as c
}

rule LibreOfficeEnhwmfDibHeaderSizeUnderflow {
  meta { id: "VYQL-MEM-029", severity: high, cwe: [CWE_190, CWE_787], confidence_floor: high }
  match code.LibreOfficeEnhwmfDibHeaderSizeUnderflow as c
}

rule BinarySearchTableIndexGuardBypass {
  meta { id: "VYQL-MEM-022", severity: medium, cwe: [CWE_125, CWE_129], confidence_floor: medium }
  match code.BinarySearchTableIndexGuardBypass as idx
}

rule CompressedBlockSizeCapacityMismatch {
  meta { id: "VYQL-MEM-023", severity: high, cwe: [CWE_787], confidence_floor: medium }
  match code.CompressedBlockSizeCapacityMismatch as c
}

rule ChakraScopeSlotArrayUncheckedIndex {
  meta { id: "VYQL-MEM-024", severity: high, cwe: [CWE_129, CWE_125, CWE_787], confidence_floor: medium }
  match code.ChakraScopeSlotArrayUncheckedIndex as idx
}

rule StackAllocationSmell {
  meta { id: "VYQL-MEM-004", severity: low, cwe: [CWE_400], confidence_floor: low }
  match code.StackAllocationSmell as a
}

rule TaintedIndexAccess {
  meta { id: "VYQL-MEM-005", severity: high, cwe: [CWE_125, CWE_787] }
  taint core.UserControlledData -> code.IndexAccess
}

rule PotentialNullDeref {
  meta { id: "VYQL-MEM-006", severity: low, cwe: [CWE_476], confidence_floor: low }
  match code.NullableDeref as d
}

rule SignedMessageLengthUnderflowCopy {
  meta { id: "VYQL-MEM-031", severity: high, cwe: [CWE_121, CWE_122, CWE_191], confidence_floor: high }
  match code.SignedMessageLengthUnderflowCopy as c
}

rule LengthMultiplierFormattedExpansionUnderallocation {
  meta { id: "VYQL-MEM-033", severity: high, cwe: [CWE_787, CWE_190], confidence_floor: high }
  match code.LengthMultiplierFormattedExpansionUnderallocation as c
}

rule Fat12SuccessorEntryBoundsBypass {
  meta { id: "VYQL-MEM-034", severity: high, cwe: [CWE_125, CWE_787, CWE_193], confidence_floor: high }
  match code.Fat12SuccessorEntryBoundsBypass as c
}

rule PotentialUseAfterFree {
  meta { id: "VYQL-MEM-007", severity: high, cwe: [CWE_416], confidence_floor: low }
  order code.PointerFree before code.PointerUse
}

rule PotentialDoubleFree {
  meta { id: "VYQL-MEM-008", severity: high, cwe: [CWE_415], confidence_floor: low }
  order code.PointerFree before code.PointerFree
}

rule PotentialUnsafeMutableAlias {
  meta { id: "VYQL-MEM-009", severity: medium, cwe: [CWE_787, CWE_416], confidence_floor: low }
  match code.UnsafeMutableAlias as a
}

rule PotentialFfiEnumLayoutRisk {
  meta { id: "VYQL-MEM-014", severity: medium, cwe: [CWE_119], confidence_floor: low }
  match code.FfiEnumLayoutRisk as e
}

rule PotentialUninitializedBufferExposure {
  meta { id: "VYQL-MEM-015", severity: medium, cwe: [CWE_908], confidence_floor: medium }
  match code.UninitializedBufferExposure as b
}

rule PotentialFieldDerivedIndexAccess {
  meta { id: "VYQL-MEM-010", severity: medium, cwe: [CWE_129, CWE_125, CWE_787], confidence_floor: low }
  match code.FieldDerivedIndexAccess as idx
}

rule FailurePathOwnedBufferFree {
  meta { id: "VYQL-MEM-011", severity: high, cwe: [CWE_415], confidence_floor: low }
  match code.FailurePathOwnedBufferFree as free
}

rule ReentrantQueueCleanup {
  meta { id: "VYQL-MEM-019", severity: high, cwe: [CWE_415, CWE_416], confidence_floor: medium }
  match code.ReentrantQueueCleanupReview as cleanup
}

rule PotentialZeroSizeReallocation {
  meta { id: "VYQL-MEM-012", severity: high, cwe: [CWE_415], confidence_floor: low }
  taint code.ComputedSizeValue -> code.ZeroSizeReallocation
    unless sanitized_by core.ZeroValueExclusion
}

rule EscapedTerminatorWrite {
  meta { id: "VYQL-MEM-013", severity: medium, cwe: [CWE_119, CWE_125, CWE_787], confidence_floor: medium }
  match code.EscapedTerminatorWrite as w
}

rule CjsonTrailingBackslashStringOverread {
  meta { id: "VYQL-MEM-025", severity: high, cwe: [CWE_125], confidence_floor: high }
  match code.CjsonTrailingBackslashStringOverread as read
}

rule UnboundedFileReadIntoFixedBuffer {
  meta { id: "VYQL-MEM-032", severity: high, cwe: [CWE_787, CWE_121], confidence_floor: high }
  match code.UnboundedFileReadIntoFixedBuffer as write
}

rule ClamavWwpackStructsPointerOobWrite {
  meta { id: "VYQL-MEM-026", severity: high, cwe: [CWE_787], confidence_floor: high }
  match code.ClamavWwpackStructsPointerOobWrite as write
}

rule ClaxonResidualPartitionBufferExposure {
  meta { id: "VYQL-MEM-027", severity: high, cwe: [CWE_908], confidence_floor: high }
  match code.ClaxonResidualPartitionBufferExposure as exposure
}

rule CountDerivedElementAccess {
  meta { id: "VYQL-MEM-017", severity: medium, cwe: [CWE_129, CWE_125, CWE_787], confidence_floor: medium }
  match code.CountDerivedElementAccess as idx
  unless guarded_by core.MemoryBoundsCheck
}

rule UncheckedNullableResultDeref {
  meta { id: "VYQL-MEM-018", severity: medium, cwe: [CWE_476], confidence_floor: medium }
  match code.UncheckedNullableResultDeref as deref
}
