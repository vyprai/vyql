// Supply chain — vulnerable dependencies, reachability-gated (docs/11).
package vypr.sca;

rule VulnerableDependency {
  meta { id: "VYQL-SCA-001", severity: medium }
  match sbom.VulnerableDependency as p
}

rule ReachableVulnerableDependency {
  meta { id: "VYQL-SCA-002", severity: high }
  match sbom.VulnerableDependency as p
  where p has sbom.ReachableSymbol
}

// A dependency name that typosquats a popular package (or is on a known-bad list) —
// name-intelligence, not a CVE feed (CWE-1357).
rule SuspiciousDependency {
  meta { id: "VYQL-SCA-003", severity: high, cwe: [CWE_1357] }
  match sbom.SuspiciousDependency as p
}
