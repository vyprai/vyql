# A7 — IaC / container misconfiguration (CWE-250/653/284). The config frontend scans
# Dockerfiles, Kubernetes YAML, and Terraform; dangerous settings are presence findings.
# Benign files yield nothing.

test "iac: Dockerfile USER root is flagged"
  lang config
  expect VYQL-CFG-010
  file Dockerfile
  ```
  FROM alpine
  USER root
  ```

test "iac: Dockerfile non-root USER is clean"
  lang config
  reject VYQL-CFG-010
  file Dockerfile
  ```
  FROM alpine
  USER app
  ```

test "iac: K8s privileged container is flagged"
  lang config
  expect VYQL-CFG-010
  file pod.yaml
  ```
  apiVersion: v1
  kind: Pod
  spec:
    containers:
    - name: app
      securityContext:
        privileged: true
  ```

test "iac: K8s hostNetwork is flagged"
  lang config
  expect VYQL-CFG-011
  file pod.yaml
  ```
  apiVersion: v1
  kind: Pod
  spec:
    hostNetwork: true
  ```

test "iac: Terraform open CIDR 0.0.0.0/0 is flagged"
  lang config
  expect VYQL-CFG-012
  file sg.tf
  ```
  resource "aws_security_group" "x" {
    ingress {
      cidr_blocks = ["0.0.0.0/0"]
    }
  }
  ```

test "iac: Terraform wildcard IAM action is flagged"
  lang config
  expect VYQL-CFG-013
  file iam.tf
  ```
  resource "aws_iam_policy" "x" {
    policy = jsonencode({
      Statement = [{ Action = "*" }]
    })
  }
  ```
