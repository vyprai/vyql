# Rank 146 / CVE-2026-8679: AudioIgniter returned playlist track data from a
# public playlist JSON endpoint without verifying publish status or read access.

test "rank146: php wordpress public playlist endpoint without read policy is review attention"
  lang php
  expect_review code.IdorPolicyReview
  code
  ```
  <?php
  class AudioIgniter {
    public function handle_playlist_endpoint() {
      global $wp_query;
      $playlist_id = $wp_query->get('audioigniter_playlist_id');
      if (empty($playlist_id)) {
        return;
      }
      $playlist_id = intval($playlist_id);
      $post = get_post($playlist_id);
      if (empty($post) || $post->post_type !== $this->post_type) {
        wp_send_json_error("ID doesn't match a playlist");
      }
      $tracks = $this->get_post_meta($playlist_id, '_audioigniter_tracks', array());
      wp_send_json($tracks);
    }
  }
  ?>
  ```

test "rank146: php wordpress public playlist endpoint with publish/read policy is clean"
  lang php
  expect_review core.AuthorizationCheck
  reject_review code.IdorPolicyReview
  code
  ```
  <?php
  class AudioIgniter {
    public function handle_playlist_endpoint() {
      global $wp_query;
      $playlist_id = $wp_query->get('audioigniter_playlist_id');
      if (empty($playlist_id)) {
        return;
      }
      $playlist_id = (int) $playlist_id;
      $post = get_post($playlist_id);
      if (empty($post) || $post->post_type !== $this->post_type) {
        wp_send_json_error("ID doesn't match a playlist");
      }
      if ((!is_user_logged_in() && 'publish' !== $post->post_status) ||
          (is_user_logged_in() && !current_user_can('read_post', $playlist_id))) {
        wp_send_json_error('Sorry, you are not allowed to access this playlist.');
      }
      $tracks = $this->get_post_meta($playlist_id, '_audioigniter_tracks', array());
      wp_send_json($tracks);
    }
  }
  ?>
  ```
