# C language-gap narrowing: exhaustive coverage for adapter-claimed native idioms.

test "c exhaustive: argv and environment input reach SQL command dynamic-load and path sinks"
  lang c
  expect VYQL-INJ-001
  expect VYQL-INJ-002
  expect VYQL-INJ-023
  expect VYQL-PATH-001
  code
  ```
  void handler(int argc, char **argv, sqlite3 *db) {
    char *q = getenv("QUERY");
    sqlite3_exec(db, q, 0, 0, 0);
    mysql_query(conn, q);
    PQexec(pg, q);
    system(argv[1]);
    popen(argv[1], "r");
    dlopen(argv[2], RTLD_NOW);
    fopen(argv[3], "r");
    open(argv[3], O_RDONLY);
  }
  ```

test "c exhaustive: realpath and shell escaping suppress path and command findings"
  lang c
  reject VYQL-INJ-002
  reject VYQL-PATH-001
  code
  ```
  void handler(int argc, char **argv) {
    char resolved[4096];
    system(escape_shell(argv[1]));
    fopen(realpath(argv[2], resolved), "r");
  }
  ```

