  reject VYQL-INJ-004
  reject VYQL-INJ-005
  reject VYQL-INJ-006
  reject VYQL-INJ-011
  reject VYQL-DOS-001
  code
  ```
  void handler(int argc, char **argv) {
    fputs(escape_html(argv[1]), stdout);
    ldap_search_s(ld, "dc=x", LDAP_SCOPE_SUBTREE, encode_for_ldap(argv[1]), NULL, 0, &res);
    xmlXPathEvalExpression(escape_xpath(argv[1]), ctx);
    printf("%s", argv[1]);
    regcomp(&re, "^[a-z]+$", 0);
  }
  ```

