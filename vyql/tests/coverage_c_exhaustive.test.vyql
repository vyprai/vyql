test "c exhaustive: released locks are clean"
  lang c
  reject VYQL-LIFE-001
  code
  ```
  void handler() {
    pthread_mutex_lock(&m);
    pthread_mutex_unlock(&m);
  }
  ```

test "c exhaustive: insecure permissions temp files weak crypto static IV and weak RNG are reported"
  lang c
  expect VYQL-CFG-008
  expect VYQL-PATH-003
  expect VYQL-CRY-001
  expect VYQL-CRY-002
  expect VYQL-CRY-003
  expect VYQL-CRY-004
  code
  ```
  void handler() {
    chmod("/tmp/x", 0777);
    open("/tmp/x", O_CREAT, 0666);
    mktemp(buf);
    tmpnam(buf);
    MD5_Init(&ctx);
    DES_set_key(key, schedule);
    EVP_EncryptInit_ex(ctx, EVP_aes_128_cbc(), NULL, key, "0000000000000000");
    rand();
  }
  ```

