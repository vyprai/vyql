# Alias-level coverage for newly added parity mappings that are not exercised by
# the primary concept specs. These are intentionally small smoke tests: each one
# proves a concrete adapter pattern reaches the shipped rule it claims.

test "c: decrypt init with static IV is reported"
  lang c
  expect VYQL-CRY-004
  code
  ```
  void f() {
    EVP_DecryptInit_ex(ctx, cipher, NULL, key, "0000000000000000");
  }
  ```

test "cpp: decrypt init with static IV is reported"
  lang cpp
  expect VYQL-CRY-004
  code
  ```
  void f() {
    EVP_DecryptInit_ex(ctx, cipher, nullptr, key, "0000000000000000");
  }
  ```

test "dart: extractFile alias reports archive traversal"
  lang dart
  expect VYQL-PATH-004
  code
  ```
  void handler(Request request, Archive archive) {
    archive.extractFile(request.params["name"]);
  }
  ```

test "dart: extractArchiveToDisk alias reports archive traversal"
  lang dart
  expect VYQL-PATH-004
  code
  ```
  void handler(Request request, Archive archive) {
    extractArchiveToDisk(archive, request.params["name"]);
  }
  ```

test "dart: File.open resource handle leaks"
  lang dart
  expect VYQL-RES-001
  code
  ```
  void f() {
    final h = File.open("data.txt");
    h.readByte();
  }
  ```

test "dart: File.openRead resource handle leaks"
  lang dart
  expect VYQL-RES-001
  code
  ```
  void f() {
    final h = File.openRead("data.txt");
    h.listen((x) {});
  }
  ```

test "dart: File.openWrite resource handle leaks"
  lang dart
  expect VYQL-RES-001
  code
  ```
  void f() {
    final h = File.openWrite("data.txt");
    h.write("x");
  }
  ```

test "groovy: ZipFile.extract alias reports archive traversal"
  lang groovy
  expect VYQL-PATH-004
  code
  ```
  def handler(zip) {
    ZipFile.extract(zip, params.name)
  }
  ```

test "groovy: deserialize alias reports unsafe deserialization"
  lang groovy
  expect VYQL-DESER-001
  code
  ```
  def handler(stream) {
    stream.deserialize(params.payload)
  }
  ```

test "groovy: Socket resource handle leaks"
  lang groovy
  expect VYQL-RES-001
  code
  ```
  def f() {
    def s = new Socket("example.com", 443)
    s.getInputStream()
  }
  ```

test "groovy: FileOutputStream resource handle leaks"
  lang groovy
  expect VYQL-RES-001
  code
  ```
  def f() {
    def h = new FileOutputStream("data.txt")
    h.write(1)
  }
  ```

test "kotlin: FileInputStream resource handle leaks"
  lang kotlin
  expect VYQL-RES-001
  code
  ```
  fun f() {
    val h = FileInputStream("data.txt")
    h.read()
  }
  ```

test "kotlin: FileOutputStream resource handle leaks"
  lang kotlin
  expect VYQL-RES-001
  code
  ```
  fun f() {
    val h = FileOutputStream("data.txt")
    h.write(1)
  }
  ```

test "lua: socket.tcp resource handle leaks"
  lang lua
  expect VYQL-RES-001
  code
  ```
  function f()
    local h = socket.tcp()
    h:connect("example.com", 443)
  end
  ```

test "perl: Archive::Extract extract alias reports archive traversal"
  lang perl
  expect VYQL-PATH-004
  code
  ```
  sub handler {
    my $name = param("name");
    Archive::Extract::extract($zip, $name);
  }
  ```

test "perl: IO::Socket::INET resource handle leaks"
  lang perl
  expect VYQL-RES-001
  code
  ```
  sub f {
    my $s = IO::Socket::INET->new(PeerHost => "example.com", PeerPort => 443);
    print $s "x";
  }
  ```

test "scala: Files.newInputStream resource handle leaks"
  lang scala
  expect VYQL-RES-001
  code
  ```
  object T {
    def f() = {
      val h = Files.newInputStream(path)
      h.read()
    }
  }
  ```

test "scala: Files.newOutputStream resource handle leaks"
  lang scala
  expect VYQL-RES-001
  code
  ```
  object T {
    def f() = {
      val h = Files.newOutputStream(path)
      h.write(1)
    }
  }
  ```

test "swift: FileHandle.forWritingAtPath resource handle leaks"
  lang swift
  expect VYQL-RES-001
  code
  ```
  func f() {
    let h = FileHandle.forWritingAtPath("data.txt")
    h.write(Data())
  }
  ```
