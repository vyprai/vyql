# OWASP-replica coverage for Ruby/Rails — true positives plus precision patterns
# (opaque-predicate pruning, container element-sensitivity) unlocked by the parity port.

# --- SQL injection (INJ-001) ---
test "ruby: params -> where(string) is SQLi"
  lang ruby
  expect VYQL-INJ-001
  code
  ```
  def h
    p = params[:id]
    User.where("id = " + p)
  end
  ```

test "ruby: opaque if/else assigns a constant on the live branch — clean SQLi"
  lang ruby
  reject VYQL-INJ-001
  code
  ```
  def h
    p = params[:id]
    num = 88
    if (7*42)-num > 200 then bar = "safe" else bar = "alsosafe" end
    User.where("id = " + bar)
  end
  ```

test "ruby: ternary routes to a constant — clean SQLi"
  lang ruby
  reject VYQL-INJ-001
  code
  ```
  def h
    p = params[:id]
    num = 106
    bar = ((7*18)+num > 200) ? "safe" : p
    User.where("id = " + bar)
  end
  ```

# --- command injection (INJ-002) ---
test "ruby: params -> system is command injection"
  lang ruby
  expect VYQL-INJ-002
  code
  ```
  def h
    p = params[:cmd]
    system("ls " + p)
  end
  ```

# --- code injection (INJ-003) ---
test "ruby: params -> eval is code injection"
  lang ruby
  expect VYQL-INJ-003
  code
  ```
  def h
    p = params[:x]
    eval(p)
  end
  ```
