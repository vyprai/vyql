# Interprocedural / multi-file call-trace tests: untrusted input enters in one file
# (a framework entrypoint) and reaches a sink in another, through 2-3 hops. Each
# weakness has positive (vulnerable) and negative (sanitized / parameterized) forms,
# with the neutralization placed in the SOURCE file, an INTERMEDIATE file, the SINK
# file, or provided by the framework.
#
# Engine cross-file support (see vyql/tests/README): Python, Ruby, PHP, Go, Java, and
# JavaScript all trace across files (controller/service/repo, DI fields, CommonJS exports).

# ============================================================================
# Python (Flask) — full interprocedural
# ============================================================================

test "py: Flask view -> service -> repo, raw SQL is SQLi (3-hop)"
  lang python
  expect VYQL-INJ-001
  file views.py
  ```
  from service import handle
  def index():
      handle(request.args['name'])
  ```
  file service.py
  ```
  from repo import run
  def handle(v):
      run(v)
  ```
  file repo.py
  ```
  def run(value):
      cursor.execute("SELECT * FROM users WHERE name = '" + value + "'")
  ```

test "py: parameterized query in the repo (sink file) is clean"
  lang python
  reject VYQL-INJ-001
  file views.py
  ```
  from repo import run
  def index():
      run(request.args['name'])
  ```
  file repo.py
  ```
  def run(value):
      cursor.execute("SELECT * FROM users WHERE name = %s", (value,))
  ```

test "py: command injection across files is positive"
  lang python
  expect VYQL-INJ-002
  file views.py
  ```
  from runner import run
  def index():
      run(request.args['host'])
  ```
  file runner.py
  ```
  import os
  def run(value):
      os.system("ping " + value)
  ```

test "py: shlex.quote in the INTERMEDIATE file neutralizes the command injection"
  lang python
  reject VYQL-INJ-002
  file views.py
  ```
  from service import handle
  def index():
      handle(request.args['host'])
  ```
  file service.py
  ```
  import shlex
  from runner import run
  def handle(v):
      run(shlex.quote(v))
  ```
  file runner.py
  ```
  import os
  def run(value):
      os.system("ping " + value)
  ```

test "py: XSS across files (Markup sink) is positive"
  lang python
  expect VYQL-INJ-004
  file views.py
  ```
  from render import show
  def index():
      show(request.args['name'])
  ```
  file render.py
  ```
  def show(v):
      return Markup(v)
  ```

test "py: html.escape in the SOURCE file neutralizes the XSS"
  lang python
  reject VYQL-INJ-004
  file views.py
  ```
  import html
  from render import show
  def index():
      show(html.escape(request.args['name']))
  ```
  file render.py
  ```
  def show(v):
      return Markup(v)
  ```

test "py: html.escape in the SINK file neutralizes the XSS"
  lang python
  reject VYQL-INJ-004
  file views.py
  ```
  from render import show
  def index():
      show(request.args['name'])
  ```
  file render.py
  ```
  import html
  def show(v):
      return Markup(html.escape(v))
  ```

test "py: one safe route does not suppress a second vulnerable route"
  lang python
  expect VYQL-INJ-001
  file views.py
  ```
  from repo import run
  def safe():
      run_safe(request.args['a'])
  def vuln():
      run(request.args['b'])
  ```
  file repo.py
  ```
  def run_safe(value):
      cursor.execute("SELECT * FROM t WHERE a = %s", (value,))
  def run(value):
      cursor.execute("SELECT * FROM t WHERE b = '" + value + "'")
  ```

# ============================================================================
# Ruby (Rails) — full interprocedural
# ============================================================================

test "ruby: controller -> service -> model, raw SQL is SQLi (3-hop)"
  lang ruby
  expect VYQL-INJ-001
  file users_controller.rb
  ```
  class UsersController
    def search; Service.handle(params[:name]); end
  end
  ```
  file service.rb
  ```
  class Service
    def self.handle(v); Repo.run(v); end
  end
  ```
  file repo.rb
  ```
  class Repo
    def self.run(value)
      ActiveRecord::Base.connection.execute("SELECT * FROM users WHERE name = '" + value + "'")
    end
  end
  ```

test "ruby: parameterized where across files is clean (framework)"
  lang ruby
  reject VYQL-INJ-001
  file c.rb
  ```
  class C
    def search; Repo.run(params[:name]); end
  end
  ```
  file repo.rb
  ```
  class Repo
    def self.run(value)
      User.where("name = ?", value)
    end
  end
  ```

test "ruby: ActiveRecord hash condition across files is clean (framework)"
  lang ruby
  reject VYQL-INJ-001
  file c.rb
  ```
  class C
    def search; Repo.run(params[:name]); end
  end
  ```
  file repo.rb
  ```
  class Repo
    def self.run(value)
      User.where(name: value)
    end
  end
  ```

test "ruby: Shellwords.escape in the SINK file neutralizes the command injection"
  lang ruby
  reject VYQL-INJ-002
  file c.rb
  ```
  class C
    def ping; Runner.run(params[:host]); end
  end
  ```
  file runner.rb
  ```
  require 'shellwords'
  class Runner
    def self.run(value)
      system("ping " + Shellwords.escape(value))
    end
  end
  ```

test "ruby: command injection across files (no escape) is positive"
  lang ruby
  expect VYQL-INJ-002
  file c.rb
  ```
  class C
    def ping; Runner.run(params[:host]); end
  end
  ```
  file runner.rb
  ```
  class Runner
    def self.run(value)
      system("ping " + value)
    end
  end
  ```

# ============================================================================
# PHP — full interprocedural
# ============================================================================

test "php: controller -> service -> dao, raw SQL is SQLi (3-hop)"
  lang php
  expect VYQL-INJ-001
  file ctrl.php
  ```
  <?php require 'service.php'; function h($c) { svc($c, $_GET['name']); }
  ```
  file service.php
  ```
  <?php require 'dao.php'; function svc($c, $v) { dao($c, $v); }
  ```
  file dao.php
  ```
  <?php function dao($c, $value) { mysqli_query($c, "SELECT * FROM u WHERE n='" . $value . "'"); }
  ```

test "php: mysqli_real_escape_string in the SOURCE file neutralizes the SQLi"
  lang php
  reject VYQL-INJ-001
  file ctrl.php
  ```
  <?php require 'dao.php';
  function h($c) { dao($c, mysqli_real_escape_string($c, $_GET['name'])); }
  ```
  file dao.php
  ```
  <?php function dao($c, $value) { mysqli_query($c, "SELECT * FROM u WHERE n='" . $value . "'"); }
  ```

test "php: command injection across files is positive"
  lang php
  expect VYQL-INJ-002
  file ctrl.php
  ```
  <?php require 'runner.php'; function h() { run($_GET['host']); }
  ```
  file runner.php
  ```
  <?php function run($value) { system("ping " . $value); }
  ```

test "php: escapeshellarg in the SINK file neutralizes the command injection"
  lang php
  reject VYQL-INJ-002
  file ctrl.php
  ```
  <?php require 'runner.php'; function h() { run($_GET['host']); }
  ```
  file runner.php
  ```
  <?php function run($value) { system("ping " . escapeshellarg($value)); }
  ```

# ============================================================================
# Go — full interprocedural (same package, multiple files)
# ============================================================================

test "go: handler -> service -> repo, raw SQL is SQLi (3-hop)"
  lang go
  expect VYQL-INJ-001
  file h.go
  ```
  package app
  import "net/http"
  func handler(r *http.Request) { svc(r.URL.Query().Get("name")) }
  ```
  file service.go
  ```
  package app
  func svc(v string) { repo(v) }
  ```
  file repo.go
  ```
  package app
  func repo(value string) { db.Query("SELECT * FROM u WHERE n = '" + value + "'") }
  ```

test "go: parameterized query in the repo is clean"
  lang go
  reject VYQL-INJ-001
  file h.go
  ```
  package app
  import "net/http"
  func handler(r *http.Request) { repo(r.URL.Query().Get("name")) }
  ```
  file repo.go
  ```
  package app
  func repo(value string) { db.Query("SELECT * FROM u WHERE n = $1", value) }
  ```

test "go: OIDC issuer extracted from bearer token reaches provider discovery as SSRF"
  lang go
  expect VYQL-RF-001
  file exchange.go
  ```
  package app
  import (
    "context"
    auth "chainguard.dev/sdk/auth"
  )
  func Exchange(ctx context.Context, bearer string) error {
    issuer, err := auth.ExtractIssuer(bearer)
    if err != nil { return err }
    _, err = Get(ctx, issuer)
    return err
  }
  ```
  file provider.go
  ```
  package app
  import (
    "context"
    "github.com/coreos/go-oidc/v3/oidc"
  )
  func Get(ctx context.Context, issuer string) (any, error) {
    return newProviderWithRetry(ctx, issuer)
  }
  func newProviderWithRetry(ctx context.Context, issuer string) (any, error) {
    return oidc.NewProvider(ctx, issuer)
  }
  ```

test "go: OIDC issuer extracted from bearer token reaches direct provider discovery as SSRF"
  lang go
  expect VYQL-RF-001
  file exchange.go
  ```
  package app
  import (
    "context"
    auth "chainguard.dev/sdk/auth"
    "github.com/coreos/go-oidc/v3/oidc"
  )
  func Exchange(ctx context.Context, bearer string) error {
    issuer, err := auth.ExtractIssuer(bearer)
    if err != nil { return err }
    _, err = oidc.NewProvider(ctx, issuer)
    return err
  }
  ```

test "go: OIDC issuer validation guards provider discovery SSRF"
  lang go
  reject VYQL-RF-001
  file exchange.go
  ```
  package app
  import (
    "context"
    auth "chainguard.dev/sdk/auth"
    "github.com/octo-sts/app/pkg/oidcvalidate"
  )
  func Exchange(ctx context.Context, bearer string) error {
    issuer, err := auth.ExtractIssuer(bearer)
    if err != nil { return err }
    if !oidcvalidate.IsValidIssuer(issuer) { return nil }
    _, err = Get(ctx, issuer)
    return err
  }
  ```
  file provider.go
  ```
  package app
  import (
    "context"
    "github.com/coreos/go-oidc/v3/oidc"
  )
  func Get(ctx context.Context, issuer string) (any, error) {
    return newProviderWithRetry(ctx, issuer)
  }
  func newProviderWithRetry(ctx context.Context, issuer string) (any, error) {
    return oidc.NewProvider(ctx, issuer)
  }
  ```

# ============================================================================
# JavaScript (Express) — CommonJS require + exports
# ============================================================================

test "js: route -> required db module (exports.fn) raw SQL is SQLi"
  lang javascript
  expect VYQL-INJ-001
  file routes.js
  ```
  const db = require('./db');
  app.get('/u', (req, res) => { db.run(req.query.name); });
  ```
  file db.js
  ```
  exports.run = function (value) {
    connection.query("SELECT * FROM users WHERE name = '" + value + "'");
  };
  ```

test "js: route -> module.exports object method raw SQL is SQLi"
  lang javascript
  expect VYQL-INJ-001
  file routes.js
  ```
  const db = require('./db');
  app.get('/u', (req, res) => { db.lookup(req.query.name); });
  ```
  file db.js
  ```
  module.exports = { lookup: function (q) { connection.query("SELECT * FROM u WHERE n='" + q + "'"); } };
  ```

test "js: parameterized query in the required module is clean"
  lang javascript
  reject VYQL-INJ-001
  file routes.js
  ```
  const db = require('./db');
  app.get('/u', (req, res) => { db.run(req.query.name); });
  ```
  file db.js
  ```
  exports.run = function (value) {
    connection.query("SELECT * FROM users WHERE name = $1", [value]);
  };
  ```

# ============================================================================
# Java (Spring) — controller -> service -> repository across classes/files
# ============================================================================

test "java: @RestController -> @Autowired service -> repo raw SQL is SQLi"
  lang java
  expect VYQL-INJ-001
  file UserController.java
  ```
  @RestController
  public class UserController {
    @Autowired UserService service;
    @GetMapping("/u")
    public void get(@RequestParam String name) throws Exception { service.handle(name); }
  }
  ```
  file UserService.java
  ```
  public class UserService {
    @Autowired UserRepo repo;
    public void handle(String v) throws Exception { repo.run(v); }
  }
  ```
  file UserRepo.java
  ```
  public class UserRepo {
    public void run(String value) throws Exception {
      stmt.executeQuery("SELECT * FROM users WHERE name = '" + value + "'");
    }
  }
  ```

test "java: a parameterized PreparedStatement in the repo is clean"
  lang java
  reject VYQL-INJ-001
  file UserController.java
  ```
  @RestController
  public class UserController {
    @Autowired UserService service;
    @GetMapping("/u")
    public void get(@RequestParam String name) throws Exception { service.handle(name); }
  }
  ```
  file UserService.java
  ```
  public class UserService {
    @Autowired UserRepo repo;
    public void handle(String v) throws Exception { repo.run(v); }
  }
  ```
  file UserRepo.java
  ```
  public class UserRepo {
    public void run(String value) throws Exception {
      PreparedStatement ps = conn.prepareStatement("SELECT * FROM users WHERE name = ?");
      ps.setString(1, value);
    }
  }
  ```

test "java: servlet -> new-instance service -> repo command injection"
  lang java
  expect VYQL-INJ-002
  file Ctrl.java
  ```
  public class Ctrl {
    void get(HttpServletRequest request) throws Exception {
      new Runner().run(request.getParameter("host"));
    }
  }
  ```
  file Runner.java
  ```
  public class Runner {
    void run(String value) throws Exception {
      Runtime.getRuntime().exec("ping " + value);
    }
  }
  ```
