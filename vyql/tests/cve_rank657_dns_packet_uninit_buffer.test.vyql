test "rank657: dns-packet allocUnsafe length does not match trimmed name encoder"
  lang javascript
  expect VYQL-MEM-015
  code
  ```
  const name = exports.name = {}

  name.encode = function (str, buf, offset) {
    if (!buf) buf = Buffer.allocUnsafe(name.encodingLength(str))
    if (!offset) offset = 0
    const oldOffset = offset
    const n = str.replace(/^\.|\.$/gm, '')
    if (n.length) {
      const list = n.split('.')
      for (let i = 0; i < list.length; i++) {
        const len = buf.write(list[i], offset + 1)
        buf[offset] = len
        offset += len + 1
      }
    }
    buf[offset++] = 0
    name.encode.bytes = offset - oldOffset
    return buf
  }

  name.encodingLength = function (n) {
    if (n === '.') return 1
    return Buffer.byteLength(n) + 2
  }
  ```

test "rank657: dns-packet encodingLength trims before sizing allocUnsafe"
  lang javascript
  reject VYQL-MEM-015
  code
  ```
  const name = exports.name = {}

  name.encode = function (str, buf, offset) {
    if (!buf) buf = Buffer.allocUnsafe(name.encodingLength(str))
    if (!offset) offset = 0
    const oldOffset = offset
    const n = str.replace(/^\.|\.$/gm, '')
    if (n.length) {
      const list = n.split('.')
      for (let i = 0; i < list.length; i++) {
        const len = buf.write(list[i], offset + 1)
        buf[offset] = len
        offset += len + 1
      }
    }
    buf[offset++] = 0
    name.encode.bytes = offset - oldOffset
    return buf
  }

  name.encodingLength = function (n) {
    if (n === '.') return 1
    return Buffer.byteLength(n.replace(/^\.|\.$/gm, '')) + 2
  }
  ```
