# Rank 491 / CVE-2023-37474: copyparty served /.cpr static files by
# joining the request vpath under the embedded web directory. Encoded absolute
# paths such as /.cpr/%2Fetc%2Fpasswd could make os.path.join discard the base.

test "rank491: copyparty cpr static path joins request vpath"
  lang python
  expect VYQL-PATH-025
  expect_review code.CopypartyCprStaticPathTraversal
  code
  ```
  import os

  class HttpCli:
      def handle_get(self):
          if self.vpath.startswith(".cpr"):
              if self.vpath.startswith(".cpr/ico/"):
                  return self.tx_ico(self.vpath.split("/")[-1], exact=True)
              static_path = os.path.join(self.E.mod, "web/", self.vpath[5:])
              return self.tx_file(static_path)
  ```

test "rank491: copyparty cpr static path is canonicalized and contained"
  lang python
  reject VYQL-PATH-025
  reject_review code.CopypartyCprStaticPathTraversal
  code
  ```
  import os
  from copyparty.util import absreal

  class HttpCli:
      def handle_get(self):
          if self.vpath.startswith(".cpr"):
              if self.vpath.startswith(".cpr/ico/"):
                  return self.tx_ico(self.vpath.split("/")[-1], exact=True)
              path_base = os.path.join(self.E.mod, "web")
              static_path = absreal(os.path.join(path_base, self.vpath[5:]))
              if not static_path.startswith(path_base):
                  self.tx_404()
                  return False
              return self.tx_file(static_path)
  ```
