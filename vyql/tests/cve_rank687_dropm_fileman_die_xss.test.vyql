test "rank687: dro.pm fileman reflects secret in die response"
  lang php
  expect VYQL-INJ-004
  code
  ```
  <?php
  if (empty($_GET['secret'])) {
      die('Missing required parameter.');
  } else {
      $secret = $db->escape_string($_GET['secret']);
      $key = $db->query('SELECT `key` FROM `shorts` WHERE `secret` = "' . $secret . '"') or die('Database error');
      if ($key->num_rows != 1) {
          die("?secret=$secret not found");
      }
  }
  ```

test "rank687: dro.pm fileman escapes reflected secret"
  lang php
  reject VYQL-INJ-004
  code
  ```
  <?php
  if (empty($_GET['secret'])) {
      die('Missing required parameter.');
  } else {
      $secret = $_GET['secret'];
      $key = $db->query('SELECT `key` FROM `shorts` WHERE `secret` = "' . $db->escape_string($secret) . '"') or die('Database error');
      if ($key->num_rows != 1) {
          die('?secret=' . htmlspecialchars($secret) . ' not found');
      }
  }
  ```

test "rank687: mysqli object escape_string suppresses concatenated SQL"
  lang php
  reject VYQL-INJ-001
  code
  ```
  <?php
  $secret = $_GET['secret'];
  $db->query('SELECT `key` FROM `shorts` WHERE `secret` = "' . $db->escape_string($secret) . '"');
  ```
