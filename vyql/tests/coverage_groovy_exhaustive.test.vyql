# Groovy language-gap narrowing: exhaustive coverage for adapter-claimed idioms.

test "groovy exhaustive: Jenkins params reach command execution"
  lang groovy
  expect VYQL-INJ-002
  code
  ```
  def f() {
    def cmd = params.CMD
    sh cmd
    bat cmd
    Runtime.exec(cmd)
  }
  ```

test "groovy exhaustive: escaped commands are clean"
  lang groovy
  reject VYQL-INJ-002
  code
  ```
  def f() {
    sh escapeShell(params.CMD)
  }
  ```

test "groovy exhaustive: Eval and GroovyShell evaluate tainted code"
  lang groovy
  expect VYQL-INJ-003
  code
  ```
  def f(shell) {
    Eval.me(params.CODE)
    Eval.x(params.CODE)
    shell.evaluate(params.CODE)
  }
  ```

test "groovy exhaustive: constant eval is clean"
  lang groovy
  reject VYQL-INJ-003
  code
  ```
  def f(shell) {
    Eval.me("1 + 1")
    shell.evaluate("1 + 1")
  }
  ```

test "groovy exhaustive: Sql raw query methods receive tainted query"
  lang groovy
  expect VYQL-INJ-001
  code
  ```
  def f(sql) {
    def q = params.Q
    sql.execute(q)
    sql.executeInsert(q)
    sql.executeUpdate(q)
    sql.rows(q)
    sql.eachRow(q)
    sql.firstRow(q)
    sql.executeQuery(q)
  }
  ```

test "groovy exhaustive: constant SQL query is clean"
  lang groovy
  reject VYQL-INJ-001
  code
  ```
  def f(sql) {
    sql.execute("select 1")
  }
  ```

test "groovy exhaustive: File and readText access tainted paths"
  lang groovy
  expect VYQL-PATH-001
  code
  ```
  def f() {
    def p = params.PATH
    new File(p)
    p.readText()
  }
  ```

test "groovy exhaustive: safePath suppresses file traversal"
  lang groovy
  reject VYQL-PATH-001
  code
  ```
  def f() {
    new File(safePath(params.PATH))
  }
  ```

test "groovy exhaustive: URL and URI constructors fetch tainted URLs"
  lang groovy
  expect VYQL-RF-001
  code
  ```
  def f() {
    new URL(params.URL)
    new URI(params.URL)
  }
  ```

test "groovy exhaustive: constant URL and URI constructors are clean for SSRF"
  lang groovy
  reject VYQL-RF-001
  code
  ```
  def f() {
    new URL("https://example.com")
    new URI("https://example.com")
  }
  ```

test "groovy exhaustive: cleartext URL and URI constructors are reported"
  lang groovy
  expect VYQL-CFG-006
  code
  ```
  def f() {
    new URL("http://example.com")
    new URI("http://example.com")
  }
  ```

test "groovy exhaustive: HTTPS and localhost URL constructors are clean for cleartext"
  lang groovy
  reject VYQL-CFG-006
  code
  ```
  def f() {
    new URL("https://example.com")
    new URI("http://127.0.0.1:8080/health")
  }
  ```

test "groovy exhaustive: archive extraction and deserialization receive tainted data"
  lang groovy
  expect VYQL-PATH-004
  expect VYQL-DESER-001
  code
  ```
  def f(zip, stream) {
    zip.extractEntry(params.ENTRY)
    ZipFile.extract(zip, params.ENTRY)
    stream.readObject(params.BLOB)
    stream.deserialize(params.BLOB)
  }
  ```

test "groovy exhaustive: regex compile and XSS sinks receive tainted data"
  lang groovy
  expect VYQL-DOS-001
  expect VYQL-INJ-004
  code
  ```
  def f(out) {
    Pattern.compile(params.PATTERN)
    out.write(params.HTML)
    out.println(params.HTML)
  }
  ```

test "groovy exhaustive: escaped HTML and constant regex are clean"
  lang groovy
  reject VYQL-DOS-001
  reject VYQL-INJ-004
  code
  ```
  def f(out) {
    Pattern.compile("^[a-z]+$")
    out.write(escapeHtml(params.HTML))
  }
  ```

test "groovy exhaustive: auth IDOR LDAP XPath and trust boundary are reported"
  lang groovy
  expect VYQL-AUTH-001
  expect VYQL-AUTH-002
  expect VYQL-INJ-005
  expect VYQL-INJ-006
  expect VYQL-CFG-014
  code
  ```
  def f(repo, ldap, xpath, session) {
    changePassword()
    repo.findById(params.ID)
    ldap.search("base", params.FILTER)
    xpath.evaluate(params.XPATH)
    session.setAttribute("role", params.ROLE)
  }
  ```

test "groovy exhaustive: auth ownership and encoders suppress guarded flows"
  lang groovy
  reject VYQL-AUTH-001
  reject VYQL-AUTH-002
  reject VYQL-INJ-005
  reject VYQL-INJ-006
  reject VYQL-CFG-014
  code
  ```
  def f(repo, ldap, xpath, session) {
    requireAuth()
    changePassword()
    checkOwnership(params.ID)
    repo.findById(params.ID)
    ldap.search("base", encodeForLDAP(params.FILTER))
    xpath.evaluate(xpathEscape(params.XPATH))
    session.setAttribute("role", validateRole(params.ROLE))
  }
  ```

test "groovy exhaustive: crypto and config presence findings are reported"
  lang groovy
  expect VYQL-CRY-001
  expect VYQL-CRY-002
  expect VYQL-CRY-003
  expect VYQL-CRY-004
  expect VYQL-CFG-005
  expect VYQL-CFG-004
  expect VYQL-CFG-001
  expect VYQL-CFG-008
  expect VYQL-CFG-007
  code
  ```
  def f(cookie) {
    MessageDigest.getInstance("MD5")
    DigestUtils.sha1Hex("x")
    Cipher.getInstance("DES")
    new IvParameterSpec("0000000000000000")
    new Random()
    Algorithm.none()
    new NoopHostnameVerifier()
    csrf.disable()
    chmod("0777")
    cookie.setHttpOnly(false)
    cookie.setSecure(false)
  }
  ```

test "groovy exhaustive: stronger crypto and secure config are clean"
  lang groovy
  reject VYQL-CRY-001
  reject VYQL-CRY-002
  reject VYQL-CRY-003
  reject VYQL-CRY-004
  reject VYQL-CFG-005
  reject VYQL-CFG-004
  reject VYQL-CFG-001
  reject VYQL-CFG-008
  reject VYQL-CFG-007
  code
  ```
  def f(cookie, iv) {
    MessageDigest.getInstance("SHA-256")
    Cipher.getInstance("AES")
    new IvParameterSpec(iv)
    new SecureRandom()
    Algorithm.HMAC256("secret")
    cookie.setHttpOnly(true)
    cookie.setSecure(true)
    chmod("0600")
  }
  ```

test "groovy exhaustive: resource handles closed are clean"
  lang groovy
  reject VYQL-RES-001
  code
  ```
  def f() {
    def s = new Socket("example.com", 443)
    s.close()
    def out = new FileOutputStream("safe.txt")
    out.close()
  }
  ```

test "groovy exhaustive: resource handles leak"
  lang groovy
  expect VYQL-RES-001
  code
  ```
  def f() {
    def s = new Socket("example.com", 443)
    s.getInputStream()
  }
  ```
