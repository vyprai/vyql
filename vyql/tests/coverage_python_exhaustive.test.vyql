  expect VYQL-INJ-003
  expect VYQL-INJ-023
  code
  ```
  def handler(request, cursor):
      q = request.args["q"]
      cmd = request.args["cmd"]
      mod = request.args["module"]
      cursor.execute(q)
      cursor.executemany(q, [])
      os.system(cmd)
      subprocess.run(cmd, shell=True)
      eval(q)
      exec(q)
      __import__(mod)
      importlib.import_module(mod)
  ```

