test "python exhaustive: LDAP XPath regex trust auth ownership and CSRF controls suppress findings"
  lang python
  reject VYQL-INJ-005
  reject VYQL-INJ-006
  reject VYQL-DOS-001
  reject VYQL-CFG-014
  reject VYQL-AUTH-001
  reject VYQL-AUTH-002
  reject VYQL-RF-003
  code
  ```
  def handler(request, ldap, tree, repo, session):
      v = request.args["v"]
      ldap.search(ldap.filter.escape_filter_chars(v))
      tree.xpath(xpath_literal(v))
      re.compile("^[a-z]+$")
      session["role"] = authenticate_user(v)
      require_auth()
      change_password("system")
      check_ownership(request.args["id"])
      repo.find_by_id(request.args["id"])
      transfer_funds("system")
  ```

