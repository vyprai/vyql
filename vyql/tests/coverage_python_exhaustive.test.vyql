test "python exhaustive: realpath base plus separator guard suppresses path traversal"
  lang python
  reject VYQL-PATH-001
  code
  ```
  def read(request):
      import os
      base = os.path.realpath("/srv/workspace")
      path = os.path.realpath(os.path.normpath(os.path.join("/srv/workspace", request.args["name"])))
      if not (path.startswith(base + os.sep) or path == base):
          raise PermissionError("outside workspace")
      return open(path).read()
  ```

test "python exhaustive: pathlib relative_to guard suppresses path traversal"
  lang python
  reject VYQL-PATH-001
  code
  ```
  from pathlib import Path
  from fastapi import APIRouter, HTTPException

  router = APIRouter()
  ROOT = Path("prompts").resolve()

  def safe_prompt_path(filename: str) -> Path:
      try:
          resolved = (ROOT / filename).resolve()
          resolved.relative_to(ROOT)
      except ValueError:
          raise HTTPException(status_code=400, detail="invalid filename")
      return resolved

  @router.get("/{filename}")
  def get_prompt(filename: str):
      path = safe_prompt_path(filename)
      with open(path, "r", encoding="utf-8") as f:
          return f.read()
  ```

test "python exhaustive: pathlib parents guard suppresses path traversal"
  lang python
  reject VYQL-PATH-001
  code
  ```
  from pathlib import Path
  from fastapi import HTTPException
  from fastapi.responses import FileResponse

  @router.get("/static-files/{path:path}/")
  async def serve_static_files(path):
      root = "/app/ui/build"
      static_file_name = "/".join((root, path))
      if not Path(root) in Path(static_file_name).resolve().parents:
          raise HTTPException(404)
      return FileResponse(static_file_name)
  ```

