test "python exhaustive: incomplete f-string format validation is flagged"
  lang python
  expect VYQL-INJ-024
  code
  ```
  from string import Formatter

  def get_template_variables(template, template_format):
      if template_format == "f-string":
          input_variables = {
              v for _, v, _, _ in Formatter().parse(template) if v is not None
          }
          for var in input_variables:
              if "." in var or "[" in var or "]" in var:
                  raise ValueError("bad")
      return sorted(input_variables)
  ```

test "python exhaustive: f-string format spec validation is clean"
  lang python
  reject VYQL-INJ-024
  code
  ```
  from string import Formatter

  def validate_f_string_template(template):
      input_variables = set()
      for _, var, format_spec, _ in Formatter().parse(template):
          if "." in var or "[" in var or "]" in var:
              raise ValueError("bad")
          if format_spec and ("{" in format_spec or "}" in format_spec):
              raise ValueError("nested fields")
          input_variables.add(var)
      return sorted(input_variables)
  ```

