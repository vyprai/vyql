# C# core-language exhaustive coverage for adapter-claimed ASP.NET/.NET idioms.

test "csharp exhaustive: request input reaches SQL command deser dynamic-load SSRF path upload and archive sinks"
  lang csharp
  expect VYQL-INJ-001
  expect VYQL-INJ-002
  expect VYQL-DESER-001
  expect VYQL-INJ-023
  expect VYQL-RF-001
  expect VYQL-PATH-001
  expect VYQL-INJ-015
  expect VYQL-PATH-004
  code
  ```
  class C {
    void H(HttpRequest Request, IDbConnection db, WebClient wc) {
      var v = Request.Query["v"];
      new SqlCommand(v);
      Process.Start(v);
      serializer.Deserialize(v);
      Assembly.Load(v);
      wc.DownloadString(v);
      File.ReadAllText(v);
      File.WriteAllBytes(v, bytes);
      archive.ExtractToFile(v);
    }
  }
  ```

