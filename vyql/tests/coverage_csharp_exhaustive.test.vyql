  expect VYQL-LIFE-001
  code
  ```
  class C {
    void H() {
      MD5.Create();
      DES.Create();
      aes.Mode = CipherMode.ECB;
      aes.CreateEncryptor(key, Encoding.UTF8.GetBytes("0000000000000000"));
      new Random();
      IgnoreAntiforgeryToken();
      HttpClientHandler.DangerousAcceptAnyServerCertificateValidator();
      new TokenValidationParameters { RequireSignedTokens = false };
      new Uri("http://example.com");
      cookie.SetHttpOnly(false);
      cookie.SetSecure(false);
      File.SetUnixFileMode(path, UnixFileMode.OtherWrite);
      File.Open("data.txt", FileMode.Open);
      Monitor.Enter(lockObj);
    }
  }
  ```

test "csharp exhaustive: stronger crypto secure config closed resources and released locks are clean"
  lang csharp
  reject VYQL-CRY-001
  reject VYQL-CRY-002
  reject VYQL-CRY-003
  reject VYQL-CRY-004
  reject VYQL-CFG-004
  reject VYQL-CFG-005
  reject VYQL-CFG-006
  reject VYQL-CFG-007
  reject VYQL-CFG-008
  reject VYQL-RES-001
  reject VYQL-LIFE-001
  code
  ```
  class C {
    void H() {
      SHA256.Create();
      Aes.Create();
      aes.Mode = CipherMode.GCM;
      aes.CreateEncryptor(key, iv);
      RandomNumberGenerator.Create();
      new TokenValidationParameters { RequireSignedTokens = true, ValidateIssuerSigningKey = true };
      new Uri("https://example.com");
      new Uri("http://127.0.0.1:8080");
      cookie.SetHttpOnly(true);
      cookie.SetSecure(true);
      File.SetUnixFileMode(path, UnixFileMode.UserRead);
      var f = File.Open("data.txt", FileMode.Open);
      f.Close();
      Monitor.Enter(lockObj);
      Monitor.Exit(lockObj);
    }
  }
  ```
