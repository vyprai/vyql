  reject VYQL-PATH-004
  code
  ```
  class C {
    void H(HttpRequest Request, WebClient wc) {
      var p = Path.GetFileName(Request.Query["v"]);
      new SqlCommand("select 1");
      Process.Start("whoami");
      Assembly.Load("Safe");
      wc.DownloadString("https://example.com");
      File.ReadAllText(p);
      File.WriteAllBytes("uploads/fixed.dat", bytes);
      archive.ExtractToFile("safe.txt");
    }
  }
  ```

test "csharp exhaustive: output header log CSV mass XML XPath LDAP regex trust auth and IDOR findings are reported"
  lang csharp
  expect VYQL-INJ-004
  expect VYQL-INJ-010
  expect VYQL-INJ-009
  expect VYQL-INJ-014
  expect VYQL-INJ-012
  expect VYQL-DESER-002
  expect VYQL-INJ-006
  expect VYQL-INJ-005
  expect VYQL-DOS-001
  expect VYQL-CFG-014
  expect VYQL-AUTH-001
  expect VYQL-AUTH-002
  code
  ```
  class C {
    void H(HttpRequest Request, HttpResponse Response, ILogger log, CsvWriter csv, Repo repo) {
      var v = Request.Query["v"];
      Response.Write(v);
      Response.Headers.Add("X-Name", v);
      log.LogInformation(v);
      csv.WriteField(v);
      TryUpdateModelAsync(user, "", Request.Form);
      var doc = new XmlDocument();
      doc.LoadXml(v);
      doc.SelectNodes(v);
      new DirectorySearcher(v);
      new Regex(v);
      Session.SetAttribute("role", v);
      ChangePassword(v);
      repo.Find(Request.Query["id"]);
    }
  }
  ```

test "csharp exhaustive: encoders constants validation and guards suppress output trust auth and IDOR findings"
  lang csharp
  reject VYQL-INJ-004
  reject VYQL-INJ-010
  reject VYQL-INJ-009
  reject VYQL-INJ-014
  reject VYQL-INJ-012
  reject VYQL-DESER-002
  reject VYQL-INJ-006
  reject VYQL-INJ-005
  reject VYQL-DOS-001
  reject VYQL-CFG-014
  reject VYQL-AUTH-001
  reject VYQL-AUTH-002
  code
  ```
  class C {
    void H(HttpRequest Request, HttpResponse Response, ILogger log, CsvWriter csv, Repo repo) {
      var v = Request.Query["v"];
      Response.Write(HttpUtility.HtmlEncode(v));
      Response.Headers.Add("X-Name", "safe");
      log.LogInformation("safe");
      csv.WriteField("safe");
      TryUpdateModelAsync(user, "", defaults);
      var doc = new XmlDocument();
      doc.LoadXml("<root/>");
      doc.SelectNodes(escapeXPath(v));
      new DirectorySearcher(encodeForLDAP(v));
      new Regex("^[a-z]+$");
      Session.SetAttribute("role", validateRole(v));
      RequireAuth();
      ChangePassword("system");
      CheckOwnership(Request.Query["id"]);
      repo.Find(Request.Query["id"]);
    }
  }
  ```

test "csharp exhaustive: crypto config cleartext permissions cookies cert JWT CSRF resource and lock findings are reported"
