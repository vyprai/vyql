# Rank 16 / CVE-2014-3579: ActiveMQ Apollo's Xalan XPath evaluator parsed
# selector XML with a raw DocumentBuilderFactory before disabling XXE features.

test "rank16: ActiveMQ Apollo Xalan XPath evaluator uses raw DocumentBuilderFactory"
  lang java
  file apollo-selector/src/main/java/org/apache/activemq/apollo/filter/XalanXPathEvaluator.java
  expect VYQL-DESER-004
  code
  ```
  import javax.xml.parsers.DocumentBuilder;
  import javax.xml.parsers.DocumentBuilderFactory;
  import org.w3c.dom.Document;
  import org.xml.sax.InputSource;

  class XalanXPathEvaluator {
    boolean evaluate(InputSource inputSource) throws Exception {
      DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
      factory.setNamespaceAware(true);
      DocumentBuilder dbuilder = factory.newDocumentBuilder();
      Document doc = dbuilder.parse(inputSource);
      return doc != null;
    }
  }
  ```

test "rank16: ActiveMQ Apollo Xalan XPath evaluator disables external entities"
  lang java
  file apollo-selector/src/main/java/org/apache/activemq/apollo/filter/XalanXPathEvaluator.java
  reject VYQL-DESER-004
  code
  ```
  import javax.xml.parsers.DocumentBuilder;
  import javax.xml.parsers.DocumentBuilderFactory;
  import org.w3c.dom.Document;
  import org.xml.sax.InputSource;

  class XalanXPathEvaluator {
    boolean evaluate(InputSource inputSource) throws Exception {
      DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
      factory.setNamespaceAware(true);
      factory.setFeature("http://apache.org/xml/features/disallow-doctype-decl", true);
      factory.setFeature("http://xml.org/sax/features/external-general-entities", false);
      factory.setFeature("http://xml.org/sax/features/external-parameter-entities", false);
      factory.setXIncludeAware(false);
      factory.setExpandEntityReferences(false);
      DocumentBuilder dbuilder = factory.newDocumentBuilder();
      Document doc = dbuilder.parse(inputSource);
      return doc != null;
    }
  }
  ```

