  ```
  int atoi(const char *);
  void handler(int argc, char **argv, char *src, char *p) {
    int n = atoi(argv[1]);
    char dst[8];
    strcpy(dst, argv[1]);
    memcpy(dst, src, n);
    sprintf(dst, "%s", src);
    alloca(n);
    dst[n] = 'x';
    int y = 10 / n;
    int z = n * 1024;
    void *heap = malloc(n * 32);
    char *maybe = NULL;
    *maybe = 'x';
    free(p);
    *p = 'x';
    free(p);
    if (access(argv[2], F_OK) == 0) { fopen(argv[2], "r"); }
    pthread_mutex_lock(&m);
  }
  ```

test "objc exhaustive: weak crypto static IV and weak randomness are reported"
  lang objc
  expect VYQL-CRY-001
  expect VYQL-CRY-002
  expect VYQL-CRY-003
  expect VYQL-CRY-004
  code
  ```
  void handler() {
    CC_MD5(data, len, out);
    CCCrypt(kCCEncrypt, "DES", 0, key, 8, "0000000000000000", in, len, out, outLen, &moved);
    CCCryptorCreate(kCCEncrypt, "DES", 0, key, 8, "0000000000000000", &cryptor);
    arc4random();
    rand();
  }
  ```

test "objc exhaustive: stronger crypto and secure randomness are clean"
  lang objc
  reject VYQL-CRY-001
  reject VYQL-CRY-002
  reject VYQL-CRY-003
  reject VYQL-CRY-004
  code
  ```
  void handler() {
    CC_SHA256(data, len, out);
    CCCrypt(kCCEncrypt, kCCAlgorithmAES, 0, key, 16, iv, in, len, out, outLen, &moved);
    SecRandomCopyBytes(kSecRandomDefault, 16, out);
  }
  ```
