test "rank532: Jenkins credentials provider lazy-loads credentials without SYSTEM startup initializer"
  lang java
  file SystemCredentialsProvider.java
  expect VYQL-SEC-016
  expect_review code.JenkinsCredentialsStartupLoadContextExposure
  code
  ```
  package com.cloudbees.plugins.credentials;

  import hudson.XmlFile;
  import jenkins.model.Jenkins;
  import java.io.File;
  import java.io.IOException;
  import java.util.List;
  import java.util.Map;

  public class SystemCredentialsProvider {
      private transient List<Credentials> credentials;
      private Map<Domain, List<Credentials>> domainCredentialsMap;

      public SystemCredentialsProvider() {
          try {
              XmlFile xml = getConfigFile();
              if (xml.exists()) {
                  xml.unmarshal(this);
              }
          } catch (IOException e) {
          }
          domainCredentialsMap = DomainCredentials.migrateListToMap(domainCredentialsMap, credentials);
          credentials = null;
      }

      public static XmlFile getConfigFile() {
          return new XmlFile(Jenkins.XSTREAM2, new File(Jenkins.getActiveInstance().getRootDir(), "credentials.xml"));
      }

      public static SystemCredentialsProvider getInstance() {
          return ExtensionList.lookup(SystemCredentialsProvider.class).get(SystemCredentialsProvider.class);
      }
  }
  ```

test "rank532: Jenkins credentials provider force-loads during SYSTEM startup"
  lang java
  file SystemCredentialsProvider.java
  reject VYQL-SEC-016
  reject_review code.JenkinsCredentialsStartupLoadContextExposure
  code
  ```
  package com.cloudbees.plugins.credentials;

  import hudson.XmlFile;
  import hudson.init.InitMilestone;
  import hudson.init.Initializer;
  import jenkins.model.Jenkins;
  import java.io.File;
  import java.io.IOException;
  import java.util.List;
  import java.util.Map;

  public class SystemCredentialsProvider {
      private transient List<Credentials> credentials;
      private Map<Domain, List<Credentials>> domainCredentialsMap;

      public SystemCredentialsProvider() {
          try {
              XmlFile xml = getConfigFile();
              if (xml.exists()) {
                  xml.unmarshal(this);
              }
          } catch (IOException e) {
          }
          domainCredentialsMap = DomainCredentials.migrateListToMap(domainCredentialsMap, credentials);
          credentials = null;
      }

      @Initializer(after = InitMilestone.JOB_LOADED)
      public static void forceLoadDuringStartup() {
          getInstance();
      }

      public static XmlFile getConfigFile() {
          return new XmlFile(Jenkins.XSTREAM2, new File(Jenkins.getActiveInstance().getRootDir(), "credentials.xml"));
      }

      public static SystemCredentialsProvider getInstance() {
          return ExtensionList.lookup(SystemCredentialsProvider.class).get(SystemCredentialsProvider.class);
      }
  }
  ```
