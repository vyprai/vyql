# Rank 480 / CVE-2021-21334: containerd's CRI implementation
# appended per-container environment variables to imageConfig.Env without first
# copying the image-config slice, allowing env values to leak between containers
# created from the same image.

test "rank480: containerd CRI aliases image env slice before appending container envs"
  lang go
  file container_create_unix.go
  expect VYQL-SEC-014
  expect_review code.ContainerdCriImageEnvAliasLeak
  code
  ```
  package server

  type ImageConfig struct {
      Env []string
  }

  type EnvVar struct {
      Key   string
      Value string
  }

  func (e EnvVar) GetKey() string { return e.Key }
  func (e EnvVar) GetValue() string { return e.Value }

  type ContainerConfig struct {
      Envs []EnvVar
  }

  func (c *ContainerConfig) GetEnvs() []EnvVar { return c.Envs }

  var oci = struct {
      WithEnv func([]string) func()
  }{}

  func containerSpec(config *ContainerConfig, imageConfig *ImageConfig) {
      env := imageConfig.Env
      for _, e := range config.GetEnvs() {
          env = append(env, e.GetKey()+"="+e.GetValue())
      }
      _ = oci.WithEnv(env)
  }
  ```

test "rank480: containerd CRI copies image env slice before appending container envs"
  lang go
  file container_create_unix.go
  reject VYQL-SEC-014
  reject_review code.ContainerdCriImageEnvAliasLeak
  code
  ```
  package server

  type ImageConfig struct {
      Env []string
  }

  type EnvVar struct {
      Key   string
      Value string
  }

  func (e EnvVar) GetKey() string { return e.Key }
  func (e EnvVar) GetValue() string { return e.Value }

  type ContainerConfig struct {
      Envs []EnvVar
  }

  func (c *ContainerConfig) GetEnvs() []EnvVar { return c.Envs }

  var oci = struct {
      WithEnv func([]string) func()
  }{}

  func containerSpec(config *ContainerConfig, imageConfig *ImageConfig) {
      env := append([]string{}, imageConfig.Env...)
      for _, e := range config.GetEnvs() {
          env = append(env, e.GetKey()+"="+e.GetValue())
      }
      _ = oci.WithEnv(env)
  }
  ```
