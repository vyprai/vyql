test "javascript default relay URL embeds token in hardcoded fallback host"
  lang javascript
  expect VYQL-SEC-017
  expect_review code.DefaultExternalRelaySecretExposure
  code
  ```
  function buildRelayUrl(gurl, token) {
    const relay = "https://example-relay.herokuapp.com";
    return relay + "/" + encodeURIComponent(gurl) + "?token=" + token;
  }
  ```

test "javascript configured relay host is clean"
  lang javascript
  reject VYQL-SEC-017
  reject_review code.DefaultExternalRelaySecretExposure
  code
  ```
  function buildRelayUrl(gurl, token, configuredRelayHost) {
    const relay = configuredRelayHost;
    return relay + "/" + encodeURIComponent(gurl) + "?token=" + token;
  }
  ```
