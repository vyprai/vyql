# Rank 462 / CVE-2022-43423: BMC Compuware SCM Downloader implemented a
# Jenkins remoting Callable that could execute on the controller and return
# Java system properties. The fix extends MasterToSlaveCallable.

test "rank462: Jenkins remoting Callable exposes controller system properties"
  lang java
  expect VYQL-SEC-013
  expect_review code.JenkinsRemotingCallableSystemPropertiesLeak
  code
  ```
  import hudson.remoting.Callable;
  import java.util.Properties;
  import org.jenkinsci.remoting.RoleChecker;

  public class RemoteSystemProperties implements Callable<Properties, RuntimeException> {
    public Properties call() {
      return System.getProperties();
    }

    @Override
    public void checkRoles(RoleChecker checker) {
      // Implementation required by interface, but not using
    }
  }
  ```

test "rank462: MasterToSlaveCallable restricts system property request to agents"
  lang java
  reject VYQL-SEC-013
  reject_review code.JenkinsRemotingCallableSystemPropertiesLeak
  code
  ```
  import java.util.Properties;
  import jenkins.security.MasterToSlaveCallable;

  public class RemoteSystemProperties extends MasterToSlaveCallable<Properties, RuntimeException> {
    public Properties call() {
      return System.getProperties();
    }
  }
  ```
