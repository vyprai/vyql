test "python authz: GraphQL principal comparison and admin override cover lookup"
  lang python
  reject VYQL-AUTH-095
  code
  ```
  class Query(graphene.ObjectType):
      def resolve_documents(self, info, user_id):
          if info.context.user.id != user_id and info.context.user.username != "admin":
              return []
          return Document.query.filter_by(user_id=user_id).all()
  ```

test "python authz: GraphQL mutation identity argument requires principal scope"
  lang python
  expect VYQL-AUTH-095
  code
  ```
  class AddDocument(graphene.Mutation):
      def mutate(self, info, user_id, title):
          document = Document(user_id=user_id, title=title)
          db.session.add(document)
          db.session.commit()
          return AddDocument(document=document)
  ```

test "python authz: GraphQL principal guard covers object creation"
  lang python
  reject VYQL-AUTH-095
  code
  ```
  class AddDocument(graphene.Mutation):
      def mutate(self, info, user_id, title):
          if info.context.user.id != user_id and info.context.user.username != "admin":
              return None
          document = Document(user_id=user_id, title=title)
          db.session.add(document)
          db.session.commit()
          return AddDocument(document=document)
  ```

