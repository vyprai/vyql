test "python authz: route target reaches direct ORM lookup without owner relation"
  lang python
  expect VYQL-AUTH-095
  code
  ```
  from flask import session

  @app.route("/documents/<int:document_id>")
  def view_document(document_id):
      principal_id = session.get("user_id")
      if principal_id:
          document = Document.query.get(document_id)
          return render_template("document.html", document=document)
      return redirect("/login")
  ```

test "python authz: owner guard covers direct ORM lookup"
  lang python
  reject VYQL-AUTH-095
  code
  ```
  from flask import abort, session

  @app.route("/documents/<int:document_id>")
  def view_document(document_id):
      principal_id = session.get("user_id")
      document = Document.query.get(document_id)
      if document.owner_id != principal_id:
          abort(403)
      return render_template("document.html", document=document)
  ```

test "python authz: target-only ORM mutation lacks owner scope"
  lang python
  expect VYQL-AUTH-095
  code
  ```
  from flask import session

  @app.route("/records/<int:record_id>/archive")
  def archive_record(record_id):
      principal = Account.query.get(session.get("user_id"))
      record = Record.query.filter(Record.id == record_id).first_or_404()
      record.archived = True
      db.session.commit()
      return redirect("/records")
  ```

test "python authz: owner-scoped ORM mutation is clean"
  lang python
  reject VYQL-AUTH-095
  code
  ```
  from flask import session

  @app.route("/records/<int:record_id>/archive")
  def archive_record(record_id):
      principal = Account.query.get(session.get("user_id"))
      record = Record.query.filter(Record.id == record_id).filter(Record.owner == principal).first_or_404()
      record.archived = True
      db.session.commit()
      return redirect("/records")
  ```

test "python authz: session lookup in another function does not protect a public label"
  lang python
  reject VYQL-AUTH-095
  code
  ```
  from flask import session

  def load_principal():
      return Account.query.get(session.get("user_id"))

  @app.route("/labels/<int:document_id>")
  def public_label(document_id):
      document = Document.query.get(document_id)
      return document.public_label
  ```

test "python authz: commit in another function does not turn a target lookup into a mutation"
  lang python
  reject VYQL-AUTH-095
  code
  ```
  @app.route("/records/<int:record_id>/label")
  def record_label(record_id):
      record = Record.query.filter(Record.id == record_id).first_or_404()
      return record.public_label

  def save_metric(metric):
      db.session.add(metric)
      db.session.commit()
  ```

test "python authz: dashboard parameter is unrelated to principal lookup"
  lang python
  reject VYQL-AUTH-095
  code
  ```
  from flask import session

  @app.route("/dashboard/<tab>")
  def dashboard(tab):
      user_id = session.get("user_id")
      user = User.query.get(user_id)
      return render_template("dashboard.html", tab=tab, user=user)
  ```

test "python authz: log-only owner comparison does not deny document access"
  lang python
  expect VYQL-AUTH-095
  code
  ```
  from flask import session

  @app.route("/documents/<int:document_id>")
  def view_document(document_id):
      principal_id = session.get("user_id")
      document = Document.query.get(document_id)
      if document.owner_id != principal_id:
          app.logger.info("document owner differs from principal")
      return render_template("document.html", document=document)
  ```

test "python authz: unrelated profile owner denial does not guard document access"
  lang python
  expect VYQL-AUTH-095
  code
  ```
  from flask import abort, session

  @app.route("/documents/<int:document_id>")
  def view_document(document_id):
      principal_id = session.get("user_id")
      profile = Profile.query.get(session.get("profile_id"))
      document = Document.query.get(document_id)
      if profile.owner_id != principal_id:
          abort(403)
      return render_template("document.html", document=document)
  ```

test "python authz: document owner relation with terminal denial is clean"
  lang python
  reject VYQL-AUTH-095
  code
  ```
  from flask import abort, session

  @app.route("/documents/<int:document_id>")
  def view_document(document_id):
      principal = Account.query.get(session.get("user_id"))
      document = Document.query.get(document_id)
      if document.owner != principal:
          abort(403)
      return render_template("document.html", document=document)
  ```

test "python authz: non-owner extra filter is outside bounded target-only mutation shape"
  lang python
  reject VYQL-AUTH-095
  code
  ```
  from flask import session

  @app.route("/records/<int:record_id>/archive")
  def archive_record(record_id):
      principal = Account.query.get(session.get("user_id"))
      record = Record.query.filter(Record.id == record_id).filter(Record.deleted == False).first_or_404()
      record.archived = True
      db.session.commit()
      return redirect("/records")
  ```

test "python authz: inverted owner equality denial does not authorize document access"
  lang python
  expect VYQL-AUTH-095
  code
  ```
  from flask import abort, session

  @app.route("/documents/<int:document_id>")
  def view_document(document_id):
      principal_id = session.get("user_id")
      document = Document.query.get(document_id)
      if document.owner_id == principal_id:
          abort(403)
      return render_template("document.html", document=document)
  ```

test "python authz: unrelated authentication abort and owner log do not authorize access"
  lang python
  expect VYQL-AUTH-095
  code
  ```
  from flask import abort, session

  @app.route("/documents/<int:document_id>")
  def view_document(document_id):
      principal_id = session.get("user_id")
      if not principal_id:
          abort(401)
      document = Document.query.get(document_id)
      if document.owner_id != principal_id:
          app.logger.warning("document owner differs from principal")
      return render_template("document.html", document=document)
  ```

test "python authz: internal direct lookup helper is outside endpoint detector"
  lang python
  reject VYQL-AUTH-095
  code
  ```
  from flask import session

  def load_document(document_id):
      principal_id = session.get("user_id")
      document = Document.query.get(document_id)
      return document
  ```

test "python authz: reachable retry-count mutation still lacks owner scope"
  lang python
  expect VYQL-AUTH-095
  code
  ```
  @app.post("/records/<int:record_id>/archive")
  def archive_record(record_id, retry_count):
      if retry_count >= 0:
          return ""
      record = Record.query.filter(Record.id == record_id).first_or_404()
      record.archived = True
      db.session.commit()
      return redirect("/records")
  ```

test "python authz: provably terminal length guard makes later mutation unreachable"
  lang python
  reject VYQL-AUTH-095
  code
  ```
  from flask import session

  @app.post("/records/<int:record_id>/archive")
  def archive_record(record_id):
      user_id = session.get("user_id")
      if len(user_id) >= 0:
          return ""
      record = Record.query.filter(Record.id == record_id).first_or_404()
      record.archived = True
      db.session.commit()
      return redirect("/records")
  ```

test "python authz: dominating request-target non-null guard blocks direct lookup"
  lang python
  reject VYQL-AUTH-095
  code
  ```
  from flask import session

  @app.get("/orders/<int:order_id>")
  def order_receipt(order_id):
      user_id = session.get("user_id")
      if user_id != None or order_id is not None:
          return ""
      order = Order.query.get(order_id)
      return render_template("receipt.html", order=order)
  ```

