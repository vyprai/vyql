test "python authz: sibling class method commit does not mutate endpoint target"
  lang python
  reject VYQL-AUTH-095
  code
  ```
  class RecordRoutes:
      @app.get("/records/<int:record_id>/label")
      def record_label(self, record_id):
          record = Record.query.filter(Record.id == record_id).first_or_404()
          return record.public_label

      def save_metric(self, metric):
          db.session.add(metric)
          db.session.commit()
  ```

test "python authz: unused nested scopes do not supply principal lookup"
  lang python
  reject VYQL-AUTH-095
  code
  ```
  from flask import session

  @app.get("/documents/<int:document_id>/label")
  def public_document_label(document_id):
      document = Document.query.get(document_id)

      def unused_principal():
          return session.get("user_id")

      class UnusedPrincipal:
          def load(self):
              return session["user_id"]

      callback = lambda: session.get("lambda-user")
      return document.public_label
  ```

test "python authz: unused nested scopes do not supply reachable commit"
  lang python
  reject VYQL-AUTH-095
  code
  ```
  @app.get("/records/<int:record_id>/label")
  def record_label(record_id):
      record = Record.query.filter(Record.id == record_id).first_or_404()

      def unused_save():
          db.commit()

      class UnusedSave:
          def save(self):
              database.session.commit()

      callback = lambda: db.session.commit()
      return record.public_label
  ```

test "python authz: request-claimed owner mismatch is not principal authorization"
  lang python
  expect VYQL-AUTH-095
  code
  ```
  from flask import abort, request, session

  @app.get("/documents/<int:document_id>")
  def view_document(document_id):
      authenticated_id = session.get("user_id")
      claimed_owner_id = request.args.get("owner_id")
      document = Document.query.get(document_id)
      if document.owner_id != claimed_owner_id:
          abort(403)
      return document
  ```

