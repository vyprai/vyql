      session["user_id"] = request.form["user_id"]
      return redirect("/preferences")
  ```

test "python authz: internal credential helper is outside endpoint detector"
  lang python
  reject VYQL-AUTH-095
  code
  ```
  from flask import request, session

  def authenticate_account(email):
      password = request.form["password"]
      account = Account.query.filter_by(email=email, password=password).first()
      if account:
          session["account_id"] = request.form["account_id"]
      return account
