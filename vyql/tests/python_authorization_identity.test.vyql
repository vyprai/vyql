test "python authz: decoded principal must bind a route target before mutation"
  lang python
  expect VYQL-AUTH-095
  code
  ```
  from jose import jwt

  @app.post("/edit/{company_id}")
  def update_profile(company_id, token, db, name, is_admin):
      payload = jwt.decode(token, SECRET_KEY, algorithms=["HS256"])
      token_company_id = int(payload.get("sub"))
      company = crud.get_company(db, company_id)
      company.name = name
      company.is_admin = is_admin
      db.add(company)
      db.commit()
      return company
  ```

test "python authz: decoded principal relation covers route-target mutation"
  lang python
  reject VYQL-AUTH-095
  code
  ```
  from jose import jwt

  @app.post("/edit/{company_id}")
  def update_profile(company_id, token, db, name, is_admin):
      payload = jwt.decode(token, SECRET_KEY, algorithms=["HS256"])
      token_company_id = int(payload.get("sub"))
      if token_company_id != company_id:
          raise Forbidden()
      company = crud.get_company(db, company_id)
      company.name = name
      company.is_admin = is_admin
      db.add(company)
      db.commit()
      return company
  ```

test "python authz: decoded-principal denial in a sibling function does not authorize mutation"
  lang python
  expect VYQL-AUTH-095
  code
  ```
  from jose import jwt

  def verify_other_route(token_company_id, other_company_id):
      if token_company_id != other_company_id:
          raise Forbidden()

  @app.post("/edit/{company_id}")
  def update_profile(company_id, token, db, name):
      payload = jwt.decode(token, SECRET_KEY, algorithms=["HS256"])
      token_company_id = int(payload.get("sub"))
      company = crud.get_company(db, company_id)
      company.name = name
      db.commit()
      return company
  ```

