test "rank180: SnakeYAML custom constructor extends unsafe Constructor"
  lang java
  expect VYQL-DESER-006
  file IntrinsicsYamlConstructor.java
  code
  ```
  import org.yaml.snakeyaml.constructor.Constructor;
  import org.yaml.snakeyaml.nodes.Tag;

  public class IntrinsicsYamlConstructor extends Constructor {
      public IntrinsicsYamlConstructor() {
          yamlConstructors.put(new Tag("!Ref"), new ConstructRef());
      }
  }
  ```

test "rank180: SnakeYAML custom constructor extends SafeConstructor"
  lang java
  reject VYQL-DESER-006
  file IntrinsicsYamlConstructor.java
  code
  ```
  import org.yaml.snakeyaml.constructor.SafeConstructor;
  import org.yaml.snakeyaml.nodes.Tag;

  public class IntrinsicsYamlConstructor extends SafeConstructor {
      public IntrinsicsYamlConstructor() {
          yamlConstructors.put(new Tag("!Ref"), new ConstructRef());
      }
  }
  ```
