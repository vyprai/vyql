test "rank589: DBI preparse allocates too little for generated placeholder indexes"
  lang c
  expect VYQL-MEM-033
  expect_review code.LengthMultiplierFormattedExpansionUnderallocation
  code
  ```
  typedef struct SV SV;
  SV *newSV(unsigned long size);
  char *SvPVX(SV *sv);
  unsigned long strlen(const char *s);
  int sprintf(char *s, const char *fmt, ...);

  static SV *preparse(const char *statement) {
      int idx = 1;
      const char *src;
      char *dest, *start;
      SV *new_stmt_sv = newSV(strlen(statement) * 3);
      src = statement;
      dest = SvPVX(new_stmt_sv);
      while (*src) {
          start = dest;
          if (*src++ == '?') {
              sprintf(start, ":p%d", idx++);
              dest = start + strlen(start);
          }
      }
      *dest = '\0';
      return new_stmt_sv;
  }
  ```

test "rank589: DBI preparse reserves enough room for generated placeholder indexes"
  lang c
  reject VYQL-MEM-033
  reject_review code.LengthMultiplierFormattedExpansionUnderallocation
  code
  ```
  typedef struct SV SV;
  SV *newSV(unsigned long size);
  char *SvPVX(SV *sv);
  unsigned long strlen(const char *s);
  int sprintf(char *s, const char *fmt, ...);

  static SV *preparse(const char *statement) {
      int idx = 1;
      const char *src;
      char *dest, *start;
      SV *new_stmt_sv = newSV(strlen(statement) * 6 + 16);
      src = statement;
      dest = SvPVX(new_stmt_sv);
      while (*src) {
          start = dest;
          if (*src++ == '?') {
              sprintf(start, ":p%d", idx++);
              dest = start + strlen(start);
          }
      }
      *dest = '\0';
      return new_stmt_sv;
  }
  ```

test "rank589: formatted placeholder underallocation generalizes across names"
  lang c
  expect VYQL-MEM-033
  expect_review code.LengthMultiplierFormattedExpansionUnderallocation
  code
  ```
  typedef struct SV SV;
  SV *newSV(unsigned long size);
  char *SvPVX(SV *sv);
  unsigned long strlen(const char *s);
  int sprintf(char *s, const char *fmt, ...);

  static SV *rewrite_query(const char *sql) {
      int number = 1;
      const char *read;
      char *write, *mark;
      SV *result = newSV(strlen(sql) * 3);
      read = sql;
      write = SvPVX(result);
      while (*read) {
          mark = write;
          if (*read++ == '?') {
              sprintf(mark, ":p%d", number++);
              write = mark + strlen(mark);
          }
      }
      *write = '\0';
      return result;
  }
  ```
