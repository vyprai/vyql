# Rank 780 / CVE-2018-8097: Eve's Mongo parser reconstructed ObjectId
# and datetime calls with eval.
test "rank780: Mongo parser evaluates reconstructed constructor call"
  lang python
  expect VYQL-INJ-003
  code
  ```
  from flask import request
  from bson import ObjectId
  from datetime import datetime

  def visit_Call():
      func_name = request.args["func"]
      string_value = request.args["value"]
      number_values = [
          request.args["year"],
          request.args["month"],
          request.args["day"],
      ]
      expr = None
      if func_name == "ObjectId":
          expr = "('" + string_value + "')"
      elif func_name == "datetime":
          values = []
          for arg in number_values:
              values.append(str(arg))
          expr = "(" + ", ".join(values) + ")"
      if expr:
          return eval(func_name + expr)
  ```

test "rank780: Mongo parser uses direct constructors"
  lang python
  reject VYQL-INJ-003
  code
  ```
  from flask import request
  from bson import ObjectId
  from datetime import datetime

  def visit_Call():
      func_name = request.args["func"]
      string_value = request.args["value"]
      number_values = [
          request.args["year"],
          request.args["month"],
          request.args["day"],
      ]
      if func_name == "ObjectId":
          try:
              return ObjectId(string_value)
          except Exception:
              pass
      elif func_name == "datetime":
          values = []
          for arg in number_values:
              values.append(arg)
          try:
              return datetime(*values)
          except Exception:
              pass
  ```
