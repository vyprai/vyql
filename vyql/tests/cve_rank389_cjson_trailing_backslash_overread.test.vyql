test "rank389: cJSON parse_string skips trailing backslash without end check"
  lang c
  expect VYQL-MEM-025
  expect_review code.CjsonTrailingBackslashStringOverread
  code
  ```
  static void *cJSON_malloc(int size);

  static const char *parse_string(void *item, const char *str, const char **ep)
  {
      const char *end_ptr = str + 1;
      int len = 0;
      char *out;

      if (*str != '\"') {
          *ep = str;
          return 0;
      }

      while (*end_ptr != '\"' && *end_ptr && ++len)
          if (*end_ptr++ == '\\')
              end_ptr++;

      out = (char*)cJSON_malloc(len + 1);
      if (!out) {
          return 0;
      }
      return end_ptr;
  }
  ```

test "rank389: cJSON parse_string rejects trailing backslash before advancing"
  lang c
  reject VYQL-MEM-025
  reject_review code.CjsonTrailingBackslashStringOverread
  code
  ```
  static void *cJSON_malloc(int size);

  static const char *parse_string(void *item, const char *str, const char **ep)
  {
      const char *end_ptr = str + 1;
      int len = 0;
      char *out;

      if (*str != '\"') {
          *ep = str;
          return 0;
      }

      while (*end_ptr != '\"' && *end_ptr && ++len)
      {
          if (*end_ptr++ == '\\')
          {
              if (*end_ptr == '\0')
              {
                  return 0;
              }
              end_ptr++;
          }
      }

      out = (char*)cJSON_malloc(len + 1);
      if (!out) {
          return 0;
      }
      return end_ptr;
  }
  ```
