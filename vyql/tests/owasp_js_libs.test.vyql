# JS Node-library sinks the owasp-js port uses: sqlite3, ldapjs, xpath.

test "js: req body -> sqlite3 db.all is SQLi"
  lang javascript
  expect VYQL-INJ-001
  code
  ```
  function h(req, res) {
    const x = req.body.name;
    db.all("SELECT * FROM users WHERE name = '" + x + "'", (e, r) => {});
  }
  ```

test "js: req body -> sqlite3 db.get is SQLi"
  lang javascript
  expect VYQL-INJ-001
  code
  ```
  function h(req, res) {
    const x = req.body.name;
    db.get("SELECT '" + x + "'", (e, r) => {});
  }
  ```

test "js: req body -> xpath.select is XPath injection"
  lang javascript
  expect VYQL-INJ-006
  code
  ```
  const xpath = require('xpath');
  function h(req, res) {
    const x = req.body.name;
    const r = xpath.select("//user[@name='" + x + "']", doc);
  }
  ```

test "js: req body -> ldapjs client.search filter is LDAP injection"
  lang javascript
  expect VYQL-INJ-005
  code
  ```
  function h(req, res, client) {
    const x = req.body.name;
    const filter = "(uid=" + x + ")";
    client.search("ou=people", { scope: "sub", filter }, (e) => {});
  }
  ```
