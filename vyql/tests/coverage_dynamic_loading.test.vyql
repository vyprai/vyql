# A0 matrix closure: remote file inclusion and unsafe dynamic loading.

test "js: request module name into require is unsafe dynamic loading"
  lang javascript
  expect VYQL-INJ-023
  code
  ```
  function handler(req) {
    return require(req.query.module);
  }
  ```

test "js: constant require is clean"
  lang javascript
  reject VYQL-INJ-023
  code
  ```
  function handler() {
    return require("./safe-plugin");
  }
  ```

test "js: request module name into dynamic import is unsafe dynamic loading"
  lang javascript
  expect VYQL-INJ-023
  code
  ```
  async function handler(req) {
    return import(req.query.module);
  }
  ```

test "python: argv module name into importlib is unsafe dynamic loading"
  lang python
  expect VYQL-INJ-023
  code
  ```
  import importlib, sys
  def main():
      return importlib.import_module(sys.argv[1])
  ```

test "python: constant importlib module is clean"
  lang python
  reject VYQL-INJ-023
  code
  ```
  import importlib
  def main():
      return importlib.import_module("safe_plugin")
  ```

test "c: getenv library path into dlopen is unsafe dynamic loading"
  lang c
  expect VYQL-INJ-023
  code
  ```
  #include <dlfcn.h>
  #include <stdlib.h>
  void h() {
    dlopen(getenv("PLUGIN_PATH"), 1);
  }
  ```

test "c: constant dlopen path is clean"
  lang c
  reject VYQL-INJ-023
  code
  ```
  #include <dlfcn.h>
  void h() {
    dlopen("/usr/lib/safe-plugin.so", 1);
  }
  ```

test "java: request class into Class.forName is unsafe dynamic loading"
  lang java
  expect VYQL-INJ-023
  code
  ```
  @RestController
  public class C {
    @GetMapping("/x")
    Object h(@RequestParam String cls) throws Exception {
      return Class.forName(cls).newInstance();
    }
  }
  ```

test "java: constant Class.forName is clean for dynamic loading"
  lang java
  reject VYQL-INJ-023
  code
  ```
  class C {
    Object h() throws Exception {
      return Class.forName("com.example.Safe").newInstance();
    }
  }
  ```

test "go: argv plugin path into plugin.Open is unsafe dynamic loading"
  lang go
  expect VYQL-INJ-023
  code
  ```
  package main
  import (
    "os"
    "plugin"
  )
  func main() {
    plugin.Open(os.Args[1])
  }
  ```

test "go: constant plugin.Open path is clean"
  lang go
  reject VYQL-INJ-023
  code
  ```
  package main
  import "plugin"
  func main() {
    plugin.Open("./safe.so")
  }
  ```

test "ruby: params module name into require is unsafe dynamic loading"
  lang ruby
  expect VYQL-INJ-023
  code
  ```
  def h
    require params[:plugin]
  end
  ```

test "ruby: constant require is clean"
  lang ruby
  reject VYQL-INJ-023
  code
  ```
  def h
    require "safe_plugin"
  end
  ```

test "lua: request module name into require is unsafe dynamic loading"
  lang lua
  expect VYQL-INJ-023
  code
  ```
  local m = require(ngx.var.plugin)
  ```

test "lua: constant require is clean"
  lang lua
  reject VYQL-INJ-023
  code
  ```
  local m = require("safe_plugin")
  ```

test "powershell: param module name into Import-Module is unsafe dynamic loading"
  lang powershell
  expect VYQL-INJ-023
  code
  ```
  param($Module)
  Import-Module $Module
  ```

test "powershell: constant Import-Module is clean"
  lang powershell
  reject VYQL-INJ-023
  code
  ```
  Import-Module Microsoft.PowerShell.Management
  ```

