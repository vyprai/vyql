# OWASP-replica coverage for JavaScript/Node — true positives plus the precision
# patterns the parity port unlocks (opaque-predicate pruning, container element-sensitivity).

# --- SQL injection (INJ-001) ---
test "js: req param -> mysql.query is SQLi"
  lang javascript
  expect VYQL-INJ-001
  code
  ```
  const mysql = require('mysql');
  function h(req){ const p = req.query.id; mysql.query("SELECT * FROM u WHERE id=" + p); }
  ```

test "js: opaque-predicate ternary routes to a constant — clean SQLi"
  lang javascript
  reject VYQL-INJ-001
  code
  ```
  const mysql = require('mysql');
  function h(req){
    const p = req.query.id; const num = 106;
    const bar = (7*18)+num > 200 ? "safe" : p;
    mysql.query("SELECT * FROM u WHERE id=" + bar);
  }
  ```

test "js: opaque if/else assigns constant on the live branch — clean SQLi"
  lang javascript
  reject VYQL-INJ-001
  code
  ```
  const mysql = require('mysql');
  function h(req){
    const p = req.query.id; const num = 88; let bar;
    if ((7*42)-num > 200) bar = "safe"; else bar = "alsosafe";
    mysql.query("SELECT * FROM u WHERE id=" + bar);
  }
  ```

# --- command injection (INJ-002) ---
test "js: req param -> child_process.exec is command injection"
  lang javascript
  expect VYQL-INJ-002
  code
  ```
  const cp = require('child_process');
  function h(req){ const p = req.query.cmd; cp.exec("ls " + p); }
  ```

# --- path traversal (PATH-001) ---
test "js: req param -> fs.readFile is path traversal"
  lang javascript
  expect VYQL-PATH-001
  code
  ```
  const fs = require('fs');
  function h(req){ const p = req.query.f; fs.readFile("/tmp/" + p, () => {}); }
  ```

# --- code injection (INJ-003) ---
test "js: req param -> eval is code injection"
  lang javascript
  expect VYQL-INJ-003
  code
  ```
  function h(req){ const p = req.query.x; eval(p); }
  ```

# --- weak hash (CRY-001) ---
test "js: createHash md5 is weak hash"
  lang javascript
  expect VYQL-CRY-001
  code
  ```
  const crypto = require('crypto');
  function h(){ return crypto.createHash('md5'); }
  ```
