  ```
  #include <string>

  bool CIccTagXmlProfileSequenceId::ParseXml(xmlNode *pNode, std::string &parseStr)
  {
      if (!pNode)
          return false;

      for (pNode = icXmlFindNode(pNode->children, "ProfileIdDesc"); pNode;
           pNode = icXmlFindNode(pNode->next, "ProfileIdDesc")) {
          CIccProfileIdDesc entry;

          const char *szDesc = icXmlAttrValue(pNode, "profileID");
          if (szDesc && *szDesc)
              entry.m_profileID = szDesc;

          m_list->push_back(entry);
      }

      return true;
