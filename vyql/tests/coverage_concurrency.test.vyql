# Race / concurrency coverage.

test "race: access check before open is TOCTOU (c)"
  lang c
  expect VYQL-RACE-001
  code
  ```
  int access(const char *, int);
  int open(const char *, int);
  void f(char *path) {
      if (access(path, 0) == 0) {
          open(path, 0);
      }
  }
  ```

test "race: thread creation is low-confidence shared-state review queue (c)"
  lang c
  expect VYQL-RACE-002
  code
  ```
  typedef unsigned long pthread_t;
  int pthread_create(pthread_t *, void *, void *(*)(void *), void *);
  void *worker(void *p) { return p; }
  void f() {
      pthread_t t;
      pthread_create(&t, 0, worker, 0);
  }
  ```

test "race: go package global roundtripper mutation is surfaced"
  lang go
  expect VYQL-RACE-002
  code
  ```
  package metrics

  type metricsRoundTripper struct {
    ctx context.Context
    roundTripper http.RoundTripper
  }

  var k8sMetrics metricsRoundTripper

  func AddMetricsTransportWrapper(ctx context.Context, config *rest.Config) *rest.Config {
    config.WrapTransport = func(rt http.RoundTripper) http.RoundTripper {
      k8sMetrics.ctx = ctx
      k8sMetrics.roundTripper = rt
      return &k8sMetrics
    }
    return config
  }
  ```

test "race: go per-request wrapper avoids package global roundtripper mutation"
  lang go
  reject VYQL-RACE-002
  code
  ```
  package metrics

  type metricsRoundTripperContext struct {
    ctx context.Context
    metrics *Metrics
  }
  type metricsRoundTripper struct {
    *metricsRoundTripperContext
    roundTripper http.RoundTripper
  }

  var k8sMetrics metricsRoundTripperContext

  func addK8sRequests(m *Metrics) {
    k8sMetrics.metrics = m
  }

  func AddMetricsTransportWrapper(ctx context.Context, config *rest.Config) *rest.Config {
    config.WrapTransport = func(rt http.RoundTripper) http.RoundTripper {
      return &metricsRoundTripper{roundTripper: rt, metricsRoundTripperContext: &k8sMetrics}
    }
    return config
  }
  ```
