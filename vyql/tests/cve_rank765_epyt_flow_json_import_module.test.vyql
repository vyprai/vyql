# Rank 765 / CVE-2026-25632: EPyT-Flow JSON deserialization loaded
# attacker-selected module/class names via importlib.import_module.

test "rank765: JSON __type__ drives importlib dynamic module load"
  lang python
  file serialization.py
  expect VYQL-INJ-023
  code
  ```
  import importlib
  import sys

  def main():
      obj = {"__type__": [sys.argv[1], "Dangerous"]}
      module_name, class_name = obj["__type__"]
      cls = getattr(importlib.import_module(module_name), class_name)
      del obj["__type__"]
      return cls(**obj)
  ```

test "rank765: JSON __type__ resolves through registered allowlist"
  lang python
  file serialization.py
  reject VYQL-INJ-023
  code
  ```
  import json

  JSON_SERIALIZABLE = {}

  def my_load_from_json(data: str):
      def __object_hook(obj: dict):
          t = obj.get("__type__")
          if not t:
              return obj
          key = (t[0], t[1])
          cls = JSON_SERIALIZABLE.get(key)
          if cls is None:
              raise ValueError(f"Type not allowed: {key}")
          args = {k: v for k, v in obj.items() if k != "__type__"}
          return cls(**args)
      return json.loads(data, object_hook=__object_hook)
  ```
