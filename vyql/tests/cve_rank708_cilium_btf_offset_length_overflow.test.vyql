test "rank708: BTF section bounds check adds uint32 offset and length before widening"
  lang go
  expect VYQL-NUM-014
  expect_review code.OffsetLengthBoundsOverflow
  code
  ```
  package btf

  import "fmt"

  type btfHeader struct {
      StringOff uint32
      StringLen uint32
      TypeOff   uint32
      TypeLen   uint32
  }

  func loadRawSpec(btf []byte, header btfHeader) error {
      if int(header.StringOff+header.StringLen) > len(btf) {
          return fmt.Errorf("string table is out of bounds")
      }
      stringsSection := btf[header.StringOff : header.StringOff+header.StringLen]

      if int(header.TypeOff+header.TypeLen) > len(btf) {
          return fmt.Errorf("types section is out of bounds")
      }
      typesSection := btf[header.TypeOff : header.TypeOff+header.TypeLen]
      _, _ = stringsSection, typesSection
      return nil
  }
  ```

test "rank708: BTF section bounds check widens offset and length before adding"
  lang go
  reject VYQL-NUM-014
  reject_review code.OffsetLengthBoundsOverflow
  code
  ```
  package btf

  import "fmt"

  type btfHeader struct {
      StringOff uint32
      StringLen uint32
      TypeOff   uint32
      TypeLen   uint32
  }

  func loadRawSpec(btf []byte, header btfHeader) error {
      if uint64(header.StringOff)+uint64(header.StringLen) > uint64(len(btf)) {
          return fmt.Errorf("string table is out of bounds")
      }
      stringsSection := btf[header.StringOff : header.StringOff+header.StringLen]

      if uint64(header.TypeOff)+uint64(header.TypeLen) > uint64(len(btf)) {
          return fmt.Errorf("types section is out of bounds")
      }
      typesSection := btf[header.TypeOff : header.TypeOff+header.TypeLen]
      _, _ = stringsSection, typesSection
      return nil
  }
  ```
