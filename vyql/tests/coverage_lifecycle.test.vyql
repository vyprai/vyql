# Lifecycle / typestate coverage.

test "lifecycle: lock acquired without release is reported (c)"
  lang c
  expect VYQL-LIFE-001
  code
  ```
  typedef int pthread_mutex_t;
  void pthread_mutex_lock(pthread_mutex_t *);
  void f(pthread_mutex_t *m) {
      pthread_mutex_lock(m);
  }
  ```

test "lifecycle: lock released on the same path is clean (c)"
  lang c
  reject VYQL-LIFE-001
  code
  ```
  typedef int pthread_mutex_t;
  void pthread_mutex_lock(pthread_mutex_t *);
  void pthread_mutex_unlock(pthread_mutex_t *);
  void f(pthread_mutex_t *m) {
      pthread_mutex_lock(m);
      pthread_mutex_unlock(m);
  }
  ```

test "lifecycle: csharp monitor released in finally is clean"
  lang csharp
  reject VYQL-LIFE-001
  code
  ```
  using System.Threading;
  public class A {
      private readonly object _lock = new object();
      void Work() {}
      public void F() { Monitor.Enter(_lock); try { Work(); } finally { Monitor.Exit(_lock); } }
  }
  ```

test "lifecycle: csharp monitor entered inside the try and released in finally is clean"
  lang csharp
  reject VYQL-LIFE-001
  code
  ```
  using System.Threading;
  public class A {
      private readonly object _lock = new object();
      void Work() {}
      public void F() { try { Monitor.Enter(_lock); Work(); } finally { Monitor.Exit(_lock); } }
  }
  ```

test "lifecycle: csharp monitor never exited is reported"
  lang csharp
  expect VYQL-LIFE-001
  code
  ```
  using System.Threading;
  public class A {
      private readonly object _lock = new object();
      void Work() {}
      public void F() { Monitor.Enter(_lock); Work(); }
  }
  ```

test "lifecycle: csharp finally that runs before the acquire is reported"
  lang csharp
  expect VYQL-LIFE-001
  code
  ```
  using System.Threading;
  public class A {
      private readonly object _lock = new object();
      void Work() {}
      public void F() { try { Work(); } finally { Monitor.Exit(_lock); } Monitor.Enter(_lock); }
  }
  ```

test "lifecycle: csharp finally inside a branch does not release a lock outside it"
  lang csharp
  expect VYQL-LIFE-001
  code
  ```
  using System.Threading;
  public class A {
      private readonly object _lock = new object();
      void Work() {}
      public void F(bool ok) { Monitor.Enter(_lock); if (ok) { try { Work(); } finally { Monitor.Exit(_lock); } } }
  }
  ```

test "lifecycle: java lock released in finally is clean"
  lang java
  reject VYQL-LIFE-001
  code
  ```
  import java.util.concurrent.locks.ReentrantLock;
  public class A {
      private final ReentrantLock lock = new ReentrantLock();
      void work() {}
      void f() { lock.lock(); try { work(); } finally { lock.unlock(); } }
  }
  ```

test "lifecycle: java lock taken inside the try and released in finally is clean"
  lang java
  reject VYQL-LIFE-001
  code
  ```
  import java.util.concurrent.locks.ReentrantLock;
  public class A {
      private final ReentrantLock lock = new ReentrantLock();
      void work() {}
      void f() { try { lock.lock(); work(); } finally { lock.unlock(); } }
  }
  ```

test "lifecycle: java lock with catch but no finally is reported"
  lang java
  expect VYQL-LIFE-001
  code
  ```
  import java.util.concurrent.locks.ReentrantLock;
  public class A {
      private final ReentrantLock lock = new ReentrantLock();
      void work() {}
      void f() { lock.lock(); try { work(); } catch (Exception e) { work(); } }
  }
  ```

test "lifecycle: java finally that runs before the acquire is reported"
  lang java
  expect VYQL-LIFE-001
  code
  ```
  import java.util.concurrent.locks.ReentrantLock;
  public class A {
      private final ReentrantLock lock = new ReentrantLock();
      void work() {}
      void f() { try { work(); } finally { lock.unlock(); } lock.lock(); }
  }
  ```

test "lifecycle: java finally inside a branch does not release a lock outside it"
  lang java
  expect VYQL-LIFE-001
  code
  ```
  import java.util.concurrent.locks.ReentrantLock;
  public class A {
      private final ReentrantLock lock = new ReentrantLock();
      void work() {}
      void f(boolean ok) { lock.lock(); if (ok) { try { work(); } finally { lock.unlock(); } } }
  }
  ```

test "lifecycle: go mutex lock without unlock is reported"
  lang go
  expect VYQL-LIFE-001
  code
  ```
  package main
  import "sync"
  func f(mu *sync.Mutex) {
      mu.Lock()
  }
  ```

test "lifecycle: go mutex lock with unlock is clean"
  lang go
  reject VYQL-LIFE-001
  code
  ```
  package main
  import "sync"
  func f(mu *sync.Mutex) {
      mu.Lock()
      mu.Unlock()
  }
  ```

test "lifecycle: go mutex lock released by defer is clean"
  lang go
  reject VYQL-LIFE-001
  code
  ```
  package main
  import "sync"
  func f(mu *sync.Mutex) {
      mu.Lock()
      defer mu.Unlock()
  }
  ```

test "lifecycle: go deferred unlock releases a lock taken in a branch"
  lang go
  reject VYQL-LIFE-001
  code
  ```
  package main
  import "sync"
  func f(mu *sync.Mutex, ok bool) {
      if ok {
          mu.Lock()
          defer mu.Unlock()
      }
  }
  ```

test "lifecycle: go deferred unlock inside a closure releases the closure's lock"
  lang go
  reject VYQL-LIFE-001
  code
  ```
  package main
  import "sync"
  func f(mu *sync.Mutex) func() {
      return func() {
          mu.Lock()
          defer mu.Unlock()
      }
  }
  ```

test "lifecycle: swift lock without unlock is reported"
  lang swift
  expect VYQL-LIFE-001
  code
  ```
  import Foundation
  func f(_ mu: NSLock) {
      mu.lock()
  }
  ```

test "lifecycle: swift lock with unlock is clean"
  lang swift
  reject VYQL-LIFE-001
  code
  ```
  import Foundation
  func f(_ mu: NSLock) {
      mu.lock()
      mu.unlock()
  }
  ```

test "lifecycle: swift lock released by defer is clean"
  lang swift
  reject VYQL-LIFE-001
  code
  ```
  import Foundation
  func f(_ mu: NSLock) {
      mu.lock()
      defer { mu.unlock() }
  }
  ```

test "lifecycle: swift defer written above the acquire still releases it"
  lang swift
  reject VYQL-LIFE-001
  code
  ```
  import Foundation
  func f(_ mu: NSLock) {
      defer { mu.unlock() }
      mu.lock()
  }
  ```

test "lifecycle: swift unlock deferred only on one branch is reported"
  lang swift
  expect VYQL-LIFE-001
  code
  ```
  import Foundation
  func f(_ mu: NSLock, _ ok: Bool) {
      mu.lock()
      if ok {
          defer { mu.unlock() }
      }
  }
  ```

test "lifecycle: swift pthread mutex without unlock is reported"
  lang swift
  expect VYQL-LIFE-001
  code
  ```
  import Foundation
  func f(_ m: UnsafeMutablePointer<pthread_mutex_t>) {
      pthread_mutex_lock(m)
  }
  ```

test "lifecycle: swift pthread mutex released by defer is clean"
  lang swift
  reject VYQL-LIFE-001
  code
  ```
  import Foundation
  func f(_ m: UnsafeMutablePointer<pthread_mutex_t>) {
      pthread_mutex_lock(m)
      defer { pthread_mutex_unlock(m) }
  }
  ```

test "lifecycle: go unlock deferred only on one branch is reported"
  lang go
  expect VYQL-LIFE-001
  code
  ```
  package main
  import "sync"
  func f(mu *sync.Mutex, ok bool) {
      mu.Lock()
      if ok {
          defer mu.Unlock()
      }
  }
  ```
