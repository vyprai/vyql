# Lifecycle / typestate coverage.

test "lifecycle: lock acquired without release is reported (c)"
  lang c
  expect VYQL-LIFE-001
  code
  ```
  typedef int pthread_mutex_t;
  void pthread_mutex_lock(pthread_mutex_t *);
  void f(pthread_mutex_t *m) {
      pthread_mutex_lock(m);
  }
  ```

test "lifecycle: lock released on the same path is clean (c)"
  lang c
  reject VYQL-LIFE-001
  code
  ```
  typedef int pthread_mutex_t;
  void pthread_mutex_lock(pthread_mutex_t *);
  void pthread_mutex_unlock(pthread_mutex_t *);
  void f(pthread_mutex_t *m) {
      pthread_mutex_lock(m);
      pthread_mutex_unlock(m);
  }
  ```

test "lifecycle: go mutex lock without unlock is reported"
  lang go
  expect VYQL-LIFE-001
  code
  ```
  package main
  import "sync"
  func f(mu *sync.Mutex) {
      mu.Lock()
  }
  ```

test "lifecycle: go mutex lock with unlock is clean"
  lang go
  reject VYQL-LIFE-001
  code
  ```
  package main
  import "sync"
  func f(mu *sync.Mutex) {
      mu.Lock()
      mu.Unlock()
  }
  ```

test "lifecycle: go mutex lock released by defer is clean"
  lang go
  reject VYQL-LIFE-001
  code
  ```
  package main
  import "sync"
  func f(mu *sync.Mutex) {
      mu.Lock()
      defer mu.Unlock()
  }
  ```

test "lifecycle: go deferred unlock releases a lock taken in a branch"
  lang go
  reject VYQL-LIFE-001
  code
  ```
  package main
  import "sync"
  func f(mu *sync.Mutex, ok bool) {
      if ok {
          mu.Lock()
          defer mu.Unlock()
      }
  }
  ```

test "lifecycle: go deferred unlock inside a closure releases the closure's lock"
  lang go
  reject VYQL-LIFE-001
  code
  ```
  package main
  import "sync"
  func f(mu *sync.Mutex) func() {
      return func() {
          mu.Lock()
          defer mu.Unlock()
      }
  }
  ```

test "lifecycle: go unlock deferred only on one branch is reported"
  lang go
  expect VYQL-LIFE-001
  code
  ```
  package main
  import "sync"
  func f(mu *sync.Mutex, ok bool) {
      mu.Lock()
      if ok {
          defer mu.Unlock()
      }
  }
  ```
