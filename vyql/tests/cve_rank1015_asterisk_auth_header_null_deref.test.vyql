# Rank 1015 / CVE-2025-57767: Asterisk crashes on a malformed SIP Authorization
# header. digest_lookup assigned the result of get_authorization_hdr(), which
# returns NULL when the request carries no Authorization header or one whose
# realm does not match, and dereferenced it on the next statement to read the
# digest algorithm, so a remote SIP request segfaults the process (CWE-253,
# CWE-476). The fix 02993717b0 guards the dereference with a ternary and adds an
# explicit auth_hdr == NULL branch returning PJSIP_SC_FORBIDDEN.
#
# ATTENTION, engine gap, and a narrow one. The concept, rule and C binding for
# this already exist and work: code.UncheckedNullableResultDeref
# (VYQL-MEM-018, CWE-476) fires from the extractor fact
# analysis.nullable_result.unchecked_deref, computed in
# ccUncheckedNullableResultDerefObservations. Three probes locate the gap
# exactly. The fact's assignment pattern requires the assignment target to be a
# member expression, obj->field = f(...), so:
#  - the Asterisk shape, a plain local pointer assigned from the call
#    (struct hdr *auth_hdr = get_authorization_hdr(...)) and then dereferenced,
#    produces no finding;
#  - the same weakness written with a member target (st->auth_hdr = ...) is
#    reported as VYQL-MEM-018;
#  - adding the null guard to that member form suppresses it again.
# So the detection already discriminates the vulnerable form from the patched
# one correctly, and only the syntactic form of the assignment target blocks it.
# Extending the pattern to accept a plain identifier target, including a
# declaration with a pointer declarator, would make this rank CAUGHT. That is a
# Go change in the C frontend, which this loop does not attempt.
# The generic review that does fire on the real file, VYQL-MEM-006, reports nine
# dereferences at other lines and none at the vulnerable one, so it is noise
# rather than evidence here.
#
# The last two tests pin the behaviour that already works, so the engine change
# has a regression test waiting for it.
#
# verify_current_expected: attention-engine-gap

test "rank1015: nullable result assigned to a plain pointer and dereferenced is missed"
  lang c
  file res/res_pjsip_authenticator_digest.c
  reject VYQL-MEM-018
  code
  ```
  #include <stddef.h>

  struct hdr { struct { int algorithm; } digest; };

  static struct hdr *get_authorization_hdr(const char *realm)
  {
      if (realm == NULL) {
          return NULL;
      }
      return lookup(realm);
  }

  int digest_lookup(const char *realm)
  {
      struct hdr *auth_hdr = get_authorization_hdr(realm);
      int algorithm = auth_hdr->digest.algorithm;
      return algorithm;
  }
  ```

test "rank1015: fix guards the plain pointer before dereferencing it"
  lang c
  file res/res_pjsip_authenticator_digest.c
  reject VYQL-MEM-018
  code
  ```
  #include <stddef.h>

  struct hdr { struct { int algorithm; } digest; };

  static struct hdr *get_authorization_hdr(const char *realm)
  {
      if (realm == NULL) {
          return NULL;
      }
      return lookup(realm);
  }

  int digest_lookup(const char *realm)
  {
      struct hdr *auth_hdr = get_authorization_hdr(realm);
      if (auth_hdr == NULL) {
          return -1;
      }
      int algorithm = auth_hdr->digest.algorithm;
      return algorithm;
  }
  ```

test "rank1015: the same weakness with a member assignment target is reported"
  lang c
  file res/res_pjsip_authenticator_digest.c
  expect VYQL-MEM-018
  code
  ```
  #include <stddef.h>

  struct hdr { struct { int algorithm; } digest; };
  struct state { struct hdr *auth_hdr; };

  static struct hdr *get_authorization_hdr(const char *realm)
  {
      if (realm == NULL) {
          return NULL;
      }
      return lookup(realm);
  }

  int digest_lookup(struct state *st, const char *realm)
  {
      st->auth_hdr = get_authorization_hdr(realm);
      int algorithm = st->auth_hdr->digest.algorithm;
      return algorithm;
  }
  ```

test "rank1015: a null guard on the member target suppresses the finding"
  lang c
  file res/res_pjsip_authenticator_digest.c
  reject VYQL-MEM-018
  code
  ```
  #include <stddef.h>

  struct hdr { struct { int algorithm; } digest; };
  struct state { struct hdr *auth_hdr; };

  static struct hdr *get_authorization_hdr(const char *realm)
  {
      if (realm == NULL) {
          return NULL;
      }
      return lookup(realm);
  }

  int digest_lookup(struct state *st, const char *realm)
  {
      st->auth_hdr = get_authorization_hdr(realm);
      if (st->auth_hdr == NULL) {
          return -1;
      }
      int algorithm = st->auth_hdr->digest.algorithm;
      return algorithm;
  }
  ```
