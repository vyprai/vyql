# Python static-regex ReDoS coverage: vulnerable constant regex construction.

test "python: IFTTT URL regex with optional slash inside repeated event is ReDoS"
  lang python
  expect VYQL-DOS-003
  code
  ```
  import re

  def parse(url):
      return re.match(
          r'^https?://maker\.ifttt\.com/use/'
          r'(?P<webhook_id>[A-Z0-9_-]+)'
          r'/?(?P<events>([A-Z0-9_-]+/?)+)?'
          r'/?(?P<params>\?.+)?$', url, re.I)
  ```

test "python: IFTTT URL regex with slash outside repeated event is clean"
  lang python
  reject VYQL-DOS-003
  code
  ```
  import re

  def parse(url):
      return re.match(
          r'^https?://maker\.ifttt\.com/use/'
          r'(?P<webhook_id>[A-Z0-9_-]+)'
          r'((?P<events>(/[A-Z0-9_-]+)+))?'
          r'/?(?P<params>\?.+)?$', url, re.I)
  ```
