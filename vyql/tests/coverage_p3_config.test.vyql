# P3: AndroidManifest.xml / iOS Info.plist insecure-configuration checks.

test "config: AndroidManifest exported activity is flagged"
  lang config
  expect VYQL-MOB-003
  file AndroidManifest.xml
  ```
  <?xml version="1.0" encoding="utf-8"?>
  <manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.x">
    <application android:label="x">
      <activity android:name=".Admin" android:exported="true"/>
    </application>
  </manifest>
  ```

test "config: AndroidManifest usesCleartextTraffic is flagged"
  lang config
  expect VYQL-MOB-004
  file AndroidManifest.xml
  ```
  <?xml version="1.0" encoding="utf-8"?>
  <manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.x">
    <application android:usesCleartextTraffic="true"/>
  </manifest>
  ```

test "config: AndroidManifest debuggable is flagged"
  lang config
  expect VYQL-MOB-005
  file AndroidManifest.xml
  ```
  <?xml version="1.0" encoding="utf-8"?>
  <manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.x">
    <application android:debuggable="true"/>
  </manifest>
  ```

test "config: AndroidManifest missing allowBackup false is flagged"
  lang config
  expect VYQL-MOB-006
  file AndroidManifest.xml
  ```
  <?xml version="1.0" encoding="utf-8"?>
  <manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.x">
    <application android:label="x"/>
  </manifest>
  ```

test "config: AndroidManifest allowBackup true is flagged"
  lang config
  expect VYQL-MOB-006
  file AndroidManifest.xml
  ```
  <?xml version="1.0" encoding="utf-8"?>
  <manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.x">
    <application android:allowBackup="true"/>
  </manifest>
  ```

test "config: a hardened AndroidManifest is clean"
  lang config
  reject VYQL-MOB-003
  reject VYQL-MOB-004
  reject VYQL-MOB-005
  reject VYQL-MOB-006
  file AndroidManifest.xml
  ```
  <?xml version="1.0" encoding="utf-8"?>
  <manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.x">
    <application android:allowBackup="false" android:usesCleartextTraffic="false" android:debuggable="false">
      <activity android:name=".Main" android:exported="false"/>
    </application>
  </manifest>
  ```

test "config: iOS Info.plist NSAllowsArbitraryLoads is flagged"
  lang config
  expect VYQL-MOB-004
  file Info.plist
  ```
  <?xml version="1.0" encoding="UTF-8"?>
  <plist version="1.0">
  <dict>
    <key>NSAppTransportSecurity</key>
    <dict>
      <key>NSAllowsArbitraryLoads</key>
      <true/>
    </dict>
  </dict>
  </plist>
  ```

test "config: iOS Info.plist with ATS enabled is clean"
  lang config
  reject VYQL-MOB-004
  file Info.plist
  ```
  <?xml version="1.0" encoding="UTF-8"?>
  <plist version="1.0">
  <dict>
    <key>NSAppTransportSecurity</key>
    <dict>
      <key>NSAllowsArbitraryLoads</key>
      <false/>
    </dict>
  </dict>
  </plist>
  ```
