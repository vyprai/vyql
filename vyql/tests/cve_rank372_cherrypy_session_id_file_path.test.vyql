# Rank 372 / CVE-2008-0252: CherryPy FileSession built session file paths
# from a cookie-supplied session id without a canonical containment check.

test "rank372: CherryPy file session id reaches filesystem path"
  lang python
  expect VYQL-PATH-017
  expect_review code.CherryPySessionIdFilePathTraversal
  code
  ```
  import os

  class Session:
      def __init__(self, id=None):
          self.id = id

  def init(storage_class, request, name):
      id = None
      if name in request.cookie:
          id = request.cookie[name].value
      return storage_class(id)

  class FileSession(Session):
      SESSION_PREFIX = "session-"

      def __init__(self, id=None, storage_path="/tmp/sessions"):
          Session.__init__(self, id)
          self.storage_path = storage_path

      def _get_file_path(self):
          return os.path.join(self.storage_path, self.SESSION_PREFIX + self.id)

      def _load(self):
          path = self._get_file_path()
          f = open(path, "rb")
          return f.read()
  ```

test "rank372: CherryPy file session id with normpath containment is clean"
  lang python
  reject VYQL-PATH-017
  reject_review code.CherryPySessionIdFilePathTraversal
  code
  ```
  import os

  class Session:
      def __init__(self, id=None):
          self.id = id

  def init(storage_class, request, name):
      id = None
      if name in request.cookie:
          id = request.cookie[name].value
      return storage_class(id)

  class FileSession(Session):
      SESSION_PREFIX = "session-"

      def __init__(self, id=None, storage_path="/tmp/sessions"):
          Session.__init__(self, id)
          self.storage_path = storage_path

      def _get_file_path(self):
          f = os.path.join(self.storage_path, self.SESSION_PREFIX + self.id)
          if not os.path.normpath(f).startswith(self.storage_path):
              raise cherrypy.HTTPError(400, "Invalid session id in cookie.")
          return f

      def _load(self):
          path = self._get_file_path()
          f = open(path, "rb")
          return f.read()
  ```
