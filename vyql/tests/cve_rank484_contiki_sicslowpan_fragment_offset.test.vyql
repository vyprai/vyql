# Rank 484 / CVE-2019-8359: Contiki-NG reassembled 6LoWPAN fragments by
# copying stored fragments into UIP_IP_BUF at frag_buf[i].offset << 3 without
# checking offset + length against uip_buf. The fix rejects oversized copies.

test "rank484: Contiki-NG reassembly copies stored fragment at unchecked offset"
  lang c
  file sicslowpan.c
  expect VYQL-MEM-028
  expect_review code.ContikiSicslowpanFragmentOffsetOobWrite
  code
  ```
  typedef unsigned char uint8_t;
  typedef unsigned short uint16_t;
  void *memcpy(void *dest, const void *src, unsigned long n);
  void clear_fragments(int context);
  enum { SICSLOWPAN_FRAGMENT_BUFFERS = 4 };
  uint8_t uip_buf[128];
  #define UIP_IP_BUF uip_buf

  struct frag_state {
    int len;
    int index;
    uint8_t offset;
    uint8_t data[128];
  } frag_buf[SICSLOWPAN_FRAGMENT_BUFFERS];

  struct frag_context {
    int first_frag_len;
    uint8_t first_frag[128];
  } frag_info[SICSLOWPAN_FRAGMENT_BUFFERS];

  static void copy_frags2uip(int context)
  {
    int i;

    memcpy((uint8_t *)UIP_IP_BUF, (uint8_t *)frag_info[context].first_frag,
           frag_info[context].first_frag_len);
    for(i = 0; i < SICSLOWPAN_FRAGMENT_BUFFERS; i++) {
      if(frag_buf[i].len > 0 && frag_buf[i].index == context) {
        memcpy((uint8_t *)UIP_IP_BUF + (uint16_t)(frag_buf[i].offset << 3),
               (uint8_t *)frag_buf[i].data, frag_buf[i].len);
      }
    }
    clear_fragments(context);
  }
  ```

test "rank484: Contiki-NG checks offset plus length before reassembly copy"
  lang c
  file sicslowpan.c
  reject VYQL-MEM-028
  reject_review code.ContikiSicslowpanFragmentOffsetOobWrite
  code
  ```
  typedef unsigned char uint8_t;
  typedef unsigned short uint16_t;
  typedef int bool;
  void *memcpy(void *dest, const void *src, unsigned long n);
  void clear_fragments(int context);
  enum { false = 0, true = 1, SICSLOWPAN_FRAGMENT_BUFFERS = 4 };
  uint8_t uip_buf[128];
  #define UIP_IP_BUF uip_buf

  struct frag_state {
    int len;
    int index;
    uint8_t offset;
    uint8_t data[128];
  } frag_buf[SICSLOWPAN_FRAGMENT_BUFFERS];

  struct frag_context {
    int len;
    int first_frag_len;
    uint8_t first_frag[128];
  } frag_info[SICSLOWPAN_FRAGMENT_BUFFERS];

  static bool copy_frags2uip(int context)
  {
    int i;

    if(frag_info[context].len < frag_info[context].first_frag_len ||
       frag_info[context].len > sizeof(uip_buf)) {
      clear_fragments(context);
      return false;
    }

    memcpy((uint8_t *)UIP_IP_BUF, (uint8_t *)frag_info[context].first_frag,
           frag_info[context].first_frag_len);
    for(i = 0; i < SICSLOWPAN_FRAGMENT_BUFFERS; i++) {
      if(frag_buf[i].len > 0 && frag_buf[i].index == context) {
        if((frag_buf[i].offset << 3) + frag_buf[i].len > sizeof(uip_buf)) {
          clear_fragments(context);
          return false;
        }
        memcpy((uint8_t *)UIP_IP_BUF + (uint16_t)(frag_buf[i].offset << 3),
               (uint8_t *)frag_buf[i].data, frag_buf[i].len);
      }
    }
    clear_fragments(context);
    return true;
  }
  ```

test "rank484: shifted fragment offset copy generalizes across names"
  lang c
  file sicslowpan.c
  expect VYQL-MEM-028
  expect_review code.ContikiSicslowpanFragmentOffsetOobWrite
  code
  ```
  typedef unsigned char uint8_t;
  typedef unsigned short uint16_t;
  void *memcpy(void *dest, const void *src, unsigned long n);
  enum { FRAG_SLOTS = 4 };
  uint8_t packet_buf[128];

  struct segment_state {
    int size;
    int owner;
    uint8_t pos;
    uint8_t payload[128];
  } segments[FRAG_SLOTS];

  static void rebuild_packet(int owner)
  {
    int slot;

    for(slot = 0; slot < FRAG_SLOTS; slot++) {
      if(segments[slot].size > 0 && segments[slot].owner == owner) {
        memcpy((uint8_t *)packet_buf + (uint16_t)(segments[slot].pos << 3),
               (uint8_t *)segments[slot].payload, segments[slot].size);
      }
    }
  }
  ```
