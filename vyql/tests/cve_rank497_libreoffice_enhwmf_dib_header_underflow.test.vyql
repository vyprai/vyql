# Rank 497 / CVE-2016-10327: LibreOffice EMF alpha-blend import
# underflowed the DIBV5 header-size delta before heap allocation/copy.

test "rank497: LibreOffice EMF alpha-blend DIB header delta underflows"
  lang cpp
  file enhwmf.cxx
  expect VYQL-MEM-029
  expect_review code.LibreOfficeEnhwmfDibHeaderSizeUnderflow
  code
  ```
  bool EnhWMFReader::ReadEnhWMF() {
    switch (nRecType) {
      case EMR_ALPHABLEND: {
        BLENDFUNCTION aFunc;
        sal_uInt32 cbBmiSrc(0), cbBitsSrc(0);
        sal_uInt32 offBmiSrc(0), offBitsSrc(0);

        pWMF->ReadUInt32(offBmiSrc).ReadUInt32(cbBmiSrc)
             .ReadUInt32(offBitsSrc).ReadUInt32(cbBitsSrc);

        const sal_uInt32 nSourceSize = cbBmiSrc + cbBitsSrc + 14;
        if (nSourceSize <= (nEndPos - nStartPos)) {
          const bool bReadAlpha(0x01 == aFunc.aAlphaFormat);
          const sal_uInt32 nDeltaToDIB5HeaderSize(bReadAlpha ? getDIBV5HeaderSize() - cbBmiSrc : 0);
          const sal_uInt32 nTargetSize(cbBmiSrc + nDeltaToDIB5HeaderSize + cbBitsSrc + 14);
          char* pBuf = new char[nTargetSize];

          pWMF->Seek(nStart + offBmiSrc);
          pWMF->ReadBytes(pBuf + 14, cbBmiSrc);

          if (bReadAlpha) {
            memset(pBuf + cbBmiSrc + 14, 0, nDeltaToDIB5HeaderSize);
          }

          pWMF->Seek(nStart + offBitsSrc);
          pWMF->ReadBytes(pBuf + 14 + nDeltaToDIB5HeaderSize + cbBmiSrc, cbBitsSrc);
        }
      }
      break;
    }
    return true;
  }
  ```

test "rank497: LibreOffice EMF alpha-blend validates cbBmiSrc before delta"
  lang cpp
  file enhwmf.cxx
  reject VYQL-MEM-029
  reject_review code.LibreOfficeEnhwmfDibHeaderSizeUnderflow
  code
  ```
  bool EnhWMFReader::ReadEnhWMF() {
    switch (nRecType) {
      case EMR_ALPHABLEND: {
        BLENDFUNCTION aFunc;
        sal_uInt32 cbBmiSrc(0), cbBitsSrc(0);
        sal_uInt32 offBmiSrc(0), offBitsSrc(0);

        pWMF->ReadUInt32(offBmiSrc).ReadUInt32(cbBmiSrc)
             .ReadUInt32(offBitsSrc).ReadUInt32(cbBitsSrc);

        const sal_uInt32 nSourceSize = cbBmiSrc + cbBitsSrc + 14;
        bool bSafeRead = nSourceSize <= (nEndPos - nStartPos);
        sal_uInt32 nDeltaToDIB5HeaderSize(0);
        const bool bReadAlpha(0x01 == aFunc.aAlphaFormat);
        if (bSafeRead && bReadAlpha) {
          const sal_uInt32 nHeaderSize = getDIBV5HeaderSize();
          if (cbBmiSrc > nHeaderSize)
            bSafeRead = false;
          else
            nDeltaToDIB5HeaderSize = nHeaderSize - cbBmiSrc;
        }
        if (bSafeRead) {
          const sal_uInt32 nTargetSize(cbBmiSrc + nDeltaToDIB5HeaderSize + cbBitsSrc + 14);
          char* pBuf = new char[nTargetSize];

          pWMF->Seek(nStart + offBmiSrc);
          pWMF->ReadBytes(pBuf + 14, cbBmiSrc);

          if (bReadAlpha) {
            memset(pBuf + cbBmiSrc + 14, 0, nDeltaToDIB5HeaderSize);
          }

          pWMF->Seek(nStart + offBitsSrc);
          pWMF->ReadBytes(pBuf + 14 + nDeltaToDIB5HeaderSize + cbBmiSrc, cbBitsSrc);
        }
      }
      break;
    }
    return true;
  }
  ```
