# Rank 666 / CVE-2013-2091: Dolibarr error pages appended request URL
# and referer server variables into buffered HTML and later printed it.

test "rank666: Dolibarr prints raw request metadata in error page"
  lang php
  expect VYQL-INJ-004
  expect VYQL-INJ-145
  code
  ```
  <?php
  function dol_print_error() {
    $out = '';
    if ($_SERVER['DOCUMENT_ROOT']) {
      $out .= '<b>RequestedUrl:</b> ' . $_SERVER['REQUEST_URI'] . "<br>\n";
      $out .= '<b>Referer:</b> ' . (isset($_SERVER['HTTP_REFERER']) ? $_SERVER['HTTP_REFERER'] : '') . "<br>\n";
    }
    print $out;
  }
  ```

test "rank666: Dolibarr escapes request metadata before printing error page"
  lang php
  reject VYQL-INJ-004
  reject VYQL-INJ-145
  code
  ```
  <?php
  function dol_print_error() {
    $out = '';
    if ($_SERVER['DOCUMENT_ROOT']) {
      $out .= '<b>RequestedUrl:</b> ' . dol_htmlentities($_SERVER['REQUEST_URI'], ENT_COMPAT, 'UTF-8') . "<br>\n";
      $out .= '<b>Referer:</b> ' . (isset($_SERVER['HTTP_REFERER']) ? dol_htmlentities($_SERVER['HTTP_REFERER'], ENT_COMPAT, 'UTF-8') : '') . "<br>\n";
    }
    print $out;
  }
  function dol_htmlentities($a, $b, $c = 'UTF-8') {
    return htmlentities($a, $b, $c);
  }
  ```
