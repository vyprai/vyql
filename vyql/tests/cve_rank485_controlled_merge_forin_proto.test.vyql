# Rank 485 / CVE-2020-28268: controlled-merge recursively copied for-in keys
# from source objects into result objects. The fix limits iteration to own
# property names before assigning result[attr].

test "rank485: controlled-merge copies inherited for-in keys"
  lang javascript
  file index.js
  expect VYQL-INJ-106
  expect_review code.ControlledMergeInheritedKeyPrototypePollution
  code
  ```
  var clone = require('clone');

  module.exports = function() {
    var onConflict;

    var iterateAndMerge = function(obj1, obj2) {
      var result = clone(obj1);
      if (Array.isArray(obj1) && Array.isArray(obj2)) {
        obj2.forEach(function(item) {
          if (result.indexOf(item) == -1) result.push(item);
        });
      } else {
        for (var attr in obj2) {
          if (!result[attr]) {
            result[attr] = clone(obj2[attr]);
          } else if (typeof result[attr] == 'object' && typeof obj2[attr] == 'object') {
            result[attr] = iterateAndMerge(obj1[attr], obj2[attr]);
          } else if (onConflict) {
            result[attr] = onConflict(obj1[attr], obj2[attr], attr);
          } else {
            result[attr] = clone(obj2[attr]);
          }
        }
      }

      return result;
    };
  };
  ```

test "rank485: controlled-merge filters for-in keys to own properties"
  lang javascript
  file index.js
  reject VYQL-INJ-106
  reject_review code.ControlledMergeInheritedKeyPrototypePollution
  code
  ```
  var clone = require('clone');

  module.exports = function() {
    var onConflict;

    var iterateAndMerge = function(obj1, obj2) {
      var result = clone(obj1);
      if (Array.isArray(obj1) && Array.isArray(obj2)) {
        obj2.forEach(function(item) {
          if (result.indexOf(item) == -1) result.push(item);
        });
      } else {
        allowedAttrs = Object.getOwnPropertyNames(obj2);
        for (var attr in obj2) {
          if (!allowedAttrs.includes(attr)) {
            continue;
          }
          if (!result[attr]) {
            result[attr] = clone(obj2[attr]);
          } else if (typeof result[attr] == 'object' && typeof obj2[attr] == 'object') {
            result[attr] = iterateAndMerge(obj1[attr], obj2[attr]);
          } else if (onConflict) {
            result[attr] = onConflict(obj1[attr], obj2[attr], attr);
          } else {
            result[attr] = clone(obj2[attr]);
          }
        }
      }

      return result;
    };
  };
  ```
