# OWASP-replica coverage for Scala — true positive plus opaque-match pruning.

test "scala: query string -> executeQuery is SQLi"
  lang scala
  expect VYQL-INJ-001
  code
  ```
  object H {
    def h(req: Request, st: Statement) = {
      val p = req.getQueryString
      st.executeQuery("SELECT " + p)
    }
  }
  ```

test "scala: tainted assign in a live match arm is still SQLi (no FN)"
  lang scala
  expect VYQL-INJ-001
  code
  ```
  object H {
    def h(req: Request, st: Statement) = {
      val p = req.getQueryString
      var c = "ok"
      1 match {
        case 1 => c = p
        case _ => c = "safe"
      }
      st.executeQuery("SELECT " + c)
    }
  }
  ```

test "scala: opaque match routes taint to a dead arm — clean SQLi"
  lang scala
  reject VYQL-INJ-001
  code
  ```
  object H {
    def h(req: Request, st: Statement) = {
      val p = req.getQueryString
      var c = "ok"
      1 match {
        case 9 => c = p
        case _ => c = "safe"
      }
      st.executeQuery("SELECT " + c)
    }
  }
  ```
