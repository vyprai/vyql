# C / C++ coverage breadth: ReDoS, SSRF, XXE, weak crypto, realpath sanitizer.

test "c: env var -> regcomp is ReDoS"
  lang c
  expect VYQL-DOS-001
  code
  ```
  void h() {
    char *u = getenv("PAT");
    regcomp(&re, u, 0);
  }
  ```

test "c: env var -> curl_easy_setopt URL is SSRF"
  lang c
  expect VYQL-RF-001
  code
  ```
  void h() {
    char *u = getenv("URL");
    curl_easy_setopt(curl, CURLOPT_URL, u);
  }
  ```

test "c: env var -> xmlReadMemory is XXE"
  lang c
  expect VYQL-DESER-002
  code
  ```
  void h() {
    char *u = getenv("XML");
    xmlReadMemory(u, sz, NULL, NULL, 0);
  }
  ```

test "c: MD5_Init is weak crypto"
  lang c
  expect VYQL-CRY-001
  code
  ```
  void h() { MD5_Init(&ctx); }
  ```

test "c: realpath neutralizes path traversal"
  lang c
  reject VYQL-PATH-001
  code
  ```
  void h() {
    char *u = getenv("FILE");
    char *p = realpath(u, buf);
    fopen(p, "r");
  }
  ```

test "c: field-derived array index without upper bound is memory attention"
  lang c
  expect VYQL-MEM-010
  code
  ```
  struct N { int neighbor[3]; };
  struct S { struct N *nodes; int n; };

  void fix(struct S *s, int facet, int j, char *seen) {
    if (s->nodes[facet].neighbor[j] != -1) {
      if (seen[s->nodes[facet].neighbor[j]] != 1) {
        seen[s->nodes[facet].neighbor[j]] = 1;
      }
    }
  }
  ```

test "c: field-derived array index with upper bound is clean"
  lang c
  reject VYQL-MEM-010
  code
  ```
  struct N { int neighbor[3]; };
  struct S { struct N *nodes; int n; };

  void fix(struct S *s, int facet, int j, char *seen) {
    if (s->nodes[facet].neighbor[j] != -1 &&
        s->nodes[facet].neighbor[j] < s->n) {
      if (seen[s->nodes[facet].neighbor[j]] != 1) {
        seen[s->nodes[facet].neighbor[j]] = 1;
      }
    }
  }
  ```

