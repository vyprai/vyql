test "rank328: CAS LDAP CRL fetcher reuses bind credentials for certificate URL"
  lang java
  expect VYQL-SEC-006
  expect_review code.LdapCrlCredentialReuse
  code
  ```
  import org.ldaptive.ConnectionConfig;
  import org.ldaptive.ConnectionFactory;
  import org.ldaptive.DefaultConnectionFactory;

  class LdaptiveResourceCRLFetcher {
      private final ConnectionConfig connectionConfig = new ConnectionConfig();

      protected ConnectionFactory prepareConnectionFactory(final String ldapURL) {
          var cc = ConnectionConfig.copy(this.connectionConfig);
          cc.setLdapUrl(ldapURL);
          return new DefaultConnectionFactory(cc);
      }
  }
  ```

test "rank328: CAS LDAP CRL fetcher clears bind initializers for foreign URL"
  lang java
  reject VYQL-SEC-006
  reject_review code.LdapCrlCredentialReuse
  code
  ```
  import org.ldaptive.ConnectionConfig;
  import org.ldaptive.ConnectionFactory;
  import org.ldaptive.DefaultConnectionFactory;

  class LdaptiveResourceCRLFetcher {
      private final ConnectionConfig connectionConfig = new ConnectionConfig();

      protected ConnectionFactory prepareConnectionFactory(final String ldapURL) {
          var cc = ConnectionConfig.copy(this.connectionConfig);
          if (!cc.getLdapUrl().equals(ldapURL)) {
              cc.setConnectionInitializers();
          }
          cc.setLdapUrl(ldapURL);
          return new DefaultConnectionFactory(cc);
      }
  }
  ```
