# Rank 652 / CVE-2020-5224: django-user-sessions exposed session keys in
# rendered session-management forms by using object.pk in the delete URL.

test "rank652: Django template exposes session key in per-session action URL"
  lang config
  file user_sessions/templates/user_sessions/session_list.html
  expect VYQL-SEC-022
  code
  ```
  {% for object in object_list %}
    <tr {% if object.session_key == session_key %}class="active"{% endif %}>
      <td>{{ object.ip|location|default_if_none:unknown|safe }}</td>
      <td>
        <form method="post" action="{% url 'user_sessions:session_delete' object.pk %}">
          {% csrf_token %}
          <button type="submit">End Session</button>
        </form>
      </td>
    </tr>
  {% endfor %}
  ```

test "rank652: Django template omits per-session key action URL"
  lang config
  file user_sessions/templates/user_sessions/session_list.html
  reject VYQL-SEC-022
  code
  ```
  {% for object in object_list %}
    <tr {% if object.session_key == session_key %}class="active"{% endif %}>
      <td>{{ object.ip|location|default_if_none:unknown|safe }}</td>
      <td>{{ object.user_agent|device|default_if_none:unknown_on_unknown|safe }}</td>
    </tr>
  {% endfor %}
  ```
