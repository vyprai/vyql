test "rank527: Craft 2FA serializes full user model in JSON success"
  lang php
  file VerifyController.php
  expect VYQL-SEC-016
  expect_review code.SensitiveModelJsonSerializationExposure
  code
  ```
  <?php
  use Craft;
  use yii\web\Response;

  class VerifyController extends Controller
  {
      private function _handleSuccessfulLogin(\craft\elements\User $user): Response
      {
          $userSession = Craft::$app->getUser();
          $returnUrl = $userSession->getReturnUrl();
          $userSession->removeReturnUrl();

          if ($this->request->getAcceptsJson()) {
              $return = [
                  'returnUrl' => $returnUrl,
              ];

              if (Craft::$app->getConfig()->getGeneral()->enableCsrfProtection) {
                  $return['csrfTokenValue'] = $this->request->getCsrfToken();
              }

              return $this->asModelSuccess($user, modelName: 'user', data: $return);
          }

          return $this->redirectToPostedUrl($userSession->getIdentity(), $returnUrl);
      }
  }
  ```

