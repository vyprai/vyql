# --- Swift / Objective-C / C-family static-IV and mobile/backend parity ---
test "p4 swift: sensitive operation without auth is reported"
  lang swift
  expect VYQL-AUTH-001
  code
  ```
  func handler(request: Request) {
    changePassword(request.query["password"])
  }
  ```

test "p4 swift: auth guard suppresses sensitive operation"
  lang swift
  reject VYQL-AUTH-001
  code
  ```
  func handler(request: Request) {
    requireAuth(request)
    changePassword(request.query["password"])
  }
  ```

test "p4 swift: request id lookup is IDOR"
  lang swift
  expect VYQL-AUTH-002
  code
  ```
  func handler(request: Request, repo: Repo) {
    repo.findById(request.query["id"])
  }
  ```

test "p4 swift: cleartext URL is reported"
  lang swift
  expect VYQL-CFG-006
  code
  ```
  func f() {
    URL(string: "http://example.com")
  }
  ```

test "p4 swift: localhost cleartext URL is clean"
  lang swift
  reject VYQL-CFG-006
  code
  ```
  func f() {
    URL(string: "http://127.0.0.1:8080")
  }
  ```

test "p4 objc: static IV is reported"
  lang objc
  expect VYQL-CRY-004
  code
  ```
  void f() {
    CCCrypt(kCCEncrypt, kCCAlgorithmAES, 0, key, 16, "0000000000000000", in, len, out, outLen, &moved);
  }
  ```

test "p4 objc: cleartext URL is reported"
  lang objc
  expect VYQL-CFG-006
  code
  ```
  void f() {
    [NSURL URLWithString:@"http://example.com"];
  }
  ```

test "p4 objc: cert validation disable is reported"
  lang objc
  expect VYQL-CFG-004
  code
  ```
  void f(AFHTTPSessionManager *manager) {
    [manager setAllowsAnyHTTPSCertificate:YES];
  }
  ```

test "p4 c: static IV is reported"
  lang c
  expect VYQL-CRY-004
  code
  ```
  void f() {
    EVP_EncryptInit_ex(ctx, cipher, NULL, key, "0000000000000000");
  }
  ```

test "p4 cpp: static IV is reported"
  lang cpp
  expect VYQL-CRY-004
  code
  ```
  void f() {
    EVP_EncryptInit_ex(ctx, cipher, nullptr, key, "0000000000000000");
  }
  ```
