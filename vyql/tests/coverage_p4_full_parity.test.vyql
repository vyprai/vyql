# P4 parity closure: long-tail and mobile/native families promoted from
# "baseline" to explicit coverage where the frontend exposes reliable call,
# literal, and guard shapes.

# --- Dart ---
test "p4 dart: sensitive operation without auth is reported"
  lang dart
  expect VYQL-AUTH-001
  code
  ```
  void handler(Request request) {
    changePassword(request.params["password"]);
  }
  ```

test "p4 dart: auth guard suppresses sensitive operation"
  lang dart
  reject VYQL-AUTH-001
  code
  ```
  void handler(Request request) {
    requireAuth(request);
    changePassword(request.params["password"]);
  }
  ```

test "p4 dart: request id lookup is IDOR"
  lang dart
  expect VYQL-AUTH-002
  code
  ```
  void handler(Request request, Repo repo) {
    repo.findById(request.params["id"]);
  }
  ```

test "p4 dart: tainted archive entry extraction is traversal"
  lang dart
  expect VYQL-PATH-004
  code
  ```
  void handler(Request request, Archive archive) {
    archive.extractEntry(request.params["name"]);
  }
  ```

test "p4 dart: canonicalized archive entry is clean"
  lang dart
  reject VYQL-PATH-004
  code
  ```
  void handler(Request request, Archive archive) {
    final name = safePath(request.params["name"]);
    archive.extractEntry(name);
  }
  ```

test "p4 dart: tainted regular expression is ReDoS"
  lang dart
  expect VYQL-DOS-001
  code
  ```
  void handler(Request request) {
    RegExp(request.params["pattern"]);
  }
  ```

test "p4 dart: constant regular expression is clean"
  lang dart
  reject VYQL-DOS-001
  code
  ```
  void handler() {
    RegExp(r"^[a-z]+$");
  }
  ```

test "p4 dart: static IV is reported"
  lang dart
  expect VYQL-CRY-004
  code
  ```
  void encrypt() {
    ParametersWithIV(key, "0000000000000000");
  }
  ```

test "p4 dart: non-static IV literal is clean"
  lang dart
  reject VYQL-CRY-004
  code
  ```
  void encrypt() {
    ParametersWithIV(key, randomIv);
  }
  ```

# --- Groovy ---
test "p4 groovy: sensitive operation without auth is reported"
  lang groovy
  expect VYQL-AUTH-001
  code
  ```
  def handler() {
    changePassword(params.password)
  }
  ```

test "p4 groovy: auth guard suppresses sensitive operation"
  lang groovy
  reject VYQL-AUTH-001
  code
  ```
  def handler() {
    requireAuth()
    changePassword(params.password)
  }
  ```

test "p4 groovy: request id lookup is IDOR"
  lang groovy
  expect VYQL-AUTH-002
  code
  ```
  def handler(repo) {
    repo.findById(params.id)
  }
  ```

test "p4 groovy: tainted archive entry extraction is traversal"
  lang groovy
  expect VYQL-PATH-004
  code
  ```
  def handler(zip) {
    zip.extractEntry(params.name)
  }
  ```

test "p4 groovy: static IV is reported"
  lang groovy
  expect VYQL-CRY-004
  code
  ```
  def encrypt() {
    new IvParameterSpec("0000000000000000".bytes)
  }
  ```

test "p4 groovy: tainted regex compile is ReDoS"
  lang groovy
  expect VYQL-DOS-001
  code
  ```
  def handler() {
    Pattern.compile(params.pattern)
  }
  ```

test "p4 groovy: tainted deserialization is reported"
  lang groovy
  expect VYQL-DESER-001
  code
  ```
  def handler(stream) {
    stream.readObject(params.payload)
  }
  ```

test "p4 groovy: NoopHostnameVerifier disables cert validation"
  lang groovy
  expect VYQL-CFG-004
  code
  ```
  def f(client) {
    client.setHostnameVerifier(NoopHostnameVerifier.INSTANCE)
  }
  ```

test "p4 groovy: default hostname verifier is clean"
  lang groovy
  reject VYQL-CFG-004
  code
  ```
  def f(client) {
    client.setHostnameVerifier(DefaultHostnameVerifier.INSTANCE)
  }
  ```

test "p4 groovy: Algorithm.none disables JWT verification"
  lang groovy
  expect VYQL-CFG-005
  code
  ```
  def f(jwt) {
    jwt.require(Algorithm.none())
  }
  ```

test "p4 groovy: SHA256 JWT algorithm is clean"
  lang groovy
  reject VYQL-CFG-005
  code
  ```
  def f(jwt) {
    jwt.require(Algorithm.HMAC256("secret"))
  }
  ```

