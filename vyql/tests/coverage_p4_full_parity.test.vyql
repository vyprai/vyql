  lang lua
  expect VYQL-PATH-004
  code
  ```
  function handler(zip)
    zip:extractEntry(ngx.var.name)
  end
  ```

test "p4 lua: static IV is reported"
  lang lua
  expect VYQL-CRY-004
  code
  ```
  function encrypt()
    crypto.cipher("AES-CBC", key, "0000000000000000")
  end
  ```

# --- Perl ---
test "p4 perl: sensitive operation without auth is reported"
  lang perl
  expect VYQL-AUTH-001
  code
  ```
  sub handler {
    my $password = param("password");
    change_password($password);
  }
  ```

test "p4 perl: auth guard suppresses sensitive operation"
  lang perl
  reject VYQL-AUTH-001
  code
  ```
  sub handler {
    my $password = param("password");
    require_auth();
    change_password($password);
  }
  ```

test "p4 perl: request id lookup is IDOR"
  lang perl
  expect VYQL-AUTH-002
  code
  ```
  sub handler {
    my $id = param("id");
    $repo->get_user($id);
  }
  ```

test "p4 perl: tainted archive member extraction is traversal"
  lang perl
  expect VYQL-PATH-004
  code
  ```
  sub handler {
    my $name = param("name");
    $zip->extractMember($name);
  }
  ```

test "p4 perl: static IV is reported"
  lang perl
  expect VYQL-CRY-004
  code
  ```
  sub encrypt {
    Crypt::CBC->new(-cipher => "AES", -iv => "0000000000000000");
  }
  ```

test "p4 perl: world-writable chmod is reported"
  lang perl
  expect VYQL-CFG-008
  code
  ```
  sub f {
    chmod 0777, "data.txt";
  }
  ```

# --- Rust ---
test "p4 rust: sensitive operation without auth is reported"
  lang rust
  expect VYQL-AUTH-001
  code
  ```
  fn handler(password: String) {
      change_password(password);
  }
  ```

test "p4 rust: auth guard suppresses sensitive operation"
  lang rust
  reject VYQL-AUTH-001
  code
  ```
  fn handler(password: String) {
      require_auth();
      change_password(password);
  }
  ```

test "p4 rust: routed request id lookup is IDOR"
  lang rust
  expect VYQL-AUTH-002
  code
  ```
  #[get("/")]
  fn handler(id: String, repo: Repo) {
      repo.find_by_id(id);
  }
  ```

test "p4 rust: tainted archive entry extraction is traversal"
  lang rust
  expect VYQL-PATH-004
  code
  ```
  #[get("/")]
  fn handler(name: String, archive: Archive) {
      archive.extract_entry(name);
  }
  ```

test "p4 rust: invalid-cert acceptance is reported"
  lang rust
  expect VYQL-CFG-004
  code
  ```
  fn client() {
      ClientBuilder::new().danger_accept_invalid_certs(true);
  }
  ```

test "p4 rust: default cert validation is clean"
  lang rust
  reject VYQL-CFG-004
  code
  ```
  fn client() {
      ClientBuilder::new().danger_accept_invalid_certs(false);
  }
  ```

test "p4 rust: static IV is reported"
  lang rust
  expect VYQL-CRY-004
  code
  ```
  fn encrypt(key: &[u8]) {
      Cbc::<Aes128>::new_from_slices(key, b"0000000000000000");
  }
  ```

test "p4 rust: dynamic IV is clean"
  lang rust
  reject VYQL-CRY-004
  code
  ```
  fn encrypt(key: &[u8], iv: &[u8]) {
      Cbc::<Aes128>::new_from_slices(key, iv);
  }
  ```

test "p4 rust: world-writable mode is reported"
  lang rust
  expect VYQL-CFG-008
  code
  ```
  fn f(opts: OpenOptions) {
      opts.mode(0o777);
  }
  ```

test "p4 rust: owner-only mode is clean"
  lang rust
  reject VYQL-CFG-008
  code
  ```
  fn f(opts: OpenOptions) {
      opts.mode(0o600);
  }
  ```

test "p4 rust: predictable temp file creation is reported"
  lang rust
  expect VYQL-PATH-003
  code
  ```
  fn f() {
      File::create("/tmp/vyql-cache");
  }
  ```

