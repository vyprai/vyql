test "php: unscanned PDF preview response is XSS-relevant"
  lang php
  expect VYQL-INJ-026
  code
  ```
  <?php
  function preview($asset) {
      $stream = $asset->getStream();
      return new StreamedResponse(function () use ($stream) {
          fpassthru($stream);
      }, 200, [
          'Content-Type' => 'application/pdf',
      ]);
  }
  ```

test "php: PDF preview scan gate suppresses unscanned PDF response"
  lang php
  reject VYQL-INJ-026
  code
  ```
  <?php
  function preview($asset) {
      $scanResponse = getResponseByScanStatus($asset);
      if ($scanResponse) {
          return $scanResponse;
      }
      $stream = $asset->getStream();
      return new StreamedResponse(function () use ($stream) {
          fpassthru($stream);
      }, 200, [
          'Content-Type' => 'application/pdf',
      ]);
  }
  ```

test "php: non-PDF streamed response is not PDF preview XSS"
