test "javascript: explicit markdown negotiation helper is clean"
  lang javascript
  reject VYQL-INJ-021
  code
  ```
  export function middleware(request) {
    const result = negotiate(request.headers.get('accept') ?? '');
    if (result === 'markdown') {
      return NextResponse.rewrite(new URL('/api/md', request.url));
    }
    return NextResponse.next();
  }
  ```

test "javascript: pdfjs getDocument with eval support is XSS"
  lang javascript
  expect VYQL-INJ-022
  code
  ```
  function load(source, options) {
    const optionsWithModifiedIsEvalSupported = { ...options, isEvalSupported: true };
    const documentInitParams = {
      ...source,
      ...optionsWithModifiedIsEvalSupported,
    };
    return pdfjs.getDocument(documentInitParams);
  }
  ```

test "javascript: pdfjs getDocument with eval disabled is clean"
  lang javascript
  reject VYQL-INJ-022
  code
  ```
  function load(source, options) {
    const optionsWithModifiedIsEvalSupported = { ...options, isEvalSupported: false };
    const documentInitParams = {
      ...source,
      ...optionsWithModifiedIsEvalSupported,
    };
    return pdfjs.getDocument(documentInitParams);
  }
  ```

