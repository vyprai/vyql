# --- Sanitizer recognition (VYQL-INJ-002 command injection) ---
test "python: os.system of raw request input is command injection"
  lang python
  expect VYQL-INJ-002
  code
  ```
  def unsafe():
      y = request.args['q']
      os.system("ping " + y)
  ```

test "python: shlex.quote neutralizes the command injection"
  lang python
  reject VYQL-INJ-002
  code
  ```
  def safe():
      x = request.args['q']
      os.system("ping " + shlex.quote(x))
  ```

test "python: shell quote inside generator join neutralizes command injection"
  lang python
  reject VYQL-INJ-002
  code
  ```
  from pipes import quote

  def safe():
      args = [request.args['tool'], request.args['input'], "-d", "/tmp/out"]
      command = " ".join(quote(arg) for arg in args)
      os.system(command)
  ```

test "python: SQLAlchemy stored value reaches command execution"
  lang python
  expect VYQL-INJ-032
  code
  ```
  import os
  import sqlalchemy

  def run_submission(submission_hash):
      submission = Submission.query.get(submission_hash)
      os.system("jpseek " + submission.password)
  ```

test "python: SQLAlchemy stored value reaches asyncio exec splat"
  lang python
  expect VYQL-INJ-032
  code
  ```
  import asyncio
  import sqlalchemy

  async def run_submission(submission_hash):
      submission = Submission.query.get(submission_hash)
      cmd = ["bash", "-c", "jpseek " + submission.password]
      await asyncio.create_subprocess_exec(*cmd)
  ```
