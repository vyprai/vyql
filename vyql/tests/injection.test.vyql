test "python: f-string field validation misses nested field syntax"
  lang python
  expect VYQL-INJ-024
  code
  ```
  from string import Formatter

  def validate(template):
      for literal, field, format_spec, conv in Formatter().parse(template):
          if field and "." in field:
              raise ValueError("bad field")
      return template
  ```

test "python: f-string field validation covers nested format specs"
  lang python
  reject VYQL-INJ-024
  code
  ```
  from string import Formatter

  def validate(template):
      for literal, field, format_spec, conv in Formatter().parse(template):
          if field and "." in field:
              raise ValueError("bad field")
          if format_spec and ("{" in format_spec or "}" in format_spec):
              raise ValueError("bad format")
      return template
  ```

