# Taint-driven injection rules across languages:
#   INJ-005 LDAP (90), INJ-006 XPath (643), INJ-008 SSTI (1336),
#   INJ-016 expression-language (917), INJ-017 email-header (93).
# Tainted source -> sink fires; a constant argument stays clean.

# --- XPath injection (VYQL-INJ-006) ---
test "php: tainted SimpleXML xpath is injection"
  lang php
  expect VYQL-INJ-006
  code
  ```
  <?php $q = $_GET['q']; $xml->xpath("//user[@name='" . $q . "']");
  ```

test "php: a constant XPath is clean"
  lang php
  reject VYQL-INJ-006
  code
  ```
  <?php $xml->xpath("//user[@name='admin']");
  ```

test "ruby: tainted Nokogiri xpath is injection"
  lang ruby
  expect VYQL-INJ-006
  code
  ```
  def f(doc); q = params[:q]; doc.xpath("//user[@name='#{q}']"); end
  ```

test "python: tainted lxml xpath is injection"
  lang python
  expect VYQL-INJ-006
  code
  ```
  from flask import request
  def f(tree):
      uid = request.args.get("uid")
      return tree.xpath("//user[@id='" + uid + "']")
  ```

test "csharp: tainted SelectNodes is XPath injection"
  lang csharp
  expect VYQL-INJ-006
  code
  ```
  class C { void F() { var q = Request.QueryString["q"]; doc.SelectNodes("//user[@name='" + q + "']"); } }
  ```

test "csharp: a constant XPath is clean"
  lang csharp
  reject VYQL-INJ-006
  code
  ```
  class C { void F() { doc.SelectNodes("//user"); } }
  ```

# --- LDAP injection (VYQL-INJ-005) ---
test "php: tainted ldap_search filter is injection"
  lang php
  expect VYQL-INJ-005
  code
  ```
  <?php $u = $_GET['u']; ldap_search($conn, "dc=x", "(uid=" . $u . ")");
  ```

test "php: a constant LDAP filter is clean"
  lang php
  reject VYQL-INJ-005
  code
  ```
  <?php ldap_search($conn, "dc=x", "(uid=admin)");
  ```

test "csharp: tainted DirectorySearcher is LDAP injection"
  lang csharp
  expect VYQL-INJ-005
  code
  ```
  class C { void F() { var u = Request.QueryString["u"]; new DirectorySearcher("(uid=" + u + ")"); } }
  ```

test "java: tainted DirContext.search filter is LDAP injection"
  lang java
  expect VYQL-INJ-005
  code
  ```
  class L {
    void run(HttpServletRequest request, DirContext ctx) throws Exception {
      String user = request.getParameter("user");
      ctx.search("ou=people", "(uid=" + user + ")", new SearchControls());
    }
  }
  ```

test "java: a constant DirContext filter is clean"
  lang java
  reject VYQL-INJ-005
  code
  ```
  class L {
    void run(DirContext ctx) throws Exception {
      ctx.search("ou=people", "(uid=admin)", new SearchControls());
    }
  }
  ```

# --- Server-side template injection (VYQL-INJ-008) ---
test "php: tainted Twig createTemplate is SSTI"
  lang php
  expect VYQL-INJ-008
  code
  ```
  <?php $t = $_GET['t']; $twig->createTemplate($t);
  ```

test "php: a constant Twig template is clean"
  lang php
  reject VYQL-INJ-008
  code
  ```
  <?php $twig->createTemplate("<h1>hello</h1>");
  ```

test "java: tainted Velocity.evaluate template is SSTI"
  lang java
  expect VYQL-INJ-008
  code
  ```
  class H {
    void run(HttpServletRequest request) {
      String tpl = request.getParameter("tpl");
      Velocity.evaluate(ctx, writer, "log", tpl);
    }
  }
  ```

test "java: a constant Velocity template is clean"
  lang java
  reject VYQL-INJ-008
  code
  ```
  class H {
    void run() {
      Velocity.evaluate(ctx, writer, "log", "static template");
    }
  }
  ```

test "js: tainted nunjucks.compile is SSTI"
  lang javascript
  expect VYQL-INJ-008
  code
  ```
  app.get('/', function(req, res){ var t = req.query.tpl; nunjucks.compile(t); });
  ```

test "js: a constant nunjucks template is clean"
  lang javascript
  reject VYQL-INJ-008
  code
  ```
  nunjucks.compile('<h1>hello</h1>');
  ```

# --- Expression-language injection (VYQL-INJ-016) ---
test "java: tainted SpEL parseExpression is EL injection"
  lang java
  expect VYQL-INJ-016
  code
  ```
  class H {
    void run(HttpServletRequest request, ExpressionParser parser) {
      String q = request.getParameter("q");
      parser.parseExpression(q).getValue();
    }
  }
  ```

test "java: a constant expression is clean"
  lang java
  reject VYQL-INJ-016
  code
  ```
  class H {
    void run(ExpressionParser parser) {
      parser.parseExpression("1 + 1").getValue();
    }
  }
  ```

# --- Email-header injection (VYQL-INJ-017) ---
test "php: tainted mail() headers arg is email-header injection"
  lang php
  expect VYQL-INJ-017
  code
  ```
  <?php $from = $_GET['from']; mail("to@x.com", "subj", "body", "From: " . $from);
  ```

test "php: a constant headers string is clean"
  lang php
  reject VYQL-INJ-017
  code
  ```
  <?php mail("to@x.com", "subj", "body", "From: noreply@x.com");
  ```

# --- CSV/formula injection (VYQL-INJ-014) ---
test "python: tainted writerow is CSV injection"
  lang python
  expect VYQL-INJ-014
  code
  ```
  def export(writer):
      row = request.args['row']
      writer.writerow(row)
  ```

test "python: a constant CSV row is clean"
  lang python
  reject VYQL-INJ-014
  code
  ```
  def export(writer):
      writer.writerow("static,header")
  ```

# --- Mass assignment (VYQL-INJ-012) ---
test "ruby: update_attributes(params) is mass assignment"
  lang ruby
  expect VYQL-INJ-012
  code
  ```
  def update
    user = User.new
    user.update_attributes(params[:user])
  end
  ```

test "ruby: update_attributes with a static hash is clean"
  lang ruby
  reject VYQL-INJ-012
  code
  ```
  def update
    user = User.new
    user.update_attributes(name: "static")
  end
  ```

# --- Prototype pollution (VYQL-INJ-013) ---
test "js: _.merge(config, req.body) is prototype pollution"
  lang javascript
  expect VYQL-INJ-013
  code
  ```
  function h(req) {
    _.merge(config, req.body);
  }
  ```

test "js: _.merge with a constant source is clean"
  lang javascript
  reject VYQL-INJ-013
  code
  ```
  function h(req) {
    _.merge(config, defaults);
  }
  ```

test "js: tainted dynamic object key is prototype pollution"
  lang javascript
  expect VYQL-INJ-013
  code
  ```
  exports.parse = function parse(key, value) {
    const obj = {};
    obj[key] = value;
    return obj;
  }
  ```

test "js: taint enters function-expression assigned to a variable"
  lang javascript
  expect VYQL-INJ-013
  code
  ```
  var build = function build(key, value) {
    const obj = {};
    obj[key] = value;
    return obj;
  };
  exports.parse = function parse(input) {
    return build(input, 'x');
  }
  ```

# --- Stored XSS writes (VYQL-INJ-004) ---
test "js: tainted Mongo hypertext update is stored XSS"
  lang javascript
  expect VYQL-INJ-004
  code
  ```
  async function updateComment(req, Document) {
    const text = req.body.text;
    return Document.findOneAndUpdate({ _id: req.body.id }, {
      $set: {
        "comments.$.hypertext": text
      }
    });
  }
  ```

test "js: sanitize-html neutralizes stored XSS update"
  lang javascript
  reject VYQL-INJ-004
  code
  ```
  const sanitizeHtml = require('sanitize-html');
  async function updateComment(req, Document) {
    const text = sanitizeHtml(req.body.text);
    return Document.findOneAndUpdate({ _id: req.body.id }, {
      $set: {
        "comments.$.hypertext": text
      }
    });
  }
  ```

test "js: nested async Mongo helper preserves stored XSS taint"
  lang javascript
  expect VYQL-INJ-004
  code
  ```
  module.exports = function buildRouter(Document) {
    var updateComment = async function (doc_id, text) {
      return Document.findOneAndUpdate({ _id: doc_id }, {
        $set: {
          "comments.$.hypertext": text
        }
      });
    };
    router.post('/comment', async function (req, res) {
      await updateComment(req.body.id, req.body.text);
    });
  };
  ```

test "js: SimpleModal title option is browser XSS"
  lang javascript
  expect VYQL-INJ-004
  code
  ```
  function openModalImage(options) {
    var opt = options || {};
    var M = new SimpleModal({});
    M.show({
      'title': opt.title,
      'contents': '<img src="' + opt.url + '" alt="">'
    });
  }
  ```

test "js: SimpleModal constant title is clean"
  lang javascript
  reject VYQL-INJ-004
  code
  ```
  function openModalImage() {
    var M = new SimpleModal({});
    M.show({
      'title': 'Preview',
      'contents': '<img src="/safe.png" alt="">'
    });
  }
  ```

# --- ReDoS (VYQL-DOS-001) ---
test "python: re.compile of a tainted pattern is ReDoS"
  lang python
  expect VYQL-DOS-001
  code
  ```
  def h():
      pat = request.args['p']
      re.compile(pat)
  ```

test "python: re.compile of a constant pattern is clean"
  lang python
  reject VYQL-DOS-001
  code
  ```
  def h():
      re.compile("[a-z]+")
  ```

# --- Unrestricted upload (VYQL-INJ-015) ---
test "php: tainted move_uploaded_file destination is unrestricted upload"
  lang php
  expect VYQL-INJ-015
  code
  ```
  <?php
  function upload() {
    $dest = "uploads/" . $_FILES['f']['name'];
    move_uploaded_file($_FILES['f']['tmp_name'], $dest);
  }
  ```

test "php: a fixed upload destination is clean"
  lang php
  reject VYQL-INJ-015
  code
  ```
  <?php
  function upload() {
    move_uploaded_file($_FILES['f']['tmp_name'], "uploads/fixed.dat");
  }
  ```

test "javascript: uploaded filename written with createWriteStream is unrestricted upload"
  lang javascript
  expect VYQL-INJ-015
  code
  ```
  const fs = require('fs');
  const path = require('path');
  function upload(req) {
    const file = req.file;
    const dest = fs.createWriteStream(path.join('public/uploads', file.originalname));
    fs.createReadStream(file.path).pipe(dest);
  }
  ```

test "javascript: fixed write stream destination is clean for unrestricted upload"
  lang javascript
  reject VYQL-INJ-015
  code
  ```
  const fs = require('fs');
  function upload(req) {
    const dest = fs.createWriteStream('public/uploads/fixed.dat');
    fs.createReadStream(req.file.path).pipe(dest);
  }
  ```

test "javascript: parsed XML key written to hidden file input is path traversal handoff"
  lang javascript
  expect VYQL-PATH-001
  code
  ```
  function parseURL(text) {
    var xml = new window.DOMParser().parseFromString(text, 'text/xml');
    var tag = xml.getElementsByTagName('Key')[0];
    return decodeURI(tag.childNodes[0].nodeValue);
  }
  function store(result, form) {
    var hiddenFileInput = document.createElement('input');
    hiddenFileInput.type = 'hidden';
    hiddenFileInput.value = parseURL(result);
    form.appendChild(hiddenFileInput);
  }
  ```

test "javascript: constant hidden file input value is clean for path traversal"
  lang javascript
  reject VYQL-PATH-001
  code
  ```
  function store(form) {
    var hiddenFileInput = document.createElement('input');
    hiddenFileInput.type = 'hidden';
    hiddenFileInput.value = 'tmp/s3file/fixed.txt';
    form.appendChild(hiddenFileInput);
  }
  ```

test "javascript: destructured readdirSync with request param path is traversal"
  lang javascript
  expect VYQL-PATH-001
  code
  ```
  const { join } = require('path');
  const { readdirSync } = require('fs');
  module.exports = (request, response) => {
    const path = request.params[0] || '';
    return readdirSync(join('/var/media', path));
  };
  ```

test "javascript: destructured mkdirSync with request body path is traversal"
  lang javascript
  expect VYQL-PATH-001
  code
  ```
  const { join } = require('path');
  const { mkdirSync } = require('fs');
  module.exports = (request, response) => {
    const { path } = request.body;
    mkdirSync(join('/var/media', path), { recursive: true });
  };
  ```

test "javascript: error message sent as HTML is XSS"
  lang javascript
  expect VYQL-INJ-004
  code
  ```
  module.exports = (err, request, response) => {
    response.status(500).send(err.message);
  };
  ```

test "javascript: encoded error message sent as HTML is clean"
  lang javascript
  reject VYQL-INJ-004
  code
  ```
  const { encode } = require('html-entities');
  module.exports = (err, request, response) => {
    response.status(500).send(encode(err.message));
  };
  ```

test "javascript: generate-function builder receives tainted source"
  lang javascript
  expect VYQL-INJ-003
  code
  ```
  const genFunc = require('generate-function');
  exports.compile = function compile(timezone) {
    const parserFn = genFunc();
    parserFn(`return packet.parseDate('${timezone}')`);
    return parserFn.toFunction();
  }
  ```

test "javascript: caller-controlled timezone option reaches generated parser source"
  lang javascript
  expect VYQL-INJ-003
  code
  ```
  const genFunc = require('generate-function');
  function readCodeFor(options, config) {
    const timezone = options.timezone || config.timezone;
    return `packet.parseDate('${timezone}')`;
  }
  function compile(fields, options, config) {
    const parserFn = genFunc();
    const readCode = readCodeFor(options, config);
    parserFn(`${fields[0].name} = ${readCode};`);
    return parserFn.toFunction();
  }
  ```

test "javascript: sandbox bridge args applied to host function are code execution"
  lang javascript
  expect VYQL-INJ-003
  code
  ```
  function apply(target, context, args) {
    args = otherFromThisArguments(args);
    return otherReflectApply(target, context, args);
  }
  ```

test "javascript: fixed host apply with constant args is clean for code execution"
  lang javascript
  reject VYQL-INJ-003
  code
  ```
  function apply(target, context) {
    return otherReflectApply(target, context, []);
  }
  ```

test "javascript: package manager install execution is code execution"
  lang javascript
  expect VYQL-INJ-019
  code
  ```
  const { spawnSync } = require('node:child_process');
  function install(path) {
    return spawnSync('rush', ['install', '--no-link'], { cwd: path });
  }
  ```

test "javascript: package manager version probe is not code execution"
  lang javascript
  reject VYQL-INJ-019
  code
  ```
  const { spawnSync } = require('node:child_process');
  function version(path) {
    return spawnSync('rush', ['--version'], { cwd: path });
  }
  ```

test "javascript: return_url query assigned to location href is DOM XSS"
  lang javascript
  expect VYQL-INJ-004
  code
  ```
  function Karma(location) {
    var queryParams = util.parseQueryParams(location.search);
    var returnUrl = queryParams['return_url' + ''] || null;
    if (returnUrl) {
      location.href = returnUrl;
    }
  }
  ```

test "javascript: constant location href navigation is clean for DOM XSS"
  lang javascript
  reject VYQL-INJ-004
  code
  ```
  function done(location) {
    location.href = '/dashboard';
  }
  ```

test "javascript: environment value in webpack shell plugin script is command injection"
  lang javascript
  expect VYQL-INJ-002
  code
  ```
  const WebpackShellPlugin = require('webpack-shell-plugin-next');
  const shellPluginConfig = {
    onBuildStart: {
      scripts: [
        'set NODE_ENV=' + process.env.NODE_ENV,
        'webpack --config webpack-main.config.js'
      ]
    }
  };
  new WebpackShellPlugin(shellPluginConfig);
  ```

test "javascript: constant webpack shell plugin scripts are clean"
  lang javascript
  reject VYQL-INJ-002
  code
  ```
  const WebpackShellPlugin = require('webpack-shell-plugin-next');
  const shellPluginConfig = {
    onBuildStart: {
      scripts: [
        'set NODE_ENV=production',
        'webpack --config webpack-main.config.js'
      ]
    }
  };
  new WebpackShellPlugin(shellPluginConfig);
  ```

# --- Format string (VYQL-INJ-011) ---
test "c: printf with a tainted format argument is a format-string bug"
  lang c
  expect VYQL-INJ-011
  code
  ```
  void h() {
    char *name = getenv("NAME");
    printf(name);
  }
  ```

test "c: printf with a constant format and %s is clean"
  lang c
  reject VYQL-INJ-011
  code
  ```
  void h() {
    char *name = getenv("NAME");
    printf("%s", name);
  }
  ```

# --- Sanitizer recognition (VYQL-INJ-002 command injection) ---
test "python: os.system of raw request input is command injection"
  lang python
  expect VYQL-INJ-002
  code
  ```
  def unsafe():
      y = request.args['q']
      os.system("ping " + y)
  ```

test "python: shlex.quote neutralizes the command injection"
  lang python
  reject VYQL-INJ-002
  code
  ```
  def safe():
      x = request.args['q']
      os.system("ping " + shlex.quote(x))
  ```
