# Rank 974 / CVE-2019-10371: GitLab OAuth login set the Jenkins
# authentication context without rotating the pre-login HTTP session.

test "rank974: OAuth finish login sets authentication without rotating session"
  lang java
  file src/main/java/org/jenkinsci/plugins/GitLabSecurityRealm.java
  expect VYQL-AUTH-074
  expect_review code.MissingSessionRotationAfterAuthentication
  code
  ```
  import org.acegisecurity.context.SecurityContextHolder;
  import org.kohsuke.stapler.StaplerRequest;

  public class GitLabSecurityRealm {
      public Object doFinishLogin(StaplerRequest request) throws Exception {
          String code = request.getParameter("code");
          GitLabAuthenticationToken auth = new GitLabAuthenticationToken(code);
          SecurityContextHolder.getContext().setAuthentication(auth);
          return null;
      }
  }
  class GitLabAuthenticationToken {
      GitLabAuthenticationToken(String code) {}
  }
  ```

test "rank974: OAuth finish login invalidates session before authentication"
  lang java
  file src/main/java/org/jenkinsci/plugins/GitLabSecurityRealm.java
  reject VYQL-AUTH-074
  reject_review code.MissingSessionRotationAfterAuthentication
  code
  ```
  import javax.servlet.http.HttpSession;
  import org.acegisecurity.context.SecurityContextHolder;
  import org.kohsuke.stapler.StaplerRequest;

  public class GitLabSecurityRealm {
      public Object doFinishLogin(StaplerRequest request) throws Exception {
          String code = request.getParameter("code");
          GitLabAuthenticationToken auth = new GitLabAuthenticationToken(code);
          HttpSession session = request.getSession(false);
          if (session != null) {
              session.invalidate();
          }
          request.getSession(true);
          SecurityContextHolder.getContext().setAuthentication(auth);
          return null;
      }
  }
  class GitLabAuthenticationToken {
      GitLabAuthenticationToken(String code) {}
  }
  ```
