# Elixir (Phoenix/Ecto) coverage: command injection, SQLi, code eval, path.

test "elixir: Phoenix params -> System.shell is command injection"
  lang elixir
  expect VYQL-INJ-002
  code
  ```
  defmodule MyController do
    def index(conn, params) do
      name = params["host"]
      System.shell("ping " <> name)
    end
  end
  ```

test "elixir: a constant command is clean"
  lang elixir
  reject VYQL-INJ-002
  code
  ```
  defmodule MyController do
    def index(conn, params) do
      System.shell("ls -la")
    end
  end
  ```

test "elixir: Phoenix params -> Ecto SQL.query is injection"
  lang elixir
  expect VYQL-INJ-001
  code
  ```
  defmodule MyController do
    def index(conn, params) do
      name = params["name"]
      Ecto.Adapters.SQL.query(Repo, "SELECT * FROM users WHERE name = '" <> name <> "'")
    end
  end
  ```

test "elixir: Phoenix params -> Code.eval_string is code injection"
  lang elixir
  expect VYQL-INJ-003
  code
  ```
  defmodule MyController do
    def run(conn, params) do
      Code.eval_string(params["expr"])
    end
  end
  ```

test "elixir: conn.params via pipe -> File.read is path traversal"
  lang elixir
  expect VYQL-PATH-001
  code
  ```
  defmodule MyController do
    def show(conn, params) do
      params["path"] |> File.read()
    end
  end
  ```
