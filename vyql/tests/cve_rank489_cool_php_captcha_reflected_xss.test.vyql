# Rank 489 / CVE-2009-10001: cool-php-captcha reflected the submitted
# captcha value in a response table without HTML escaping.

test "rank489: cool-php-captcha reflects request captcha in heredoc"
  lang php
  profile web
  file example-form.php
  expect VYQL-INJ-004
  code
  ```
  <?php
  session_start();

  if (!empty($_REQUEST['captcha'])) {
      if (empty($_SESSION['captcha']) || trim(strtolower($_REQUEST['captcha'])) != $_SESSION['captcha']) {
          $captcha_message = "Invalid captcha";
          $style = "background-color: #FF606C";
      } else {
          $captcha_message = "Valid captcha";
          $style = "background-color: #CCFF99";
      }

      echo <<<HTML
          <div id="result" style="$style">
          <h2>$captcha_message</h2>
          <table>
          <tr>
              <td>Form CAPTCHA:</td>
              <td>{$_REQUEST['captcha']}</td>
          </tr>
          </table>
          </div>
  HTML;
  }
  ```

test "rank489: cool-php-captcha escapes reflected captcha value"
  lang php
  profile web
  file example-form.php
  reject VYQL-INJ-004
  code
  ```
  <?php
  session_start();

  if (!empty($_REQUEST['captcha'])) {
      $submitted = htmlspecialchars($_REQUEST['captcha'], ENT_QUOTES, 'UTF-8');
      echo <<<HTML
          <div id="result">
          <table>
          <tr>
              <td>Form CAPTCHA:</td>
              <td>{$submitted}</td>
          </tr>
          </table>
          </div>
  HTML;
  }
  ```

