# Rank 152 / CVE-2021-32637: Authelia's /api/verify endpoint returned the
# generic error response when malformed forwarded/original URL parsing failed,
# allowing nginx auth_request deployments to treat the request as authenticated.

test "rank152: go authelia verify parse failure using generic error requires auth review"
  lang go
  expect_review code.AuthFailureResponseReview
  code
  ```
  package handlers

  import (
    "fmt"

    "github.com/authelia/authelia/internal/middlewares"
  )

  const operationFailedMessage = "Operation failed."

  func VerifyGet() middlewares.RequestHandler {
    return func(ctx *middlewares.AutheliaCtx) {
      targetURL, err := ctx.GetOriginalURL()
      if err != nil {
        ctx.Error(fmt.Errorf("Unable to parse target URL: %s", err), operationFailedMessage)
        return
      }

      _ = targetURL
    }
  }
  ```

test "rank152: go authelia verify parse failure replying unauthorized is clean"
  lang go
  reject_review code.AuthFailureResponseReview
  code
  ```
  package handlers

  import (
    "fmt"

    "github.com/authelia/authelia/internal/middlewares"
  )

  func VerifyGet() middlewares.RequestHandler {
    return func(ctx *middlewares.AutheliaCtx) {
      targetURL, err := ctx.GetOriginalURL()
      if err != nil {
        ctx.Logger.Error(fmt.Errorf("Unable to parse target URL: %s", err))
        ctx.ReplyUnauthorized()
        return
      }

      _ = targetURL
    }
  }
  ```
