# OWASP-replica coverage for PHP — true positives plus precision patterns
# (opaque-predicate pruning, container element-sensitivity) unlocked by the parity port.

# --- SQL injection (INJ-001) ---
test "php: $_GET -> mysqli_query is SQLi"
  lang php
  expect VYQL-INJ-001
  code
  ```
  <?php
  function h($conn){ $p = $_GET['id']; mysqli_query($conn, "SELECT * FROM u WHERE id=" . $p); }
  ```

test "php: opaque if/else assigns a constant on the live branch — clean SQLi"
  lang php
  reject VYQL-INJ-001
  code
  ```
  <?php
  function h($conn){
    $p = $_GET['id']; $num = 88;
    if ((7*42)-$num > 200) { $bar = "safe"; } else { $bar = "alsosafe"; }
    mysqli_query($conn, "SELECT * FROM u WHERE id=" . $bar);
  }
  ```

test "php: ternary routes to a constant — clean SQLi"
  lang php
  reject VYQL-INJ-001
  code
  ```
  <?php
  function h($conn){
    $p = $_GET['id']; $num = 106;
    $bar = ((7*18)+$num > 200) ? "safe" : $p;
    mysqli_query($conn, "SELECT * FROM u WHERE id=" . $bar);
  }
  ```

# --- command injection (INJ-002) ---
test "php: $_GET -> system is command injection"
  lang php
  expect VYQL-INJ-002
  code
  ```
  <?php
  function h(){ $p = $_GET['cmd']; system("ls " . $p); }
  ```

# --- path traversal (PATH-001) ---
test "php: $_GET -> fopen is path traversal"
  lang php
  expect VYQL-PATH-001
  code
  ```
  <?php
  function h(){ $p = $_GET['f']; $fh = fopen("/tmp/" . $p, "r"); }
  ```

# --- code injection (INJ-003) ---
test "php: $_GET -> eval is code injection"
  lang php
  expect VYQL-INJ-003
  code
  ```
  <?php
  function h(){ $p = $_GET['x']; eval($p); }
  ```

# --- weak hash (CRY-001) — explicit hash('md5', …); bare md5() is intentionally not flagged ---
test "php: hash('md5', …) is weak hash"
  lang php
  expect VYQL-CRY-001
  code
  ```
  <?php
  function h(){ $p = $_GET['x']; return hash('md5', $p); }
  ```
