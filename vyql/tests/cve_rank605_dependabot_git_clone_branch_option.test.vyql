# Rank 605 / CVE-2020-26222: Dependabot interpolated source.branch into
# `git clone --branch` inside a shell command string.
test "rank605: git clone branch option interpolated into shell command"
  lang ruby
  file base.rb
  expect VYQL-INJ-201
  code
  ```
  class Base
    def _clone_repo_contents(target_directory:)
      SharedHelpers.with_git_configured(credentials: credentials) do
        path = target_directory || File.join("tmp", source.repo)
        return path if Dir.exist?(File.join(path, ".git"))

        FileUtils.mkdir_p(path)
        br_opt = " --branch #{source.branch} --single-branch" if source.branch
        SharedHelpers.run_shell_command(
          <<~CMD
            git clone --no-tags --no-recurse-submodules --depth 1#{br_opt} #{source.url} #{path}
          CMD
        )
        path
      end
    end
  end
  ```

test "rank605: git clone branch option shell escaped"
  lang ruby
  file base.rb
  reject VYQL-INJ-201
  code
  ```
  class Base
    def _clone_repo_contents(target_directory:)
      SharedHelpers.with_git_configured(credentials: credentials) do
        path = target_directory || File.join("tmp", source.repo)
        return path if Dir.exist?(File.join(path, ".git"))

        FileUtils.mkdir_p(path)
        br_opt = " --branch #{Shellwords.escape(source.branch)} --single-branch" if source.branch
        SharedHelpers.run_shell_command(
          <<~CMD
            git clone --no-tags --no-recurse-submodules --depth 1#{br_opt} #{source.url} #{path}
          CMD
        )
        path
      end
    end
  end
  ```
