# Rank 646 / CVE-2022-4526: django-photologue rendered Photo.caption through
# Django's `safe` filter in the default detail template.
test "rank646: Django template safe filter renders stored caption HTML"
  lang config
  file photo_detail.html
  expect VYQL-INJ-028
  code
  ```
  {% extends "photologue/root.html" %}
  {% block content %}
  <div>
    {% if object.caption %}<p>{{ object.caption|safe }}</p>{% endif %}
  </div>
  {% endblock %}
  ```

test "rank646: Django template default escaping keeps caption text safe"
  lang config
  file photo_detail.html
  reject VYQL-INJ-028
  code
  ```
  {% extends "photologue/root.html" %}
  {% block content %}
  <div>
    {% if object.caption %}<p>{{ object.caption }}</p>{% endif %}
  </div>
  {% endblock %}
  ```
