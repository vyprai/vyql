# Rank 392 / CVE-2025-58064: CKEditor 5 clipboard plain-text conversion
# rendered view RawElement content into the live document, so active markup
# could execute while extracting text.

test "rank392: CKEditor5 RawElement plain-text conversion renders into live document"
  lang javascript
  file viewtoplaintext.ts
  expect VYQL-INJ-067
  expect_review code.CkeditorRawElementLiveDocumentRenderXss
  code
  ```
  export function viewToPlainText( converter: ViewDomConverter, viewItem: ViewItem ): string {
    let text = '';

    if ( viewItem.is( 'rawElement' ) ) {
      const tempElement = document.createElement( 'div' );

      viewItem.render( tempElement, converter );

      text += domElementToPlainText( tempElement );
    }

    return text;
  }

  function domElementToPlainText( element: HTMLElement ): string {
    return element.textContent!;
  }
  ```

test "rank392: CKEditor5 RawElement plain-text conversion renders into detached document"
  lang javascript
  file viewtoplaintext.ts
  reject VYQL-INJ-067
  reject_review code.CkeditorRawElementLiveDocumentRenderXss
  code
  ```
  export function viewToPlainText( converter: ViewDomConverter, viewItem: ViewItem ): string {
    let text = '';

    if ( viewItem.is( 'rawElement' ) ) {
      const doc = document.implementation.createHTMLDocument( '' );
      const tempElement = doc.createElement( 'div' );

      viewItem.render( tempElement, converter );

      text += domElementToPlainText( tempElement );
    }

    return text;
  }

  function domElementToPlainText( element: HTMLElement ): string {
    return element.textContent!;
  }
  ```
