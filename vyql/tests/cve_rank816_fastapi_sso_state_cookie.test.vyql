# Rank 816 / CVE-2025-14546: fastapi-sso generated OAuth state but did not
# bind callback state to a stored cookie/session value.

test "rank816: OAuth state is not stored or compared on callback"
  lang python
  file base.py
  expect VYQL-RF-032
  expect_review code.OAuthStateCookieValidationMissing
  code
  ```
  from starlette.requests import Request
  from starlette.responses import RedirectResponse

  class SSOBase:
      requires_state = True

      async def get_login_url(self, *, state=None):
          request_uri = self.oauth_client.prepare_request_uri(
              await self.authorization_endpoint,
              redirect_uri=self.redirect_uri,
              state=state,
              scope=self._scope,
          )
          return request_uri

      async def get_login_redirect(self, *, state=None):
          if self.requires_state and not state:
              state = self._generated_state
          login_uri = await self.get_login_url(state=state)
          response = RedirectResponse(login_uri, 303)
          return response

      async def verify_and_process(self, request: Request):
          code = request.query_params.get("code")
          self._state = request.query_params.get("state")
          return await self.process_login(code, request)
  ```

test "rank816: OAuth state is stored in cookie and compared on callback"
  lang python
  file base.py
  reject VYQL-RF-032
  reject_review code.OAuthStateCookieValidationMissing
  code
  ```
  from starlette.requests import Request
  from starlette.responses import RedirectResponse

  class SSOBase:
      requires_state = True

      async def get_login_url(self, *, state=None):
          request_uri = self.oauth_client.prepare_request_uri(
              await self.authorization_endpoint,
              redirect_uri=self.redirect_uri,
              state=state,
              scope=self._scope,
          )
          return request_uri

      async def get_login_redirect(self, *, state=None):
          if self.requires_state and not state:
              state = self._generated_state
          login_uri = await self.get_login_url(state=state)
          response = RedirectResponse(login_uri, 303)
          if state is not None:
              response.set_cookie("sso_state", state)
          return response

      async def verify_and_process(self, request: Request):
          code = request.query_params.get("code")
          self._state = request.query_params.get("state")
          if self._state is not None:
              sso_state = request.cookies.get("sso_state")
              if sso_state is not None and sso_state != self._state:
                  raise Exception("Invalid state")
          return await self.process_login(code, request)
  ```
