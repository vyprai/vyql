test "rank892: foreman-kubevirt verify_ssl depends on CA cert presence"
  lang ruby
  expect VYQL-CFG-004
  expect_review code.CertValidationDisabled
  code
  ```
  module ForemanKubevirt
    class Kubevirt
      def client
        Fog::Kubevirt::Compute.new(
          :kubevirt_uri => url,
          :kubevirt_token => token,
          :kubevirt_ca_cert => ca_cert,
          :kubevirt_verify_ssl => ca_cert.present?,
        )
      end
    end
  end
  ```

test "rank892: foreman-kubevirt verify_ssl defaults to true"
  lang ruby
  reject VYQL-CFG-004
  reject_review code.CertValidationDisabled
  code
  ```
  module ForemanKubevirt
    class Kubevirt
      def client
        Fog::Kubevirt::Compute.new(
          :kubevirt_uri => url,
          :kubevirt_token => token,
          :kubevirt_ca_cert => ca_cert,
          :kubevirt_verify_ssl => true,
        )
      end
    end
  end
  ```
