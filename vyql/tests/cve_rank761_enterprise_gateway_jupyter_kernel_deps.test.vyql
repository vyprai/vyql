# Rank 761 / CVE-2026-44180: remote kernel images installed uncapped
# ipykernel, allowing incompatible ipykernel 7.x behavior to break gateway
# message handling.

test "rank761: Dockerfile bare ipykernel upgrade in kernel image is flagged"
  lang config
  file Dockerfile
  expect VYQL-SCA-007
  expect_review code.UnboundedJupyterKernelDependency
  code
  ```
  FROM jupyter/scipy-notebook:2023-03-13
  RUN pip install --upgrade ipykernel
  ```

test "rank761: Dockerfile mixed package upgrade with bare ipykernel is flagged"
  lang config
  file Dockerfile
  expect VYQL-SCA-007
  expect_review code.UnboundedJupyterKernelDependency
  code
  ```
  FROM tensorflow/tensorflow:2.9.1-gpu
  RUN apt-get update && apt-get install -yq python3-dev && \
      pip install --upgrade future pycryptodomex ipykernel
  ```

test "rank761: Dockerfile capped ipykernel upgrade is clean"
  lang config
  file Dockerfile
  reject VYQL-SCA-007
  code
  ```
  FROM jupyter/scipy-notebook:2023-03-13
  RUN pip install --upgrade \
      "ipykernel<7" \
      "jupyter_client<9" \
      "jupyter_server<3" \
      "pyzmq<28"
  ```

test "rank761: requirements YAML bare ipykernel dependency is flagged"
  lang config
  file requirements.yml
  expect VYQL-SCA-007
  expect_review code.UnboundedJupyterKernelDependency
  code
  ```
  dependencies:
    - jupyter_client>=6.1,<7
    - ipykernel
  ```

test "rank761: requirements YAML capped ipykernel dependency is clean"
  lang config
  file requirements.yml
  reject VYQL-SCA-007
  code
  ```
  dependencies:
    - jupyter_client>=6.1,<7
    - ipykernel>=6.29,<7
  ```
