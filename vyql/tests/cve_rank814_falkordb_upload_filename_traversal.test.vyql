# Rank 814 / CVE-2026-6057: FalkorDB Browser's Next.js upload route wrote
# browser File.name values under public/assets without basename canonicalization.

test "rank814: Next upload route writes raw File.name into assets path"
  lang javascript
  file route.ts
  expect VYQL-PATH-001
  code
  ```
  import { NextRequest, NextResponse } from "next/server";
  import path from "path";
  import fs from "fs";

  export async function POST(request: NextRequest) {
    const formData = await request.formData();
    const file = formData.get("file") as File;
    if (!file) {
      return NextResponse.json({ error: "No files received." }, { status: 400 });
    }

    const filename = file.name.replaceAll(" ", "_");
    const filePath = path.join(process.cwd(), `public/assets/${filename}`);
    fs.createWriteStream(filePath);
    return NextResponse.json({ path: filePath, status: 200 });
  }
  ```

test "rank814: Next upload route canonicalizes File.name before writing"
  lang javascript
  file route.ts
  reject VYQL-PATH-001
  code
  ```
  import { NextRequest, NextResponse } from "next/server";
  import path from "path";
  import fs from "fs";

  export async function POST(request: NextRequest) {
    const formData = await request.formData();
    const file = formData.get("file") as File;
    if (!file) {
      return NextResponse.json({ error: "No files received." }, { status: 400 });
    }

    const filename = path.basename(file.name).replaceAll(" ", "_");
    const assetsDir = path.join(process.cwd(), "public", "assets");
    const filePath = path.join(assetsDir, filename);
    if (!filePath.startsWith(assetsDir)) {
      return NextResponse.json({ error: "Invalid file name." }, { status: 400 });
    }

    fs.createWriteStream(filePath);
    return NextResponse.json({ path: filePath, status: 200 });
  }
  ```
