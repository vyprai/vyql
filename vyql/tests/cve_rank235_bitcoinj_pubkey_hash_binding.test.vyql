test "rank235: Java signature verification must bind supplied pubkey to committed hash"
  lang java
  expect_review code.PublicKeyHashBindingReview
  code
  ```
  import java.util.Set;

  class ScriptExecution {
    static void correctlySpends(Script script, Transaction tx, int index, Witness witness, Coin value,
                                Script scriptPubKey, Set<VerifyFlag> flags) {
      if (ScriptPattern.isP2WPKH(scriptPubKey)) {
        TransactionSignature signature = TransactionSignature.decodeFromBitcoin(witness.getPush(0), true, true);
        ECKey pubkey = ECKey.fromPublicOnly(witness.getPush(1));
        Script scriptCode = ScriptBuilder.createP2PKHOutputScript(pubkey);
        Hash sigHash = tx.hashForWitnessSignature(index, scriptCode, value, signature.sigHashMode(), false);
        boolean validSig = pubkey.verify(sigHash, signature);
        if (!validSig) throw new RuntimeException("bad sig");
      }
    }
  }
  ```

test "rank235: Java signature verification checks supplied pubkey hash first"
  lang java
  reject_review code.PublicKeyHashBindingReview
  code
  ```
  import java.util.Arrays;
  import java.util.Set;

  class ScriptExecution {
    static void correctlySpends(Script script, Transaction tx, int index, Witness witness, Coin value,
                                Script scriptPubKey, Set<VerifyFlag> flags) {
      if (ScriptPattern.isP2WPKH(scriptPubKey)) {
        TransactionSignature signature = TransactionSignature.decodeFromBitcoin(witness.getPush(0), true, true);
        ECKey pubkey = ECKey.fromPublicOnly(witness.getPush(1));
        byte[] requiredHash160 = ScriptPattern.extractHashFromP2WH(scriptPubKey);
        byte[] providedHash160 = CryptoUtils.sha256hash160(pubkey.getPubKey());
        if (!Arrays.equals(requiredHash160, providedHash160)) {
          throw new RuntimeException("bad key hash");
        }
        Script scriptCode = ScriptBuilder.createP2PKHOutputScript(requiredHash160);
        Hash sigHash = tx.hashForWitnessSignature(index, scriptCode, value, signature.sigHashMode(), false);
        boolean validSig = pubkey.verify(sigHash, signature);
        if (!validSig) throw new RuntimeException("bad sig");
      }
    }
  }
  ```
