# Rank 270 / CVE-2018-15759: brokerapi compared BasicAuth credentials with
# ordinary string equality, leaking timing/observable discrepancy information.

test "rank270: brokerapi BasicAuth ordinary credential equality needs timing review"
  lang go
  expect VYQL-CRY-006
  expect_review code.SecretComparisonReview
  code
  ```
  package auth

  import "net/http"

  type Wrapper struct {
    username string
    password string
  }

  func authorized(wrapper *Wrapper, r *http.Request) bool {
    username, password, isOk := r.BasicAuth()
    return isOk && username == wrapper.username && password == wrapper.password
  }
  ```

test "rank270: brokerapi BasicAuth constant-time compare is clean"
  lang go
  reject VYQL-CRY-006
  reject_review code.SecretComparisonReview
  code
  ```
  package auth

  import (
    "crypto/sha256"
    "crypto/subtle"
    "net/http"
  )

  type Wrapper struct {
    username []byte
    password []byte
  }

  func authorized(wrapper *Wrapper, r *http.Request) bool {
    username, password, isOk := r.BasicAuth()
    u := sha256.Sum256([]byte(username))
    p := sha256.Sum256([]byte(password))
    return isOk &&
      subtle.ConstantTimeCompare(wrapper.username, u[:]) == 1 &&
      subtle.ConstantTimeCompare(wrapper.password, p[:]) == 1
  }
  ```
