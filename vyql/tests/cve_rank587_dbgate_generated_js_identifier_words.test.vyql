test "rank587: generated JavaScript identifiers must reject eval and arguments"
  lang javascript
  file packageTools.ts
  expect VYQL-INJ-127
  expect_review code.IncompleteGeneratedJsIdentifierReservedWords
  code
  ```
  const JS_IDENTIFIER_RE = /^[a-zA-Z_$][a-zA-Z0-9_$]*$/;
  const JS_RESERVED_WORDS = new Set([
    'break', 'case', 'catch', 'class', 'const', 'continue',
    'async', 'await',
    'enum',
  ]);

  export function isValidJsIdentifier(name: string): boolean {
    return typeof name === 'string' && JS_IDENTIFIER_RE.test(name) && !JS_RESERVED_WORDS.has(name);
  }

  export function assertValidShellApiFunctionName(functionName: string): void {
    if (!isValidJsIdentifier(functionName)) {
      throw new Error(`Invalid functionName: ${functionName}`);
    }
  }

  export function compileShellApiFunctionName(functionName) {
    assertValidShellApiFunctionName(functionName);
    return `dbgateApi.${functionName}`;
  }
  ```

test "rank587: generated JavaScript identifier reserved words include eval and arguments"
  lang javascript
  file packageTools.ts
  reject VYQL-INJ-127
  reject_review code.IncompleteGeneratedJsIdentifierReservedWords
  code
  ```
  const JS_IDENTIFIER_RE = /^[a-zA-Z_$][a-zA-Z0-9_$]*$/;
  const JS_RESERVED_WORDS = new Set([
    'break', 'case', 'catch', 'class', 'const', 'continue',
    'async', 'await',
    'enum', 'eval', 'arguments',
  ]);

  export function isValidJsIdentifier(name: string): boolean {
    return typeof name === 'string' && JS_IDENTIFIER_RE.test(name) && !JS_RESERVED_WORDS.has(name);
  }

  export function assertValidShellApiFunctionName(functionName: string): void {
    if (!isValidJsIdentifier(functionName)) {
      throw new Error(`Invalid functionName: ${functionName}`);
    }
  }

  export function compileShellApiFunctionName(functionName) {
    assertValidShellApiFunctionName(functionName);
    return `dbgateApi.${functionName}`;
  }
  ```
