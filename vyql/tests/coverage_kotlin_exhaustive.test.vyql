test "kotlin exhaustive: file and archive APIs receive tainted paths"
  lang kotlin
  expect VYQL-PATH-001
  expect VYQL-PATH-004
  code
  ```
  fun handler(req: Request, archive: Archive) {
    val p = req.getParameter("path")
    File(p).readText()
    FileInputStream(p)
    archive.extractEntry(p)
  }
  ```

test "kotlin exhaustive: canonicalized file and archive paths are clean"
  lang kotlin
  reject VYQL-PATH-001
  reject VYQL-PATH-004
  code
  ```
  fun handler(req: Request, archive: Archive) {
    val p = safePath(req.getParameter("path"))
    File(p).readText()
    archive.extractEntry(p)
  }
  ```

test "kotlin exhaustive: URL receivers fetch tainted URLs"
  lang kotlin
  expect VYQL-RF-001
  code
  ```
  fun handler(req: Request, client: OkHttpClient) {
    val u = req.getParameter("url")
    URL(u).openConnection()
    client.newCall(Request.Builder().url(u).build())
  }
  ```

test "kotlin exhaustive: constant URL receivers are clean for SSRF"
  lang kotlin
  reject VYQL-RF-001
  code
  ```
  fun handler(client: OkHttpClient) {
    URL("https://example.com").openConnection()
    client.newCall(Request.Builder().url("https://example.com").build())
  }
  ```

