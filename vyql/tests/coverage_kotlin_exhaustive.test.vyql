test "kotlin exhaustive: crypto and config presence findings are reported"
  lang kotlin
  expect VYQL-CRY-001
  expect VYQL-CRY-002
  expect VYQL-CRY-003
  expect VYQL-CRY-004
  expect VYQL-CFG-001
  expect VYQL-CFG-003
  expect VYQL-CFG-004
  expect VYQL-CFG-005
  expect VYQL-CFG-007
  expect VYQL-CFG-008
  expect VYQL-CFG-009
  expect VYQL-PATH-003
  code
  ```
  fun handler(http: HttpSecurity, response: Response, file: File) {
    MessageDigest.getInstance("MD5")
    Cipher.getInstance("DES")
    IvParameterSpec("0000000000000000".toByteArray())
    Random()
    http.csrf().disable()
    NoopHostnameVerifier()
    Algorithm.none()
    setSecure(false)
    setHttpOnly(false)
    file.setWritable(true, false)
    Files.createFile(Paths.get("/tmp/fixed"))
    response.setHeader("Access-Control-Allow-Origin", "*")
    response.setHeader("X-Frame-Options", "ALLOWALL")
  }
  ```

test "kotlin exhaustive: stronger crypto and secure config are clean"
  lang kotlin
  reject VYQL-CRY-001
  reject VYQL-CRY-002
  reject VYQL-CRY-003
  reject VYQL-CRY-004
  reject VYQL-CFG-003
  reject VYQL-CFG-004
  reject VYQL-CFG-005
  reject VYQL-CFG-007
  reject VYQL-CFG-008
  reject VYQL-CFG-009
  reject VYQL-PATH-003
  code
  ```
  fun handler(response: Response, file: File, iv: ByteArray) {
    MessageDigest.getInstance("SHA-256")
    Cipher.getInstance("AES/GCM/NoPadding")
    IvParameterSpec(iv)
    SecureRandom()
    setSecure(true)
    setHttpOnly(true)
    file.setWritable(false, false)
    Files.createTempFile("safe", ".tmp")
    response.setHeader("Access-Control-Allow-Origin", "https://example.com")
    response.setHeader("X-Frame-Options", "DENY")
  }
  ```

