# Kotlin language-gap narrowing: exhaustive coverage for adapter-claimed idioms.

test "kotlin exhaustive: servlet input reaches SQL execution"
  lang kotlin
  expect VYQL-INJ-001
  code
  ```
  fun handler(req: Request, stmt: Statement, db: SQLiteDatabase) {
    val q = req.getParameter("q")
    stmt.executeQuery(q)
    stmt.executeUpdate(q)
    stmt.execute(q)
    db.rawQuery(q, null)
    db.execSQL(q)
  }
  ```

test "kotlin exhaustive: constant SQL execution is clean"
  lang kotlin
  reject VYQL-INJ-001
  code
  ```
  fun handler(stmt: Statement, db: SQLiteDatabase) {
    stmt.executeQuery("select 1")
    db.rawQuery("select 1", null)
  }
  ```

test "kotlin exhaustive: servlet input reaches command execution"
  lang kotlin
  expect VYQL-INJ-002
  code
  ```
  fun handler(req: Request) {
    val cmd = req.getParameter("cmd")
    Runtime.getRuntime().exec(cmd)
    ProcessBuilder(cmd).start()
  }
  ```

test "kotlin exhaustive: shell escaping suppresses command execution"
  lang kotlin
  reject VYQL-INJ-002
  code
  ```
  fun handler(req: Request) {
    Runtime.getRuntime().exec(escapeShell(req.getParameter("cmd")))
  }
  ```

test "kotlin exhaustive: Android intent input reaches WebView loads"
  lang kotlin
  expect VYQL-MOB-001
  code
  ```
  fun handler(intent: Intent, webView: WebView) {
    val html = intent.getStringExtra("html")
    webView.loadUrl(html)
    webView.loadData(html, "text/html", "utf-8")
    webView.loadDataWithBaseURL(null, html, "text/html", "utf-8", null)
    webView.evaluateJavascript(html, null)
  }
  ```

test "kotlin exhaustive: constant WebView loads are clean"
  lang kotlin
  reject VYQL-MOB-001
  code
  ```
  fun handler(webView: WebView) {
    webView.loadUrl("https://example.com")
    webView.evaluateJavascript("init()", null)
  }
  ```

