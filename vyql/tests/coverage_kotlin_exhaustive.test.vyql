test "kotlin exhaustive: regex expression and deserialization sinks receive taint"
  lang kotlin
  expect VYQL-DOS-001
  expect VYQL-DESER-001
  code
  ```
  fun handler(req: Request, mapper: ObjectMapper, stream: ObjectInputStream) {
    val p = req.getParameter("pattern")
    Pattern.compile(p)
    Regex(p)
    p.toRegex()
    mapper.readValue(req.getParameter("json"), User::class.java)
    stream.readObject()
  }
  ```

test "kotlin exhaustive: constant regex and deserialization data are clean"
  lang kotlin
  reject VYQL-DOS-001
  reject VYQL-DESER-001
  code
  ```
  fun handler(mapper: ObjectMapper) {
    Pattern.compile("^[a-z]+$")
    mapper.readValue("{\"name\":\"a\"}", User::class.java)
  }
  ```

test "kotlin exhaustive: HTML LDAP XPath trust-boundary and expression sinks receive taint"
  lang kotlin
  expect VYQL-INJ-004
  expect VYQL-INJ-005
  expect VYQL-INJ-006
  expect VYQL-CFG-014
  expect VYQL-INJ-016
  code
  ```
  fun handler(req: Request, out: Writer, ldap: DirContext, xpath: XPath, session: Session, parser: Parser) {
    val v = req.getParameter("v")
    out.write(v)
    ldap.search("dc=x", v, controls)
    xpath.evaluate(v, doc)
    session.setAttribute("role", v)
    parser.parseExpression(v)
  }
  ```

test "kotlin exhaustive: encoders and validation suppress HTML LDAP XPath and trust-boundary findings"
  lang kotlin
  reject VYQL-INJ-004
  reject VYQL-INJ-005
  reject VYQL-INJ-006
  reject VYQL-CFG-014
  code
  ```
  fun handler(req: Request, out: Writer, ldap: DirContext, xpath: XPath, session: Session) {
    val html = escapeHtml(req.getParameter("v"))
    val filter = encodeForLDAP(req.getParameter("v"))
    val path = escapeXPath(req.getParameter("v"))
    val role = validateRole(req.getParameter("v"))
    out.write(html)
    ldap.search("dc=x", filter, controls)
    xpath.evaluate(path, doc)
    session.setAttribute("role", role)
  }
  ```

