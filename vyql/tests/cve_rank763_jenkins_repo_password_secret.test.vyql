# Rank 763 / CVE-2020-2132: Jenkins Environment Manager Tools stored a
# databound repository password as a plain String in job configuration.

test "rank763: Jenkins databound repository password stored as plain string"
  lang java
  file EnvironmentManagerBuilder.java
  expect VYQL-SEC-015
  expect_review code.JenkinsPlaintextDataboundCredential
  code
  ```
  import hudson.tasks.Builder;
  import org.kohsuke.stapler.DataBoundConstructor;

  public class EnvironmentManagerBuilder extends Builder {
      private String repoPassword;

      @DataBoundConstructor
      public EnvironmentManagerBuilder(String repoUsername, String repoPassword) {
          this.repoPassword = repoPassword;
      }
  }
  ```

test "rank763: Jenkins databound repository password converted to Secret"
  lang java
  file EnvironmentManagerBuilder.java
  reject VYQL-SEC-015
  reject_review code.JenkinsPlaintextDataboundCredential
  code
  ```
  import hudson.tasks.Builder;
  import hudson.util.Secret;
  import org.kohsuke.stapler.DataBoundConstructor;

  public class EnvironmentManagerBuilder extends Builder {
      private Secret repoPassword;

      @DataBoundConstructor
      public EnvironmentManagerBuilder(String repoUsername, String repoPassword) {
          this.repoPassword = Secret.fromString(repoPassword);
      }
  }
  ```

test "rank763: Jenkins databound Secret password parameter is clean"
  lang java
  file EnvironmentManagerBuilder.java
  reject VYQL-SEC-015
  code
  ```
  import hudson.tasks.Builder;
