# OWASP-replica coverage for Bash — true positive plus opaque-predicate pruning.

test "bash: positional arg -> eval is code injection"
  lang bash
  expect VYQL-INJ-003
  code
  ```
  x=$1
  eval $x
  ```

test "bash: tainted assign in a live branch is still code injection (no FN)"
  lang bash
  expect VYQL-INJ-003
  code
  ```
  x=$1
  c=ls
  if [ 1 -lt 100 ]; then c=$x; fi
  eval $c
  ```

test "bash: opaque-false if taints only the dead branch — clean"
  lang bash
  reject VYQL-INJ-003
  code
  ```
  x=$1
  c=ls
  if [ 1 -gt 100 ]; then c=$x; fi
  eval $c
  ```

test "bash: opaque case routes taint to a dead arm — clean"
  lang bash
  reject VYQL-INJ-003
  code
  ```
  x=$1
  c=ls
  case 1 in
    9) c=$x;;
    *) c=safe;;
  esac
  eval $c
  ```
