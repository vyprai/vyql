test "rank176: Jenkins AWS global configure endpoint saves config without admin permission check"
  lang java
  expect_review code.SensitiveOperation
  code
  ```
  import hudson.BulkChange;
  import jenkins.model.Jenkins;
  import org.kohsuke.stapler.interceptor.RequirePOST;

  public class AwsManagementLink {
    @RequirePOST
    public synchronized void doConfigure(StaplerRequest req, StaplerResponse rsp) throws Exception {
      BulkChange bc = new BulkChange(Jenkins.get());
      try {
        boolean result = configure(req, req.getSubmittedForm());
        Jenkins.get().save();
        FormApply.success(req.getContextPath() + "/manage").generateResponse(req, rsp, null);
      } finally {
        bc.commit();
      }
    }
  }
  ```

test "rank176: Jenkins AWS global configure endpoint checks admin permission before save"
  lang java
  reject_review code.SensitiveOperation
  code
  ```
  import hudson.BulkChange;
  import jenkins.model.Jenkins;
  import org.kohsuke.stapler.verb.POST;

  public class AwsManagementLink {
    @POST
    public synchronized void doConfigure(StaplerRequest req, StaplerResponse rsp) throws Exception {
      Jenkins.get().checkPermission(Jenkins.ADMINISTER);
      BulkChange bc = new BulkChange(Jenkins.get());
      try {
        boolean result = configure(req, req.getSubmittedForm());
        Jenkins.get().save();
        FormApply.success(req.getContextPath() + "/manage").generateResponse(req, rsp, null);
      } finally {
        bc.commit();
      }
    }
  }
  ```
