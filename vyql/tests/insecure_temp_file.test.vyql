# Insecure temporary file (VYQL-PATH-003, CWE-377) — presence of a predictable-name
# / race-prone temp API. Safe APIs (NamedTemporaryFile) stay clean.

test "python: tempfile.mktemp is insecure"
  lang python
  expect VYQL-PATH-003
  code
  ```
  import tempfile
  p = tempfile.mktemp()
  ```

test "python: NamedTemporaryFile is safe"
  lang python
  reject VYQL-PATH-003
  code
  ```
  import tempfile
  f = tempfile.NamedTemporaryFile()
  ```

test "python: fixed write under shared tmp is insecure"
  lang python
  expect VYQL-PATH-003
  code
  ```
  import os
  filename = "%s.retry" % os.path.basename(playbook)
  filename = os.path.join("/var/tmp/ansible", filename)
  fd = open(filename, "w")
  ```

test "python: fixed write under home is clean"
  lang python
  reject VYQL-PATH-003
  code
  ```
  import os
  filename = "%s.retry" % os.path.basename(playbook)
  filename = os.path.join(os.path.expandvars("$HOME/"), filename)
  fd = open(filename, "w")
  ```

test "python: predictable lxc attach script files are insecure"
  lang python
  expect VYQL-PATH-003
  code
  ```
  import os.path as path
  import tempfile

  script_file = path.join('/opt', '.lxc-attach-script')
  f = open(script_file, 'wb')

  tempdir = tempfile.gettempdir()
  stdout_file = open(path.join(tempdir, 'lxc-attach-script.log'), 'ab')
  stderr_file = open(path.join(tempdir, 'lxc-attach-script.err'), 'ab')
  ```

test "python: lxc attach script mkstemp files are clean"
  lang python
  reject VYQL-PATH-003
  code
  ```
  import os
  import tempfile

  (fd, script_file) = tempfile.mkstemp(prefix='lxc-attach-script')
  f = os.fdopen(fd, 'wb')
  stdout_file = os.fdopen(tempfile.mkstemp(prefix='lxc-attach-script-log')[0], 'ab')
  stderr_file = os.fdopen(tempfile.mkstemp(prefix='lxc-attach-script-err')[0], 'ab')
  ```

test "c: mktemp is insecure"
  lang c
  expect VYQL-PATH-003
  code
  ```
  int main(){ char *p = mktemp("/tmp/fooXXXXXX"); return 0; }
  ```
