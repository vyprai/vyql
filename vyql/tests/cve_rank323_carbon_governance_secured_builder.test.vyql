# Rank 323 / CVE-2023-6836: WSO2 carbon-governance moved XML parser
# construction to a secured DocumentBuilderFactory helper.

test "rank323: raw DocumentBuilderFactory parser is structural XXE"
  lang java
  expect VYQL-DESER-004
  code
  ```
  import java.io.InputStream;
  import javax.xml.parsers.DocumentBuilder;
  import javax.xml.parsers.DocumentBuilderFactory;

  class GovernanceUtils {
    static void initGovernanceConfiguration(InputStream in) throws Exception {
      DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
      DocumentBuilder builder = factory.newDocumentBuilder();
      builder.parse(in);
    }
  }
  ```

test "rank323: getSecuredDocumentBuilder suppresses structural XXE"
  lang java
  reject VYQL-DESER-004
  code
  ```
  import java.io.InputStream;
  import javax.xml.parsers.DocumentBuilder;
  import javax.xml.parsers.DocumentBuilderFactory;

  class GovernanceUtils {
    static void initGovernanceConfiguration(InputStream in) throws Exception {
      DocumentBuilderFactory factory = getSecuredDocumentBuilder();
      DocumentBuilder builder = factory.newDocumentBuilder();
      builder.parse(in);
    }

    static DocumentBuilderFactory getSecuredDocumentBuilder() {
      DocumentBuilderFactory dbf = DocumentBuilderFactory.newInstance();
      dbf.setXIncludeAware(false);
      dbf.setExpandEntityReferences(false);
      return dbf;
    }
  }
  ```
