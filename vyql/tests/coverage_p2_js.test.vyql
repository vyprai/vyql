# P2 entry-point seeding: NestJS controller handler params.

test "js: NestJS @Param -> raw SQL is injection"
  lang javascript
  expect VYQL-INJ-001
  code
  ```
  @Controller('users')
  class UsersController {
    @Get(':id')
    find(id) {
      return this.conn.query("SELECT * FROM users WHERE id = " + id);
    }
  }
  ```

test "js: NestJS @Query -> child_process.exec is command injection"
  lang javascript
  expect VYQL-INJ-002
  code
  ```
  @Controller('ping')
  class PingController {
    @Post()
    ping(host) {
      cp.exec("ping " + host);
    }
  }
  ```

test "js: NestJS constant query is clean"
  lang javascript
  reject VYQL-INJ-001
  code
  ```
  @Controller('users')
  class UsersController {
    @Get()
    all() {
      return this.conn.query("SELECT * FROM users");
    }
  }
  ```

test "js: an undecorated class method param is not a source"
  lang javascript
  reject VYQL-INJ-001
  code
  ```
  class Helper {
    find(id) {
      return this.conn.query("SELECT * FROM users WHERE id = " + id);
    }
  }
  ```
