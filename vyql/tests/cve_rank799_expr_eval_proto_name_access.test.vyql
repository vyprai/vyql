# Rank 799 / CVE-2025-13204: expr-eval allowed expressions to resolve
# prototype-sensitive variable names before evaluating tokens.

test "rank799: expression evaluator resolves prototype names without guard"
  lang javascript
  file evaluate.js
  expect VYQL-INJ-167
  expect_review code.ExpressionEvaluatorPrototypeNameAccess
  code
  ```
  export default function evaluate(tokens, expr, values) {
    var nstack = [];
    for (var i = 0; i < tokens.length; i++) {
      var item = tokens[i];
      var type = item.type;
      if (type === IVAR) {
        if (item.value in expr.functions) {
          nstack.push(expr.functions[item.value]);
        } else {
          var v = values[item.value];
          if (v !== undefined) nstack.push(v);
        }
      } else if (type === IMEMBER) {
        var n1 = nstack.pop();
        nstack.push(n1[item.value]);
      }
    }
    return nstack.pop();
  }
  ```

test "rank799: expression evaluator rejects prototype-sensitive names"
  lang javascript
  file evaluate.js
  reject VYQL-INJ-167
  reject_review code.ExpressionEvaluatorPrototypeNameAccess
  code
  ```
  export default function evaluate(tokens, expr, values) {
    var nstack = [];
    for (var i = 0; i < tokens.length; i++) {
      var item = tokens[i];
      var type = item.type;
      if (type === IVAR) {
        if (/^__proto__|prototype|constructor$/.test(item.value)) {
          throw new Error('prototype access detected');
        }
        if (item.value in expr.functions) {
          nstack.push(expr.functions[item.value]);
        } else {
          var v = values[item.value];
          if (v !== undefined) nstack.push(v);
        }
      } else if (type === IMEMBER) {
        var n1 = nstack.pop();
        nstack.push(n1[item.value]);
      }
    }
    return nstack.pop();
  }
  ```
