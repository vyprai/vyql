test "cve rank313 capnproto: zero-sized list count reaches reader without amplification charge"
  lang cpp
  file layout.c++
  expect VYQL-DOS-012
  expect_review code.ProtocolListAmplification
  code
  ```
  enum class ElementSize { VOID, POINTER };

  void readInlineCompositeList(Source* src, Tag* tag, Segment* srcSegment, void* ptr) {
    auto elementCount = tag->inlineCompositeListElementCount();
    auto wordsPerElement = tag->structRef.wordSize();
    boundsCheck(srcSegment, ptr, ptr + wordsPerElement);
    ListReader(srcSegment, ptr, elementCount, wordsPerElement);
  }

  void readVoidList(Source* src, Segment* srcSegment, void* ptr, ElementSize elementSize, int elementCount) {
    if (elementSize == ElementSize::VOID) {
      ListReader(srcSegment, ptr, elementCount, 0);
    }
  }
  ```

test "cve rank313 capnproto: list amplification generalizes across names"
  lang cpp
  file layout.c++
  expect VYQL-DOS-012
  expect_review code.ProtocolListAmplification
  code
  ```
  enum class ElementSize { VOID, POINTER };

  void readAnyList(Tag* meta, Segment* seg, void* ptr) {
    auto count = meta->inlineCompositeListElementCount();
    auto words = meta->structRef.wordSize();
    ListReader(seg, ptr, count, words);
  }

  void readEmpty(ElementSize size_kind, int count, Segment* seg, void* ptr) {
    if (size_kind == ElementSize::VOID) {
      ListReader(seg, ptr, count, 0);
    }
  }
  ```

test "cve rank313 capnproto: zero-sized list count charged as amplified read"
  lang cpp
  file layout.c++
  reject VYQL-DOS-012
  reject_review code.ProtocolListAmplification
  code
  ```
  enum class ElementSize { VOID, POINTER };

  void readInlineCompositeList(Source* src, Tag* tag, Segment* srcSegment, void* ptr) {
    auto elementCount = tag->inlineCompositeListElementCount();
    auto wordsPerElement = tag->structRef.wordSize();
    boundsCheck(srcSegment, ptr, ptr + wordsPerElement);
    if (wordsPerElement == 0) {
      amplifiedRead(srcSegment, elementCount);
    }
    ListReader(srcSegment, ptr, elementCount, wordsPerElement);
  }

  void readVoidList(Source* src, Segment* srcSegment, void* ptr, ElementSize elementSize, int elementCount) {
    if (elementSize == ElementSize::VOID) {
      amplifiedRead(srcSegment, elementCount);
      ListReader(srcSegment, ptr, elementCount, 0);
    }
  }
  ```
