test "rank524: CPython unicodeescape_string underallocates wide Unicode escape buffer"
  lang c
  expect VYQL-MEM-030
  expect_review code.PythonUnicodeEscapeWideUnderallocation
  code
  ```
  typedef unsigned int Py_UNICODE;
  typedef void PyObject;
  PyObject *PyString_FromStringAndSize(char *s, int size);
  char *PyString_AS_STRING(PyObject *o);
  int _PyString_Resize(PyObject **o, int size);

  static PyObject *unicodeescape_string(const Py_UNICODE *s, int size, int quotes)
  {
      PyObject *repr;
      char *p;
      static const char *hexdigit = "0123456789abcdef";

      repr = PyString_FromStringAndSize(NULL, 2 + 6*size + 1);
      if (repr == NULL)
          return NULL;

      p = PyString_AS_STRING(repr);
      while (size-- > 0) {
          Py_UNICODE ch = *s++;
  #ifdef Py_UNICODE_WIDE
          if (ch >= 0x10000) {
              *p++ = '\\';
              *p++ = 'U';
              *p++ = hexdigit[(ch >> 28) & 0x0000000F];
              *p++ = hexdigit[(ch >> 24) & 0x0000000F];
              *p++ = hexdigit[(ch >> 20) & 0x0000000F];
              *p++ = hexdigit[(ch >> 16) & 0x0000000F];
              *p++ = hexdigit[(ch >> 12) & 0x0000000F];
              *p++ = hexdigit[(ch >> 8) & 0x0000000F];
              *p++ = hexdigit[(ch >> 4) & 0x0000000F];
              *p++ = hexdigit[ch & 0x0000000F];
          }
  #endif
      }
      _PyString_Resize(&repr, p - PyString_AS_STRING(repr));
      return repr;
  }
  ```

test "rank524: CPython unicodeescape_string allocates wide Unicode escape capacity"
  lang c
  reject VYQL-MEM-030
  reject_review code.PythonUnicodeEscapeWideUnderallocation
  code
  ```
  typedef unsigned int Py_UNICODE;
  typedef void PyObject;
  PyObject *PyString_FromStringAndSize(char *s, int size);
  char *PyString_AS_STRING(PyObject *o);
  int _PyString_Resize(PyObject **o, int size);

  static PyObject *unicodeescape_string(const Py_UNICODE *s, int size, int quotes)
  {
      PyObject *repr;
      char *p;
      static const char *hexdigit = "0123456789abcdef";

      repr = PyString_FromStringAndSize(NULL,
          2
  #ifdef Py_UNICODE_WIDE
          + 10*size
  #else
          + 6*size
  #endif
          + 1);
      if (repr == NULL)
          return NULL;

      p = PyString_AS_STRING(repr);
      while (size-- > 0) {
          Py_UNICODE ch = *s++;
  #ifdef Py_UNICODE_WIDE
          if (ch >= 0x10000) {
              *p++ = '\\';
              *p++ = 'U';
              *p++ = hexdigit[(ch >> 28) & 0x0000000F];
              *p++ = hexdigit[(ch >> 24) & 0x0000000F];
              *p++ = hexdigit[(ch >> 20) & 0x0000000F];
              *p++ = hexdigit[(ch >> 16) & 0x0000000F];
              *p++ = hexdigit[(ch >> 12) & 0x0000000F];
              *p++ = hexdigit[(ch >> 8) & 0x0000000F];
              *p++ = hexdigit[(ch >> 4) & 0x0000000F];
              *p++ = hexdigit[ch & 0x0000000F];
          }
  #endif
      }
      _PyString_Resize(&repr, p - PyString_AS_STRING(repr));
      return repr;
  }
  ```
