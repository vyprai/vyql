# The pickle/marshal sink patterns match loosely on the `loads` method name whenever the
# receiver is unresolved, so every `<obj>.loads(...)` looked like CWE-502. Two loaders are
# provably not object deserialization: json.loads (builds only JSON scalars/containers, no
# arbitrary types, no code) and an itsdangerous signed serializer (verifies an HMAC before
# deserializing, raising BadSignature otherwise). Real unsafe loaders must still fire, and
# must keep firing even when they sit next to a signed serializer.

test "python deser: json.loads on request data is not unsafe deserialization"
  lang python
  reject VYQL-DESER-001
  code
  ```
  import json

  def handler(request):
      return json.loads(request.data)
  ```

test "python deser: pickle.loads on request data is unsafe deserialization"
  lang python
  expect VYQL-DESER-001
  code
  ```
  import pickle

  def handler(request):
      return pickle.loads(request.data)
  ```

test "python deser: itsdangerous signed serializer loads is signature-verified, not unsafe"
  lang python
  reject VYQL-DESER-001
  code
  ```
  from itsdangerous import URLSafeTimedSerializer

  def open_session(app, request):
      s = URLSafeTimedSerializer(app.secret_key, salt="cookie-session")
      return s.loads(request.cookies.get("session"), max_age=3600)
  ```

test "python deser: a real pickle loader next to a signed serializer still reports"
  lang python
  expect VYQL-DESER-001
  code
  ```
  import pickle
  from itsdangerous import URLSafeTimedSerializer

  def mixed(app, request):
      s = URLSafeTimedSerializer(app.secret_key)
      safe = s.loads(request.cookies.get("session"))
      evil = pickle.loads(request.data)
      return safe, evil
  ```
