# B1.4 — path-sensitive guards. `unless guarded_by` suppresses only when the guard
# DOMINATES the sink (lies on every CFG path to it). These graph specs carry CFG metadata
# (region/order, as the lowering stamps) on the SAME topology as the presence-model reject
# in coverage_csrf.test.vyql — proving the difference is dominance, not graph shape.
# Without CFG metadata the engine falls back to presence semantics (that reject still holds).

test "path-sensitive: a CSRF guard that DOMINATES the sink suppresses (clean)"
  reject VYQL-RF-003
  graph
  ```
  node src code.HttpInput {region=/fn1, order=1}
  node op code.StateChangingOp {region=/fn1/if2.t, order=5}
  node guard core.CsrfProtection {region=/fn1, order=2}
  edge FLOWS src -> op
  edge PROTECTS guard -> op
  ```

test "path-sensitive: a CSRF guard in a SIBLING branch does NOT cover the sink (vulnerable)"
  expect VYQL-RF-003
  graph
  ```
  node src code.HttpInput {region=/fn1, order=1}
  node op code.StateChangingOp {region=/fn1/if2.t, order=5}
  node guard core.CsrfProtection {region=/fn1/if2.e, order=4}
  edge FLOWS src -> op
  edge PROTECTS guard -> op
  ```

# Real-code guards (B1 enabler): a guard-control-labelled call (validate_csrf_token)
# now suppresses the sinks it DOMINATES — `guarded_by` works on code, not just graphs.

test "path-sensitive: a CSRF check dominating the state change suppresses (real code)"
  lang python
  reject VYQL-RF-003
  code
  ```
  def change_pw(request, account):
      validate_csrf_token(request)
      pw = request.form["new_password"]
      account.change_password(pw)
  ```

test "path-sensitive: a CSRF check in ONE branch does not cover the sink (real code)"
  lang python
  expect VYQL-RF-003
  code
  ```
  def change_pw(request, account, safe):
      if safe:
          validate_csrf_token(request)
      pw = request.form["new_password"]
      account.change_password(pw)
  ```

test "path-sensitive: a preflight validation loop covers a later bulk sink"
  reject VYQL-PATH-004
  graph
  ```
  node src core.UserControlledData {region=/fn1, order=1}
  node guard core.PathAccessCheck {region=/fn1/loop2, order=3}
  node sink code.ArchiveEntryWrite {region=/fn1, order=5}
  edge FLOWS src -> sink
  ```
