# B1.4 — path-sensitive guards. `unless guarded_by` suppresses only when the guard
# DOMINATES the sink (lies on every CFG path to it). These graph specs carry CFG metadata
# (region/order, as the lowering stamps) on the SAME topology as the presence-model reject
# in coverage_csrf.test.vyql — proving the difference is dominance, not graph shape.
# Without CFG metadata the engine falls back to presence semantics (that reject still holds).

test "path-sensitive: a CSRF guard that DOMINATES the sink suppresses (clean)"
  reject VYQL-RF-003
  graph
  ```
  node src code.HttpInput {region=/fn1, order=1}
  node op code.StateChangingOp {region=/fn1/if2.t, order=5}
  node guard core.CsrfProtection {region=/fn1, order=2}
  edge FLOWS src -> op
  edge PROTECTS guard -> op
  ```

test "path-sensitive: a CSRF guard in a SIBLING branch does NOT cover the sink (vulnerable)"
  expect VYQL-RF-003
  graph
  ```
  node src code.HttpInput {region=/fn1, order=1}
  node op code.StateChangingOp {region=/fn1/if2.t, order=5}
  node guard core.CsrfProtection {region=/fn1/if2.e, order=4}
  edge FLOWS src -> op
  edge PROTECTS guard -> op
  ```
