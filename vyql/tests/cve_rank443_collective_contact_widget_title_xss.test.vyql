# Rank 443 / CVE-2022-4638: collective.contact.widget term-contact viewlet
# rendered contact titles into a hidden input without HTML attribute escaping.

test "rank443: collective.contact.widget term title is rendered unescaped"
  lang python
  file widgets.py
  expect VYQL-INJ-089
  expect_review code.CollectiveContactWidgetTitleXss
  code
  ```
  from Products.CMFPlone.utils import base_hasattr, safe_unicode
  from five import grok

  class TermViewlet(grok.Viewlet):
      grok.name('term-contact')
      grok.context(IContactContent)
      grok.viewletmanager(IBelowContent)

      @property
      def title(self):
          if base_hasattr(self.context, 'get_full_title'):
              title = self.context.get_full_title()
          else:
              title = self.context.Title()
          title = title and safe_unicode(title) or u""
          return title

      def render(self):
          return u"""<input type="hidden" name="objpath" value="%s" />""" % (
              '|'.join([self.token, self.title, self.portal_type, self.url]))
  ```

test "rank443: collective.contact.widget term title is escaped before rendering"
  lang python
  file widgets.py
  reject VYQL-INJ-089
  reject_review code.CollectiveContactWidgetTitleXss
  code
  ```
  from cgi import escape
  from Products.CMFPlone.utils import base_hasattr, safe_unicode
  from five import grok

  class TermViewlet(grok.Viewlet):
      grok.name('term-contact')
      grok.context(IContactContent)
      grok.viewletmanager(IBelowContent)

      @property
      def title(self):
          if base_hasattr(self.context, 'get_full_title'):
              title = self.context.get_full_title()
          else:
              title = self.context.Title()
          title = title and safe_unicode(title) or u""
          return escape(title, quote=True)

      def render(self):
          return u"""<input type="hidden" name="objpath" value="%s" />""" % (
              '|'.join([self.token, self.title, self.portal_type, self.url]))
  ```
