# Rust language-gap narrowing: exhaustive coverage for adapter-claimed idioms.

test "rust exhaustive: env and argv reach command builders"
  lang rust
  expect VYQL-INJ-002
  code
  ```
  fn h() {
    let p = std::env::var("CMD").unwrap();
    std::process::Command::new("sh").arg("-c").arg(format!("echo {}", p)).output();
    std::process::Command::new(p).output();
    let args = std::env::args();
    std::process::Command::new("sh").args(args).output();
  }
  ```

test "rust exhaustive: shell escaping suppresses command injection"
  lang rust
  reject VYQL-INJ-002
  code
  ```
  fn h() {
    let p = std::env::var("CMD").unwrap();
    let safe = escape_shell(p);
    std::process::Command::new("sh").arg("-c").arg(safe).output();
  }
  ```

test "rust exhaustive: HTTP clients fetch tainted URLs"
  lang rust
  expect VYQL-RF-001
  code
  ```
  fn h(client: reqwest::Client) {
    let u = std::env::var("URL").unwrap();
    reqwest::get(&u);
    reqwest::post(&u);
    client.get(&u);
    client.post(&u);
    ureq::get(&u);
    ureq::post(&u);
    ureq::request("GET", &u);
    surf::get(&u);
    surf::post(&u);
  }
  ```

test "rust exhaustive: constant HTTP URLs are clean for SSRF"
  lang rust
  reject VYQL-RF-001
  code
  ```
  fn h() {
    reqwest::get("https://example.com");
    ureq::get("https://example.com");
  }
  ```

test "rust exhaustive: cleartext HTTP client URLs are reported"
  lang rust
  expect VYQL-CFG-006
  code
  ```
  fn h(client: reqwest::Client) {
    reqwest::get("http://example.com");
    reqwest::post("http://example.com");
    client.get("http://example.com");
    client.post("http://example.com");
    ureq::get("http://example.com");
    ureq::post("http://example.com");
    ureq::request("GET", "http://example.com");
    surf::get("http://example.com");
    surf::post("http://example.com");
  }
  ```

test "rust exhaustive: HTTPS and localhost URLs are clean for cleartext"
  lang rust
  reject VYQL-CFG-006
  code
  ```
  fn h() {
    reqwest::get("https://example.com");
    ureq::get("http://127.0.0.1:8080/health");
  }
  ```

test "rust exhaustive: regex builders compile tainted patterns"
  lang rust
  expect VYQL-DOS-001
  code
  ```
  fn h() {
    let p = std::env::var("PATTERN").unwrap();
    regex::Regex::new(&p);
    regex::RegexBuilder::new(&p);
  }
  ```

test "rust exhaustive: constant regex patterns are clean"
  lang rust
  reject VYQL-DOS-001
  code
  ```
  fn h() {
    regex::Regex::new("^[a-z]+$");
  }
  ```

test "rust exhaustive: PreEscaped and response bodies render tainted HTML"
  lang rust
  expect VYQL-INJ-004
  code
  ```
  fn h(resp: ResponseBuilder) {
    let html = std::env::var("HTML").unwrap();
    maud::PreEscaped(html.clone());
    resp.body(html);
  }
  ```

test "rust exhaustive: HTML escaping suppresses render findings"
  lang rust
  reject VYQL-INJ-004
  code
  ```
  fn h(resp: ResponseBuilder) {
    let html = html_escape::encode_text(&std::env::var("HTML").unwrap());
    resp.body(html);
  }
  ```

test "rust exhaustive: weak hash cipher static IV and weak RNG are reported"
  lang rust
  expect VYQL-CRY-001
  expect VYQL-CRY-002
  expect VYQL-CRY-003
  expect VYQL-CRY-004
  code
  ```
  fn h(data: &[u8], key: &[u8]) {
    md5::compute(data);
    Md5::new();
    Sha1::new();
    Des::new(key);
    Rc4::new(key);
    Aes128Cbc::new_from_slices(key, b"0000000000000000");
    rand::random::<u32>();
    rand::thread_rng();
    StdRng::seed_from_u64(1);
  }
  ```

test "rust exhaustive: stronger crypto and OsRng are clean"
  lang rust
  reject VYQL-CRY-001
  reject VYQL-CRY-002
  reject VYQL-CRY-003
  reject VYQL-CRY-004
  code
  ```
  fn h(data: &[u8], key: &[u8], iv: &[u8]) {
    Sha256::new();
    Aes256::new(key);
    Aes128Cbc::new_from_slices(key, iv);
    OsRng.fill_bytes(&mut [0u8; 32]);
  }
  ```

test "rust exhaustive: LDAP XPath and trust-boundary sinks receive tainted data"
  lang rust
  expect VYQL-INJ-005
  expect VYQL-INJ-006
  expect VYQL-CFG-014
  code
  ```
  fn h(ldap: Ldap, xpath: Xpath, session: Session) {
    let filter = std::env::var("FILTER").unwrap();
    let xp = std::env::var("XPATH").unwrap();
    let role = std::env::var("ROLE").unwrap();
    ldap.search("base", filter);
    xpath.evaluate(xp);
    session.insert("role", role);
  }
  ```

test "rust exhaustive: LDAP XPath and trust-boundary controls suppress findings"
  lang rust
  reject VYQL-INJ-005
  reject VYQL-INJ-006
  reject VYQL-CFG-014
  code
  ```
  fn h(ldap: Ldap, xpath: Xpath, session: Session) {
    let filter = encode_for_ldap(std::env::var("FILTER").unwrap());
    let xp = escape_xpath(std::env::var("XPATH").unwrap());
    let role = validate_role(std::env::var("ROLE").unwrap());
    ldap.search("base", filter);
    xpath.evaluate(xp);
    session.insert("role", role);
  }
  ```

test "rust exhaustive: SQL and file APIs receive tainted values"
  lang rust
  expect VYQL-INJ-001
  expect VYQL-PATH-001
  code
  ```
  fn h(db: Db) {
    let q = std::env::var("Q").unwrap();
    let p = std::env::var("PATH_INFO").unwrap();
    sqlx::query(&q);
    db.query(&q);
    db.execute(&q);
    std::fs::read(&p);
    std::fs::read_to_string(&p);
    std::fs::write(&p, "x");
    std::fs::remove_file(&p);
    std::fs::File::open(&p);
    std::fs::File::create(&p);
  }
  ```

test "rust exhaustive: SQL parameterization and safePath suppress filesystem findings"
  lang rust
  reject VYQL-INJ-001
  reject VYQL-PATH-001
  code
  ```
  fn h(db: Db) {
    sqlx::query("select 1");
    std::fs::read(safe_path(std::env::var("PATH_INFO").unwrap()));
  }
  ```

test "rust exhaustive: archive extraction and deserialization receive tainted data"
  lang rust
  expect VYQL-PATH-004
  expect VYQL-DESER-001
  code
  ```
  fn h(archive: Archive) {
    let entry = std::env::var("ENTRY").unwrap();
    let blob = std::env::var("BLOB").unwrap();
    archive.extract_entry(entry);
    archive.extract(blob);
    serde_json::from_str(blob);
    serde_yaml::from_str(blob);
  }
  ```

test "rust exhaustive: auth and IDOR findings are reported"
  lang rust
