test "rust exhaustive: auth and ownership guards suppress findings"
  lang rust
  reject VYQL-AUTH-001
  reject VYQL-AUTH-002
  code
  ```
  fn h(repo: Repo) {
    require_auth();
    change_password();
    check_ownership(std::env::var("ID").unwrap());
    repo.find_by_id(std::env::var("ID").unwrap());
  }
  ```

test "rust exhaustive: cert disable permission temp and memory review points are reported"
  lang rust
  expect VYQL-CFG-004
  expect VYQL-CFG-008
  expect VYQL-PATH-003
  expect VYQL-MEM-005
  expect VYQL-MEM-006
  code
  ```
  #[get("/")]
  fn h(i: usize, data: Vec<u8>, p: *const i32) {
    ClientBuilder::new().danger_accept_invalid_certs(true);
    OpenOptions::new().mode(0o777);
    std::fs::File::create("/tmp/predictable");
    let _x = data[i];
    unsafe { let _y = *p; }
  }
  ```

test "rust exhaustive: secure cert permission temp and memory cases are clean"
  lang rust
  reject VYQL-CFG-004
  reject VYQL-CFG-008
  reject VYQL-PATH-003
  reject VYQL-MEM-005
  reject VYQL-MEM-006
  code
  ```
  fn h(data: Vec<u8>, p: i32) {
    ClientBuilder::new().danger_accept_invalid_certs(false);
    OpenOptions::new().mode(0o600);
    tempfile::NamedTempFile::new();
    let _x = data[0];
    let _y = p;
  }
  ```
