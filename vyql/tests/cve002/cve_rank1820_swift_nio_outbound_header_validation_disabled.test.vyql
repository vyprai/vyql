test "rank1820: a false passed to error handling with header validation left at its default is not read as the validation switch"
  lang swift
  file Tests/NIOHTTP1Tests/ErrorHandlingOnly.swift
  reject VYQL-INJ-247
  code
  ```
  import NIOCore
  import NIOHTTP1

  final class ErrorHandlingOnly {
      let channel: EmbeddedChannel

      init() {
          self.channel = EmbeddedChannel()
      }

      func configure() throws {
          try channel.pipeline.syncOperations.configureHTTPServerPipeline(withErrorHandling: false)
      }
  }
  ```

test "rank1820: the server pipeline left at its validating default, the patched form the fixed revision ships"
  lang swift
  file Sources/App/ServerBootstrap.swift
  reject VYQL-INJ-247
  code
  ```
  import NIOCore
  import NIOHTTP1

  final class ServerBootstrap {
      let channel: Channel

      init(channel: Channel) {
          self.channel = channel
      }

      func configure() -> EventLoopFuture<Void> {
          return channel.pipeline.configureHTTPServerPipeline()
      }
  }
  ```

test "rank1820: the server pipeline with outbound header validation explicitly enabled"
  lang swift
  file Sources/App/ServerBootstrapExplicit.swift
  reject VYQL-INJ-247
  code
  ```
  import NIOCore
  import NIOHTTP1

  final class ServerBootstrapExplicit {
      let channel: Channel

      init(channel: Channel) {
          self.channel = channel
      }

      func configure() -> EventLoopFuture<Void> {
          return channel.pipeline.configureHTTPServerPipeline(
              position: .last,
              withPipeliningAssistance: true,
              withServerUpgrade: nil,
              withErrorHandling: true,
              withOutboundHeaderValidation: true
          )
      }
  }
  ```

test "rank1820: the client pipeline with outbound header validation explicitly enabled"
  lang swift
  file Sources/App/ClientBootstrap.swift
  reject VYQL-INJ-247
  code
  ```
  import NIOCore
  import NIOHTTP1

  final class ClientBootstrap {
      let channel: Channel

      init(channel: Channel) {
          self.channel = channel
      }

      func configure() -> EventLoopFuture<Void> {
          return channel.pipeline.addHTTPClientHandlers(enableOutboundHeaderValidation: true)
      }
  }
  ```
