# Label Studio's Django settings module shipped a fixed SECRET_KEY literal
# baked into the source, so every deployment that did not override it shared
# one key capable of forging signed sessions, CSRF tokens, and password
# reset links.

test "rank1289: Django settings module assigns SECRET_KEY a hardcoded literal"
  lang python
  file settings/base.py
  expect VYQL-AUTH-101
  code
  ```
  import logging

  from core.utils.io import get_data_dir
  from core.utils.params import get_bool_env, get_env

  # SECURITY WARNING: keep the secret key used in production secret!
  SECRET_KEY = '$(fefwefwef13;LFK{P!)@#*!)kdsjfWF2l+i5e3t(8a1n'
  ```

test "rank1289: Django settings module derives SECRET_KEY from the environment with a generated fallback"
  lang python
  file settings/base.py
  reject VYQL-AUTH-101
  code
  ```
  import logging

  from core.utils.io import get_data_dir, generate_key_if_missing
  from core.utils.params import get_bool_env, get_env

  # SECURITY WARNING: keep the secret key used in production secret!
  SECRET_KEY = generate_key_if_missing('SECRET_KEY')
  ```
