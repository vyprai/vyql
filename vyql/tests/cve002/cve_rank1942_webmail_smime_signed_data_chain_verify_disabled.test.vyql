test "rank1942: a comment naming the disabled spelling neither creates nor silences the flag"
  lang javascript
  file comments.js
  expect VYQL-CFG-004
  code
  ```
  export async function smimeVerify(cmsBytes) {
    // the chain check read checkChain: true before the v1 rewrite, and the
    // migration note still says do not restore checkChain: false blindly
    const signedData = extractSignedData(parseContentInfo(cmsBytes));
    const ok = await signedData.verify(
      { signer: 0, checkChain: false },
      cryptoEngine,
    );
    return ok;
  }
  ```

test "rank1942: a comment naming the disabled spelling does not flag a verifying function"
  lang javascript
  file comments-fixed.js
  reject VYQL-CFG-004
  code
  ```
  export async function smimeVerify(cmsBytes) {
    // do not set checkChain: false here; chain validation is required
    const signedData = extractSignedData(parseContentInfo(cmsBytes));
    const ok = await signedData.verify(
      { signer: 0, checkChain: true, trustedCerts: anchors },
      cryptoEngine,
    );
    return ok;
  }
  ```

test "rank1942: the fixed revision's own variable names are not the anchor"
  lang javascript
  file renamed.js
  expect VYQL-CFG-004
  code
  ```
  async function checkMessage(raw) {
    const blob = new pkijs.SignedData({ schema: read(raw).content });
    const ok = await blob.verify({ signer: 0, checkChain: false }, engine);
    return ok;
  }
