  ```
  import hljs from 'highlight.js';
  import MarkdownIt from 'markdown-it';

  const markdownit = new MarkdownIt('zero', {breaks: true, html: false, linkify: true});

  export const renderMessage = (message, mentionTexts) => {
    markdownit.set({
      highlight: function (code) {
        const containsMentions = Object.keys(mentionTexts).some(hash => code.includes(hash));
        if (containsMentions) {
          // same registration, same highlighter, same mention branch --
          // only the returned expression differs from the first test
          return hljs.highlightAuto(code).value;
        }
        return hljs.highlightAuto(code).value;
      },
    });
    return markdownit.render(message);
  };
  ```

test "rank1956: markdown-it's documented hljs integration returns highlighter output, not raw text"
  lang javascript
  file src/script/util/readme-example.ts
  reject VYQL-INJ-004
  code
  ```
  import hljs from 'highlight.js';
  import MarkdownIt from 'markdown-it';

  // markdown-it's own README example: every return path is either the
  // highlighter's escaped markup or the empty string that defers escaping
  // to the renderer. A presence rule keying on "highlight callback with
  // no escape call" flags exactly this file and must not.
  const md = MarkdownIt({
    highlight: function (str, lang) {
      if (lang && hljs.getLanguage(lang)) {
        try {
          return hljs.highlight(lang, str).value;
        } catch (err) {
          console.error(err);
        }
      }
      return '';
    },
  });

  export const render = text => md.render(text);
  ```

test "rank1956: passing the highlighter by name reports the same nothing as the inline literal"
  lang javascript
  file src/script/util/messageRenderer-by-name.ts
  reject VYQL-INJ-004
  code
  ```
  import hljs from 'highlight.js';
  import MarkdownIt from 'markdown-it';

  const markdownit = new MarkdownIt('zero', {breaks: true, html: false, linkify: true});

  function highlightFence(code) {
    if (code.includes('@@')) {
      return code;
    }
    return hljs.highlightAuto(code).value;
  }

  export const renderMessage = message => {
    markdownit.set({highlight: highlightFence});
    return markdownit.render(message);
  };
  ```
