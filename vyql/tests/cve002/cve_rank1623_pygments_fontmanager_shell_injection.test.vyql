# Rank 1623 / CVE-2015-8557: Pygments' image formatter asked fontconfig
# for a font path by interpolating the configured font name into a shell
# command. FontManager._get_nix_font_path in pygments/formatters/img.py
# ran getstatusoutput('fc-list "%s:style=%s" file' % (name, style)),
# where name is the font_name formatter option -- attacker-controlled
# through `pygmentize -O font_name=...` -- so a crafted option broke out
# of the quoted context and executed an arbitrary command (shell
# injection, CWE-78). The fixing commit db6dd826f8 is the merge of pull
# request #501; the readable fix is its first parent e0e6a3d ("Fix
# Shell Injection in FontManager._get_nix_font_path"), which wraps the
# interpolated pattern in shlex.quote and drops the manual double
# quotes. The merge row's parent carries
# the change, so the vulnerable tree is e0e6a3d^ (4e0b1c8).
#
# The sink and the control are both bound today: getstatusoutput is
# code.CommandExecution at args[0] (through the function-local
# from-import in both spellings), shlex.quote is core.ShellEscape, and
# VYQL-INJ-002 fires whenever an untrusted value reaches the %-format
# ahead of the call. The expect block pins that path with the font name
# sourced from sys.argv, standing in for the -O option; it drives
# _create_nix from a caller because the real code dispatches it from
# inside __init__, and constructor arguments never reach __init__ --
# the call does not resolve to the class (resolveTargets looks up
# functions only, lowering.go:5019), so taint dies at the ctor call
# site and the internal self._create_nix() stays cold. The same chain
# also breaks one hop earlier on the real tree: a keyword argument
# splatted into a **options parameter drops its taint. Scanning the
# vulnerable checkout reports zero findings on img.py for those two
# hops, which stay engine work (a ctor-args-into-__init__ relation is
# resolution-wide, not a confined fix). The reject block is the patched
# form: shlex.quote around the pattern neutralises the path, so the
# same driver reports nothing.

test "rank1623: unescaped font name into fc-list via getstatusoutput"
  lang python
  file pygments/formatters/img.py
  expect VYQL-INJ-002
  code
  ```
  import sys


  class FontManager(object):

      def __init__(self, font_name, font_size=14):
          self.font_name = font_name
          self.font_size = font_size
          self.fonts = {}
          if not font_name:
              self.font_name = 'Bitstream Vera Sans Mono'

      def _get_nix_font_path(self, name, style):
          try:
              from commands import getstatusoutput
          except ImportError:
              from subprocess import getstatusoutput
          exit, out = getstatusoutput('fc-list "%s:style=%s" file' %
                                      (name, style))
          if not exit:
              lines = out.splitlines()
              if lines:
                  path = lines[0].strip().strip(':')
                  return path

      def _create_nix(self):
          for name in ['', 'Roman', 'Book', 'Normal', 'Regular', 'Medium']:
              path = self._get_nix_font_path(self.font_name, name)
              if path is not None:
                  break


  def main():
      fm = FontManager(sys.argv[1])
      fm._create_nix()
  ```

test "rank1623: shlex.quote around the font pattern is safe"
  lang python
  file pygments/formatters/img.py
  reject VYQL-INJ-002
  code
  ```
  import sys
  import shlex


  class FontManager(object):

      def __init__(self, font_name, font_size=14):
          self.font_name = font_name
          self.font_size = font_size
          self.fonts = {}
          if not font_name:
              self.font_name = 'Bitstream Vera Sans Mono'

      def _get_nix_font_path(self, name, style):
          try:
              from commands import getstatusoutput
          except ImportError:
              from subprocess import getstatusoutput
          exit, out = getstatusoutput('fc-list %s file' %
                                      shlex.quote("%s:style=%s" % (name, style)))
          if not exit:
              lines = out.splitlines()
              if lines:
                  path = lines[0].strip().strip(':')
                  return path

      def _create_nix(self):
          for name in ['', 'Roman', 'Book', 'Normal', 'Regular', 'Medium']:
              path = self._get_nix_font_path(self.font_name, name)
              if path is not None:
                  break


  def main():
      fm = FontManager(sys.argv[1])
      fm._create_nix()
  ```
