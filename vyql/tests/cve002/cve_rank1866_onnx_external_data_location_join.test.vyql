test "rank1866: (g) a document entry's value naming a file to read is the same weakness"
  lang rust
  file manifest/src/blob.rs
  expect VYQL-PATH-006
  code
  ```
  use std::fs;
  use std::path::PathBuf;

  struct Entry {
      key: String,
      value: String,
  }

  fn load_referenced_blob(dir: &str, entry: &Entry) -> Vec<u8> {
      let name = entry.value.as_str();
      let p = PathBuf::from(dir).join(name);
      fs::read(&p).unwrap_or_default()
  }
  ```
