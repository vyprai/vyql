  ```
  use std::fs;
  use std::path::PathBuf;

  fn load_builtin_weights(dir: &str) -> Vec<u8> {
      let p = PathBuf::from(dir).join("weights.bin");
      fs::read(&p).unwrap_or_default()
  }
