# Rank 1516 / CVE-2025-54874: upstream OpenJPEG used the image a failed
# header read left behind (out-of-bounds heap write on a short data
# stream, CWE-457 use of uninitialized variable in NVD's framing):
# opj_jp2_read_header in src/lib/openjp2/jp2.c assigned
# ret = opj_j2k_read_header(p_stream, jp2->j2k, p_image, p_manager) and
# then branched on `if (p_image && *p_image)` -- the pointers are
# guarded but the call's status is not, so a read that fails with
# p_image partially set proceeded to write (*p_image)->color_space from
# an invalid structure. This is the upstream original of rank
# 1509 reviewed as OpenCV's cherry-pick (CVE-2025-53644, GHSL-2025-057
# family): the advisory for this CVE names branch commit f809b80
# ("opj_jp2_read_header: Check for error after parsing header.") while
# the pool holds the merge 44119c2 that carries it -- COMMIT_MISMATCH is
# merge-versus-branch only, the same one-line change (`ret &&` added to
# the guard).
#
# FIXED by the same engine fact rank 1509 shipped for its cherry-pick:
# analysis.out_param.status_unchecked (ccOutParamStatusUnchecked
# Observations in internal/extract/frontend/treesitter/c.go) reaches
# VYQL-MEM-075 / code.MissingOutParamStatusCheck, and the pair below is
# the flip this spec's previous form was holding open for. Real-tree
# A/B, 3 x --cache off / timeout 180 / --max-ram 6GB at eb25a5ec
# (= 44119c2^1, vulnerable) and f809b80c (fixed, byte-equal to the
# merge 44119c2 for that file): src/lib/openjp2/jp2.c reports 26
# findings with exactly one VYQL-MEM-075 at jp2.c:2835 -- the body of
# opj_jp2_read_header -- on all three vulnerable runs and 25 with none
# on all three fixed runs; src/lib/openjp2 whole gives 1 MEM-075 row
# against 0, and the whole tree 22888 finding lines against 22887 with
# that single row the only substantive difference.
#
# Before the fact landed, both revisions reported identically: 25
# findings and 243 review flags on jp2.c at each revision, the only
# rule at the site being VYQL-MEM-006 from nullableDeref135, which
# binds `node.path ~= "__deref"` and emits code.NullableDeref on every
# pointer dereference in every C file -- 22 rows in jp2.c alone, one
# per __deref occurrence, carrying no guard knowledge at all. The
# third block is the guard against a conjunction-shaped reading of the
# fix: a dominating early return on the status clears the fact too, so
# the discriminator is that the status is consulted anywhere between
# the call and the read, not that it appears as one more conjunct.

test "rank1516: the image a failed header read handed back is read through its null guards"
  lang c
  file src/lib/openjp2/jp2.c
  expect VYQL-MEM-075
  code
  ```
  typedef int OPJ_BOOL;
  typedef struct { int color_space; } opj_image_t;
  typedef struct { int dummy; } opj_stream_private_t;
  typedef struct { int dummy; } opj_jp2_codec;

  OPJ_BOOL opj_j2k_read_header(opj_stream_private_t *stream, opj_jp2_codec *codec, opj_image_t **p_image, int *manager);

  OPJ_BOOL opj_jp2_read_header(opj_stream_private_t *p_stream, opj_jp2_codec *p_codec, opj_image_t **p_image) {
      int manager = 0;
      opj_jp2_codec *jp2 = p_codec;
      OPJ_BOOL ret = opj_j2k_read_header(p_stream, jp2, p_image, &manager);
      if (p_image && *p_image) {
          (*p_image)->color_space = 18;
      }
      return ret;
  }
  ```

test "rank1516: the fixed revision consults the read status in the same guard"
  lang c
  file src/lib/openjp2/jp2.c
  reject VYQL-MEM-075
  code
  ```
  typedef int OPJ_BOOL;
  typedef struct { int color_space; } opj_image_t;
  typedef struct { int dummy; } opj_stream_private_t;
  typedef struct { int dummy; } opj_jp2_codec;

  OPJ_BOOL opj_j2k_read_header(opj_stream_private_t *stream, opj_jp2_codec *codec, opj_image_t **p_image, int *manager);

  OPJ_BOOL opj_jp2_read_header(opj_stream_private_t *p_stream, opj_jp2_codec *p_codec, opj_image_t **p_image) {
      int manager = 0;
      opj_jp2_codec *jp2 = p_codec;
      OPJ_BOOL ret = opj_j2k_read_header(p_stream, jp2, p_image, &manager);
      if (ret && p_image && *p_image) {
          (*p_image)->color_space = 18;
      }
      return ret;
  }
  ```

test "rank1516: a dominating early return on the status clears the fact as well"
  lang c
  file src/lib/openjp2/jp2.c
  reject VYQL-MEM-075
  code
  ```
  typedef int OPJ_BOOL;
  typedef struct { int color_space; } opj_image_t;
  typedef struct { int dummy; } opj_stream_private_t;
  typedef struct { int dummy; } opj_jp2_codec;

  OPJ_BOOL opj_j2k_read_header(opj_stream_private_t *stream, opj_jp2_codec *codec, opj_image_t **p_image, int *manager);

  OPJ_BOOL opj_jp2_read_header(opj_stream_private_t *p_stream, opj_jp2_codec *p_codec, opj_image_t **p_image) {
      int manager = 0;
      opj_jp2_codec *jp2 = p_codec;
      OPJ_BOOL ret = opj_j2k_read_header(p_stream, jp2, p_image, &manager);
      if (!ret) {
          return 0;
      }
      if (p_image && *p_image) {
          (*p_image)->color_space = 18;
      }
      return ret;
  }
  ```
