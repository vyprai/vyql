# Rank 1221 / CVE-2021-39155 (GHSA-7774-7vr3-cc8j): Istio's AuthorizationPolicy
# "hosts" field compiles to an Envoy RBAC filter permission built by
# pilot/pkg/security/authz/model/generator.go's hostGenerator.permission, which
# handed the policy's host value straight to
# pilot/pkg/security/authz/matcher/header.go's HeaderMatcher. HeaderMatcher
# builds an exact/prefix/suffix HeaderMatcher over the literal string, all
# three case-sensitive. Envoy itself routes and matches the HTTP :authority
# (Host) header case-insensitively per RFC 4343, so a policy written to reject
# "httpbin.foo" for some source could be bypassed by requesting
# "Httpbin.Foo" — the data plane still routes it to the same backend, but
# the case-sensitive RBAC comparison against the policy's literal host no
# longer matches the header Envoy actually saw (CWE-178).
#
# Fix 084b417a486dbe9b9024d4812877016a484572b1 (verified: the only functional
# diff for this GHSA is a new HostMatcher in header.go — a "*" present match,
# and a case-insensitive `(?i)` SafeRegexMatch for every other case, generated
# the same way HeaderMatcher generates ExactMatch/PrefixMatch/SuffixMatch —
# and switching hostGenerator.permission to call it instead of HeaderMatcher;
# the bundled URL-fragment-stripping bootstrap change in the same squashed
# commit is for a different advisory and does not touch this file set.
#
# The decisive precision fact, and the reason no binding on the shared
# builder can ever discriminate: HeaderMatcher itself is untouched by the fix.
# At the fixed revision it still builds case-sensitive ExactMatch /
# PrefixMatch / SuffixMatch, and it is still called for the plain `headers`
# field (requestHeaderGenerator.principal) and for the :method pseudo-header
# (methodGenerator.permission) — both legitimately case-sensitive, both
# deliberately left on HeaderMatcher. Only hostGenerator's one call site
# moves to HostMatcher, so any detection keyed on HeaderMatcher's own body
# shape fires identically on both revisions and flags remediated code, and the
# only token-level difference inside generator.go is the callee name
# HeaderMatcher vs. HostMatcher, which is the fixing commit's own vocabulary.
#
# ATTENTION, vocabulary gap, held on recheck. `vyql match` on the real
# vulnerable checkout's pilot/pkg/security/authz/matcher directory reports no
# source, sink or control at all; `vyql resolve` there reports 203 call sites
# resolved/recognized against 68 unresolved, with header.go's own function
# contexts (HeaderMatcher, PathMatcher) among the unknowns. Three
# --cache off scans per revision of pilot/pkg/security/authz (timeout 180,
# --max-ram 6GB; go:20 textpattern:20) report 0 findings and 0 review flags on
# the vulnerable revision and the same 0/0 on the fixed one — deterministic,
# no noise floor to read a miss out of. The whole tree does stay in bounds
# (393 findings in ~70s, under the 6GB cap) and is identical across the two
# revisions apart from one byte-for-byte matching test-file FilePathAccess at
# builder/builder_test.go:343; the exhaustive label set of the subtree is 41
# go.sinks labels, 40 of them in _test.go, plus builder/logger.go:48
# LogOutput and builder/extauthz.go:294 strings.ReplaceAll as a CharFilter —
# nothing at matcher/header.go, matcher/string.go, matcher/cidr.go,
# matcher/metadata.go or model/generator.go. The CWE-178 family has grown from
# one concept to five since the first pass (CaseInsensitiveLocalIdentity-
# AuthorizationBypass, ComrakDangerousUrlCaseSensitiveGrammar, UrlPathParameter-
# CaseNormalizationBypass, SchematronLinkHrefUnsafeSchemeDenylist,
# RecursionGuardIndexedByUnnormalizedKey), and none of the five carries a Go
# binding. None of them models this mechanism either: the shipped CWE-178
# bindings all key on a positive, observable comparison the code itself
# performs — comrak's .pest grammar spells the case-sensitive `data:` /
# `javascript:` prefixes out as grammar text, and jquery's attr.js shows the
# lowercased `attrHooks[name.toLowerCase()]` lookup sitting beside the
# unnormalized `attrHandle[name]` index in one file. Istio's Go performs no
# comparison at all, wrong or right: it populates a go-control-plane protobuf
# oneof (HeaderMatcher_ExactMatch vs. HeaderMatcher_SafeRegexMatch with a
# `(?i)` prefix) and the case-sensitivity is a property of Envoy's C++ RBAC
# filter at request time, entirely outside any code a scan sees. There is no
# token pair to bind. Keying on which oneof variant a composite literal
# populates would encode that Envoy runtime semantics as go-control-plane
# vocabulary no library documentation states, failing the genericity test, and
# an absence binding ("host permission built without case-insensitive
# matching") is both the measured-unshippable no-signal-in-the-body shape and
# blind to the fact that the host key's meaning — hostHeader = ":authority" —
# lives in a third file (model.go) whose const the generator only names. No
# binding, concept or rule change was attempted; no engine gap is involved
# (nothing to resolve, attribute or scope — there is no vocabulary at all).

test "rank1221: hostGenerator.permission routes the policy host through the shared case-sensitive HeaderMatcher"
  lang go
  reject VYQL-AUTH-032
  file model.go
  ```
  package model

  // Internal names used to generate corresponding Envoy matcher.
  const (
  	methodHeader = ":method"
  	pathMatcher  = "path-matcher"
  	hostHeader   = ":authority"
  )
  ```
  file header.go
  ```
  package matcher

  import (
  	"strings"

  	routepb "github.com/envoyproxy/go-control-plane/envoy/config/route/v3"
  )

  // HeaderMatcher converts a key, value string pair to a corresponding HeaderMatcher.
  func HeaderMatcher(k, v string) *routepb.HeaderMatcher {
  	// We must check "*" first to make sure we'll generate a non empty value in the prefix/suffix case.
  	// Empty prefix/suffix value is invalid in HeaderMatcher.
  	if v == "*" {
  		return &routepb.HeaderMatcher{
  			Name: k,
  			HeaderMatchSpecifier: &routepb.HeaderMatcher_PresentMatch{
  				PresentMatch: true,
  			},
  		}
  	} else if strings.HasPrefix(v, "*") {
  		return &routepb.HeaderMatcher{
  			Name: k,
  			HeaderMatchSpecifier: &routepb.HeaderMatcher_SuffixMatch{
  				SuffixMatch: v[1:],
  			},
  		}
  	} else if strings.HasSuffix(v, "*") {
  		return &routepb.HeaderMatcher{
  			Name: k,
  			HeaderMatchSpecifier: &routepb.HeaderMatcher_PrefixMatch{
  				PrefixMatch: v[:len(v)-1],
  			},
  		}
  	}
  	return &routepb.HeaderMatcher{
  		Name: k,
  		HeaderMatchSpecifier: &routepb.HeaderMatcher_ExactMatch{
  			ExactMatch: v,
  		},
  	}
  }
  ```
  file generator.go
  ```
  package model

  import (
  	"fmt"
  	"strings"

  	"istio.io/istio/pilot/pkg/security/authz/matcher"
  )

  func (requestHeaderGenerator) principal(key, value string, forTCP bool) (*rbacpb.Principal, error) {
  	if forTCP {
  		return nil, fmt.Errorf("%q is HTTP only", key)
  	}

  	header, err := extractNameInBrackets(strings.TrimPrefix(key, attrRequestHeader))
  	if err != nil {
  		return nil, err
  	}
  	m := matcher.HeaderMatcher(header, value)
  	return principalHeader(m), nil
  }

  type hostGenerator struct {
  }

  func (hostGenerator) permission(key, value string, forTCP bool) (*rbacpb.Permission, error) {
  	if forTCP {
  		return nil, fmt.Errorf("%q is HTTP only", key)
  	}

  	m := matcher.HeaderMatcher(hostHeader, value)
  	return permissionHeader(m), nil

  }

  func (hostGenerator) principal(key, value string, forTCP bool) (*rbacpb.Principal, error) {
  	return nil, fmt.Errorf("unimplemented")
  }

  type methodGenerator struct {
  }

  func (methodGenerator) permission(key, value string, forTCP bool) (*rbacpb.Permission, error) {
  	if forTCP {
  		return nil, fmt.Errorf("%q is HTTP only", key)
  	}

  	m := matcher.HeaderMatcher(methodHeader, value)
  	return permissionHeader(m), nil
  }

  func (methodGenerator) principal(key, value string, forTCP bool) (*rbacpb.Principal, error) {
  	return nil, fmt.Errorf("unimplemented")
  }
  ```

test "rank1221: hostGenerator.permission moves to the case-insensitive HostMatcher while the shared HeaderMatcher keeps its other callers"
  lang go
  reject VYQL-AUTH-032
  file model.go
  ```
  package model

  // Internal names used to generate corresponding Envoy matcher.
  const (
  	methodHeader = ":method"
  	pathMatcher  = "path-matcher"
  	hostHeader   = ":authority"
  )
  ```
  file header.go
  ```
  package matcher

  import (
  	"regexp"
  	"strings"

  	routepb "github.com/envoyproxy/go-control-plane/envoy/config/route/v3"
  	matcherpb "github.com/envoyproxy/go-control-plane/envoy/type/matcher/v3"
  )

  // HeaderMatcher converts a key, value string pair to a corresponding HeaderMatcher.
  func HeaderMatcher(k, v string) *routepb.HeaderMatcher {
  	// We must check "*" first to make sure we'll generate a non empty value in the prefix/suffix case.
  	// Empty prefix/suffix value is invalid in HeaderMatcher.
  	if v == "*" {
  		return &routepb.HeaderMatcher{
  			Name: k,
  			HeaderMatchSpecifier: &routepb.HeaderMatcher_PresentMatch{
  				PresentMatch: true,
  			},
  		}
  	} else if strings.HasPrefix(v, "*") {
  		return &routepb.HeaderMatcher{
  			Name: k,
  			HeaderMatchSpecifier: &routepb.HeaderMatcher_SuffixMatch{
  				SuffixMatch: v[1:],
  			},
  		}
  	} else if strings.HasSuffix(v, "*") {
  		return &routepb.HeaderMatcher{
  			Name: k,
  			HeaderMatchSpecifier: &routepb.HeaderMatcher_PrefixMatch{
  				PrefixMatch: v[:len(v)-1],
  			},
  		}
  	}
  	return &routepb.HeaderMatcher{
  		Name: k,
  		HeaderMatchSpecifier: &routepb.HeaderMatcher_ExactMatch{
  			ExactMatch: v,
  		},
  	}
  }

  // HostMatcher creates a host matcher for a host.
  func HostMatcher(k, v string) *routepb.HeaderMatcher {
  	var regex string
  	if v == "*" {
  		return &routepb.HeaderMatcher{
  			Name: k,
  			HeaderMatchSpecifier: &routepb.HeaderMatcher_PresentMatch{
  				PresentMatch: true,
  			},
  		}
  	} else if strings.HasPrefix(v, "*") {
  		regex = `.*` + regexp.QuoteMeta(v[1:])
  	} else if strings.HasSuffix(v, "*") {
  		regex = regexp.QuoteMeta(v[:len(v)-1]) + `.*`
  	} else {
  		regex = regexp.QuoteMeta(v)
  	}
  	return &routepb.HeaderMatcher{
  		Name: k,
  		HeaderMatchSpecifier: &routepb.HeaderMatcher_SafeRegexMatch{
  			SafeRegexMatch: &matcherpb.RegexMatcher{
  				EngineType: &matcherpb.RegexMatcher_GoogleRe2{
  					GoogleRe2: &matcherpb.RegexMatcher_GoogleRE2{},
  				},
  				Regex: `(?i)` + regex,
  			},
  		},
  	}
  }
  ```
