test "rank1354: a parameter merged with a constructor leaves the client untyped"
  lang python
  file quota_notify.py
  reject VYQL-INJ-008
  code
  ```
  import sys
  from jinja2 import Template
  import redis

  def render(client, username):
    r = client
    if len(sys.argv) > 2:
      r = redis.StrictRedis(host='redis', port=6379, db=0)
    template = Template(r.get('QW_HTML'))
    return template.render(username=username)
  ```

test "rank1354: two constructors agreeing on their type do type the merged client"
  lang python
  file quota_notify.py
  expect VYQL-INJ-008
  code
  ```
  import sys
  from jinja2 import Template
  import redis

  username = str(sys.argv[1])

  if len(sys.argv) > 2:
    r = redis.StrictRedis(host='primary', port=6379, db=0)
  else:
    r = redis.Redis(host='replica', port=6379, db=0)

  template = Template(r.get('QW_HTML'))
  html = template.render(username=username)
  ```

test "rank1354: a supertype-declared Writer assigned in a loop still reaches its response sink"
  lang java
  file src/main/java/servlet/WriteName.java
  expect VYQL-INJ-004
  code
  ```
  package servlet;

  import java.io.IOException;
  import java.io.Writer;
  import javax.servlet.http.HttpServlet;
  import javax.servlet.http.HttpServletRequest;
  import javax.servlet.http.HttpServletResponse;

  public class WriteName extends HttpServlet {
    protected void doGet(HttpServletRequest req, HttpServletResponse resp) throws IOException {
      Writer w = null;
      while (w == null) {
        w = resp.getWriter();
      }
      w.write(req.getParameter("name"));
    }
  }
  ```

test "rank1354: a supertype-declared Context assigned in a loop still reaches its LDAP sink"
  lang java
  file src/main/java/servlet/LdapLookup.java
  expect VYQL-INJ-005
  code
  ```
  package servlet;

  import java.util.Hashtable;
  import javax.naming.Context;
  import javax.naming.directory.DirContext;
  import javax.naming.directory.InitialDirContext;
  import javax.naming.directory.SearchControls;
  import javax.servlet.http.HttpServlet;
  import javax.servlet.http.HttpServletRequest;
  import javax.servlet.http.HttpServletResponse;

  public class LdapLookup extends HttpServlet {
    protected void doGet(HttpServletRequest req, HttpServletResponse resp) throws Exception {
      String user = req.getParameter("user");
      Hashtable<String, String> env = new Hashtable<String, String>();
      Context ctx = null;
      for (int i = 0; i < 3; i++) {
        ctx = new InitialDirContext(env);
      }
      ((DirContext) ctx).search("ou=people", "(uid=" + user + ")", new SearchControls());
    }
  }
  ```

test "rank1354: a mutator writing back into the merged client does not withhold its type"
  lang python
  file quota_notify.py
  expect VYQL-INJ-008
  code
  ```
  import sys
  import time
  from jinja2 import Template
  import redis

  username = str(sys.argv[1])

  while True:
    try:
      r = redis.StrictRedis(host='redis', port=6379, db=0)
      r.ping()
    except Exception as ex:
      time.sleep(3)
    else:
      break

  r.set('last_notify', 'fixed-literal')
  r.expire('last_notify', 60)

  template = Template(r.get('QW_HTML'))
  html = template.render(username=username)
  ```
