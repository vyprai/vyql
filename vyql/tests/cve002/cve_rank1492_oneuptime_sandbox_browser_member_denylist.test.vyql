test "rank1492: a compiled script run through runInNewContext carries the same incomplete denylist"
  lang javascript
  file src/worker/sandbox.js
  expect VYQL-INJ-271
  expect_review code.SandboxHostObjectMemberDenylistGap
  code
  ```
  const { Script } = require('node:vm');

  const denied = new Set(['browserType', 'launch', 'launchPersistentContext', 'newCDPSession']);

  function guard(host) {
    return new Proxy(host, {
      get(target, prop) {
        if (denied.has(prop)) {
          return undefined;
        }
        return guard(Reflect.get(target, prop, target));
      },
    });
  }

  module.exports = function run(source, page, timeout) {
    const script = new Script(source);
    return script.runInNewContext({ page: guard(page) }, { timeout });
  };
  ```

test "rank1492: a Playwright launcher that runs no sandboxed script is not a sandbox facade"
  lang javascript
  file src/browser/launcher.js
  reject VYQL-INJ-271
  reject_review code.SandboxHostObjectMemberDenylistGap
  code
  ```
  // Ordinary browser-pool code. It names "browserType" and "launch" because that
  // is the API it drives, and it reads properties reflectively off a config
  // object, but nothing here runs author-supplied script against the result.
  const { chromium } = require('playwright');

  const SUPPORTED = new Set(['browserType', 'launch']);

  function readOption(config, prop) {
    if (!SUPPORTED.has(prop)) {
      return undefined;
    }
    return Reflect.get(config, prop, config);
  }

  async function open(config) {
    return chromium.launch({ headless: readOption(config, 'launch') !== false });
  }

  module.exports = { open, readOption };
  ```
