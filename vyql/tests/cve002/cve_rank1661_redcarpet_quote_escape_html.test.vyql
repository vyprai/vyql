# Rank 1661 / CVE-2020-26298: redcarpet's HTML renderer emitted the quoted
# span of the :quote extension raw, ignoring the :escape_html option. The
# extension's parser, char_quote in ext/redcarpet/markdown.c, hands the
# renderer callback a struct buf over the raw document bytes (data + f_begin
# to f_end) with no intervening parse_inline, so the span never reaches
# rndr_normal_text -- the only callback that consults HTML_ESCAPE when
# escaping literal text. rndr_quote in ext/redcarpet/html.c then writes it
# with bufput between <q> and </q>, so markup such as
# "<svg/onload=pwned>" inside "..." reached the page unescaped even with
# :escape_html enabled (cross-site scripting, CWE-79). The fixed revision reads the
# render options and routes the span through escape_html when
# HTML_ESCAPE is set. The gem is Ruby but the defect and its fix live in
# the C extension; the remediation is present at a699c822 and absent at
# its parent 6270d6b (v3.5.0).
#
# ATTENTION, engine gap. The source, the sink and the rule all work today;
# what is missing is the two function-pointer hops the document takes
# between them.
#
#   * Source: sd_markdown_render's document parameter is a library entry
#     point and is labelled code.ExternalEntryInput (library.param-source,
#     under the library profile the repository resolves to). On the
#     vulnerable checkout 178 of the 334 findings start there, and taint
#     walks parse_block -> parse_inline and its helpers (parse_atxheader,
#     is_ref, check_domain, autolink_delim all appear in taint paths).
#   * Sink: fwrite/fputs are bound to code.HtmlRender in C, escape_html to
#     core.HtmlEscape (htmlEscape197), and VYQL-INJ-004 fires on the pair.
#   * The path then dies twice at a call the engine cannot route:
#     markdown.c:492 dispatches the character handler through an array of
#     function pointers -- end = markdown_char_ptrs[(int)action](ob, rndr,
#     data + i, ...) -- and char_quote hands the span on through a struct
#     field of callbacks -- rndr->cb.quote(ob, &work, rndr->opaque).
#     `vyql resolve` on markdown.c reports 380 unresolved sites, "taint
#     terminates"; no taint path in the real scan reaches any rndr_* body
#     in html.c.
#
# The first three tests are the isolating pair: the identical callback,
# source and sink report when the callback is invoked directly and fall
# silent when the same call goes through a struct field of function
# pointers or an array of them. This is the C instance of the
# registered-handler dispatch already on file for C++ at rank 1714 (the
# (*target->handler)(...) form) and for Go/JavaScript at rank 1485; the
# two forms measured here -- `cb->quote(...)` and `table[i](...)` -- are
# the spellings a C callback table actually takes, and the table form is
# the front half of this path. Not mechanical: routing an indirect call to
# its statically-known target is a new dataflow relation, not a correction
# to a known construct. 29,350 `(*f)(...)` sites across the corpus clones'
# 4,624 C/C++ files sit behind it.
#
# A second, independent blocker sits at the write itself: bufput is the
# project's own buffer append (buffer.c), used to build intermediate work
# buffers in markdown.c as well as final HTML, so binding it to
# code.HtmlRender fails the genericity test -- it is not answerable to any
# API documentation, only to this defect. Naming it would fire on every
# bufput in the tree, HTML or not. Detection therefore needs the dispatch
# relation first and a defensible sink for a library-internal HTML write
# second.
#
# A presence route was measured at the first pass and stays
# unshippable: 19 renderer callbacks at 6270d6b write a content parameter
# between tag literals with no escape in their own body (rndr_quote,
# rndr_emphasis, rndr_double_emphasis, rndr_strikethrough, rndr_underline,
# rndr_highlight, rndr_blockquote, rndr_header, rndr_paragraph, rndr_list,
# rndr_listitem, rndr_table, rndr_tablerow, rndr_tablecell,
# rndr_superscript, rndr_triple_emphasis, rndr_footnotes, rndr_footnote_def,
# rndr_raw_block) and the fix clears exactly one of them; the other 18
# receive content that parse_inline routes through rndr_normal_text or
# fully rendered child output, so a shape-keyed emission scores 19 against
# 18 across the pair -- inside the +/-2 run noise, with 18 false positives
# on the CVE's own file. The discriminator is which spans the parser
# leaves unparsed, and that fact lives in markdown.c behind the same
# indirect calls.
#
# On the real vulnerable checkout the full scan reports 334 findings and
# 768 review flags with an identical rule histogram at both revisions
# (three --cache off runs each); the only VYQL-INJ-004 rows sit in
# test/test_helper.rb, and no review flag of any category lands in
# ext/redcarpet/. Measured collateral for the direct half of the pair:
# none -- it is a synthetic snippet.
#
# verify_current_expected: attention-engine-gap, both revisions rejected.

test "rank1661: a document parameter reaching an HTML write through a direct callback call"
  lang c
  file quote_direct.c
  profile library
  expect VYQL-INJ-004
  code
  ```
  #include <stdint.h>
  #include <stddef.h>
  #include <stdio.h>

  struct buf {
    uint8_t *data;
    size_t size;
  };

  static int
  rndr_quote(struct buf *ob, const struct buf *text, void *opaque)
  {
    if (!text || !text->size)
      return 0;

    fwrite(text->data, 1, text->size, stdout);

    return 1;
  }

  void
  sdhtml_render(const uint8_t *document, size_t doc_size)
  {
    struct buf work = { (uint8_t *)document, doc_size, 0, 0 };

    rndr_quote(0, &work, 0);
  }
  ```

test "rank1661: the same callback invoked through a struct field of function pointers"
  lang c
  file quote_callbacks.c
  profile library
  reject VYQL-INJ-004
  code
  ```
  #include <stdint.h>
  #include <stddef.h>
  #include <stdio.h>

  struct buf {
    uint8_t *data;
    size_t size;
  };

  struct sd_callbacks {
    int (*quote)(struct buf *ob, const struct buf *text, void *opaque);
  };

  static int
  rndr_quote(struct buf *ob, const struct buf *text, void *opaque)
  {
    if (!text || !text->size)
      return 0;

    fwrite(text->data, 1, text->size, stdout);

    return 1;
  }

  void
  sd_markdown_render(struct sd_callbacks *cb, const uint8_t *document, size_t doc_size)
  {
    struct buf work = { (uint8_t *)document, doc_size, 0, 0 };

    cb->quote(0, &work, 0);
  }
  ```

test "rank1661: the same callback invoked through an array of function pointers"
  lang c
  file quote_table.c
  profile library
  reject VYQL-INJ-004
  code
  ```
  #include <stdint.h>
  #include <stddef.h>
  #include <stdio.h>

  struct buf {
    uint8_t *data;
    size_t size;
  };

  struct sd_callbacks {
    int (*quote)(struct buf *ob, const struct buf *text, void *opaque);
  };

  struct sd_markdown {
    struct sd_callbacks cb;
  };

  typedef size_t (*char_trigger)(struct buf *ob, struct sd_markdown *rndr,
                                 uint8_t *data, size_t offset, size_t size);

  static int
  rndr_quote(struct buf *ob, const struct buf *text, void *opaque)
  {
    if (!text || !text->size)
      return 0;

    fwrite(text->data, 1, text->size, stdout);

    return 1;
  }

  static size_t
  char_quote(struct buf *ob, struct sd_markdown *rndr, uint8_t *data,
             size_t offset, size_t size)
  {
    struct buf work = { data, size, 0, 0 };

    rndr->cb.quote(ob, &work, rndr);

    return size;
  }

  static char_trigger markdown_char_ptrs[] = {
    0,
    char_quote
  };

  void
  sd_markdown_render(struct sd_markdown *rndr, const uint8_t *document,
                     size_t doc_size, unsigned int action)
  {
    markdown_char_ptrs[action](0, rndr, (uint8_t *)document, 0, doc_size);
  }
  ```

test "rank1661: the quote renderer emits its span raw regardless of the escape option"
  lang c
  file ext/redcarpet/html.c
  reject VYQL-INJ-004
  code
  ```
  #include <stdint.h>
  #include <stddef.h>

  struct buf {
    uint8_t *data;
    size_t size;
  };

  #define BUFPUTSL(output, literal) bufput(output, literal, sizeof(literal) - 1)

  void bufput(struct buf *, const uint8_t *, size_t);

  static int
  rndr_quote(struct buf *ob, const struct buf *text, void *opaque)
  {
    if (!text || !text->size)
      return 0;

    BUFPUTSL(ob, "<q>");
    bufput(ob, text->data, text->size);
    BUFPUTSL(ob, "</q>");

    return 1;
  }
  ```

test "rank1661: the fixed revision escapes the span when the escape option is set"
  lang c
  file ext/redcarpet/html.c
  reject VYQL-INJ-004
  code
  ```
  #include <stdint.h>
  #include <stddef.h>

  struct buf {
    uint8_t *data;
    size_t size;
  };

  struct html_renderopt {
    unsigned int flags;
  };

  #define HTML_ESCAPE (1 << 3)
  #define BUFPUTSL(output, literal) bufput(output, literal, sizeof(literal) - 1)

  void bufput(struct buf *, const uint8_t *, size_t);
  void escape_html(struct buf *, const uint8_t *, size_t);

  static int
  rndr_quote(struct buf *ob, const struct buf *text, void *opaque)
  {
    if (!text || !text->size)
      return 0;

    struct html_renderopt *options = opaque;

    BUFPUTSL(ob, "<q>");

    if (options->flags & HTML_ESCAPE)
      escape_html(ob, text->data, text->size);
    else
      bufput(ob, text->data, text->size);

    BUFPUTSL(ob, "</q>");

    return 1;
  }
  ```
