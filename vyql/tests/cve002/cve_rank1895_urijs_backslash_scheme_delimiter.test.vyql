  lang javascript
  file src/URI.js
  expect VYQL-RF-053
  expect_review code.UrlAuthoritySplitWithoutBackslashNormalization
  code
  ```
  var URI = function() {};

  URI.parse = function(string, parts) {
    var pos = string.indexOf('?');
    if (pos > -1) {
      parts.query = string.substring(pos + 1) || null;
      string = string.substring(0, pos);
    }

    if (string.substring(0, 2) === '//') {
      parts.protocol = null;
      string = URI.parseAuthority(string.substring(2), parts);
    } else {
      pos = string.indexOf(':');
      if (pos > -1) {
        parts.protocol = string.substring(0, pos) || null;
        if (string.substring(pos + 1, pos + 3) === '//') {
          string = URI.parseAuthority(string.substring(pos + 3), parts);
        } else {
          string = string.substring(pos + 1);
          parts.urn = true;
        }
      }
    }

    parts.path = string;
    return parts;
  };

  // no backslash handling at all: the host is split off the raw string
  URI.parseHost = function(string, parts) {
    var pos = string.indexOf('/');
    if (pos === -1) {
      pos = string.length;
    }

    var t = string.substring(0, pos).split(':');
    parts.hostname = t[0] || null;
    parts.port = t[1] || null;
    return parts;
  };

  URI.parseAuthority = function(string, parts) {
    var pos = string.indexOf('@');
    if (pos > -1) {
      parts.username = string.substring(0, pos) || null;
      string = string.substring(pos + 1);
    }
    return URI.parseHost(string, parts);
  };

  // accessor table: the component names reach the module as string literals
  var p = URI.prototype;
  p.protocol = generateSimpleAccessor('protocol');
  p.username = generateSimpleAccessor('username');
  p.password = generateSimpleAccessor('password');
  p.hostname = generateSimpleAccessor('hostname');
  p.port = generateSimpleAccessor('port');
  p.pathname = generateAccessor('pathname', p.pathname);

  function generateSimpleAccessor(key) {
    return function(value) {
      if (value === undefined) {
        return this._parts[key] || null;
      }
      this._parts[key] = value || null;
      return this;
    };
  }

  function generateAccessor(key, fn) {
    return function(value) {
      var result = fn.call(this, value);
      return result === undefined ? this._parts[key] : result;
    };
  }

  return URI;
  ```

