# Rank 1137 / CVE-2026-35392: goshs's PUT-upload handler built the save path
# by string concatenation directly from the request URL with no cleaning or
# containment check at all, so an unauthenticated `PUT /../../etc/cron.d/x`
# style request wrote a file anywhere the process could reach (CWE-22).
#
# put() in httpserver/updown.go split req.URL.Path on "/" and rejoined it
# with fs.UploadFolder via fmt.Sprintf, with no filepath.Clean, no `..`
# rejection and no check that the result stayed under UploadFolder.
#
# The pool commit was a version-bump ("New version v2.0.1") that already
# contained sanitizePath; the actual introduction is earlier. Corpus
# correction, in place: pool.tsv now names
# 237f3af891a90df9b903b85f1cd3438040ca261a (COMMIT_OK once corrected), found
# by walking updown.go's commit history for where sanitizePath was
# introduced; its diff matches the advisory's vulnerable-code excerpt
# byte-for-byte. It adds a `sanitizePath(root, requestPath)` helper that
# URL-decodes, filepath.Cleans, filepath.Joins against root, and returns an
# error unless the result equals root or starts with root plus a path
# separator, and routes put()'s savepath and upload()'s targetDir through it.
# No further pool correction.
#
# CAUGHT. VYQL-PATH-001 reports the vulnerable put(), and reports nothing
# once sanitizePath's Clean+Join+HasPrefix containment check gates savepath,
# confirmed on put() and sanitizePath isolated together. Scanning the real
# 262-line updown.go at both revisions still reports the same count of
# VYQL-PATH-001 findings either side of this commit; that count is not this
# rank's finding persisting; put() and sanitizePath in isolation prove that
# one disappears cleanly. The file has several other handlers,
# bulkDownload, GetDiffPreview's sibling and delete, this commit does not
# touch, and their own FilePathAccess sinks hold the total steady while
# put()'s finding drops out from underneath it -- worth a look on its own,
# but not evidence against this rank's fix.
#
# verify_current_expected: current-behavior

test "rank1137: the save path is built by raw string concatenation"
  lang go
  file updown.go
  expect VYQL-PATH-001
  code
  ```
  package httpserver

  import (
      "fmt"
      "net/http"
      "os"
      "strings"
  )

  func (fs *FileServer) put(w http.ResponseWriter, req *http.Request) {
      upath := req.URL.Path

      filename := strings.Split(upath, "/")
      outName := filename[len(filename)-1]

      targetpath := strings.Split(upath, "/")
      targetpath = targetpath[:len(targetpath)-1]
      target := strings.Join(targetpath, "/")

      savepath := fmt.Sprintf("%s%s/%s", fs.UploadFolder, target, outName)

      osFile, err := os.OpenFile(savepath, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, 0644)
      if err != nil {
          return
      }
      defer osFile.Close()
  }
  ```

test "rank1137: the save path is resolved and checked against the upload root"
  lang go
  file updown.go
  reject VYQL-PATH-001
  code
  ```
  package httpserver

  import (
      "fmt"
      "net/http"
      "net/url"
      "os"
      "path/filepath"
      "strings"
  )

  func sanitizePath(root, requestPath string) (string, error) {
      decoded, err := url.QueryUnescape(requestPath)
      if err != nil {
          decoded = requestPath
      }
      clean := filepath.Clean("/" + strings.TrimLeft(decoded, "/"))
      abs := filepath.Join(root, clean)
      rootClean := filepath.Clean(root)
      if abs != rootClean && !strings.HasPrefix(abs, rootClean+string(filepath.Separator)) {
          return "", fmt.Errorf("path escapes root: %q", requestPath)
      }
      return abs, nil
  }

  func (fs *FileServer) put(w http.ResponseWriter, req *http.Request) {
      savepath, err := sanitizePath(fs.UploadFolder, req.URL.Path)
      if err != nil {
          return
      }

      osFile, err := os.OpenFile(savepath, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, 0644)
      if err != nil {
          return
      }
      defer osFile.Close()
  }
  ```
