# Rank 1043 / CVE-2024-5982: ChuanhuChatGPT copied an uploaded history file to a
# path built from the upload's own name, with no check that the source sits
# inside the history directory (CWE-22). load_chat_history in
# modules/models/base_model.py did
#
#   new_history_file_path = new_history_file_path.name
#   shutil.copyfile(
#       new_history_file_path,
#       os.path.join(HISTORY_DIR, self.user_name,
#                    os.path.basename(new_history_file_path)))
#
# so the read side takes whatever path the upload names. The fixed revision adds
# two realpath/startswith assertions and an auth_list membership check.
#
# ATTENTION, and the finding is narrow: everything except the source works. The
# first snippet proves the chain end to end with an ordinary request parameter as
# the source, reporting VYQL-PATH-001 at high with the taint path running through
# the method parameter into the copy, and both `unless` clauses correctly
# unsatisfied. The sink is labelled in the real file too, code.FilePathAccess
# on the copyfile, as are the os.path.basename controls around it.
#
# What is missing is the source. The upload arrives through Gradio, wired as
# uploadFileBtn.upload(upload_chat_history, [current_model, uploadFileBtn], ...),
# so the tainted value is a parameter of a callback passed by reference to a
# framework. Gradio has zero bindings, and making every Gradio handler parameter
# an input would add sources across every Gradio application at once, which is
# the same unmeasurable step recorded at rank 1035 for the Nextcloud AppFramework.
# Only one Gradio application is available here, so the precision cost cannot be
# measured. Scanning the real file reports nothing at either revision.
#
# Worth a later rank, and separate from this CVE: the fixed revision's own guard is bare
# prefix containment. os.path.realpath(t).startswith(os.path.realpath(HISTORY_DIR))
# accepts a sibling directory sharing the prefix, so the last snippet still
# reports and that is correct rather than a false positive. The Python
# core.PathAccessCheck binding declines it deliberately, requiring os.sep in the
# argument. But code.CanonicalPathStringPrefixContainment, which is exactly this
# weakness, is bound only for Java's getCanonicalPath().startsWith, so the Python
# form is neither accepted as a control nor reported as the weakness it is. That
# is a binding rather than engine work, so it is not in ENGINE-GAPS.md.
#
# verify_current_expected: attention-source-gap

test "rank1043: the chain reports when the uploaded path comes from a request"
  lang python
  file modules/models/base_model.py
  expect VYQL-PATH-001
  code
  ```
  import os
  import shutil

  HISTORY_DIR = "/data/history"


  class Model:
      def __init__(self, user_name):
          self.user_name = user_name

      def load_chat_history(self, new_history_file_path=None):
          if new_history_file_path is not None:
              if type(new_history_file_path) != str:
                  new_history_file_path = new_history_file_path.name
                  shutil.copyfile(
                      new_history_file_path,
                      os.path.join(
                          HISTORY_DIR,
                          self.user_name,
                          os.path.basename(new_history_file_path),
                      ),
                  )


  def handler(request):
      uploaded = request.args.get("file")
      Model("bob").load_chat_history(uploaded)
  ```

test "rank1043: the same copy is silent when the upload arrives through the framework"
  lang python
  file modules/models/base_model.py
  reject VYQL-PATH-001
  code
  ```
  import os
  import shutil

  import gradio as gr

  HISTORY_DIR = "/data/history"


  class Model:
      def __init__(self, user_name):
          self.user_name = user_name

      def load_chat_history(self, new_history_file_path=None):
          if new_history_file_path is not None:
              if type(new_history_file_path) != str:
                  new_history_file_path = new_history_file_path.name
                  shutil.copyfile(
                      new_history_file_path,
                      os.path.join(
                          HISTORY_DIR,
                          self.user_name,
                          os.path.basename(new_history_file_path),
                      ),
                  )


  def upload_chat_history(current_model, new_history_file_path):
      return current_model.load_chat_history(new_history_file_path)


  with gr.Blocks() as demo:
      uploadFileBtn = gr.UploadButton("upload", file_types=[".json"])
      current_model = gr.State()
      uploadFileBtn.upload(upload_chat_history, [current_model, uploadFileBtn], [])
  ```

test "rank1043: the fixed revision's prefix containment is not a control, and reporting it is right"
  lang python
  file modules/models/base_model.py
  expect VYQL-PATH-001
  code
  ```
  import os
  import shutil

  HISTORY_DIR = "/data/history"


  class Model:
      def __init__(self, user_name):
          self.user_name = user_name

      def load_chat_history(self, new_history_file_path=None):
          if new_history_file_path is not None:
              if type(new_history_file_path) != str:
                  new_history_file_path = new_history_file_path.name
                  target_path = os.path.join(HISTORY_DIR, self.user_name, new_history_file_path)
                  assert os.path.realpath(new_history_file_path).startswith(os.path.realpath(HISTORY_DIR))
                  assert os.path.realpath(target_path).startswith(os.path.realpath(HISTORY_DIR))
                  shutil.copyfile(
                      new_history_file_path,
                      os.path.join(
                          HISTORY_DIR,
                          self.user_name,
                          os.path.basename(new_history_file_path),
                      ),
                  )


  def handler(request):
      uploaded = request.args.get("file")
      Model("bob").load_chat_history(uploaded)
  ```
