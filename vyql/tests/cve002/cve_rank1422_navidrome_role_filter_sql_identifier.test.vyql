test "rank1422: an ordered-list allowlist on the identifier is not reported either"
  lang go
  file store/query.go
  reject VYQL-INJ-152
  reject_review code.UnvalidatedSqlIdentifierInterpolation
  code
  ```
  package store

  import (
  	"fmt"
  	"slices"

  	sq "github.com/Masterminds/squirrel"
  )

  var sortableColumns = []string{"name", "created_at", "size"}

  func byColumn(column string, value any) sq.Sqlizer {
  	if !slices.Contains(sortableColumns, column) {
  		return sq.Eq{"1": 2}
  	}
  	return sq.Eq{fmt.Sprintf("track.%s", column): value}
  }
  ```
  file go.mod
  code
  ```
  module example.com/store

  go 1.24

  require (
      github.com/Masterminds/squirrel v1.5.4
  )
  ```

test "rank1422: a table identifier formatted into a condition key in unrelated code is the same weakness"
  lang go
  file server/sqlstore/playbook_run.go
  expect VYQL-INJ-152
  expect_review code.UnvalidatedSqlIdentifierInterpolation
  code
  ```
  package sqlstore

  import (
  	"fmt"

  	sq "github.com/Masterminds/squirrel"
  )

  func buildTeamLimitExpr(userID, teamID, tableName string) sq.Sqlizer {
  	filterToSelectedTeam := sq.Eq{fmt.Sprintf("%s.TeamID", tableName): teamID}
  	onlyTeamsUserIsAMember := sq.Expr(fmt.Sprintf(`
  		EXISTS(SELECT 1 FROM TeamMembers as tm
  			WHERE tm.TeamId = %s.TeamID AND tm.DeleteAt = 0 AND tm.UserId = ?)
  		`, tableName), userID)
  	if teamID != "" {
  		return filterToSelectedTeam
  	}
  	return onlyTeamsUserIsAMember
  }
  ```
  file go.mod
  code
  ```
  module github.com/mattermost/mattermost-plugin-playbooks

  go 1.24

  require (
      github.com/Masterminds/squirrel v1.5.4
  )
  ```

test "rank1422: a formatted map key with no condition-map type in scope is not a SQL identifier"
  lang go
  file internal/labels/labels.go
  reject VYQL-INJ-152
  reject_review code.UnvalidatedSqlIdentifierInterpolation
  code
  ```
  package labels

  import (
  	"fmt"
  	"strings"
  )

  func describe(kind, name string) map[string]string {
  	out := map[string]string{fmt.Sprintf("%s/%s", kind, name): name}
  	if strings.EqualFold(kind, "artist") {
  		out["kind"] = "artist"
  	}
  	return out
  }
  ```
  file go.mod
  code
  ```
  module example.com/labels

  go 1.24

  require (
      github.com/Masterminds/squirrel v1.5.4
  )
  ```

test "rank1422: a driver identifier quoter on the interpolated name is not reported"
  lang go
  file store/query.go
  reject VYQL-INJ-152
  reject_review code.UnvalidatedSqlIdentifierInterpolation
  code
  ```
  package store

  import (
  	"fmt"

  	"github.com/lib/pq"
  	sq "github.com/Masterminds/squirrel"
  )

  func byColumn(column string, value any) sq.Sqlizer {
  	return sq.Eq{fmt.Sprintf("track.%s", pq.QuoteIdentifier(column)): value}
  }
  ```
