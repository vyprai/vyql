# Rank 1736 / CVE-2023-34478: Shiro's InvalidRequestFilter screened the
# request URI for semicolon, backslash and non-ASCII sequences but performed
# no dot-segment or encoded dot/slash check, so traversal sequences reached
# Spring Boot's nested-JAR resource resolution.

test "rank1736: request URI character screen without a traversal check"
  lang java
  file InvalidRequestFilter.java
  expect VYQL-PATH-041
  expect_review code.IncompleteDotSegmentRequestScreen
  code
  ```
  import javax.servlet.http.HttpServletRequest;
  import java.util.Arrays;
  import java.util.Collections;
  import java.util.List;

  public class InvalidRequestFilter {

      private static final List<String> SEMICOLON = Collections.unmodifiableList(Arrays.asList(";", "%3b", "%3B"));

      private static final List<String> BACKSLASH = Collections.unmodifiableList(Arrays.asList("\\", "%5c", "%5C"));

      protected boolean isAccessAllowed(HttpServletRequest request) {
          // check the original and decoded values
          return isValid(request.getRequestURI())      // user request string (not decoded)
                  && isValid(request.getServletPath()) // decoded servlet part
                  && isValid(request.getPathInfo());   // decoded path info (may be null)
      }

      private boolean isValid(String uri) {
          return uri == null
                 || (!containsSemicolon(uri)
                   && !containsBackslash(uri)
                   && !containsNonAsciiCharacters(uri));
      }

      private boolean containsSemicolon(String uri) {
          return SEMICOLON.stream().anyMatch(uri::contains);
      }

      private boolean containsBackslash(String uri) {
          return BACKSLASH.stream().anyMatch(uri::contains);
      }

      private boolean containsNonAsciiCharacters(String uri) {
          int length = uri.length();
          for (int i = 0; i < length; i++) {
              char c = uri.charAt(i);
              if (c < ' ' || c > '~') {
                  return true;
              }
          }
          return false;
      }
  }
  ```

test "rank1736: screen with a traversal check rejects dot and encoded separator sequences"
  lang java
  file InvalidRequestFilter.java
  reject VYQL-PATH-041
  reject_review code.IncompleteDotSegmentRequestScreen
  code
  ```
  import javax.servlet.http.HttpServletRequest;
  import java.util.Arrays;
  import java.util.Collections;
  import java.util.List;

  public class InvalidRequestFilter {

      private static final List<String> SEMICOLON = Collections.unmodifiableList(Arrays.asList(";", "%3b", "%3B"));

      private static final List<String> BACKSLASH = Collections.unmodifiableList(Arrays.asList("\\", "%5c", "%5C"));

      private static final List<String> FORWARDSLASH = Collections.unmodifiableList(Arrays.asList("%2f", "%2F"));

      private static final List<String> PERIOD = Collections.unmodifiableList(Arrays.asList("%2e", "%2E"));

      protected boolean isAccessAllowed(HttpServletRequest request) {
          // check the original and decoded values
          return isValid(request.getRequestURI())      // user request string (not decoded)
                  && isValid(request.getServletPath()) // decoded servlet part
                  && isValid(request.getPathInfo());   // decoded path info (may be null)
      }

      private boolean isValid(String uri) {
          return uri == null
                 || (!containsSemicolon(uri)
                   && !containsBackslash(uri)
                   && !containsNonAsciiCharacters(uri)
                   && !containsTraversal(uri));
      }

      private boolean containsTraversal(String uri) {
          return !(isNormalized(uri)
                  && PERIOD.stream().noneMatch(uri::contains)
                  && FORWARDSLASH.stream().noneMatch(uri::contains));
      }

      private boolean isNormalized(String path) {
          if (path == null) {
              return true;
          }
          for (int i = path.length(); i > 0;) {
              int slashIndex = path.lastIndexOf('/', i - 1);
              int gap = i - slashIndex;
              if (gap == 2 && path.charAt(slashIndex + 1) == '.') {
                  return false; // ".", "/./" or "/."
              }
              if (gap == 3 && path.charAt(slashIndex + 1) == '.' && path.charAt(slashIndex + 2) == '.') {
                  return false;
              }
              i = slashIndex;
          }
          return true;
      }

      private boolean containsSemicolon(String uri) {
          return SEMICOLON.stream().anyMatch(uri::contains);
      }

      private boolean containsBackslash(String uri) {
          return BACKSLASH.stream().anyMatch(uri::contains);
      }

      private boolean containsNonAsciiCharacters(String uri) {
          int length = uri.length();
          for (int i = 0; i < length; i++) {
              char c = uri.charAt(i);
              if (c < ' ' || c > '~') {
                  return true;
              }
          }
          return false;
      }
  }
  ```

test "rank1736: request URI read without a character deny-list is not a screen"
  lang java
  file LoginRedirect.java
  reject VYQL-PATH-041
  code
  ```
  import javax.servlet.http.HttpServletRequest;

  public class LoginRedirect {
      public String target(HttpServletRequest request) {
          String uri = request.getRequestURI();
          if (uri.startsWith("/public/")) {
              return uri;
          }
          return "/index";
      }
  }
  ```
