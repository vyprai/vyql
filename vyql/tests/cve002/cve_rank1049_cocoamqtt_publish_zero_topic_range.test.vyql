# Rank 1049 / CVE-2026-30867: CocoaMQTT crashed on a PUBLISH frame carrying a
# zero-length topic (CWE-617). FramePublish's byte initialiser in
# Source/FramePublish.swift computed
#
#   let len = UInt16(bytes[0]) << 8 + UInt16(bytes[1])
#   var pos = 2 + Int(len)
#   ...
#   if let data = NSString(bytes: [UInt8](bytes[2...(pos-1)]), length: Int(len), ...)
#
# and with len == 0 that closed range is bytes[2...1], a reversed range, which
# traps at runtime. A broker or a network attacker sending one malformed PUBLISH
# terminates the client. The fix 010bca6f61 rejects a zero topic length, switches
# to the half-open bytes[topicStart..<topicEnd], bounds-checks pos against
# bytes.count, and turns every parse failure in the reader into a protocol error
# that disconnects instead of continuing.
#
# ATTENTION, and the gap is that Swift has no range or index analysis at all.
# The frontend carries one analysis feature, analysis.module.context, so there is
# nothing that observes a subscript, a range expression or a bound, and no
# vocabulary describes a reversed range. vyql match on the two files reports no
# source and no sink, only four generic code.ResourceReview marks on the socket
# reads. Both revisions report 0 findings.
#
# This is the Swift-side member of the family already recorded for C at ranks
# 1026, 1032, 1038 and 1045, and it is a separate item rather than the same one:
# the C gap is an index observation that fires only for field-derived indices,
# while here the construct is a closed range whose upper bound is computed as
# lower + n - 1 and n can be zero, and the frontend that would have to observe it
# is a different one with no bound analysis to extend.
#
# verify_current_expected: attention-frontend-gap

test "rank1049: a zero topic length makes the slice range reversed"
  lang swift
  file Source/FramePublish.swift
  reject VYQL-MEM-010
  code
  ```
  extension FramePublish: InitialWithBytes {
      init?(packetFixedHeaderType: UInt8, bytes: [UInt8]) {
          if bytes.count < 2 {
              return nil
          }

          let len = UInt16(bytes[0]) << 8 + UInt16(bytes[1])

          // 2 is packetFixedHeaderType length
          var pos = 2 + Int(len)

          if bytes.count < pos {
              return nil
          }

          if let data = NSString(bytes: [UInt8](bytes[2...(pos-1)]), length: Int(len), encoding: String.Encoding.utf8.rawValue) {
              topic = data as String
          }

          payload = [UInt8](bytes[pos..<bytes.count])
      }
  }
  ```

test "rank1049: fix rejects the empty topic and slices a half-open range"
  lang swift
  file Source/FramePublish.swift
  reject VYQL-MEM-010
  code
  ```
  extension FramePublish: InitialWithBytes {
      init?(packetFixedHeaderType: UInt8, bytes: [UInt8]) {
          if bytes.count < 2 {
              return nil
          }

          let topicLength = Int(UInt16(bytes[0]) << 8 | UInt16(bytes[1]))
          let topicStart = 2
          let topicEnd = topicStart + topicLength

          if bytes.count < topicEnd {
              return nil
          }
          var pos = topicEnd

          guard topicLength > 0 else {
              return nil
          }
          guard let recTopic = String(bytes: bytes[topicStart..<topicEnd], encoding: .utf8) else {
              return nil
          }
          topic = recTopic

          payload = [UInt8](bytes[pos..<bytes.count])
      }
  }
  ```
