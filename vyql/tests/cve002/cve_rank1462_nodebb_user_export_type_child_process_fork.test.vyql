test "rank1462: pinned miss -- the same flow whose function is assigned to a local alias of module.exports"
  lang javascript
  file src/api/users.js
  reject VYQL-INJ-002
  code
  ```
  'use strict';

  const express = require('express');
  const db = require('./database');

  const usersAPI = module.exports;

  usersAPI.generateExport = async function (caller, params) {
  	const uid = params.uid;
  	const type = params.type;

  	const count = await db.incrObjectField('locks', `export:${uid}${type}`);
  	if (count > 1) {
  		throw new Error('[[error:already-exporting]]');
  	}

  	const child = require('child_process').fork(`./src/user/jobs/export-${type}.js`, [], {
  		env: process.env,
  	});
  	child.send({ uid });
  };

  const router = express.Router();

  router.post('/:uid/exports/:type', async (req, res) => {
  	await generateExport(req, req.params);
  	res.sendStatus(202);
  });
  ```
