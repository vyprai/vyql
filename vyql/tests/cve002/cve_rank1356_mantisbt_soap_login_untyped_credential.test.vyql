# Rank 1356 / CVE-2026-30849 (GHSA-phrq-pc6r-f6gh, CWE-305, CVSS 9.3):
# MantisBT's SOAP API funnels every call through mci_check_login() in
# api/soap/mc_api.php, and that function took its two credentials with no type
# declaration at all:
#
#   function mci_check_login( $p_username, $p_password ) {
#       $t_password = ( $p_password === null ) ? '' : $p_password;
#       if( api_token_validate( $p_username, $t_password ) ) {
#           if( auth_attempt_script_login( $p_username ) === false ) { ... }
#       } else {
#           $t_user_id = auth_user_id_from_cookie( $p_password );
#           if( $t_user_id !== false ) {
#               if( auth_attempt_script_login( $p_username ) === false ) { ... }
#           } else {
#               if( auth_attempt_script_login( $p_username, $t_password ) === false ) { ... }
#           }
#       }
#
# A SOAP payload declares its own XML types, so the caller -- not the callee --
# decides what PHP type $p_password arrives as. Send it as an integer and the
# `=== null` normalisation does not apply, api_token_validate() drops out on its
# length check, and the value lands in auth_user_id_from_cookie(), which is
# user_get_id_by_cookie() in core/user_api.php:
#
#   $t_query = 'SELECT * FROM {user} WHERE cookie_string=' . db_param();
#   $t_result = db_query( $t_query, array( $p_cookie_string ) );
#
# The stored cookie_string is a character column, so MySQL compares it to a
# bound integer by casting the column to a number: every non-numeric secret in
# the table becomes 0 and the first row matches. That branch treats a matching
# cookie as proof of identity and calls auth_attempt_script_login( $p_username )
# with the password argument omitted, and that function skips password
# validation entirely when it is handed none:
#
#   if( null !== $t_password ) {
#       if( !auth_does_password_match( $t_user_id, $t_password ) ) { return false; }
#   }
#
# So knowing a username is enough to obtain a session for it over the API. The
# fix, b349e5c890eeda9bd82e7c7e14479853f8a30d9f, does exactly one thing that
# matters: it constrains the parameter types, `?string $p_username, ?string
# $p_password`, so a non-string payload value is coerced at the boundary and can
# never reach the comparison as a number. null stays acceptable because SOAP
# consumers may legitimately omit the password for anonymous login, and the
# `??=` rewrite of the normalisation is cosmetic.
#
# Step 0, `commit?` flag: the pool row's commit 61082fb5bc is "Bump version to
# 2.28.1" -- api/rest/mantisbt_openapi.yaml and core/constant_inc.php, two lines,
# a release bump. The advisory's own reference names the real fix,
# b349e5c890eeda9bd82e7c7e14479853f8a30d9f, "Add type definition to
# mci_check_login()'s params".
#
# FIXED. Nothing was labelled before: `vyql match` over the vulnerable function
# reported no source, no sink and no control, so no rule could judge it, and a
# scan of api/ reported nothing on mc_api.php. What names the weakness is that
# the credential's PHP type is unconstrained where it is spent, so this adds
# code.NonStringCredentialCoercionAuthBypass / VYQL-AUTH-114 for the class: a
# secret authenticated by a database equality lookup whose success then
# authorises a login with no password argument, reached from a parameter carrying
# no scalar type declaration. Any of the documented ways of pinning the type
# clears it -- a scalar type declaration on the parameters, an is_string() guard,
# strval() or settype().
#
# Measured on the real checkout, bounded (timeout 180, --max-ram 6GB,
# --cache off): the whole repository finishes inside the bound -- 509 PHP files,
# 2261 findings -- and VYQL-AUTH-114 appears exactly once in all of it, at
# api/soap/mc_api.php:458, the declaration line of mci_check_login. The same scan
# of the patched revision reports 2260 findings and VYQL-AUTH-114 zero times, so
# the one row is the whole difference between the two trees. core/ on its own,
# 148 PHP files and 520 findings, reports it zero times: the other callers of the
# cookie lookup (auth_is_cookie_string_unique, auth_is_user_authenticated and the
# cookie refresh in core/authentication_api.php) drive no script login, and the
# login primitives themselves -- auth_attempt_login, auth_attempt_script_login,
# auth_does_password_match -- are untyped too but do not authenticate a secret by
# database lookup. Neither benchmark corpus contains a script login of this
# shape, so no score can move.

test "rank1356: soap login spends an untyped credential on a cookie-string lookup"
  lang php
  file api/soap/mc_api.php
  expect VYQL-AUTH-114
  expect_review code.NonStringCredentialCoercionAuthBypass
  code
  ```
  <?php
  function mci_check_login( $p_username, $p_password ) {
      static $s_already_called = false;

      if( $s_already_called === true ) {
          return auth_get_current_user_id();
      }

      $s_already_called = true;

      if( mci_is_mantis_offline() ) {
          return false;
      }

      # Must not pass in null password, otherwise, authentication will be by-passed
      # by auth_attempt_script_login().
      $t_password = ( $p_password === null ) ? '' : $p_password;

      if( api_token_validate( $p_username, $t_password ) ) {
          # Token is valid, then login the user without worrying about a password.
          if( auth_attempt_script_login( $p_username ) === false ) {
              return false;
          }
      } else {
          # User cookie
          $t_user_id = auth_user_id_from_cookie( $p_password );
          if( $t_user_id !== false ) {
              # Cookie is valid
              if( auth_attempt_script_login( $p_username ) === false ) {
                  return false;
              }
          } else {
              # Use regular passwords
              if( auth_attempt_script_login( $p_username, $t_password ) === false ) {
                  return false;
              }
          }
      }

      lang_push( lang_get_default() );

      return auth_get_current_user_id();
  }
  ```

test "rank1356: soap login constrains its credential types at the boundary"
  lang php
  file api/soap/mc_api.php
  reject VYQL-AUTH-114
  reject_review code.NonStringCredentialCoercionAuthBypass
  code
  ```
  <?php
  function mci_check_login( ?string $p_username, ?string $p_password ) {
      static $s_already_called = false;

      if( $s_already_called === true ) {
          return auth_get_current_user_id();
      }

      $s_already_called = true;

      if( mci_is_mantis_offline() ) {
          return false;
      }

      $p_username ??= '';

      # Must not pass in null password, otherwise, authentication will be by-passed
      # by auth_attempt_script_login().
      $p_password ??= '';

      if( api_token_validate( $p_username, $p_password ) ) {
          # Token is valid, then login the user without worrying about a password.
          if( auth_attempt_script_login( $p_username ) === false ) {
              return false;
          }
      } else {
          # User cookie
          $t_user_id = auth_user_id_from_cookie( $p_password );
          if( $t_user_id !== false ) {
              # Cookie is valid
              if( auth_attempt_script_login( $p_username ) === false ) {
                  return false;
              }
          } else {
              # Use regular passwords
              if( auth_attempt_script_login( $p_username, $p_password ) === false ) {
                  return false;
              }
          }
      }

      lang_push( lang_get_default() );

      return auth_get_current_user_id();
  }
  ```

test "rank1356: an is_string guard on the credential also pins its type"
  lang php
  file api/soap/mc_api.php
  reject VYQL-AUTH-114
  reject_review code.NonStringCredentialCoercionAuthBypass
  code
  ```
  <?php
  function mci_check_login( $p_username, $p_password ) {
      if( !is_string( $p_username ) || !is_string( $p_password ) ) {
          return false;
      }

      if( api_token_validate( $p_username, $p_password ) ) {
          if( auth_attempt_script_login( $p_username ) === false ) {
              return false;
          }
      } else {
          $t_user_id = auth_user_id_from_cookie( $p_password );
          if( $t_user_id !== false ) {
              if( auth_attempt_script_login( $p_username ) === false ) {
                  return false;
              }
          } else {
              if( auth_attempt_script_login( $p_username, $p_password ) === false ) {
                  return false;
              }
          }
      }

      return auth_get_current_user_id();
  }
  ```

test "rank1356: a cookie-string uniqueness check that drives no login is not this"
  lang php
  file core/authentication_api.php
  reject VYQL-AUTH-114
  reject_review code.NonStringCredentialCoercionAuthBypass
  code
  ```
  <?php
  function auth_is_cookie_string_unique( $p_cookie_string ) {
      return false === user_get_id_by_cookie( $p_cookie_string );
  }

  function auth_is_user_authenticated() {
      $t_cookie_string = auth_get_current_user_cookie( false );
      if( $t_cookie_string === false ) {
          return false;
      }
      return false !== auth_user_id_from_cookie( $t_cookie_string );
  }
  ```
