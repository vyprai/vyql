  let running = true;

  async function eventLoop(dispatch) {
    while (running) {
      const event = await nextEvent();
      if (event == null) continue

      await dispatch(event)
    }
  }
  ```

test "rank1560: a receiver call before the continue advances the cursor"
  lang javascript
  file server/core/lib/activitypub/crawl.ts
  reject VYQL-DOS-050
  code
  ```
  async function crawlItems(items, handler) {
    const it = items.iterator();
    while (it.hasNext()) {
      const item = it.next();
      if (skip(item)) continue

      await handler(item)
    }
  }
  ```

test "rank1560: an update-less for loop has no clause for the restart to run"
  lang javascript
  file server/core/lib/activitypub/crawl.ts
  expect VYQL-DOS-050
  code
  ```
  async function crawlCollectionPage(argUrl, handler) {
    let url = argUrl;

    const firstBody = (await fetchAP(url)).body;

    const limit = ACTIVITY_PUB.FETCH_PAGE_LIMIT;
    let i = 0;
    let nextLink = firstBody.first;
    for (;;) {
      if (i >= limit) break

      if (typeof nextLink === 'string') {
        const remoteHost = new URL(nextLink).host;
        if (remoteHost === WEBSERVER.HOST) continue

        url = nextLink;
        nextLink = (await fetchAP(url)).body.next;
      } else {
        nextLink = nextLink.next
      }

      i++
    }
  }
  ```

test "rank1560: an augmented assignment advances the budget like an increment"
  lang javascript
  file server/core/lib/activitypub/crawl.ts
  expect VYQL-DOS-050
  code
  ```
  async function crawlCollectionPage(argUrl, handler) {
    const firstBody = (await fetchAP(argUrl)).body;

    const limit = ACTIVITY_PUB.FETCH_PAGE_LIMIT;
    let i = 0;
    let nextLink = firstBody.first;
    while (nextLink && i < limit) {
      if (typeof nextLink === 'string' && new URL(nextLink).host === WEBSERVER.HOST) continue

      nextLink = nextLink.next
      i += 1
    }
  }
  ```

test "rank1560: a sibling branch's progress does not cover its own restart"
  lang javascript
  file server/core/lib/activitypub/crawl.ts
  expect VYQL-DOS-050
  code
  ```
  async function crawlCollectionPage(argUrl, handler) {
    const firstBody = (await fetchAP(argUrl)).body;

    const limit = ACTIVITY_PUB.FETCH_PAGE_LIMIT;
    let i = 0;
    let nextLink = firstBody.first;
    while (nextLink && i < limit) {
      if (nextLink === firstBody.first) { i += 1; continue }

      if (new URL(nextLink).host === WEBSERVER.HOST) continue

      nextLink = nextLink.next
      i++
    }
  }
  ```

test "rank1560: a closure the function defines can carry the loop's progress"
  lang javascript
  file server/core/lib/activitypub/crawl.ts
  reject VYQL-DOS-050
  code
  ```
  async function crawlCollectionPage(argUrl, handler) {
    const queue = [argUrl];

    function getArg() {
      const arg = queue.shift();
      return arg
    }

    while (queue.length) {
      const arg = getArg();
      if (new URL(arg).host === WEBSERVER.HOST) continue

      await fetchAP(arg)
    }
  }
  ```

test "rank1560: progress inside a callback argument is the callee's contract"
  lang javascript
  file server/core/lib/activitypub/crawl.ts
  reject VYQL-DOS-050
  code
  ```
  async function crawlCollectionPage(argUrl, handler) {
    let src = argUrl;

    while (src) {
      if (handlers.some((h) => {
        const token = h(src);
        src = src.substring(token.raw.length);
        return token != null
      })) continue

      await fetchAP(src)
    }
  }
  ```
