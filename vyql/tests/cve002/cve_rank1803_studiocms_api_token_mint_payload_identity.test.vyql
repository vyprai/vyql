# withstudiocms/studiocms, CVE-2026-30944 (CWE-639/CWE-863). The dashboard
# API's token-mint handler authenticates the caller, checks only that the
# caller is an editor, and then issues the bearer credential for whichever
# user id the request body carries. `createApiToken` reads its subject from
# `payload.user` -- the decoded request body -- while the authenticated
# principal (`userData.user.id`, from the session's `CurrentUser` context)
# sits unused three lines above; nothing compares the two and nothing compares
# ranks, so an editor mints an owner's API token and uses it against the REST
# API as that owner. The remediation drops the `user` field from the payload
# schema entirely and passes `userData.user.id` to the mint instead; the
# sibling `revokeApiToken` handler gets the same treatment plus an explicit
# `tokenData.userId !== userData.user.id` ownership comparison.
#
# The pool row's commit 9eec9c3b45523b635cfe16d55aa55afabacbebe3 is one commit
# late: it is the child of the fixing change. GHSA-667w-mmh7-mrr4 references
# f4a209fc090c90195e2419fff47b48a46eab7441 ("refactor(api): clean up API
# handlers and remove unnecessary variables for improved security"), and at
# 9eec9c3^ -- which is f4a209f itself -- `createApiToken` mints for
# `userData.user.id`. The corrected pair is f4a209f^ (b4b660a, vulnerable) vs
# f4a209f (remediated).
#
# What fires today, union over three `timeout 180 ./bin/vyql scan --cache off
# --max-ram 6GB` runs per revision: 288 findings / 132 at or above high on
# b4b660a and the identical 288/132 on f4a209f, none of them touching
# apiTokens.ts -- `vyql match` on the handler file reports no source, no sink
# and no control at either revision, so the fix moves nothing the scanner can
# see.
#
# ATTENTION, vocabulary-only, re-measured after the destructuring-parameter
# lowering landed. The engine half of the original blocker is gone: an
# object-pattern parameter now lowers to a positional slot under its first
# bound name with the remaining names assigned from that slot, so the
# handler's `payload` is a real parameter, the body's `user` has an incoming
# edge, and a request field destructured into a signature reports end to end
# wherever a parameter-entry source fires (cases 4, 5 and 7 below). Two
# vocabulary gaps keep the rank a miss.
#
# (a) No source labels the handler's payload parameter. The parameter-entry
# fact a binding would key on records only the lambda's immediate callee --
# `call_path:Effect.fn` with `param_name:payload` -- and carries no trace of
# the enclosing `HttpApiBuilder.group(...).handle(...)` registration, while
# `Effect.fn` is Effect's general function wrapper, used for every service
# function and not only HTTP handlers. A source keyed on the parameter's name
# under `Effect.fn` would label internal message payloads and background-job
# inputs as request input: gating on a bare name in a shared code path. The
# member-path spellings do not help either -- `req.query` is labelled at the
# attribute access itself, so the same field destructured into the signature
# carries no source at all (case 8 against case 4).
# (b) The only consumer of the payload's taint is the mint itself --
# `sdk.REST_API.tokens.new(user, description)` -- and that sink is
# project-internal: `@withstudiocms/sdk`'s REST_API surface, with exactly one
# call site in the corpus. No concept covers issuing a credential for a
# caller-named principal; minting one for this SDK alone would be a concept
# per incident, and the counterweight test -- "did the fix leave an
# API-documented call inside the guarded function" -- is satisfied
# (`sdk.REST_API.tokens.new` stays) but discriminating on it means reading the
# call's first argument, and the frontend emits no call-argument tokens, so
# keying on the argument's name encodes the payload field the fixed revision
# deletes.
#
# verify_current_expected: attention, both revisions pinned as misses. Cases
# 4, 5 and 7 are the reporting halves that prove the parameter-to-leaf flow
# is live; case 6 holds the real framework spelling, which stays dark for
# want of a source, and case 8 the same contrast at the member-path spelling.

test "rank1803: the token-mint handler issuing the credential for the payload's own user id"
  lang javascript
  file packages/studiocms/frontend/pages/studiocms_api/_handlers/dashboard/apiTokens.ts
  reject VYQL-AUTH-002
  reject_review code.ObjectLookupByUserInput
  code
  ```
  import { HttpApiBuilder } from '@effect/platform';
  import { CurrentUser } from '@withstudiocms/api-spec/astro-context';
  import { DashboardAPIError } from '@withstudiocms/api-spec/dashboard';
  import { SDKCore } from '@withstudiocms/sdk';
  import { Effect } from 'effect';

  const developerConfig = { demoMode: false };

  export const ApiTokensHandler = HttpApiBuilder.group(
  	'StudioCMSDashboardApiSpec',
  	'apiTokens',
  	(handlers) =>
  		handlers.handle(
  			'createApiToken',
  			Effect.fn(
  				function* ({ payload: { user, description } }) {
  					if (developerConfig.demoMode !== false) {
  						return yield* new DashboardAPIError({
  							error: 'Demo mode is enabled, this action is not allowed.',
  						});
  					}

  					const [sdk, userData] = yield* Effect.all([SDKCore, CurrentUser]);

  					const isAuthorized = userData.userPermissionLevel.isEditor;

  					if (!userData.isLoggedIn || !isAuthorized) {
  						return yield* new DashboardAPIError({ error: 'Unauthorized' });
  					}

  					const newToken = yield* sdk.REST_API.tokens.new(user, description);

  					return { token: newToken.key };
  				}
  			)
  		)
  );
  ```

test "rank1803: the patched handler minting for the session principal instead"
  lang javascript
  file packages/studiocms/frontend/pages/studiocms_api/_handlers/dashboard/apiTokensPatched.ts
  reject VYQL-AUTH-002
  reject_review code.ObjectLookupByUserInput
  code
  ```
  import { HttpApiBuilder } from '@effect/platform';
  import { CurrentUser } from '@withstudiocms/api-spec/astro-context';
  import { DashboardAPIError } from '@withstudiocms/api-spec/dashboard';
  import { SDKCore } from '@withstudiocms/sdk';
  import { Effect } from 'effect';

  const developerConfig = { demoMode: false };

  export const ApiTokensHandlerPatched = HttpApiBuilder.group(
  	'StudioCMSDashboardApiSpec',
  	'apiTokens',
  	(handlers) =>
  		handlers.handle(
  			'createApiToken',
  			Effect.fn(
  				function* ({ payload: { description } }) {
  					if (developerConfig.demoMode !== false) {
  						return yield* new DashboardAPIError({
  							error: 'Demo mode is enabled, this action is not allowed.',
  						});
  					}

  					const [sdk, userData] = yield* Effect.all([SDKCore, CurrentUser]);

  					const isAuthorized = userData.userPermissionLevel.isEditor;

  					if (!userData.isLoggedIn || !userData.user || !isAuthorized) {
  						return yield* new DashboardAPIError({ error: 'Unauthorized' });
  					}

  					const newToken = yield* sdk.REST_API.tokens.new(userData.user.id, description);

  					return { token: newToken.key };
  				}
  			)
  		)
  );
  ```

test "rank1803: the earlier astro-route spelling, whose taint path is live but whose body reader has no source"
  lang javascript
  file packages/studiocms/frontend/pages/studiocms_api/dashboard/api-tokens.ts
  reject VYQL-AUTH-002
  reject_review code.ObjectLookupByUserInput
  code
  ```
  import { readAPIContextJson } from '@withstudiocms/effect';
  import { SDKCore } from '@withstudiocms/sdk';

  export const POST = (ctx) =>
  	(function* () {
  		const sdk = yield* SDKCore;

  		const userData = ctx.locals.StudioCMS.security?.userSessionData;

  		if (!userData?.isLoggedIn) {
  			return { status: 403, body: 'Unauthorized' };
  		}

  		const isAuthorized = ctx.locals.StudioCMS.security?.userPermissionLevel.isEditor;
  		if (!isAuthorized) {
  			return { status: 403, body: 'Unauthorized' };
  		}

  		const jsonData = yield* readAPIContextJson<{ description: string; user: string }>(ctx);

  		if (!jsonData.user) {
  			return { status: 400, body: 'Invalid form data, user is required' };
  		}

  		const newToken = yield* sdk.REST_API.tokens.new(jsonData.user, jsonData.description);

  		return { token: newToken.key };
  	})();
  ```

