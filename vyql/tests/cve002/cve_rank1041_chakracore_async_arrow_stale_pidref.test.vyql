# Rank 1041 / CVE-2017-0028: ChakraCore's parser left a reference to the `async`
# identifier behind when it backed up to reparse an async arrow function
# (CWE-119). Parser::ParseTerm in lib/Parser/Parse.cpp pushes a PidRef for
# `async` while parsing what may be a call, and when the following token turns
# out to be `=>` it reparses the construct as a lambda. The pushed reference is
# never unwound, so the identifier keeps a binding into scope state the reparse
# has replaced, which is reachable from ordinary script such as
# `class async extends A { constructor() { super(); let Q = async A => { A }; } }`.
#
# The fixed revision records `savedTopAsyncRef = pid->GetTopRef()` before the
# speculative parse and, when the token is `tkDArrow`, pops references with
# RemovePrevPidRef until the stack is back to the saved top.
#
# ATTENTION, and this one is out of reach of every layer rather than blocked on
# one of them. The obligation the code breaks is that a speculative parse must
# unwind whatever it pushed, and the vulnerable code does not acknowledge that
# obligation anywhere: there is no saved value, no restore call and no failure
# path, only an absence. Detecting the absence means holding the invariant of
# ChakraCore's own PidRefStack, which no library documentation supports and which
# is not a weakness class that transfers to a second codebase.
#
# No ENGINE-GAPS.md entry, deliberately. That file lists work a later session can
# pick up, and there is nothing here to pick up: this is not a missing feature
# that other ranks also want, it is one parser's internal protocol. Rank 358
# covered a different ChakraCore memory bug with a frontend analysis feature
# (analysis.chakra.scope_slot_array_unchecked_index), which worked because that
# bug is a missing index guard inside one function. This bug spans a save,
# a reparse and an unwind, so the same approach does not carry over.
#
# Both revisions of the real file report the same 208 findings, every one
# VYQL-MEM-006 at low confidence, and none of them near the reparse.
#
# verify_current_expected: attention-not-expressible

test "rank1041: the speculative async parse leaves its identifier reference behind"
  lang cpp
  file lib/Parser/Parse.cpp
  reject VYQL-MEM-007
  code
  ```
  ParseNodePtr Parser::ParseTerm(BOOL fAllowCall,
      LPCOLESTR pNameHint,
      uint32 *pHintLength,
      uint32 *pShortNameOffset,
      IdentToken* pToken,
      bool fUnaryOrParen,
      _Out_opt_ BOOL* pfCanAssign,
      _Inout_opt_ BOOL* pfLikelyPattern,
      _Out_opt_ bool* pfIsDotOrIndex,
      _Inout_opt_ charcount_t *plastRParen)
  {
      ParseNodePtr pnode = nullptr;
      charcount_t ichMin = 0;
      BOOL fCanAssign = TRUE;
      IdentToken term;

      if (m_token.tk == tkID)
      {
          IdentPtr pid = m_token.GetIdentifier(this->GetHashTbl());
          if (pid == wellKnownPropertyPids.async && !this->GetScanner()->FHadNewLine())
          {
              this->GetScanner()->Scan();
              if (m_token.tk == tkID)
              {
                  isLambdaExpr = true;
                  goto LFunction;
              }
          }

          PushPidRef(pid);
      }

  LFunction:
      pnode = ParsePostfixOperators<buildAST>(pnode, fAllowCall, fInNew, isAsyncExpr, &fCanAssign, &term, pfIsDotOrIndex);

      if (pToken && term.tk == tkID)
      {
          *pToken = term;
      }

      return pnode;
  }
  ```

test "rank1041: fix pops the references the speculative parse pushed"
  lang cpp
  file lib/Parser/Parse.cpp
  reject VYQL-MEM-007
  code
  ```
  ParseNodePtr Parser::ParseTerm(BOOL fAllowCall,
      LPCOLESTR pNameHint,
      uint32 *pHintLength,
      uint32 *pShortNameOffset,
      IdentToken* pToken,
      bool fUnaryOrParen,
      _Out_opt_ BOOL* pfCanAssign,
      _Inout_opt_ BOOL* pfLikelyPattern,
      _Out_opt_ bool* pfIsDotOrIndex,
      _Inout_opt_ charcount_t *plastRParen)
  {
      ParseNodePtr pnode = nullptr;
      PidRefStack *savedTopAsyncRef = nullptr;
      charcount_t ichMin = 0;
      BOOL fCanAssign = TRUE;
      IdentToken term;

      if (m_token.tk == tkID)
      {
          IdentPtr pid = m_token.GetIdentifier(this->GetHashTbl());
          if (pid == wellKnownPropertyPids.async && !this->GetScanner()->FHadNewLine())
          {
              this->GetScanner()->Scan();
              if (m_token.tk == tkID)
              {
                  isLambdaExpr = true;
                  goto LFunction;
              }
              else if (m_token.tk == tkLParen)
              {
                  savedTopAsyncRef = pid->GetTopRef();
              }
          }

          PushPidRef(pid);
      }

  LFunction:
      pnode = ParsePostfixOperators<buildAST>(pnode, fAllowCall, fInNew, isAsyncExpr, &fCanAssign, &term, pfIsDotOrIndex);

      if (savedTopAsyncRef != nullptr &&
          this->m_token.tk == tkDArrow)
      {
          for (IdentPtr pid = wellKnownPropertyPids.async; pid->GetTopRef() != savedTopAsyncRef;)
          {
              Assert(pid->GetTopRef() != nullptr);
              pid->RemovePrevPidRef(nullptr);
          }
      }

      if (pToken && term.tk == tkID)
      {
          *pToken = term;
      }

      return pnode;
  }
  ```
