# Rank 1417 / CVE-2026-54305 (GHSA-2j5h-858j-5mpf, CWE-200 + CWE-284, CVSS 4.0
# 8.9): n8n's Dynamic Credentials enterprise module exposes three REST endpoints
# whose callers come from two different places. One caller is an external system
# that authenticates with a resolver-issued static token and has no n8n user at
# all; the other is a logged-in n8n browser session, because the routes are
# mounted on the same authenticated REST surface as everything else. The
# vulnerable revision resolves the target resource **by id alone**, the same way,
# for both:
#
#   private async findCredentialToUse(credentialId: string) {
#     const credential = await this.enterpriseCredentialsService.getOne(credentialId);
#     ...
#   }
#
#   @Delete('/:id/revoke', { allowUnauthenticated: true, middlewares: ..., ipRateLimit: ... })
#   async revokeCredential(req: Request, res: Response) {
#     const credentialContext = this.dynamicCredentialWebService.getCredentialContextFromRequest(req);
#     const credential = await this.findCredentialToUse(req.params.id);   // <-- any id
#     ...
#     await resolver.deleteSecret(credential.id, credentialContext, { ... });
#   }
#
# and, in services/credential-resolver-workflow.service.ts:
#
#   const workflow = await this.workflowRepository.get({ id: workflowId });
#
# So the attacker is an **authenticated low-privilege n8n user** -- not a workflow
# author and not an unauthenticated caller. No project membership and no
# credential-sharing relationship with the victim is needed. Reaching
# `GET /workflows/:workflowId/execution-status` with somebody else's workflow id
# enumerates the credential ids, names and types that any private workflow
# references; `POST /credentials/:id/authorize` starts an OAuth authorization flow
# against somebody else's credential and overwrites its stored tokens with tokens
# bound to an account the attacker controls, so the victim's workflows then run
# under the attacker's OAuth identity; `DELETE /credentials/:id/revoke` deletes
# the victim's stored tokens outright. The `allowUnauthenticated: true` option on
# the routes is present in both revisions and is not the defect -- it is what
# admits the external token caller -- and the fixed revision does not remove it.
#
# The fixed revision keeps the dual-audience shape and splits the resolution: when the
# request carries an n8n session user, resolve the resource through the
# ownership-aware finder under an explicit scope, and only fall back to the
# by-id getter when there is no user.
#
#   -  const credential = await this.enterpriseCredentialsService.getOne(credentialId);
#   +  const credential =
#   +    user && scope
#   +      ? await this.credentialsFinderService.findCredentialForUser(credentialId, user, [scope])
#   +      : await this.enterpriseCredentialsService.getOne(credentialId);
#
#   -  const credential = await this.findCredentialToUse(req.params.id);
#   +  const user = isAuthenticatedRequest(req) ? req.user : undefined;
#   +  const credential = await this.findCredentialToUse(req.params.id, user, 'credential:update');
#
#   -  const workflow = await this.workflowRepository.get({ id: workflowId });
#   +  const workflow = user
#   +    ? await this.workflowFinderService.findWorkflowForUser(workflowId, user, ['workflow:read'])
#   +    : await this.workflowRepository.get({ id: workflowId });
#
# ## The pool row is wrong, and `nocommit` is right that something is odd
#
# The row's `6c8a27591e5d1c43bc2270e83dbde69d75c06215` resolves, but not from a
# default clone: it sits on the 1.x maintenance line, unreachable from `master`,
# and `git init` + `git fetch --depth 2 --filter=blob:none origin <sha>` is what
# retrieves it (rank 1404's route, used here for the second time). It reads fine
# once fetched -- `chore: Bundle/1.x (#32030)`, 38 files, the 1.123.55 security
# bundle -- and it is **not this CVE's fix**. It carries a Python task-runner
# sandbox hardening, webhook origin isolation, a Postgres and a SecurityScorecard
# node change, and nothing else; `git ls-tree -d 6c8a2759 packages/cli/src/modules`
# shows the 1.x line has no `dynamic-credentials.ee` module at all, so the
# weakness cannot exist on that branch and the advisory's `< 1.123.55` range is
# over-broad. This is a distinct route for `nocommit` being wrong: the commit is
# real, readable, on the right project, in the right release window, and is the
# wrong one of several security bundles cut the same minute.
#
# The readable fix is `3f7246b41a768a331efd7681a103cf30a293f725`
# (`chore: Bundle/2.x (backport to release-candidate/2.25.x) (#32036)`, 53 files,
# tagged into `n8n@2.25.7`), whose parent is `n8n@2.25.6` and carries the by-id
# lookups above verbatim; `284b3f088` is the same bundle on the 2.26.x line for
# `n8n@2.26.2`. Both come from diffing the advisory's own patched tags
# against their predecessors, since the advisory references no commit at all.
# The remediation is present at the fixed revision (rank 1390's check) and the vulnerable
# construct is present at its parent.
#
# ## What fires
#
# `timeout 180 ./bin/vyql scan --cache off --max-ram 6GB` over
# `packages/cli/src/modules/dynamic-credentials.ee` at both revisions reports the
# **same 9 findings and 0 flags**, byte-identical fingerprints: four VYQL-CRY-003
# in a resolver contract test, a VYQL-INJ-009, a VYQL-INJ-013, two VYQL-INJ-001
# and a VYQL-INJ-002 -- the last three sourced from a Slack signature verifier and
# sinking into a rate-limit integration test's SQL, which is the known
# `.get`/`Container.get` over-label. Nothing about the ownership of a credential
# or a workflow, and nothing that moves across the revisions. The first five cases below
# pin that, in both directions.
#
# ## Why the obvious binding is not shippable, measured
#
# The only documented API the fixed revision adds inside the handlers is `req.user`
# (Express/Passport); every other name it introduces belongs to n8n's own service
# layer. Section 9's "endpoint with no authorization signal in its body" shape is
# therefore the first thing to reach for, and on this codebase it is exactly as
# bad as section 9 says: a function-scope presence node with
# `node.context.attrPath contains "req.params"` and `not (... "req.user")` gives
# a clean **3 on the vulnerable module and 0 on the patched** -- and **109 hits on
# the 1905 TypeScript files of `packages/cli/src`**. That is the sixth codebase
# the shape has failed on.
#
# The 106 others are not sloppy code. n8n declares route authorization the way
# NestJS and routing-controllers do, with a decorator beside the verb decorator:
# `@ProjectScope('folder:create')`, `@GlobalScope(...)`, and a class-level
# `@Middleware()` for the rest. Reading no principal in the body is meaningless
# for those handlers, and it is meaningful for the three vulnerable ones only
# because they have no scope decorator either. Adding the decorator to the clause
# set -- `decorator_method:` in Post/Put/Patch/Delete, a captured path segment
# read, no principal read, no scope decorator -- takes it to **2 on the vulnerable
# module, 0 on the patched, and 3 on the whole of `packages/cli/src`**. That
# binding is not in this commit, because it cannot fire: see below.
#
# ## The engine gap
#
# The scope decorator is not readable, and the reason is a wrong extraction path
# rather than a missing fact. `nir.FuncDef.Decorators` exists, the lowering
# appends it to the function's context tokens (`lowering.go:3053`,
# `l.curDecorators = append(ContextTokens, Decorators...)`),
# `decoratorPath`/`decoratorMethod` compile to `decorator_path:`/`decorator_method:`
# (`compile_presence.go:596`), and eight shipped bindings in
# `bindings/javascript/mfb63017a.vyql` key on `decorator_method:` to make
# a decorated handler's parameters `code.HttpInput`. But `jsDecoratorTokens`
# (`internal/extract/frontend/treesitter/javascript.go:2549`) reads decorators
# only from `namedChildren` of the member, and the two grammars disagree about
# where a class member's decorators live:
#
#   javascript: (class_body member: (method_definition decorator: (decorator ...) name: ...))
#   typescript: (class_body decorator: (decorator ...) (method_definition name: ...))
#
# `tree-sitter-typescript/common/define-grammar.js:455` redefines
# `method_definition` without decorators and hoists them into `class_body`. So for
# `.ts`, `.mts`, `.cts` and `.tsx` -- every file any of these frameworks is
# actually written in -- a decorated method carries no decorator token at all, and
# the eight shipped route-entry bindings are inert. The last two cases below are
# the minimal pair, and they are written against shipped detection rather than
# against anything this rank adds: a NestJS-shaped handler whose only untrusted
# input is its own decorated parameter reports **VYQL-INJ-002 critical** as `.js`
# and reports **nothing** as `.ts`, from byte-identical source. The `.ts` half is
# pinned as a `reject` and must flip to `expect` when the gap closes.
#
# ## Why no binding ships
#
# With the gap open the decorator-clause binding above reports **0 on every real
# tree measured**: 0 on both revisions of `dynamic-credentials.ee`, 0 on the 1905
# TypeScript files of `packages/cli/src`, and 0 on all 132 files in the ~120
# campaign clones that carry a `@Post`/`@Put`/`@Patch`/`@Delete` member decorator
# -- 129 of those 132 are `.ts`, and the three `.js` ones do not match either. A
# binding that cannot fire is worse than none, because it would begin firing, with
# an uncharacterised precision profile, the moment somebody corrects the grammar
# for an unrelated reason. It is recorded here and in `ENGINE-GAPS.md` instead.
#
# `code.IdorPolicyReview` is the concept it would emit, reused rather than minted:
# CWE-639, `access_control.Idor`, review text "review object lookup or delete
# criteria for a current-principal ownership constraint", cleared by
# `core.OwnershipCheck` or `core.AuthorizationCheck`, judged by `VYQL-AUTH-081` at
# high. Considered and rejected: `code.AccessPolicyReview` and
# `code.RequestScopePolicyReview` are CWE-863 "wrong scope" concepts and the
# defect here is that no scope is consulted at all;
# `code.MemberStoreMissingCreateAuthorization` and
# `code.CommentUpdateMissingOwnershipConstraint` are per-resource siblings of
# exactly the kind AGENTS.md calls ontology rot; `code.UnvalidatedModelSelection`
# is about which model a request selects, not whose row it selects.
#
# The discriminator, if it ever ships, is `req.user` and not the fixed revision's own
# vocabulary, tested by rewriting rather than argued: renaming
# `findCredentialForUser` to `lookupThing`, `isAuthenticatedRequest` to
# `hasSession` and `credentialsFinderService` to `finderSvc` throughout the
# patched controller still gives 0, while deleting only the
# `isAuthenticatedRequest(req) ? req.user : undefined` read from the patched
# controller brings it back to 2. That is rank 1380's counterweight rather than
# the 1377/1389/1397/1399 attribution gap: the fixed revision leaves a documented API call
# inside the method it guards. Function confinement is not assumed either: the
# same file's `deleteMyConnection`, which keys its delete on `req.user.id`, sits
# three methods below the two that would fire and does not silence them.
#
# The third endpoint would be out of reach even then. `GET .../execution-status`
# is the credential-enumeration leg and it is a read, so admitting `Get` would
# catch it -- at the cost of five more rows on `packages/cli/src`, among them a
# documented existence probe (`@Get('/:workflowId/exists')`, whose comment
# explains it cannot take a scope) and a public node catalogue. A read route left
# unscoped on purpose is ordinary; a mutating one is not. The fourth and fifth
# cases below pin both of those exits so a future binding has to respect them.

test "rank1417: a mutating route deletes the credential named by a path segment with no principal read"
  lang javascript
  file packages/cli/src/modules/dynamic-credentials.ee/dynamic-credentials.controller.js
  reject VYQL-AUTH-081
  code
  ```
  const { Delete, RestController } = require('@n8n/decorators');

  @RestController('/credentials')
  class DynamicCredentialsController {
    async findCredentialToUse (credentialId) {
      const credential = await this.enterpriseCredentialsService.getOne(credentialId);
      if (!credential) {
        throw new NotFoundError('Credential not found');
      }
      return credential;
    }

    @Delete('/:id/revoke', { allowUnauthenticated: true, ipRateLimit: { limit: 10 } })
    async revokeCredential (req, res) {
      this.dynamicCredentialCorsService.applyCorsHeadersIfEnabled(req, res, ['delete', 'options']);
      const credentialContext = this.dynamicCredentialWebService.getCredentialContextFromRequest(req);
      const credential = await this.findCredentialToUse(req.params.id);
      const resolverId = req.query.resolverId;
      const { resolver, resolverEntity } = await this.getResolverInstance(resolverId);
      if (resolver.deleteSecret) {
        await resolver.deleteSecret(credential.id, credentialContext, { resolverId: resolverEntity.id });
      }
      res.status(204).send();
    }
  }

  module.exports = { DynamicCredentialsController };
  ```

test "rank1417: the same route resolves the credential through the finder for the session user"
  lang javascript
  file packages/cli/src/modules/dynamic-credentials.ee/dynamic-credentials.controller.js
  reject VYQL-AUTH-081
  code
  ```
  const { Delete, RestController } = require('@n8n/decorators');
  const { isAuthenticatedRequest } = require('@n8n/db');

  @RestController('/credentials')
  class DynamicCredentialsController {
    async findCredentialToUse (credentialId, user, scope) {
      const credential = user && scope
        ? await this.credentialsFinderService.findCredentialForUser(credentialId, user, [scope])
        : await this.enterpriseCredentialsService.getOne(credentialId);
      if (!credential) {
        throw new NotFoundError('Credential not found');
      }
      return credential;
    }

    @Delete('/:id/revoke', { allowUnauthenticated: true, ipRateLimit: { limit: 10 } })
    async revokeCredential (req, res) {
      this.dynamicCredentialCorsService.applyCorsHeadersIfEnabled(req, res, ['delete', 'options']);
      const credentialContext = this.dynamicCredentialWebService.getCredentialContextFromRequest(req);
      const user = isAuthenticatedRequest(req) ? req.user : undefined;
      const credential = await this.findCredentialToUse(req.params.id, user, 'credential:update');
      const resolverId = req.query.resolverId;
      const { resolver, resolverEntity } = await this.getResolverInstance(resolverId);
      if (resolver.deleteSecret) {
        await resolver.deleteSecret(credential.id, credentialContext, { resolverId: resolverEntity.id });
      }
      res.status(204).send();
    }
  }

  module.exports = { DynamicCredentialsController };
  ```

test "rank1417: a mutating route that declares its authorization with a scope decorator"
  lang javascript
  file packages/cli/src/workflows/workflows.controller.js
  reject VYQL-AUTH-081
  code
  ```
  const { Patch, RestController } = require('@n8n/decorators');
  const { ProjectScope } = require('@n8n/permissions');

  @RestController('/workflows')
  class WorkflowsController {
    @Patch('/:workflowId')
    @ProjectScope('workflow:update')
    async update (req, res) {
      const { workflowId } = req.params;
      const updated = await this.workflowService.update(workflowId, req.body);
      return updated;
    }
  }

  module.exports = { WorkflowsController };
  ```

test "rank1417: a mutating route that keys the delete on the caller's own user id"
  lang javascript
  file packages/cli/src/modules/dynamic-credentials.ee/dynamic-credentials.controller.js
  reject VYQL-AUTH-081
  code
  ```
  const { Delete, RestController } = require('@n8n/decorators');

  @RestController('/credentials')
  class DynamicCredentialsController {
    @Delete('/:credentialId/my-connection')
    async deleteMyConnection (req, res) {
      const credential = await this.credentialsFinderService.findCredentialById(req.params.credentialId);
      if (!credential) {
        throw new NotFoundError('Credential not found');
      }
      const affected = await this.credentialConnectionStatusService.deleteMyConnection(
        req.user.id,
        req.params.credentialId,
      );
      if (affected === 0) {
        throw new NotFoundError('No connection to disconnect');
      }
      res.status(204).send();
    }
  }

  module.exports = { DynamicCredentialsController };
  ```

test "rank1417: a read route left unscoped on purpose is not this weakness"
  lang javascript
  file packages/cli/src/workflows/workflows.controller.js
  reject VYQL-AUTH-081
  code
  ```
  const { Get, RestController } = require('@n8n/decorators');

  @RestController('/workflows')
  class WorkflowsController {
    // We cannot use a scope here because we want to check for the id's existence:
    // adding one would disable the route if the user has no access to the workflow.
    @Get('/:workflowId/exists')
    async exists (req) {
      const exists = await this.workflowRepository.existsBy({ id: req.params.workflowId });
      return { exists };
    }
  }

  module.exports = { WorkflowsController };
  ```

test "rank1417: minimal pair -- a decorated handler's parameter is untrusted input in a .js module"
  lang javascript
  file packages/cli/src/modules/dynamic-credentials.ee/pair.js
  expect VYQL-INJ-002
  code
  ```
  const { exec } = require('child_process');

  @Controller('/jobs')
  class JobsController {
    @Post('/run')
    run (payload) {
      exec('systemctl restart ' + payload.unit);
      return 'ok';
    }
  }

  module.exports = { JobsController };
  ```

# Pinned miss. The source is byte-identical to the case above and the only thing
# that differs is the extension, so this must flip to `expect VYQL-INJ-002` when
# the typescript grammar's hoisted member decorators are read.
