# Rank 1001 / CVE-2023-51763: ActiveAdmin CSV export wrote model attribute
# values straight into CSV.generate_line. A record whose field begins with
# = + - @ becomes a formula when the export is opened in a spreadsheet.

test "rank1001: CSV rows mapped from collection data with no formula guard"
  lang ruby
  expect VYQL-INJ-121
  code
  ```
  module ActiveAdmin
    class CSVBuilder
      def build_csv_lines(csv, columns, options, csv_options)
        if column_names
          csv << CSV.generate_line(columns.map { |c| encode c.name, options }, **csv_options)
        end

        controller.send(:in_paginated_batches) do |resource|
          csv << CSV.generate_line(build_row(resource, columns, options), **csv_options)
        end
      end
    end
  end
  ```

test "rank1001: sanitized cells are not formula-prone"
  lang ruby
  reject VYQL-INJ-121
  code
  ```
  module ActiveAdmin
    class CSVBuilder
      def build_csv_lines(csv, columns, options, csv_options)
        if column_names
          csv << CSV.generate_line(columns.map { |c| sanitize(encode(c.name, options)) }, **csv_options)
        end

        controller.send(:in_paginated_batches) do |resource|
          csv << CSV.generate_line(build_row(resource, columns, options), **csv_options)
        end
      end
    end
  end
  ```

test "rank1001: generating a line from literals is not an export row"
  lang ruby
  reject VYQL-INJ-121
  code
  ```
  def header_line(csv_options)
    CSV.generate_line(["id", "name", "created_at"], **csv_options)
  end
  ```
