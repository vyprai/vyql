# Rank 1083 / CVE-2024-47875: DOMPurify places no limit on element nesting
# depth, so deeply nested markup can re-serialize in the browser and reverse
# sanitization (CWE-79, mutation XSS).
#
# ATTENTION: vocabulary gap. The weakness is inside the sanitizer; callers of
# DOMPurify.sanitize are doing the correct thing. The call emits core.HtmlEscape
# with no version gate, so a vulnerable dependency suppresses VYQL-INJ-004.
# Sanitized assignment rejects; unsanitized expects; nesting-bounded form
# rejects.
#
# verify_current_expected: attention-vocabulary-gap

test "rank1083: sanitized output is not reported, whatever the library version"
  lang javascript
  file app.js
  reject VYQL-INJ-004
  code
  ```
  const DOMPurify = require('dompurify');

  function render(req, el) {
    const raw = req.query.bio;
    el.innerHTML = DOMPurify.sanitize(raw);
  }
  ```

test "rank1083: the same assignment without the sanitizer is reported"
  lang javascript
  file app.js
  expect VYQL-INJ-004
  code
  ```
  function render(req, el) {
    const raw = req.query.bio;
    el.innerHTML = raw;
  }
  ```

# The library's own fix, kept so a later reader can see what the patched
# sanitizer does rather than inferring it from the advisory text.

test "rank1083: the sanitizer bounds nesting depth itself"
  lang javascript
  file src/purify.js
  reject VYQL-INJ-004
  code
  ```
  const MAX_NESTING_DEPTH = 500;

  function _sanitizeElements(currentNode) {
    if (currentNode.nodeType === 1) {
      if (currentNode.parentNode && currentNode.parentNode.__depth) {
        currentNode.__depth =
          (currentNode.__removalCount || 0) + currentNode.parentNode.__depth + 1;
      } else {
        currentNode.__depth = 1;
      }
    }

    if (currentNode.__depth >= MAX_NESTING_DEPTH) {
      _forceRemove(currentNode);
    }
  }
  ```
