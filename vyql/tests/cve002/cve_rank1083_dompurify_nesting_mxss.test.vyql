# Rank 1083 / CVE-2024-47875: DOMPurify placed no limit on element nesting
# depth, so deeply nested markup made the browser's parser re-serialize the tree
# in a way that reversed sanitization (CWE-79, mutation XSS). The weakness is
# inside the sanitizer, so the caller's assignment is correct code and the
# report that belongs to this CVE is the dependency finding: a pin below
# 3.1.3, the release the advisory names as first fixed.

test "rank1083: a dompurify pin below the first fixed release is a dependency finding"
  lang javascript
  file app.js
  code
  ```
  const DOMPurify = require('dompurify');

  function render(req, el) {
    el.innerHTML = DOMPurify.sanitize(req.query.bio);
  }
  ```
  file package.json
  code
  ```
  {
    "name": "profile-ui",
    "dependencies": {
      "dompurify": "3.1.2"
    }
  }
  ```
  expect VYQL-SCA-001
  expect_evidence VYQL-SCA-001 CVE-2024-47875

test "rank1083: a dompurify pin at the first fixed release is clean"
  lang javascript
  file app.js
  code
  ```
  const DOMPurify = require('dompurify');

  function render(req, el) {
    el.innerHTML = DOMPurify.sanitize(req.query.bio);
  }
  ```
  file package.json
  code
  ```
  {
    "name": "profile-ui",
    "dependencies": {
      "dompurify": "3.1.3"
    }
  }
  ```
  reject VYQL-SCA-001

# The sanitizer call stays a control whatever the library version: the caller
# is doing the correct thing, and the vulnerable-library report is carried by
# the dependency finding above, not by an injection finding on correct code.

test "rank1083: the sanitized assignment is not an injection finding on a vulnerable pin"
  lang javascript
  file app.js
  code
  ```
  const DOMPurify = require('dompurify');

  function render(req, el) {
    const raw = req.query.bio;
    el.innerHTML = DOMPurify.sanitize(raw);
  }
  ```
  file package.json
  code
  ```
  {
    "name": "profile-ui",
    "dependencies": {
      "dompurify": "3.1.2"
    }
  }
  ```
  reject VYQL-INJ-004

test "rank1083: the same assignment without the sanitizer is reported"
  lang javascript
  file app.js
  code
  ```
  function render(req, el) {
    const raw = req.query.bio;
    el.innerHTML = raw;
  }
  ```
  expect VYQL-INJ-004

# The library's own fix, kept so a later reader can see what the patched
# sanitizer does rather than inferring it from the advisory text.

test "rank1083: the sanitizer bounds nesting depth itself"
  lang javascript
  file src/purify.js
  code
  ```
  const MAX_NESTING_DEPTH = 500;

  function _sanitizeElements(currentNode) {
    if (currentNode.nodeType === 1) {
      if (currentNode.parentNode && currentNode.parentNode.__depth) {
        currentNode.__depth =
          (currentNode.__removalCount || 0) + currentNode.parentNode.__depth + 1;
      } else {
        currentNode.__depth = 1;
      }
    }

    if (currentNode.__depth >= MAX_NESTING_DEPTH) {
      _forceRemove(currentNode);
    }
  }
  ```
  reject VYQL-INJ-004
