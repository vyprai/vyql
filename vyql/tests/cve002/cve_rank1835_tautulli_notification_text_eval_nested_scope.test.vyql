test "rank1835: the fixed revision walks the nested code objects before evaluating"
  lang python
  file plexpy/notification_handler.py
  reject VYQL-INJ-274
  reject_review code.RestrictedEvalNestedScopeNameFilterGap
  code
  ```
  import re
  import types
  from string import Formatter
  from typing import Any, Callable

  import helpers


  def str_eval(field_name: str, kwargs: dict[str, Callable]) -> Any:
      field_name = field_name.strip('`')
      allowed_names = {
          'bool': bool,
          'divmod': helpers.helper_divmod,
          'float': helpers.cast_to_float,
          'int': helpers.cast_to_int,
          'len': helpers.helper_len,
          'round': helpers.helper_round,
          'str': str
      }
      allowed_names.update(kwargs)
      code = compile(field_name, '<string>', 'eval')
      _check_names(code, allowed_names)
      return eval(code, {'__builtins__': {}}, allowed_names)


  def _check_names(code: types.CodeType, allowed_names: dict[str, Callable]):
      for name in code.co_names:
          if name not in allowed_names:
              raise NameError(f'Use of {name} not allowed')
      for const in code.co_consts:
          if isinstance(const, types.CodeType):
              _check_names(const, allowed_names)


  class CustomFormatter(Formatter):
      def __init__(self, default='{{{0}}}'):
          self.default = default
          self.eval_regex = re.compile(r'`.*?`')
          self.eval_replace_regex = re.compile(r'{.*(`.*?`).*}')
  ```

test "rank1835: an inline descent into the nested code objects is equally clean"
  lang python
  file plexpy/notification_handler.py
  reject VYQL-INJ-274
  code
  ```
  import types

  import helpers


  def str_eval(field_name, kwargs):
      field_name = field_name.strip('`')
      allowed_names = {
          'bool': bool,
          'int': helpers.cast_to_int,
          'len': helpers.helper_len,
          'str': str
      }
      allowed_names.update(kwargs)
      code = compile(field_name, '<string>', 'eval')
      pending = [code]
      while pending:
          current = pending.pop()
          for name in current.co_names:
              if name not in allowed_names:
                  raise NameError('Use of {name} not allowed'.format(name=name))
          for const in current.co_consts:
              if isinstance(const, types.CodeType):
                  pending.append(const)
      return eval(code, {'__builtins__': {}}, allowed_names)
  ```

test "rank1835: an expression filter built on the ast module does not read co_names"
  lang python
  file plexpy/notification_handler.py
  reject VYQL-INJ-274
  code
  ```
  import ast

  import helpers


  _DENIED_ATTRIBUTES = frozenset({
      '__subclasses__', '__bases__', '__mro__', '__globals__',
      '__code__', '__class__', '__dict__', '__builtins__',
  })


  def str_eval(field_name, kwargs):
      field_name = field_name.strip('`')
      allowed_names = {
          'bool': bool,
          'int': helpers.cast_to_int,
          'len': helpers.helper_len,
          'str': str
      }
      allowed_names.update(kwargs)
      tree = ast.parse(field_name, mode='eval')
      for node in ast.walk(tree):
          if isinstance(node, ast.Attribute) and node.attr in _DENIED_ATTRIBUTES:
              raise NameError('Use of {0} not allowed'.format(node.attr))
          if isinstance(node, ast.Name) and node.id not in allowed_names:
              raise NameError('Use of {0} not allowed'.format(node.id))
      return eval(compile(tree, '<string>', 'eval'), {'__builtins__': {}}, allowed_names)
  ```

