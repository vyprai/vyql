  <?php
  namespace OCA\Tables\Db;

  use OCA\Tables\Constants\ColumnType;

  class Column extends EntitySuper implements JsonSerializable {
  	public function getType(): string {
  		return ColumnType::from($this->type)->value;
  	}
  }
