test "rank1830: a model's own table name is the ordinary ORM idiom and is not this weakness"
  lang php
  file lib/Database/Relations/DefinedConstraints.php
  reject VYQL-INJ-152
  reject_review code.UnvalidatedSqlIdentifierInterpolation
  code
  ```
  <?php
  namespace October\Rain\Database\Relations;

  class DefinedConstraints {
  	public function build(Model $query, Model $related): void {
  		$query->join($this->related->getTable(), $this->relatedPivotKey, '=', $this->relatedKey);
  		$prefix = $this->connection->getTablePrefix();
  		$query->from($prefix . 'deferred_bindings', 'd');
  	}
  }
  ```
