# QEMU's ESP SCSI emulator keeps its in-flight transfer state as a pair of
# fields on ESPState (include/hw/scsi/esp.h:47-48): `uint8_t *async_buf`, the
# remaining slice of the SCSI buffer to service, and `uint32_t async_len`, how
# many bytes that slice can still take. The pairing is convention, not type:
# nothing but the emulator's own discipline keeps the two in step. The non-DMA
# TI (Transfer Info) path, esp_do_nodma() in hw/scsi/esp.c, moves FIFO data
# into that slice when the guest is the initiator:
#
#   len = MIN(fifo8_num_used(&s->fifo), ESP_FIFO_SZ);
#   esp_fifo_pop_buf(&s->fifo, s->async_buf, len);
#   s->async_buf += len;
#   s->async_len -= len;
#
# The advance and the decrement are one step of one walk, and that is what
# states the pairing: `s->async_len` is `s->async_buf`'s remaining byte count.
# The bound on `len`, though, is taken entirely from the source side -- how
# much data the FIFO holds, capped by the FIFO constant -- and never consults
# `s->async_len`. When a SCSI transfer is terminated early, the guest can leave
# more bytes in the FIFO than the terminated transfer still expects, so `len`
# exceeds the destination slice's remaining capacity: esp_fifo_pop_buf
# (hw/scsi/esp.c:121) memcpy's `len` bytes into `s->async_buf` past the end of
# the SCSI buffer, and the `s->async_len -= len` decrement, in uint32_t
# arithmetic, wraps to a huge value (gitlab issue 1810).
#
# Fix commit 77668e4b9bca03a856c27ba899a2513ddf52bb52 ("esp: restrict non-DMA
# transfer length to that of available data") adds the missing operand, so the
# capacity enters the MIN chain ahead of the source side:
#
#   len = MIN(s->async_len, ESP_FIFO_SZ);
#   len = MIN(len, fifo8_num_used(&s->fifo));
#
# The vulnerable form is present at the parent (b86dc5cb0, checked out and
# read) and the remediation is present at the fixed revision itself.
#
# Detected by VYQL-MEM-071: the cursor pair -- `s->async_buf += len` beside
# `s->async_len -= len` in one block, the length handed to the transfer call
# with the destination -- states that `s->async_len` is the destination's
# remaining capacity, and the frontend fact for an unconsulted destination
# capacity then reports the transfer whose bound never mentions it. The
# capacity entering the MIN chain is what clears the fixed form, in either
# operand order, so the pair of tests separates the two revisions by the
# presence of the capacity in the bound rather than by the arrangement the fix
# happens to use.
#
# The first two tests hold the full real shape of the to_device branch, helper
# included, at both revisions; the second two isolate the construct with the
# helper as a declaration, so the only difference between them is whether
# `s->async_len` enters the bound.
#
# verify_current_expected: expect

test "rank1633: the non-DMA transfer length is bounded by the FIFO side only, never by the destination slice's remaining capacity"
  lang c
  file hw/scsi/esp.c
  expect VYQL-MEM-071
  reject VYQL-MEM-010
  reject VYQL-MEM-023
  reject VYQL-NUM-003
  reject_review code.CompressedBlockSizeCapacityMismatch
  reject_review code.SignedMessageLengthUnderflowCopy
  code
  ```
  #include <stdint.h>
  #include <string.h>

  #define ESP_FIFO_SZ 16
  #define MIN(a, b) ((a) < (b) ? (a) : (b))

  typedef struct Fifo8 Fifo8;
  uint32_t fifo8_num_used(const Fifo8 *fifo);
  const uint8_t *fifo8_pop_buf(Fifo8 *fifo, uint32_t max, uint32_t *n);

  struct ESPState {
      uint32_t async_len;
      uint8_t *async_buf;
      uint32_t ti_size;
      Fifo8 fifo;
  };

  static uint32_t esp_fifo_pop_buf(Fifo8 *fifo, uint8_t *dest, int maxlen)
  {
      const uint8_t *buf;
      uint32_t n;

      if (maxlen == 0) {
          return 0;
      }

      buf = fifo8_pop_buf(fifo, maxlen, &n);
      if (dest) {
          memcpy(dest, buf, n);
      }

      return n;
  }

  static void esp_do_nodma(struct ESPState *s)
  {
      int len;

      if (s->async_len == 0) {
          return;
      }

      len = MIN(fifo8_num_used(&s->fifo), ESP_FIFO_SZ);
      esp_fifo_pop_buf(&s->fifo, s->async_buf, len);
      s->async_buf += len;
      s->async_len -= len;
      s->ti_size += len;
  }
  ```

test "rank1633: the destination capacity enters the MIN chain ahead of the FIFO side"
  lang c
  file hw/scsi/esp.c
  reject VYQL-MEM-071
  reject VYQL-MEM-010
  reject VYQL-MEM-023
  reject VYQL-NUM-003
  reject_review code.CompressedBlockSizeCapacityMismatch
  reject_review code.SignedMessageLengthUnderflowCopy
  code
  ```
  #include <stdint.h>
  #include <string.h>

  #define ESP_FIFO_SZ 16
  #define MIN(a, b) ((a) < (b) ? (a) : (b))

  typedef struct Fifo8 Fifo8;
  uint32_t fifo8_num_used(const Fifo8 *fifo);
  const uint8_t *fifo8_pop_buf(Fifo8 *fifo, uint32_t max, uint32_t *n);

  struct ESPState {
      uint32_t async_len;
      uint8_t *async_buf;
      uint32_t ti_size;
      Fifo8 fifo;
  };

  static uint32_t esp_fifo_pop_buf(Fifo8 *fifo, uint8_t *dest, int maxlen)
  {
      const uint8_t *buf;
      uint32_t n;

      if (maxlen == 0) {
          return 0;
      }

      buf = fifo8_pop_buf(fifo, maxlen, &n);
      if (dest) {
          memcpy(dest, buf, n);
      }

      return n;
  }

  static void esp_do_nodma(struct ESPState *s)
  {
      int len;

      if (s->async_len == 0) {
          return;
      }

      len = MIN(s->async_len, ESP_FIFO_SZ);
      len = MIN(len, fifo8_num_used(&s->fifo));
      esp_fifo_pop_buf(&s->fifo, s->async_buf, len);
      s->async_buf += len;
      s->async_len -= len;
      s->ti_size += len;
  }
  ```

