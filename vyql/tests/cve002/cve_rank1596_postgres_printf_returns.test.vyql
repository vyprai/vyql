test "rank1596: the captured sprintf return is consumed as a length"
  lang c
  file src/port/snprintf.c
  reject VYQL-VAL-001
  reject VYQL-MEM-073
  code
  ```
  #include <stdio.h>
  #include <ctype.h>

  typedef struct PrintfTarget
  {
      char       *bufstart;
      char       *bufptr;
      char       *bufend;
  } PrintfTarget;

  static void dostr(const char *str, int slen, PrintfTarget *target);

  static void
  fmtptr(void *value, PrintfTarget *target)
  {
      int         vallen;
      char        convert[64];

      /* we rely on regular C library's sprintf to do the basic conversion */
      vallen = sprintf(convert, "%p", value);

      dostr(convert, vallen, target);
  }

  static void
  fmtfloat(double value, char type, int precision, int pointflag,
           PrintfTarget *target)
  {
      int         vallen;
      char        fmt[32];
      char        convert[1024];
      int         zeropadlen = 0;

      if (pointflag)
      {
          sprintf(fmt, "%%.%d%c", precision, type);
          zeropadlen = 8;
      }
      else
          sprintf(fmt, "%%%c", type);

      vallen = sprintf(convert, fmt, value);

      /* If it's infinity or NaN, forget about doing any zero-padding */
      if (zeropadlen > 0 && !isdigit((unsigned char) convert[vallen - 1]))
          zeropadlen = 0;
  }
  ```

test "rank1596: the fixed revision consults the formatted-output return"
  lang c
  file src/port/snprintf.c
  reject VYQL-VAL-001
  reject VYQL-MEM-073
  code
  ```
  #include <stdio.h>
  #include <ctype.h>

  typedef struct PrintfTarget
  {
      char       *bufstart;
      char       *bufptr;
      char       *bufend;
      bool        failed;
  } PrintfTarget;

  static void dostr(const char *str, int slen, PrintfTarget *target);

  static void
  fmtptr(void *value, PrintfTarget *target)
  {
      int         vallen;
      char        convert[64];

      /* we rely on regular C library's sprintf to do the basic conversion */
      vallen = sprintf(convert, "%p", value);
      if (vallen < 0)
          target->failed = true;
      else
          dostr(convert, vallen, target);
  }

  static void
  fmtfloat(double value, char type, int precision, int pointflag,
           PrintfTarget *target)
  {
      int         vallen;
      char        fmt[32];
      char        convert[1024];
      int         zeropadlen = 0;

      if (pointflag)
      {
          if (sprintf(fmt, "%%.%d%c", precision, type) < 0)
              goto fail;
          zeropadlen = 8;
      }
      else if (sprintf(fmt, "%%%c", type) < 0)
          goto fail;

      vallen = sprintf(convert, fmt, value);
      if (vallen < 0)
          goto fail;

      /* If it's infinity or NaN, forget about doing any zero-padding */
      if (zeropadlen > 0 && !isdigit((unsigned char) convert[vallen - 1]))
          zeropadlen = 0;
      return;

  fail:
      target->failed = true;
  }
  ```

test "rank1596: the throw-on-fail wrapper aborts instead of returning"
  lang c
  file src/port/syswrap.c
  reject VYQL-VAL-001
  code
  ```
  #include <stdio.h>
  #include <stdlib.h>
  #include <stdarg.h>
  #include <errno.h>

  /* We abort() in the frontend, rather than exit(), because libpq in
   * particular has no business calling exit().  These failures had better
   * be rare. */
  static void
  lib_err(const char *func)
  {
      int         discard;

      discard = fprintf(stderr, "%s failed: %s\n", func, strerror(errno));
      (void) discard;
      abort();
  }

  int
  vfprintf_throw_on_fail(FILE *stream, const char *fmt, va_list args)
  {
      int         ret;

      ret = vfprintf(stream, fmt, args);
      if (ret < 0)
          lib_err("vfprintf");
      return ret;
  }

  int
  vsprintf_throw_on_fail(char *str, const char *fmt, va_list args)
  {
      int         ret;

      ret = vsprintf(str, fmt, args);
      if (ret < 0)
          lib_err("vsprintf");
      return ret;
  }

  int
  printf_throw_on_fail(const char *fmt,...)
  {
      int         ret;
      va_list     args;

      va_start(args, fmt);
      ret = vprintf(fmt, args);
      va_end(args);
      if (ret < 0)
          lib_err("printf");
      return ret;
  }
  ```
