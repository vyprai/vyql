  public class AuthorizationRuleWildcard extends WebSecurityConfigurerAdapter {

  	@Override
  	protected void configure(HttpSecurity http) throws Exception {
  		http.authorizeHttpRequests(
  				(requests) -> requests.requestMatchers(new AntPathRequestMatcher("/admin/**")).hasRole("ADMIN"));
  	}

  }
  ```

