test "rank1837: fix gives the two-argument check the copy's own length"
  lang c
  file print-isakmp.c
  reject VYQL-MEM-016
  code
  ```
  #include <stdint.h>
  #include <string.h>

  struct isakmp_gen {
      uint8_t  np;
      uint8_t  critical;
      uint16_t len;
  };

  struct ikev2_auth {
      struct isakmp_gen h;
      uint8_t  auth_method;
      uint8_t  reserved[3];
  };

  #define ND_TTEST2(var, l) \
    (((uintptr_t)&(var) <= (uintptr_t)snapend - (l)))
  #define ND_TCHECK2(var, l) if (!ND_TTEST2(var, l)) goto trunc
  #define ND_TCHECK(var) ND_TCHECK2(var, sizeof(var))
  #define UNALIGNED_MEMCPY(p, q, l)	memcpy((p), (q), (l))

  const unsigned char *snapend;

  static const unsigned char *
  ikev2_auth_print(const struct isakmp_gen *ext)
  {
      struct ikev2_auth a;
      unsigned int len;

      ND_TCHECK2(*ext, sizeof(a));
      UNALIGNED_MEMCPY(&a, ext, sizeof(a));

      len = ntohs(a.h.len);
      return (const unsigned char *)ext + len;
  trunc:
      return NULL;
  }
  ```

test "rank1837: equal sizes -- checking the generic header before copying it is correct"
  lang c
  file print-isakmp.c
  reject VYQL-MEM-016
  code
  ```
  #include <stdint.h>
  #include <string.h>

  struct isakmp_gen {
      uint8_t  np;
      uint8_t  critical;
      uint16_t len;
  };

  #define ND_TTEST2(var, l) \
    (((uintptr_t)&(var) <= (uintptr_t)snapend - (l)))
  #define ND_TCHECK2(var, l) if (!ND_TTEST2(var, l)) goto trunc
  #define ND_TCHECK(var) ND_TCHECK2(var, sizeof(var))
  #define UNALIGNED_MEMCPY(p, q, l)	memcpy((p), (q), (l))

  const unsigned char *snapend;

  static const unsigned char *
  ikev2_sub_print(const struct isakmp_gen *ext)
  {
      struct isakmp_gen e;

      while (ext) {
          ND_TCHECK(*ext);
          UNALIGNED_MEMCPY(&e, ext, sizeof(e));
          ND_TCHECK2(*ext, ntohs(e.len));
          ext = (const struct isakmp_gen *)((const char *)ext + ntohs(e.len));
      }
      return (const unsigned char *)ext;
  trunc:
      return NULL;
  }
  ```

test "rank1837: a check on a pointer cast from the source covers the copy, so the cast spelling is safe"
  lang c
  file print-isakmp.c
  reject VYQL-MEM-016
  code
  ```
  #include <stdint.h>
  #include <string.h>

  struct isakmp_gen {
      uint8_t  np;
      uint8_t  critical;
      uint16_t len;
  };

  struct ikev2_p {
      struct isakmp_gen h;
      uint8_t  p_no;      /* Proposal # */
      uint8_t  prot_id;   /* Protocol */
      uint8_t  spi_size;  /* SPI Size */
      uint8_t  num_t;     /* Number of Transforms */
  };

  #define ND_TTEST2(var, l) \
    (((uintptr_t)&(var) <= (uintptr_t)snapend - (l)))
  #define ND_TCHECK2(var, l) if (!ND_TTEST2(var, l)) goto trunc
  #define ND_TCHECK(var) ND_TCHECK2(var, sizeof(var))
  #define UNALIGNED_MEMCPY(p, q, l)	memcpy((p), (q), (l))

  const unsigned char *snapend;

  static const unsigned char *
  ikev2_p_print(const struct isakmp_gen *ext)
  {
      const struct ikev2_p *p;
      struct ikev2_p prop;

      p = (const struct ikev2_p *)ext;
      ND_TCHECK(*p);
      UNALIGNED_MEMCPY(&prop, ext, sizeof(prop));

      return (const unsigned char *)ext + ntohs(prop.h.len);
  trunc:
      return NULL;
  }
  ```
