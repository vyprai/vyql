test "rank1838: a zero test spelled as an equality excludes zero just the same"
  lang c
  file src/common/utils_eq.c
  reject VYQL-MEM-067
  code
  ```
  #include <pcap.h>
  #include <stdio.h>
  #include <stdlib.h>

  #define MAXPACKET 65535

  u_char *checked_safe_pcap_next(pcap_t *pcap, struct pcap_pkthdr *pkthdr)
  {
      u_char *pktdata = (u_char *)pcap_next(pcap, pkthdr);

      if (pktdata) {
          if (pkthdr->len > MAXPACKET)
              exit(-1);
          if (pkthdr->len == 0)
              exit(-1);
          if (pkthdr->len < pkthdr->caplen)
              exit(-1);
      }

      return pktdata;
  }
  ```

test "rank1838: a positive capture-length bound excludes the zero buffer"
  lang c
  file src/common/utils_caplen.c
  reject VYQL-MEM-067
  code
  ```
  #include <pcap.h>
  #include <stdlib.h>

  #define MAXPACKET 65535

  u_char *caplen_guarded_pcap_next(pcap_t *pd, struct pcap_pkthdr *hdr)
  {
      u_char *pkt;
      int rc;

      if ((rc = pcap_next_ex(pd, &hdr, (const u_char **)&pkt)) > 0) {
          if (pkt != NULL && hdr->caplen > 0) {
              if (hdr->len > MAXPACKET)
                  exit(-1);
              return pkt;
          }
      }
      return NULL;
  }
  ```

test "rank1838: a reader that validates no length at all is not an incomplete validation"
  lang c
  file src/common/utils_bare.c
  reject VYQL-MEM-067
  code
  ```
  #include <pcap.h>

  struct Packet {
      const u_char *data;
      unsigned int len;
  };

  int read_packets(pcap_t *cap)
  {
      struct pcap_pkthdr *pkt_hdr;
      const u_char *data;
      int frame = 0;

      while (1 == pcap_next_ex(cap, &pkt_hdr, &data)) {
          struct Packet packet = { data, pkt_hdr->len };
          ++frame;
      }
      return frame;
  }
  ```

test "rank1838: the C++ spelling of the incompletely validated reader"
  lang cpp
  file src/common/utils.cpp
  expect VYQL-MEM-067
  code
  ```
  #include <pcap.h>
  #include <cstdlib>

  static const unsigned int kMaxPacket = 65535;

  unsigned char *SafePcapNext(pcap_t *pcap, struct pcap_pkthdr *pkthdr)
  {
      unsigned char *pktdata = reinterpret_cast<unsigned char *>(pcap_next(pcap, pkthdr));

      if (pktdata != nullptr) {
          if (pkthdr->len > kMaxPacket)
              std::exit(-1);
          if (pkthdr->len < pkthdr->caplen)
              std::exit(-1);
      }
      return pktdata;
  }
  ```

test "rank1838: the C++ spelling of the zero-excluding fix"
  lang cpp
  file src/common/utils.cpp
  reject VYQL-MEM-067
  code
  ```
  #include <pcap.h>
  #include <cstdlib>

  static const unsigned int kMaxPacket = 65535;

  unsigned char *SafePcapNext(pcap_t *pcap, struct pcap_pkthdr *pkthdr)
  {
      unsigned char *pktdata = reinterpret_cast<unsigned char *>(pcap_next(pcap, pkthdr));

      if (pktdata != nullptr) {
          if (pkthdr->len > kMaxPacket)
              std::exit(-1);
          if (!pkthdr->len || pkthdr->len < pkthdr->caplen)
              std::exit(-1);
      }
      return pktdata;
  }
  ```
