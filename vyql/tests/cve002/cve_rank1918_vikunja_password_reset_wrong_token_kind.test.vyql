test "rank1918: sibling flow looks up and removes the same kind"
  lang go
  file confirm.go
  reject VYQL-AUTH-117
  reject_review code.PasswordResetTokenReplay
  code
  ```
  package user

  import "xorm.io/xorm"

  type EmailConfirm struct {
  	Token string
  }

  func ConfirmEmailAddress(s *xorm.Session, c *EmailConfirm) (err error) {
  	token, err := getToken(s, c.Token, TokenEmailConfirm)
  	if err != nil {
  		return
  	}
  	if token == nil {
  		return ErrInvalidEmailConfirmToken{Token: c.Token}
  	}

  	user, err := GetUserByID(s, token.UserID)
  	if err != nil {
  		return
  	}

  	user.Status = StatusActive
  	_, err = s.Cols("status").Where("id = ?", user.ID).Update(user)
  	if err != nil {
  		return
  	}

  	err = removeTokens(s, user, TokenEmailConfirm)
  	return
  }
  ```
