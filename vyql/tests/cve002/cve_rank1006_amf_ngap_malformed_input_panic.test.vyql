# Rank 1006 / CVE-2026-9298: omec-project/amf NGAP crash on malformed input.
# The advisory (VulDB, CWE-119, PathSwitchRequest handler) describes remotely
# triggerable memory corruption; in Go this is a panic (nil-pointer dereference
# or index out of range) that crashes the AMF. Fix 34bc6724ac (PR #666) is a
# broad hardening pass: it adds nil-checks on decoded NGAP information elements
# across many handlers (RANUENGAPID / AMFUENGAPID in the PathSwitchRequest path,
# nil PDU / connection / RAN guards in the dispatcher) and length validation in
# util.PlmnIdStringToModels, which sliced plmnId[:3] and plmnId[3:] with no
# length check and panics on a short string.
#
# ATTENTION, no precise generic detection.
#  - The dominant fix is a nil-check before dereferencing a decoded protocol
#    field. Flagging that generically would flag essentially every Go pointer
#    dereference of decoded input, which is ordinary code everywhere; a decoded
#    NGAP IE is not distinguishable from any other pointer without protocol
#    knowledge the binding layer does not carry.
#  - The concrete out-of-bounds in PlmnIdStringToModels (a string sliced at a
#    hardcoded offset with no length guard) has no source or sink model today.
#    A generic "fixed-offset string slice without a length check" sink fires on
#    common safe slicing such as s[:3] where an upstream check guarantees the
#    length; a protocol-decode source feeding an out-of-bounds slice sink is
#    heavy, protocol-specific machinery. Minting a PathSwitchRequest- or
#    PlmnId-specific concept is the concept-per-CVE bloat the batch discipline
#    warns against.
#
# verify_current_expected: attention-precision-cost

test "rank1006: PlmnId string sliced at fixed offsets with no length check panics"
  lang go
  file util/convert.go
  reject VYQL-MEM-006
  code
  ```
  package util

  import "github.com/omec-project/openapi/models"

  func PlmnIdStringToModels(plmnId string) (plmnID models.PlmnId) {
      plmnID.Mcc = plmnId[:3]
      plmnID.Mnc = plmnId[3:]
      return
  }
  ```

test "rank1006: fix validates the PlmnId length and digits before slicing"
  lang go
  file util/convert.go
  reject VYQL-MEM-006
  code
  ```
  package util

  import (
      "fmt"

      "github.com/omec-project/openapi/models"
  )

  func PlmnIdStringToModels(plmnId string) (plmnID models.PlmnId, err error) {
      if len(plmnId) < 5 || len(plmnId) > 6 {
          return models.PlmnId{}, fmt.Errorf("invalid PLMN ID length %d", len(plmnId))
      }
      for _, digit := range plmnId {
          if digit < '0' || digit > '9' {
              return models.PlmnId{}, fmt.Errorf("invalid PLMN ID %q", plmnId)
          }
      }
      plmnID.Mcc = plmnId[:3]
      plmnID.Mnc = plmnId[3:]
      return plmnID, nil
  }
  ```
