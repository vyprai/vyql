  ```

test "tophat: the install result's enum case binding carries the requests to the shell"
  lang swift
  file InstallResult.swift
  expect VYQL-INJ-002
  code
  ```
  import Foundation

  enum URLReaderResult {
  	case install(requests: [String])
  }

  final class AppDelegate: NSObject, NSApplicationDelegate {
  	func application(_ application: NSApplication, open urls: [URL]) {
  		for url in urls {
  			let result = read(url: url)
  			switch result {
  				case .install(let requests):
  					for request in requests {
  						system("adb shell " + request)
  					}
  			}
  		}
  	}
  }

  func read(url: URL) -> URLReaderResult {
  	let components = URLComponents(url: url, resolvingAgainstBaseURL: true)
  	let value = components?.queryItems?.first??.value ?? ""
  	return .install(requests: [value])
  }
  ```

test "tophat: the whole distilled chain, from query binning to the joined command string"
  lang swift
  file Tophat.swift
  expect VYQL-INJ-002
  code
  ```
  import Foundation

  enum URLReaderResult {
  	case install(requests: [InstallRecipe])
  }

  struct InstallRecipe {
  	let launchArguments: [String]
  }

  protocol Device {
  	func launch(arguments: [String]) throws
  }

  enum AdbCommand {
  	case launch(serial: String, arguments: [String])

  	var string: String {
  		switch self {
  			case .launch(let serial, let arguments):
  				return ["-s", serial, "shell", "am", "start", "--esa", arguments.joined(separator: ",")].joined(separator: " ")
  		}
  	}
  }

  struct AdbDevice: Device {
  	func launch(arguments: [String]) throws {
  		try ShellCommandRunner.run(command: AdbCommand.launch(serial: "emulator-1", arguments: arguments))
  	}
  }

  struct ShellCommandRunner {
  	static func run(command: AdbCommand) throws {
  		system(command.string)
  	}
  }

  final class AppDelegate: NSObject, NSApplicationDelegate {
  	func application(_ application: NSApplication, open urls: [URL]) {
  		do {
  			for url in urls {
  				let urlReaderResult = try read(url: url)
  				switch urlReaderResult {
  					case .install(let recipes):
  						launchApp(recipes: recipes)
  				}
  			}
  		} catch {}
  	}

  	func launchApp(recipes: [InstallRecipe]) {
  		for recipe in recipes {
  			do {
  				let device = AdbDevice()
  				try device.launch(arguments: recipe.launchArguments)
  			} catch {}
  		}
  	}
  }

  func read(url: URL) throws -> URLReaderResult {
  	let components = URLComponents(url: url, resolvingAgainstBaseURL: true)
  	let queryItems = components?.queryItems ?? []
  	let binned = Dictionary(grouping: queryItems, by: { element in element.name }).mapValues { items in
  		items.compactMap { item in item.value }
  	}
  	let launchArguments = binned["arguments"]?.first?.split(separator: ",").map(String.init) ?? []
  	return .install(requests: [InstallRecipe(launchArguments: launchArguments)])
  }
  ```

test "tophat: the change's own guard and single-quote wrapping leave the stand-in sink reporting"
  lang swift
  file Patched.swift
  expect VYQL-INJ-002
  code
  ```
  import Foundation

  enum URLReaderResult {
  	case install(requests: [String])
  }

  final class AppDelegate: NSObject, NSApplicationDelegate {
  	func application(_ application: NSApplication, open urls: [URL]) {
  		for url in urls {
  			let result = read(url: url)
  			switch result {
  				case .install(let requests):
  					launch(arguments: requests)
  			}
  		}
  	}

  	func launch(arguments: [String]) {
  		guard arguments.allSatisfy({ $0.allSatisfy { $0.isLetter || $0.isNumber } }) else {
  			return
  		}
  		let formatted = arguments.map { argument in
  			"'" + argument.replacingOccurrences(of: "'", with: "'\\''") + "'"
  		}
  		system("adb shell " + formatted.joined(separator: " "))
  	}
  }

  func read(url: URL) -> URLReaderResult {
  	let components = URLComponents(url: url, resolvingAgainstBaseURL: true)
  	let value = components?.queryItems?.first??.value ?? ""
  	return .install(requests: [value])
  }
  ```
