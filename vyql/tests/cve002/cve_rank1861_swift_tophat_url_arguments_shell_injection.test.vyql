  ```

test "tophat: the same flow through a subscripted url reports too"
  lang swift
  file Subscript.swift
  expect VYQL-INJ-002
  code
  ```
  import Foundation

  final class AppDelegate: NSObject, NSApplicationDelegate {
  	func application(_ application: NSApplication, open urls: [URL]) {
  		let url = urls[0]
