# Rank 1929 / CVE-2022-24845 / GHSA-j2x6-9323-fp7h (recorded language python;
# the axis is a compiler-correctness defect, CWE-787 via missing returndata
# validation, not a taint path). vyper's codegen lets unvalidated external
# call returndata into the generated contract in two ways. First, a signature
# imported from a .json ABI is flagged is_from_json, so _returndata_encoding
# (vyper/codegen/external_call.py:62 at the parent) tags the returndata
# buffer Encoding.JSON_ABI rather than Encoding.ABI, and needs_clamp
# (vyper/codegen/core.py:703) then exempts bytestrings and dynamic arrays
# under that encoding -- "don't have bytestring size bound from json, don't
# clamp" -- so a malicious callee's declared length is trusted and the
# generated EVM code walks past the allocated returndata buffer. Second, in
# complex expressions the inferred type of the Call expression takes a
# codegen path that skips clamp generation entirely:
# convert(self.foo.returns_int128(), uint256) and
# concat(self.foo.returns_Bytes3(), b"") both carry unvalidated returndata
# into the runtime. The fixed revision 049dbdc deletes the JSON_ABI encoding outright
# and makes _unpack_returndata strictly decode the returndata into a
# freshly allocated buffer whenever needs_clamp holds, so no unvalidated
# byte can escape the call site.
#
# Measured, both revisions, three --cache off runs each over vyper/'s 98
# python files: 21 findings at or above high on the vulnerable parent and 21
# on the fixed revision, identical rule multisets (VYQL-AUTH-098/099/105/106,
# VYQL-PATH-001 six times, VYQL-SMELL-AUTHZ); every row is CLI
# mass-assignment noise -- core.UserControlledData at cli/vyper_compile.py:148
# or cli/vyper_json.py:74 flowing into code.MassAssignmentSink over the AST
# and IR builders. Nothing at or near external_call.py, core.py's
# needs_clamp, or any encoding artifact. vyql match on the two vulnerable
# files labels only code.Param / code.ExternalEntryInput on
# _external_call_helper's parameters and a core.PathAccessCheck flag on an
# `in` comparison; no sink, no bound, no buffer fact.
#
# Reuse is checked before minting. code.RawMemoryCopySizeSink (VYQL-MEM-003
# tainted, VYQL-MEM-016 potential, CWE-787 "raw memory copy size expression
# needs bounds review") is the nearest judgement class -- external data
# entering a buffer whose size is not validated -- and is the rule these
# cases pin. code.ComputedSizeValue, code.UnvalidatedDeserializedCollection
# and the subscript analyses (code.FieldDerivedIndexAccess,
# code.ZeroCountLastElementAccess) each require a real memory access or a
# decode call in the source; none fits code that only constructs IR lists.
#
# No binding can emit any of them here without keying on the incident. The
# untrusted bytes are the EVM's returndata at the compiled contract's
# runtime -- the Python compiler never reads, writes or copies them, so
# there is no source and no sink in the dataflow sense. Every artifact that
# discriminates the revisions is the fixed revision's own vocabulary: the JSON_ABI enum
# member, the is_from_json branch, the needs_clamp helper and the strict
# make_setter(buf2, buf) copy. All are vyper-private codegen internals with
# no existence outside this repository -- a grep across every clone under
# /tmp/cve-work/rank*/ finds Encoding.JSON_ABI and is_from_json nowhere else
# -- so the rename test fails and the genericity test fails: nobody writes
# these bindings from library documentation. The one discriminating negation
# ("_unpack_returndata never consults needs_clamp") is the 1394 Otp-substring
# trap, and the complex-expression path is repaired by the same
# unconditional strict decode, so its Python text is identical in both
# revisions and no function-scoped binding on it can discriminate at all.
# Compiler-correctness family: the vulnerability is a property of the
# generated bytecode, which no local structure of the compiler's Python
# carries -- 1825's constant-value family is the nearest measured sibling.
#
# All cases assert reject VYQL-MEM-003 and VYQL-MEM-016: nothing fires today.
# If compiler-output validation vocabulary ever lands, the first two cases
# must flip to expect while the patched case stays reject.
#
# verify_current_expected: attention-vocabulary-gap, both revisions rejected.

test "rank1929: needs_clamp exempts bytestrings returndata from json interfaces"
  lang python
  reject VYQL-MEM-003
  reject VYQL-MEM-016
  file vyper/codegen/core.py
  code
  ```
  from vyper.codegen.ir_node import Encoding, IRnode
  from vyper.codegen.types import (
      BaseType,
      ByteArrayLike,
      DArrayType,
      SArrayType,
      TupleLike,
  )


  # returns True if t is ABI encoded and is a type that needs any kind of
  # validation
  def needs_clamp(t, encoding):
      if encoding not in (Encoding.ABI, Encoding.JSON_ABI):
          return False
      if isinstance(t, (ByteArrayLike, DArrayType)):
          if encoding == Encoding.JSON_ABI:
              # don't have bytestring size bound from json, don't clamp
              return False
          return True
      if isinstance(t, BaseType) and t.typ not in ("int256", "uint256", "bytes32"):
          return True
      if isinstance(t, SArrayType):
          return needs_clamp(t.subtype, encoding)
      if isinstance(t, TupleLike):
          return any(needs_clamp(m, encoding) for m in t.tuple_members())
      return False
  ```

test "rank1929: json interface returndata buffer is handed downstream without a strict decode"
  lang python
  reject VYQL-MEM-003
  reject VYQL-MEM-016
  file vyper/codegen/external_call.py
  code
  ```
  from vyper.address_space import MEMORY
  from vyper.codegen.core import (
      calculate_type_for_external_return,
      get_element_ptr,
  )
  from vyper.codegen.ir_node import Encoding, IRnode


  def _returndata_encoding(contract_sig):
      if contract_sig.is_from_json:
          return Encoding.JSON_ABI
      return Encoding.ABI


  def _unpack_returndata(buf, contract_sig, skip_contract_check, context):
      return_t = contract_sig.return_type
      if return_t is None:
          return ["pass"], 0, 0

      return_t = calculate_type_for_external_return(return_t)
      # if the abi signature has a different type than
      # the vyper type, we need to wrap and unwrap the type
      # so that the ABI decoding works correctly
      should_unwrap_abi_tuple = return_t != contract_sig.return_type

      abi_return_t = return_t.abi_type
      min_return_size = abi_return_t.min_size()
      max_return_size = abi_return_t.size_bound()
      assert 0 < min_return_size <= max_return_size

      # revert when returndatasize is not in bounds
      ret = []
      if not skip_contract_check:
          ret += [["assert", ["gt", "returndatasize", min_return_size - 1]]]

      # the returndata buffer is handed downstream tagged with the json
      # encoding, which exempts it from every clamp the consumer would add
      buf = IRnode(buf, typ=return_t, encoding=_returndata_encoding(contract_sig), location=MEMORY)

      if should_unwrap_abi_tuple:
          buf = get_element_ptr(buf, 0, array_bounds_check=False)

      ret += [buf]

      return ret, buf, max_return_size
  ```

test "rank1929: strict returndata decode clamps into a fresh buffer at the call site"
  lang python
  reject VYQL-MEM-003
  reject VYQL-MEM-016
  file vyper/codegen/external_call.py
  code
  ```
  from vyper.address_space import MEMORY
  from vyper.codegen.core import (
      calculate_type_for_external_return,
      check_assign,
      dummy_node_for_type,
      make_setter,
      needs_clamp,
  )
  from vyper.codegen.ir_node import Encoding, IRnode
  from vyper.codegen.types import TupleType
  from vyper.codegen.types.convert import new_type_to_old_type


  def _unpack_returndata(buf, contract_sig, skip_contract_check, context, expr):
      # expr.func._metadata["type"].return_type is more accurate
      # than contract_sig.return_type in the case of JSON interfaces.
      ast_return_t = expr.func._metadata["type"].return_type

      if ast_return_t is None:
          return ["pass"], 0, 0

      # sanity check
      return_t = new_type_to_old_type(ast_return_t)
      check_assign(dummy_node_for_type(return_t), dummy_node_for_type(contract_sig.return_type))

      return_t = calculate_type_for_external_return(return_t)
      abi_return_t = return_t.abi_type
      min_return_size = abi_return_t.min_size()

      # revert when returndatasize is not in bounds
      ret = []
      if not skip_contract_check:
          ret += [["assert", ["ge", "returndatasize", min_return_size]]]

      encoding = Encoding.ABI

      buf = IRnode.from_list(
          buf,
          typ=return_t,
          location=MEMORY,
          encoding=encoding,
          annotation=f"{expr.node_source_code} returndata buffer",
      )

      assert isinstance(return_t, TupleType)
      # unpack strictly
      if needs_clamp(return_t, encoding):
          buf2 = IRnode.from_list(
              context.new_internal_variable(return_t), typ=return_t, location=MEMORY
          )

          ret.append(make_setter(buf2, buf))
          ret.append(buf2)
      else:
          ret.append(buf)

      return ret, buf, 0
  ```
