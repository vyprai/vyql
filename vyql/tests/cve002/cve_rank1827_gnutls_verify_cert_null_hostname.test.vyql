  expect VYQL-CFG-004
  code
  ```
  #include <gnutls/socket.h>

  int connect_upstream(gnutls_session_t gs) {
          gnutls_init(&gs, GNUTLS_CLIENT);
          gnutls_session_set_verify_cert(gs, NULL, 0);
