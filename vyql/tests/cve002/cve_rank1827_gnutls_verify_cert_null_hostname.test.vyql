test "rank1827: the C++ spelling of the identity-bearing fix"
  lang cpp
  file src/tls/gnutls_client.cpp
  reject VYQL-CFG-004
  code
  ```
  #include <gnutls/socket.h>

  int connect_upstream(gnutls_session_t gs, unsigned char *ip, unsigned ip_len) {
          gnutls_typed_vdata_st vdata[1];

          gnutls_init(&gs, GNUTLS_CLIENT);
          vdata[0].type = GNUTLS_DT_IP_ADDRESS;
          vdata[0].data = ip;
          vdata[0].size = ip_len;
          gnutls_session_set_verify_cert2(gs, vdata, 1, 0);
          return gnutls_handshake(gs);
  }
  ```
