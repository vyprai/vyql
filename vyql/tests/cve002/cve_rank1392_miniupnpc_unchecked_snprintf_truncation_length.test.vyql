  ```
  #include <stdio.h>

  int send_request(int s, const char * path, const char * host)
  {
  	char buf[2048];
  	int len;
  	int sent;
  	int n;

  	len = snprintf(buf, sizeof(buf), "GET %s HTTP/1.1\r\nHost: %s\r\n\r\n", path, host);
  	sent = 0;
  	while(sent < len)
  	{
  		n = send(s, buf + sent, len - sent, 0);
  		if(n < 0)
  			return -1;
  		sent += n;
  	}
  	return 0;
  }
  ```

test "rank1392: the measure-then-format idiom consumes the reported length as a bound and stays quiet"
  lang c
  file miniupnpc/minihttptestserver.c
  reject VYQL-MEM-073
  code
  ```
  #include <stdio.h>
  #include <stdlib.h>

  char * format_pubkey(const char * privkey)
  {
  	char * pubkey;
  	int n;

  	if((n = snprintf(NULL, 0, "%s.pub", privkey)) < 0)
  		return NULL;
  	if((pubkey = malloc(n + 1)) == NULL)
  		return NULL;
  	if((n = snprintf(pubkey, n + 1, "%s.pub", privkey)) < 0)
  		return NULL;
  	return pubkey;
  }
  ```

