test "rank1392: minimal pair -- a send length read from the socket is reported as size arithmetic"
  lang c
  file miniupnpc/miniwget.c
  expect VYQL-NUM-003
  reject VYQL-MEM-073
  code
  ```
  #include <stdio.h>

  int send_request(int s, const char * path, const char * host)
  {
  	char buf[2048];
  	int len;
  	int sent;
  	int n;

  	len = recv(s, buf, sizeof(buf), 0);
  	sent = 0;
  	while(sent < len)
  	{
  		n = send(s, buf + sent, len - sent, 0);
  		if(n < 0)
  			return -1;
  		sent += n;
  	}
  	return 0;
  }
  ```

test "rank1392: minimal pair -- the same send length reported by snprintf is the formatted-length miss"
