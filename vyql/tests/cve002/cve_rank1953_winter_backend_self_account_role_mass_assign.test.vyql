test "rank1953: the patched context resolution and save hook leave the designed save path in place"
  lang php
  file myaccount-save-patched.php
  reject VYQL-INJ-012
  code
  ```
  <?php

  class FormWidget {
      public $context;
      public $allFields = array('login', 'email');

      public function getSaveData() {
          $result = array();
          $data = post('User');
          foreach ($this->allFields as $field) {
              if (isset($data[$field])) {
                  $result[$field] = $data[$field];
              }
          }
          return $result;
      }
  }

  class FormControllerBehavior {
      public $context = 'myaccount';

      public function formGetContext() {
          return $this->context;
      }

      public function update_onSave($recordId = null, $context = null) {
          $model = BackendAuth::findUserById($recordId);
          $context = $this->context = $context ?? $this->formGetContext();
          $saveData = $this->formWidget->getSaveData();
          $this->setModelAttributes($model, $saveData);
          $model->save();
      }

      public function setModelAttributes($model, $saveData) {
          foreach ($saveData as $attribute => $value) {
              $model->{$attribute} = $value;
          }
      }
  }

  class User {
      public function beforeSave() {
          $actor = BackendAuth::getUser();
          if ($actor && $actor->getKey() === $this->getKey()
              && $this->isDirty(array('role_id', 'is_superuser', 'permissions'))) {
              throw new AuthorizationException('denied');
          }
      }
  }

  function post($key, $default = null) {
      return $_POST[$key] ?? $default;
  }
  ```
