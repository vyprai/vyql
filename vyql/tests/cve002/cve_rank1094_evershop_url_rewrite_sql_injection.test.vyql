# Rank 1094 / CVE-2026-25993: Evershop rebuilt url_rewrite rows for a
# category's subcategories and products by interpolating the request path and
# the new URL key straight into a raw SQL string (CWE-89).
# packages/evershop/src/modules/catalog/subscribers/category_updated/builUrlRewrite.ts
# had
#
#   await execute(
#     pool,
#     `UPDATE url_rewrite SET request_path = REPLACE(request_path, '${currentPath.request_path}', '${path}') WHERE entity_type IN ('category', 'product') AND entity_uuid != '${categoryUUid}'`
#   );
#
# with path coming from the category's URL key, editable through the admin
# catalog UI. The sibling subscriber deleteUrlRewrite.ts has the same shape on
# a DELETE. Pool commit 5c5bdf2c1ad5 is the real fix; both subscribers switch
# from execute(pool, sqlString) to pool.query(sqlString, [params]), and the
# category, product and CMS page data schemas gain stricter validation on the
# fields that feed these queries.
#
# FIXED. The diagnosis found the shipped execute() sink binding anchored at
# args[0], which is the SqlExecution sink for the common connection.execute(sql,
# params) idiom (SQL string first). @evershop/postgres-query-builder's
# standalone execute function has the opposite signature -- its own published
# type declares execute(connection: PoolClient | Pool, query: string) -- so
# every call through this specific library has its SQL string at args[1], never
# checked, and args[0] is the pool object, which can never carry attacker
# taint. Measured directly: execute(pool, tainted) reported 0 findings before
# this change regardless of whether the string was a plain variable, a `+`
# concatenation or a template literal, and reported 1 (VYQL-INJ-001) after a
# new binding, gated on import("@evershop/postgres-query-builder") and
# anchored at args[1], was added beside the existing one. The gate reads the
# file's own import statement, so no package.json is needed for the specs
# below to exercise it. The generic args[0] binding is untouched, so the far
# more common connection.execute(sql, params) shape used elsewhere in the
# corpus is unaffected. Definition change: vyql/bindings/javascript/mfb63017a.vyql,
# new binding sqlExecution131a.
#
# make test green; OWASP Java holds at +1.00 and Python at +0.90.
#
# verify_current_expected: fixed

test "rank1094: the url key is interpolated into a raw SQL update"
  lang javascript
  file packages/evershop/src/modules/catalog/subscribers/category_updated/builUrlRewrite.ts
  expect VYQL-INJ-001
  code
  ```
  import { execute, select } from '@evershop/postgres-query-builder';
  import { pool } from '../../../../lib/postgres/connection.js';

  async function buildUrlReWrite(data) {
    const { uuid: categoryUUid, url_key: path } = data;
    const request = await getIncomingRequest();
    const currentPath = { request_path: request.query.old_path };
    if (currentPath) {
      await execute(
        pool,
        `UPDATE url_rewrite SET request_path = REPLACE(request_path, '${currentPath.request_path}', '${path}') WHERE entity_type IN ('category', 'product') AND entity_uuid != '${categoryUUid}'`
      );
    }
  }
  ```

test "rank1094: the fix parameterizes the same update"
  lang javascript
  file packages/evershop/src/modules/catalog/subscribers/category_updated/builUrlRewrite.ts
  reject VYQL-INJ-001
  code
  ```
  import { select } from '@evershop/postgres-query-builder';
  import { pool } from '../../../../lib/postgres/connection.js';

  async function buildUrlReWrite(data) {
    const { uuid: categoryUUid, url_key: path } = data;
    const request = await getIncomingRequest();
    const currentPath = { request_path: request.query.old_path };
    if (currentPath) {
      await pool.query(
        `UPDATE url_rewrite SET request_path = REPLACE(request_path, $1, $2) WHERE entity_type IN ('category', 'product') AND entity_uuid != $3`,
        [currentPath.request_path, path, categoryUUid]
      );
    }
  }
  ```

# The argument-position pair. Same execute() call from the same library;
# only which position carries the tainted value differs.

test "rank1094: a tainted SQL string in evershop's execute(connection, query) reports"
  lang javascript
  file args1.ts
  expect VYQL-INJ-001
  code
  ```
  import { execute } from '@evershop/postgres-query-builder';

  async function handler(request) {
    const path = request.body.url_key;
    await execute(pool, `UPDATE url_rewrite SET request_path = '${path}' WHERE id = 1`);
  }
  ```

test "rank1094: the same call with the connection argument tainted instead"
  lang javascript
  file args0.ts
  expect VYQL-INJ-001
  code
  ```
  import { execute } from '@evershop/postgres-query-builder';

  async function handler(request) {
    const poolLike = request.body.pool;
    await execute(poolLike, "SELECT 1");
  }
  ```
