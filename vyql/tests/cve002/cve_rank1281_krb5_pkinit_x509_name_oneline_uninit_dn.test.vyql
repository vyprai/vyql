# Rank 1281 / CVE-2017-15088: krb5's PKINIT preauth built a certificate's
# subject and issuer DNs into a fixed-size stack buffer, buf[DN_BUF_LEN]
# (256), via X509_NAME_oneline_ex(cert_name, buf, &bufsize, flag). That
# helper's contract -- stated in its own definition comment -- makes size
# an in/out parameter: on input the buffer's capacity, on output the
# rendered length. The body keeps the contract: when the rendered name
# needs more bytes than the buffer holds, only *size is updated and buf
# is left untouched. A certificate controls how long the rendered name
# is, and this runs during PKINIT cert matching before authentication
# completes, so a crafted certificate leaves buf holding whatever is on
# the stack while get_matching_data strdup()s it regardless, with no
# check on the size parameter and none possible on the return, which is
# buf itself in every case (CWE-908's CWE-824 child: an invalid read of
# uninitialized stack memory, and since strdup keeps reading until it
# finds a NUL, potentially past the frame).
#
# Fix commit fbb687db1088ddd894d975996e5f6a4252b9a2b4 deletes the helper
# and every call site: rfc2253_name() renders into a memory BIO and
# calloc()s a buffer sized exactly to BIO_number_written() plus a NUL, so
# there is no capacity ceiling to overrun and no path that leaves the
# output unpopulated, and each caller checks the returned error code
# before touching the string it produced.
#
# C now reports the unchecked call through code.UninitializedBufferExposure
# (VYQL-MEM-015), the same member rank 1155's h2o_url_init binding uses.
# The binding names the helper's documented contract and credits the two
# idioms that engage with the call's outcome -- a comparison lowers to a
# binary: token carrying the whole expression text, a capture into a named
# variable to an assign: token -- so the fixed revision, whose callers
# capture and test the replacement helper's error code, reports nothing.
# The anchor is exact-token, so the public X509_NAME_oneline, a different
# function that truncates into its buffer, is not drawn in.
#
# Residuals: a caller that captures or compares the call yet reads the
# buffer without consulting the size parameter clears (the safe direction
# for precision), and a two-pass measure-then-fill caller still reports,
# because only the caller's own locals name the size parameter and no
# token route can see the comparison.
#
# Measured on the real revision pair (src/plugins/preauth/pkinit, three
# --cache off runs each, timeout 180, --max-ram 6GB): the vulnerable
# revision reports VYQL-MEM-015 on get_matching_data, the fixed revision
# reports none; 557 -> 556 findings with every other rule identical and
# the one-count delta an unrelated VYQL-MEM-006 elsewhere. No other tree
# under /tmp/cve-work contains an X509_NAME_oneline_ex call site.
#
# verify_current_expected: fixed

test "rank1281: X509_NAME_oneline_ex leaves buf untouched when the DN overflows it"
  lang c
  file plugins/preauth/pkinit/pkinit_crypto_openssl.c
  expect VYQL-MEM-015
  code
  ```
  #include <stddef.h>
  #include <stdlib.h>
  #include <string.h>

  #define DN_BUF_LEN 256
  #define ENOMEM 12
  #define XN_FLAG_SEP_COMMA_PLUS 1

  typedef struct X509_NAME X509_NAME;
  typedef struct X509 X509;
  typedef int krb5_error_code;

  typedef struct pkinit_cert_matching_data {
      char *subject_dn;
      char *issuer_dn;
  } pkinit_cert_matching_data;

  X509_NAME *X509_get_subject_name(X509 *a);

  /*
   * Return a string format of an X509_NAME in buf where
   * size is an in/out parameter.  On input it is the size
   * of the buffer, and on output it is the actual length
   * of the name.
   * If buf is NULL, returns the length req'd to hold name
   */
  static char *
  X509_NAME_oneline_ex(X509_NAME *a, char *buf, unsigned int *size,
                       unsigned long flag);

  static krb5_error_code
  get_matching_data(X509 *cert, pkinit_cert_matching_data **md_out)
  {
      krb5_error_code ret = ENOMEM;
      pkinit_cert_matching_data *md = NULL;
      char buf[DN_BUF_LEN];
      unsigned int bufsize = sizeof(buf);

      *md_out = NULL;

      md = calloc(1, sizeof(*md));
      if (md == NULL)
          goto cleanup;

      /* Get the subject name (in rfc2253 format). */
      X509_NAME_oneline_ex(X509_get_subject_name(cert), buf, &bufsize,
                           XN_FLAG_SEP_COMMA_PLUS);
      md->subject_dn = strdup(buf);
      if (md->subject_dn == NULL) {
          ret = ENOMEM;
          goto cleanup;
      }

      *md_out = md;
      md = NULL;
      ret = 0;

  cleanup:
      free(md);
      return ret;
  }
  ```

test "rank1281: rfc2253_name allocates exactly what it renders and every caller checks it"
  lang c
  file plugins/preauth/pkinit/pkinit_crypto_openssl.c
  reject VYQL-MEM-015
  code
  ```
  #include <stddef.h>
  #include <stdlib.h>
  #include <string.h>

  #define ENOMEM 12
  #define XN_FLAG_SEP_COMMA_PLUS 1

  typedef struct X509_NAME X509_NAME;
  typedef struct X509 X509;
  typedef struct BIO BIO;
  typedef int krb5_error_code;

  typedef struct pkinit_cert_matching_data {
      char *subject_dn;
      char *issuer_dn;
  } pkinit_cert_matching_data;

  X509_NAME *X509_get_subject_name(X509 *a);
  BIO *BIO_new(const void *type);
  const void *BIO_s_mem(void);
  int X509_NAME_print_ex(BIO *b, X509_NAME *name, int indent, unsigned long flags);
  size_t BIO_number_written(BIO *b);
  int BIO_read(BIO *b, void *data, int len);
  int BIO_free(BIO *b);

  static krb5_error_code
  rfc2253_name(X509_NAME *name, char **str_out)
  {
      BIO *b = NULL;
      char *str;

      *str_out = NULL;
      b = BIO_new(BIO_s_mem());
      if (b == NULL)
          return ENOMEM;
      if (X509_NAME_print_ex(b, name, 0, XN_FLAG_SEP_COMMA_PLUS) < 0)
          goto error;
      str = calloc(BIO_number_written(b) + 1, 1);
      if (str == NULL)
          goto error;
      BIO_read(b, str, (int)BIO_number_written(b));
      BIO_free(b);
      *str_out = str;
      return 0;

  error:
      BIO_free(b);
      return ENOMEM;
  }

  static krb5_error_code
  get_matching_data(X509 *cert, pkinit_cert_matching_data **md_out)
  {
      krb5_error_code ret = ENOMEM;
      pkinit_cert_matching_data *md = NULL;

      *md_out = NULL;

      md = calloc(1, sizeof(*md));
      if (md == NULL)
          goto cleanup;

      ret = rfc2253_name(X509_get_subject_name(cert), &md->subject_dn);
      if (ret)
          goto cleanup;

      *md_out = md;
      md = NULL;
      ret = 0;

  cleanup:
      free(md);
      return ret;
  }
  ```
