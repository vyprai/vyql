test "rank1552: a vulnerable parse-path pin nothing imports is present but not reachable"
  lang javascript
  file lib/index.js
  code
  ```
  "use strict"

  const normalizeUrl = require("normalize-url")

  function normalize(input) {
      return normalizeUrl(input, { stripHash: false })
  }

  module.exports = normalize;
  ```
  file package.json
  code
  ```
  {
    "name": "parse-url",
    "version": "5.0.8",
    "description": "An advanced url parser supporting git urls too.",
    "main": "lib/index.js",
    "dependencies": {
      "is-ssh": "^1.3.0",
      "normalize-url": "^6.1.0",
      "parse-path": "^4.0.4",
      "protocols": "^1.4.0"
    }
  }
  ```
  expect VYQL-SCA-001
  reject VYQL-SCA-002
