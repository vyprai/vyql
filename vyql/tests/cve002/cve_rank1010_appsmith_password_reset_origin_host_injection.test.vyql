# Rank 1010 / CVE-2026-22794: Appsmith account takeover through password-reset
# Origin header injection. The forgotPassword endpoint binds the request Origin
# header onto the reset DTO (UserControllerCE.forgotPasswordRequest does
# userPasswordDTO.setBaseUrl(originHeader)), and UserServiceCEImpl
# .forgotPasswordTokenGenerate formats the reset-token link from
# resetUserPasswordDTO.getBaseUrl() and emails it, so a spoofed Origin makes the
# victim's reset email link to the attacker host carrying the real token
# (CWE-346, CWE-640). The fixed revision adds validateBaseUrl(), which rejects
# a provided base URL that does not equal the configured APPSMITH_BASE_URL when
# it is set, and moves the link build into processForgotPasswordTokenGeneration.
#
# ATTENTION, genericity gap. The concept and rule exist
# (code.PasswordRecoveryLinkHostControl / VYQL-AUTH-003, CWE-640) but only PHP
# bindings emit it, and the request-supplied-site-URL sibling
# (code.UntrustedSupportUrlNotification / VYQL-VAL-018) is likewise PHP-only,
# so neither reaches this code. No rule reports the flow on the real checkout,
# and the one rule that follows it (VYQL-INJ-004) labels the reset-URL
# String.format as code.HtmlRender and fires identically on the fixed revision,
# because validateBaseUrl() does not clear taint. Every binding that would
# separate the two revisions keys on the fix's own layout: at function scope
# the extracted helper carries the identical build-and-send shape; at class
# scope only the fix's own identifiers (appsmithBaseUrl, validateBaseUrl)
# separate the classes, while @Value / annotationArg / field / selector tokens
# are not emitted into the Java class context; and the controller, where the
# request header is bound, is unchanged by the fix. Both snippets reject.
#
# verify_current_expected: attention-vocabulary-gap, both revisions rejected.

test "rank1010: reset link built from request Origin baseUrl with no base-URL validation"
  lang java
  file UserServiceCEImpl.java
  reject VYQL-AUTH-003
  code
  ```
  public class UserServiceCEImpl {
      private static final String FORGOT_PASSWORD_CLIENT_URL_FORMAT = "%s/user/resetPassword?token=%s";

      public Mono<Boolean> forgotPasswordTokenGenerate(ResetUserPasswordDTO resetUserPasswordDTO) {
          if (resetUserPasswordDTO.getEmail() == null
                  || resetUserPasswordDTO.getEmail().isBlank()) {
              return Mono.error(new AppsmithException(AppsmithError.INVALID_PARAMETER, FieldName.EMAIL));
          }

          if (resetUserPasswordDTO.getBaseUrl() == null
                  || resetUserPasswordDTO.getBaseUrl().isBlank()) {
              return Mono.error(new AppsmithException(AppsmithError.INVALID_PARAMETER, FieldName.ORIGIN));
          }

          final String token = UUID.randomUUID().toString();
          String email = resetUserPasswordDTO.getEmail();

          List<NameValuePair> nameValuePairs = new ArrayList<>(2);
          nameValuePairs.add(new BasicNameValuePair("email", email));
          nameValuePairs.add(new BasicNameValuePair("token", token));
          String urlParams = WWWFormCodec.format(nameValuePairs, StandardCharsets.UTF_8);
          String resetUrl = String.format(
                  FORGOT_PASSWORD_CLIENT_URL_FORMAT,
                  resetUserPasswordDTO.getBaseUrl(),
                  EncryptionHelper.encrypt(urlParams));

          return emailService
                  .sendForgotPasswordEmail(email, resetUrl, resetUserPasswordDTO.getBaseUrl())
                  .thenReturn(true);
      }
  }
  ```

test "rank1010: fix validates the provided base URL against APPSMITH_BASE_URL first"
  lang java
  file UserServiceCEImpl.java
  reject VYQL-AUTH-003
  code
  ```
  public class UserServiceCEImpl {
      private static final String FORGOT_PASSWORD_CLIENT_URL_FORMAT = "%s/user/resetPassword?token=%s";

      @Value("${APPSMITH_BASE_URL:}")
      private String appsmithBaseUrl;

      private Mono<Void> validateBaseUrl(String providedBaseUrl) {
          if (!StringUtils.hasText(appsmithBaseUrl)) {
              return Mono.empty();
          }
          if (!appsmithBaseUrl.equals(providedBaseUrl)) {
              return Mono.error(new AppsmithException(
                      AppsmithError.GENERIC_BAD_REQUEST,
                      "Origin header does not match APPSMITH_BASE_URL configuration."));
          }
          return Mono.empty();
      }

      public Mono<Boolean> forgotPasswordTokenGenerate(ResetUserPasswordDTO resetUserPasswordDTO) {
          if (resetUserPasswordDTO.getBaseUrl() == null
                  || resetUserPasswordDTO.getBaseUrl().isBlank()) {
              return Mono.error(new AppsmithException(AppsmithError.INVALID_PARAMETER, FieldName.ORIGIN));
          }

          return validateBaseUrl(resetUserPasswordDTO.getBaseUrl()).then(Mono.defer(() -> {
              String email = resetUserPasswordDTO.getEmail();
              return processForgotPasswordTokenGeneration(email, resetUserPasswordDTO);
          }));
      }

      private Mono<Boolean> processForgotPasswordTokenGeneration(
              String email, ResetUserPasswordDTO resetUserPasswordDTO) {
          final String token = UUID.randomUUID().toString();

          List<NameValuePair> nameValuePairs = new ArrayList<>(2);
          nameValuePairs.add(new BasicNameValuePair("email", email));
          nameValuePairs.add(new BasicNameValuePair("token", token));
          String urlParams = WWWFormCodec.format(nameValuePairs, StandardCharsets.UTF_8);
          String resetUrl = String.format(
                  FORGOT_PASSWORD_CLIENT_URL_FORMAT,
                  resetUserPasswordDTO.getBaseUrl(),
                  EncryptionHelper.encrypt(urlParams));

          return emailService
                  .sendForgotPasswordEmail(email, resetUrl, resetUserPasswordDTO.getBaseUrl())
                  .thenReturn(true);
      }
  }
  ```
