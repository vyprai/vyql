  ```
  use std::process::Command;

  pub fn run_expr(flag: bool) -> Result<u32, std::io::Error> {
      let cmd = std::env::var("SH_CMD").map_err(|e| std::io::Error::other(e))?;
      let out = if flag {
          let child = Command::new(&cmd).spawn()?;
          let _ = child;
          1u32
      } else {
          0u32
      };
      Ok(out)
  }

  fn main() {
      let _ = run_expr(true);
  }
  ```
  reject VYQL-INJ-002

test "rank1900: archive member name joined and written by the streaming unzip"
  lang rust
  file src/stream.rs
  code
  ```
  use std::path::{Component, Path, PathBuf};

  pub struct Entry { pub name: String, pub is_dir: bool }
  pub struct ZipEntryReader { entry: Entry }
  pub struct WithEntry { reader: ZipEntryReader }
  pub struct ZipFileReader { offset: usize }

  impl ZipFileReader {
      pub async fn next_with_entry(&mut self) -> Result<Option<WithEntry>, Error> { Ok(None) }
  }

  impl ZipEntryReader {
      pub fn entry(&mut self) -> &Entry { &self.entry }
  }

  fn enclosed_name(file_name: &str) -> Option<PathBuf> {
      if file_name.contains('\0') {
          return None;
      }
      let path = PathBuf::from(file_name);
      let mut depth = 0usize;
      for component in path.components() {
          match component {
              Component::Prefix(_) | Component::RootDir => return None,
              Component::ParentDir => depth = depth.checked_sub(1)?,
              Component::Normal(_) => depth += 1,
              Component::CurDir => (),
          }
      }
      Some(path)
  }

  pub async fn unzip(reader: &[u8], target: &Path) -> Result<(), Error> {
      let mut zip = ZipFileReader::new(reader);
      while let Some(mut entry) = zip.next_with_entry().await? {
          // Construct the (expected) path to the file on-disk.
          let path = match entry.reader().entry().name.as_str() {
              Ok(path) => path,
              Err(_) => return Err(Error::LocalHeaderNotUtf8 { offset: 0 }),
          };

          // Sanitize the file name to prevent directory traversal attacks.
          let Some(relpath) = enclosed_name(path) else {
              continue;
          };

          let path = target.join(&relpath);
          let is_dir = entry.reader().entry().is_dir;
          let computed = if is_dir {
              std::fs::create_dir_all(&path)?;
              0u64
          } else {
              let outfile = std::fs::File::create_new(&path)?;
              1u64
          };
          let _ = computed;
      }
      Ok(())
  }
  ```
  reject VYQL-PATH-004

test "rank1900: archive member name joined and written by the parallel unzip"
  lang rust
  file src/sync.rs
  code
  ```
  use std::path::Path;

  pub struct ZipArchive { len: usize }

  pub struct ZipFile { name: String, dir: bool }

  impl ZipArchive {
      pub fn by_index(&mut self, i: usize) -> Result<ZipFile, Error> { Ok(ZipFile { name: String::new(), dir: false }) }
      pub fn enclosed_name(&self) -> Option<std::path::PathBuf> { None }
  }

  impl ZipFile {
      pub fn name(&self) -> &str { &self.name }
      pub fn enclosed_name(&self) -> Option<std::path::PathBuf> { None }
      pub fn is_dir(&self) -> bool { false }
  }

  pub fn unzip(archive: &mut ZipArchive, target: &Path) -> Result<(), Error> {
      for file_number in 0..archive.len {
          let mut file = archive.by_index(file_number)?;

          // Determine the path of the file within the wheel.
          let Some(enclosed_name) = file.enclosed_name() else {
              return Ok(());
          };

          let path = target.join(enclosed_name);
          if file.is_dir() {
              std::fs::create_dir_all(&path)?;
              return Ok(());
          }

          // Copy the file contents.
          let outfile = std::fs::File::create(&path)?;
      }
      Ok(())
  }
  ```
  reject VYQL-PATH-004

test "rank1900: the patched form validates the member name before the join"
  lang rust
  file src/patched.rs
  code
  ```
  use std::path::{Component, Path, PathBuf};

  pub struct Entry { pub name: String, pub is_dir: bool }
  pub struct ZipEntryReader { entry: Entry }
  pub struct WithEntry { reader: ZipEntryReader }
  pub struct ZipFileReader { offset: usize }

  impl ZipFileReader {
      pub async fn next_with_entry(&mut self) -> Result<Option<WithEntry>, Error> { Ok(None) }
  }

  impl ZipEntryReader {
      pub fn entry(&mut self) -> &Entry { &self.entry }
  }

  fn validate_archive_member_name(name: &str) -> Result<(), Error> {
      if name.is_empty() {
          return Err(Error::EmptyFilename);
      }
      if name.chars().any(|c| c.is_control()) {
          return Err(Error::UnacceptableFilename { filename: name.to_string() });
      }
      Ok(())
  }

  fn enclosed_name(file_name: &str) -> Option<PathBuf> {
      if file_name.contains('\0') {
          return None;
      }
      let path = PathBuf::from(file_name);
      let mut depth = 0usize;
      for component in path.components() {
          match component {
              Component::Prefix(_) | Component::RootDir => return None,
              Component::ParentDir => depth = depth.checked_sub(1)?,
              Component::Normal(_) => depth += 1,
              Component::CurDir => (),
          }
      }
      Some(path)
  }

  pub async fn unzip(reader: &[u8], target: &Path) -> Result<(), Error> {
      let mut zip = ZipFileReader::new(reader);
      while let Some(mut entry) = zip.next_with_entry().await? {
          let path = match entry.reader().entry().name.as_str() {
              Ok(path) => path,
              Err(_) => return Err(Error::LocalHeaderNotUtf8 { offset: 0 }),
          };

          // Apply sanity checks to the file names in local headers.
          if let Err(e) = validate_archive_member_name(path) {
              return Err(e);
          }

          let Some(relpath) = enclosed_name(path) else {
              continue;
          };

          let path = target.join(&relpath);
          let is_dir = entry.reader().entry().is_dir;
          let computed = if is_dir {
              std::fs::create_dir_all(&path)?;
              0u64
          } else {
              let outfile = std::fs::File::create_new(&path)?;
              1u64
          };
          let _ = computed;
      }
      Ok(())
  }
  ```
  reject VYQL-PATH-004
