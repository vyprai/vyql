  reject VYQL-AUTH-149
  code
  ```
  package org.silverpeas.core.security.authentication;

  public class AuthenticationService implements Authentication {

    public AuthenticationResponse authenticate(final AuthenticationCredential credential)
        throws AuthenticationException {
      final String key = checkAuthentication(credential);
      return AuthenticationResponse.succeed(key);
    }

    private String checkAuthentication(final AuthenticationCredential userCredential)
        throws AuthenticationException {
      final String key;
      if (userCredential.isPasswordSet()) {
        key = authenticateByLoginAndPasswordAndDomain(userCredential);
      } else {
        key = authenticateByLoginAndDomain(userCredential);
      }
      return key;
    }

    private String authenticateByLoginAndPasswordAndDomain(final AuthenticationCredential credential)
        throws AuthenticationException {
      String password = credential.getPassword();
      String domainId = credential.getDomainId();
      if (password == null || domainId == null) {
        throw new AuthenticationException("No login or no domain is specified!");
      }
      return getAuthenticationServer(domainId).authenticate(credential);
    }

    private String authenticateByLoginAndDomain(final AuthenticationCredential credential)
        throws AuthenticationException {
      String login = credential.getLogin();
      String domainId = credential.getDomainId();
      if (domainId == null) {
        throw new AuthenticationException("No domain is specified!");
      }
      final JdbcSqlQuery query = JdbcSqlQuery.select("id")
          .from("st_user")
          .where("domainId = ?", Integer.parseInt(domainId))
          .and("login = ?", login);
      return getAuthToken(credential);
    }
  }
