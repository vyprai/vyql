# Apache HugeGraph declares its JWT signing key as a config option whose
# default is a fixed literal shipped in source. AuthOptions.java
# (hugegraph-server/hugegraph-core/src/main/java/org/apache/hugegraph/config/
# AuthOptions.java) declares the auth.token_secret ConfigOption with
# "FXQXbJtbCLxODc6tGci732pkH1cyf8Qg" as the constructor's fourth argument —
# the option's default value — and TokenGenerator reads that option straight
# into the HMAC-SHA256 key that signs and verifies every auth JWT
# (Keys.hmacShaKeyFor(secretKey.getBytes(...)), .signWith(this.key,
# SignatureAlgorithm.HS256)). Any deployment that does not override
# auth.token_secret in its own config signs and verifies tokens with a key
# whose value is in the public source tree, so anyone who can read the
# repository can forge an admin JWT (CWE-798, CWE-321, CWE-347). The fix
# (03b40a52446218c83e98cb43020e0593a744a246, AuthOptions.java and
# StandardAuthManager.java only) replaces the literal fourth argument with a
# generateRandomBase64Key() helper — SecureRandom-backed, 32 bytes,
# base64-encoded — and logs that the key is generated at startup.
#
# The hardcoded-secret heuristic reads the default off the call as well as
# off the literal: a secret-named assignment whose right-hand call carries a
# string literal in its final argument — the default slot of a
# (name, description, checker, default) options constructor — is the same
# baked-into-source secret as a direct literal or an os.getenv(name,
# "default") fallback, and now reports VYQL-AUTH-101 through the existing
# HardcodedSecretLiteral rule and its java binding. A default computed at
# runtime (generateRandomBase64Key(), an identifier) is not a literal and
# does not report. The construct needs no HugeGraph-specific binding: the
# lowering pass emits the same analysis call for every language sharing
# nir.Assign, so a Python/JavaScript config object that bakes a literal
# default into its secret-named option reports the same way.
#
# The final-argument slot is read only for calls of two or more arguments: a
# single-argument call's operand is a name read by value (getHeader(
# "X-Auth-Token"), Mac.getInstance("HmacSHA256")), not a default. Residual,
# both directions: a default declared in a non-final argument slot is
# invisible, and a multi-argument reader whose final operand is a long
# literal that is a name rather than a value still reports.
#
# Four cases: the vulnerable real declaration (expect), the fixed real
# declaration (reject), a framework-independent builder default carrying the
# same literal (expect — the shape, not the library, is what reports), and
# the single-argument name-read guard (reject).

test "rank1209: AuthOptions declares auth.token_secret with a fixed literal default"
  lang java
  file AuthOptions.java
  expect VYQL-AUTH-101
  code
  ```
  package org.apache.hugegraph.config;

  import java.util.function.Predicate;

  class ConfigOption<T> {
      ConfigOption(String name, String description, Predicate<T> checker, T defaultValue) {
      }
  }

  class OptionChecker {
      static <T> Predicate<T> disallowEmpty() {
          return null;
      }
  }

  public class AuthOptions {

      public static final ConfigOption<String> AUTH_TOKEN_SECRET =
              new ConfigOption<>(
                      "auth.token_secret",
                      "Secret key of HS256 algorithm.",
                      OptionChecker.disallowEmpty(),
                      "FXQXbJtbCLxODc6tGci732pkH1cyf8Qg"
              );
  }
  ```

test "rank1209: AuthOptions generates auth.token_secret's default at startup"
  lang java
  file AuthOptions_fixed.java
  reject VYQL-AUTH-101
  code
  ```
  package org.apache.hugegraph.config;

  import java.security.SecureRandom;
  import java.util.Base64;
  import java.util.function.Predicate;

  class ConfigOption<T> {
      ConfigOption(String name, String description, Predicate<T> checker, T defaultValue) {
      }
  }

  class OptionChecker {
      static <T> Predicate<T> disallowEmpty() {
          return null;
      }
  }

  public class AuthOptions {

      public static final ConfigOption<String> AUTH_TOKEN_SECRET =
              new ConfigOption<>(
                      "auth.token_secret",
                      "Secret key of HS256 algorithm.",
                      OptionChecker.disallowEmpty(),
                      generateRandomBase64Key()
              );

      private static String generateRandomBase64Key() {
          SecureRandom random = new SecureRandom();
          byte[] bytes = new byte[32];
          random.nextBytes(bytes);
          return Base64.getEncoder().encodeToString(bytes);
      }
  }
  ```

test "rank1209: a secret-named field's builder default is the same baked-in literal"
  lang java
  file BuilderSecret.java
  expect VYQL-AUTH-101
  code
  ```
  package x;

  import java.util.function.Predicate;

  class ConfigOption<T> {
      ConfigOption(String name, String description, Predicate<T> checker, T defaultValue) {
      }
  }

  public class BuilderSecret {
      public static final ConfigOption<String> AUTH_SECRET_KEY =
              new ConfigOption<>(
                      "auth.secret_key",
                      "Secret key of HS256 algorithm.",
                      null,
                      "FXQXbJtbCLxODc6tGci732pkH1cyf8Qg"
              );
  }
  ```

test "rank1209: a single-argument name read into a secret-named target is not a default"
  lang java
  file NameRead.java
  reject VYQL-AUTH-101
  code
  ```
  package x;

  import java.util.HashMap;
  import java.util.Map;

  public class NameRead {
      private static final Map<String, String> HEADERS = new HashMap<>();

      public String authSecretHeader() {
          String authSecretName = HEADERS.get("X-Auth-Secret-Name");
          return authSecretName;
      }
  }
  ```
