test "rank1042: a normalization written as a method chain is the safe shape"
  lang ruby
  file config/initializers/rack_attack.rb
  reject VYQL-AUTH-088
  code
  ```
  class Rack::Attack
    throttle('login/ip', limit: 5, period: 5.minutes) do |req|
      req.ip if req.path.sub(/\.[^.]+$/, '') == '/auth/sign_in' && req.post?
    end
  end
  ```

test "rank1042: a raw path equality outside a throttle reports nothing"
  lang ruby
  file app/controllers/concerns/path_check.rb
  reject VYQL-AUTH-088
  code
  ```
  class PathCheck
    def signed_in?(req)
      req.path == '/auth/sign_in'
    end
  end
  ```
