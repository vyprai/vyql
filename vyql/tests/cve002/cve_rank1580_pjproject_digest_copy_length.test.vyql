test "rank1580: a count bounded by the destination's own size is consulted"
  lang c
  file pjsip/src/pjsip/sip_auth_client.c
  reject VYQL-MEM-076
  code
  ```
  #include <string.h>

  typedef struct { const unsigned char *session_id; unsigned session_id_length; } session_t;

  unsigned long session_hash(const session_t *a)
  {
      unsigned char tmp_storage[4];

      if (a->session_id_length < sizeof(tmp_storage)) {
          memset(tmp_storage, 0, sizeof(tmp_storage));
          memcpy(tmp_storage, a->session_id, a->session_id_length);
      }
      return tmp_storage[0] | tmp_storage[1];
  }
  ```

