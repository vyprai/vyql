# Rank 1584 / CVE-2021-43852: Oro's URL-query unpacker wrote every bracket
# segment of a query key into nested objects without rejecting special
# property names, so a query like ?__proto__[polluted]=1 set properties on
# Object.prototype for every consumer of the parsed result (prototype
# pollution, CWE-1321; BAP-21092). unpackFromQueryString in
# src/Oro/Bundle/UIBundle/Resources/public/js/tools.js walks the key path
# and assigns `root[path] = value`, and the intermediate level is allocated
# with `root[dir] = path[0] === '' ? [] : {}` -- the __proto__ segment
# reached the language's prototype machinery unchecked. The fixing commit
# 62c26936b3 ("BAP-21092: JavaScript Prototype Pollution (#31464)", +4
# lines) makes setValue return early `if (path[0] === '__proto__')` with the
# comment "Prevent Object.prototype pollution".
#
# The nested-path-setter review (VYQL-INJ-134) is the vocabulary this shape
# needs, and both halves already existed: the review asks whether a setter
# that allocates the intermediate levels of a key path also carries the
# prototype-name guard, and the fixing comparison sets prototype_key_guard,
# which the binding negates. The miss was in the fact: a computed key whose
# value is a ternary between container literals allocates a fresh container
# on every path, exactly as a bare object literal does, but the
# object-literal half of the fact was emitted only when the right-hand side
# was itself an object node. Reading the value a ternary actually stores
# recovers the unguarded form; the guarded form keeps its suppression.

test "rank1584: the query unpacker writes every bracket segment it is given"
  lang javascript
  file src/Oro/Bundle/UIBundle/Resources/public/js/tools.js
  expect VYQL-INJ-134
  expect_review code.NestedPathInheritedPropertyPrototypePollution
  code
  ```
  function unpackFromQueryString(query) {
      if (query.charAt(0) === '?') {
          query = query.slice(1);
      }
      const setValue = function(root, path, value) {
          if (path.length > 1) {
              const dir = path.shift();
              if (typeof root[dir] === 'undefined') {
                  root[dir] = path[0] === '' ? [] : {};
              }
              setValue(root[dir], path, value);
          } else {
              if (root instanceof Array) {
                  root.push(value);
              } else {
                  root[path] = value;
              }
          }
      };
      const nvp = query.split('&');
      const data = {};
      for (let i = 0; i < nvp.length; i++) {
          const pair = nvp[i].split('=');
          if (pair.length < 2) {
              continue;
          }
          const name = decodeURIComponent(pair[0]);
          const value = decodeURIComponent(pair[1]);

          let path = name.match(/(^[^\[]+)(\[.*\]$)?/);
          const first = path[1];
          if (path[2]) {
              path = path[2].match(/(?=\[(.*)\]$)/)[1].split('][');
          } else {
              path = [];
          }
          path.unshift(first);

          setValue(data, path, value);
      }
      return data;
  }
  ```

test "rank1584: the fixed revision refuses the dunder-proto segment"
  lang javascript
  file src/Oro/Bundle/UIBundle/Resources/public/js/tools.js
  reject VYQL-INJ-134
  reject_review code.NestedPathInheritedPropertyPrototypePollution
  code
  ```
  function unpackFromQueryString(query) {
      if (query.charAt(0) === '?') {
          query = query.slice(1);
      }
      const setValue = function(root, path, value) {
          if (path[0] === '__proto__') {
              // Prevent Object.prototype pollution
              return;
          }
          if (path.length > 1) {
              const dir = path.shift();
              if (typeof root[dir] === 'undefined') {
                  root[dir] = path[0] === '' ? [] : {};
              }
              setValue(root[dir], path, value);
          } else {
              if (root instanceof Array) {
                  root.push(value);
              } else {
                  root[path] = value;
              }
          }
      };
      const nvp = query.split('&');
      const data = {};
      for (let i = 0; i < nvp.length; i++) {
          const pair = nvp[i].split('=');
          if (pair.length < 2) {
              continue;
          }
          const name = decodeURIComponent(pair[0]);
          const value = decodeURIComponent(pair[1]);

          let path = name.match(/(^[^\[]+)(\[.*\]$)?/);
          const first = path[1];
          if (path[2]) {
              path = path[2].match(/(?=\[(.*)\]$)/)[1].split('][');
          } else {
              path = [];
          }
          path.unshift(first);

          setValue(data, path, value);
      }
      return data;
  }
  ```
