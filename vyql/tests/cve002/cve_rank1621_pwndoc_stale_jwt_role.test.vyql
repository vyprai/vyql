# Rank 1621 / CVE-2021-31590: PwnDoc's access control trusted the
# JWT's baked-in claims for the token's whole lifetime. The
# middleware in backend/src/lib/auth.js verified the signature and
# expiry but decided authorization from decoded.role alone, and
# updateProfile in backend/src/models/user.js minted that token with
# expiresIn '24h', so a user downgraded from admin, or deleted
# entirely, kept every privilege for up to a day -- with the
# hard-coded dev secret in backend/src/config/config.json, even
# across redeploys (stale session claims deciding access control,
# CWE-613/CWE-863). The fixing commit ff1b868 is the vendor's fix inside
# 0.4.0, the version the advisory names as patched (verified: the
# commit is an ancestor of the v0.4.0 tag and nothing else touches
# the auth files between them). It never changes the authorization
# decision -- hasPermission is byte-identical at both revisions. It
# shrinks the claim's authority window from 24h to 15 minutes, re-keys
# the refresh token on the immutable userId (findById instead of
# findOne on the username claim), and moves the session-removal
# endpoint from GET /api/users/destroytoken to DELETE
# /api/users/refreshtoken.
#
# ATTENTION, stale-claim authority, rechecked. The same family as rank
# 1599 (Postiz's verified payload used as the principal) and rank 1546
# (rate limiting on a decoded claim); the change comes from the
# configuration side like 1514/1535/1540/1556/1557/1593, so the
# decision site is unchanged between revisions and no detection aimed
# at it can discriminate. Re-measured on the real checkout: 55
# findings on each of three --cache off runs per revision with
# byte-identical 16-rule histograms, and 118 review flags per revision
# with identical category counts (98 core.AuthorizationCheck on the
# acl.hasPermission route guards, 15 code.ResourceReview, and one each
# of HostHeaderUserinfoConfusion, ExpressParamArrayValuePollution,
# SecretComparisonReview, CertValidationDisabled and
# code.SensitiveOperation) -- the three auth-carrying files carry only
# code.WeakJwtSecret rows, the callArg substring matching the
# jwtSecret variable name rather than the secret handling.
#
# The discriminating token was measured rather than assumed. A
# presence binding on the sign node reading
# node.context.callArg contains "24h" fires on
# backend/src/models/user.js:101 at the pre-fix revision and on
# nothing at the fixed revision -- the option object is reachable and
# call-confined. It is still not the weakness. The payload reaches
# jwt.sign as a variable, and probes over node.context.assign, .expr,
# .prop, .identifier, .callPath and .callArg with "role", "getRoles"
# and "payload" return zero on every jwt.sign node at both revisions,
# so no clause can say "this long-lived token carries an authorization
# claim". Keying the duration alone over-flags the measured
# neighbourhood: trek signs {id} with expiresIn '24h' at
# server/src/routes/oidc.ts:87 and auth.ts:170, and twenty sets
# expiresIn = '100y' for an API key
# (api-key.service.ts:157) -- id-only and API-key credentials whose
# lifetime is a deliberate choice, and the fix's own refresh token
# legitimately carries '7 days' in the same function. A day-scale
# threshold also flags password-reset-shaped tokens, for which a day
# is the recommended lifetime.
#
# No later-shipped vocabulary answers it. The CWE-613 family in the
# ontology -- ExpiredCachedAuthTokenReuse, SessionHashMissingAuthorizationState,
# PasswordChangeWithoutSessionInvalidation, LogoutWithoutSessionInvalidation,
# MissingSessionRotationAfterAuthentication,
# SessionUserInstallWithoutAuthenticationStateCheck,
# RevocationCheckAgainstCurrentTime, HttpPersistentAuthReuse,
# TokenCacheAuthorizationBypass -- asks about caches, hashes,
# rotation and revocation records, not about authorization attributes
# frozen into a bearer token; only LogoutWithoutSessionInvalidation
# has a JavaScript binding at all. What is missing is the
# claim-authority question: whether the authorization decision is
# re-resolved from the store rather than read from a token whose
# window outlives the state it encodes. The GET-to-DELETE verb change
# on the session-removal endpoint is the settled
# csrf-on-state-changing-endpoint family (1501, 1567, 1581, 1592,
# 1601). No ENGINE-GAPS.md entry: no taint path is interrupted, the
# vocabulary to ask the question is what is missing. No definition
# change shipped. Spec cve_rank1621 records the role-claim decision
# and both halves of the mint pair, all asserting reject
# VYQL-AUTH-079: when session-claim vocabulary lands, the role-claim
# and long-window forms must flip to expect.

test "rank1621: authorization decided from the token's role claim"
  lang javascript
  file backend/src/lib/auth.js
  reject VYQL-AUTH-079
  code
  ```
  var jwt = require('jsonwebtoken');
  var jwtSecret = config[env].jwtSecret;

  class ACL {
      isAllowed(role, permission) {
          return this.roles[role].allows.indexOf(permission) !== -1;
      }

      hasPermission(permission) {
          return (req, res, next) => {
              if (!req.cookies['token']) {
                  Response.Unauthorized(res, 'No token provided');
                  return;
              }
              var cookie = req.cookies['token'].split(' ')
              if (cookie.length !== 2 || cookie[0] !== 'JWT') {
                  Response.Unauthorized(res, 'Bad token type')
                  return
              }
              var token = cookie[1]
              jwt.verify(token, jwtSecret, (err, decoded) => {
                  if (err) {
                      if (err.name === 'TokenExpiredError')
                          Response.Unauthorized(res, 'Expired token')
                      else
                          Response.Unauthorized(res, 'Invalid token')
                      return
                  }
                  if ( permission === "validtoken" || this.isAllowed(decoded.role, permission)) {
                      req.decodedToken = decoded
                      return next()
                  }
                  else {
                      Response.Forbidden(res, 'Insufficient privileges')
                      return
                  }
              })
          }
      }
  }
  ```

test "rank1621: the role-carrying token minted with a day-scale window"
  lang javascript
  file backend/src/models/user.js
  reject VYQL-AUTH-079
  code
  ```
  var jwt = require('jsonwebtoken');
  var auth = require('../lib/auth.js');

  UserSchema.statics.updateProfile = function (username, user) {
      return new Promise((resolve, reject) => {
          var query = this.findOne({username: username});
          var payload = {};
          query.exec()
          .then(function(row) {
              if (!row)
                  throw({fn: 'NotFound', message: 'User not found'});
              else if (bcrypt.compareSync(user.password, row.password)) {
                  if (user.username) row.username = user.username;
                  if (user.newPassword) row.password = bcrypt.hashSync(user.newPassword, 10);

                  payload.id = row._id;
                  payload.username = row.username;
                  payload.role = row.role;
                  payload.roles = auth.acl.getRoles(payload.role)

                  return row.save();
              }
              else
                  throw({fn: 'Unauthorized', message: 'Current password is invalid'});
          })
          .then(function() {
              var token = jwt.sign(payload, auth.jwtSecret, {expiresIn: '24h'});
              resolve({token: `JWT ${token}`});
          })
      })
  }
  ```

test "rank1621: the fixed revision re-keys the refresh and shortens the window"
  lang javascript
  file backend/src/models/user.js
  reject VYQL-AUTH-079
  code
  ```
  var jwt = require('jsonwebtoken');
  var auth = require('../lib/auth.js');

  UserSchema.statics.updateRefreshToken = function (refreshToken, userAgent) {
      return new Promise((resolve, reject) => {
          var token = ""
          var newRefreshToken = ""
          try {
              var decoded = jwt.verify(refreshToken, auth.jwtRefreshSecret)
              var userId = decoded.userId
              var sessionId = decoded.sessionId
              var expiration = decoded.exp
          }
          catch (err) {
              throw({fn: 'Unauthorized', message: 'Invalid refreshToken'})
          }
          var query = this.findById(userId)
          query.exec()
          .then(row => {
              if (row) {
                  if (sessionId !== null) {
                      var sessionExist = row.refreshTokens.findIndex(e => e.sessionId === sessionId && e.token === refreshToken)
                      if (sessionExist === -1)
                          throw({fn: 'Unauthorized', message: 'Session not found'})
                  }
                  var payload = {}
                  payload.id = row._id
                  payload.username = row.username
                  payload.role = row.role
                  payload.roles = auth.acl.getRoles(payload.role)

                  token = jwt.sign(payload, auth.jwtSecret, {expiresIn: '15 minutes'})
                  sessionId = generateUUID()
                  newRefreshToken = jwt.sign({sessionId: sessionId, userId: userId}, auth.jwtRefreshSecret, {expiresIn: '7 days'})
                  row.refreshTokens.push({sessionId: sessionId, userAgent: userAgent, token: newRefreshToken})
                  return row.save()
              }
              else
                  reject({fn: 'NotFound', message: 'Session not found'})
          })
          .then(() => {
              resolve({token: token, refreshToken: newRefreshToken})
          })
      })
  }
  ```
