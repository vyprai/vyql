test "rank1286: the diag command handed to ProcessBuilder as an array literal reports command injection -- the route itself works"
  lang java
  file org/apache/kylin/rest/service/DiagnosisService.java
  expect VYQL-INJ-002
  code
  ```
  package org.apache.kylin.rest.service;

  import org.apache.commons.lang3.StringUtils;
  import org.springframework.web.bind.annotation.PathVariable;
  import org.springframework.web.bind.annotation.RequestMapping;
  import org.springframework.web.bind.annotation.RequestMethod;
  import org.springframework.web.bind.annotation.RestController;

  @RestController
  @RequestMapping(value = "/diag")
  public class DiagnosisService {

      @RequestMapping(value = "/job/{jobId}/download", method = { RequestMethod.GET })
      public void dumpJobDiagnosisInfo(@PathVariable String jobId) {
          String[] args = { jobId, "/tmp/kylin-diag" };
          String diagCmd = "/opt/kylin/bin/diag.sh " + StringUtils.join(args, " ");
          runNativeCommand(diagCmd);
      }

      private void runNativeCommand(String command) {
          String[] cmd = { "/bin/bash", "-c", command };
          ProcessBuilder builder = new ProcessBuilder(cmd);
          builder.redirectErrorStream(true);
      }
  }
  ```

test "rank1286: the same command assigned into the array by element subscript reports nothing -- the write drops the taint"
  lang java
  file org/apache/kylin/rest/service/DiagnosisService.java
  reject VYQL-INJ-002
  code
  ```
  package org.apache.kylin.rest.service;

  import org.apache.commons.lang3.StringUtils;
  import org.springframework.web.bind.annotation.PathVariable;
  import org.springframework.web.bind.annotation.RequestMapping;
  import org.springframework.web.bind.annotation.RequestMethod;
  import org.springframework.web.bind.annotation.RestController;

  @RestController
  @RequestMapping(value = "/diag")
  public class DiagnosisService {

      @RequestMapping(value = "/job/{jobId}/download", method = { RequestMethod.GET })
      public void dumpJobDiagnosisInfo(@PathVariable String jobId) {
          String[] args = { jobId, "/tmp/kylin-diag" };
          String diagCmd = "/opt/kylin/bin/diag.sh " + StringUtils.join(args, " ");
          runNativeCommand(diagCmd);
      }

      private void runNativeCommand(String command) {
          String[] cmd = new String[3];
          cmd[0] = "/bin/bash";
          cmd[1] = "-c";
          cmd[2] = command;
          ProcessBuilder builder = new ProcessBuilder(cmd);
          builder.redirectErrorStream(true);
      }
  }
  ```
