# Rank 1717 / CVE-2017-15288 (CWE-732): the Scala compilation daemon kept its
# per-port handshake file under the JVM temp directory with whatever
# permissions the umask leaves in place. CompileSocket derives
# `(Path(Properties.tmpDir) / ("scala-devel" + userName)).createDirectory()`
# at class level, nests a `scalac-compile-server-port` directory in it, and
# setPort writes the daemon's shared secret there --
# `val secret = new SecureRandom().nextInt.toString; file writeAll secret`.
# Nothing restricts the file to its owner, so a local user who can read or
# replace that file (the directory name is the predictable
# "scala-devel<userName>" in a shared /tmp) learns the 31-bit secret or
# substitutes their own, and the victim's next `fsc` client authenticates to a
# socket of the attacker's choosing and compiles attacker-supplied sources
# with the victim's privileges. getPassword reads the same file back and
# prints it over the socket, so the file is credential material and not
# incidental state.
#
# The fixing commit 0f624c5e5 is the merge of PR #6128 ("Backports for
# 2.10.7"), so a plain `git show` prints an empty combined diff and the row
# reads as though the change is unavailable; `git diff bda53196eb 0f624c5e5`
# reads it in full. That diff replaces the class-level temp directory with
# `~/.scalac`, replaces `writeAll` with
# `OwnerOnlyChmod().chmodAndWrite(file.jfile, secretDigits)` (delete, recreate,
# strip group/other, then write), raises the secret from SecureRandom.nextInt
# to a 128-bit BigInteger, and applies the same chmod to the directory itself.
# The parent bda53196eb carries the vulnerable form verbatim, and the merge is
# reachable from every release branch, so the row needs no correction.
#
# There is no taint path to judge -- the secret never crosses a trust
# boundary the engine models, and the exploit turns on filesystem permissions
# -- so this is the permission-hardening shape code.SecretFilePermissionReview
# names for PHP ("secret or key material is generated without an
# observed restrictive file-permission hardening call"). The Scala binding
# reuses that concept rather than minting a sibling, and keys only on what the
# APIs document: a value assigned from java.security.SecureRandom, a file
# write through scala.reflect.io's writeAll/appendAll or the java.io/java.nio
# file writers, and no setReadable/setWritable/setExecutable/setPosixFilePermissions/
# PosixFilePermissions/chmod call in the same function. Both spellings of the
# reflect.io write are covered because Scala writes infix (`f writeAll s`,
# an expr token) and dotted (`f.writeAll(s)`, a call-path token) with equal
# frequency.
#
# Measured on src/compiler extracted at each revision (415 Scala files, all
# scanned): 1 flag at CompileSocket.scala:141 (setPort) at bda53196eb, stable
# over three `--cache off` runs; 0 at 0f624c5e5, stable over three runs. The
# binding emits a review concept only -- no pack rule consumes it -- and A/B on
# the same tree gives 211 findings with and without it. The fixed revision
# reports 212, the whole difference a pre-existing VYQL-INJ-004 row on
# SocketServer.scala where the remediation's new `fixPort` parameter adds one
# entry to the jquery.js taint noise. The reachable set is the functions
# that both derive from SecureRandom and write a file: `SecureRandom` occurs in
# two of the 6035 .scala files in the whole checkout (the CVE file and a
# disabled akka test helper that writes nothing), and the collateral scans are
# 0 on rocket-chip (343 files), the scala library and reflect trees, and the
# quarkus/mlflow Scala subtrees. Function confinement and comment-proofness
# are pinned below: the secret derived in a sibling function reports nothing,
# and a comment naming chmod does not neutralise, because assign/expr/call_path
# tokens are AST-derived and comments produce no nodes.
#
# Residual, stated rather than hidden: the temp-directory location lives in a
# class-level `val`, which the Scala frontend lowers to a bare Assign that
# contributes no context token, so no function-scoped binding can conjoin it.
# The flag therefore also covers a secret written with default permissions to a
# private directory, which is the false-positive direction a
# review/attention-grade concept is designed to absorb.

test "rank1717: fsc writes the daemon secret to the port file with default permissions"
  lang scala
  file src/compiler/scala/tools/nsc/CompileSocket.scala
  expect_review code.SecretFilePermissionReview
  code
  ```
  package scala.tools.nsc

  import java.security.SecureRandom
  import io.{ File, Path }

  class CompileSocket {
    protected lazy val dirName = "scalac-compile-server-port"

    val tmpDir = {
      val udir = Option(Properties.userName) getOrElse "shared"
      (Path(Properties.tmpDir) / ("scala-devel" + udir)).createDirectory()
    }

    val portsDir = (tmpDir / dirName).createDirectory()

    def portFile(port: Int) = portsDir / File(port.toString)

    def setPort(port: Int) {
      val file   = portFile(port)
      val secret = new SecureRandom().nextInt.toString
      try file writeAll secret catch {
        case e: Throwable => fatal("Cannot create file: %s" format file.path)
      }
    }
  }
  ```

test "rank1717: chmodAndWrite with a 128-bit secret is the remediated form"
  lang scala
  file src/compiler/scala/tools/nsc/CompileSocket.scala
  reject_review code.SecretFilePermissionReview
  code
  ```
  package scala.tools.nsc

  import java.math.BigInteger
  import java.security.SecureRandom
  import scala.reflect.internal.util.OwnerOnlyChmod

  class CompileSocket {
    def portFile(port: Int) = portsDir / File(port.toString)

    def setPort(port: Int): Unit = {
      val file = portFile(port)
      val secretDigits = new BigInteger(128, new SecureRandom()).toString.getBytes("UTF-8")
      try OwnerOnlyChmod().chmodAndWrite(file.jfile, secretDigits)
      catch chmodFailHandler(s"Cannot create file: ${file}")
    }
  }
  ```

test "rank1717: stripping group and other before a java.io write is clean"
  lang scala
  file src/compiler/scala/tools/nsc/CompileSocket.scala
  reject_review code.SecretFilePermissionReview
  code
  ```
  package scala.tools.nsc

  import java.io.{ File, FileOutputStream }
  import java.security.SecureRandom

  class CompileSocket {
    def setPort(port: Int) {
      val file   = new File("/tmp/scalac-compile-server-port/" + port)
      val secret = new SecureRandom().nextInt.toString
      file.setReadable(false, false)
      file.setWritable(false, false)
      val out = new FileOutputStream(file)
      out.write(secret.getBytes)
      out.close()
    }
  }
  ```

test "rank1717: the dotted spelling and the java.io writers report too"
  lang scala
  file src/compiler/scala/tools/nsc/CompileSocket.scala
  expect_review code.SecretFilePermissionReview
  code
  ```
  package scala.tools.nsc

  import java.io.{ File, PrintWriter }
  import java.security.SecureRandom

  class Daemon {
    def writeToken(dir: File) {
      val token = new SecureRandom().nextInt.toString
      val out = new PrintWriter(new File(dir, "token"))
      out.print(token)
      out.close()
    }
  }
  ```

test "rank1717: a secret derived in a sibling function does not reach the writer"
