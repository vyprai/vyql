  package scala.tools.nsc

  import java.security.SecureRandom
  import io.File

  class CompileSocket {
    def newSecret() = new SecureRandom().nextInt.toString

    def writeStatus(f: File, msg: String) {
      f writeAll msg
    }
  }
  ```

