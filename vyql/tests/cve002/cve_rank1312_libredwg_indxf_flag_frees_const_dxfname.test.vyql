test "rank1312: a class name aliased into an object is freed unconditionally"
  lang c
  file free.c
  reject VYQL-MEM-008
  reject VYQL-MEM-011
  code
  ```
  #include <stdlib.h>

  typedef struct { const char *dxfname; } Dwg_Class;
  typedef struct { char *dxfname; int type; } Dwg_Object;
  typedef struct { unsigned int opts; Dwg_Class *dwg_class; } Dwg_Data;

  void
  dwg_object_set_dxfname (Dwg_Data *dwg, Dwg_Object *obj, int i)
  {
    obj->dxfname = (char *)dwg->dwg_class[i].dxfname;
  }

  void
  dwg_free_object (Dwg_Data *dwg, Dwg_Object *obj)
  {
    free (obj->dxfname);
    obj->type = -1;
  }
  ```

