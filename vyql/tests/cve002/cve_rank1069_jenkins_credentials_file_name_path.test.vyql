# A file credential's getFileName() is the name the credential's creator
# configured, stored beside the secret bytes. Materializing the secret under
# it without reducing it to a bare name lets the stored name choose where the
# bytes land: a name with traversal segments escapes the secret directory the
# binding hands out to the build.

test "rank1069: the credential's own file name becomes the path"
  lang java
  file src/main/java/org/jenkinsci/plugins/credentialsbinding/impl/FileBinding.java
  expect VYQL-PATH-013
  expect_review code.UploadFilePathTraversalWrite
  code
  ```
  package org.jenkinsci.plugins.credentialsbinding.impl;

  import hudson.FilePath;
  import java.io.IOException;

  public class FileBinding extends AbstractOnDiskBinding<FileCredentials> {

      @Override
      protected final FilePath write(FileCredentials credentials, FilePath dir) throws IOException, InterruptedException {
          FilePath secret = dir.child(credentials.getFileName());
          secret.copyFrom(credentials.getContent());
          secret.chmod(0400);
          return secret;
      }
  }
  ```

test "rank1069: the archive binding materializes under the credential's own name"
  lang java
  file src/main/java/org/jenkinsci/plugins/credentialsbinding/impl/ZipFileBinding.java
  expect VYQL-PATH-013
  expect_review code.UploadFilePathTraversalWrite
  code
  ```
  package org.jenkinsci.plugins.credentialsbinding.impl;

  import hudson.FilePath;
  import java.io.IOException;

  public class ZipFileBinding extends AbstractOnDiskBinding<FileCredentials> {

      @Override
      protected final FilePath write(FileCredentials credentials, FilePath dir) throws IOException, InterruptedException {
          FilePath secret = dir.child(credentials.getFileName());
          secret.unzipFrom(credentials.getContent());
          secret.chmod(0700);
          return secret;
      }
  }
  ```

test "rank1069: the same write taking the base name first"
  lang java
  file src/main/java/org/jenkinsci/plugins/credentialsbinding/impl/FileBinding.java
  reject VYQL-PATH-013
  reject_review code.UploadFilePathTraversalWrite
  code
  ```
  package org.jenkinsci.plugins.credentialsbinding.impl;

  import hudson.FilePath;
  import java.io.File;
  import java.io.IOException;

  public class FileBinding extends AbstractOnDiskBinding<FileCredentials> {

      @Override
      protected final FilePath write(FileCredentials credentials, FilePath dir) throws IOException, InterruptedException {
          String baseName = new File(credentials.getFileName()).getName();

          FilePath secret = dir.child(baseName);
          secret.copyFrom(credentials.getContent());
          secret.chmod(0400);
          return secret;
      }
  }
  ```

