test "rank1911: the device polling endpoint answers the requester, it does not log in"
  lang rust
  file src/api/core/accounts.rs
  reject VYQL-AUTH-166
  reject_review code.UnapprovedLoginArtifactAuthentication
  code
  ```
  #[get("/auth-requests/<uuid>/response?<code>")]
  async fn get_auth_request_response(
      uuid: &str,
      code: &str,
      client_headers: ClientHeaders,
      mut conn: DbConn,
  ) -> JsonResult {
      let auth_request = match AuthRequest::find_by_uuid(uuid, &mut conn).await {
          Some(auth_request) => auth_request,
          None => err!("AuthRequest doesn't exist", "User not found"),
      };

      if auth_request.device_type != client_headers.device_type
          || auth_request.request_ip != client_headers.ip.ip.to_string()
          || !auth_request.check_access_code(code)
      {
          err!("AuthRequest doesn't exist", "Invalid device, IP or code")
      }

      let response_date_utc = auth_request.response_date.map(|response_date| format_date(&response_date));

      Ok(Json(json!({ "id": uuid, "key": auth_request.enc_key, "requestApproved": auth_request.approved })))
  }
  ```

test "rank1911: a comment claiming the approval check does not clear the login"
  lang rust
  file src/api/identity.rs
  expect VYQL-AUTH-166
  expect_review code.UnapprovedLoginArtifactAuthentication
  code
  ```
  async fn _password_login(
      data: ConnectData,
      user_uuid: &mut Option<String>,
      conn: &mut DbConn,
      ip: &ClientIp,
  ) -> JsonResult {
      let password = data.password.as_ref().unwrap();
      // The auth request is checked against the approved access code before
      // the user_uuid of the requesting device, so this branch is safe.
      if let Some(auth_request_uuid) = data.auth_request.clone() {
          if let Some(auth_request) = AuthRequest::find_by_uuid(auth_request_uuid.as_str(), conn).await {
              if !auth_request.check_access_code(password) {
                  err!("Username or access code is incorrect. Try again")
              }
          }
      } else if !user.check_valid_password(password) {
          err!("Username or password is incorrect. Try again")
      }

      let (access_token, expires_in) = device.refresh_tokens(&user, scope_vec);
      Ok(Json(json!({ "access_token": access_token, "expires_in": expires_in })))
  }
  ```

test "rank1911: the approval endpoint's state write does not clear the login in another function"
  lang rust
  file src/api/core/accounts.rs
  expect VYQL-AUTH-166
  expect_review code.UnapprovedLoginArtifactAuthentication
  code
  ```
  async fn put_auth_request(
      uuid: &str,
      data: Json<AuthResponseRequest>,
      headers: Headers,
      mut conn: DbConn,
  ) -> JsonResult {
      let mut auth_request = match AuthRequest::find_by_uuid(uuid, &mut conn).await {
          Some(auth_request) => auth_request,
          None => err!("AuthRequest doesn't exist", "Record not found"),
      };

      if headers.user.uuid != auth_request.user_uuid {
          err!("AuthRequest doesn't exist", "User uuid's do not match")
      }

      auth_request.approved = Some(data.request_approved);
      auth_request.save(&mut conn).await?;
      Ok(Json(json!({ "id": uuid })))
  }

  async fn _password_login(
      data: ConnectData,
      user_uuid: &mut Option<String>,
      conn: &mut DbConn,
      ip: &ClientIp,
  ) -> JsonResult {
      let password = data.password.as_ref().unwrap();
      if let Some(auth_request_uuid) = data.auth_request.clone() {
          if let Some(auth_request) = AuthRequest::find_by_uuid(auth_request_uuid.as_str(), conn).await {
              if !auth_request.check_access_code(password) {
                  err!("Username or access code is incorrect. Try again")
              }
          }
      } else if !user.check_valid_password(password) {
          err!("Username or password is incorrect. Try again")
      }

      let (access_token, expires_in) = device.refresh_tokens(&user, scope_vec);
      Ok(Json(json!({ "access_token": access_token, "expires_in": expires_in })))
  }
  ```
