test "rank1345: minimal pair -- an intrusive-list segment walk bounded from a mid-list cursor, while another function relinks at the head"
  lang c
  file segment_walk.c
  reject VYQL-MEM-007
  code
  ```
  struct obj { int age; struct obj *next; };

  struct pool {
    struct obj *head;      /* the list */
    struct obj *survival;  /* cursor into it */
    struct obj *oldest;    /* cursor into it */
    struct obj *pending;
  };

  extern void keep (struct pool *p, struct obj *o);
  extern void collect (struct pool *p, struct obj **from, struct obj *to);

  /* an object leaves 'pending' and is relinked at the head of the list */
  static struct obj *revive (struct pool *p) {
    struct obj *o = p->pending;
    p->pending = o->next;
    o->next = p->head;
    p->head = o;
    return o;
  }

  static void mark_aged (struct pool *p, struct obj *from, struct obj *to) {
    struct obj *o;
    for (o = from; o != to; o = o->next) {
      if (o->age == 1)
        keep(p, o);
    }
  }

  void minor_collect (struct pool *p) {
    mark_aged(p, p->survival, p->oldest);
    collect(p, &p->head, p->survival);
    collect(p, &p->survival, p->oldest);
  }
  ```

