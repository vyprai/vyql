# free5GC's PCF registered its Session Management and UE Policy SBI route
# groups without the authorization middleware every sibling group carries, so
# a peer that can reach the SBI drives the policy-control endpoints with no
# Authorization header at all (missing function-level access control,
# CWE-306/862). NewServer (internal/sbi/server.go:64) did
#
#   smPolicyRoutes := s.getSmPolicyRoutes()
#   smPolicyGroup := s.router.Group(factory.PcfSMpolicyCtlResUriPrefix)
#   applyRoutes(smPolicyGroup, smPolicyRoutes)
#
# and the UE-Policy twin, with nothing between the Group and the
# applyRoutes, while the same function's AM-Policy, BDT-Policy, OAM and
# Policy-Authorization groups each construct a
# util.NewRouterAuthorizationCheck and install it with
# group.Use(func(c *gin.Context) { check.Check(c, s.Context()) }) before
# their routes apply. Fix commit 8c4d457 (merge of PR #63,
# "fix(pcf): add missing auth middleware to smPolicyGroup and
# uePolicyGroup", +8 lines) installs the same middleware on both groups for
# ServiceName_NPCF_SMPOLICYCONTROL and ServiceName_NPCF_UE_POLICY_CONTROL.
# The SHA is the merge, the parent 508d70b is the fully vulnerable tree, and
# the remediation is present at <fix> and absent at <fix>^.
#
# Held ATTENTION at recheck, route-authorization completeness. The vulnerable
# code is the ABSENCE of a middleware on two of seven sibling groups; the
# expected pattern is visible four times in the same function, and the defect
# is that two groups skip it. That is the per-resource decision-completeness
# family (permission-switch branches, per-item gates in enumeration) at route
# registration, and the unit that needs the decision is the route group,
# which is not a fact anywhere. This is the second free5GC network function
# with the exact shape -- NEF mounted all five groups unchecked, SMF left its
# User Plane Information group unchecked -- and the third measurement of the
# same miss.
#
# Measured at recheck against the current knowledge base, not inherited.
# Three --cache off scans per revision of the real tree report an identical
# four findings at both revisions (a PermissiveCors and three
# UnvalidatedRouteIdentifier rows, none in internal/sbi/server.go) --
# later-shipped vocabulary fires more than at first review, but nothing
# discriminates the revisions. vyql match on server.go reports no source, no
# sink and no control at either revision: router.Group(prefix) is an ordinary
# call returning a value and goAtomToken returns "" for any *ast.CallExpr
# except len(...), so `smPolicyGroup := s.router.Group(...)` emits no assign:
# token linking the variable to the call, and the middleware a fix installs
# is a func(c *gin.Context) *ast.FuncLit, for which goFunctionTokens returns
# false, so the .Check call contributes no fact to NewServer at either
# revision. No Go binding at this tip labels gin route registration or the
# platform's authorization check, and the route-flavored authorization rules
# that do exist key on other ecosystems' frontend facts.
#
# Both counterweights fail here as they did on NEF and SMF. The naive
# generic form -- any function whose call paths mention Group with no
# authorization-named call in the body -- reports three functions at BOTH
# revisions: applyRoutes (internal/sbi/server.go:34, the mounting helper,
# which receives the group as a parameter) plus two RatingGroup substring
# false positives in the processors, while NewServer itself is suppressed at
# both revisions by its four sibling installs. Three false positives, zero
# true positives, and no delta on the repository that contains the bug. A
# per-group completeness rule does not separate the revisions either:
# httpcallbackGroup still mounts no authorization middleware at the fixed
# revision, so "a group with no check" is true of the patched tree too, and
# which groups need the decision is application semantics -- the reason a
# binding on free5gc's own RouterAuthorizationCheck would detect this
# platform rather than the weakness.
#
# No ENGINE-GAPS.md entry, as on the sibling network functions: the piece is
# ontology design (a route-group relation and route-authorization
# completeness), not a localised construct in one function. No definition
# change shipped. All three blocks reject VYQL-AUTH-079: when
# route-completeness vocabulary lands, the unchecked groups must flip to
# expect.
#
# verify_current_expected: attention-analysis-gap, both revisions rejected

test "rank1556: the policy groups mount their routes with no authorization middleware"
  lang go
  file internal/sbi/server.go
  reject VYQL-AUTH-079
  code
  ```
  package sbi

  import (
  	"github.com/gin-gonic/gin"

  	"github.com/free5gc/openapi/models"
  	"github.com/free5gc/pcf/internal/util"
  	"github.com/free5gc/pcf/pkg/factory"
  	logger_util "github.com/free5gc/util/logger"
  	"github.com/free5gc/util/metrics"
  )

  func NewServer(pcf pcf, tlsKeyLogPath string) (*Server, error) {
  	s := &Server{
  		pcf:    pcf,
  		router: logger_util.NewGinWithLogrus(logger.GinLog),
  	}

  	s.router.Use(metrics.InboundMetrics())

  	smPolicyRoutes := s.getSmPolicyRoutes()
  	smPolicyGroup := s.router.Group(factory.PcfSMpolicyCtlResUriPrefix)
  	applyRoutes(smPolicyGroup, smPolicyRoutes)

  	amPolicyRoutes := s.getAmPolicyRoutes()
  	amPolicyGroup := s.router.Group(factory.PcfAMpolicyCtlResUriPrefix)
  	amRouterAuthorizationCheck := util.NewRouterAuthorizationCheck(models.ServiceName_NPCF_AM_POLICY_CONTROL)
  	amPolicyGroup.Use(func(c *gin.Context) {
  		amRouterAuthorizationCheck.Check(c, s.Context())
  	})
  	applyRoutes(amPolicyGroup, amPolicyRoutes)

  	bdtPolicyRoutes := s.getBdtPolicyRoutes()
  	bdtPolicyGroup := s.router.Group(factory.PcfBdtPolicyCtlResUriPrefix)
  	bdtRouterAuthorizationCheck := util.NewRouterAuthorizationCheck(models.ServiceName_NPCF_BDTPOLICYCONTROL)
  	bdtPolicyGroup.Use(func(c *gin.Context) {
  		bdtRouterAuthorizationCheck.Check(c, s.Context())
  	})
  	applyRoutes(bdtPolicyGroup, bdtPolicyRoutes)

  	httpcallbackRoutes := s.getHttpCallBackRoutes()
  	httpcallbackGroup := s.router.Group(factory.PcfCallbackResUriPrefix)
  	applyRoutes(httpcallbackGroup, httpcallbackRoutes)

  	oamRoutes := s.getOamRoutes()
  	oamGroup := s.router.Group(factory.PcfOamResUriPrefix)
  	oamRouterAuthorizationCheck := util.NewRouterAuthorizationCheck(models.ServiceName_NPCF_OAM)
  	oamGroup.Use(func(c *gin.Context) {
  		oamRouterAuthorizationCheck.Check(c, s.Context())
  	})
  	applyRoutes(oamGroup, oamRoutes)

  	policyAuthorizationRoutes := s.getPolicyAuthorizationRoutes()
  	policyAuthorizationGroup := s.router.Group(factory.PcfPolicyAuthResUriPrefix)
  	policyAuthorizationRouterAuthorizationCheck := util.
  		NewRouterAuthorizationCheck(models.ServiceName_NPCF_POLICYAUTHORIZATION)
  	policyAuthorizationGroup.Use(func(c *gin.Context) {
  		policyAuthorizationRouterAuthorizationCheck.Check(c, s.Context())
  	})
  	applyRoutes(policyAuthorizationGroup, policyAuthorizationRoutes)

  	uePolicyRoutes := s.getUePolicyRoutes()
  	uePolicyGroup := s.router.Group(factory.PcfUePolicyCtlResUriPrefix)
  	applyRoutes(uePolicyGroup, uePolicyRoutes)

  	return s, nil
  }
  ```

