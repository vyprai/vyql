# Rank 1220 / CVE-2016-4985: Ironic's BaseAgentVendor.lookup returns
# node.as_dict() straight to the caller of the driver_passthru "lookup"
# vendor-passthru endpoint. as_dict() carries driver_info, which holds
# out-of-band management credentials (for example ipmi_password). Every
# other Ironic API response masks driver_info through the deployment's
# policy.json; this one bypassed it entirely, so a client that only knows
# (or guesses) a node's MAC address, with no authentication at all, could
# recover any node's driver credentials via a crafted POST to
# /v1/drivers/$DRIVER_NAME/vendor_passthru. Fixed by affec224977174581d19a
# (cherry-pick of 426a306fb580), which builds ndict = node.as_dict() and,
# when the caller's policy says show_password is false, overwrites
# ndict['driver_info'] with oslo_utils.strutils.mask_password(...) before
# it goes into the response dict.
#
# code.SensitiveDataInResponse and its rule (VYQL-SEC-044) already exist
# for credential material serialized into an HTTP response; only a Python
# binding was missing. Written from Ironic's own driver API surface, not
# this file's variable names: any function decorated with a driver_passthru/
# passthru decorator (Ironic's documented mechanism for exposing a vendor
# operation over the REST API) that calls .as_dict() on a versioned object
# with no oslo_utils.strutils.mask_password call anywhere in the same
# function is exactly the shape the fix closes -- an object export handed
# to an HTTP response with no redaction step. The reject case keeps the
# same decorator and as_dict() call and adds the mask_password call the
# real fix adds; presenceNode only sees a single function's body, so the
# masking has to happen inline rather than in a helper the way the fix's
# ast.literal_eval() dance is written.

test "rank1220: vendor lookup returns as_dict() with no password masking"
  lang python
  file ironic/drivers/modules/agent_base_vendor.py
  expect VYQL-SEC-044
  code
  ```
  class BaseAgentVendor(base.VendorInterface):
      @base.driver_passthru(['POST'], async=False)
      def lookup(self, context, **kwargs):
          uuid = kwargs.get('node_uuid')
          if uuid:
              node = objects.Node.get_by_uuid(context, uuid)
          else:
              inventory = kwargs.get('inventory')
              interfaces = self._get_interfaces(inventory)
              mac_addresses = self._get_mac_addresses(interfaces)
              node = self._find_node_by_macs(context, mac_addresses)

          LOG.info(_LI('Initial lookup for node %s succeeded, agent is '
                       'running and waiting for commands'), node.uuid)

          return {
              'heartbeat_timeout': CONF.agent.heartbeat_timeout,
              'node': node.as_dict()
          }
  ```

test "rank1220: vendor lookup masks driver_info before returning as_dict()"
  lang python
  file ironic/drivers/modules/agent_base_vendor.py
  reject VYQL-SEC-044
  code
  ```
  class BaseAgentVendor(base.VendorInterface):
      @base.driver_passthru(['POST'], async=False)
      def lookup(self, context, **kwargs):
          uuid = kwargs.get('node_uuid')
          if uuid:
              node = objects.Node.get_by_uuid(context, uuid)
          else:
              inventory = kwargs.get('inventory')
              interfaces = self._get_interfaces(inventory)
              mac_addresses = self._get_mac_addresses(interfaces)
              node = self._find_node_by_macs(context, mac_addresses)

          LOG.info(_LI('Initial lookup for node %s succeeded, agent is '
                       'running and waiting for commands'), node.uuid)

          ndict = node.as_dict()
          if not context.show_password:
              ndict['driver_info'] = ast.literal_eval(
                  strutils.mask_password(ndict['driver_info'], "******"))

          return {
              'heartbeat_timeout': CONF.agent.heartbeat_timeout,
              'node': ndict,
          }
  ```
