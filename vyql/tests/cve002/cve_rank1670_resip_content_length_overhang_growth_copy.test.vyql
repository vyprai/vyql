  expect VYQL-MEM-016
  code
  ```
  #include <stddef.h>
  #include <string.h>

  struct Conn {
     int st;
     char *mBuffer;
     size_t mBufferPos;
     size_t mBufferSize;

     bool grow(int bytesRead)
     {
        switch (st)
        {
        case 0:
           mBufferPos += bytesRead;
           break;
        case 1:
        {
           size_t newSize = mBufferSize*3/2;
           char *newBuffer = new char[newSize];
           memcpy(newBuffer, mBuffer, mBufferSize);
           mBufferSize = newSize;
           break;
        }
        }
        return true;
     }
  };
  ```
