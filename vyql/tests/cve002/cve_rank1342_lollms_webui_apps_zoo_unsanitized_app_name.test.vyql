# Rank 1342 / CVE-2024-8898: lollms-webui's apps-zoo router takes the app name
# straight out of the request path and joins it under the zoo directory:
#
#   @router.post("/install/{app_name}")
#   async def install_app(app_name: str, auth: AuthRequest):
#       check_access(lollmsElfServer, auth.client_id)
#       app_path = lollmsElfServer.lollms_paths.apps_zoo_path/app_name
#       os.makedirs(app_path, exist_ok=True)
#
#   @router.post("/uninstall/{app_name}")
#   async def uninstall_app(app_name: str, auth: AuthRequest):
#       app_path = lollmsElfServer.lollms_paths.apps_zoo_path / app_name
#       if app_path.exists():
#           shutil.rmtree(app_path)
#
# (endpoints/lollms_apps.py:339 and :410 on the vulnerable parent of
# 6d07c8a0dd). A FastAPI path parameter is raw request text, `Path.__truediv__`
# with a `..`-bearing or absolute segment escapes the base, and both endpoints
# then create a directory tree anywhere the server can write and recursively
# delete one anywhere it can unlink. Fix 6d07c8a0dd adds
# `app_name = sanitize_path(app_name)` at the top of each handler, and the same
# for `asset_type`/`file_name` in `lollms_assets`.
#
# `lollms.security.sanitize_path` is the library's documented path sanitizer:
# it normalises separators, then raises `HTTPException(400)` on an absolute
# path, on any run of two or more dots, on a repeated separator, on a
# `$(...)` command substitution, and on any character outside its allowed set,
# returning the value only when none of those hold. That is the control the
# patched handlers rely on, and without the label the scanner cannot
# tell the two revisions apart: VYQL-PATH-001 reported the vulnerable pair
# (`code.HttpInput` at the path parameter -> `code.FilePathAccess` at
# `os.makedirs` and `shutil.rmtree`, `unless path coveredBy
# core.PathCanonicalization` unsatisfied) and reported the patched pair
# identically, with `vyql match` showing no control label anywhere in the file.
# `bindings/python/lollms_security.vyql` supplies it as
# `core.PathCanonicalization` covering the path from the call onward, so the
# sanitized value is covered and only the unsanitized revision is reported.
# `allow_absolute_path=True` is excluded, because it drops exactly the
# rejection that confines the value to a base directory.
#
# Measured on the vulnerable checkout, whole repository, bounded scan
# (timeout 180, --cache off, --max-ram 6GB): 341 findings without the binding
# and 335 with it, no finding gained. All six it removes are call sites that
# applied the helper -- lollms_apps.py get_app_file (212), download_app
# (237) and lollms_assets (488), and lollms_help.py serve_help (60) through
# `sanitize_path_from_endpoint`. lollms_advanced.py's open_file (215) and
# open_folder (254) sanitize with `allow_absolute_path=True` and stay reported.
# The seven flows the CVE is about survive: install_app's parameter (340) into
# `os.makedirs`, `shutil.copytree` and `shutil.copy2` (346, 350, 358, 368, 369)
# and uninstall_app's (412) into `Path.exists` and `shutil.rmtree` (414, 415).
# Scanning the fixed revision reports none of those seven and keeps the
# file's other still-unsanitized handlers.
#
# verify_current_expected: fixed; the vulnerable install/uninstall handlers are
# reported and the patched ones are not.

test "rank1342: an install endpoint joins its unsanitized path parameter under the apps zoo and creates it"
  lang python
  file lollms_apps.py
  expect VYQL-PATH-001
  code
  ```
  import os
  import shutil
  from fastapi import APIRouter, HTTPException
  from lollms.security import check_access, sanitize_path

  router = APIRouter()


  @router.post("/install/{app_name}")
  async def install_app(app_name: str, auth: AuthRequest):
      check_access(lollmsElfServer, auth.client_id)
      REPO_DIR = lollmsElfServer.lollms_paths.personal_path/"apps_zoo_repo"

      app_path = lollmsElfServer.lollms_paths.apps_zoo_path/app_name
      os.makedirs(app_path, exist_ok=True)

      source_dir = REPO_DIR/app_name

      if not source_dir.exists():
          raise HTTPException(status_code=404, detail=f"App {app_name} not found in the local repository")

      for item in source_dir.glob('*'):
          shutil.copy2(item, app_path)

      return {"message": f"App {app_name} installed successfully."}
  ```

test "rank1342: an uninstall endpoint recursively deletes the tree named by its unsanitized path parameter"
  lang python
  file lollms_apps.py
  expect VYQL-PATH-001
  code
  ```
  import shutil
  from fastapi import APIRouter, HTTPException

  router = APIRouter()


  @router.post("/uninstall/{app_name}")
  async def uninstall_app(app_name: str, auth: AuthRequest):
      app_path = lollmsElfServer.lollms_paths.apps_zoo_path / app_name
      if app_path.exists():
          shutil.rmtree(app_path)
          return {"message": f"App {app_name} uninstalled successfully."}
      else:
          raise HTTPException(status_code=404, detail="App not found")
  ```

test "rank1342: the patched handlers pass the path parameter through the library's path sanitizer first"
  lang python
  file lollms_apps.py
  reject VYQL-PATH-001
  code
  ```
  import os
  import shutil
  from fastapi import APIRouter, HTTPException
  from lollms.security import check_access, sanitize_path

  router = APIRouter()


  @router.post("/install/{app_name}")
  async def install_app(app_name: str, auth: AuthRequest):
      check_access(lollmsElfServer, auth.client_id)
      app_name=sanitize_path(app_name)

      REPO_DIR = lollmsElfServer.lollms_paths.personal_path/"apps_zoo_repo"

      app_path = lollmsElfServer.lollms_paths.apps_zoo_path/app_name
      os.makedirs(app_path, exist_ok=True)

      source_dir = REPO_DIR/app_name

      if not source_dir.exists():
          raise HTTPException(status_code=404, detail=f"App {app_name} not found in the local repository")

      for item in source_dir.glob('*'):
          shutil.copy2(item, app_path)

      return {"message": f"App {app_name} installed successfully."}


  @router.post("/uninstall/{app_name}")
  async def uninstall_app(app_name: str, auth: AuthRequest):
      app_name=sanitize_path(app_name)
      app_path = lollmsElfServer.lollms_paths.apps_zoo_path / app_name
      if app_path.exists():
          shutil.rmtree(app_path)
          return {"message": f"App {app_name} uninstalled successfully."}
      else:
          raise HTTPException(status_code=404, detail="App not found")
  ```

test "rank1342: an asset endpoint serving a file name sanitized by the same helper is not reported"
  lang python
  file lollms_apps.py
  reject VYQL-PATH-001
  code
  ```
  from pathlib import Path
  from fastapi import APIRouter, HTTPException, Response
  from lollms.security import sanitize_path

  router = APIRouter()


  @router.get("/lollms_assets/{asset_type}/{file_name}")
  async def lollms_assets(asset_type: str, file_name: str):
      asset_type = sanitize_path(asset_type)
      file_name = sanitize_path(file_name)
      base_path = Path(__file__).parent

      if asset_type == "js":
          directory = base_path / "libraries"
          file_extension = ".js"
          content_type = "application/javascript"
      elif asset_type == "css":
          directory = base_path / "styles"
          file_extension = ".css"
          content_type = "text/css"
      else:
          raise HTTPException(status_code=400, detail="Invalid asset type")

      file_path = directory / f"{file_name}{file_extension}"

      if not file_path.is_file() or not file_path.is_relative_to(directory):
          raise HTTPException(status_code=404, detail="File not found")

      with file_path.open('r') as file:
          content = file.read()
      return Response(content=content, media_type=content_type)
  ```

test "rank1342: sanitizing with absolute paths allowed does not confine the value to a base directory"
  lang python
  file lollms_advanced.py
  expect VYQL-PATH-001
  code
  ```
  from pathlib import Path
  from fastapi import APIRouter
  from lollms.security import sanitize_path

  router = APIRouter()


  @router.post("/open_file/{name}")
  async def open_file(name: str):
      path = sanitize_path(name, allow_absolute_path=True)
      if Path(path).exists():
          with open(path, 'r') as f:
              return {"content": f.read()}
      return {"status": False}
  ```
