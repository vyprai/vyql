# Rank 1024 / CVE-2026-41475: the BACnet stack's WritePropertyMultiple decoder
# read past the end of the request buffer. wpm_decode_object_property() called
# decode_tag_number_and_value(), which takes no buffer size and so cannot stop
# at the end of the message, and a truncated BACnet/IP packet made it read one
# to seven bytes beyond the allocation on an embedded device (CWE-125). The
# fixed revision
# a70ce07507 moves the decoder onto the size-taking family, passing the
# remaining length and checking the negative return.
#
# The library documents the hazard itself: bacdcode.h marks these entry points
# BACNET_STACK_DEPRECATED("Use bacnet_tag_decode() instead"), 35 of them, so a
# binding naming them answers to the library's own header rather than to this
# CVE. That is what the new concept records: code.DeprecatedUnboundedDecoder
# (VYQL-MEM-053, CWE-125) reports the presence of a decode primitive with no
# size argument, in the same low-confidence style used for strcpy and
# sprintf under code.UnboundedCopySmell. No existing concept covered the read
# side; the copy smell is scoped to out-of-bounds writes.
#
# Measured. On the affected file the count is 7 at the vulnerable revision and 0 after,
# because migrating away from the unbounded family is exactly how the
# maintainers remediated it; across the whole source tree the deprecated calls
# drop from 28 to 5. Two independent C corpora, asterisk res/ and asterisk
# main/, report none, so the generically named entries in the list are not
# colliding with other protocol parsers. The full spec suite passes and OWASP
# stays at Java +1.00 and Python +0.90.

test "rank1024: WritePropertyMultiple decodes a tag with no buffer size available"
  lang c
  file src/bacnet/wpm.c
  expect VYQL-MEM-053
  code
  ```
  #include <stdint.h>

  int wpm_decode_object_property(
      const uint8_t *apdu, uint16_t apdu_len, BACNET_WRITE_PROPERTY_DATA *wp_data)
  {
      uint8_t tag_number = 0;
      uint32_t len_value = 0;
      uint16_t len = 0;

      if (apdu && (apdu_len > 5)) {
          len += decode_tag_number_and_value(&apdu[len], &tag_number, &len_value);
          if ((tag_number == 0) && (apdu_len > len)) {
              apdu_len -= len;
              len += decode_object_id(&apdu[len], &wp_data->object_type,
                  &wp_data->object_instance);
          }
      }

      return len;
  }
  ```

test "rank1024: fix decodes through the size-taking family and checks the result"
  lang c
  file src/bacnet/wpm.c
  reject VYQL-MEM-053
  code
  ```
  #include <stdint.h>

  int wpm_decode_object_property(
      const uint8_t *apdu, uint16_t apdu_size, BACNET_WRITE_PROPERTY_DATA *wp_data)
  {
      int len = 0, apdu_len = 0;

      if (apdu && (apdu_size > 5)) {
          len = bacnet_object_id_context_decode(
              &apdu[apdu_len], apdu_size - apdu_len, 0, &wp_data->object_type,
              &wp_data->object_instance);
          if (len <= 0) {
              return BACNET_STATUS_ERROR;
          }
          apdu_len += len;
      }

      return apdu_len;
  }
  ```
