# Rank 1015 / CVE-2025-57767: Asterisk crashes on a malformed SIP Authorization
# header. digest_lookup assigned the result of get_authorization_hdr(), which
# returns NULL when the request carries no Authorization header or one whose
# realm does not match, and dereferenced it on the next statement to read the
# digest algorithm, so a remote SIP request segfaults the process (CWE-253,
# CWE-476). The fixed revision guards the dereference with a ternary and adds an
# explicit auth_hdr == NULL branch returning PJSIP_SC_FORBIDDEN.
#
# ATTENTION, and measured twice. The concept, rule and C binding for this
# exist and work: code.UncheckedNullableResultDeref (VYQL-MEM-018, CWE-476)
# fires from the extractor fact analysis.nullable_result.unchecked_deref,
# computed in ccUncheckedNullableResultDerefObservations. The fact's assignment
# pattern requires the assignment target to be a member expression,
# obj->field = f(...), so the Asterisk shape -- a plain local pointer assigned
# from the call and dereferenced -- produces no finding.
#
# Accepting a plain identifier target is measured unshippable on the real
# revisions (res/ subtree, 3 x --cache off per revision, deterministic):
#
#  - the widening takes the subtree from 22 to 747 VYQL-MEM-018 rows (3764 to
#    4489 findings) and discriminates nothing -- the identical 747-row census
#    appears on the fixed revision. In digest_lookup the widened first match
#    fires on auth = get_auth() followed by S_OR(auth->realm, ...), a
#    pre-existing unchecked shape present in both revisions, and the extractor
#    returns after the first observation per function, so the CVE's own
#    auth_hdr assignment is never considered. The collateral is the ordinary C
#    accessor idiom, rtp = ast_rtp_instance_get_data(instance); rtp->..., with
#    92 rows in res_rtp_asterisk.c alone, and 163 rows on the 117 files of a
#    second tree (barebox drivers/net, against 5 before).
#  - emitting one observation per matching assignment and recognising a
#    ternary guard (target?) emits three raw facts in the vulnerable
#    digest_lookup against one in the fixed one, but every fact carries the
#    function body's location and the same constant evidence, so the finding
#    fingerprint deduplicates them to the same rows on both revisions.
#    Separating the pair would additionally need per-assignment locations in
#    the fact, and the collateral stays at 734 rows on the subtree.
#
# A whole-tree scan of either revision aborts at the 6 GB --max-ram ceiling
# (7.3 GB attempted), so the res/ subtree is the measured scope. The generic
# review that does fire on the real file, VYQL-MEM-006, reports nine
# dereferences at other lines and none at the vulnerable one, so it is noise
# rather than evidence here.
#
# The four tests below pin the behaviour that works, so a real fix has a
# regression test waiting for it: the member-target form is reported, its
# guarded form is not, and the plain-pointer forms stay unreported today.
#
# verify_current_expected: attention-engine-gap

test "rank1015: nullable result assigned to a plain pointer and dereferenced is missed"
  lang c
  file res/res_pjsip_authenticator_digest.c
  reject VYQL-MEM-018
  code
  ```
  #include <stddef.h>

  struct hdr { struct { int algorithm; } digest; };

  static struct hdr *get_authorization_hdr(const char *realm)
  {
      if (realm == NULL) {
          return NULL;
      }
      return lookup(realm);
  }

  int digest_lookup(const char *realm)
  {
      struct hdr *auth_hdr = get_authorization_hdr(realm);
      int algorithm = auth_hdr->digest.algorithm;
      return algorithm;
  }
  ```

test "rank1015: fix guards the plain pointer before dereferencing it"
  lang c
  file res/res_pjsip_authenticator_digest.c
  reject VYQL-MEM-018
  code
  ```
  #include <stddef.h>

  struct hdr { struct { int algorithm; } digest; };

  static struct hdr *get_authorization_hdr(const char *realm)
  {
      if (realm == NULL) {
          return NULL;
      }
      return lookup(realm);
  }

  int digest_lookup(const char *realm)
  {
      struct hdr *auth_hdr = get_authorization_hdr(realm);
      if (auth_hdr == NULL) {
          return -1;
      }
      int algorithm = auth_hdr->digest.algorithm;
      return algorithm;
  }
  ```

test "rank1015: the same weakness with a member assignment target is reported"
  lang c
  file res/res_pjsip_authenticator_digest.c
  expect VYQL-MEM-018
  code
  ```
  #include <stddef.h>

  struct hdr { struct { int algorithm; } digest; };
  struct state { struct hdr *auth_hdr; };

  static struct hdr *get_authorization_hdr(const char *realm)
  {
      if (realm == NULL) {
          return NULL;
      }
      return lookup(realm);
  }

  int digest_lookup(struct state *st, const char *realm)
  {
      st->auth_hdr = get_authorization_hdr(realm);
      int algorithm = st->auth_hdr->digest.algorithm;
      return algorithm;
  }
  ```

test "rank1015: a null guard on the member target suppresses the finding"
  lang c
  file res/res_pjsip_authenticator_digest.c
  reject VYQL-MEM-018
  code
  ```
  #include <stddef.h>

  struct hdr { struct { int algorithm; } digest; };
  struct state { struct hdr *auth_hdr; };

  static struct hdr *get_authorization_hdr(const char *realm)
  {
      if (realm == NULL) {
          return NULL;
      }
      return lookup(realm);
  }

  int digest_lookup(struct state *st, const char *realm)
  {
      st->auth_hdr = get_authorization_hdr(realm);
      if (st->auth_hdr == NULL) {
          return -1;
      }
      int algorithm = st->auth_hdr->digest.algorithm;
      return algorithm;
  }
  ```
