# Rank 1045 / CVE-2023-48704: ClickHouse's Gorilla codec wrote past the
# decompression destination in two ways (CWE-120, CWE-122, CWE-787).
# CompressionCodecGorilla.cpp took bytes_to_skip from the compressed header and
# checked it only against the source:
#
#   if (static_cast<UInt32>(2 + bytes_to_skip) > source_size)
#       throw Exception(...);
#   memcpy(dest, &source[2], bytes_to_skip);
#
# and decompressDataForType received dest as a bare pointer with no size at all,
# then wrote items_count items into it, items_count also coming from the input.
# The fixed revision adds bytes_to_skip >= uncompressed_size before the memcpy,
# threads dest_size into decompressDataForType and throws when
# items_count * sizeof(T) exceeds it, and adds a default arm to the bytes_size
# switch.
#
# CAUGHT by VYQL-MEM-016, on the memcpy half. Scanning the real file reports two
# rows, both code.RawMemoryCopySize at medium severity and high confidence, and
# one of them is the CVE's own line: the review condition reads "raw memory copy
# size expression needs bounds review", with the advisory that the size or source
# offset can exceed the destination or source object bounds. That is the question
# the fixed revision answers.
#
# Two limits, and the note is only worth having if it states them. The row does
# not separate the revisions: the fixed file reports the same two rows at the
# shifted lines, because the guard the fixed revision adds is not recognised as bounding the
# copy. And the loop half is invisible. decompressDataForType writing
# items_count items into a pointer whose size it is never given is the larger of
# the two bugs and nothing reports it, which is the same shape as ranks 1026,
# 1032 and 1038: the write is an unstructured index into a plain local, so the
# index observation never fires.
#
# verify_current_expected: caught-partial

test "rank1045: the header byte count is copied into the destination unchecked"
  lang cpp
  file src/Compression/CompressionCodecGorilla.cpp
  expect VYQL-MEM-016
  code
  ```
  void CompressionCodecGorilla::doDecompressData(const char * source, UInt32 source_size, char * dest, UInt32 uncompressed_size) const
  {
      if (source_size < 2)
          throw Exception(ErrorCodes::CANNOT_DECOMPRESS, "Cannot decompress. File has wrong header");

      UInt8 bytes_size = source[0];
      UInt8 bytes_to_skip = uncompressed_size % bytes_size;

      if (static_cast<UInt32>(2 + bytes_to_skip) > source_size)
          throw Exception(ErrorCodes::CANNOT_DECOMPRESS, "Cannot decompress Gorilla-encoded data. File has wrong header");

      memcpy(dest, &source[2], bytes_to_skip);
      UInt32 source_size_no_header = source_size - bytes_to_skip - 2;
      switch (bytes_size)
      {
      case 1:
          decompressDataForType<UInt8>(&source[2 + bytes_to_skip], source_size_no_header, &dest[bytes_to_skip]);
          break;
      case 8:
          decompressDataForType<UInt64>(&source[2 + bytes_to_skip], source_size_no_header, &dest[bytes_to_skip]);
          break;
      }
  }
  ```

test "rank1045: the fixed revision bounds the copy against the destination and still reports"
  lang cpp
  file src/Compression/CompressionCodecGorilla.cpp
  expect VYQL-MEM-016
  code
  ```
  void CompressionCodecGorilla::doDecompressData(const char * source, UInt32 source_size, char * dest, UInt32 uncompressed_size) const
  {
      if (source_size < 2)
          throw Exception(ErrorCodes::CANNOT_DECOMPRESS, "Cannot decompress. File has wrong header");

      UInt8 bytes_size = source[0];
      UInt8 bytes_to_skip = uncompressed_size % bytes_size;

      if (static_cast<UInt32>(2 + bytes_to_skip) > source_size)
          throw Exception(ErrorCodes::CANNOT_DECOMPRESS, "Cannot decompress Gorilla-encoded data. File has wrong header");

      if (bytes_to_skip >= uncompressed_size)
          throw Exception(ErrorCodes::CANNOT_DECOMPRESS, "Cannot decompress Gorilla-encoded data. File has wrong header");

      memcpy(dest, &source[2], bytes_to_skip);
      UInt32 source_size_no_header = source_size - bytes_to_skip - 2;
      UInt32 uncompressed_size_left = uncompressed_size - bytes_to_skip;
      switch (bytes_size)
      {
      case 1:
          decompressDataForType<UInt8>(&source[2 + bytes_to_skip], source_size_no_header, &dest[bytes_to_skip], uncompressed_size_left);
          break;
      case 8:
          decompressDataForType<UInt64>(&source[2 + bytes_to_skip], source_size_no_header, &dest[bytes_to_skip], uncompressed_size_left);
          break;
      default:
          throw Exception(ErrorCodes::CANNOT_DECOMPRESS, "Cannot decompress Gorilla-encoded data. File has wrong header");
      }
  }
  ```

test "rank1045: the loop writes an input-supplied item count into a sizeless destination"
  lang cpp
  file src/Compression/CompressionCodecGorilla.cpp
  reject VYQL-MEM-016
  code
  ```
  template <typename T>
  void decompressDataForType(const char * source, UInt32 source_size, char * dest)
  {
      const char * const source_end = source + source_size;

      if (source + sizeof(UInt32) > source_end)
          return;

      const UInt32 items_count = unalignedLoadLittleEndian<UInt32>(source);
      source += sizeof(items_count);

      T prev_value = 0;

      if (source + sizeof(T) > source_end || items_count < 1)
          return;

      prev_value = unalignedLoadLittleEndian<T>(source);
      unalignedStoreLittleEndian<T>(dest, prev_value);

      source += sizeof(prev_value);
      dest += sizeof(prev_value);

      for (UInt32 items_read = 1; items_read < items_count; ++items_read)
      {
          unalignedStoreLittleEndian<T>(dest, prev_value);
          dest += sizeof(prev_value);
      }
  }
  ```
