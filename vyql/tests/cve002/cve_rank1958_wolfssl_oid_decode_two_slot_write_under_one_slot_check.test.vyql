# CVE-2026-5187 (wolfSSL, recorded language c; the axis is CWE-129/787, a
# heap out-of-bounds write from an array-capacity check that covers less than
# the write it guards, not the advisory title's generic "off-by-one").
# `DecodeObjectId()` in wolfcrypt/src/asn.c decodes a DER object identifier
# into a caller-supplied `word16 out[]` whose element count arrives through
# `word32* outSz`. The loop guards every store with
# `if (y >= (int)*outSz) return BUFFER_E;` -- one free element -- but the
# first-arc branch stores TWO elements unconditionally:
#     if (y == 0) { out[0] = t / 40; out[1] = t % 40; y = 2; }
# so `outSz == 1` passes the check and `out[1]` writes one element past the
# buffer. The second location is caller-side: both call sites (DumpOID and
# DecodeCertExtensions) declare `word16 decOid[MAX_OID_SZ]` and pass
# `word32 decOidSz = sizeof(decOid)` -- MAX_OID_SZ * sizeof(word16), twice
# the element count the callee counts in -- so a long OID writes up to
# MAX_OID_SZ elements past the array. The fixed revision (PR 10025) moves the check to
# the write it guards -- `if (y == 0) { if ((int)*outSz < 2) return
# BUFFER_E; ... }` -- and corrects both callers to `decOidSz = MAX_OID_SZ`.
#
# Held at attention, re-measured on the current ruleset. Three
# `--cache off` runs per revision of wolfcrypt/src/asn.c at the parent and
# the fixed revision (timeout 180, --max-ram 6GB): 938 findings on each
# side, byte-stable inside each revision, and the two finding sets
# identical once the fix's three added lines are accounted for -- the one
# difference beyond the shift is a LOW VYQL-MEM-006 NullableDeref row on a
# `*outSz` dereference relocating with the moved guard (asn.c:6898 ->
# 6899). The two-slot store pair carries no finding at either revision;
# the file's 10 findings at or above high sit elsewhere. Findings in the
# function are not coverage. `vyql match` on the parent labels `out[0]`
# and `out[1]` as code.IndexAccessSink -- and labels nothing for
# `out[y++]`, because ccHasUpperBoundGuard
# (internal/extract/frontend/treesitter/c.go:7022) credits `y >= *outSz`
# as that store's upper bound: the engine actively treats the insufficient
# check as sufficient. `vyql match` on the caller labels only the later
# `decOid[i]` read (asn.c:7009) -- a declared array's capacity and a
# `sizeof` over it produce no node and no context token.
#
# The capacity-family observation vocabulary shipped since does not reach
# this shape: dest-capacity-unchecked copy (VYQL-MEM-071), self-sized copy
# into a declared array (VYQL-MEM-076), call-sized stack array
# (VYQL-MEM-077) and assert-only length copy (VYQL-MEM-079) all key on a
# copy call's length argument, a call-sized declarator or an assert-
# wrapped length, and this function contains no copy call at all --
# `match` emits no analysis.* node anywhere in DecodeObjectId, DumpOID or
# DecodeCertExtensions (134 elsewhere in the file). No shipped rule judges
# the relation either: VYQL-MEM-005 (TaintedIndexAccess, the only
# IndexAccessSink consumer) wants taint reaching the index and these
# indices are constants; VYQL-MEM-017 (CountDerivedElementAccess) wants a
# count-derived index; VYQL-MEM-041 wants a `count - 1` index; VYQL-MEM-016
# wants a raw memory copy. The discriminator is the number of elements the
# guard establishes versus the number the guarded branch writes, and on
# the caller side the byte-size versus element-count unit of a `sizeof`
# handed through a size variable -- the check-side sibling of the capacity
# family on file (1370: an output buffer's capacity parameter never
# correlated with a write length; 1837: a bounds check's length never
# compared with the guarded access's size), with the caller-side half
# being the declared-array-capacity gap (1756: `char timeBuf[32];` emits
# no node, nothing evaluates sizeof). Not mechanical for the same reason
# 1837 and 1756 record: it needs guard-versus-write-width facts and
# declared-capacity/sizeof evaluation, new cross-statement relations, not
# a localized correction.
#
# Precision constraint, re-enumerated on the parent: the same-base
# `[0] = ... [1] = ...` store-pair idiom appears on 124 distinct arrays
# across 52 of the first 400 non-test .c files of this repository, and 564
# assignments feed a bare identifier's `sizeof` into a variable in the
# same set -- nearly all of the latter the correct byte-unit spelling for
# a byte-counted API -- of which exactly one site is this weakness. A
# shape-only binding without the numeric relation fires on all of them and
# does not discriminate the callee fix, since the patched branch keeps
# both stores and a `*outSz` comparison. A second, untouched instance of
# the same unguarded two-arc shape sits in EncodedDottedForm
# (asn.c:35430) at both revisions, so the shape is live in-tree at the
# fixed revision too.
#
# verify_current_expected: attention-engine-gap, all five cases reject
# today because no binding or rule can see the element counts. When
# guard-capacity versus write-width vocabulary lands (the 1837/1756
# sweep), case 1 and case 3 must flip to expect while the patched forms
# and the correctly-sized guard idiom stay reject.

test "rank1958: two-slot first-arc store under a one-slot capacity check"
  lang c
  file asn.c
  reject VYQL-MEM-017
  code
  ```
  typedef unsigned char byte;
  typedef unsigned short word16;
  typedef unsigned int word32;

  #define BUFFER_E -132

  int DecodeObjectId(const byte* in, word32 inSz, word16* out, word32* outSz)
  {
      int x = 0, y = 0;
      word32 t = 0;
      int cnt = 0;

      if (in == 0 || outSz == 0) {
          return -173;
      }

      while (inSz--) {
          if (cnt == 4)
              return -170;
          t = (t << 7) | (in[x] & 0x7F);
          cnt++;
          if (!(in[x] & 0x80)) {
              if (y >= (int)*outSz) {
                  return BUFFER_E;
              }
              if (y == 0) {
                  out[0] = (word16)(t / 40);
                  out[1] = (word16)(t % 40);
                  y = 2;
              }
              else {
                  out[y++] = (word16)t;
              }
              t = 0;
              cnt = 0;
          }
          x++;
      }

      *outSz = (word32)y;

      return 0;
  }
  ```

test "rank1958: fix sizes the check to the two-slot write it guards"
  lang c
  file asn.c
  reject VYQL-MEM-017
  code
  ```
  typedef unsigned char byte;
  typedef unsigned short word16;
  typedef unsigned int word32;

  #define BUFFER_E -132

  int DecodeObjectId(const byte* in, word32 inSz, word16* out, word32* outSz)
  {
      int x = 0, y = 0;
      word32 t = 0;
      int cnt = 0;

      if (in == 0 || outSz == 0) {
          return -173;
      }

      while (inSz--) {
          if (cnt == 4)
              return -170;
          t = (t << 7) | (in[x] & 0x7F);
          cnt++;
          if (!(in[x] & 0x80)) {
              if (y == 0) {
                  if ((int)*outSz < 2) {
                      return BUFFER_E;
                  }
                  out[0] = (word16)(t / 40);
                  out[1] = (word16)(t % 40);
                  y = 2;
              }
              else {
                  if (y >= (int)*outSz) {
                      return BUFFER_E;
                  }
                  out[y++] = (word16)t;
              }
              t = 0;
              cnt = 0;
          }
          x++;
      }

      *outSz = (word32)y;

      return 0;
  }
  ```

test "rank1958: caller passes an array's sizeof as an element count"
  lang c
  file asn_caller.c
  reject VYQL-MEM-017
  code
  ```
  typedef unsigned char byte;
  typedef unsigned short word16;
  typedef unsigned int word32;

  #define MAX_OID_SZ 32

  int DecodeObjectId(const byte* in, word32 inSz, word16* out, word32* outSz);

  static int DecodeCertExtensionsUnknown(const byte* oidData, word32 oidSz)
  {
      word16 decOid[MAX_OID_SZ];
      word32 decOidSz = sizeof(decOid);
      int ret;

      ret = DecodeObjectId(oidData, oidSz, decOid, &decOidSz);
      if (ret == 0) {
          return (int)decOid[0];
      }
      return ret;
  }
  ```

test "rank1958: fix passes the element count, not the byte size"
  lang c
  file asn_caller.c
  reject VYQL-MEM-017
  code
  ```
  typedef unsigned char byte;
  typedef unsigned short word16;
  typedef unsigned int word32;

  #define MAX_OID_SZ 32

  int DecodeObjectId(const byte* in, word32 inSz, word16* out, word32* outSz);

  static int DecodeCertExtensionsUnknown(const byte* oidData, word32 oidSz)
  {
      word16 decOid[MAX_OID_SZ];
      word32 decOidSz = MAX_OID_SZ;
      int ret;

      ret = DecodeObjectId(oidData, oidSz, decOid, &decOidSz);
      if (ret == 0) {
          return (int)decOid[0];
      }
      return ret;
  }
  ```

test "rank1958: guard sized to the write width is the ordinary safe idiom"
  lang c
  file asn_safe.c
  reject VYQL-MEM-017
  code
  ```
  typedef unsigned short word16;
  typedef unsigned int word32;

  #define BUFFER_E -132

  /* Arc pair decoder whose check covers both stores: the idiom the
   * vulnerable form is indistinguishable from without element counts. */
  int DecodeFirstArcs(const word32 first, word16* out, word32* outSz)
  {
      if (out == 0 || outSz == 0) {
          return -173;
      }
      if ((int)*outSz < 2) {
          return BUFFER_E;
      }
      out[0] = (word16)(first / 40);
      out[1] = (word16)(first % 40);
      *outSz = 2;
      return 0;
  }
  ```
