# Rank 1882 / CVE-2018-15761: Cloud Foundry UAA's OAuth2 authorization endpoint
# serves the user-approval POST (`/oauth/authorize` with `user_oauth_approval`)
# through UaaAuthorizationEndpoint.approveOrDeny. The handler compares the
# session-held authorization request against the ORIGINAL_AUTHORIZATION_REQUEST
# copy it stored when the approval page is rendered (isAuthorizationRequestModified,
# a sibling predicate), but that comparison covers the request the *session* holds --
# it cannot see what the approval POST itself carries. The posted parameters are then
# handed to Spring Security OAuth2's documented approval flow:
#
#   authorizationRequest.setApprovalParameters(approvalParameters);
#   authorizationRequest = userApprovalHandler.updateAfterApproval(authorizationRequest,
#     (Authentication) principal);
#
# and UAA's UaaApprovalsUserApprovalHandler derives the granted scope set from the
# posted `scope.<index>` parameters. Nothing compares those names against the scope
# set of the original authorization request, so a user submitting the approval form
# with a crafted parameter (`scope.0=scope.<arbitrary scope name>`) is granted scopes
# the resource owner never saw on the approval page. The session-stored equality
# check passes because the session's authorization request is untouched; only the
# approval parameters carry the new names.
#
# 95b7d9e7fae534a362b98de1df5bf501cd52c481 ("Validate authz parameters against
# original authz request") closes it inside the same method, before the merge:
#
#   for (String approvalParameter : approvalParameters.keySet()) {
#       if (approvalParameter.startsWith(SCOPE_PREFIX)) {
#           String scope = approvalParameters.get(approvalParameter).substring(SCOPE_PREFIX.length());
#           Set<String> originalScopes = (Set<String>) originalAuthorizationRequest.get("scope");
#           if (!originalScopes.contains(scope)) { ... redirect invalid_scope ... }
#       }
#   }
#
# SCOPE_PREFIX is Spring's OAuth2Utils constant naming the documented `scope.`
# approval-parameter prefix, and `"scope"` is the OAuth2Utils.SCOPE key of the
# stored original request -- both library vocabulary, not the fixed revision's invention.
#
# The family is the CSRF/session one measured at 1501/1567/1581/1592/1601 (a
# state-changing endpoint mutating authorization state from request data without
# a consistency check against server-side session state), not the
# authorization-by-wiring family: the missing control is a data consistency check
# inside the handler, and the fixed revision adds it inline in the guarded method, so the
# attribution-gap shape (1377/1389/1399 and siblings) does not apply.
#
# Detection rides the review vehicle code.RequestScopePolicyReview (CWE_863,
# "request metadata and resource metadata are used without an observed
# request/resource scope consistency check") -- emitted by the Go bindings
# at vyql/bindings/go/backupConfigImportScopeReview.vyql and m48a985c1.vyql; the
# Java binding at vyql/bindings/java/oauth_approval_scope_consistency.vyql widens
# it to this language. Measured: the flag fires exactly once on the vulnerable
# revision (UaaAuthorizationEndpoint.java:348, the approveOrDeny handler), zero on
# the patched revision, stable over three --cache off runs on both the
# org/cloudfoundry/identity/uaa/oauth subtree (60 java files) and all of
# server/src/main/java (606 files). The stock definitions report nothing on the
# method (51 findings elsewhere in the subtree, none on approveOrDeny). The
# positive anchors' reachable set is enumerated by grep across every clone under
# /tmp/cve-work/rank*/: no other tree contains either call, so the collateral
# cost is zero by enumeration. The anchors are also absent from the OWASP Java
# corpus, so the binding cannot fire there.

test "rank1882: approveOrDeny merges posted approval parameters into the authorization request with no comparison against the original request's scope"
  lang java
  file server/src/main/java/org/cloudfoundry/identity/uaa/oauth/UaaAuthorizationEndpoint.java
  expect_review code.RequestScopePolicyReview
  code
  ```
  package org.cloudfoundry.identity.uaa.oauth;

  import java.security.Principal;
  import java.util.Map;
  import java.util.Set;

  import org.springframework.security.core.Authentication;
  import org.springframework.security.oauth2.common.exceptions.InvalidRequestException;
  import org.springframework.security.oauth2.common.util.OAuth2Utils;
  import org.springframework.security.oauth2.provider.AuthorizationRequest;
  import org.springframework.web.bind.annotation.RequestMapping;
  import org.springframework.web.bind.annotation.RequestMethod;
  import org.springframework.web.bind.annotation.RequestParam;
  import org.springframework.web.servlet.View;

  public class UaaAuthorizationEndpoint {

      @RequestMapping(value = "/oauth/authorize", method = RequestMethod.POST, params = OAuth2Utils.USER_OAUTH_APPROVAL)
      public View approveOrDeny(@RequestParam Map<String, String> approvalParameters, Map<String, ?> model,
                                SessionStatus sessionStatus, Principal principal) {

          AuthorizationRequest authorizationRequest = (AuthorizationRequest) model.get("authorizationRequest");

          Map<String, Object> originalAuthorizationRequest = (Map<String, Object>) model.get(
              "org.springframework.security.oauth2.provider.endpoint.AuthorizationEndpoint.ORIGINAL_AUTHORIZATION_REQUEST");
          if (isAuthorizationRequestModified(authorizationRequest, originalAuthorizationRequest)) {
              throw new InvalidRequestException("Changes were detected from the original authorization request.");
          }

          try {
              Set<String> responseTypes = authorizationRequest.getResponseTypes();
              String grantType = deriveGrantTypeFromResponseType(responseTypes);

              authorizationRequest.setApprovalParameters(approvalParameters);
              authorizationRequest = userApprovalHandler.updateAfterApproval(authorizationRequest,
                (Authentication) principal);
              boolean approved = userApprovalHandler.isApproved(authorizationRequest, (Authentication) principal);
              authorizationRequest.setApproved(approved);

              if (!authorizationRequest.isApproved()) {
                  return new RedirectView(getUnsuccessfulRedirect(authorizationRequest,
                    new UserDeniedAuthorizationException("User denied access"), responseTypes.contains("token")),
                    false, true, false);
              }

              return getAuthorizationCodeResponse(authorizationRequest, (Authentication) principal);
          } finally {
              sessionStatus.setComplete();
          }
      }

      private boolean isAuthorizationRequestModified(AuthorizationRequest authorizationRequest, Map<String, Object> originalAuthorizationRequest) {
          if (!ObjectUtils.nullSafeEquals(
            authorizationRequest.getClientId(),
            originalAuthorizationRequest.get(OAuth2Utils.CLIENT_ID))) {
              return true;
          }
          return !ObjectUtils.nullSafeEquals(
            authorizationRequest.getScope(),
            originalAuthorizationRequest.get(OAuth2Utils.SCOPE));
      }
  }
  ```

test "rank1882: approveOrDeny rejects a posted scope parameter the original authorization request does not carry"
  lang java
  file server/src/main/java/org/cloudfoundry/identity/uaa/oauth/UaaAuthorizationEndpoint.java
  reject_review code.RequestScopePolicyReview
  code
  ```
  package org.cloudfoundry.identity.uaa.oauth;

  import java.security.Principal;
  import java.util.Map;
  import java.util.Set;

  import org.springframework.security.core.Authentication;
  import org.springframework.security.oauth2.common.exceptions.InvalidRequestException;
  import org.springframework.security.oauth2.common.exceptions.InvalidScopeException;
  import org.springframework.security.oauth2.common.util.OAuth2Utils;
  import org.springframework.security.oauth2.provider.AuthorizationRequest;
  import org.springframework.web.bind.annotation.RequestMapping;
  import org.springframework.web.bind.annotation.RequestMethod;
  import org.springframework.web.bind.annotation.RequestParam;
  import org.springframework.web.servlet.View;

  import static org.springframework.security.oauth2.common.util.OAuth2Utils.SCOPE_PREFIX;

  public class UaaAuthorizationEndpoint {

      @RequestMapping(value = "/oauth/authorize", method = RequestMethod.POST, params = OAuth2Utils.USER_OAUTH_APPROVAL)
      public View approveOrDeny(@RequestParam Map<String, String> approvalParameters, Map<String, ?> model,
                                SessionStatus sessionStatus, Principal principal) {

          AuthorizationRequest authorizationRequest = (AuthorizationRequest) model.get("authorizationRequest");

          Map<String, Object> originalAuthorizationRequest = (Map<String, Object>) model.get(
              "org.springframework.security.oauth2.provider.endpoint.AuthorizationEndpoint.ORIGINAL_AUTHORIZATION_REQUEST");
          if (isAuthorizationRequestModified(authorizationRequest, originalAuthorizationRequest)) {
              throw new InvalidRequestException("Changes were detected from the original authorization request.");
          }

          for (String approvalParameter : approvalParameters.keySet()) {
              if (approvalParameter.startsWith(SCOPE_PREFIX)) {
                  String scope = approvalParameters.get(approvalParameter).substring(SCOPE_PREFIX.length());
                  Set<String> originalScopes = (Set<String>) originalAuthorizationRequest.get("scope");
                  if (!originalScopes.contains(scope)) {
                      sessionStatus.setComplete();
                      return new RedirectView(getUnsuccessfulRedirect(authorizationRequest,
                          new InvalidScopeException("The requested scopes are invalid. Please use valid scope names in the request."), false), false, true, false);
                  }
              }
          }

          try {
              Set<String> responseTypes = authorizationRequest.getResponseTypes();
              String grantType = deriveGrantTypeFromResponseType(responseTypes);

              authorizationRequest.setApprovalParameters(approvalParameters);
              authorizationRequest = userApprovalHandler.updateAfterApproval(authorizationRequest,
                (Authentication) principal);
              boolean approved = userApprovalHandler.isApproved(authorizationRequest, (Authentication) principal);
              authorizationRequest.setApproved(approved);

              if (!authorizationRequest.isApproved()) {
                  return new RedirectView(getUnsuccessfulRedirect(authorizationRequest,
                    new UserDeniedAuthorizationException("User denied access"), responseTypes.contains("token")),
                    false, true, false);
              }

              return getAuthorizationCodeResponse(authorizationRequest, (Authentication) principal);
          } finally {
              sessionStatus.setComplete();
          }
      }

      private boolean isAuthorizationRequestModified(AuthorizationRequest authorizationRequest, Map<String, Object> originalAuthorizationRequest) {
          if (!ObjectUtils.nullSafeEquals(
            authorizationRequest.getClientId(),
            originalAuthorizationRequest.get(OAuth2Utils.CLIENT_ID))) {
              return true;
          }
          return !ObjectUtils.nullSafeEquals(
            authorizationRequest.getScope(),
            originalAuthorizationRequest.get(OAuth2Utils.SCOPE));
      }
  }
  ```
