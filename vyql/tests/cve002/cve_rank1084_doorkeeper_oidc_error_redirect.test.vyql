# Rank 1084 / CVE-2019-9837: doorkeeper-openid_connect answered an
# authorization error by redirecting to the request's own redirect_uri, so
# whoever could trigger the error chose the Location (CWE-601).
# lib/doorkeeper/openid_connect/helpers/controller.rb built
# Doorkeeper::OAuth::ErrorResponse.new(..., redirect_uri: params[:redirect_uri])
# in its rescue and rendered json: error.body, status: :found,
# location: error.redirect_uri. The fixed revision takes the parameter only
# when pre_auth.valid? holds and otherwise uses pre_auth.error_response.
#
# The discriminator is doorkeeper's pre-authorization gate: `pre_auth` is the
# PreAuthorization the host controller exposes, and its documented `valid?`
# predicate is where the redirect_uri is matched against the registered
# client. Both revisions keep the construction and the redirect; only the
# gate differs, and the binding negates it.
#
# The keyword-argument pair and the object-hop block below pin a separate,
# still-open engine gap: a sink anchored at args[0] does not see a value
# passed as a keyword argument, so the taint route through
# `redirect_to location:` reports nothing while the positional form reports
# VYQL-RF-002.

test "rank1084: the error response redirects to the request's own uri"
  lang ruby
  file lib/doorkeeper/openid_connect/helpers/controller.rb
  expect VYQL-RF-055
  reject VYQL-RF-002
  code
  ```
  module Doorkeeper
    module OpenidConnect
      module Helpers
        module Controller
          def authenticate_resource_owner!
            super
          rescue Errors::OpenidConnectError => exception
            self.response_body = nil
            @_response_body = nil

            error = ::Doorkeeper::OAuth::ErrorResponse.new(name: exception.error_name, state: params[:state], redirect_uri: params[:redirect_uri])
            response.headers.merge!(error.headers)

            if error.redirectable?
              render json: error.body, status: :found, location: error.redirect_uri
            else
              render json: error.body, status: error.status
            end
          end
        end
      end
    end
  end
  ```

test "rank1084: the request uri is used only once the pre-auth validated it"
  lang ruby
  file lib/doorkeeper/openid_connect/helpers/controller.rb
  reject VYQL-RF-055
  code
  ```
  module Doorkeeper
    module OpenidConnect
      module Helpers
        module Controller
          def authenticate_resource_owner!
            super
          rescue Errors::OpenidConnectError => exception
            self.response_body = nil
            @_response_body = nil

            error_response = if pre_auth.valid?
              ::Doorkeeper::OAuth::ErrorResponse.new(
                name: exception.error_name,
                state: params[:state],
                redirect_uri: params[:redirect_uri]
              )
            else
              pre_auth.error_response
            end

            response.headers.merge!(error_response.headers)

            if error_response.redirectable?
              render json: error_response.body, status: :found, location: error_response.redirect_uri
            else
              render json: error_response.body, status: error_response.status
            end
          end
        end
      end
    end
  end
  ```

test "rank1084: a redirect target passed as a positional argument"
  lang ruby
  file positional.rb
  expect VYQL-RF-002
  code
  ```
  class AuthorizationsController < ApplicationController
    def create
      redirect_to params[:redirect_uri]
    end
  end
  ```

test "rank1084: the same redirect target passed as a keyword argument"
  lang ruby
  file keyword.rb
  reject VYQL-RF-002
  code
  ```
  class AuthorizationsController < ApplicationController
    def create
      redirect_to location: params[:redirect_uri]
    end
  end
  ```

# Taint reaches a redirect through object construction and an attribute read,
# so the object hop in the real code is not what stops it.

test "rank1084: taint reaches a redirect through a constructed error object"
  lang ruby
  file object_hop.rb
  expect VYQL-RF-002
  code
  ```
  class AuthorizationsController < ApplicationController
    def create
      error = ErrorResponse.new(name: :invalid_request, redirect_uri: params[:redirect_uri])
      redirect_to error.redirect_uri
    end
  end
  ```
