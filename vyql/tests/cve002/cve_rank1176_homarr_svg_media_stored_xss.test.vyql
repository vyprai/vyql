test "rank1176: an attachment disposition makes the response a download"
  lang javascript
  file download.ts
  reject VYQL-INJ-246
  code
  ```
  export async function GET(_req, props) {
    const image = await db.query.medias.findFirst({ where: eq(medias.id, props.params.id) });

    const headers = new Headers();
    headers.set("Content-Type", image.contentType);
    headers.set("Content-Disposition", `attachment; filename="${props.params.id}"`);

    return new NextResponse(new Uint8Array(image.content), {
      status: 200,
      headers,
    });
  }
  ```

