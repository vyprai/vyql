test "rank1176: a stored asset served under a name-derived mime type is the same class"
  lang javascript
  file asset-handler.ts
  expect VYQL-INJ-246
  code
  ```
  const mime = require("mime");

  export async function getAssetFromKV(event, options) {
    const pathKey = new URL(event.request.url).pathname.replace(/^\/+/, "");
    let mimeType = mime.getType(pathKey) || options.defaultMimeType;
    if (mimeType.startsWith("text") || mimeType === "application/javascript") {
      mimeType += "; charset=utf-8";
    }

    const object = await options.ASSET_NAMESPACE.get(pathKey, { type: "arrayBuffer" });
    const headers = new Headers();
    headers.set("Content-Type", mimeType);
    headers.set("Cache-Control", "public, max-age=14400");

    return new Response(object.body, {
      status: 200,
      headers,
    });
  }
  ```

