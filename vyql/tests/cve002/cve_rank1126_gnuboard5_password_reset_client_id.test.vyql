# Rank 1126 / CVE-2022-44216: GnuBoard5's password-reset finalization step
# updated whichever account's mb_id the request named, with nothing tying
# that account to the identity-verification step the flow was supposed to
# have already completed, so an attacker who reached the page after any
# identity check (even their own) could set any other account's password by
# POSTing that account's id (CWE-306, CWE-732).
#
# bbs/password_reset_update.php took `$mb_id = $_POST['mb_id']` directly and
# ran `update {member_table} set mb_password = ... where mb_id = '$mb_id'`
# with no check that this request followed a completed verification for that
# specific id. The identity-verification plugins (KCP, iniCERT, LGXPay,
# okname) run earlier in the flow and confirm a real-world identity, but
# nothing carried that confirmation's own account binding into this step.
#
# Pool commit 11718eb4c02f is the real fix (COMMIT_OK, GHSA-ch8g-82wx-x73x).
# It reads `$mb_id` and a `$mb_dupinfo` (a deduplication/identity fingerprint
# set only by the verification plugins) from `$_SESSION['ss_cert_mb_id']` and
# `$_SESSION['ss_cert_dupinfo']` instead of the POST body, requires a member
# row matching BOTH values together before proceeding, scopes the UPDATE's
# WHERE clause to both, and clears both session values once the reset
# completes so the same verification cannot be replayed for another update.
# The same session-instead-of-POST substitution is applied across the five
# plugin result pages and the two password_reset skin templates in the same
# commit. No pool correction.
#
# ATTENTION, vocabulary gap. Scanning either revision reports 0 findings.
# code.PasswordRecoveryLinkHostControl is the nearest concept under the same
# CWE-640 "weak password recovery mechanism" umbrella and the only auth-
# category review concept naming password recovery specifically, but its
# condition is about which host a reset LINK is built from, not about which
# account a reset UPDATE applies to; nothing in the ontology states "the
# account a password-reset finalization step modifies must come from a
# session value the verification step itself set, not from the request that
# claims to be finishing that verification."
#
# No definition change attempted.
#
# verify_current_expected: attention-vocabulary-gap, both revisions rejected.

test "rank1126: the account to reset comes straight from the POST body"
  lang php
  file password_reset_update.php
  reject_review code.PasswordRecoveryLinkHostControl
  code
  ```
  <?php
  include_once('./_common.php');

  $mb_id = isset($_POST['mb_id']) ? trim($_POST['mb_id']) : '';

  if (!$mb_id) {
      alert('회원아이디 값이 없습니다.');
  }

  $mb_password = isset($_POST['mb_password']) ? trim($_POST['mb_password_re']) : '';
  $mb_password_re = isset($_POST['mb_password_re']) ? trim($_POST['mb_password_re']) : '';

  $sql_password = '';
  if ($mb_password) {
      $sql_password = "mb_password = '" . get_encrypt_string($mb_password) . "' ";
  }

  sql_query("update {$g5['member_table']} set {$sql_password} where mb_id = '{$mb_id}'");

  goto_url(G5_BBS_URL . '/login.php');
  ```

test "rank1126: the account to reset comes from the verification step's own session values"
  lang php
  file password_reset_update.php
  reject_review code.PasswordRecoveryLinkHostControl
  code
  ```
  <?php
  include_once('./_common.php');

  $mb_id = isset($_SESSION['ss_cert_mb_id']) ? trim(get_session('ss_cert_mb_id')) : '';
  $mb_dupinfo = isset($_SESSION['ss_cert_dupinfo']) ? trim(get_session('ss_cert_dupinfo')) : '';

  if (!$mb_id) alert('회원아이디 값이 없습니다.', G5_URL);
  if (!$mb_dupinfo) alert('잘못된 접근입니다.', G5_URL);

  $mb_check = sql_fetch("select * from {$g5['member_table']} where mb_id = '{$mb_id}' AND mb_dupinfo = '{$mb_dupinfo}'");
  if (!$mb_check) alert('잘못된 접근입니다.', G5_URL);

  $mb_password = isset($_POST['mb_password']) ? trim($_POST['mb_password_re']) : '';
  $mb_password_re = isset($_POST['mb_password_re']) ? trim($_POST['mb_password_re']) : '';

  if (!$mb_password) alert('비밀번호가 넘어오지 않았습니다.');
  if ($mb_password != $mb_password_re) alert('비밀번호가 일치하지 않습니다.');

  $sql_password = "mb_password = '" . get_encrypt_string($mb_password) . "' ";

  sql_query("update {$g5['member_table']} set {$sql_password} where mb_id = '{$mb_id}' AND mb_dupinfo = '{$mb_dupinfo}'");

  set_session('ss_cert_mb_id', '');
  set_session('ss_cert_dupinfo', '');

  goto_url(G5_BBS_URL . '/login.php');
  ```
