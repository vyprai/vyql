# Rank 1126 / CVE-2022-44216: GnuBoard5's password-reset finalization updates
# whichever account id the request names, with nothing tying that id to the
# identity verification the flow has completed (CWE-306, CWE-732).
#
# ATTENTION: vocabulary gap. The account-selector axis has no ontology entry:
# nothing states that the account a reset finalization modifies must come from
# server-side state the verification step set rather than from the finishing
# request. The two nearest concepts are deliberately narrower —
# PasswordRecoveryLinkHostControl is about which host a reset LINK is built
# from, and PasswordChangeWithoutSessionInvalidation is the authenticated
# change (its condition has the caller re-authenticate with the current
# password), which a reset-from-verification flow is not. The injection axis
# does not stand in for this either: request data reaching the project's
# sql_query wrapper is traced interprocedurally down to mysqli_query, but the
# report keys a finding on rule and sink, so the caller-side path collapses
# into the row the library's own sources claim, and the finding sets over bbs/
# and lib/ are identical before and after the fix (455 findings on both, three
# cache-off runs each). A presence binding cannot separate the flow from
# self-registration or the nonce-gated mail-link reset in the same project:
# PHP module scope carries no file-name fact, so the reset-flow marker is
# inexpressible, and the only discriminator left is this fix's own
# session-read spelling.
#
# verify_current_expected: attention-vocabulary-gap, both revisions rejected.

test "rank1126: the account to reset comes straight from the POST body"
  lang php
  file password_reset_update.php
  reject_review code.PasswordRecoveryLinkHostControl
  reject_review code.PasswordChangeWithoutSessionInvalidation
  code
  ```
  <?php
  include_once('./_common.php');

  if($w == '')
      $mb_id = isset($_POST['mb_id']) ? trim($_POST['mb_id']) : '';
  else
      alert('잘못된 접근입니다', G5_URL);

  if(!$mb_id)
      alert('회원아이디 값이 없습니다. 올바른 방법으로 이용해 주십시오.');

  $mb_password    = isset($_POST['mb_password']) ? trim($_POST['mb_password_re']) : '';
  $mb_password_re = isset($_POST['mb_password_re']) ? trim($_POST['mb_password_re']) : '';

  if ($w == '' && !$mb_password)
      alert('비밀번호가 넘어오지 않았습니다.');
  if($w == '' && $mb_password != $mb_password_re)
      alert('비밀번호가 일치하지 않습니다.');

  $sql_password = "";
  if ($mb_password)
      $sql_password = "mb_password = '" . get_encrypt_string($mb_password) . "' ";

  sql_query("update {$g5['member_table']} set {$sql_password} where mb_id = '{$mb_id}'");

  goto_url(G5_BBS_URL . '/login.php');
  ```

test "rank1126: the account to reset comes from the verification step's own session values"
  lang php
  file password_reset_update.php
  reject_review code.PasswordRecoveryLinkHostControl
  reject_review code.PasswordChangeWithoutSessionInvalidation
  code
  ```
  <?php
  include_once('./_common.php');

  $mb_id = isset($_SESSION['ss_cert_mb_id']) ? trim(get_session('ss_cert_mb_id')) : '';
  $mb_dupinfo = isset($_SESSION['ss_cert_dupinfo']) ? trim(get_session('ss_cert_dupinfo')) : '';

  if (!$mb_id) alert('회원아이디 값이 없습니다. 올바른 방법으로 이용해 주십시오.', G5_URL);
  if (!$mb_dupinfo) alert('잘못된 접근입니다.', G5_URL);

  $mb_check = sql_fetch("select * from {$g5['member_table']} where mb_id = '{$mb_id}' AND mb_dupinfo = '{$mb_dupinfo}'");
  if (!$mb_check) alert('잘못된 접근입니다.', G5_URL);

  $mb_password    = isset($_POST['mb_password']) ? trim($_POST['mb_password_re']) : '';
  $mb_password_re = isset($_POST['mb_password_re']) ? trim($_POST['mb_password_re']) : '';

  if (!$mb_password) alert('비밀번호가 넘어오지 않았습니다.');
  if ($mb_password != $mb_password_re) alert('비밀번호가 일치하지 않습니다.');

  $sql_password = "mb_password = '" . get_encrypt_string($mb_password) . "' ";

  sql_query("update {$g5['member_table']} set {$sql_password} where mb_id = '{$mb_id}' AND mb_dupinfo = '{$mb_dupinfo}'");

  set_session('ss_cert_mb_id', '');
  set_session('ss_cert_dupinfo', '');

  goto_url(G5_BBS_URL . '/login.php');
  ```
