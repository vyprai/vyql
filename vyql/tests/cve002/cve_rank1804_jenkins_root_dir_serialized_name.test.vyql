test "rank1804: the separator check on the stored name stops the join from leaving the storage directory"
  lang java
  file SshPublicKeyCredential.java
  reject_review code.JenkinsRootDirFileNameTraversal
  code
  ```
  import java.io.File;
  import java.io.Serializable;

  public class SshPublicKeyCredential extends Credential {
      private final String userName;
      private final String id;

      public SshPublicKeyCredential(String userName, String passphrase, File keyFile) {
          this.userName = userName;
          this.id = "0a1b2c3d4e5f6071";
          File savedKeyFile = getKeyFile();
          FileUtils.copyFile(keyFile, savedKeyFile);
      }

      /**
       * Gets the location where the private key will be permanently stored.
       */
      private File getKeyFile() {
          if (id.contains("/") || id.contains("\\")) {
              throw new SecurityException();
          }
          File dir = new File(Jenkins.getInstance().getRootDir(),"subversion-credentials");
          if(dir.mkdirs()) {
              setFilePermissions(dir, "600");
          }
          return new File(dir,id);
      }

      public String createSVNAuthentication() throws IOException {
          return FileUtils.readFileToString(getKeyFile(),"iso-8859-1");
      }

      private boolean setFilePermissions(File file, String perms) {
          return true;
      }
  }
  ```
  file Credential.java
  ```
  import java.io.Serializable;

  public abstract class Credential implements Serializable {
  }
  ```
