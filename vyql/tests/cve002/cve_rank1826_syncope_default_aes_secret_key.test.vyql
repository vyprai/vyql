# apache/syncope, CVE-2025-65998 (SYNCOPE-1932, "Improve AES management").
# The change diff, not the title, gives the weakness: Encryptor carried a
# compile-time default AES key,
#
#   private static final String DEFAULT_SECRET_KEY = "1abcdefghilmnopqrstuvz2!";
#
# substituted whenever the operator supplied no key:
#
#   String actualKey = StringUtils.isBlank(secretKey) ? DEFAULT_SECRET_KEY : secretKey;
#
# Every installation that left security.secretKey unset encrypted its
# confidential attributes (admin password, LDAP/connector credentials) under a
# key published in the project's own source, and that key is then truncated to
# its first 16 bytes before reaching SecretKeySpec, so the effective key is
# always AES-128 regardless of what is configured:
#
#   keySpec = new SecretKeySpec(ArrayUtils.subarray(
#           actualKey.getBytes(StandardCharsets.UTF_8), 0, 16),
#           CipherAlgorithm.AES.getAlgorithm());
#
# CWE-798. The fixed revision deletes the constant outright: a blank key now yields an
# empty Optional and encode()/decode() throw IllegalArgumentException("AES not
# configured") instead of silently encrypting, and the full key byte array --
# its length driving AES-128/192/256 -- is what reaches SecretKeySpec.
#
# verify_current_expected: the vulnerable form reports VYQL-AUTH-101 on the
# DEFAULT_SECRET_KEY assignment; the patched form reports nothing, because the
# only key material left in source is the operator-supplied configuration
# property. Measured on the real checkout, three `timeout 180 ./bin/vyql scan
# --cache off --max-ram 6GB` runs per revision, byte-identical inside each
# revision: 473 findings on 9d706af25d2e^ against 471 on 9d706af25d2e, the sole
# vulnerability-relevant delta being VYQL-AUTH-101
# code.HardcodedSecretLiteral @ core/spring/src/main/java/org/apache/syncope/
# core/spring/security/Encryptor.java:49, present in all three runs at the
# parent and in none at the fixed revision. The remaining 2-finding drift is line-number
# shift on unrelated LogOutput/XmlParse sinks the commit's own length changes
# moved. The residual on this tree is a pre-existing VYQL-AUTH-101 on
# SecurityProperties.java:95 (`jwtIssuer = "ApacheSyncope"`), an issuer claim
# string that secretNamedTarget's "jwt" needle names a secret; it fires at both
# revisions and is not this defect.

test "rank1826: compile-time default AES key substituted when no secret key is configured"
  lang java
  file Encryptor.java
  expect VYQL-AUTH-101
  code
  ```
  package org.apache.syncope.core.spring.security;

  import java.nio.charset.StandardCharsets;
  import java.util.Map;
  import java.util.concurrent.ConcurrentHashMap;
  import javax.crypto.Cipher;
  import javax.crypto.spec.SecretKeySpec;
  import org.apache.commons.lang3.ArrayUtils;
  import org.apache.commons.lang3.StringUtils;

  public final class Encryptor {

      private static final Map<String, Encryptor> INSTANCES = new ConcurrentHashMap<>();

      private static final String DEFAULT_SECRET_KEY = "1abcdefghilmnopqrstuvz2!";

      private SecretKeySpec keySpec;

      public static Encryptor getInstance(final String secretKey) {
          String actualKey = StringUtils.isBlank(secretKey) ? DEFAULT_SECRET_KEY : secretKey;

          Encryptor instance = INSTANCES.get(actualKey);
          if (instance == null) {
              instance = new Encryptor(actualKey);
              INSTANCES.put(actualKey, instance);
          }

          return instance;
      }

      private Encryptor(final String secretKey) {
          String actualKey = secretKey;
          if (actualKey.length() < 16) {
              StringBuilder actualKeyPadding = new StringBuilder(actualKey);
              int length = 16 - actualKey.length();
              String randomChars = SecureRandomUtils.generateRandomPassword(length);

              actualKeyPadding.append(randomChars);
              actualKey = actualKeyPadding.toString();
          }

          try {
              keySpec = new SecretKeySpec(ArrayUtils.subarray(
                      actualKey.getBytes(StandardCharsets.UTF_8), 0, 16),
                      CipherAlgorithm.AES.getAlgorithm());
          } catch (Exception e) {
              // error during key specification
          }
      }

      public String encode(final String value, final CipherAlgorithm cipherAlgorithm) throws Exception {
          String encoded = null;

          if (value != null) {
              if (cipherAlgorithm == null || cipherAlgorithm == CipherAlgorithm.AES) {
                  Cipher cipher = Cipher.getInstance(CipherAlgorithm.AES.getAlgorithm());
                  cipher.init(Cipher.ENCRYPT_MODE, keySpec);

                  encoded = java.util.Base64.getEncoder().
                          encodeToString(cipher.doFinal(value.getBytes(StandardCharsets.UTF_8)));
              } else {
                  encoded = getDigester(cipherAlgorithm).digest(value);
              }
          }

          return encoded;
      }

      private Object getDigester(final CipherAlgorithm cipherAlgorithm) {
          throw new UnsupportedOperationException();
      }
  }
  ```

test "rank1826: fix has no compiled-in key material and refuses to encrypt without one"
  lang java
  file Encryptor.java
  reject VYQL-AUTH-101
  code
  ```
  package org.apache.syncope.core.spring.security;

  import java.nio.charset.StandardCharsets;
  import java.util.Map;
  import java.util.Optional;
  import java.util.concurrent.ConcurrentHashMap;
  import javax.crypto.Cipher;
  import javax.crypto.spec.SecretKeySpec;
  import org.apache.commons.lang3.StringUtils;

  public final class Encryptor {

      private static final Map<String, Encryptor> INSTANCES = new ConcurrentHashMap<>();

      public static Encryptor getInstance(final String aesSecretKey) {
          SecurityProperties securityProperties = Optional.ofNullable(
                          ApplicationContextProvider.getApplicationContext()).
                  flatMap(ctx -> {
                      try {
                          return Optional.ofNullable(ctx.getBean(SecurityProperties.class));
                      } catch (Exception e) {
                          return Optional.empty();
                      }
                  }).
                  orElseGet(() -> {
                      SecurityProperties props = new SecurityProperties();
                      props.setAesSecretKey(StringUtils.EMPTY);
                      return props;
                  });

          String actualKey = StringUtils.isBlank(aesSecretKey)
                  ? securityProperties.getAesSecretKey() : aesSecretKey;
          return INSTANCES.computeIfAbsent(actualKey, k -> new Encryptor(k));
      }

      private final Optional<SecretKeySpec> aesKeySpec;

      private Encryptor(final String aesSecretKey) {
          SecretKeySpec sks = null;

          if (StringUtils.isNotBlank(aesSecretKey)) {
              String actualKey = aesSecretKey;

              Integer pad = null;
              boolean truncate = false;
              if (actualKey.length() < 16) {
                  pad = 16 - actualKey.length();
              } else if (actualKey.length() > 16 && actualKey.length() < 24) {
                  pad = 24 - actualKey.length();
              } else if (actualKey.length() > 24 && actualKey.length() < 32) {
                  pad = 32 - actualKey.length();
              } else if (actualKey.length() > 32) {
                  truncate = true;
              }

              if (pad != null) {
                  StringBuilder actualKeyPadding = new StringBuilder(actualKey);
                  String randomChars = SecureRandomUtils.generateRandomPassword(pad);

                  actualKeyPadding.append(randomChars);
                  actualKey = actualKeyPadding.toString();
              }
              if (truncate) {
                  actualKey = actualKey.substring(0, 32);
              }

              try {
                  sks = new SecretKeySpec(actualKey.getBytes(StandardCharsets.UTF_8),
                          CipherAlgorithm.AES.getAlgorithm());
              } catch (Exception e) {
                  // error during key specification
              }
          }

          aesKeySpec = Optional.ofNullable(sks);
      }

      public String encode(final String value, final CipherAlgorithm cipherAlgorithm) throws Exception {
          String encoded = null;

          if (value != null) {
              if (cipherAlgorithm == null || cipherAlgorithm == CipherAlgorithm.AES) {
                  Cipher cipher = Cipher.getInstance(CipherAlgorithm.AES.getAlgorithm());
                  cipher.init(Cipher.ENCRYPT_MODE, aesKeySpec.
                          orElseThrow(() -> new IllegalArgumentException("AES not configured")));

                  encoded = java.util.Base64.getEncoder().
                          encodeToString(cipher.doFinal(value.getBytes(StandardCharsets.UTF_8)));
              } else {
                  encoded = (String) getDigester(cipherAlgorithm);
              }
          }

          return encoded;
      }

      private Object getDigester(final CipherAlgorithm cipherAlgorithm) {
          throw new UnsupportedOperationException();
      }
  }
  ```
