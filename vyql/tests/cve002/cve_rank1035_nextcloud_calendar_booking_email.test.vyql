# Rank 1035 / CVE-2022-24838: Nextcloud Calendar's public appointment booking
# took the attendee address from the request and concatenated it into the
# iCalendar document without validating it (CWE-74):
#
#   $vcalendar->VEVENT->add('ATTENDEE',
#     'mailto:' . $email,
#     [ 'CN' => $displayName, ... ]);
#
# BookingController::bookSlot is a @PublicPage, so $email arrives from an
# unauthenticated caller, passes through BookingService::book and reaches two
# writers in this repository: BookingCalendarWriter::write (the ATTENDEE
# property, then createFromString on the serialized .ics) and
# MailService::sendConfirmationEmail, whose recipient write is
# ->setTo([$booking->getEmail() => $booking->getDisplayName()]) followed by
# $this->mailer->send($message). The fixed revision injects OCP\Mail\IMailer
# and rejects the request with 422 when validateMailAddress fails.
#
# ATTENTION, re-verified against the current knowledge base: all three layers
# are missing at once and the first is the blocker.
#
#  - No source. vyql match reports no sources on the controller, service,
#    writer or mail service, because a parameter of a Nextcloud AppFramework
#    controller method is bound from the request by the framework and nothing
#    says so. The PHP frontend's parameter-entry tokens carry function and
#    parameter names and types but no class token, so a binding cannot key on
#    "action method of a Controller subclass" or on @PublicPage at all. A
#    general binding for that would add sources to every Nextcloud app at
#    once, no Nextcloud corpus exists beyond this one application to measure
#    it on, and the generic action-parameter source shape is measured
#    unshippable on a comparable framework (+88 findings for 1 true positive).
#  - No sink. code.MailHeaderWrite is bound in PHP only for the fourth
#    argument of mail(); ruby carries net/smtp envelope addresses, but an OCP
#    mail message's setTo and an iCalendar property are not bound.
#  - No control. IMailer::validateMailAddress, which is the whole fix, is not
#    a known email-validation control.
#
# Binding the iCalendar property as a CRLF sink is the tempting middle step
# and the measurement argues against it: the same function writes 'CN' =>
# $displayName and DESCRIPTION => $description from equally unvalidated request
# data, so such a rule reports 3 sites in the one function the fixed revision
# touched, for 1 true positive, and the maintainers left the other two alone.
# The mail-recipient route does not rescue it either: without a source it
# reports nothing on either revision, and the javascript analogue (a mail
# sendMail sink over the reachable set) is measured at one genuine row for two
# spurious and deliberately not shipped.
#
# Both revisions of the whole tree report the same 62 findings with identical
# fingerprints; the three VYQL-RF-043 rows on BookingService's mapper writes
# are the only booking-flow findings, present on both sides, and nothing
# names the address.
#
# verify_current_expected: attention-precision-cost

test "rank1035: an unvalidated booking address is concatenated into the attendee property"
  lang php
  file lib/Service/Appointments/BookingCalendarWriter.php
  reject VYQL-INJ-017
  code
  ```
  <?php
  class BookingCalendarWriter {
      public function write($config, $start, string $displayName, string $email, string $description) {
          $vcalendar = new VCalendar([
              'VEVENT' => [ 'SUMMARY' => $config->getName(), 'DTSTART' => $start ]
          ]);
          if (!empty($description)) {
              $vcalendar->VEVENT->add('DESCRIPTION', $description);
          }
          $vcalendar->VEVENT->add('ATTENDEE',
              'mailto:' . $email,
              [
                  'CN' => $displayName,
                  'CUTYPE' => 'INDIVIDUAL',
                  'RSVP' => 'TRUE'
              ]
          );
          return $vcalendar->serialize();
      }
  }
  ```

test "rank1035: fix rejects the booking when the address does not validate"
  lang php
  file lib/Controller/BookingController.php
  reject VYQL-INJ-017
  code
  ```
  <?php
  class BookingController extends Controller {
      private $mailer;
      private $bookingService;

      public function bookSlot(int $appointmentConfigId,
                               int $start,
                               int $end,
                               string $displayName,
                               string $email,
                               string $description,
                               string $timeZone): JsonResponse {
          if (!$this->mailer->validateMailAddress($email)) {
              return JsonResponse::fail('Invalid email address', Http::STATUS_UNPROCESSABLE_ENTITY);
          }
          if ($start > $end) {
              return JsonResponse::fail('Invalid time range', Http::STATUS_UNPROCESSABLE_ENTITY);
          }
          $booking = $this->bookingService->book($config, $start, $end, $timeZone, $displayName, $email, $description);
          return JsonResponse::success($booking);
      }
  }
  ```
