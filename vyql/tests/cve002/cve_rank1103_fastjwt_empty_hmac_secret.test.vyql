# Rank 1103 / CVE-2026-44351: fast-jwt builds an HMAC key from whatever the key
# resolver returns, so a resolver returning '' or Buffer.alloc(0) leaves the
# verifier checking signatures against a zero-length secret (CWE-287, CWE-326,
# CWE-1391).
#
# ATTENTION: precision cost. Treating createSecretKey/createHmac as sinks that
# require a length control would fire widely on configuration-sourced secrets
# with no true positives; a literal empty-key binding does not reach a
# runtime-empty resolver return.
#
# verify_current_expected: attention-precision-cost, both revisions rejected.

test "rank1103: the symmetric key is built from an unchecked value"
  lang javascript
  file src/verifier.js
  reject VYQL-AUTH-006
  code
  ```
  const { createPublicKey, createSecretKey } = require('crypto')
  const { TokenError } = require('./error')

  function prepareKeyOrSecret(key, isSecret) {
    if (typeof key === 'string') {
      key = Buffer.from(key, 'utf-8')
    }

    return isSecret ? createSecretKey(key) : createPublicKey(key)
  }

  module.exports = { prepareKeyOrSecret }
  ```

test "rank1103: the zero-length symmetric secret is rejected first"
  lang javascript
  file src/verifier.js
  reject VYQL-AUTH-006
  code
  ```
  const { createPublicKey, createSecretKey } = require('crypto')
  const { TokenError } = require('./error')

  function prepareKeyOrSecret(key, isSecret) {
    if (typeof key === 'string') {
      key = Buffer.from(key, 'utf-8')
    }

    if (isSecret && key.length === 0) {
      throw new TokenError(TokenError.codes.invalidKey, 'The key cannot be an empty string or buffer.')
    }

    return isSecret ? createSecretKey(key) : createPublicKey(key)
  }

  module.exports = { prepareKeyOrSecret }
  ```
