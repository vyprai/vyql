# Rank 1103 / CVE-2026-44351: fast-jwt built an HMAC key from whatever the
# key resolver returned, so a resolver resolving '' (a JWKS-style fallback
# like keys[kid] || '') left the verifier checking signatures against a
# zero-length secret anyone can reproduce (CWE-287, CWE-326, CWE-1391).
# Passing a resolver is the documented createVerifier form and the empty
# value arises inside the library, so the caller is correct code and the
# report that belongs to this CVE is the dependency finding: a pin below
# 6.2.4, the release the advisory names as first fixed.

test "rank1103: a fast-jwt pin below the first fixed release is a dependency finding"
  lang javascript
  file app.js
  code
  ```
  const { createVerifier } = require('fast-jwt');

  // The documented key-resolver form; a kid missing from the JWKS map
  // resolves '' and the library builds the HMAC key from it.
  const verify = createVerifier({
    key: async (header) => jwks[header.kid] || ''
  });

  function authenticate(req) {
    return verify(req.headers.authorization);
  }
  ```
  file package.json
  code
  ```
  {
    "name": "api-gateway",
    "dependencies": {
      "fast-jwt": "6.2.3"
    }
  }
  ```
  expect VYQL-SCA-001
  expect_evidence VYQL-SCA-001 CVE-2026-44351

test "rank1103: a fast-jwt pin at the first fixed release is clean"
  lang javascript
  file app.js
  code
  ```
  const { createVerifier } = require('fast-jwt');

  const verify = createVerifier({
    key: async (header) => jwks[header.kid] || ''
  });

  function authenticate(req) {
    return verify(req.headers.authorization);
  }
  ```
  file package.json
  code
  ```
  {
    "name": "api-gateway",
    "dependencies": {
      "fast-jwt": "6.2.4"
    }
  }
  ```
  reject VYQL-SCA-001

# The resolver form is correct code whatever the library version: the caller
# is using the documented API, and the vulnerable-library report is carried
# by the dependency finding above, not by an authentication finding on it.

test "rank1103: the resolver-based verifier is not an authentication finding on a vulnerable pin"
  lang javascript
  file app.js
  code
  ```
  const { createVerifier } = require('fast-jwt');

  const verify = createVerifier({
    key: async (header) => jwks[header.kid] || ''
  });

  function authenticate(req) {
    return verify(req.headers.authorization);
  }
  ```
  file package.json
  code
  ```
  {
    "name": "api-gateway",
    "dependencies": {
      "fast-jwt": "6.2.3"
    }
  }
  ```
  reject VYQL-AUTH-006

# The library's own code, both halves. No code-level rule covers the
# unguarded form: keying a length control on createSecretKey would flag
# every configuration-sourced secret (the constructors appear across the
# benchmark corpora with a zero-length check in none of them), and the empty
# value reaches the constructor from a resolver at run time, so no literal
# form reaches it either. Both revisions pin that miss.

test "rank1103: the symmetric key is built from an unchecked value"
  lang javascript
  file src/verifier.js
  reject VYQL-AUTH-006
  code
  ```
  const { createPublicKey, createSecretKey } = require('crypto')
  const { TokenError } = require('./error')

  function prepareKeyOrSecret(key, isSecret) {
    if (typeof key === 'string') {
      key = Buffer.from(key, 'utf-8')
    }

    return isSecret ? createSecretKey(key) : createPublicKey(key)
  }

  module.exports = { prepareKeyOrSecret }
  ```

test "rank1103: the zero-length symmetric secret is rejected first"
  lang javascript
  file src/verifier.js
  reject VYQL-AUTH-006
  code
  ```
  const { createPublicKey, createSecretKey } = require('crypto')
  const { TokenError } = require('./error')

  function prepareKeyOrSecret(key, isSecret) {
    if (typeof key === 'string') {
      key = Buffer.from(key, 'utf-8')
    }

    if (isSecret && key.length === 0) {
      throw new TokenError(TokenError.codes.invalidKey, 'The key cannot be an empty string or buffer.')
    }

    return isSecret ? createSecretKey(key) : createPublicKey(key)
  }

  module.exports = { prepareKeyOrSecret }
  ```
