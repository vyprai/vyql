  export function scan(src: string, tokens: Token[] = []) {
    let previous = '';

    while (src) {
      if (src === previous) {
        throw new Error('tokenizer consumed nothing');
      }
      previous = src;

      let token: Token | undefined;

      if (token = space(src)) {
        src = src.substring(token.raw.length);
        tokens.push(token);
        continue;
      }

      if (src) {
        throw new Error('Infinite loop on byte: ' + src.charCodeAt(0));
      }
    }

    return tokens;
  }
  ```

test "rank1358: scanning loop guarded by a bounded iteration counter"
  lang javascript
  file src/scanner.ts
  reject VYQL-DOS-029
  reject_review code.NumericParserMissingProgressCheck
  code
  ```
  export function scan(src: string, tokens: Token[] = []) {
    let guard = 0;

    while (src) {
      if (++guard > 100000) {
        throw new Error('too many iterations');
      }

      let token: Token | undefined;

      if (token = space(src)) {
        src = src.substring(token.raw.length);
        tokens.push(token);
        continue;
      }

      if (src) {
        throw new Error('Infinite loop on byte: ' + src.charCodeAt(0));
      }
    }

    return tokens;
  }
  ```

test "rank1358: cursor scanner whose bailout follows every restart over an index rather than a buffer"
  lang javascript
  file src/scanner.ts
  reject VYQL-DOS-029
  reject_review code.NumericParserMissingProgressCheck
  code
  ```
  export function scan(src: string, tokens: Token[] = []) {
    let pos = 0;

    for (;;) {
      if (pos >= src.length) {
        break;
      }

      let token: Token | undefined;

      if (token = space(src, pos)) {
        pos += token.raw.length;
        tokens.push(token);
        continue;
      }

      if (token = text(src, pos)) {
        pos += token.raw.length;
        tokens.push(token);
        continue;
      }

      if (pos < src.length) {
        throw new Error('Infinite loop on byte: ' + src.charCodeAt(pos));
      }
    }

    return tokens;
  }
  ```
