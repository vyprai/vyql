# Rank 1905 / CVE-2025-12758: validator.js's isLength counted every
# variation selector in the input individually. The validator computes the
# length it checks as str.length minus the number of presentation-sequence
# matches minus the number of surrogate-pair matches, and the
# presentation-sequence pattern (src/lib/isLength.js:17 at the vulnerable revision)
# reads /(\uFE0F|\uFE0E)/g -- an alternation of single invisible code units
# with no requirement that a base character precede the selector. A string
# made purely of N bare variation selectors therefore subtracts N from a
# length of N and validates as length 0, so isLength(str, { max: 10 })
# accepts an arbitrarily long string of invisible code units and every
# consumer bound by the max is bypassed (CWE-172 encoding error, CWE-792
# protection mechanism failure; the advisory is GHSA-vghf-hv5q-vc2g). The
# under-count runs the other way too: the fixed revision's own regression test pins
# 'test\uFE0F\uFE0F' at length 5 where the old pattern computed 4, and
# '\uFE0Ftest' at 5 where it computed 4. Fix d457ecaf rewrites the pattern
# to /[^\uFE0F\uFE0E][\uFE0F\uFE0E]/g -- a base character and its selector
# consumed as one match -- and changes nothing else: the whole
# src/lib/isLength.js diff is that one regex literal. Construct present at
# the parent, remediation present at the fixed revision. .
#
# Not the ReDoS family this repository's advisories usually carry: the
# pattern has no quantifier at all, so nothing backtracks and the 1864/1881
# regex cost-model gap does not apply.
#
# ATTENTION, vocabulary gap. The whole discriminator lives inside the regex
# literal's inner spelling -- the arithmetic around it
# (str.length - presentationSequences.length - surrogatePairs.length,
# compared against min and max) is byte-identical at both revisions, so
# every AST-shape route fires on both revisions or on neither. Measured on
# the real checkout, three --cache off runs per revision (timeout 180,
# --max-ram 6GB, deterministic): 18 findings at the vulnerable revision and 18 at
# the fixed revision with identical fingerprint multisets, none naming
# src/lib/isLength.js at either revision; the tree's rows are the generic
# library.param-source advisories (DOS-001 on blacklist/matches/
# multilineRegex new RegExp builds, INJ-013 proto-pollute, INJ-002 on
# typeOf). vyql match on the real file verbatim reports no source, no
# sink, no control; vyql resolve resolves the .match calls (nothing
# terminates early); vyql explain reports no findings.
#
# Binding routes priced. A needle on the escapes does not discriminate:
# both spellings carry \uFE0F and \uFE0E, and the fixed pattern is the
# negated class of the same two code units. The only text that separates
# the revisions is the vulnerable revision's own alternation spelling
# "(\uFE0F|\uFE0E)" -- keying on it is the repro-shaped patch the
# genericity test rejects: isLength's documentation says "check if the
# string's length falls in a range" and never mentions variation
# selectors, so no one derives that needle from the library's
# documentation. A general form would need to know which escapes are
# invisible code units (FE0E/FE0F, 200B-200D, 2060, 00AD, combining
# ranges) and that an alternation of them matches individually while a
# base-anchored pair class does not -- Unicode character semantics and
# regex semantics, neither of which is library-API knowledge -- and the
# census prices the class at one real-code instance in the corpus: the
# \uFE0F/\uFE0E escapes appear in four other files across the ~90 sibling
# checkouts (tinymce's ExtendingChar.ts and UnicodeData.ts data tables, a
# typebot grapheme regex that anchors the selector to a base, one minified
# bundle), none subtracting a match count from a length, and the
# alternation spelling appears nowhere else at all. Concepts considered
# and not fitting: code.UncheckedEncodedLengthArithmetic (serialized
# protocol length overflow, CWE-190/835),
# code.UnicodeNormalizationAfterFilterBypass (normalisation order inside a
# filter, CWE-176/74), code.ArrayBufferTransferMaxLengthBypass
# (ArrayBuffer transfer allocation), code.UnboundedEmailRegexValidation
# (ReDoS resource). A length check under-counted by individually-counted
# invisible code units has no concept, and the same function's next line
# -- the surrogate-pair subtraction -- is the identical arithmetic done
# correctly, so the shape alone can never carry the judgement. Not an
# engine gap: the regex literal is reachable as a literal token and a
# binding can read its text; there is just no generic meaning to attach.
# No definition change shipped, no ENGINE-GAPS.md entry.
#
# verify_current_expected: attention-vocabulary-gap, both revisions
# rejected. When invisible-code-unit counting vocabulary lands, the first
# test flips to expect and the third stays reject.

test "rank1905: the length check subtracts every bare variation selector"
  lang javascript
  file src/lib/isLength.js
  profile library
  reject VYQL-VAL-009
  reject VYQL-DOS-001
  code
  ```
  import assertString from './util/assertString';

  /* eslint-disable prefer-rest-params */
  export default function isLength(str, options) {
    assertString(str);
    let min;
    let max;

    if (typeof (options) === 'object') {
      min = options.min || 0;
      max = options.max;
    } else { // backwards compatibility: isLength(str, min [, max])
      min = arguments[1] || 0;
      max = arguments[2];
    }

    const presentationSequences = str.match(/(\uFE0F|\uFE0E)/g) || [];
    const surrogatePairs = str.match(/[\uD800-\uDBFF][\uDC00-\uDFFF]/g) || [];
    const len = str.length - presentationSequences.length - surrogatePairs.length;
    const isInsideRange = len >= min && (typeof max === 'undefined' || len <= max);

    if (isInsideRange && Array.isArray(options?.discreteLengths)) {
      return options.discreteLengths.some(discreteLen => discreteLen === len);
    }

    return isInsideRange;
  }
  ```

test "rank1905: the fixed revision counts a base character and its selector as one"
  lang javascript
  file src/lib/isLength.js
  profile library
  reject VYQL-VAL-009
  reject VYQL-DOS-001
  code
  ```
  import assertString from './util/assertString';

  /* eslint-disable prefer-rest-params */
  export default function isLength(str, options) {
    assertString(str);
    let min;
    let max;

    if (typeof (options) === 'object') {
      min = options.min || 0;
      max = options.max;
    } else { // backwards compatibility: isLength(str, min [, max])
      min = arguments[1] || 0;
      max = arguments[2];
    }

    const presentationSequences = str.match(/[^\uFE0F\uFE0E][\uFE0F\uFE0E]/g) || [];
    const surrogatePairs = str.match(/[\uD800-\uDBFF][\uDC00-\uDFFF]/g) || [];
    const len = str.length - presentationSequences.length - surrogatePairs.length;
    const isInsideRange = len >= min && (typeof max === 'undefined' || len <= max);

    if (isInsideRange && Array.isArray(options?.discreteLengths)) {
      return options.discreteLengths.some(discreteLen => discreteLen === len);
    }

    return isInsideRange;
  }
  ```

# The precision pin. The surrogate-pair subtraction is the same arithmetic
# with a pattern that only ever matches two code units at a time -- the
# correct astral-plane adjustment, present unchanged at both revisions.
# Any concept minted for the under-counting class must leave it alone.

test "rank1905: the surrogate-pair subtraction counts pairs and must stay unreported"
  lang javascript
  file src/lib/astralLength.js
  profile library
  reject VYQL-VAL-009
  code
  ```
  import assertString from './util/assertString';

  export default function astralLength(str) {
    assertString(str);
    const surrogatePairs = str.match(/[\uD800-\uDBFF][\uDC00-\uDFFF]/g) || [];
    const len = str.length - surrogatePairs.length;
    return len;
  }
  ```
