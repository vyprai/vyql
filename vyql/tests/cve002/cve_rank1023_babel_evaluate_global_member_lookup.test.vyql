# Rank 1023 / CVE-2023-45133: compiling attacker-crafted source with Babel could
# run arbitrary code during compilation, through the constant folding in
# path.evaluate(). The evaluator resolved an object from the global object by
# name and then took a member off it by name, with only an allow-list of object
# names and a deny-list of method names in front:
#
#   context = global[object.node.name];
#   func = context[property.node.name];
#
# The member lookup walks the prototype chain, so a name the deny-list misses,
# or a polluted prototype member, is reachable and gets called (CWE-184,
# CWE-697). The fixed revision takes the member only when the object owns it,
# via Object.hasOwnProperty.call(context, key).
#
# Detection: the existing concept code.ExpressionEvaluatorPrototypeNameAccess
# (VYQL-INJ-167, CWE-1321) describes an evaluator resolving member
# tokens against JavaScript objects without rejecting prototype-sensitive names,
# but its only binding is pinned to another evaluator's token names. A second
# binding now covers the general shape: a function that indexes the global
# object with a dynamic key and carries no own-property guard. The guard side is
# an extractor fact that distinguishes these two revisions.
#
# The base match is exact rather than a substring. Matching "global" loosely
# also hits ordinary code such as state.prefs.global?.[prefName] and
# globalPrefs, which produced three false positives on one client codebase;
# requiring the index base to be exactly global removed them. Measured across
# five JavaScript corpora, including an expression-evaluator library, the
# binding reports the Babel evaluator and nothing else.

test "rank1023: evaluator takes a member off a global object with no own-property guard"
  lang javascript
  file packages/babel-traverse/src/path/evaluation.ts
  expect VYQL-INJ-167
  code
  ```
  function _evaluate(path, state) {
    const callee = path.get("callee");
    let context;
    let func;

    if (callee.isMemberExpression()) {
      const object = callee.get("object");
      const property = callee.get("property");

      if (
        object.isIdentifier() &&
        property.isIdentifier() &&
        isValidObjectCallee(object.node.name) &&
        !isInvalidMethod(property.node.name)
      ) {
        context = global[object.node.name];
        func = context[property.node.name];
      }
    }

    return func;
  }
  ```

test "rank1023: fix takes the member only when the object owns it"
  lang javascript
  file packages/babel-traverse/src/path/evaluation.ts
  reject VYQL-INJ-167
  code
  ```
  function _evaluate(path, state) {
    const callee = path.get("callee");
    let context;
    let func;

    if (callee.isMemberExpression()) {
      const object = callee.get("object");
      const property = callee.get("property");

      if (
        object.isIdentifier() &&
        property.isIdentifier() &&
        isValidObjectCallee(object.node.name) &&
        !isInvalidMethod(property.node.name)
      ) {
        context = global[object.node.name];
        const key = property.node.name;
        if (Object.hasOwnProperty.call(context, key)) {
          func = context[key];
        }
      }
    }

    return func;
  }
  ```
