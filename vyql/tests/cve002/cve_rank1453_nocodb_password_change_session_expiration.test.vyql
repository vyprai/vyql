# Rank 1453 / CVE-2022-2064: NocoDB authenticates API requests with a bearer
# JWT that carries only `email`, `id`, `roles` and the standard claims, and the
# passport-jwt strategy in `packages/nocodb/src/lib/meta/api/userApi/
# initStrategies.ts` accepts it on signature and expiry alone -- it looks the
# user up by the payload's email (or returns a cached copy of that lookup) and
# hands it back as the principal. Nothing about the account is consulted, so
# there is no server-side state a credential change could move.
#
# `passwordChange` in `userApi/userApis.ts` is the flow that needs one. It
# checks `req.isAuthenticated()`, re-hashes the submitted current password
# against the stored salt, compares it, then writes a freshly derived
# `{ salt, password }` onto the user row -- and stops. Every token minted
# before that write keeps authenticating for the rest of its ten-hour lifetime.
# Someone who learned the old password, or held a session on a shared machine,
# survives exactly the action taken to lock them out; the same holds for the
# reset and forgot flows, which set a new credential from an emailed token.
#
# The fixed revision adds the missing state: a `token_version` column, stamped into the
# JWT at sign-in and compared against the account's stored value in the
# strategy's verify callback, and nulled by `passwordChange`,
# `passwordForgot` and `passwordReset`. A token whose claim fails to match
# is refused with `Token Expired. Please login again.`
#
# Step 0: no metadata flag. The row is the PR merge; `git show` reads it in
# full. The vulnerable construct is present at the parent -- `passwordChange`
# writing salt and password with nothing else -- and the remediation is
# present at the fixed revision, migration `nc_017_add_user_token_version_column`
# included. No pool row correction.
#
# What the binding reads is documented in two libraries and nothing else:
# passport's `req.isAuthenticated()`, which says an authenticatedcated
# principal is driving the request, and a password-hash derivation
# (`bcrypt.hash`, `argon2.hash`, `crypto.scrypt`, `crypto.pbkdf2`), which says
# a new credential is being minted rather than merely verified. Together that
# is an authenticated password-change endpoint. The negation is the vocabulary
# a revocation control is spelled with -- a session destroy or regenerate, a
# refresh-token or all-session revoke, or a stored version/timestamp the token
# is checked against.
#
# Measured on `packages/nocodb/src`: 3/3/3 at the parent against 2/2/2 at the
# fix over three `--cache off` runs each. The one that clears is
# `userApi/userApis.ts:265`, the CVE's own function. The two that remain are
# true positives the change leaves alone -- the v1-legacy `passwordChange` in
# `rest/RestAuthCtrl.ts` and `gql/GqlAuthResolver.ts`, both still writing salt
# and password with no invalidation, against a legacy jwt strategy
# (`GqlAuthResolver.ts:134`) that still returns the user on the payload's email
# alone.
#
# Three variants pin what the discrimination rests on. The patched function
# with the neutraliser rewritten as an unrelated remediation -- deleting the
# `token_version` write and calling `req.session.destroy()` instead -- also
# reports zero, so the clause reads a control vocabulary rather than this
# commit's layout. A comment naming `token_version`, `passwordChangedAt` and
# `req.session.destroy()` inside the vulnerable function leaves it reporting,
# since these tokens are AST-derived. And renaming the fixed revision's column throughout
# to a word no revocation idiom uses brings the flag back: the residual is
# that a revocation control spelled with a name outside the documented set is
# invisible, which is the false-negative direction.
#
# The reachable set outside this repository is empty and says nothing about
# precision: across the ~170 clones under /tmp/cve-work/rank*/ only four
# JavaScript or TypeScript files call `.isAuthenticated(` at all, all four in
# one Auth0 SDK, and none of them derives a password hash.

test "rank1453: an authenticated password change writes the new hash and leaves outstanding tokens valid"
  lang javascript
  expect VYQL-AUTH-141
  expect_review code.PasswordChangeWithoutSessionInvalidation
  code
  ```
  import bcrypt from 'bcryptjs';
  import { promisify } from 'util';
  import User from '../../../models/User';

  export async function passwordChange(req, res) {
    if (!req.isAuthenticated()) {
      return res.status(403).json({ msg: 'Not allowed' });
    }
    const { currentPassword, newPassword } = req.body;
    if (!currentPassword || !newPassword) {
      return res.status(400).json({ msg: 'Missing new/old password' });
    }

    const user = await User.getByEmail(req.user.email);
    const hashedPassword = await promisify(bcrypt.hash)(
      currentPassword,
      user.salt
    );
    if (hashedPassword !== user.password) {
      return res.status(400).json({ msg: 'Current password is wrong' });
    }

    const salt = await promisify(bcrypt.genSalt)(10);
    const password = await promisify(bcrypt.hash)(newPassword, salt);

    await User.update(user.id, {
      salt,
      password,
      email: user.email
    });

    res.json({ msg: 'Password updated successfully' });
  }
  ```

test "rank1453: the credential write clears the token version the strategy checks"
  lang javascript
  reject VYQL-AUTH-141
  reject_review code.PasswordChangeWithoutSessionInvalidation
  code
  ```
  import bcrypt from 'bcryptjs';
  import { promisify } from 'util';
  import User from '../../../models/User';

  export async function passwordChange(req, res) {
    if (!req.isAuthenticated()) {
      return res.status(403).json({ msg: 'Not allowed' });
    }
    const { currentPassword, newPassword } = req.body;
    if (!currentPassword || !newPassword) {
      return res.status(400).json({ msg: 'Missing new/old password' });
    }

    const user = await User.getByEmail(req.user.email);
    const hashedPassword = await promisify(bcrypt.hash)(
      currentPassword,
      user.salt
    );
    if (hashedPassword !== user.password) {
      return res.status(400).json({ msg: 'Current password is wrong' });
    }

    const salt = await promisify(bcrypt.genSalt)(10);
    const password = await promisify(bcrypt.hash)(newPassword, salt);

    await User.update(user.id, {
      salt,
      password,
      email: user.email,
      token_version: null
    });

    res.json({ msg: 'Password updated successfully' });
  }
  ```

test "rank1453: the credential write drops the session it is made under"
  lang javascript
  reject VYQL-AUTH-141
  reject_review code.PasswordChangeWithoutSessionInvalidation
  code
  ```
  import bcrypt from 'bcryptjs';
  import { promisify } from 'util';
  import User from '../../../models/User';

  export async function passwordChange(req, res) {
    if (!req.isAuthenticated()) {
      return res.status(403).json({ msg: 'Not allowed' });
    }
    const { currentPassword, newPassword } = req.body;
    if (!currentPassword || !newPassword) {
      return res.status(400).json({ msg: 'Missing new/old password' });
    }

    const user = await User.getByEmail(req.user.email);
    const hashedPassword = await promisify(bcrypt.hash)(
      currentPassword,
      user.salt
    );
    if (hashedPassword !== user.password) {
      return res.status(400).json({ msg: 'Current password is wrong' });
    }

    const salt = await promisify(bcrypt.genSalt)(10);
    const password = await promisify(bcrypt.hash)(newPassword, salt);

    await User.update(user.id, {
      salt,
      password,
      email: user.email
    });

    await req.session.destroy();

    res.json({ msg: 'Password updated successfully' });
  }
  ```
