test "rank1962: the guarded form the real handler uses, after the repo probe"
  lang javascript
  file deploy.ts
  expect VYQL-INJ-119
  code
  ```
  import { execSync } from "node:child_process";

  export const pagesDeployCommand = createCommand({
  	handler: async (args) => {
  		const { commitHash, commitMessage } = args;

  		let isGitDir = true;
  		try {
  			execSync(`git rev-parse --is-inside-work-tree`, { stdio: "ignore" });
  		} catch {
  			isGitDir = false;
  		}

  		if (isGitDir) {
  			try {
  				if (!commitMessage) {
  					commitMessage = execSync(`git show -s --format=%B ${commitHash}`)
  						.toString()
  						.trim();
  				}
  			} catch {}
  		}
  	},
  });
  ```

test "rank1962: the fixed revision passes the commit hash as one argv element, no shell"
  lang javascript
  file deploy.ts
  reject VYQL-INJ-119
  code
  ```
  import { execFileSync, execSync } from "node:child_process";

  export const pagesDeployCommand = createCommand({
  	handler: async (args) => {
  		const { commitHash, commitMessage } = args;

  		let isGitDir = true;
  		try {
  			execSync(`git rev-parse --is-inside-work-tree`, { stdio: "ignore" });
  		} catch {
  			isGitDir = false;
  		}

  		if (isGitDir) {
  			try {
  				if (!commitMessage) {
  					commitMessage = execFileSync("git", [
  						"show",
  						"-s",
  						"--format=%B",
  						commitHash,
  					])
  						.toString()
  						.trim();
  				}
  			} catch {}
  		}
  	},
  });
  ```

test "rank1962: a value from the real argv flowing through the same guarded shape"
  lang javascript
  file deploy.ts
  expect VYQL-INJ-119
  code
  ```
  import { execSync } from "node:child_process";

  export const pagesDeployCommand = createCommand({
  	handler: (args) => {
  		const hash = process.argv[2];

  		let ok = true;
  		try {
  			execSync("git rev-parse", { stdio: "ignore" });
  		} catch {
  			ok = false;
  		}

  		if (ok) {
  			execSync(`git show -s --format=%B ${hash}`);
  		}
  	},
  });
  ```

test "rank1962: the taint path through the guarded shape, which needs the sink node to survive the try/catch"
  lang javascript
  file deploy.ts
  expect VYQL-INJ-002
  code
  ```
  import { execSync } from "node:child_process";

  export const pagesDeployCommand = createCommand({
  	handler: (args) => {
  		const hash = process.argv[2];

  		let ok = true;
  		try {
  			execSync("git rev-parse", { stdio: "ignore" });
  		} catch {
  			ok = false;
  		}

  		if (ok) {
  			execSync(`git show -s --format=%B ${hash}`);
  		}
  	},
  });
  ```
