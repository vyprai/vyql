# Rank 1367 / CVE-2016-11074 (GHSA-j26g-95ph-2mwv, "a password-reset link could
# be reused", fixed in Mattermost Server 3.0.0): the reset link carried its own
# authorisation instead of spending one the server had issued, so it stayed
# valid for its whole embedded hour no matter how many times it is presented
# and no matter that the reset it is mailed for has since changed the
# password (CWE-640, CWE-294).
#
# api/user.go's sendPasswordReset built the link body itself --
# `{"user_id": ..., "time": ...}` as `d`, and
# `model.HashPassword(d + ":" + utils.Cfg.EmailSettings.PasswordResetSalt)` as
# `h`. resetPassword then took `d` and `h` straight back off the request,
# recomputed the hash with the same configured salt via model.ComparePassword,
# parsed the `time` out of the payload it had just authenticated and accepted
# anything under an hour old, and wrote the credential with
# Srv.Store.User().UpdatePassword for whichever user_id that payload named.
# Nothing existed server-side for the reset to consume, so nothing could be
# invalidated once it had been used.
#
# The fixed revision replaces the self-describing token with a record: sendPasswordReset
# saves a model.PasswordRecovery via Srv.Store.PasswordRecovery().SaveOrUpdate
# and mails only its Code, and resetPassword resolves the account by
# PasswordRecovery().GetByCode(code), takes the user id from the record rather
# than the request, and deletes the record before the reset returns.
#
# Detection is code.PasswordResetTokenReplay (VYQL-AUTH-117, CWE-640/CWE-294),
# emitted by the goPasswordResetTokenReplay binding on a Go function that
# compares a request-supplied reset hash against a configured reset salt and
# writes a credential, with neither a recovery-record lookup nor a session
# binding in the same body. code.AuthenticationRequiredOp lands on the
# UpdatePassword call, but it lands on the patched revision's UpdatePassword
# too, and on the sibling change-password handler, so it cannot tell any of
# them apart.
#
# The fixing commit for the single-use recovery record is
# 2e5617c29be69637acd384e85f795a0b343bec8d ("PLT-2057 User as a first class
# object", 2016-04-22), which adds model/password_recovery.go and
# store/sql_recovery_store.go and shipped in 3.0.0. Both revisions below come
# from that commit and its parent 5c755463ed3a4c74a383fb4460b5be02d8868481.

test "rank1367: password reset authorises the credential write with a hash it recomputes from the configured reset salt"
  lang go
  file api/user.go
  expect VYQL-AUTH-117
  expect_review code.PasswordResetTokenReplay
  code
  ```
  package api

  import (
  	"fmt"
  	"net/http"
  	"strconv"
  	"strings"

  	"github.com/mattermost/platform/model"
  	"github.com/mattermost/platform/utils"
  )

  func resetPassword(c *Context, w http.ResponseWriter, r *http.Request) {
  	props := model.MapFromJson(r.Body)

  	newPassword := props["new_password"]
  	if len(newPassword) < 5 {
  		c.SetInvalidParam("resetPassword", "new_password")
  		return
  	}

  	hash := props["hash"]
  	if len(hash) == 0 {
  		c.SetInvalidParam("resetPassword", "hash")
  		return
  	}

  	data := model.MapFromJson(strings.NewReader(props["data"]))

  	userId := data["user_id"]
  	timeStr := data["time"]
  	if len(timeStr) == 0 {
  		c.SetInvalidParam("resetPassword", "data:time")
  		return
  	}

  	if len(userId) != 26 {
  		c.SetInvalidParam("resetPassword", "user_id")
  		return
  	}

  	if !model.ComparePassword(hash, fmt.Sprintf("%v:%v", props["data"], utils.Cfg.EmailSettings.PasswordResetSalt)) {
  		c.Err = model.NewLocAppError("resetPassword", "api.user.reset_password.invalid_link.app_error", nil, "")
  		return
  	}

  	t, err := strconv.ParseInt(timeStr, 10, 64)
  	if err != nil || model.GetMillis()-t > 1000*60*60 {
  		c.Err = model.NewLocAppError("resetPassword", "api.user.reset_password.link_expired.app_error", nil, "")
  		return
  	}

  	if result := <-Srv.Store.User().UpdatePassword(userId, model.HashPassword(newPassword)); result.Err != nil {
  		c.Err = result.Err
  		return
  	}

  	c.LogAuditWithUserId(userId, "success")
  	w.Write([]byte(model.MapToJson(props)))
  }
  ```

test "rank1367: password reset resolves the account from a recovery record it deletes"
  lang go
  file api/user.go
  reject VYQL-AUTH-117
  reject_review code.PasswordResetTokenReplay
  code
  ```
  package api

  import (
  	"net/http"

  	l4g "github.com/alecthomas/log4go"

  	"github.com/mattermost/platform/model"
  )

  func resetPassword(c *Context, w http.ResponseWriter, r *http.Request) {
  	props := model.MapFromJson(r.Body)

  	newPassword := props["new_password"]
  	if len(newPassword) < model.MIN_PASSWORD_LENGTH {
  		c.SetInvalidParam("resetPassword", "new_password")
  		return
  	}

  	code := props["code"]
  	if len(code) != model.PASSWORD_RECOVERY_CODE_SIZE {
  		c.SetInvalidParam("resetPassword", "code")
  		return
  	}

  	userId := ""

  	if result := <-Srv.Store.PasswordRecovery().GetByCode(code); result.Err != nil {
  		c.Err = model.NewLocAppError("resetPassword", "api.user.reset_password.invalid_link.app_error", nil, result.Err.Error())
  		return
  	} else {
  		recovery := result.Data.(*model.PasswordRecovery)

  		if model.GetMillis()-recovery.CreateAt < model.PASSWORD_RECOVER_EXPIRY_TIME {
  			userId = recovery.UserId
  		} else {
  			c.Err = model.NewLocAppError("resetPassword", "api.user.reset_password.link_expired.app_error", nil, "")
  			return
  		}

  		if result := <-Srv.Store.PasswordRecovery().Delete(userId); result.Err != nil {
  			l4g.Error("%v", result.Err)
  		}
  	}

  	if result := <-Srv.Store.User().UpdatePassword(userId, model.HashPassword(newPassword)); result.Err != nil {
  		c.Err = result.Err
  		return
  	}

  	c.LogAuditWithUserId(userId, "success")
  	w.Write([]byte(model.MapToJson(map[string]string{"status": "ok"})))
  }
  ```

test "rank1367: change-password spends the account's own stored hash for the session's user"
  lang go
  file api/user.go
  reject VYQL-AUTH-117
  reject_review code.PasswordResetTokenReplay
  code
  ```
  package api

  import (
  	"net/http"

  	"github.com/mattermost/platform/model"
  )

  func updatePassword(c *Context, w http.ResponseWriter, r *http.Request) {
  	props := model.MapFromJson(r.Body)

  	userId := props["user_id"]
  	if len(userId) != 26 {
  		c.SetInvalidParam("updatePassword", "user_id")
  		return
  	}

  	currentPassword := props["current_password"]
  	newPassword := props["new_password"]

  	if userId != c.Session.UserId {
  		c.Err = model.NewLocAppError("updatePassword", "api.user.update_password.context.app_error", nil, "")
  		c.Err.StatusCode = http.StatusForbidden
  		return
  	}

  	var user *model.User
  	if result := <-Srv.Store.User().Get(userId); result.Err != nil {
  		c.Err = result.Err
  		return
  	} else {
  		user = result.Data.(*model.User)
  	}

  	if !model.ComparePassword(user.Password, currentPassword) {
  		c.Err = model.NewLocAppError("updatePassword", "api.user.update_password.incorrect.app_error", nil, "")
  		c.Err.StatusCode = http.StatusForbidden
  		return
  	}

  	if uresult := <-Srv.Store.User().UpdatePassword(c.Session.UserId, model.HashPassword(newPassword)); uresult.Err != nil {
  		c.Err = uresult.Err
  		return
  	}

  	c.LogAudit("completed")
  	w.Write([]byte(model.MapToJson(props)))
  }
  ```
