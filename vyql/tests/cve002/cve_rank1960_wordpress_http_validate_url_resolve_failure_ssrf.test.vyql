# Rank 1960 / CVE-2019-17669: wp_http_validate_url() is the SSRF gate for
# WordPress's safe HTTP API. When a URL's host is not a dotted-decimal IPv4
# literal, it resolves the host with gethostbyname(), which PHP documents as
# returning the unmodified hostname on failure. The vulnerable revision
# detects exactly that documented failure ($ip === $host) but handles it by
# assigning $ip = false and continuing: the loopback/RFC1918 test that
# follows is guarded by its own if ($ip) and is skipped, control reaches the
# port check, and the URL is returned as validated. A host string the
# resolver refinterpret is precisely what the HTTP client may still
# interpret on its own -- cURL's address parser accepts hex, octal and short
# integer spellings of 127.0.0.1 (http://0x7f.0.0.1/) that glibc's
# gethostbyname() rejects -- so the fetch that follows connects to an
# internal address the validator never sees. The fixed revision
# (608d39faed63ea212b6c6cdf9fe2bef92e2120ea) makes the failure branch
# return false immediately.
#
# FIXED. The discriminator correlates two assignments on one variable: the
# resolution ($ip = gethostbyname($host)) and the falsy sentinel
# ($ip = false), with the documented failure comparison between them. That
# correlation is beyond a presence clause, and the first attempt proved it:
# keying the sentinel on an uncorrelated assign_literal:false token still
# fired on the patched file, because the same real function also carries
# $same_host = false in both revisions. The PHP review extractor
# (phpResolveFailureSentinelNotRejected) performs the correlation and emits
# resolve_failure_url_validation_bypass; the binding in
# bindings/php/resolve_failure_url_validation_bypass.vyql emits
# code.ResolveFailureUrlValidationBypass, judged by VYQL-RF-054. The
# vulnerable case below is the real function with that unrelated false
# assignment present, so the pair cannot pass on an uncorrelated sentinel.
#
# The third case is the hardened sibling form measured in the wild: the
# resolved value routed through filter_var(), which rejects the
# unmodified-hostname failure return itself, beside a false literal inside
# an error payload array. The fourth is the die()-on-failure form, also
# measured, which never resets the resolved variable at all.

test "rank1960: url validation resets the resolved variable on a gethostbyname failure and continues"
  lang php
  file wp-includes/http.php
  expect VYQL-RF-054
  code
  ```
  <?php
  function wp_http_validate_url( $url ) {
  	$original_url = $url;
  	$url          = wp_kses_bad_protocol( $url, array( 'http', 'https' ) );
  	$parsed_url   = @parse_url( $url );

  	$parsed_home = @parse_url( get_option( 'home' ) );
  	if ( isset( $parsed_home['host'] ) ) {
  		$same_host = strtolower( $parsed_home['host'] ) === strtolower( $parsed_url['host'] );
  	} else {
  		$same_host = false;
  	}

  	if ( ! $same_host ) {
  		$host = trim( $parsed_url['host'], '.' );
  		if ( preg_match( '#^(([1-9]?\d|1\d\d|25[0-5]|2[0-4]\d)\.){3}([1-9]?\d|1\d\d|25[0-5]|2[0-4]\d)$#', $host ) ) {
  			$ip = $host;
  		} else {
  			$ip = gethostbyname( $host );
  			if ( $ip === $host ) { // Error condition for gethostbyname()
  				$ip = false;
  			}
  		}
  		if ( $ip ) {
  			$parts = array_map( 'intval', explode( '.', $ip ) );
  			if ( 127 === $parts[0] || 10 === $parts[0] || 0 === $parts[0]
  				|| ( 172 === $parts[0] && 16 <= $parts[1] && 31 >= $parts[1] )
  				|| ( 192 === $parts[0] && 168 === $parts[1] )
  			) {
  				return false;
  			}
  		}
  	}

  	return $url;
  }
  ```

test "rank1960: url validation rejects the url when gethostbyname fails"
  lang php
  file wp-includes/http.php
  reject VYQL-RF-054
  code
  ```
  <?php
  function wp_http_validate_url( $url ) {
  	$original_url = $url;
  	$url          = wp_kses_bad_protocol( $url, array( 'http', 'https' ) );
  	$parsed_url   = @parse_url( $url );

  	$parsed_home = @parse_url( get_option( 'home' ) );
  	if ( isset( $parsed_home['host'] ) ) {
  		$same_host = strtolower( $parsed_home['host'] ) === strtolower( $parsed_url['host'] );
  	} else {
  		$same_host = false;
  	}

  	if ( ! $same_host ) {
  		$host = trim( $parsed_url['host'], '.' );
  		if ( preg_match( '#^(([1-9]?\d|1\d\d|25[0-5]|2[0-4]\d)\.){3}([1-9]?\d|1\d\d|25[0-5]|2[0-4]\d)$#', $host ) ) {
  			$ip = $host;
  		} else {
  			$ip = gethostbyname( $host );
  			if ( $ip === $host ) { // Error condition for gethostbyname()
  				return false;
  			}
  		}
  		if ( $ip ) {
  			$parts = array_map( 'intval', explode( '.', $ip ) );
  			if ( 127 === $parts[0] || 10 === $parts[0] || 0 === $parts[0]
  				|| ( 172 === $parts[0] && 16 <= $parts[1] && 31 >= $parts[1] )
  				|| ( 192 === $parts[0] && 168 === $parts[1] )
  			) {
  				return false;
  			}
  		}
  	}

  	return $url;
  }
  ```

test "rank1960: a false literal beside a resolved host is closed by validating the answer with filter_var"
  lang php
  file includes/ssrf_helper.php
  reject VYQL-RF-054
  code
  ```
  <?php
  function fetch_logo_from_url( $url ) {
  	$parts = parse_url( $url );
  	$host  = $parts['host'];
  	$ip    = gethostbyname( $host );

  	if ( filter_var( $ip, FILTER_VALIDATE_IP, FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE ) === false ) {
  		$response = array(
  			'success' => false,
  			'message' => 'Invalid IP Address.',
  		);
  		echo json_encode( $response );
  		exit();
  	}

  	$ch = curl_init( $url );
  	curl_setopt( $ch, CURLOPT_RESOLVE, array( "$host:$ip" ) );
  	return curl_exec( $ch );
  }
  ```

test "rank1960: a resolver failure test that kills the request needs no sentinel at all"
  lang php
  file includes/ssrf_helper.php
  reject VYQL-RF-054
  code
  ```
  <?php
  function validate_webhook_url_for_ssrf( $url ) {
  	$parsed_url = parse_url( $url );
  	$host       = $parsed_url['host'];
  	$ip         = gethostbyname( $host );

  	// CATCH DNS FAILURES
  	if ( $ip === $host && filter_var( $host, FILTER_VALIDATE_IP ) === false ) {
  		die( json_encode( array(
  			'success' => false,
  			'message' => 'Error: Could not resolve the hostname.',
  		) ) );
  	}

  	if ( filter_var( $ip, FILTER_VALIDATE_IP, FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE ) === false ) {
  		return false;
  	}

  	return $ip;
  }
  ```
