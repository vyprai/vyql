# Rank 1673 / CVE-2016-9124: Revive Adserver's login password check
# throttles nothing, so the login page can be driven at machine speed
# and passwords guessed in parallel (improper restriction of excessive
# authentication attempts, CWE-307; h1 report 96115, fix commit
# 847941390f "Mitigate h1 report 96115", shipped in 3.2.3). The check
# in lib/OX/Extension/authentication/authentication.php looks the row
# up through `OA_Dal::factoryDO('users')`, assigns `md5($password)` to
# the password field and returns the fetch result -- no failure penalty
# of any kind -- and the one delay the tree carries is a constant
# `sleep(3)` in the OA_Auth caller, which serialises nothing: parallel
# attempts each wait the same three seconds. The fixed revision removes
# the constant sleep and gives checkPassword a random 1-5s failure
# delay (`mt_rand` + `usleep`) plus a per-username advisory lock
# (`OA_DB_AdvisoryLock::factory()`, `->get('auth.'.md5($username))`,
# `->release()`) that both serialises attempts on one account and
# quadruples the delay while another attempt on the same name is
# underway. Verified: the unthrottled form is present at the parent,
# the lock-and-delay form at the fixed revision.
#
# ATTENTION, throttle-decision completeness, rechecked. Re-measured on
# the real checkout over three --cache off runs per revision
# (lib/OA + lib/OX, 597 PHP files; the full tree's 2784 PHP files reach
# the 6GB --max-ram ceiling and abort, so this is the bounded scope):
# 569/569/569 findings at the parent and 571/571/571 at the fix, the
# +2 being fix-direction noise on the fix's own `mt_rand` and the
# `md5($username)` inside its lock key (CRY-003 123->124, CRY-001
# 26->27). The rule histogram is identical in shape at both revisions
# -- RF-043 347, CRY-003, AUTH-079 51, CRY-001, RES-001 8, CFG-008 4,
# single INJ/SEC/RF/PATH rows -- and the `-flags only` view carries
# StateChangingOp, SensitiveOperation, ResourceReview,
# ObjectLookupByUserInput, InsecurePermission and UnsanitizedSvgUpload
# and nothing attempt- or throttle-named. The brute-force defect is
# invisible at both revisions; this is a clean zero, not a misread one.
#
# The vocabulary this needs exists now and is live:
# `code.RateLimitRequiredOp` (reviewCondition "an authentication-
# sensitive endpoint accepts attempts without a throttle") is consumed
# by VYQL-AUTH-105 `unless endpoint coveredBy code.RateLimitCheck`, and
# a Python binding (`passwordVerificationAttemptLimitRequired`,
# vyql/bindings/python/) demonstrates the shape: a function whose own
# scope performs an account-level password verification while carrying
# no attempt-limiting machinery. That binding's positive key is the
# framework-documented verifier call -- `check_password`,
# `pwd_context.verify` -- and this code offers no such foothold:
# `vyql match` on the real file reports no label on the lookup at all,
# only WeakHash on every `md5`, StateChangingOp on the insert/update
# methods and FileInclude on the require_once lines. No binding emits
# `code.RateLimitRequiredOp` for PHP.
#
# The only firing shape was measured with a throwaway probe (since
# removed) emitting that concept on a PHP function scope that assigns
# `password=md5(` into the row object, calls `find()` and `fetch()`,
# and carries no sleep-family call: 1 -> 0 on the isolated pair, and
# 5 -> 4 VYQL-AUTH-105 on the real subtree, where the four survivors
# are DAL test fixture seeders (Statistics_manageCampaigns.dal.test.php
# :925, Email.mtc.test.php:626, Preferences.dal.test.php:43 and :491)
# -- four false positives per true positive on the very tree that
# motivates it. Outside this repository the shape's reachable set is
# empty: a corpus-wide enumeration over the clone pool's PHP files
# finds the password-hash assignment in 11 files, and requiring a
# DataObject read leaves only this repository's own sources and tests.
#
# Not shipped: the positive key is an application idiom assembled from
# a field-name convention plus PEAR DB_DataObject's read methods, and
# no library documents "assign md5() to the password property and call
# find()" as authentication. It reconstructs this incident's spelling,
# and the next variant -- a PDO prepared statement keyed on `md5(?)` --
# carries neither the property assignment nor the DataObject read, so
# it walks past. Not an engine gap: the function-scope tokens are all
# readable (the probe reads them). When a PHP throttle-decision binding
# lands on documented verifier vocabulary, the unthrottled block below
# must flip from reject to expect VYQL-AUTH-105; the lock-and-delay
# block stays reject.

test "rank1673: the password check throttles nothing"
  lang php
  file lib/OX/Extension/authentication/authentication.php
  reject VYQL-AUTH-079
  reject VYQL-AUTH-105
  code
  ```
  <?php

  require_once MAX_PATH . '/lib/OA/Dal.php';

  class Plugins_Authentication extends OX_Component
  {
      /**
       * A method to check a username and password
       *
       * @param string $username
       * @param string $password
       * @return mixed A DataObjects_Users instance, or false if no matching user was found
       */
      function checkPassword($username, $password)
      {
          $doUser = OA_Dal::factoryDO('users');
          $doUser->username = strtolower($username);
          $doUser->password = md5($password);

          $doUser->find();

          if ($doUser->fetch()) {
              return $doUser;
          } else {
              return false;
          }
      }
  }
  ```

test "rank1673: the fixed revision delays failures and serialises per username"
  lang php
  file lib/OX/Extension/authentication/authentication.php
  reject VYQL-AUTH-079
  reject VYQL-AUTH-105
  code
  ```
  <?php

  require_once MAX_PATH . '/lib/OA/Dal.php';
  require_once MAX_PATH . '/lib/OA/DB/AdvisoryLock.php';

  class Plugins_Authentication extends OX_Component
  {
      function checkPassword($username, $password)
      {
          // Random 1-5 second base delay for failures.
          $waitMs = mt_rand(1000, 5000);

          $oLock = OA_DB_AdvisoryLock::factory();

          $username = strtolower($username);

          // Exclusive advisory lock per username.
          $lock = $oLock->get('auth.' . md5($username));

          if (!$lock) {
              // Another attempt on this username is underway:
              // discourage parallel brute forcing with a 4x delay.
              usleep($waitMs * 4000);
          }

          $doUser = OA_Dal::factoryDO('users');
          $doUser->username = $username;
          $doUser->password = md5($password);

          $doUser->find();

          if ($doUser->fetch()) {
              $oLock->release();

              return $doUser;
          }

          if ($lock) {
              usleep($waitMs * 1000);
          }

          $oLock->release();

          return false;
      }
  }
  ```
