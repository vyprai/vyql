test "rank1338: the same stream reaching ObjectInputStream through a delegating super(in) loses its taint"
  lang java
  file ObjectInputStreamViaSuper.java
  reject VYQL-DESER-001
  code
  ```
  import java.io.IOException;
  import java.io.InputStream;
  import java.io.ObjectInputStream;
  import java.net.Socket;

  class EventInputStream extends ObjectInputStream {
      EventInputStream(InputStream in) throws IOException {
          super(in);
      }
  }

  public class ObjectInputStreamViaSuper {
      public Object read(Socket socket) throws Exception {
          EventInputStream eis = new EventInputStream(socket.getInputStream());
          return eis.readObject();
      }
  }
  ```
