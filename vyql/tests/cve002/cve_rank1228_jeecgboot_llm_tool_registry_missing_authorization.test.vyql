  ```
  package org.jeecg.modules.airag;

  import dev.langchain4j.agent.tool.ToolSpecification;
  import dev.langchain4j.model.chat.request.json.JsonObjectSchema;
  import dev.langchain4j.service.tool.ToolExecutor;
  import org.apache.shiro.SecurityUtils;

  public class JeecgBizToolsProvider implements JeecgToolsProvider {

      @Autowired
      private ISysUserService sysUserService;

      public Map<ToolSpecification, ToolExecutor> getDefaultTools() {
          Map<ToolSpecification, ToolExecutor> tools = new HashMap<>();

          if (SecurityUtils.getSubject().isPermitted("system:user:add")) {
              JeecgLlmTools addUser = addUserTool();
              tools.put(addUser.getToolSpecification(), addUser.getToolExecutor());
          }

          return tools;
      }

      private JeecgLlmTools addUserTool() {
          ToolSpecification toolSpecification = ToolSpecification.builder()
                  .name("add_user")
                  .description("add a user and return the result")
                  .parameters(
                          JsonObjectSchema.builder()
                                  .addStringProperty("username", "user name")
                                  .addStringProperty("password", "password")
                                  .required("username", "password")
                                  .build()
                  )
                  .build();
          ToolExecutor toolExecutor = (toolExecutionRequest, memoryId) -> {
              JSONObject arguments = JSONObject.parseObject(toolExecutionRequest.arguments());
              SysUser user = JSON.parseObject(arguments.toJSONString(), SysUser.class);
              String salt = oConvertUtils.randomGen(8);
              user.setSalt(salt);
              user.setPassword(PasswordUtil.encrypt(user.getUsername(), user.getPassword(), salt));
              sysUserService.saveUser(user, null, null, null, false);
              return "user added";
          };
          return new JeecgLlmTools(toolSpecification, toolExecutor);
      }
  }
  ```

test "rank1228: the registry loads the caller's permission set and tests membership per tool"
  lang java
  file JeecgBizToolsProvider.java
  reject VYQL-AUTH-112
  reject_review code.LlmToolRegistrationMissingAuthorization
  code
  ```
  package org.jeecg.modules.airag;

  import dev.langchain4j.agent.tool.ToolSpecification;
  import dev.langchain4j.model.chat.request.json.JsonObjectSchema;
  import dev.langchain4j.service.tool.ToolExecutor;
  import org.jeecg.common.system.util.JwtUtil;
  import org.jeecg.common.util.SpringContextUtils;

  public class JeecgBizToolsProvider implements JeecgToolsProvider {

      @Autowired
      private ISysUserService sysUserService;

      public Map<ToolSpecification, ToolExecutor> getDefaultTools() {
          Map<ToolSpecification, ToolExecutor> tools = new HashMap<>();

          Set<String> perms = currentUserPermissions();
          if (perms.isEmpty()) {
              return tools;
          }

          if (perms.contains("system:user:add")) {
              JeecgLlmTools addUser = addUserTool(perms);
              tools.put(addUser.getToolSpecification(), addUser.getToolExecutor());
          }

          return tools;
      }

      private Set<String> currentUserPermissions() {
          HttpServletRequest req = SpringContextUtils.getHttpServletRequest();
          if (null == req) {
              return Collections.emptySet();
          }
          String token = req.getHeader("X-Access-Token");
          String username = JwtUtil.getUsername(token);
          if (StringUtils.isBlank(username)) {
              return Collections.emptySet();
          }
          SysUser user = sysUserService.getUserByName(username);
          if (null == user) {
              return Collections.emptySet();
          }
          return sysUserService.getUserPermissionsSet(user.getId());
      }

      private JeecgLlmTools addUserTool(Set<String> perms) {
          ToolSpecification toolSpecification = ToolSpecification.builder()
                  .name("add_user")
                  .description("add a user and return the result")
                  .parameters(
                          JsonObjectSchema.builder()
                                  .addStringProperty("username", "user name")
                                  .addStringProperty("password", "password")
                                  .required("username", "password")
                                  .build()
                  )
                  .build();
          ToolExecutor toolExecutor = (toolExecutionRequest, memoryId) -> {
              JSONObject arguments = JSONObject.parseObject(toolExecutionRequest.arguments());
              SysUser user = JSON.parseObject(arguments.toJSONString(), SysUser.class);
              String salt = oConvertUtils.randomGen(8);
              user.setSalt(salt);
              user.setPassword(PasswordUtil.encrypt(user.getUsername(), user.getPassword(), salt));
              sysUserService.saveUser(user, null, null, null, false);
              return "user added";
          };
          return new JeecgLlmTools(toolSpecification, toolExecutor);
      }
  }
  ```

test "rank1228: a tool registry that administers nothing is not a finding"
  lang java
  file WeatherToolsProvider.java
  reject VYQL-AUTH-112
  reject_review code.LlmToolRegistrationMissingAuthorization
  code
  ```
  package com.example.assistant;

  import dev.langchain4j.agent.tool.ToolSpecification;
  import dev.langchain4j.model.chat.request.json.JsonObjectSchema;
  import dev.langchain4j.service.tool.ToolExecutor;

  public class WeatherToolsProvider {

      @Autowired
      private WeatherService weatherService;

      public Map<ToolSpecification, ToolExecutor> getDefaultTools() {
          Map<ToolSpecification, ToolExecutor> tools = new HashMap<>();
          ToolSpecification toolSpecification = ToolSpecification.builder()
                  .name("current_weather")
                  .description("return the current weather for a city")
                  .parameters(
                          JsonObjectSchema.builder()
                                  .addStringProperty("city", "city name")
                                  .required("city")
                                  .build()
                  )
                  .build();
          ToolExecutor toolExecutor = (toolExecutionRequest, memoryId) -> {
              JSONObject arguments = JSONObject.parseObject(toolExecutionRequest.arguments());
              return weatherService.forecastFor(arguments.getString("city"));
          };
          tools.put(toolSpecification, toolExecutor);
          return tools;
      }
  }
  ```

