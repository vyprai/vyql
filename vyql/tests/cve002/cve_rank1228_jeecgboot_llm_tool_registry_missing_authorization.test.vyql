  package org.jeecg.modules.system.service.impl;

  public class SysUserServiceImpl implements ISysUserService {

      @Autowired
      private SysUserMapper userMapper;

      @Autowired
      private ISysUserRoleService sysUserRoleService;

      public void saveUser(SysUser user, String selectedRoles, String selectedDeparts, String relTenantIds, boolean sync) {
          String salt = oConvertUtils.randomGen(8);
          user.setSalt(salt);
          user.setPassword(PasswordUtil.encrypt(user.getUsername(), user.getPassword(), salt));
          userMapper.insert(user);
          if (StringUtils.isNotBlank(selectedRoles)) {
              for (String roleId : selectedRoles.split(",")) {
                  sysUserRoleService.save(new SysUserRole(user.getId(), roleId));
              }
          }
      }
  }
  ```
