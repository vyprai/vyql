test "rank1432: the same bound written as a proceed-if-in-range comparison is equally quiet"
  lang c
  file etc/cnid_dbd/comm.c
  reject VYQL-MEM-010
  reject_review code.FieldDerivedIndexAccess
  code
  ```
  #include <stddef.h>

  #define MAXPATHLEN 1024
  #define CNID_DBD_TIMEOUT 10

  struct cnid_dbd_rqst {
      int op;
      unsigned int cnid;
      unsigned int did;
      const char *name;
      size_t namelen;
  };

  extern int cur_fd;

  int readt(int fd, void *buf, size_t len, int setnonblocking, int timeout);
  void invalidate_fd(int fd);
  int check_fd(long timeout);
  int setnonblock(int fd, int on);

  int comm_rcv(struct cnid_dbd_rqst *rqst, long timeout)
  {
      char *nametmp;
      int b;

      if ((cur_fd = check_fd(timeout)) < 0) {
          return -1;
      }

      if (!cur_fd) {
          return 0;
      }

      if (setnonblock(cur_fd, 1) != 0) {
          return -1;
      }

      nametmp = (char *)rqst->name;

      if ((b = readt(cur_fd, rqst, sizeof(struct cnid_dbd_rqst), 1, CNID_DBD_TIMEOUT))
              != sizeof(struct cnid_dbd_rqst)) {
          invalidate_fd(cur_fd);
          rqst->name = nametmp;
          return 0;
      }

      rqst->name = nametmp;

      if (!(rqst->namelen < MAXPATHLEN)) {
          invalidate_fd(cur_fd);
          return 0;
      }

      if (rqst->namelen
              && readt(cur_fd, (char *)rqst->name, rqst->namelen, 1, CNID_DBD_TIMEOUT)
              != rqst->namelen) {
          invalidate_fd(cur_fd);
          return 0;
      }

      /* We set this to make life easier for logging. None of the other stuff
         needs zero terminated strings. */
      ((char *)(rqst->name))[rqst->namelen] = '\0';
      return 1;
  }
  ```

# The three cases below pin the restrictions on the reject-if-larger spelling.
# Each carries a relational operator beside `rqst->namelen` that is not a bound
# on it, and each must still report.

test "rank1432: a nonzero test on the wire length is not a bound"
  lang c
  file etc/cnid_dbd/comm.c
  expect VYQL-MEM-010
  expect_review code.FieldDerivedIndexAccess
  code
  ```
  #include <stddef.h>

  struct cnid_dbd_rqst {
      int op;
      const char *name;
      size_t namelen;
  };

  int comm_rcv(struct cnid_dbd_rqst *rqst)
  {
      if (rqst->namelen > 0) {
          ((char *)(rqst->name))[rqst->namelen] = '\0';
      }

      return 1;
  }
  ```

test "rank1432: a loop that walks to the wire length uses it as the bound, not the bounded value"
  lang c
  file etc/cnid_dbd/comm.c
  expect VYQL-MEM-010
  expect_review code.FieldDerivedIndexAccess
  code
  ```
  #include <stddef.h>

  struct cnid_dbd_rqst {
      int op;
      const char *name;
      size_t namelen;
  };

  int comm_rcv(struct cnid_dbd_rqst *rqst)
  {
      size_t i;
      ((char *)(rqst->name))[rqst->namelen] = '\0';

      for (i = 0; i < rqst->namelen; i++) {
          ((char *)(rqst->name))[i] = 'x';
      }

      return 1;
  }
  ```

test "rank1432: a length check below the terminator write does not bound it"
  lang c
  file etc/cnid_dbd/comm.c
  expect VYQL-MEM-010
  expect_review code.FieldDerivedIndexAccess
  code
  ```
  #include <stddef.h>

  #define MAXPATHLEN 1024

  struct cnid_dbd_rqst {
      int op;
      const char *name;
      size_t namelen;
  };

  int comm_rcv(struct cnid_dbd_rqst *rqst)
  {
      ((char *)(rqst->name))[rqst->namelen] = '\0';

      if (rqst->namelen > MAXPATHLEN) {
          return 0;
      }

      return 1;
  }
  ```
