test "rank1688: (d) a strip_prefix containment check is the same control"
  lang rust
  file src/collector/rrdp.rs
  reject VYQL-PATH-006
  code
  ```
  use std::fs;
  use std::path::Path;

  struct HttpResponse;

  impl HttpResponse {
      fn open_file(
          base: &Path, uri: &uri::Https, multi: bool
      ) -> Option<fs::File> {
          let path = base.join(&uri.as_str()[8..]);
          if !path.strip_prefix(base).is_ok() {
              return None
          }
          let parent = path.parent()?;
          fs::create_dir_all(parent).ok()?;
          fs::File::create(&path).ok()
      }
  }
  ```

test "rank1688: (e) a url crate path component joined into a cache directory is the same weakness"
  lang rust
  file fetch_cache.rs
  expect VYQL-PATH-006
  code
  ```
  use std::fs;
  use std::path::Path;

  fn store_response(base: &Path, url: &Url) -> std::io::Result<()> {
      let path = base.join(url.path());
      if let Some(parent) = path.parent() {
          fs::create_dir_all(parent)?;
      }
      fs::write(&path, b"")
  }
  ```

test "rank1688: (f) joining a URI but only reading it back stays with the taint rules"
  lang rust
  file src/collector/rrdp.rs
  reject VYQL-PATH-006
  code
  ```
  use std::fs;
  use std::path::Path;

  struct HttpResponse;

  impl HttpResponse {
      fn load_mirror(
          base: &Path, uri: &uri::Https
      ) -> std::io::Result<String> {
          let path = base.join(&uri.as_str()[8..]);
          fs::read_to_string(&path)
      }
  }
  ```

test "rank1688: (g) a join of purely local components creates files without the remote name"
  lang rust
  file src/store.rs
  reject VYQL-PATH-006
  code
  ```
  use std::fs;
  use std::path::Path;

  struct Store;

  impl Store {
      fn state_path(dir: &Path) -> std::io::Result<()> {
          let path = dir.join("repository.state");
          if let Some(parent) = path.parent() {
              fs::create_dir_all(parent)?;
          }
          fs::write(&path, b"")
      }
  }
  ```
