# Rank 1155 / CVE-2023-30847: h2o's reverse proxy path builds the request
# target for the outgoing connection into a stack-local h2o_url_t,
# target_buf, by calling h2o_url_init(&target_buf, req->scheme,
# req->authority, ...) as a bare statement, discarding its return value.
# h2o_url_init's own doc comment states "@return 0 if successful"; on
# failure -- a malformed authority (Host header) that h2o_url_parse_hostport
# cannot fully consume -- it returns -1 without touching any field of the
# output struct, so target_buf carries whatever is on the stack. That
# value, unread and unvalidated, is then passed as the connection target to
# h2o_httpclient_connect, an invalid read of uninitialized stack memory
# reachable from a single malformed request (CWE-824, a child of CWE-908;
# NVD does not carry CWE-908 itself for this CVE).
#
# The fixed revision changes the bare call to `if (target == &target_buf &&
# h2o_url_init(...) != 0) { h2o_send_error_400(...); return; }`, so a
# malformed authority stops the request instead of proceeding with an unset
# target. The same commit guards the sibling call in build_request() the
# same way, with `h2o_fatal` instead of a recoverable return, which is not
# modeled here because it does not add a new shape -- same ignored return,
# same uninitialized-struct consequence, same gap.
#
# ATTENTION, vocabulary and engine gap together. Nothing is labelled in
# the repro: h2o_url_init and h2o_httpclient_connect are both unresolved,
# unknown calls (no C binding names either), so no rule has anything to
# judge. The nearest existing concept by mechanism is
# code.UninitializedBufferExposure (CWE_908, VYQL-MEM-015, "a buffer with
# reserved capacity is exposed as initialized mutable storage"), which is
# exactly the shape here (a stack-reserved h2o_url_t exposed unfilled),
# but it has no C binding at all -- only Rust and JavaScript, each matched
# on a literal, single-incident textual context (node.context.rustReview
# == "uninitialized_buffer_exposure", a specific Buffer.allocUnsafe call
# chain), not a structural pattern transferable to this call shape.
#
# A binding that discriminates the two revisions needs a fact no query in
# this engine can express: whether a call's return value is tested before
# the call's own out-parameter is used again. A plain `emit issue ... at
# call` on h2o_url_init fires identically on both revisions, because the
# call site still exists, unconditionally, inside the fixed form's `if`
# condition -- the invariant the fixed revision adds is exactly what has
# to be checked, and "was this expression's value consumed by a condition"
# is a new dataflow relation (return-value-checkedness), not a pattern
# over one node. Scanning both revisions of lib/core confirms this
# directly: byte-identical finding counts (253, same rule IDs, same lines
# shifted by the one line the fixed revision adds) with nothing at either
# revision's target_buf/h2o_url_init lines. No definition change
# attempted.
#
# verify_current_expected: attention-engine-gap, both revisions rejected.

test "rank1155: h2o_url_init's return is discarded before target_buf is used"
  lang c
  file lib/core/proxy.c
  reject VYQL-MEM-015
  code
  ```
  #include <stddef.h>

  typedef struct h2o_iovec_t { const char *base; size_t len; } h2o_iovec_t;
  typedef struct h2o_url_scheme_t { const char *name; } h2o_url_scheme_t;
  typedef struct h2o_url_t {
      const h2o_url_scheme_t *scheme;
      h2o_iovec_t authority;
      h2o_iovec_t host;
      h2o_iovec_t path;
      unsigned short _port;
  } h2o_url_t;
  typedef struct h2o_req_overrides_t { void *connpool; int proxy_preserve_host; } h2o_req_overrides_t;
  typedef struct h2o_req_t {
      const h2o_url_scheme_t *scheme;
      h2o_iovec_t authority;
      h2o_req_overrides_t *overrides;
  } h2o_req_t;

  /**
   * initializes URL object given scheme, authority, and path
   * @return 0 if successful
   */
  int h2o_url_init(h2o_url_t *url, const h2o_url_scheme_t *scheme, h2o_iovec_t authority, h2o_iovec_t path);
  void h2o_httpclient_connect(void **clientp, void *pool, void *data, void *client_ctx, void *connpool, h2o_url_t *target, const char *upgrade_to, void *cb);

  void h2o__proxy_process_request(h2o_req_t *req)
  {
      h2o_req_overrides_t *overrides = req->overrides;
      h2o_url_t target_buf, *target = &target_buf;

      void *connpool = NULL;
      if (overrides != NULL && overrides->connpool != NULL) {
          connpool = overrides->connpool;
          if (!overrides->proxy_preserve_host)
              target = NULL;
      }
      if (target == &target_buf)
          h2o_url_init(&target_buf, req->scheme, req->authority, (h2o_iovec_t){"/", 1});

      void *client = NULL;
      h2o_httpclient_connect(&client, NULL, NULL, NULL, connpool, target, NULL, NULL);
  }
  ```

test "rank1155: the fixed revision gates the connect on h2o_url_init's return"
  lang c
  file lib/core/proxy.c
  reject VYQL-MEM-015
  code
  ```
  #include <stddef.h>

  typedef struct h2o_iovec_t { const char *base; size_t len; } h2o_iovec_t;
  typedef struct h2o_url_scheme_t { const char *name; } h2o_url_scheme_t;
  typedef struct h2o_url_t {
      const h2o_url_scheme_t *scheme;
      h2o_iovec_t authority;
      h2o_iovec_t host;
      h2o_iovec_t path;
      unsigned short _port;
  } h2o_url_t;
  typedef struct h2o_req_overrides_t { void *connpool; int proxy_preserve_host; } h2o_req_overrides_t;
  typedef struct h2o_req_t {
      const h2o_url_scheme_t *scheme;
      h2o_iovec_t authority;
      h2o_req_overrides_t *overrides;
  } h2o_req_t;

  /**
   * initializes URL object given scheme, authority, and path
   * @return 0 if successful
   */
  int h2o_url_init(h2o_url_t *url, const h2o_url_scheme_t *scheme, h2o_iovec_t authority, h2o_iovec_t path);
  void h2o_send_error_400(h2o_req_t *req, const char *reason, const char *body, int flags);
  void h2o_httpclient_connect(void **clientp, void *pool, void *data, void *client_ctx, void *connpool, h2o_url_t *target, const char *upgrade_to, void *cb);

  void h2o__proxy_process_request(h2o_req_t *req)
  {
      h2o_req_overrides_t *overrides = req->overrides;
      h2o_url_t target_buf, *target = &target_buf;

      void *connpool = NULL;
      if (overrides != NULL && overrides->connpool != NULL) {
          connpool = overrides->connpool;
          if (!overrides->proxy_preserve_host)
              target = NULL;
      }
      if (target == &target_buf && h2o_url_init(&target_buf, req->scheme, req->authority, (h2o_iovec_t){"/", 1}) != 0) {
          h2o_send_error_400(req, "Invalid Request", "Invalid Request", 1);
          return;
      }

      void *client = NULL;
      h2o_httpclient_connect(&client, NULL, NULL, NULL, connpool, target, NULL, NULL);
  }
  ```
