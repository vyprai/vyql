test "rank1808: the patched form validates scheme, resolved addresses and each redirect before dispatch"
  lang javascript
  file rss-transcript.ts
  profile library
  reject VYQL-RF-001
  code
  ```
  type TranscriptCandidate = { url: string; type: string | null };

  const MAX_TRANSCRIPT_REDIRECTS = 10;
  const BLOCKED_HOSTNAME_SUFFIXES = [".localhost", ".internal"];
  const BLOCKED_IPV4_PREFIXES = ["0.", "10.", "127.", "169.254.", "192.168."];

  export async function tryFetchTranscriptFromFeedXml({
    fetchImpl,
    feedXml,
  }: {
    fetchImpl: typeof fetch;
    feedXml: string;
  }): Promise<{ text: string; transcriptUrl: string } | null> {
    const items = extractFeedItems(feedXml);
    for (const item of items) {
      const preferred = selectPreferred(extractPodcastTranscriptCandidatesFromItem(item));
      if (!preferred) continue;
      const transcriptUrl = decodeXmlEntities(preferred.url);
      const res = await fetchTranscriptUrl(fetchImpl, transcriptUrl, {
        signal: AbortSignal.timeout(30000),
        headers: { accept: "text/vtt,text/plain,application/json;q=0.9,*/*;q=0.8" },
      });
      if (!res.ok) return null;
      const body = await res.text();
      return { text: body, transcriptUrl };
    }
    return null;
  }

  async function fetchTranscriptUrl(
    fetchImpl: typeof fetch,
    rawUrl: string,
    options: { signal?: AbortSignal; headers?: HeadersInit },
    redirectCount = 0,
  ): Promise<Response> {
    const target = await resolveTranscriptFetchTarget(rawUrl);
    const pinnedFetchImpl = fetchImpl;
    const response = await pinnedFetchImpl(target.url.href, {
      headers: options.headers,
      signal: options.signal,
      redirect: "manual",
    });
    if (![301, 302, 303, 307, 308].includes(response.status)) return response;
    const location = response.headers.get("location");
    if (!location) return response;
    if (redirectCount >= MAX_TRANSCRIPT_REDIRECTS) {
      throw new Error("RSS transcript URL redirected too many times");
    }
    const nextUrl = new URL(location, target.url.href).href;
    return await fetchTranscriptUrl(fetchImpl, nextUrl, options, redirectCount + 1);
  }

  async function resolveTranscriptFetchTarget(
    rawUrl: string,
  ): Promise<{ url: URL }> {
    let url: URL;
    try {
      url = new URL(rawUrl);
    } catch {
      throw new Error("RSS transcript URL is invalid");
    }
    if (url.protocol !== "http:" && url.protocol !== "https:") {
      throw new Error("RSS transcript URL must use http or https");
    }
    const hostname = url.hostname.trim().replace(/^\[|\]$/g, "").toLowerCase();
    if (hostname === "localhost" || BLOCKED_HOSTNAME_SUFFIXES.some((s) => hostname.endsWith(s))) {
      throw new Error("RSS transcript URL resolves to a blocked local network host");
    }
    if (BLOCKED_IPV4_PREFIXES.some((p) => hostname.startsWith(p))) {
      throw new Error("RSS transcript URL resolves to a blocked local network address");
    }
    return { url };
  }

  function extractFeedItems(xml: string): string[] {
    const out: string[] = [];
    for (const m of xml.matchAll(/<item\b[^>]*>([\s\S]*?)<\/item>/gi)) out.push(m[1] ?? "");
    return out;
  }

  function extractPodcastTranscriptCandidatesFromItem(itemXml: string): TranscriptCandidate[] {
    const matches = itemXml.matchAll(
      /<podcast:transcript\b[^>]*\burl\s*=\s*(['"])([^'"]+)\1[^>]*>/gi,
    );
    const results: TranscriptCandidate[] = [];
    for (const match of matches) {
      const url = match[2]?.trim();
      if (!url) continue;
      results.push({ url, type: null });
    }
    return results;
  }

  function selectPreferred(c: TranscriptCandidate[]): TranscriptCandidate | null {
    return c[0] ?? null;
  }

  function decodeXmlEntities(v: string): string {
    return v.replaceAll("&amp;", "&");
  }
  ```

