# Rank 1004 / CVE-2026-26959: Alex4SSB/ADB-Explorer remote code execution.
# ADBService.VerifyAdbVersion launches a process whose executable path
# (StartInfo.FileName) is the ManualAdbPath setting, loaded from an App.txt
# settings file whose directory is a command-line argument. No integrity or
# authenticity check runs before execution, so a crafted settings file that
# points ManualAdbPath at an arbitrary executable runs attacker code at startup
# (CWE-829, untrusted binary execution). The fixed revision computes the
# SHA-256 of the binary and requires it to match a known-good hash list before
# launching.
#
# ATTENTION, precision cost. The neutralizing control the fixed revision adds is integrity
# verification of the executable before launch. Detecting its absence
# generically flags ordinary code everywhere:
#  - The dangerous element is a process whose executable path comes from a
#    mutable application setting. This is architecturally identical to every
#    legitimate "run the configured external tool" feature: editors run a
#    configured compiler path, git clients run a configured git.exe, media apps
#    run a configured ffmpeg. No static signal separates an attacker-plantable
#    settings value from an expected tool-path configuration.
#  - Labelling settings/config reads as an untrusted source to reach the
#    process-execution sink is exactly the broad config-read false-positive
#    surface that precision guidance warns against.
#  - Almost no application verifies the integrity of the external tools it
#    invokes, so flagging the missing hash check would fire on nearly every app
#    that shells out to a CLI tool.
# There is also a vocabulary gap: the process-execution sink code.CommandExecution
# is CWE-78 (argument injection into a fixed binary), which is a different
# weakness from CWE-829 (choosing which binary runs); no untrusted-executable
# sink concept exists. Recording ATTENTION rather than minting a broad concept.
#
# verify_current_expected: attention-precision-cost

test "rank1004: adb path from a settings value is executed with no integrity check"
  lang csharp
  file ADB Explorer/Services/ADB/ADBService.cs
  reject VYQL-INJ-002
  code
  ```
  using System.Diagnostics;

  namespace ADB_Explorer.Services;

  public static class ADBService
  {
      public static void VerifyAdbVersion(string adbPath)
      {
          if (string.IsNullOrEmpty(adbPath))
              return;

          var process = new Process();
          process.StartInfo.UseShellExecute = false;
          process.StartInfo.FileName = adbPath;
          process.StartInfo.Arguments = "version";
          process.Start();
      }

      public static void Init()
      {
          VerifyAdbVersion(Settings.ManualAdbPath);
      }
  }
  ```

test "rank1004: fix verifies the binary SHA-256 against a known list before executing"
  lang csharp
  file ADB Explorer/Services/ADB/ADBService.cs
  reject VYQL-INJ-002
  code
  ```
  using System.Diagnostics;
  using System.Security.Cryptography;

  namespace ADB_Explorer.Services;

  public static class ADBService
  {
      public static void VerifyAdbVersion(string adbPath)
      {
          if (string.IsNullOrEmpty(adbPath))
              return;

          var adbSHA = Security.CalculateWindowsFileHash(adbPath, true);
          if (adbSHA is null || !AdbVersions.HashList.Contains(adbSHA))
              return;

          var process = new Process();
          process.StartInfo.UseShellExecute = false;
          process.StartInfo.FileName = adbPath;
          process.StartInfo.Arguments = "version";
          process.Start();
      }

      public static void Init()
      {
          VerifyAdbVersion(Settings.ManualAdbPath);
      }
  }
  ```
