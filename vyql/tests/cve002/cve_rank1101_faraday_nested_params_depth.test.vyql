# Rank 1101 / CVE-2026-54297: Faraday's nested params decoder put no limit on
# how deeply a query string may nest, so a key like a[b][c][d]... builds one
# container per bracket pair and recurses once per level, exhausting the stack
# (CWE-674).
#
# The discriminator is the nesting ceiling the convention carries: rack's
# QueryParser names it `param_depth_limit` in its public interface and raises
# ParamsTooDeepError at it, and faraday's encoder documents itself as the same
# convention. The fix adds exactly that accessor with a default of 100 and
# raises in decode_pair once the scanned subkey count passes it, so both the
# ceiling's assignment and its comparison are visible as AST tokens while
# prose naming the ceiling is not.

test "rank1101: the decoder expands bracket-nested keys with no depth ceiling"
  lang ruby
  file lib/faraday/encoders/nested_params_encoder.rb
  expect VYQL-DOS-049
  code
  ```
  module Faraday
    module DecodeMethods
      SUBKEYS_REGEX = /[^\[\]]+(?:\]?\[\])?/

      def decode(query)
        return nil if query.nil?

        params = {}
        query.split('&').each do |pair|
          next if pair.empty?

          key, value = pair.split('=', 2)
          key = unescape(key)
          value = unescape(value.tr('+', ' ')) if value
          decode_pair(key, value, params)
        end

        dehash(params, 0)
      end

      def decode_pair(key, value, context)
        subkeys = key.scan(SUBKEYS_REGEX)
        subkeys.each_with_index do |subkey, i|
          is_array = subkey =~ /[\[\]]+\Z/
          subkey = Regexp.last_match.pre_match if is_array
          last_subkey = i == subkeys.length - 1

          context = prepare_context(context, subkey, is_array, last_subkey)
          add_to_context(is_array, context, value, subkey) if last_subkey
        end
      end

      def dehash(hash, depth)
        hash.each do |key, value|
          hash[key] = dehash(value, depth + 1) if value.is_a?(Hash)
        end

        if depth.positive? && !hash.empty? && hash.keys.all? { |k| k =~ /^\d+$/ }
          hash.sort.map(&:last)
        else
          hash
        end
      end
    end
  end
  ```

test "rank1101: the decoder raises once the subkey count passes the limit"
  lang ruby
  file lib/faraday/encoders/nested_params_encoder.rb
  reject VYQL-DOS-049
  code
  ```
  module Faraday
    module DecodeMethods
      SUBKEYS_REGEX = /[^\[\]]+(?:\]?\[\])?/

      def decode(query)
        return nil if query.nil?

        params = {}
        query.split('&').each do |pair|
          next if pair.empty?

          key, value = pair.split('=', 2)
          key = unescape(key)
          value = unescape(value.tr('+', ' ')) if value
          decode_pair(key, value, params)
        end

        dehash(params, 0)
      end

      def decode_pair(key, value, context)
        subkeys = key.scan(SUBKEYS_REGEX)
        validate_params_depth!(subkeys.length)

        subkeys.each_with_index do |subkey, i|
          is_array = subkey =~ /[\[\]]+\Z/
          subkey = Regexp.last_match.pre_match if is_array
          last_subkey = i == subkeys.length - 1

          context = prepare_context(context, subkey, is_array, last_subkey)
          add_to_context(is_array, context, value, subkey) if last_subkey
        end
      end

      def validate_params_depth!(depth)
        return unless @param_depth_limit && depth > @param_depth_limit

        raise Faraday::Error, "exceeded nested parameter depth limit of #{@param_depth_limit}"
      end

      def dehash(hash, depth)
        hash.each do |key, value|
          hash[key] = dehash(value, depth + 1) if value.is_a?(Hash)
        end

        if depth.positive? && !hash.empty? && hash.keys.all? { |k| k =~ /^\d+$/ }
          hash.sort.map(&:last)
        else
          hash
        end
      end
    end
  end
  ```

test "rank1101: prose naming the ceiling does not silence the flag"
  lang ruby
  file comment_only.rb
  expect VYQL-DOS-049
  code
  ```
  module Faraday
    module DecodeMethods
      # Rack caps this expansion with param_depth_limit; see also depth_limit
      # and max_depth in the query parser.
      SUBKEYS_REGEX = /[^\[\]]+(?:\]?\[\])?/

      def decode(query)
        return nil if query.nil?

        params = {}
        query.split('&').each do |pair|
          next if pair.empty?

          key, value = pair.split('=', 2)
          key = unescape(key)
          value = unescape(value.tr('+', ' ')) if value
          decode_pair(key, value, params)
        end

        dehash(params, 0)
      end

      def decode_pair(key, value, context)
        subkeys = key.scan(SUBKEYS_REGEX)
        subkeys.each_with_index do |subkey, i|
          is_array = subkey =~ /[\[\]]+\Z/
          subkey = Regexp.last_match.pre_match if is_array
          last_subkey = i == subkeys.length - 1

          context = prepare_context(context, subkey, is_array, last_subkey)
          add_to_context(is_array, context, value, subkey) if last_subkey
        end
      end
    end
  end
  ```
