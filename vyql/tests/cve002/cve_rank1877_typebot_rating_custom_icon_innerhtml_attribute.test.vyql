test "rank1877: (f) the imperative spelling of the same write, covered"
  lang javascript
  file packages/embeds/js/src/utils/injectFont.ts
  expect VYQL-INJ-004
  code
  ```
  type Font = { type: string; css: string };

  export const injectFontFromTheme = async (themeUrl: string) => {
    const res = await fetch(themeUrl);
    const theme = (await res.json()) as { font: Font };
    const font = theme.font;
    const existing = document.getElementById("typebot-font");
    if (existing?.innerHTML === font.css) return;
    existing?.remove();
    const style = document.createElement("style");
    style.innerHTML = font.css;
    document.head.appendChild(style);
  };
  ```

test "rank1877: (g) the same icon expression through an imperative innerHTML write"
  lang javascript
  file packages/embeds/js/src/features/blocks/inputs/rating/components/RatingForm.tsx
  expect VYQL-INJ-004
  code
  ```
  import { isEmpty } from "@typebot.io/lib/utils";

  type RatingInputBlock = {
    options?: { customIcon?: { isEnabled: boolean; svg: string } };
  };

  const defaultIcon = `<svg xmlns="http://www.w3.org/2000/svg"></svg>`;

  export const RatingForm = async (props: { typebotId: string }) => {
    const res = await fetch(`/api/v1/typebots/${props.typebotId}/startChat`, {
      method: "POST",
    });
    const data = (await res.json()) as { input: RatingInputBlock };
    const icon = data.input.options?.customIcon;
    const container = document.createElement("div");
    container.className = "rating-icon-container";
    container.innerHTML =
      icon?.isEnabled && !isEmpty(icon.svg) ? icon.svg : defaultIcon;
    return container;
  };
  ```
