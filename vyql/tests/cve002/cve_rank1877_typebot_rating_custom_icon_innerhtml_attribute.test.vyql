  code
  ```
  import domPurify from "dompurify";

  type RatingInputBlock = {
    options?: { customIcon?: { isEnabled: boolean; svg: string } };
  };

  const defaultIcon = `<svg xmlns="http://www.w3.org/2000/svg"></svg>`;

  export const RatingForm = async (props: { typebotId: string }) => {
    const res = await fetch(`/api/v1/typebots/${props.typebotId}/startChat`, {
      method: "POST",
    });
    const data = (await res.json()) as { input: RatingInputBlock };
    const icon = data.input.options?.customIcon;
    return (
      <label class="cursor-pointer">
        <div
          class="rating-icon-container"
          innerHTML={
            icon?.isEnabled
              ? domPurify.sanitize(icon.svg, { USE_PROFILES: { svg: true } })
              : defaultIcon
          }
        />
      </label>
    );
  };
  ```

test "rank1877: (d) the file input's placeholder label through the same attribute"
  lang javascript
  file packages/embeds/js/src/features/blocks/inputs/fileUpload/components/FileUploadForm.tsx
  expect VYQL-INJ-004
  code
  ```
  type FileInputBlock = {
    options?: { labels?: { placeholder?: string } };
  };

  const defaultFileInputOptions = {
    labels: { placeholder: "Upload a file" },
  };

  export const FileUploadForm = async (props: { typebotId: string }) => {
    const res = await fetch(`/api/v1/typebots/${props.typebotId}/startChat`, {
      method: "POST",
    });
    const data = (await res.json()) as { input: FileInputBlock };
    return (
      <form class="flex flex-col w-full gap-2" onSubmit={() => undefined}>
        <p
          class="text-sm text-gray-500 text-center"
          innerHTML={
            data.input.options?.labels?.placeholder ??
            defaultFileInputOptions.labels.placeholder
          }
        />
      </form>
    );
  };
  ```

