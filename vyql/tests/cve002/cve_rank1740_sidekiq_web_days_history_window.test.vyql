test "rank1740: the count stored in an instance variable never reaches the reading method"
  lang ruby
  file sidekiq/web/application.rb
  reject VYQL-INJ-003
  code
  ```
  module Sidekiq
    module Stats
      class History
        def initialize(days_previous, start_date = nil)
          @days_previous = days_previous
          @start_date = start_date || Time.now.utc.to_date
        end

        def date_stat_hash(stat)
          stat_hash = {}
          dates = @start_date.downto(@start_date - @days_previous + 1).map { |date|
            date.strftime("%Y-%m-%d")
          }
          eval(@days_previous.to_s)

          keys = dates.map { |datestr| "stat:#{stat}:#{datestr}" }
          stat_hash
        end
      end
    end

    class WebApplication
      get "/" do
        stats_history = Sidekiq::Stats::History.new((params["days"] || 30).to_i)
        stats_history.date_stat_hash("processed")
      end
    end
  end
  ```
