# The completing application-side change the fixed release makes possible:
# naming the header so the client strips it across origins. Kept so a later
# reader can see the remediation shape the advisory recommends rather than
# inferring it from the pin report.

test "rank1112: the application names its sensitive header after upgrading"
  lang javascript
  file app.js
  code
  ```
  const followRedirects = require('follow-redirects');

  function fetchWithApiKey(url, apiKey) {
    return followRedirects.https.request(url, {
      headers: { 'X-Api-Key': apiKey },
      sensitiveHeaders: ['X-Api-Key'],
    });
  }

  module.exports = { fetchWithApiKey };
  ```
  file package.json
  code
  ```
  {
    "name": "billing-sync",
    "dependencies": {
      "follow-redirects": "1.16.0"
    }
  }
  ```
  reject VYQL-SCA-001
  reject VYQL-SEC-052

# The library's own revisions, kept so a later reader can see what changed
# inside follow-redirects rather than inferring it from the advisory text.
# Both name the standard credential headers -- the vulnerable one in a fixed
# strip pattern, the fixed one in the built-in list the caller extends -- so
# the follower family is deliberately silent on both; its weakness class is a
# follower that considers no credential header at all.

test "rank1112: the vulnerable revision strips a fixed three-name pattern"
  lang javascript
  file index.js
  code
  ```
  RedirectableRequest.prototype._processResponse = function (response) {
    var location = response.headers.location;
    // ...
    if (++this._redirectCount > this._options.maxRedirects) {
      throw new TooManyRedirectsError();
    }
    // ...
    var redirectUrl = resolveUrl(location, currentUrl);
    spreadUrlObject(redirectUrl, this._options);

    // Drop confidential headers when redirecting to a less secure protocol
    // or to a different domain that is not a superdomain
    if (redirectUrl.protocol !== currentUrlParts.protocol &&
       redirectUrl.protocol !== "https:" ||
       redirectUrl.host !== currentHost &&
       !isSubdomain(redirectUrl.host, currentHost)) {
      removeMatchingHeaders(/^(?:(?:proxy-)?authorization|cookie)$/i, this._options.headers);
    }

    this._performRequest();
  };
  ```
  reject VYQL-SEC-052

test "rank1112: the fixed revision builds the strip pattern from the built-in names plus the caller's"
  lang javascript
  file index.js
  code
  ```
  var sensitiveHeaders = [
    "Authorization",
    "Proxy-Authorization",
    "Cookie",
  ];

  function RedirectableRequest(options, responseCallback) {
    // ...
    // Create filter for sensitive HTTP headers
    this._headerFilter = new RegExp("^(?:" +
        sensitiveHeaders.concat(options.sensitiveHeaders).map(escapeRegex).join("|") +
      ")$", "i");

    this._performRequest();
  }
  ```
  reject VYQL-SEC-052
