# Rank 1610 / CVE-2026-42151: Prometheus stored the Azure AD remote
# write OAuth client secret as a plain string, so every config dump,
# log line or error rendering the struct printed the credential
# verbatim (secret exposure through default string formatting,
# CWE-532; PR #18590). The OAuthConfig in storage/remote/azuread/
# azuread.go declared `ClientSecret string
# yaml:"client_secret,omitempty"` and handed it straight to
# azidentity.NewClientSecretCredential. The fixing commit 26dae7f06bs
# the real fix (the merge "remote/azuread: use Secret
# type for OAuth client_secret"): the field becomes
# config_util.Secret -- the prometheus/common type whose String()
# renders <secret> -- and the credential call wraps
# string(oAuthConfig.ClientSecret). .
#
# ATTENTION, typed-secret redaction. The exposure is structural: a
# plain string field joins log output whenever its struct is
# rendered, and no rule can ask "do secret-bearing fields use a
# redacting type" -- type-level redaction vocabulary. The corpus's
# secret rules (VYQL-SEC-001 SecretInLog and friends) judge explicit
# secret-to-log flows; the implicit fmt rendering of a config struct
# carries no sink label. A binding on prometheus's own config types
# would detect this monitor rather than the weakness. Measured on
# the real code: scanning azuread.go reports 3 findings at both
# revisions (2 PATH-001 on certificate path handling and 1 INJ-010
# on a response header -- all unrelated to the client secret). No
# ENGINE-GAPS.md entry. No definition change shipped. Spec
# cve_rank1610 records the plain-string field and the Secret-typed
# form, both asserting reject VYQL-SEC-001: when typed-secret
# vocabulary lands, the plain-string form must flip to expect.

test "rank1610: the client secret is a plain string field"
  lang go
  file storage/remote/azuread/azuread.go
  reject VYQL-SEC-001
  code
  ```
  package azuread

  import (
      "fmt"

      "github.com/Azure/azure-sdk-for-go/sdk/azidentity"
  )

  type OAuthConfig struct {
      ClientID     string `yaml:"client_id,omitempty"`
      ClientSecret string `yaml:"client_secret,omitempty"`
      TenantID     string `yaml:"tenant_id,omitempty"`
  }

  func newTokenCredential(oAuthConfig *OAuthConfig) (azidentity.TokenCredential, error) {
      fmt.Printf("creating credential for client %s with secret %s", oAuthConfig.ClientID, oAuthConfig.ClientSecret)

      opts := &azidentity.ClientSecretCredentialOptions{}
      return azidentity.NewClientSecretCredential(oAuthConfig.TenantID, oAuthConfig.ClientID, oAuthConfig.ClientSecret, opts)
  }
  ```

test "rank1610: the fixed revision gives the secret a redacting type"
  lang go
  file storage/remote/azuread/azuread.go
  reject VYQL-SEC-001
  code
  ```
  package azuread

  import (
      "fmt"

      "github.com/Azure/azure-sdk-for-go/sdk/azidentity"
      config_util "github.com/prometheus/common/config"
  )

  type OAuthConfig struct {
      ClientID     string             `yaml:"client_id,omitempty"`
      ClientSecret config_util.Secret `yaml:"client_secret,omitempty"`
      TenantID     string             `yaml:"tenant_id,omitempty"`
  }

  func newTokenCredential(oAuthConfig *OAuthConfig) (azidentity.TokenCredential, error) {
      fmt.Printf("creating credential for client %s with secret %s", oAuthConfig.ClientID, oAuthConfig.ClientSecret)

      opts := &azidentity.ClientSecretCredentialOptions{}
      return azidentity.NewClientSecretCredential(oAuthConfig.TenantID, oAuthConfig.ClientID, string(oAuthConfig.ClientSecret), opts)
  }
  ```
