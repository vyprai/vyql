# Rank 1610 / CVE-2026-42151: Prometheus stored the Azure AD remote
# write OAuth client secret as a plain string, so every config dump,
# log line or error rendering the struct printed the credential
# verbatim (secret exposure through default string formatting,
# CWE-532; PR #18590). The OAuthConfig in storage/remote/azuread/
# azuread.go declared `ClientSecret string
# yaml:"client_secret,omitempty"` and passed it straight to
# azidentity.NewClientSecretCredential; the file itself never logs
# the value -- the exposure is that a plain string field joins any
# rendering of the struct. Pool commit 26dae7f06b (the merge
# "remote/azuread: use Secret type for OAuth client_secret", whose
# diff reads against the first parent) is the real fix: the field
# becomes config_util.Secret -- the prometheus/common type whose
# String() renders <secret> -- and the credential call wraps
# string(oAuthConfig.ClientSecret). No pool correction.
#
# Held ATTENTION, typed-secret redaction, rechecked at the span tip.
# The concept layer carries the vocabulary: core.SecretRedaction is a
# check that neutralizes secrets.SensitiveLog, and VYQL-SEC-041
# code.ConfigExposureReview asks exactly "does config or diagnostic
# serialization redact inline secrets before exposure" while
# expecting core.SecretRedaction. Nothing emits any of it -- the only
# Go bindings producing code.ConfigExposureReview key on
# instance.MarshalConfig and a Repositories/Keyring field pair, and
# no binding labels prometheus/common config.Secret or any
# azidentity call. Fresh scans of the real checkout at both
# revisions (3 x --cache off each) report the identical single
# VYQL-INJ-010 finding on the RoundTrip response header and the
# identical two LockRelease flags: nothing on the client secret in
# the findings or -flags view, and `vyql match` labels nothing near
# ClientSecret or NewClientSecretCredential, so VYQL-SEC-001's
# SecretValue -> LogWriteSink taint has neither end in this file.
# The discriminating fact is the field's declared type, and the Go
# frontend's type.context node does not carry it:
# typeContextStmts (internal/extract/frontend/golang/golang.go)
# emits type_name:, field: (names only), field_tag: and method:
# tokens, so `ClientSecret string` and `ClientSecret
# config_util.Secret` are indistinguishable -- a probe on the
# field_tag token fires on OAuthConfig at azuread.go:73 at BOTH
# revisions, because the fix keeps yaml:"client_secret,omitempty"
# as the tag. Extracting the declared type would not rescue the
# verdict: the same probe widened to secret-named tag needles flags
# 30 ordinary option structs in one mid-size Go tree (podman's
# registry-auth and PullOptions structs -- Password *string,
# Authfile, artifact types -- none rendered anywhere), which is the
# measured-unshippable ratio for a "plain-string secret field"
# finding; keying on the string(...) conversion the fix leaves at
# the call site encodes the fixing commit's own layout; and the
# renderings that actually expose the value are framework-internal
# (the config dump marshals the whole struct), so no explicit
# secret-to-log path exists to trace. No ENGINE-GAPS.md entry -- the
# engine mishandles no construct here; the blocker is the precision
# of the verdict. No definition change shipped. Spec cve_rank1610
# pins the plain-string field and the Secret-typed form on the real
# file shape, both rejecting VYQL-SEC-001 and
# code.ConfigExposureReview: when typed-secret redaction vocabulary
# lands, the plain-string form must flip to expect_review.

test "rank1610: the client secret is a plain string field"
  lang go
  file storage/remote/azuread/azuread.go
  reject VYQL-SEC-001
  reject_review code.ConfigExposureReview
  code
  ```
  package azuread

  import (
      "github.com/Azure/azure-sdk-for-go/sdk/azcore"
      "github.com/Azure/azure-sdk-for-go/sdk/azidentity"
  )

  // OAuthConfig is used to store azure oauth config values.
  type OAuthConfig struct {
      // ClientID is the clientId of the azure active directory application that is being used to authenticate.
      ClientID string `yaml:"client_id,omitempty"`

      // ClientSecret is the clientSecret of the azure active directory application that is being used to authenticate.
      ClientSecret string `yaml:"client_secret,omitempty"`

      // TenantID is the tenantId of the azure active directory application that is being used to authenticate.
      TenantID string `yaml:"tenant_id,omitempty"`
  }

  // newOAuthTokenCredential returns new OAuth token credential.
  func newOAuthTokenCredential(clientOpts azcore.ClientOptions, oAuthConfig *OAuthConfig) (azcore.TokenCredential, error) {
      opts := &azidentity.ClientSecretCredentialOptions{ClientOptions: clientOpts}
      return azidentity.NewClientSecretCredential(oAuthConfig.TenantID, oAuthConfig.ClientID, oAuthConfig.ClientSecret, opts)
  }
  ```

test "rank1610: the fixed revision gives the secret a redacting type"
  lang go
  file storage/remote/azuread/azuread.go
  reject VYQL-SEC-001
  reject_review code.ConfigExposureReview
  code
  ```
  package azuread

  import (
      "github.com/Azure/azure-sdk-for-go/sdk/azcore"
      "github.com/Azure/azure-sdk-for-go/sdk/azidentity"
      config_util "github.com/prometheus/common/config"
  )

  // OAuthConfig is used to store azure oauth config values.
  type OAuthConfig struct {
      // ClientID is the clientId of the azure active directory application that is being used to authenticate.
      ClientID string `yaml:"client_id,omitempty"`

      // ClientSecret is the clientSecret of the azure active directory application that is being used to authenticate.
      ClientSecret config_util.Secret `yaml:"client_secret,omitempty"`

      // TenantID is the tenantId of the azure active directory application that is being used to authenticate.
      TenantID string `yaml:"tenant_id,omitempty"`
  }

  // newOAuthTokenCredential returns new OAuth token credential.
  func newOAuthTokenCredential(clientOpts azcore.ClientOptions, oAuthConfig *OAuthConfig) (azcore.TokenCredential, error) {
      opts := &azidentity.ClientSecretCredentialOptions{ClientOptions: clientOpts}
      return azidentity.NewClientSecretCredential(oAuthConfig.TenantID, oAuthConfig.ClientID, string(oAuthConfig.ClientSecret), opts)
  }
  ```
