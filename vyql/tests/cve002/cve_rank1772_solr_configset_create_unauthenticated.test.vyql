  package org.apache.solr.handler.admin;

  import java.util.Map;

  public class EnumBodyProbe {
    enum Ops {
      ANON_OP("a") {
        @Override
        Map<String, Object> call(javax.servlet.http.HttpServletRequest req) throws Exception {
          String baseConfigSetName = req.getParameter("baseConfigSet");
          Map<String, Object> props = new java.util.HashMap<>();
          props.put("baseConfigSet", baseConfigSetName);
          return props;
        }
      };

      String action;
      Ops(String action) { this.action = action; }
      abstract Map<String, Object> call(javax.servlet.http.HttpServletRequest req) throws Exception;
    }

    Map<String, Object> namedOp(javax.servlet.http.HttpServletRequest req) {
      String baseConfigSetName = req.getParameter("baseConfigSet");
      Map<String, Object> props = new java.util.HashMap<>();
      props.put("baseConfigSet", baseConfigSetName);
      return props;
    }
  }
