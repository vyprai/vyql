test "rank1957: a member array in the source position is not a write into it"
  lang c
  file sized_dest.c
  reject VYQL-MEM-071
  reject VYQL-MEM-003
  code
  ```
  #include <stdint.h>
  #include <stdlib.h>

  typedef struct tvbuff tvbuff_t;

  struct _zgfx_context_t {
      uint32_t outputCount;
      uint8_t outputSegment[65536];
  };
  typedef struct _zgfx_context_t zgfx_context_t;

  void *wmem_alloc (void *, unsigned);
  void tvb_memcpy (tvbuff_t *, void *, int, unsigned);

  static uint8_t *
  read_uncompressed_segment (void *scope, zgfx_context_t *zgfx,
      tvbuff_t *tvb, unsigned len)
  {
      uint8_t *dest;

      dest = wmem_alloc (scope, len);
      tvb_memcpy (tvb, dest, 1, len);
      memcpy (dest, zgfx->outputSegment, len);
      return dest;
  }
  ```

test "rank1957: a constant count states its own bound and is not reported"
