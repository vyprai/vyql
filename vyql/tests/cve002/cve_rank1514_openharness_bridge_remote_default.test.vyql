test "rank1514: boundary -- the file's auth row fires on the credential-storage handler instead"
  lang python
  file src/openharness/commands/registry.py
  expect VYQL-AUTH-105
  code
  ```
  async def _login_handler(args: str, context: CommandContext) -> CommandResult:
      del context
      settings = load_settings()
      manager = AuthManager(settings)
      profile_name, profile = settings.resolve_profile()
      provider = detect_provider(settings)
      api_key = args.strip()
      if not api_key:
          return CommandResult(message="Auth status: (usage /login API_KEY)")
      manager.store_profile_credential(profile_name, "api_key", api_key)
      return CommandResult(message="Stored API key in ~/.openharness/settings.json")
  ```

test "rank1514: the powerful operation the exposure reaches carries no consumer"
  lang python
  file src/openharness/commands/registry.py
  reject VYQL-AUTH-105
  code
  ```
  async def _bridge_handler(args: str, context: CommandContext) -> CommandResult:
      tokens = args.split()
      if tokens[0] == "spawn" and len(tokens) >= 2:
          command = args[len("spawn ") :]
          handle = await get_bridge_manager().spawn(
              session_id=f"bridge-{datetime.now(timezone.utc).strftime('%H%M%S')}",
              command=command,
              cwd=context.cwd,
          )
          return CommandResult(message=f"Spawned bridge session {handle.session_id}")
      return CommandResult(message="Usage: /bridge list|status|spawn")
  ```
