  ```
  import aiohttp.web

  from ray.dashboard import routes


  class HttpServerAgent:
      async def run(self, dashboard_agent_modules):
          for m in dashboard_agent_modules:
              routes.DashboardAgentRouteTable.bind(m)

          app = aiohttp.web.Application()
          app.add_routes(routes=routes.bound_routes())

          self.runner = aiohttp.web.AppRunner(app)
  ```

