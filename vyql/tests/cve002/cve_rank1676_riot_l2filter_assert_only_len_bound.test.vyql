test "rank1676: a nonzero test in an assert is not a bound"
  lang c
  file sys/net/link_layer/l2filter/l2filter.c
  reject VYQL-MEM-079
  code
  ```
  #include <string.h>

  #define CONFIG_L2FILTER_ADDR_MAXLEN (8U)

  typedef struct {
      uint8_t addr[CONFIG_L2FILTER_ADDR_MAXLEN];
      size_t addr_len;
  } l2filter_t;

  int l2filter_add(l2filter_t *list, const void *addr, size_t addr_len)
  {
      assert(list && addr && addr_len > 0);

      memcpy(list[0].addr, addr, addr_len);
      return 0;
  }
  ```

test "rank1676: a count the compiler fixes states its own capacity"
  lang c
  file sys/net/link_layer/l2filter/l2filter.c
  reject VYQL-MEM-079
  code
  ```
  #include <string.h>

  #define CONFIG_L2FILTER_ADDR_MAXLEN (8U)

  typedef struct {
      uint8_t addr[CONFIG_L2FILTER_ADDR_MAXLEN];
      size_t addr_len;
  } l2filter_t;

  int l2filter_reset(l2filter_t *f)
  {
      assert(f != NULL);
      memcpy(f->addr, "\0\0\0\0\0\0\0\0", sizeof(f->addr));
      return 0;
  }
  ```

test "rank1676: the index-access guard route reads an assert-wrapped comparison as a bound"
  lang c
  file sys/net/link_layer/l2filter/l2filter.c
  reject VYQL-MEM-010
  reject_review code.FieldDerivedIndexAccess
  code
  ```
  #define CAP (64U)

  typedef struct {
      unsigned len;
      uint8_t data[CAP];
  } pkt_t;

  int read_last(pkt_t *p)
  {
      assert(p->len <= CAP);
      return p->data[p->len];
  }
  ```
