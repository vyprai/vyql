# Rank 1712 / CVE-2026-4408 (GHSA-jg8v-92xc-cx65, CWE-78): Samba's "check
# password script" took the client-supplied account name into a shell command
# line with no shell quoting. The remote path is _samr_ValidatePassword
# (source3/rpc_server/samr/srv_samr_nt.c:7466, SAMR over ncacn_ip_tcp/ncalrpc
# at privacy auth level), which passes r->in.req->req2.account.string through
# samr_ValidatePassword_Change/_Reset into check_password_complexity
# (source3/rpc_server/samr/srv_samr_chgpasswd.c). There the command is
# assembled as cmd = talloc_string_sub(tosctx, lp_check_password_script(...),
# "%u", username) -- a raw splice of the account name into the configured
# template -- and executed by smbrunsecret(cmd, password). smbrunsecret is
# Samba's "run a command, send the secret on stdin" helper and execs
# /bin/sh -c verbatim (source3/lib/smbrun.c): unlike smbrun() it applies no
# escape_shell_string(), so a username carrying shell metacharacters runs
# commands of the client's choosing.
#
# The fixing commit e6c532fbd5 is a CVE-2026-4408 commit in the right
# repository: it gates _samr_ValidatePassword to domain controllers
# (lp_server_role() <= ROLE_DOMAIN_MEMBER returns ACCESS_DENIED with a DCERPC
# fault), removing the endpoint from file servers and members. The
# remediation of the CWE-78 at the injection site is the next commit of the
# same series, 23bc9e264e ("deny, mask and/or single quote username to
# 'check password script'"): check_password_complexity_internal first denies
# the username when strstr_for_invalid_account_characters() finds anything
# (the helper landed in 9910bbfc09, that commit's own parent), then
# substitutes through talloc_string_sub_unsafe(), which masks unsafe
# characters and single-quotes the inserted value. The deny alone is not
# sufficient -- its set ("[]:;|=+*?<>/\, plus control characters) leaves
# single quote, dollar, ampersand, parentheses, backtick and space
# unconstrained -- so the masking substitution is the load-bearing fix, and
# the binding keys the raw spellings only.
#
# Detection: smbrunUnquotedSubstitution971 in vyql/bindings/c/mce54b166.vyql
# labels a smbrunsecret() call that shares its scope with one of Samba's raw
# substitution helpers (talloc_string_sub, talloc_all_string_sub,
# string_sub), emitting code.CommandLineAssemblyReview, whose reviewCondition
# -- "command line text is assembled from contextual values without observed
# shell quoting" -- names this shape; VYQL-INJ-053 reports it HIGH. The
# masking variant is a distinct exact name and does not satisfy the clause.
# smbrun() and smbrun_no_sanitize() are excluded on their own documented
# semantics: smbrun() escapes the line itself, and smbrun_no_sanitize()'s doc
# comment reserves it for lines the caller has validated (printing);
# its one user, print_generic.c, routes the client jobname through the
# masking variant since the sibling CVE-2026-4480 fix b80131fcf5, an
# ancestor of this tree.
#
# Measured on source3/rpc_server/samr extracted at each revision: 1
# VYQL-INJ-053 at srv_samr_chgpasswd.c:1047 (the smbrunsecret line) at
# 9910bbfc09, stable over three runs; 0 at 23bc9e264e, stable over three
# runs; the subtree reports 88 findings on both sides, and the only other
# rule-level movement is MEM-006 83 -> 84, NullableDeref rows shifted one
# line by the remediation's added #include plus new rows inside the added
# helper -- the pre-existing rule on newly written code, not this binding's.
# The same finding is still present at e6c532fbd5, the pool
# commit: the DC gate does not touch the substitution, which the second test
# pins. The reachable set is one function tree-wide: smbrunsecret has a
# single call site in the whole samba checkout (the CVE line; the only other
# occurrence is the prototype in source3/include/proto.h:141) and appears in
# no other clone under /tmp/cve-work/, so the binding's collateral cost is
# that one finding. Residual: scope.call is same-or-nested lexical scope, so
# a variant performing the raw substitution in a helper while calling
# smbrunsecret in its caller is outside the conjunction -- measured silent on
# a two-function pair, and not asserted here.

test "rank1712: the account name reaches the check password script unquoted"
  lang c
  file source3/rpc_server/samr/srv_samr_chgpasswd.c
  expect VYQL-INJ-053
  code
  ```
  struct loadparm_substitution;

  const char *lp_check_password_script(void *ctx,
					const struct loadparm_substitution *sub);
  char *talloc_string_sub(void *ctx, const char *src, const char *pattern,
			  const char *insert);
  int smbrunsecret(const char *cmd, const char *secret);

  int check_password_complexity(const char *username, const char *password)
  {
	void *tosctx = NULL;
	const struct loadparm_substitution *lp_sub = NULL;
	const char *script;
	char *cmd;
	int check_ret;

	script = lp_check_password_script(tosctx, lp_sub);
	if (script == NULL || script[0] == '\0') {
		return 0;
	}

	cmd = talloc_string_sub(tosctx, script, "%u", username);
	if (!cmd) {
		return 2;
	}

	check_ret = smbrunsecret(cmd, password);
	return check_ret == 0 ? 0 : 2;
  }
  ```

test "rank1712: the DC-only gate alone leaves the substitution raw"
  lang c
  file source3/rpc_server/samr/srv_samr_chgpasswd.c
  expect VYQL-INJ-053
  code
  ```
  struct loadparm_substitution;
  struct samr_ValidatePasswordReq2;

  enum server_role { ROLE_STANDALONE, ROLE_DOMAIN_MEMBER,
		     ROLE_DOMAIN_CONTROLLER };

  const char *lp_check_password_script(void *ctx,
					const struct loadparm_substitution *sub);
  char *talloc_string_sub(void *ctx, const char *src, const char *pattern,
			  const char *insert);
  int smbrunsecret(const char *cmd, const char *secret);
  enum server_role lp_server_role(void);

  /* srv_samr_chgpasswd.c at e6c532fbd5: the gate in srv_samr_nt.c does not
     reach the substitution, which stays exactly as before. */
  int check_password_complexity(const char *username, const char *password)
  {
	void *tosctx = NULL;
	const struct loadparm_substitution *lp_sub = NULL;
	const char *script;
	char *cmd;
	int check_ret;

	script = lp_check_password_script(tosctx, lp_sub);
	if (script == NULL || script[0] == '\0') {
		return 0;
	}

	cmd = talloc_string_sub(tosctx, script, "%u", username);
	if (!cmd) {
		return 2;
	}

	check_ret = smbrunsecret(cmd, password);
	return check_ret == 0 ? 0 : 2;
  }

  int _samr_ValidatePassword(int transport, int level,
			     struct samr_ValidatePasswordReq2 *req2)
  {
	if (transport != 1 && transport != 2) {
		return 1;
	}

	if (lp_server_role() <= ROLE_DOMAIN_MEMBER) {
		return 1;
	}

	if (level != 2) {
		return 3;
	}

	return check_password_complexity(req2->account.string,
					 req2->password.string);
  }
  ```

test "rank1712: the masked and single-quoted substitution clears"
  lang c
  file source3/rpc_server/samr/srv_samr_chgpasswd.c
  reject VYQL-INJ-053
  code
  ```
  struct loadparm_substitution;

  #include <stdbool.h>

  #define STRING_SUB_UNSAFE_CHARACTERS "$`\"';%|&<>"

  const char *lp_check_password_script(void *ctx,
					const struct loadparm_substitution *sub);
  char *talloc_string_sub_unsafe(void *ctx, const char *orig_cmd,
				 char variable_char,
				 const char *unsafe_value,
				 const char *unsafe_characters,
				 char safe_character,
				 const char *fallback_value, bool *_modified,
				 bool *_masked, bool *_mixed_fallback);
  int smbrunsecret(const char *cmd, const char *secret);
  const char *strstr_for_invalid_account_characters(const char *name);

  /* srv_samr_chgpasswd.c at 23bc9e264e: deny, then substitute through the
     masking and single-quoting variant. */
  static int check_password_complexity_internal(void *tosctx,
						const char *orig_cmd,
						const char *username,
						char **cmd_out)
  {
	const char *fallback_username = "__CVE-2026-4408_FallbackUsername__";
	const char *inv;
	bool modified = false;
	bool masked = false;
	bool mixed_fallback = false;
	char *cmd;

	*cmd_out = NULL;

	inv = strstr_for_invalid_account_characters(username);
	if (inv != NULL) {
		return 4;
	}

	cmd = talloc_string_sub_unsafe(tosctx, orig_cmd, 'u', username,
				       STRING_SUB_UNSAFE_CHARACTERS, '_',
				       fallback_username, &modified,
				       &masked, &mixed_fallback);
	if (cmd == NULL) {
		return 4;
	}

	*cmd_out = cmd;
	return 0;
  }

  int check_password_complexity(const char *username, const char *password)
  {
	void *tosctx = NULL;
	const struct loadparm_substitution *lp_sub = NULL;
	const char *orig_cmd;
	char *cmd = NULL;
	int check_ret;

	orig_cmd = lp_check_password_script(tosctx, lp_sub);
	if (orig_cmd == NULL || orig_cmd[0] == '\0') {
		return 0;
	}

	if (check_password_complexity_internal(tosctx, orig_cmd, username,
					       &cmd) != 0) {
		return 4;
	}

	check_ret = smbrunsecret(cmd, password);
	return check_ret == 0 ? 0 : 2;
  }
  ```
