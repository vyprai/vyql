# Rank 1184 / CVE-2024-55875: http4k's Xml object builds a Document with a
# stock javax.xml DocumentBuilderFactory:
#
#   fun String.asXmlDocument(): Document =
#       DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(byteInputStream())
#
# A JAXP DocumentBuilderFactory resolves DOCTYPE-declared external entities
# and external DTDs/schemas by default. Body.xml() feeds this straight from
# an HTTP request body, so a request carrying
# `<!DOCTYPE root [<!ENTITY xxe SYSTEM "http://attacker">]>` makes the server
# fetch attacker-chosen URLs (SSRF) and can read local files back into the
# parsed document (info disclosure) -- CWE-611, CWE-918, CWE-200. The fixed
# revision adds an `XmlParsingConfig` typealias
# (`DocumentBuilderFactory.() -> Unit`), a `defaultXmlParsingConfig` value
# that sets `isExpandEntityReferences = false` and blanks
# `XMLConstants.ACCESS_EXTERNAL_DTD` / `ACCESS_EXTERNAL_SCHEMA` via
# `setAttribute`, and threads that config through `.apply(config)` before
# `newDocumentBuilder()` in every `asXmlDocument` overload; the new
# XmlSecurityTest asserts none of DTD/schema/entity fetches reach a
# listening test server.
#
# vyql match on the vulnerable file labels the parse call
# (code.XmlParserCreate, kotlin.marks) but nothing covers it -- expected,
# there is no hardening call anywhere. VYQL-DESER-004 fires, correctly.
#
# vyql match on the fixed file also labels the same code.XmlParserCreate
# call, and nothing covers it: the kotlin bindings wire `setProperty` +
# ACCESS_EXTERNAL_DTD to core.XmlHardening (the SAXParserFactory/
# XMLInputFactory idiom), but DocumentBuilderFactory's real, documented API
# for this is `setAttribute`, which xmlHardening92a/92b/92c in
# vyql/bindings/kotlin/m304d1620.vyql bind (setAttribute + literal
# ACCESS_EXTERNAL_DTD / ACCESS_EXTERNAL_SCHEMA / ACCESS_EXTERNAL_STYLESHEET
# -> check core.XmlHardening, covers sameReceiver anchored on
# callee.receiver, mirroring the Java bindings that cover this exact,
# standard DocumentBuilderFactory hardening call). Not orphaned: a
# same-function repro that calls
# `factory.setAttribute(XMLConstants.ACCESS_EXTERNAL_DTD, "")` right beside
# `factory.newDocumentBuilder()` clears VYQL-DESER-004 (third case below).
#
# ATTENTION anyway: the real fix's `setAttribute` calls do not sit in the
# same function as `newDocumentBuilder()`. They live inside
# `defaultXmlParsingConfig`, a value of the extension-lambda type
# `DocumentBuilderFactory.() -> Unit`, applied indirectly via
# `.apply(config)` where `config` is a named default-parameter reference
# (`config: XmlParsingConfig = defaultXmlParsingConfig`), not a literal
# trailing lambda at the call site. kotlin.go's trailingLambdaStmts already
# inlines literal trailing lambdas passed to apply/also/let/run so their
# statements execute in the caller's scope, but a named reference to a
# lambda-typed value is not a literal at the call site, so that inlining
# never triggers, and the hardening calls stay invisible from asXmlDocument
# entirely: on the fixed real file they lower as module-scope calls with no
# region at all (`path=setAttribute`, no `[region@order]`), two functions
# away from the sink at `fn6`. Recognizing this needs the engine to resolve
# the reference through the parameter's default value to the top-level
# `val` and inline its body with the scope function's receiver bound to the
# lambda's implicit `this` -- real symbol resolution plus receiver
# substitution, not a binding or rule fix, so it is entered in
# ENGINE-GAPS.md rather than worked around in data.
#
# The fourth case pins the sibling defect in the same construct that a
# reference-resolving fix would still leave behind. Written as a *literal*
# trailing lambda the hardening does get inlined into the sink's own
# function -- but the inlined call is lowered with no receiver
# (`path=setAttribute`, so sameReceiver's receiverPrefix is empty and can
# never equal the sink's `DocumentBuilderFactory.newInstance.apply`), and it
# is appended after the whole chain's own expression statement (order 17
# and 23 against the sink's order 8), so neither sameReceiver nor
# endpoint/dominates can see it. Two independent blockers, so fixing the
# ordering alone recovers nothing.
#
# verify_current_expected: attention-precision-limit, both real revisions
# fire identically
#
# vyql/bindings/kotlin/m304d1620.vyql: xmlHardening92a/92b/92c
# (setAttribute + ACCESS_EXTERNAL_DTD/SCHEMA/STYLESHEET -> core.XmlHardening,
# covers sameReceiver). OWASP Java and Python unchanged at +1.00 and +0.90.

test "rank1184: asXmlDocument builds a DocumentBuilder with no XML hardening"
  lang kotlin
  file Xml.kt
  expect VYQL-DESER-004
  code
  ```
  package org.http4k.format

  import org.w3c.dom.Document
  import javax.xml.parsers.DocumentBuilderFactory

  object Xml {
      fun String.asXmlDocument(): Document =
          DocumentBuilderFactory
              .newInstance()
              .newDocumentBuilder()
              .parse(byteInputStream())
  }
  ```

test "rank1184: the fixed revision's config lambda hardens the factory through apply(), but the check does not reach across the indirection"
  lang kotlin
  file Xml.kt
  expect VYQL-DESER-004
  code
  ```
  package org.http4k.format

  import org.w3c.dom.Document
  import javax.xml.XMLConstants
  import javax.xml.parsers.DocumentBuilderFactory

  object Xml {
      fun String.asXmlDocument(config: XmlParsingConfig = defaultXmlParsingConfig): Document =
          DocumentBuilderFactory
              .newInstance()
              .apply(config)
              .newDocumentBuilder()
              .parse(byteInputStream())
  }

  typealias XmlParsingConfig = DocumentBuilderFactory.() -> Unit

  val defaultXmlParsingConfig: XmlParsingConfig = {
      isExpandEntityReferences = false
      setAttribute(XMLConstants.ACCESS_EXTERNAL_DTD, "")
      setAttribute(XMLConstants.ACCESS_EXTERNAL_SCHEMA, "")
  }
  ```

test "rank1184: the same hardening written as a literal trailing lambda is inlined into the sink's function but still reports, because the inlined call carries no receiver and runs after the chain"
  lang kotlin
  file Xml.kt
  expect VYQL-DESER-004
  code
  ```
  package org.http4k.format

  import org.w3c.dom.Document
  import javax.xml.XMLConstants
  import javax.xml.parsers.DocumentBuilderFactory

  object Xml {
      fun String.asXmlDocument(): Document =
          DocumentBuilderFactory
              .newInstance()
              .apply {
                  setAttribute(XMLConstants.ACCESS_EXTERNAL_DTD, "")
                  setAttribute(XMLConstants.ACCESS_EXTERNAL_SCHEMA, "")
              }
              .newDocumentBuilder()
              .parse(byteInputStream())
  }
  ```

test "rank1184: the same setAttribute hardening, called directly beside newDocumentBuilder, clears the check"
  lang kotlin
  file Xml.kt
  reject VYQL-DESER-004
  code
  ```
  package org.http4k.format

  import org.w3c.dom.Document
  import javax.xml.XMLConstants
  import javax.xml.parsers.DocumentBuilderFactory

  object Xml {
      fun String.asXmlDocument(): Document {
          val factory = DocumentBuilderFactory.newInstance()
          factory.setAttribute(XMLConstants.ACCESS_EXTERNAL_DTD, "")
          factory.setAttribute(XMLConstants.ACCESS_EXTERNAL_SCHEMA, "")
          return factory.newDocumentBuilder().parse(byteInputStream())
      }
  }
  ```
