test "rank1755: a response event without any URI argument stays clean"
  lang rust
  file src/hyper_tokio/connector.rs
  reject VYQL-SEC-029
  code
  ```
  use hyper::{Body, Request, StatusCode};
  use tracing::*;

  pub struct SlackClientApiCallContext<'a> {
      pub is_sensitive_url: bool,
      pub tracing_span: &'a Span,
  }

  async fn send_http_request<RS>(
      request: Request<Body>,
      context: SlackClientApiCallContext<'_>,
  ) -> String {
      let uri_str = request.uri().to_string();
      let http_status = StatusCode::OK;

      context.tracing_span.in_scope(|| {
          debug!(
              slack_uri = uri_str.as_str(),
              slack_http_status = http_status.as_u16(),
              "Received HTTP response {}",
              http_status
          );
      });

      uri_str
  }
  ```

test "rank1755: the redaction helper itself is not a log event"
  lang rust
  file src/hyper_tokio/connector.rs
  reject VYQL-SEC-029
  code
  ```
  use hyper::{Body, Request};

  pub struct SlackClientApiCallContext<'_> {
      pub is_sensitive_url: bool,
  }

  fn redacted_uri(request: &Request<Body>, context: &SlackClientApiCallContext<'_>) -> String {
      if context.is_sensitive_url {
          format!(
              "{}://{}/-redacted-",
              request
                  .uri()
                  .scheme()
                  .map(|scheme| scheme.to_string())
                  .unwrap_or_else(|| "unknown-scheme".to_string()),
              request
                  .uri()
                  .host()
                  .map(|host| host.to_string())
                  .unwrap_or_else(|| "unknown-host".to_string())
          )
      } else {
          request.uri().to_string()
      }
  }
  ```
