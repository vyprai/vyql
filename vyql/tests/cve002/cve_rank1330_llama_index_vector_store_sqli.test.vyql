# Rank 1330 / CVE-2025-1793: eight llama_index vector-store integrations built
# their SQL by interpolating caller-supplied values straight into the statement
# text (CWE-89, CVSS 9.8). The canonical instance is the Lantern store's
# delete():
#
#   stmt = sqlalchemy.text(
#       f"DELETE FROM {self.schema_name}.data_{self.table_name} where "
#       f"(metadata_->>'doc_id')::text = '{ref_doc_id}' "
#   )
#   session.execute(stmt)
#
# with sibling instances in clickhouse (self._client.command(f"... doc_id=
# '{ref_doc_id}'")), couchbase (self._scope.query(f"... = '{ref_doc_id}'")),
# jaguar (plain "+" concatenation into self.run(q)), deeplake, nile, oracledb
# and singlestoredb. Because the stores are library entry points, the value
# arrives from whatever application drives them, which is what the advisory
# means by "when llama-index is integrated into web applications".
#
# The pool row's commit 0008041e8dde8e519621388e5d6f558bde6ef42e is the
# "v0.12.28 (#18340)" release bump, not the fix. The fix is
# 201d3f5408055c5c6825bc37304b9dcc9d46e5ab, "fix: patch multiple sql-injection
# vulnerabilities" (#18316), which switches Lantern to
# text(...).bindparams(ref_doc_id=ref_doc_id), clickhouse to a %(name)s
# placeholder plus parameters=, couchbase to a $name placeholder plus a query
# kwarg, nile to psycopg sql.SQL placeholders, singlestoredb to an
# alphanumeric-identifier allowlist, and jaguar/deeplake to hand-rolled
# escapers.
#
# CAUGHT. On the vulnerable checkout of the Lantern package VYQL-INJ-001
# (taint core.UserControlledData -> code.SqlExecution) reports base.py:656
# with the path delete#param#ref_doc_id -> Format -> Arg, and VYQL-INJ-203
# reports the same line from code.DynamicSqlQuery. The nile, oracledb and
# singlestoredb interpolations the same commit rewrites are reported too.
#
# Two limits are worth knowing rather than re-deriving:
#
#   * VYQL-INJ-203 is presence-based, so it also fires on the patched line:
#     the fix keeps interpolating the schema and table identifiers, which is
#     the part that cannot be parameterised. Discrimination comes from
#     VYQL-INJ-001, whose taint path ends when the value moves into a bind
#     parameter -- the first two tests below.
#   * Under `profile library` a public method's `self` is an entry point as
#     well, so `{self.schema_name}` keeps the patched f-string tainted and
#     both revisions report 17 findings. The application shape -- a route that
#     hands a request value to the store, which is the advisory's own threat
#     model -- is where the two revisions separate.
#
# The clickhouse and couchbase instances are missed: clickhouse-connect's
# Client.command and Couchbase's Scope.query carry no code.SqlExecution
# binding, so nothing is labelled at those calls and neither rule can see
# them. A dependency-gated method binding for both was written and measured
# against the real packages, and rejected: `callee.method == "query"` under
# dependency("couchbase") does report couchbase/base.py:316, but it reports
# the identical 7 findings on the patched revision -- the patched statement
# still interpolates {self._collection_name}, so under the library profile
# `self` keeps it tainted -- plus 6 rows in the package's own tests. The shape
# does not tell fixed from vulnerable on the code it was derived from. The
# clickhouse half could not be measured at all: the store receives its client
# by injection and never imports clickhouse_connect, and the only other
# evidence for dependency("clickhouse-connect") is the poetry pyproject.toml,
# which internal/extract/sca/discover.go's manifestParsers table does not
# read. The last four tests pin both misses so a later sweep flips them.
#
# verify_current_expected: caught-by-VYQL-INJ-001, patched bindparams form
# rejected, clickhouse/couchbase shapes pinned as misses.

test "rank1330: a route hands a request value to a store that interpolates it into text()"
  lang python
  file base.py
  expect VYQL-INJ-001
  code
  ```
  import logging
  from typing import Any, List, NamedTuple, Optional, Type

  import sqlalchemy
  from flask import Flask, request

  from llama_index.core.vector_stores.types import BasePydanticVectorStore

  app = Flask(__name__)


  class LanternVectorStore(BasePydanticVectorStore):
      schema_name: str = "public"
      table_name: str = "llamaindex"

      def delete(self, ref_doc_id: str, **delete_kwargs: Any) -> None:
          import sqlalchemy

          self._initialize()
          with self._session() as session, session.begin():
              stmt = sqlalchemy.text(
                  f"DELETE FROM {self.schema_name}.data_{self.table_name} where "
                  f"(metadata_->>'doc_id')::text = '{ref_doc_id}' "
              )

              session.execute(stmt)
              session.commit()


  @app.route("/documents/delete", methods=["POST"])
  def delete_document():
      store = LanternVectorStore()
      store.delete(request.form["doc_id"])
      return "deleted"
  ```

test "rank1330: the value moves into a bind parameter and only the identifiers stay interpolated"
  lang python
  file base.py
  reject VYQL-INJ-001
  code
  ```
  import logging
  from typing import TYPE_CHECKING, Any, List, NamedTuple, Optional, Type

  import sqlalchemy
  from flask import Flask, request

  from llama_index.core.vector_stores.types import BasePydanticVectorStore

  app = Flask(__name__)


  class LanternVectorStore(BasePydanticVectorStore):
      schema_name: str = "public"
      table_name: str = "llamaindex"

      def delete(self, ref_doc_id: str, **delete_kwargs: Any) -> None:
          from sqlalchemy import text

          self._initialize()
          with self._session() as session, session.begin():
              # Use parameterized query with bind parameters
              stmt = text(
                  f"DELETE FROM {self.schema_name}.data_{self.table_name} "
                  "WHERE (metadata_->>'doc_id')::text = :ref_doc_id"
              ).bindparams(ref_doc_id=ref_doc_id)

              session.execute(stmt)
              session.commit()


  @app.route("/documents/delete", methods=["POST"])
  def delete_document():
      store = LanternVectorStore()
      store.delete(request.form["doc_id"])
      return "deleted"
  ```

