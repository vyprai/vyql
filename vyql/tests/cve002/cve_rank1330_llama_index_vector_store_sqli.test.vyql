test "rank1330: a fully static statement executed through text() is not this weakness"
  lang python
  file base.py
  profile library
  reject VYQL-INJ-001
  reject VYQL-INJ-203
  code
  ```
  import logging
  from typing import Any, List, NamedTuple, Optional, Type

  import sqlalchemy

  from llama_index.core.vector_stores.types import BasePydanticVectorStore


  class LanternVectorStore(BasePydanticVectorStore):
      def delete(self, ref_doc_id: str, **delete_kwargs: Any) -> None:
          from sqlalchemy import text

          self._initialize()
          with self._session() as session, session.begin():
              stmt = text(
                  "DELETE FROM public.data_llamaindex "
                  "WHERE (metadata_->>'doc_id')::text = :ref_doc_id"
              ).bindparams(ref_doc_id=ref_doc_id)

              session.execute(stmt)
              session.commit()
  ```

test "rank1330: a clickhouse-connect command() carrying an interpolated value is not labelled"
  lang python
  file base.py
  reject VYQL-INJ-001
  reject VYQL-INJ-203
  code
  ```
  import logging
  from typing import Any, Dict, List, Optional, cast

  import clickhouse_connect
  from flask import Flask, request

  from llama_index.core.vector_stores.types import BasePydanticVectorStore

  app = Flask(__name__)


  class ClickHouseVectorStore(BasePydanticVectorStore):
      def delete(self, ref_doc_id: str, **delete_kwargs: Any) -> None:
          self._client.command(
              f"DELETE FROM {self._config.database}.{self._config.table} WHERE doc_id='{ref_doc_id}'"
          )


  @app.route("/documents/delete", methods=["POST"])
  def delete_document():
      store = ClickHouseVectorStore()
      store.delete(request.form["doc_id"])
      return "deleted"
  ```

test "rank1330: the clickhouse-connect placeholder plus parameters= form"
  lang python
  file base.py
  reject VYQL-INJ-001
  code
  ```
  import logging
  from typing import Any, Dict, List, Optional, cast

  import clickhouse_connect
  from flask import Flask, request

  from llama_index.core.vector_stores.types import BasePydanticVectorStore

  app = Flask(__name__)


  class ClickHouseVectorStore(BasePydanticVectorStore):
      def delete(self, ref_doc_id: str, **delete_kwargs: Any) -> None:
          query = f"DELETE FROM {self._config.database}.{self._config.table} WHERE doc_id = %(ref_doc_id)s"
          self._client.command(query, parameters={"ref_doc_id": ref_doc_id})


  @app.route("/documents/delete", methods=["POST"])
  def delete_document():
      store = ClickHouseVectorStore()
      store.delete(request.form["doc_id"])
      return "deleted"
  ```

test "rank1330: a couchbase scope query carrying an interpolated value is not labelled"
  lang python
  file base.py
  reject VYQL-INJ-001
  reject VYQL-INJ-203
  code
  ```
  import logging
  from typing import Any, Dict, List, Optional

  from flask import Flask, request

  from llama_index.core.vector_stores.types import BasePydanticVectorStore

  app = Flask(__name__)
  logger = logging.getLogger(__name__)


  class CouchbaseVectorStore(BasePydanticVectorStore):
      def _connect(self) -> Any:
          from couchbase.cluster import Cluster

          self._cluster = Cluster(self._connection_string)
          return self._cluster

      def delete(self, ref_doc_id: str, **kwargs: Any) -> None:
          document_field = self._metadata_key + ".ref_doc_id"
          self._scope.query(
              f"DELETE FROM `{self._collection_name}` WHERE {document_field} = '{ref_doc_id}'"
          ).execute()


  @app.route("/documents/delete", methods=["POST"])
  def delete_document():
      store = CouchbaseVectorStore()
      store.delete(request.form["doc_id"])
      return "deleted"
  ```

test "rank1330: the couchbase named-parameter form"
  lang python
  file base.py
  reject VYQL-INJ-001
  code
  ```
  import logging
  from typing import Any, Dict, List, Optional

  from flask import Flask, request

  from llama_index.core.vector_stores.types import BasePydanticVectorStore

  app = Flask(__name__)
  logger = logging.getLogger(__name__)


  class CouchbaseVectorStore(BasePydanticVectorStore):
      def _connect(self) -> Any:
          from couchbase.cluster import Cluster

          self._cluster = Cluster(self._connection_string)
          return self._cluster

      def delete(self, ref_doc_id: str, **kwargs: Any) -> None:
          document_field = self._metadata_key + ".ref_doc_id"
          query = f"DELETE FROM `{self._collection_name}` WHERE {document_field} = $ref_doc_id"
          self._scope.query(query, ref_doc_id=ref_doc_id).execute()


  @app.route("/documents/delete", methods=["POST"])
  def delete_document():
      store = CouchbaseVectorStore()
      store.delete(request.form["doc_id"])
      return "deleted"
  ```
