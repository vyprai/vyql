# Rank 1319 / CVE-2019-19334: libyang canonicalized an identityref value into
# a 512-byte stack buffer with sprintf/strcpy and no length check, so a long
# identityref default value in a supplied YANG module overflowed it
# (CWE-120, CWE-787).
#
# make_canonical in src/parser.c declares `const uint16_t buf_len = 511;`
# followed by `char buf[buf_len + 1];` and switches on the value's type. The
# LY_TYPE_IDENT arm took the parsed value and either prefixed it with the
# local module's name, `sprintf(buf, "%s:%s", module_name, *value)`, or copied
# it verbatim, `strcpy(buf, *value)`, in both branches without comparing any
# length against buf_len. lyp_parse_value reaches that arm at parser.c:1612
# with a value taken from a schema default or a data node, so a value longer
# than 511 bytes wrote past the 512-byte stack array. The LY_TYPE_BITS arm a
# few cases above the same switch guards its own sprintf and strcpy with
# `LY_CHECK_ERR_RETURN(strlen(...) > buf_len, LOGBUF(...), -1)`; the
# identityref arm is the one that does not. The fixed revision (one file, two
# added lines, "parser BUGFIX long identityref default value buffer overflow /
# STRING_OVERFLOW (CWE-120)") adds that same LY_CHECK_ERR_RETURN length check
# to each identityref branch, keeping sprintf and strcpy.
#
# ATTENTION. code.UnboundedCopySmell (VYQL-MEM-002) reports both copies, at
# src/parser.c:1024 and :1026 in the real tree, and reports them identically
# at the fixed revision (1025 and :1028 there), together with the two
# already-guarded BITS copies at :1012 and :1015: the rule carries no `unless`
# clause, so it is an unconditional low-confidence smell on the unbounded copy
# family (strcpy/strcat/sprintf/vsprintf) rather than a discriminator between
# a guarded and an unguarded call. The fourth snippet pins where the rule does
# discriminate: rewriting the same two copies onto the bounded-destination
# family (snprintf, strlcpy) drops VYQL-MEM-002 entirely.
#
# The rule that discriminates a clamp from an unclamped copy exists:
# VYQL-MEM-071, fed by the dest_capacity_unchecked fact
# (ccDestCapacityUncheckedObservations,
# internal/extract/frontend/treesitter/c.go) through binding
# destCapacityUncheckedCopy. It does not reach this code, for two independent
# reasons, each pinned by a reject block below.
#
# 1. The fact pairs a copy destination only with a *parameter* the function
#    uses as that destination's byte count in a capacity-taking libc call
#    (memset/fgets/fread/snprintf/strncpy), and `ccContainsParam(params, dst)`
#    gates the report on the destination being a parameter at all. `buf` is a
#    local array, so its declaration's own size expression -- which names
#    buf_len, the very identifier the fix compares against -- is never read as
#    the capacity. Pairing a locally declared array with the identifiers its
#    size expression is built from was measured: it holds the fifth snippet at
#    one finding and the sixth at zero, and adds four plausible
#    strcat-into-a-MAX_PATH-sized-local rows on a 1500-file krb5 tree and
#    nothing on three other C trees.
# 2. Even with that pairing, the real function still reports zero on both
#    revisions, because ccCapacityConsultedIn scans the whole compacted body:
#    the BITS arm's own `strlen(...) > buf_len` comparisons sit in the same
#    function and clear every copy in it, including the identityref arm's
#    unguarded pair. That is the branch-boundary residual the shipped binding
#    documents ("a comparison on either side of a branch boundary clears every
#    copy in the function"), and lifting it means attributing a guard to the
#    branch that contains the copy rather than the function -- a new
#    attribution relation over a shipped rule's accepted residual, not a
#    localized correction.
#
# No definition change shipped.
#
# verify_current_expected: attention-engine-gap, both revisions rejected.

test "rank1319: the identityref value is canonicalized into a fixed stack buffer with no length check"
  lang c
  file parser.c
  expect VYQL-MEM-002
  code
  ```
  static int
  make_canonical(struct ly_ctx *ctx, int type, const char **value, void *data1, void *data2)
  {
      const uint16_t buf_len = 511;
      char buf[buf_len + 1];
      const char *module_name;

      switch (type) {
      case LY_TYPE_IDENT:
          module_name = (const char *)data1;
          /* identity must always have a prefix */
          if (!strchr(*value, ':')) {
              sprintf(buf, "%s:%s", module_name, *value);
          } else {
              strcpy(buf, *value);
          }
          break;
      default:
          return 0;
      }

      lydict_remove(ctx, *value);
      *value = lydict_insert(ctx, buf, 0);
      return 1;
  }
  ```

test "rank1319: the length check the fixed revision adds before each copy leaves the smell unchanged"
  lang c
  file parser.c
  expect VYQL-MEM-002
  code
  ```
  static int
  make_canonical(struct ly_ctx *ctx, int type, const char **value, void *data1, void *data2)
  {
      const uint16_t buf_len = 511;
      char buf[buf_len + 1];
      const char *module_name;

      switch (type) {
      case LY_TYPE_IDENT:
          module_name = (const char *)data1;
          /* identity must always have a prefix */
          if (!strchr(*value, ':')) {
              LY_CHECK_ERR_RETURN(strlen(module_name) + 1 + strlen(*value) > buf_len, LOGBUF(*value), -1);
              sprintf(buf, "%s:%s", module_name, *value);
          } else {
              LY_CHECK_ERR_RETURN(strlen(*value) > buf_len, LOGBUF(*value), -1);
              strcpy(buf, *value);
          }
          break;
      default:
          return 0;
      }

      lydict_remove(ctx, *value);
      *value = lydict_insert(ctx, buf, 0);
      return 1;
  }
  ```

test "rank1319: the same canonicalization on the bounded-destination copy family is not reported"
  lang c
  file parser.c
  reject VYQL-MEM-002
  code
  ```
  static int
  make_canonical(struct ly_ctx *ctx, int type, const char **value, void *data1, void *data2)
  {
      const uint16_t buf_len = 511;
      char buf[buf_len + 1];
      const char *module_name;

      switch (type) {
      case LY_TYPE_IDENT:
          module_name = (const char *)data1;
          /* identity must always have a prefix */
          if (!strchr(*value, ':')) {
              snprintf(buf, buf_len + 1, "%s:%s", module_name, *value);
          } else {
              strlcpy(buf, *value, buf_len + 1);
          }
          break;
      default:
          return 0;
      }

      lydict_remove(ctx, *value);
      *value = lydict_insert(ctx, buf, 0);
      return 1;
  }
  ```

