  static const MtxTable *lock_mtx (hb_blob_t *blob);

  struct hb_ot_face_metrics_accelerator_t
  {
    unsigned int num_metrics;
    unsigned int num_advances;
    unsigned int default_advance;
    const MtxTable *table;
    hb_blob_t *blob;

    void init (hb_face_t *face, unsigned int _mtx_tag)
    {
      this->blob = sanitize_mtx (face->reference_table (_mtx_tag));
      if (!this->num_advances ||
          2 * (this->num_advances + this->num_metrics) > hb_blob_get_length (this->blob))
      {
        this->num_metrics = this->num_advances = 0;
        hb_blob_destroy (this->blob);
        this->blob = hb_blob_get_empty ();
      }
      this->table = lock_mtx (this->blob);
    }

    unsigned int get_advance (unsigned int glyph) const
    {
      if (glyph >= this->num_metrics)
      {
        if (this->num_metrics)
          return 0;
        else
          return this->default_advance;
      }

      if (glyph >= this->num_advances)
        glyph = this->num_advances - 1;

      return this->table->longMetric[glyph].advance;
    }
  };
  ```
