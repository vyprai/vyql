# Rank 1679 / CVE-2025-53076: rlottie's dotLottie path decompressed an
# attacker-supplied zip stream into a heap buffer and handed the raw char*
# to its rapidjson parser with no byte count attached (CWE-125 buffer
# over-read through CWE-20 improper input validation).
#
# uncompressZip (src/lottie/lottieparser.cpp:2413 at the vulnerable revision) reads
# the archive entry with zip_entry_read(zip, (void**)&buf, &bufSize),
# closes the stream and returns buf. The entry bytes are not
# NUL-terminated and bufSize never leaves the function, so model::parse's
# `LottieParserImpl obj(input)` -- whose LookaheadParserHandler base
# stores the pointer in a rapidjson StringStream that reads until a parse
# error or a zero byte -- scans past the allocation. The same path carried
# two more defects the one fix commit closes: uncompressZip's failure
# returns (zip_stream_open failure, zip_entry_openbyindex failure) are
# nullptr and model::parse passed that to the parser unguarded, and
# model::parse ran free(input) between constructing the parser and calling
# obj.VerifyType(), so the whole parse walks freed memory. The fixed revision adds the
# null and empty checks, reallocates buf to bufSize+1 and writes the
# terminator, moves the free after the parse, and closes the stream on the
# openbyindex failure path.
#
# ATTENTION, engine gap: nothing reports on either side of the defect.
# Re-measured on the real checkout, three --cache off --max-ram 6GB runs
# per revision: 1013 findings on the parent and 1014 on the fix, stable
# in every run, the defect 0 on both, and the single delta is
# VYQL-MEM-049 (ReallocFailurePathInputFree) on the fix's own correct
# free-after-failed-realloc -- the remediation reports and the defect
# does not (1370, 1371, 1378).
#
# The zip half is not a resolution miss. src/lottie/zip/zip.cpp is
# vendored beside the parser, so zip_stream_open, zip_entry_openbyindex
# and zip_entry_read all resolve to their own bodies (lottieparser.cpp:1285
# is that file's only unresolved call site), and zip_entry_read's body
# writes the buffer exactly the way a source would carry it:
# `*buf = mz_zip_reader_extract_to_heap(pzip, idx, &size, 0)`. The
# blocker sits below the binding question, measured with a two-file
# probe: a source labelled inside a callee that assigns through `*out`
# reaches nothing at the caller -- the caller's sink is labelled and no
# finding reports -- while the same producer returning the value instead
# of writing it through the parameter reports a critical injection.
# Taint does not cross an out-parameter write even when the callee is
# in-tree and resolved (1206, 1407), so the generated kubazip binding's
# dependency() gate and its call.result emit are both moot: no labelling
# of this call moves the buffer. The binding-side mechanism for it
# (propagate ... to args[N].pointee) still compiles to a flow_path
# mapping that specFromBindingSet panics on, and CallEffectsFor has no
# callers.
#
# The two correlation facts the C frontend has gained since -- an
# out-parameter status left unconsulted, and a realloc failure path
# freeing its input -- do not reach this shape either: the status fact
# pairs a call's return with a `(*id)->` member read, not a byte count
# with a length-less consumer, and the realloc fact is what produces the
# false positive on the fix. The over-read still needs a buffer/byte-count
# correlation the engine does not have, and the use-after-free half still
# needs pointer capture: code.PointerUse stays bound to the deref
# primitive alone (1645), the use is the parser object reading the
# pointer its constructor captured, and both revisions carry the
# identical free label because the fix moves the release rather than
# removing it. The fix's own `if (!input)` guard still emits no token --
# on the fixed revision nothing is labelled in model::parse between the
# realloc block and the moved free.
#
# A producer-side binding (zip_entry_read present, no terminator write in
# the function) stays rejected on genericity, not effort: the fact that
# makes this code dangerous -- the consumer's size-less char* constructor
# -- lives in another function the binding cannot see, so the binding must
# assume it and fires on the API's correct binary consumers
# (std::string(buf, bufSize), size-bounded loops), and the narrowed form
# "buffer returned while the size is discarded" is inexpressible because
# the C/C++ frontend emits no return-statement token. rlottie is the only
# zip_entry_read user among the reachable clones, so the corpus cannot
# measure the false-positive rate either.
#
# verify_current_expected: attention-engine-gap, both revisions rejected.

test "rank1679: the decompressed entry is parsed as an unterminated char* and freed mid-parse"
  lang cpp
  file src/lottie/lottieparser.cpp
  reject VYQL-MEM-007
  reject VYQL-MEM-006
  code
  ```
  #include <cstddef>

  struct zip_t;
  struct Composition { int frames; };

  zip_t* zip_stream_open(const char* stream, size_t size, int cache, char mode);
  int zip_entry_openbyindex(zip_t* zip, int index);
  long zip_entry_read(zip_t* zip, void** buf, size_t* bufsize);
  void zip_entry_close(zip_t* zip);
  void zip_stream_close(zip_t* zip);

  struct LookaheadParserHandler {
      LookaheadParserHandler(char* str);
      bool VerifyType();
      int parseComposition();
      Composition* composition();
  };

  static bool checkDotLottie(const char* str) {
      return str[0] == 0x50 && str[1] == 0x4B;
  }

  static char* uncompressZip(const char* str, size_t length) {
      auto zip = zip_stream_open(str, length, 0, 'r');
      if (!zip) {
          return nullptr;
      }

      if (zip_entry_openbyindex(zip, 1)) {
          return nullptr;
      }

      char* buf = nullptr;
      size_t bufSize;
      zip_entry_read(zip, (void**)&buf, &bufSize);

      zip_entry_close(zip);
      zip_stream_close(zip);

      return buf;
  }

  Composition* model_parse(char* str, size_t length) {
      auto input = str;

      auto dotLottie = checkDotLottie(str);
      if (dotLottie) {
          input = uncompressZip(str, length);
      }

      LookaheadParserHandler obj(input);

      if (dotLottie) free(input);

      if (obj.VerifyType()) {
          obj.parseComposition();
          auto composition = obj.composition();
          if (composition) {
              return composition;
          }
      }
      return nullptr;
  }
  ```

test "rank1679: the fixed revision terminates the buffer, guards the null return and frees after the parse"
  lang cpp
  file src/lottie/lottieparser.cpp
  reject VYQL-MEM-007
  reject VYQL-MEM-006
  code
  ```
  #include <cstddef>

  struct zip_t;
  struct Composition { int frames; };

  zip_t* zip_stream_open(const char* stream, size_t size, int cache, char mode);
  int zip_entry_openbyindex(zip_t* zip, int index);
  long zip_entry_read(zip_t* zip, void** buf, size_t* bufsize);
  void zip_entry_close(zip_t* zip);
  void zip_stream_close(zip_t* zip);

  struct LookaheadParserHandler {
      LookaheadParserHandler(char* str);
      bool VerifyType();
      int parseComposition();
      Composition* composition();
  };

  static bool checkDotLottie(const char* str) {
      return str[0] == 0x50 && str[1] == 0x4B;
  }

  static char* uncompressZip(const char* str, size_t length) {
      auto zip = zip_stream_open(str, length, 0, 'r');
      if (!zip) {
          return nullptr;
      }

      if (zip_entry_openbyindex(zip, 1)) {
          zip_stream_close(zip);
          return nullptr;
      }

      char* buf = nullptr;
      size_t bufSize;
      zip_entry_read(zip, (void**)&buf, &bufSize);

      zip_entry_close(zip);
      zip_stream_close(zip);

      if (buf == nullptr || bufSize == 0) {
          free(buf);
          return nullptr;
      }

      char* terminatedBuf = static_cast<char*>(realloc(buf, bufSize + 1));
      if (!terminatedBuf) {
          free(buf);
          return nullptr;
      }

      terminatedBuf[bufSize] = '\0';
      return terminatedBuf;
  }

  Composition* model_parse(char* str, size_t length) {
      auto input = str;

      auto dotLottie = checkDotLottie(str);
      if (dotLottie) {
          input = uncompressZip(str, length);
          if (!input) {
              return nullptr;
          }
      }

      LookaheadParserHandler obj(input);

      bool ok = obj.VerifyType();
      int parsed = ok ? obj.parseComposition() : 0;
      Composition* composition = parsed ? obj.composition() : nullptr;

      if (dotLottie) free(input);

      return composition;
  }
  ```
