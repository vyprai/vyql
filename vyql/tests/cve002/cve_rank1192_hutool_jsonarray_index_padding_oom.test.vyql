# The padding call itself stays unreported as a resource finding whatever the
# pin: the caller is doing the correct thing, the loop that grows without a
# bound is inside the library, and detecting it in source needs the Java
# loop-identity analysis fact the engine does not have (ENGINE-GAPS "1192").
# The vulnerable-library report is carried by the dependency finding above.

test "rank1192: the padding call is not a resource finding on a vulnerable pin"
  lang java
  file src/main/java/example/App.java
  code
  ```
  package example;

  import cn.hutool.json.JSONArray;

  public class App {
      public void place(JSONArray array, int index, Object value) {
          array.add(index, value);
      }
  }
  ```
  file pom.xml
  code
  ```
  <project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>example</groupId>
    <artifactId>app</artifactId>
    <version>1.0.0</version>
    <dependencies>
      <dependency>
        <groupId>cn.hutool</groupId>
        <artifactId>hutool-json</artifactId>
        <version>5.8.21</version>
