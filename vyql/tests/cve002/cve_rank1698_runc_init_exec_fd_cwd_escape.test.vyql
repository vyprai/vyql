# runc's container init reaches the final execve still holding internal
# host-side file descriptors -- the O_PATH dirfd for the container rootfs
# among them -- and a container image controls the working directory recorded
# in config.json, so `cwd: /proc/self/fd/N` resolves through a leaked fd to a
# directory on the host filesystem. The container process then starts with
# its working directory, or an exec target reached through /proc/self/fd/N,
# outside the container's mount namespace and can walk the host from there
# (CWE-403, exposure of file descriptors to an unintended control sphere;
# CVE-2024-21626, fix commit 02120488a4c0fc487d1ed2867e901eeed7ce8ecf, the
# merge of GHSA-xr7r-f8xq-vfvv, whose first parent 8454bbb carries the
# weakness in full). The vulnerable revision already sweeps the fds with
# `utils.CloseExecFrom` in finalizeNamespace, but close-on-exec only bites at
# execve: the `unix.Chdir(config.Cwd)` runs before it and the
# working-directory reference survives execve untouched, which is why the
# fixed revision adds a control at every remaining boundary rather than
# widening the sweep:
#
#   * Container.start marks all fds >= 3 close-on-exec before spawning
#     "runc init" (`utils.CloseExecFrom(3)`), container_linux.go.
#   * linuxStandardInit.Init and linuxSetnsInit.Init close everything not
#     passed to the container before `system.Exec` (`utils.UnsafeCloseFrom(
#     l.config.PassedFilesCount + 3)`), standard_init_linux.go and
#     setns_init_linux.go.
#   * finalizeNamespace verifies after the chdir that the working directory
#     is still inside the mount namespace root (`verifyCwd()`, whose body is
#     `unix.Getwd` + `filepath.IsAbs`), init_linux.go.
#
# ATTENTION, rechecked: the delegated-check attribution family measured for
# Go at ranks 1377, 1389 and 1399. Every one of the three remediations is a
# call to a project-internal helper, and no API-documented call is left
# inside the function each one guards:
#
#   * Go `call:` tokens drop the package qualifier -- `system.Exec(...)`
#     lowers to `call == "Exec"`, and `call contains "system."` never
#     matches -- so a positive anchor on the exec boundary either names
#     runc's internal wrapper (`node.context.callPath contains
#     "system.Exec"`) or matches every `.Exec` receiver including `db.Exec`
#     SQL.
#   * A closefrom-family negation (`not containsAny(node.context.call,
#     ["CloseFrom","CloseOnExec","CloseRange","closefrom","close_range"])`)
#     separates the vulnerable from the patched Init only through the
#     substring "CloseFrom" inside the fixed revision's own helper name
#     `UnsafeCloseFrom`; the same fix with the sweep helper renamed
#     (`utils.SweepAbove(...)`) still matches, so the renaming test a
#     discriminating negation must survive fails on it.
#   * The cwd-verification control puts its only documented calls
#     (`unix.Getwd`, `filepath.IsAbs`) inside verifyCwd, and a negation on
#     `Getwd` in finalizeNamespace's context sees nothing at either
#     revision -- a control that leaves the guarded function is invisible to
#     function-confined facts, and keying the helper's own name is the
#     fixing commit's layout.
#
# Re-measured on the real checkout over three --cache off runs per revision
# (`timeout 180 ./bin/vyql scan --cache off --max-ram 6GB` over libcontainer,
# 211 go + 37 c + 3 cpp + 219 textpattern files): 93/93/93 findings at the
# parent and 93/93/93 at the fix, 18 at or above high on both sides. The
# JSON finding sets differ only by line-number shift (container_linux.go:434
# -> :443 and cgroups/file.go:162 -> :163, both from added lines above them),
# with 85 of 88 (rule, sink) pairs common. The `-flags with` view reports 591
# review flags, and the four files this weakness lives in carry only
# LockAcquire/LockRelease and ResourceReview/ResourceRelease flags --
# nothing descriptor- or cwd-named. This is a clean zero at both revisions,
# not a misread one.
#
# The one finding that lands on the advisory's own descriptor does not move
# when the fix lands: VYQL-RES-001 medium at container_linux.go:434
# (includeExecFifo, `os.OpenFile(fifoName, unix.O_PATH|unix.O_CLOEXEC, 0)`)
# reports at the parent and at :443 at the fix. It is the "opened and not
# closed inside this function" resource heuristic -- the handle is stored on
# `c.fifo` and closed in destroy() -- so it describes the adjacent leak
# shape, not the exposure across the exec boundary.
#
# No fix is available at any layer today. No source: `config.Cwd` reaches
# `unix.Chdir` at init_linux.go:294 and :331 with no label at all -- `vyql
# match` on init_linux.go lists only `os.Getenv` sources and `Close` /
# `FileUse` controls, and the `json.NewDecoder(initPipe).Decode(&config)` at
# :212 that produces initConfig is labelled `core.SafeDeserialization`, a
# control, so labelling the field would have to name runc's own struct. No
# sink: no binding labels any working-directory change anywhere in the
# corpus. The exec boundary is mislabelled rather than unlabelled --
# `system.Exec` at setns_init_linux.go:141 carries `code.SqlExecution` from
# the bare `callee.method == "Exec"` binding (sqlExecution12,
# vyql/bindings/packages/go/m39efcd29.vyql:103), which produces no finding at
# either revision. And the descriptors that actually leak are opened in the
# parent process (includeExecFifo's O_PATH fifo fd, the rootfs dirfds) and
# inherited across fork and exec; inside setns_init's own body every handle
# is closed before the Exec, so a rule pairing an exec boundary with an open
# handle cannot fire on the function that carries the bug.
#
# The one candidate anchor was measured and is ordinary code in both
# directions: a working-directory-change issue with a file-wide Getwd
# negation. Across the clone pool's Go trees, 51 files carry
# `os|unix|syscall.Chdir(` and 44 of them also carry `Getwd(`, so the shape
# fires on 7 files -- and inside runc itself that set includes
# `unix.Chdir("/")` at rootfs_linux.go:1092 and :1165, a constant target, and
# `os.Chdir(bundle)` at exec.go:213, spec.go:101 and utils.go:74. A chdir to
# a literal directory is the common case, and the negation is the whole-file
# co-membership form that combines unrelated facts by sitting in one file.
#
# No ENGINE-GAPS.md entry: the attribution half is the existing
# 1377/1389/1399 family entry, and the cwd and descriptor halves are missing
# source and sink vocabulary rather than a localised mishandled construct.
# No definition change shipped. Spec cve_rank1698 records the unguarded and
# the swept exec boundary (asserting reject VYQL-RES-001, the resource-leak
# rule whose CWE-772 class a descriptor surviving execve belongs to) and the
# chdir without and with the post-chdir verification (asserting reject
# VYQL-PATH-001): when descriptor-boundary or cwd-containment vocabulary
# lands for Go, the unguarded forms must flip to expect.

test "rank1698: setns init execs with the container-rootfs fds still open"
  lang go
  file libcontainer/setns_init_linux.go
  reject VYQL-RES-001
  code
  ```
  package libcontainer

  import (
  	"fmt"
  	"os"
  	"os/exec"

  	"github.com/opencontainers/runc/libcontainer/seccomp"
  	"github.com/opencontainers/runc/libcontainer/system"
  )

  type linuxSetnsInit struct {
  	config     *initConfig
  	dmzExe     *os.File
  	logPipe    *os.File
  	pipe       *os.File
  }

  func (l *linuxSetnsInit) Init() error {
  	// Check for the arg early to make sure it exists.
  	name, err := exec.LookPath(l.config.Args[0])
  	if err != nil {
  		return err
  	}
  	// Set seccomp as close to execve as possible.
  	if l.config.Config.Seccomp != nil && l.config.NoNewPrivileges {
  		seccompFd, err := seccomp.InitSeccomp(l.config.Config.Seccomp)
  		if err != nil {
  			return fmt.Errorf("unable to init seccomp: %w", err)
  		}
  		if err := syncParentSeccomp(l.pipe, seccompFd); err != nil {
  			return err
  		}
  	}
  	// Close the log pipe fd so the parent's ForwardLogs can exit.
  	if err := l.logPipe.Close(); err != nil {
  		return fmt.Errorf("close log pipe: %w", err)
  	}
  	if l.dmzExe != nil {
  		l.config.Args[0] = name
  		return system.Fexecve(l.dmzExe.Fd(), l.config.Args, os.Environ())
  	}
  	return system.Exec(name, l.config.Args, os.Environ())
  }
  ```

test "rank1698: the fixed revision closes everything not passed to the container first"
  lang go
  file libcontainer/setns_init_linux.go
  reject VYQL-RES-001
  code
  ```
  package libcontainer

  import (
  	"fmt"
  	"os"
  	"os/exec"

  	"github.com/opencontainers/runc/libcontainer/seccomp"
  	"github.com/opencontainers/runc/libcontainer/system"
  	"github.com/opencontainers/runc/libcontainer/utils"
  )

  type linuxSetnsInit struct {
  	config     *initConfig
  	dmzExe     *os.File
  	logPipe    *os.File
  	pipe       *os.File
  }

  func (l *linuxSetnsInit) Init() error {
  	// Check for the arg early to make sure it exists.
  	name, err := exec.LookPath(l.config.Args[0])
  	if err != nil {
  		return err
  	}
  	// Set seccomp as close to execve as possible.
  	if l.config.Config.Seccomp != nil && l.config.NoNewPrivileges {
  		seccompFd, err := seccomp.InitSeccomp(l.config.Config.Seccomp)
  		if err != nil {
  			return fmt.Errorf("unable to init seccomp: %w", err)
  		}
  		if err := syncParentSeccomp(l.pipe, seccompFd); err != nil {
  			return err
  		}
  	}
  	// Close the log pipe fd so the parent's ForwardLogs can exit.
  	if err := l.logPipe.Close(); err != nil {
  		return fmt.Errorf("close log pipe: %w", err)
  	}
  	if l.dmzExe != nil {
  		l.config.Args[0] = name
  		return system.Fexecve(l.dmzExe.Fd(), l.config.Args, os.Environ())
  	}
  	// Close all file descriptors we are not passing to the container.
  	// The execve target could use internal runc fds as the execve path,
  	// potentially giving access to binary files from the host.
  	if err := utils.UnsafeCloseFrom(l.config.PassedFilesCount + 3); err != nil {
  		return err
  	}
  	return system.Exec(name, l.config.Args, os.Environ())
  }
  ```

test "rank1698: finalizeNamespace chdirs into the image-chosen cwd unverified"
  lang go
  file libcontainer/init_linux.go
  reject VYQL-PATH-001
  code
  ```
  package libcontainer

  import (
  	"fmt"

  	"golang.org/x/sys/unix"

  	"github.com/opencontainers/runc/libcontainer/utils"
  )

  // finalizeNamespace drops the caps, sets the correct user and working
  // dir, and closes any leaked file descriptors before executing the
  // command inside the namespace.
  func finalizeNamespace(config *initConfig) error {
  	// Ensure that all unwanted fds we may have accidentally inherited
  	// are marked close-on-exec so they stay out of the container.
  	if err := utils.CloseExecFrom(config.PassedFilesCount + 3); err != nil {
  		return fmt.Errorf("error closing exec fds: %w", err)
  	}
  	// we only do chdir if it's specified
  	doChdir := config.Cwd != ""
  	if doChdir {
  		if err := unix.Chdir(config.Cwd); err != nil {
  			return fmt.Errorf("chdir to cwd (%q) set in config.json failed: %w", config.Cwd, err)
  		}
  	}
  	if err := system.ClearKeepCaps(); err != nil {
  		return fmt.Errorf("unable to clear keep caps: %w", err)
  	}
  	return nil
  }
  ```

test "rank1698: the fixed revision verifies the working directory is inside the container"
  lang go
  file libcontainer/init_linux.go
  reject VYQL-PATH-001
  code
  ```
  package libcontainer

  import (
  	"errors"
  	"fmt"
  	"path/filepath"

  	"golang.org/x/sys/unix"

  	"github.com/opencontainers/runc/libcontainer/utils"
  )

  // verifyCwd ensures that the current directory is actually inside the
  // mount namespace root of the current process. getcwd(2) prefixes
  // "(unreachable)" when the cwd escaped the mount namespace root, and
  // both glibc's getcwd(3) and Go's Getwd() surface that as ENOENT.
  func verifyCwd() error {
  	if wd, err := unix.Getwd(); errors.Is(err, unix.ENOENT) {
  		return errors.New("current working directory is outside of container mount namespace root -- possible container breakout detected")
  	} else if err != nil {
  		return fmt.Errorf("failed to verify if current working directory is safe: %w", err)
  	} else if !filepath.IsAbs(wd) {
  		return fmt.Errorf("current working directory is not absolute -- possible container breakout detected: cwd is %q", wd)
  	}
  	return nil
  }

  func finalizeNamespace(config *initConfig) error {
  	// Ensure that all unwanted fds we may have accidentally inherited
  	// are marked close-on-exec so they stay out of the container.
  	if err := utils.CloseExecFrom(config.PassedFilesCount + 3); err != nil {
  		return fmt.Errorf("error closing exec fds: %w", err)
  	}
  	// we only do chdir if it's specified
  	doChdir := config.Cwd != ""
  	if doChdir {
  		if err := unix.Chdir(config.Cwd); err != nil {
  			return fmt.Errorf("chdir to cwd (%q) set in config.json failed: %w", config.Cwd, err)
  		}
  	}
  	// Make sure our final working directory is inside the container.
  	if err := verifyCwd(); err != nil {
  		return err
  	}
  	if err := system.ClearKeepCaps(); err != nil {
  		return fmt.Errorf("unable to clear keep caps: %w", err)
  	}
  	return nil
  }
  ```
