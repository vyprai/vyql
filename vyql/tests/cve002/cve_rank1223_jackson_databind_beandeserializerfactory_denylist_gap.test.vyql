# The library-source half is still invisible and stays pinned here as the
# engine gap's isolation pair: the denylist-completeness shape a class-scope
# binding would need is cut off by the per-class token budget, which is capped
# (ENGINE-GAPS "1223"; internal/extract/lowering/lowering.go). H2O's
# SQLManager is the already-shipped pipeline for the same shape
# (VYQL-INJ-205), so padding that class with unrelated methods isolates the
# cap from anything about this CVE: 3 padding methods ahead of the check and
# it still fires, 14 and it does not.

test "rank1223: H2O's SQLManager denylist check, with 3 unrelated methods ahead of it, is still caught"
  lang java
  file h2o-core/src/main/java/water/jdbc/SQLManager.java
  expect VYQL-INJ-205
  code
  ```
  package water.jdbc;

  import java.util.List;
  import java.util.stream.Collectors;
  import java.util.stream.Stream;

  public class SQLManager {

    private static final List<String> DEFAULT_JDBC_DISALLOWED_PARAMETERS = Stream.of(
            "autoDeserialize", "queryInterceptors", "allowLoadLocalInfile", "allowMultiQueries",
            "allowLoadLocalInfileInPath", "allowUrlInLocalInfile", "allowPublicKeyRetrieval",
            "init", "script", "shutdown"
    ).map(String::toLowerCase).collect(Collectors.toList());

    public void paddingMethod0(String argOne, String argTwo, String argThree) {
        System.out.println("padding method number 0 does some unrelated logging work here");
        String local0 = argOne + argTwo + argThree;
        if (local0.length() > 3) {
            System.out.println("branch taken in padding method 0 for extra token volume");
        }
    }
    public void paddingMethod1(String argOne, String argTwo, String argThree) {
        System.out.println("padding method number 1 does some unrelated logging work here");
        String local1 = argOne + argTwo + argThree;
        if (local1.length() > 3) {
            System.out.println("branch taken in padding method 1 for extra token volume");
        }
    }
    public void paddingMethod2(String argOne, String argTwo, String argThree) {
        System.out.println("padding method number 2 does some unrelated logging work here");
        String local2 = argOne + argTwo + argThree;
        if (local2.length() > 3) {
            System.out.println("branch taken in padding method 2 for extra token volume");
        }
    }

    public static void validateJdbcUrl(String jdbcUrl) {
        for (String key : parseParameterNames(jdbcUrl)) {
            if (DEFAULT_JDBC_DISALLOWED_PARAMETERS.contains(key.toLowerCase())) {
                throw new IllegalArgumentException("Potentially dangerous JDBC parameter found: " + key);
            }
        }
    }
  }
  ```

