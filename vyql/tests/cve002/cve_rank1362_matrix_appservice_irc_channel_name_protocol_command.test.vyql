  import { Client } from "matrix-org-irc";

  export class BridgedClient {
      private client: Client;

      public joinChannel(channel: string) {
          const client = this.client;
          client.join(channel, () => {
              this.log.debug("Joined %s", channel);
          });
      }
  }
  ```
  file src/provisioning/Provisioner.ts
  reject VYQL-INJ-245
  code
  ```
  import { BridgedClient } from "../irc/BridgedClient";

  export class Provisioner {
      public async requestLink(req: ProvisioningRequest) {
          const body = req.body as unknown;
          const raw = body.remote_room_channel;
          const ircChannel = raw.replace(/[\s\r\n\0,]/g, "");
          const botClient = await this.ircBridge.getBotClient(this.server);
          await botClient.joinChannel(ircChannel);
      }
  }
  ```

test "rank1362 matrix-appservice-irc: the anchored allowlist the fixed revision adds sits behind a named predicate and does not reject"
  lang javascript
  file package.json
  code
  ```
  {
    "name": "matrix-appservice-irc",
    "dependencies": {
      "matrix-org-irc": "^2.0.1",
      "matrix-appservice-bridge": "^9.0.0"
    }
  }
  ```
  file src/models/IrcRoom.ts
  code
  ```
  export function validateChannelName(channel: string) {
      // According to https://www.rfc-editor.org/rfc/rfc1459#section-1.3
      return /^#([^\s\cG,]){1,199}$/.test(channel);
  }
  ```
  file src/irc/BridgedClient.ts
  code
  ```
  import { Client } from "matrix-org-irc";

  export class BridgedClient {
      private client: Client;

      public joinChannel(channel: string) {
          const client = this.client;
          client.join(channel, () => {
              this.log.debug("Joined %s", channel);
          });
      }
  }
  ```
  file src/provisioning/Provisioner.ts
  expect VYQL-INJ-245
  code
  ```
  import { validateChannelName } from "../models/IrcRoom";
  import { BridgedClient } from "../irc/BridgedClient";

  export class Provisioner {
      public async requestLink(req: ProvisioningRequest) {
          const body = req.body as unknown;
          const ircChannel = body.remote_room_channel;

          if (!validateChannelName(ircChannel)) {
              throw new Error("Channel name isn't valid");
          }

          const botClient = await this.ircBridge.getBotClient(this.server);
          await botClient.joinChannel(ircChannel);
      }
  }
  ```
