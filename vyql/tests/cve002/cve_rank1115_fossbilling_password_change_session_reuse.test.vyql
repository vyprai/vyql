# Rank 1115 / CVE-2023-4005: FOSSBilling's password-change endpoint verifies
# the current password and updates it, but leaves every other active session
# for that account untouched, so a stolen session stays valid after the change
# (CWE-613).
#
# ATTENTION: vocabulary gap. MissingSessionRotationAfterAuthentication is
# written for login-time session rotation (CWE_384), not a credential-change
# endpoint that fails to invalidate sibling sessions.
#
# verify_current_expected: attention-vocabulary-gap, both revisions rejected.

test "rank1115: the password is changed and no session is touched"
  lang php
  file src/modules/Profile/Api/Client.php
  reject_review code.MissingSessionRotationAfterAuthentication
  code
  ```
  class Client extends \Api_Abstract
  {
      public function change_password($data)
      {
          $client = $this->getIdentity();

          if (!$this->di['password']->verify($data['current_password'], $client->pass)) {
              throw new \Exception('Current password incorrect');
          }

          return $this->getService()->changeClientPassword($client, $data['new_password']);
      }
  }
  ```

test "rank1115: existing sessions are invalidated before the password is changed"
  lang php
  file src/modules/Profile/Api/Client.php
  reject_review code.MissingSessionRotationAfterAuthentication
  code
  ```
  class Client extends \Api_Abstract
  {
      public function change_password($data)
      {
          $client = $this->getIdentity();

          if (!$this->di['password']->verify($data['current_password'], $client->pass)) {
              throw new \Exception('Current password incorrect');
          }

          $this->getService()->invalidateSessions();
          return $this->getService()->changeClientPassword($client, $data['new_password']);
      }
  }
  ```
