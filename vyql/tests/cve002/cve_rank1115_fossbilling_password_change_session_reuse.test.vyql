# Rank 1115 / CVE-2023-4005: FOSSBilling's self-service password change
# verified the caller's current password and stored the new one, but left
# every other active session for the account untouched, so a session an
# attacker had already stolen stayed valid after the legitimate user secured
# the account by changing its password (CWE-613).
#
# Client::change_password in src/modules/Profile/Api/Client.php (and the
# staff twin Admin::change_password in src/modules/Profile/Api/Admin.php)
# read current_password and new_password from the request, checked the
# current password against the stored hash through the password service, and
# delegated the credential write to Service::changeClientPassword() — with
# nothing anywhere in the flow that touched a session record. The fix adds
# Service::invalidateSessions(), which walks the session table, decodes each
# row to check whether it belongs to the account, and deletes the matches,
# and calls it from both self-service endpoints (and the admin-forced
# change) before the password update runs, plus a destroy_sessions API
# action a user can call directly.
#
# Detection reads the flow through PHP's own vocabulary: the endpoint name
# and the current_password field (Laravel documents it as "must match the
# user's current password") establish an authenticated password change, the
# capital-P Password call is the delegated credential write, and the
# negation is the vocabulary a revocation control is spelled with —
# session_destroy() / session_regenerate_id() in the core, a
# destroy/invalidate/regenerate on a framework session object, a logout, an
# invalidateSession*/revoke* sweep, or a stored token-version /
# password-changed timestamp. Measured on the real checkout, three
# --cache off runs per revision: 2/2/2 findings at the parent
# (Profile/Api/Client.php:107 and Profile/Api/Admin.php:102, the CVE's own
# two functions) against 0/0/0 at the fix. Clearing session data with
# flush() alone is deliberately not accepted as a control — flush empties
# the session but does not rotate or destroy it.
#
# Variants pin what the discrimination rests on: a control spelled with the
# core session_regenerate_id(true) instead of the fix's own invalidateSessions
# also reports zero, so the clause reads a control vocabulary rather than
# this commit's layout, and a comment naming invalidateSessions() inside the
# vulnerable function leaves it reporting, since these tokens are
# AST-derived. The reachable set outside this repository is empty: across
# the clone corpus no other PHP function pairs a change_password name with a
# current_password read.

test "rank1115: the password is changed and no session is touched"
  lang php
  file src/modules/Profile/Api/Client.php
  expect VYQL-AUTH-141
  expect_review code.PasswordChangeWithoutSessionInvalidation
  code
  ```
  <?php

  class Client extends \Api_Abstract
  {
      public function change_password($data)
      {
          $client = $this->getIdentity();

          if (!$this->di['password']->verify($data['current_password'], $client->pass)) {
              throw new \Exception('Current password incorrect');
          }

          return $this->getService()->changeClientPassword($client, $data['new_password']);
      }
  }
  ```

test "rank1115: existing sessions are invalidated before the password is changed"
  lang php
  file src/modules/Profile/Api/Client.php
  reject VYQL-AUTH-141
  reject_review code.PasswordChangeWithoutSessionInvalidation
  code
  ```
  <?php

  class Client extends \Api_Abstract
  {
      public function change_password($data)
      {
          $client = $this->getIdentity();

          if (!$this->di['password']->verify($data['current_password'], $client->pass)) {
              throw new \Exception('Current password incorrect');
          }

          $this->getService()->invalidateSessions();
          return $this->getService()->changeClientPassword($client, $data['new_password']);
      }
  }
  ```

test "rank1115: the session id is rotated before the password is changed"
  lang php
  file src/modules/Profile/Api/Client.php
  reject VYQL-AUTH-141
  reject_review code.PasswordChangeWithoutSessionInvalidation
  code
  ```
  <?php

  class Client extends \Api_Abstract
  {
      public function change_password($data)
      {
          $client = $this->getIdentity();

          if (!$this->di['password']->verify($data['current_password'], $client->pass)) {
              throw new \Exception('Current password incorrect');
          }

          session_regenerate_id(true);
          return $this->getService()->changeClientPassword($client, $data['new_password']);
      }
  }
  ```
