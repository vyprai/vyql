test "rank1879: a this store in one method does not reach the sibling that renders it"
  lang php
  file self-sibling.php
  reject VYQL-INJ-004
  code
  ```
  <?php

  class TypoScriptFrontendController
  {
      public $absRefPrefix = '';
      public $content = '<a href="_assets/x.css">';

      public function process()
      {
          $this->absRefPrefix = ($_SERVER['ORIG_PATH_INFO'] ?? '') ?: ($_SERVER['PATH_INFO'] ?? '');
          $this->setAbsRefPrefix();
      }

      public function setAbsRefPrefix()
      {
          $replace = [
              '"' . $this->absRefPrefix . '_assets/',
          ];
          $this->content = str_replace(['"_assets/'], $replace, $this->content);
          echo $this->content;
      }
  }

  $controller = new TypoScriptFrontendController();
  $controller->process();
  ```

test "rank1879: the escaped prefix stays off the content write"
  lang php
  file local-object-escaped.php
  reject VYQL-INJ-004
  code
  ```
  <?php

  class NormalizedParams
  {
      public $scriptName = '';
  }

  $params = new NormalizedParams();
  $params->scriptName = ($_SERVER['ORIG_PATH_INFO'] ?? '') ?: ($_SERVER['PATH_INFO'] ?? '');
  $encodedAbsRefPrefix = htmlspecialchars($params->scriptName, ENT_QUOTES | ENT_HTML5);
  echo '<base href="' . $encodedAbsRefPrefix . '">';
  ```

test "rank1879: a fully-qualified static call does not resolve"
  lang php
  file static-fqcn.php
  reject VYQL-INJ-004
  code
  ```
  <?php

  declare(strict_types=1);

  namespace Vendor\Project;

  class NormalizedParams
  {
      public static function determineScriptName(): string
      {
          return ($_SERVER['ORIG_PATH_INFO'] ?? '') ?: ($_SERVER['PATH_INFO'] ?? '');
      }
  }

  namespace Other;

  class Page
  {
      public function process()
      {
          $s = \Vendor\Project\NormalizedParams::determineScriptName();
          echo '<base href="' . $s . '">';
      }
  }
  ```

