  <?php

  class TypoScriptFrontendController
  {
      public $absRefPrefix = '';
      public $content = '<a href="_assets/x.css">';

      public function process()
      {
          $this->absRefPrefix = ($_SERVER['ORIG_PATH_INFO'] ?? '') ?: ($_SERVER['PATH_INFO'] ?? '');
          $this->setAbsRefPrefix();
      }

      public function setAbsRefPrefix()
      {
          $replace = [
              '"' . $this->absRefPrefix . '_assets/',
          ];
          $this->content = str_replace(['"_assets/'], $replace, $this->content);
          echo $this->content;
      }
  }

  $controller = new TypoScriptFrontendController();
  $controller->process();
