  class NormalizedParams
  {
      public $scriptName = '';

      public function determine()
      {
          $this->scriptName = ($_SERVER['ORIG_PATH_INFO'] ?? '') ?: ($_SERVER['PATH_INFO'] ?? '');
          echo '<base href="' . $this->scriptName . '">';
      }
  }

  $params = new NormalizedParams();
  $params->determine();
