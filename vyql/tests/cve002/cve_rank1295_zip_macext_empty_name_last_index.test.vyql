test "rank1295: a first-byte emptiness check stands in for a count guard"
  lang c
  file archive_write_set_format_zip.c
  reject VYQL-MEM-041
  reject_review code.ZeroCountLastElementAccess
  code
  ```
  #include <stddef.h>

  size_t zip_path_length(const char *path, unsigned type) {
      size_t len;

      if (path == NULL)
          return (0);
      len = strlen(path);
      if (type == 0x4000 && (path[0] == '\0' || path[len - 1] != '/'))
          ++len; /* Space for the trailing / */
      return len;
  }
  ```

test "rank1295: a count defined as strlen plus one is nonzero by construction"
  lang c
  file bsdunzip.c
  reject VYQL-MEM-041
  reject_review code.ZeroCountLastElementAccess
  code
  ```
  #include <stddef.h>
  #include <stdlib.h>
  #include <string.h>

  char *unzip_makepath(const char *prefix, const char *path) {
      char *str;
      size_t prelen, len;

      prelen = prefix ? strlen(prefix) + 1 : 0;
      len = strlen(path) + 1;
      if ((str = malloc(prelen + len)) == NULL) {
          return (NULL);
      }
      if (prefix) {
          memcpy(str, prefix, prelen);  /* includes zero */
          str[prelen - 1] = '/';        /* splat zero */
      }
      memcpy(str + prelen, path, len);  /* includes zero */

      return (str);
  }
  ```
