test "rank1789: the same arms in statement position expose the arm boundary"
  lang rust
  file crates/imap-proto/src/receiver.rs
  reject VYQL-DOS-042
  code
  ```
  const QUOTED_ARG_MAX_LEN: usize = 4096;

  enum State {
      Argument { last_ch: u8 },
      ArgumentQuoted { escaped: bool },
  }

  struct Receiver {
      buf: Vec<u8>,
      state: State,
  }

  impl Receiver {
      fn error_reset(&mut self, _: &str) -> Error {
          self.buf.clear();
          Error::TooLong
      }

      // The identical arm structure with the match in statement position and
      // no enclosing loop: this is the form the solver already gives nested
      // regions to, and the form on which a dominance-suppressed accumulation
      // rule separates the unguarded arm from the bounded ones.
      pub fn parse(&mut self, ch: u8) -> Result<(), Error> {
          match self.state.clone() {
              State::ArgumentQuoted { escaped } => match ch {
                  b'"' => {
                      if !escaped {
                          self.buf.clear();
                          self.state = State::Argument { last_ch: b' ' };
                      } else if self.buf.len() < QUOTED_ARG_MAX_LEN {
                          self.buf.push(ch);
                          self.state = State::ArgumentQuoted { escaped: false };
                      } else {
                          return Err(self.error_reset("Quoted argument too long."));
                      }
                  }
                  b'\\' => {
                      if escaped {
                          self.buf.push(ch);
                      }
                      self.state = State::ArgumentQuoted { escaped: !escaped };
                  }
                  b'\n' => {
                      return Err(self.error_reset("Unterminated quoted argument."));
                  }
                  _ => {
                      if self.buf.len() < QUOTED_ARG_MAX_LEN {
                          if escaped {
                              self.buf.push(b'\\');
                          }
                          self.buf.push(ch);
                          self.state = State::ArgumentQuoted { escaped: false };
                      } else {
                          return Err(self.error_reset("Quoted argument too long."));
                      }
                  }
              },
              _ => {}
          }
          Ok(())
      }
  }

  enum Error {
      TooLong,
  }
  ```

