# Rank 1341 / CVE-2026-1114: lollms' backend/config.py read its JWT signing
# key as
#
#   SECRET_KEY = get_env_var("SECRET_KEY", "a_very_secret_key_that_should_be_changed_for_production")
#
# and backend/security.py signed and verified every application token with it
# (`jwt.encode(to_encode, SECRET_KEY, algorithm=ALGORITHM)`,
# `jwt.decode(token, SECRET_KEY, algorithms=[ALGORITHM])`). Any deployment that
# did not set SECRET_KEY in its environment therefore signed with a key printed
# in the public source tree, so an attacker could resign a token with
# `is_admin`/`sub` of their choosing and be admitted as the administrator
# (CWE-798, CWE-321, CWE-284). The fixed revision adds _ensure_secure_secret_key(), which
# rotates a missing or known-weak key to secrets.token_urlsafe(32) before the
# module reads it, and drops the literal fallback from the get_env_var call.
#
The fixing revision is
# f577838da1dc1654f89754252e762f8483a75a1a
# ("feat(security): auto-rotate and generate secure SECRET_KEY"), which the
# spec is written against.
#
# The construct the engine missed is the env-getter wrapper. lowering.go's
# envDefaultConst unwraps the fallback literal baked into an
# `os.getenv(name, default)` / `os.environ.get(name, default)` /
# `config.get(name, default)` read, which is what lets a secret-named target
# assigned such a read reach analysis.secret.hardcoded and VYQL-AUTH-101. It
# recognised the three stdlib spellings only, and applications almost always
# wrap them in a helper of their own — lollms' get_env_var(key, default,
# cast_type) casts and swallows ValueError in one place — so the fallback went
# unseen even though it is just as baked into the source. envDefaultConst now
# also accepts a callee whose final segment names the environment
# (`get_env_var`, `env`, `read_env`), keeping the two-argument requirement: the
# second argument is the default in every such (key, default) accessor.
#
# The name and value guards are untouched, which is where this check's
# precision lives: the target still has to be secret-named
# (secretNamedTarget's secret/jwt/hmac/api_key/signing-key family) and the
# default still has to be a non-trivial literal (plausibleSecretLiteral, six
# characters and not None/true/false), and the file still has to not be a
# test or seed file. The last two cases below pin both halves of that.
#
# VYQL-CFG-022 reports code.WeakJwtSecret at security.py:89 and :428 on
# this checkout, but it does so at both revisions — its Python binding is a
# presence predicate over `node.context.callArg` matching the *name*
# SECRET_KEY, not the key's value — so it does not discriminate this fix. The
# hardcoded default in config.py is the line the fixed revision removes.

test "rank1341: lollms config.py reads its JWT signing key through get_env_var with a literal fallback"
  lang python
  file backend/config.py
  expect VYQL-AUTH-101
  code
  ```
  import os
  from pathlib import Path


  def get_env_var(key, default, cast_type=str):
      """Gets an environment variable and casts it to the desired type."""
      value = os.environ.get(key, default)
      try:
          if cast_type == bool:
              if isinstance(value, bool):
                  return value
              return str(value).lower() in ('true', '1', 'yes', 'on')
          if cast_type == int and value is not None:
              return int(value)
          return cast_type(value) if value is not None else default
      except (ValueError, TypeError):
          return default


  PROJECT_ROOT = Path(__file__).resolve().parent.parent
  APP_DATA_DIR = PROJECT_ROOT / get_env_var("APP_DATA_DIR", "data")

  APP_DB_URL = get_env_var("DATABASE_URL", f"sqlite:///{APP_DATA_DIR / 'app_main.db'}")
  SECRET_KEY = get_env_var("SECRET_KEY", "a_very_secret_key_that_should_be_changed_for_production")
  ```

test "rank1341: lollms rotates a weak or missing key and reads SECRET_KEY with no fallback"
  lang python
  file backend/config.py
  reject VYQL-AUTH-101
  code
  ```
  import os
  import re
  import secrets
  from pathlib import Path


  def get_env_var(key, default, cast_type=str):
      """Gets an environment variable and casts it to the desired type."""
      value = os.environ.get(key, default)
      try:
          return cast_type(value) if value is not None else default
      except (ValueError, TypeError):
          return default


  def _ensure_secure_secret_key():
      """Replaces a weak or missing SECRET_KEY with a generated one."""
      weak_keys = [
          "changeme",
          "a_very_secret_key_that_should_be_changed_for_production",
          "a_very_secret_key_for_flask_sessions_or_jwt",
      ]
      current_key = os.environ.get("SECRET_KEY", "")
      if not current_key or current_key in weak_keys:
          new_key = secrets.token_urlsafe(32)
          os.environ["SECRET_KEY"] = new_key


  _ensure_secure_secret_key()

  APP_DB_URL = get_env_var("DATABASE_URL", "sqlite:///app_main.db")
  SECRET_KEY = get_env_var("SECRET_KEY", "")
  ```

# The isolating pair for the construct, naming no lollms API: the same
# secret-named target and the same fallback literal, read once through the
# stdlib accessor envDefaultConst unwrapped and once through a
# two-argument wrapper of it.

test "rank1341: a secret-named target defaults to a literal from the stdlib environment accessor"
  lang python
  file settings.py
  expect VYQL-AUTH-101
  code
  ```
  import os

  JWT_SIGNING_SECRET = os.environ.get("JWT_SIGNING_SECRET", "please-change-this-in-production")
  ```

test "rank1341: the same secret-named target defaults to the same literal through an env-getter wrapper"
  lang python
  file settings.py
  expect VYQL-AUTH-101
  code
  ```
  import os


  def read_env(key, default):
      return os.environ.get(key, default)


  JWT_SIGNING_SECRET = read_env("JWT_SIGNING_SECRET", "please-change-this-in-production")
  ```

# Both guards the wrapper form still has to clear. Widening which callees
# envDefaultConst unwraps must not widen which targets or which literals
# count, or every application's `get_env_var("HOST", "localhost")` becomes a
# hardcoded secret.

test "rank1341: an ordinary setting read through the same wrapper is not a secret"
  lang python
  file settings.py
  reject VYQL-AUTH-101
  code
  ```
  import os


  def read_env(key, default):
      return os.environ.get(key, default)


  PUBLIC_DOMAIN_NAME = read_env("PUBLIC_DOMAIN_NAME", "lollms.example.com")
  DATABASE_URL = read_env("DATABASE_URL", "sqlite:///app_main.db")
  ```

test "rank1341: a secret-named target whose wrapper default is empty holds no secret"
  lang python
  file settings.py
  reject VYQL-AUTH-101
  code
  ```
  import os


  def read_env(key, default):
      return os.environ.get(key, default)


  JWT_SIGNING_SECRET = read_env("JWT_SIGNING_SECRET", "")
  API_KEY = read_env("API_KEY", None)
  ```
