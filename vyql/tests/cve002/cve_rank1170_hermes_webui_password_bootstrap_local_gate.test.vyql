# Rank 1170 / CVE-2026-49973: hermes-webui's `/api/settings` route is
# intentionally reachable without a session while auth is disabled, so a
# first-run install can set its own password from the browser. Setting
# `_set_password` there does two things at once: it hashes the password and
# it decides who owns the instance, because the next login uses whatever
# hash won the race. api/routes.py's `handle_post` -- one function serving
# every POST route -- read the request body's `_set_password` on the
# `/api/settings` branch and, whenever auth was not yet enabled, called
# `save_settings(body)` unconditionally, with no check on where the request
# came from. Any remote client that reached the instance before its real
# owner opened the setup page could win first-run ownership by POSTing
# `_set_password` first (CWE-306). The fix (f2ef285, inside pool merge
# 1126e541) gates that one branch the same way the file already gates
# onboarding setup: unless the caller is loopback or private
# (`_onboarding_request_is_local`, via
# ipaddress.ip_address(...).is_loopback / .is_private) or the operator
# opted in with HERMES_WEBUI_ONBOARDING_OPEN=1, first-password bootstrap
# returns 403 before save_settings runs.
#
# ATTENTION, re-confirmed on a second pass; the blocker is sharper than a
# missing control concept. Rule VYQL-AUTH-176 now judges
# code.PrivilegedEntryPointReview (the concept is no longer inert), but no
# Python binding emits it, and none could separate these two revisions:
# measured with three cache-off runs per revision over api/routes.py, the
# finding sets are byte-identical -- 42 findings each, the same rule at the
# same line in every run, and zero difference between the vulnerable and
# fixed unions (the full tree aborts at the 6GB --max-ram ceiling, and the
# api/ directory alone exceeds timeout 180, so the file that carries the
# fix is the measurable scope). The only in-function artifacts the fix adds
# are a call to the project-private helper `_onboarding_gate_allows` -- a
# token already present in `handle_post`'s context at both revisions,
# because the onboarding branches of the same function call the same helper
# four times before the fix -- and the fix's own error-message literal.
# Keying on either fails the genericity test: there is no documentation
# anchor for a private helper's name, and the message string is the fixing
# commit's own layout.
#
# A control concept for the network-origin idiom (ipaddress is_loopback /
# is_private) would not close this either, because the idiom pre-exists the
# fix in a sibling function (`_onboarding_request_is_local`, labelled
# core.UserControlledData at both revisions by the generated ipaddress
# package binding), and no guard relation can see it from the sink: the
# engine's `endpoint coveredBy` fallback requires the control's function
# context to be the sink's own function, `dominates coveredBy` requires a
# CFG node that dominates the sink, and `sameScope coveredBy` requires an
# ancestor lexical scope -- a sibling helper satisfies none of them, so a
# rule requiring the control reports both revisions identically. This is
# the Python instance of the delegated-check attribution family (1364 Rust,
# 1372 JavaScript, 1394 PHP) with a stronger requirement: because the
# handler already calls the gate helper for sibling routes, one-hop
# attribution of the callee's facts to the caller's context still reads the
# gate as present at both revisions; only path-sensitive attribution --
# stamping the dominating call site itself so `dominates coveredBy` can
# use it -- separates them. That is engine design work, recorded against
# the family, not a binding.
#
# verify_current_expected: attention-missing-control-concept

test "rank1170: unauthenticated first-run password bootstrap has no origin gate"
  lang python
  file api/routes.py
  reject_review code.PrivilegedEntryPointReview
  code
  ```
  import ipaddress
  import os


  def _truthy_env(name):
      return os.getenv(name, "").strip().lower() in ("1", "true", "yes", "on")


  def _onboarding_request_is_local(handler):
      host = handler.client_address[0]
      addr = ipaddress.ip_address(host)
      return bool(addr.is_loopback or addr.is_private)


  def _onboarding_gate_allows(handler):
      from api.auth import is_auth_enabled

      if is_auth_enabled() or _truthy_env("HERMES_WEBUI_ONBOARDING_OPEN"):
          return True
      return _onboarding_request_is_local(handler)


  def bad(handler, message, code):
      handler.send_response(code)
      return True


  def j(handler, payload):
      handler.send_response(200)
      return True


  def handle_post(handler, parsed):
      body = read_body(handler)

      if parsed.path == "/api/onboarding/start":
          if not _onboarding_gate_allows(handler):
              return bad(handler, "Onboarding is only available from local networks.", 403)
          return j(handler, {"ok": True})

      if parsed.path == "/api/settings":
          from api.auth import is_auth_enabled

          auth_enabled_before = is_auth_enabled()
          requested_password = bool(
              isinstance(body.get("_set_password"), str)
              and body.get("_set_password", "").strip()
          )

          saved = save_settings(body)
          return j(handler, saved)
  ```

test "rank1170: the fixed revision gates first-run bootstrap to loopback/private callers"
  lang python
  file api/routes.py
  reject_review code.PrivilegedEntryPointReview
  code
  ```
  import ipaddress
  import os


  def _truthy_env(name):
      return os.getenv(name, "").strip().lower() in ("1", "true", "yes", "on")


  def _onboarding_request_is_local(handler):
      host = handler.client_address[0]
      addr = ipaddress.ip_address(host)
      return bool(addr.is_loopback or addr.is_private)


  def _onboarding_gate_allows(handler, auth_enabled=None):
      from api.auth import is_auth_enabled

      auth_enabled = is_auth_enabled() if auth_enabled is None else auth_enabled
      if auth_enabled or _truthy_env("HERMES_WEBUI_ONBOARDING_OPEN"):
          return True
      return _onboarding_request_is_local(handler)


  def bad(handler, message, code):
      handler.send_response(code)
      return True


  def j(handler, payload):
      handler.send_response(200)
      return True


  def handle_post(handler, parsed):
      body = read_body(handler)

      if parsed.path == "/api/onboarding/start":
          if not _onboarding_gate_allows(handler):
              return bad(handler, "Onboarding is only available from local networks.", 403)
          return j(handler, {"ok": True})

      if parsed.path == "/api/settings":
          from api.auth import is_auth_enabled

          auth_enabled_before = is_auth_enabled()
          requested_password = bool(
              isinstance(body.get("_set_password"), str)
              and body.get("_set_password", "").strip()
          )

          if requested_password and not auth_enabled_before:
              if not _onboarding_gate_allows(handler, auth_enabled_before):
                  return bad(
                      handler,
                      "First password setup is only available from local networks when auth is not enabled.",
                      403,
                  )

          saved = save_settings(body)
          return j(handler, saved)
  ```
