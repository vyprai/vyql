# Rank 1170 / CVE-2026-49973: hermes-webui's `/api/settings` route is
# intentionally reachable without a session while auth is disabled, so a
# first-run install can set its own password from the browser. Setting
# `_set_password` there does two things at once: it hashes the password and
# it decides who owns the instance, because the next login uses whatever
# hash won this race. api/routes.py's settings handler read the request
# body's `_set_password` and, whenever auth was not yet enabled, called
# save_settings(body) unconditionally -- no check on where the request came
# from. Any remote client that reached the instance before its real owner
# opened the setup page could win first-run ownership by POSTing
# `_set_password` first (CWE-306).
#
# The fix, PR #3964 (merge 1126e54132, real change f2ef285), gates that one
# branch the same way the file already gates onboarding setup: unless the
# caller is loopback or private (`_onboarding_request_is_local`, via
# ipaddress.ip_address(...).is_loopback/is_private) or the operator opted in
# with HERMES_WEBUI_ONBOARDING_OPEN=1, first-password bootstrap now returns
# 403 before save_settings ever runs. Normal authenticated password changes
# are unaffected because the gate only applies while auth is not yet
# enabled.
#
# ATTENTION, missing control concept. vyql match on both revisions labels
# nothing at the branch that matters: no source resolves through the hand-
# rolled read_body()/save_settings() path to the hashing call in this
# reduced form, and the one rule that does reach save_settings on the real
# checkout (VYQL-AUTH-099, mass assignment on the settings dict) fires
# identically before and after the fix, because save_settings' field
# handling did not change -- it is a real but unrelated finding, not this
# CVE.
#
# The missing piece is not a source or a sink, both of which already exist
# generically (core.UserControlledData for the request body,
# code.StateChangingOpSink already covers change_password/reset_password-
# style calls and could be extended to the hashlib.pbkdf2_hmac call
# _hash_password wraps). It is the control. Every existing "unless ...
# coveredBy" clause for this shape checks core.AuthenticationCheck, and
# that is the wrong property here: the fixed code is still, by design, not
# behind an authentication check on this branch -- the whole point of a
# first-run bootstrap route is that it runs before auth exists. What the
# fix adds is a network-origin gate (loopback/private-only, escape-hatched
# by an explicit env var), which is a different control than "was the
# caller authenticated" and has no concept to bind to. A rule written
# against core.AuthenticationCheck would reject the patched form exactly
# like the vulnerable one, which is worse than reporting nothing, because
# it would look like coverage while never separating the two revisions.
#
# code.PrivilegedEntryPointReview (CWE_862, vulnerableTo
# access_control.MissingAuthorization) is the closest existing concept,
# but it is not bound in Python at all yet -- only C and PHP -- and even a
# Python binding would not close this alone, because its review expects
# core.AuthorizationCheck, the same wrong property. Closing this rank and
# the weakness class it represents needs a new check concept, something
# like core.LocalOriginCheck, bound to the network-origin idiom
# (ipaddress.ip_address(...).is_loopback / .is_private, client-address
# allowlists) across languages, before a rule can require it ahead of a
# credential-bootstrap sink.
#
# verify_current_expected: attention-missing-control-concept

test "rank1170: unauthenticated first-run password bootstrap has no origin gate"
  lang python
  file api/routes.py
  reject_review code.PrivilegedEntryPointReview
  code
  ```
  import ipaddress
  import os


  def _truthy_env(name):
      return os.getenv(name, "").strip().lower() in ("1", "true", "yes", "on")


  def _onboarding_request_is_local(handler):
      host = handler.client_address[0]
      addr = ipaddress.ip_address(host)
      return bool(addr.is_loopback or addr.is_private)


  def _onboarding_gate_allows(handler):
      from api.auth import is_auth_enabled

      if is_auth_enabled() or _truthy_env("HERMES_WEBUI_ONBOARDING_OPEN"):
          return True
      return _onboarding_request_is_local(handler)


  def save_settings(settings):
      raw_pw = settings.pop("_set_password", None)
      if raw_pw and isinstance(raw_pw, str) and raw_pw.strip():
          from api.auth import _hash_password

          current = load_settings()
          current["password_hash"] = _hash_password(raw_pw.strip())
          write_settings(current)
      return settings


  def handle_post(handler, parsed, body):
      from api.auth import is_auth_enabled

      if parsed.path == "/api/settings":
          auth_enabled_before = is_auth_enabled()
          requested_password = bool(
              isinstance(body.get("_set_password"), str)
              and body.get("_set_password", "").strip()
          )

          saved = save_settings(body)
          return j(handler, saved)
  ```

test "rank1170: the fix gates first-run bootstrap to loopback/private callers"
  lang python
  file api/routes.py
  reject_review code.PrivilegedEntryPointReview
  code
  ```
  import ipaddress
  import os


  def _truthy_env(name):
      return os.getenv(name, "").strip().lower() in ("1", "true", "yes", "on")


  def _onboarding_request_is_local(handler):
      host = handler.client_address[0]
      addr = ipaddress.ip_address(host)
      return bool(addr.is_loopback or addr.is_private)


  def _onboarding_gate_allows(handler, auth_enabled=None):
      from api.auth import is_auth_enabled

      auth_enabled = is_auth_enabled() if auth_enabled is None else auth_enabled
      if auth_enabled or _truthy_env("HERMES_WEBUI_ONBOARDING_OPEN"):
          return True
      return _onboarding_request_is_local(handler)


  def save_settings(settings):
      raw_pw = settings.pop("_set_password", None)
      if raw_pw and isinstance(raw_pw, str) and raw_pw.strip():
          from api.auth import _hash_password

          current = load_settings()
          current["password_hash"] = _hash_password(raw_pw.strip())
          write_settings(current)
      return settings


  def handle_post(handler, parsed, body):
      from api.auth import is_auth_enabled

      if parsed.path == "/api/settings":
          auth_enabled_before = is_auth_enabled()
          requested_password = bool(
              isinstance(body.get("_set_password"), str)
              and body.get("_set_password", "").strip()
          )

          if requested_password and not auth_enabled_before:
              if not _onboarding_gate_allows(handler, auth_enabled_before):
                  return bad(
                      handler,
                      "First password setup is only available from local networks when auth is not enabled.",
                      403,
                  )

          saved = save_settings(body)
          return j(handler, saved)
  ```
