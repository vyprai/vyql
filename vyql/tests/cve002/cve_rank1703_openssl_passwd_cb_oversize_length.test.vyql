      pub type c_int = i32;
      pub type c_void = u8;
  }
  ```

test "rank1703: rust trampoline bounding the returned length with an if-condition"
  lang rust
  file openssl/src/util.rs
  reject VYQL-MEM-064
  code
  ```
  use std::panic::{self, AssertUnwindSafe};

  pub struct CallbackState<F> {
      pub cb: Option<F>,
      pub panic_slot: Option<Box<dyn std::any::Any + Send + 'static>>,
  }

  pub unsafe extern "C" fn invoke_passwd_cb<F>(
      buf: *mut libc::c_char,
      size: libc::c_int,
      _rwflag: libc::c_int,
      cb_state: *mut libc::c_void,
  ) -> libc::c_int
  where
      F: FnOnce(&mut [u8]) -> Result<usize, ErrorStack>,
  {
      let callback = &mut *(cb_state as *mut CallbackState<F>);

      let result = panic::catch_unwind(AssertUnwindSafe(|| {
          let pass_slice = std::slice::from_raw_parts_mut(buf as *mut u8, size as usize);
          callback.cb.take().unwrap()(pass_slice)
      }));

      match result {
          Ok(Ok(len)) => {
              if len > size as usize {
                  0
              } else {
                  len as libc::c_int
              }
          }
          Ok(Err(_)) => 0,
          Err(err) => {
              callback.panic_slot = Some(err);
              0
          }
      }
  }

  pub struct ErrorStack;
  pub mod libc {
      pub type c_char = i8;
      pub type c_int = i32;
      pub type c_void = u8;
  }
  ```

test "rank1703: rust trampoline with the bound only in a comment"
  lang rust
  file openssl/src/util.rs
  expect VYQL-MEM-064
  code
  ```
  use std::panic::{self, AssertUnwindSafe};

  pub struct CallbackState<F> {
      pub cb: Option<F>,
      pub panic_slot: Option<Box<dyn std::any::Any + Send + 'static>>,
  }

  pub unsafe extern "C" fn invoke_passwd_cb<F>(
      buf: *mut libc::c_char,
      size: libc::c_int,
      _rwflag: libc::c_int,
      cb_state: *mut libc::c_void,
  ) -> libc::c_int
  where
      F: FnOnce(&mut [u8]) -> Result<usize, ErrorStack>,
  {
      let callback = &mut *(cb_state as *mut CallbackState<F>);

      let result = panic::catch_unwind(AssertUnwindSafe(|| {
          let pass_slice = std::slice::from_raw_parts_mut(buf as *mut u8, size as usize);
          callback.cb.take().unwrap()(pass_slice)
      }));

      match result {
          // callers must return len > size as usize as an error
          Ok(Ok(len)) => len as libc::c_int,
          Ok(Err(_)) => 0,
          Err(err) => {
              callback.panic_slot = Some(err);
              0
          }
      }
  }

  pub struct ErrorStack;
  pub mod libc {
      pub type c_char = i8;
      pub type c_int = i32;
      pub type c_void = u8;
  }
  ```

test "rank1703: rust trampoline beside a sibling function carrying the comparison"
  lang rust
  file openssl/src/util.rs
  expect VYQL-MEM-064
  code
  ```
  use std::panic::{self, AssertUnwindSafe};

  pub struct CallbackState<F> {
      pub cb: Option<F>,
      pub panic_slot: Option<Box<dyn std::any::Any + Send + 'static>>,
  }

  pub unsafe extern "C" fn invoke_passwd_cb<F>(
      buf: *mut libc::c_char,
      size: libc::c_int,
      _rwflag: libc::c_int,
      cb_state: *mut libc::c_void,
  ) -> libc::c_int
  where
      F: FnOnce(&mut [u8]) -> Result<usize, ErrorStack>,
  {
      let callback = &mut *(cb_state as *mut CallbackState<F>);

      let result = panic::catch_unwind(AssertUnwindSafe(|| {
          let pass_slice = std::slice::from_raw_parts_mut(buf as *mut u8, size as usize);
          callback.cb.take().unwrap()(pass_slice)
      }));

      match result {
          Ok(Ok(len)) => len as libc::c_int,
          Ok(Err(_)) => 0,
          Err(err) => {
              callback.panic_slot = Some(err);
              0
          }
      }
  }

  fn bounded_elsewhere(a: usize, b: usize) -> bool {
      a > b
  }

  pub struct ErrorStack;
  pub mod libc {
      pub type c_char = i8;
      pub type c_int = i32;
      pub type c_void = u8;
  }
