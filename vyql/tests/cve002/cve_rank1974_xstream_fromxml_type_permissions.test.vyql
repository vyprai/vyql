# Rank 1974 / CVE-2013-7285 (CWE-502): XStream instantiates whatever classes
# the XML document names, so whoever supplies the document chooses the code
# that runs -- the canonical Java deserialization RCE. The library's own code
# carries the shape everywhere: AbstractFilePersistenceStrategy holds a plain
# XStream and reads persisted files back with
#
#	return xstream.fromXML(reader);
#
# and XStreamer offers the whole graph through static fromXML(String xml)
# helpers, both with no notion of a class-set restriction at the parent. The
# fix (6344867d, "Merge security framework from HEAD into branch") adds the
# permission framework a consumer configures before reading: SecurityMapper
# consults TypePermissions on every realClass, and XStream gains the
# documented instance API -- addPermission, allowTypes, allowTypesByRegExp,
# allowTypesByWildcard, denyPermission, denyTypes*, and later
# setupDefaultSecurity -- so restricting the set is now part of every correct
# use.
#
# `vyql match` at the parent labelled nothing on either shape: the generated
# package bindings for com.thoughtworks.xstream never fire (the dependency
# gate stays closed on real trees, the same reason the Kryo sinks dropped
# theirs), so fromXML had no sink and no presence label at all -- a tainted
# request reader flowed to an unlabelled call and reported nothing.
#
# Detection is two arms of the existing deserialization family, no new
# vocabulary: a fromXML sink at args[0] (VYQL-DESER-001 over tainted input),
# and code.UnrestrictedClassDeserialization (VYQL-DESER-023) on the class
# context for the unconfigured shape -- a class that deserializes through
# XStream while no member configures a type permission. The permission API is
# instance-scoped and documented on XStream, configured wherever the instance
# is built (factory method, static or field initializer), so the class is the
# unit that owns the obligation; the negation runs over the class's collected
# member call tokens and the permission calls also emit core.SafeDeserialization
# with endpoint coverage so a configured instance's tainted read is cleared.
# unmarshal is shared with JAXB, so that arm requires a second XStream-typed
# token in the class to fire.
#
# Measured on the real checkout (xstream/src/java, three --cache off runs
# each): VYQL-DESER-023 0 -> 6 at the parent (XStream.java twice, XStreamer,
# AbstractFilePersistenceStrategy thrice) and 6 -> 4 across the fixed revisioned revision, the two
# XStream.java rows declining because the fixed class configures
# AnyTypePermission through addPermission in setupSecurity -- the
# API-documented call the fixed revision leaves inside the class it guards. XStreamer and
# the persistence strategy stay reported at the fixed revision, correctly: neither takes
# a permission even there, the opt-in residual that later forced 1.4.18's
# default deny. VYQL-DESER-004 held at 14 on both revisions and both states.
# Reachable set across the ~175 clones: XStream usage exists in exactly two
# other repos -- the XStreamReaderWriter JAX-RS consumer (unmarshal over a
# request entityStream, no permissions) goes 0 -> 1 VYQL-DESER-023, a true
# positive, and one jenkins test file -- so the binding's collateral is the
# one true positive plus that test.
#
# verify_current_expected: fixed

test "rank1974: a persistence strategy reading files back through an unconfigured XStream reports unrestricted deserialization"
  lang java
  expect VYQL-DESER-023
  code
  ```
  package com.thoughtworks.xstream.persistence;

  import java.io.File;
  import java.io.FileInputStream;
  import java.io.FileNotFoundException;
  import java.io.IOException;
  import java.io.InputStreamReader;
  import java.io.Reader;
  import com.thoughtworks.xstream.XStream;
  import com.thoughtworks.xstream.io.StreamException;

  public abstract class AbstractFilePersistenceStrategy implements PersistenceStrategy {

      private final File baseDirectory;
      private final String encoding;
      private final transient XStream xstream;

      public AbstractFilePersistenceStrategy(
          final File baseDirectory, final XStream xstream, final String encoding) {
          this.baseDirectory = baseDirectory;
          this.xstream = xstream;
          this.encoding = encoding;
      }

      private Object readFile(final File file) {
          try {
              final FileInputStream in = new FileInputStream(file);
              final Reader reader = encoding != null
                  ? new InputStreamReader(in, encoding)
                  : new InputStreamReader(in);
              try {
                  return xstream.fromXML(reader);
              } finally {
                  reader.close();
              }
          } catch (final FileNotFoundException e) {
              // not found... file.exists might generate a sync problem
              return null;
          } catch (final IOException e) {
              throw new StreamException(e);
          }
      }
  }
  ```

test "rank1974: the same strategy restricting the instance's type set in its constructor is hardened"
  lang java
  reject VYQL-DESER-023
  code
  ```
  package com.thoughtworks.xstream.persistence;

  import java.io.File;
  import java.io.FileInputStream;
  import java.io.FileNotFoundException;
  import java.io.IOException;
  import java.io.InputStreamReader;
  import java.io.Reader;
  import com.thoughtworks.xstream.XStream;
  import com.thoughtworks.xstream.io.StreamException;

  public abstract class AbstractFilePersistenceStrategy implements PersistenceStrategy {

      private final File baseDirectory;
      private final String encoding;
      private final transient XStream xstream;

      public AbstractFilePersistenceStrategy(
          final File baseDirectory, final XStream xstream, final String encoding) {
          this.baseDirectory = baseDirectory;
          this.xstream = xstream;
          this.encoding = encoding;
          xstream.allowTypesByWildcard(new String[]{"com.thoughtworks.xstream.persistence.**"});
      }

      private Object readFile(final File file) {
          try {
              final FileInputStream in = new FileInputStream(file);
              final Reader reader = encoding != null
                  ? new InputStreamReader(in, encoding)
                  : new InputStreamReader(in);
              try {
                  return xstream.fromXML(reader);
              } finally {
                  reader.close();
              }
          } catch (final FileNotFoundException e) {
              // not found... file.exists might generate a sync problem
              return null;
          } catch (final IOException e) {
              throw new StreamException(e);
          }
      }
  }
  ```

test "rank1974: a request body handed to XStream's fromXML is a critical deserialization path"
  lang java
  expect VYQL-DESER-001
  code
  ```
  package com.example.settings;

  import java.io.IOException;
  import javax.servlet.http.HttpServletRequest;
  import com.thoughtworks.xstream.XStream;

  public class SettingsDecoder {

      private final XStream xstream = new XStream();

      public Object decode(HttpServletRequest request) throws IOException {
          return xstream.fromXML(request.getReader());
      }
  }
  ```

test "rank1974: the same read behind an instance configured with a type permission is cleared"
  lang java
  reject VYQL-DESER-001
  code
  ```
  package com.example.settings;

  import java.io.IOException;
  import javax.servlet.http.HttpServletRequest;
  import com.thoughtworks.xstream.XStream;

  public class SettingsDecoder {

      private final XStream xstream = new XStream();

      public Object decode(HttpServletRequest request) throws IOException {
          xstream.allowTypesByWildcard(new String[]{"com.example.settings.**"});
          return xstream.fromXML(request.getReader());
      }
  }
  ```
