# Rank 1305 / CVE-2024-11403: libjxl's jpegli JPEG decoder builds a Huffman
# lookup table for each DC/AC table straight from the DHT marker's bit-length
# histogram (JHUFF_TBL::bits) and symbol list (JHUFF_TBL::huffval), both read
# verbatim off the file. BuildJpegHuffmanTable (lib/jpegli/huffman.cc) walks
# that attacker-controlled histogram in two passes and writes each generated
# entry through a running index (`key` for the root table, `low`/`key` for
# second-level sub-tables) into `lut`, a buffer sized only
# `kJpegHuffmanLutSize` entries -- fixed at 758 (lib/jpegli/huffman.h and the
# near-identical lib/jxl/jpeg/enc_jpeg_huffman_decode.h). 758 is `zlib`'s
# `enough.c` bound for a *complete* Huffman code; the histogram's own
# consistency check (`space < 0` in BuildHuffmanLookupTable, decode.cc) still
# accepts a broader class of "space > 0" incomplete codes for which the true
# worst case is close to 1024 entries, so a crafted DHT marker whose bit
# lengths land in that gap drives BuildJpegHuffmanTable's write index past
# the 758-entry array -- an out-of-bounds write, CWE-787/CWE-1284. The
# fixed revision changes only the constant (758 ->
# 1024) in both headers; the write loops themselves are untouched.
#
# `timeout 180 ./bin/vyql scan --cache off --max-ram 6GB` against the real
# checkout at the vulnerable revision reports nothing at huffman.cc's
# BuildJpegHuffmanTable or decode.cc's BuildHuffmanLookupTable: every
# subscript on `lut`/`table`/`counts`/`values` carries only the generic
# presence label code.IndexAccess / code.IndexAccessSink, no VYQL-MEM-010
# (code.FieldDerivedIndexAccess) and no VYQL-MEM-017
# (code.CountDerivedElementAccess). `vyql explain` on an isolated repro of
# the same shape confirms zero findings; `vyql resolve` shows the call into
# BuildJpegHuffmanTable resolves, so the miss is not an unresolved call --
# nothing judges the write.
#
# ATTENTION, engine gap, related to but distinct from the one logged
# for rank 1297 (libde265 HRD cpb_cnt loop bound; ENGINE-GAPS.md). That gap
# is "a field-derived count bounds a loop whose *own loop variable* indexes
# the array" -- `for (j = 0; j <= s->count; j++) arr[j] = ...`. Here the
# write index is not the loop variable at all: `key`/`low` are separate
# accumulators incremented by a computed replication count
# (`reps = 1 << (table_bits - code.bits)`) inside a `while (reps--)` nested
# inside the histogram-bounded `for` loop, and `key`/`low` keep accumulating
# across two independent passes over the histogram. A minimal pair isolates
# exactly this narrower difference: a field-derived count used directly as
# an index is caught (VYQL-MEM-010); the identical count used only as a
# `for` trip count, whose body writes through a *separate* accumulator
# variable rather than the loop variable itself, is not -- and would not be
# fixed by 1297's proposed correlation (loop condition to same-array
# subscript), because the subscript here never mentions the loop variable at
# all. Recognising this needs the engine to track an accumulator threaded
# across write sites back to the field-derived counts that pace its
# increments, a new dataflow relation with no bounded correction in one
# extraction path, and there is no local `unless`-shaped guard to add either
# -- the loop-and-accumulate idiom is the normal way to fill a variable-width
# lookup table and is safe whenever the destination is actually sized for the
# maximum possible accumulation, which is exactly the arithmetic fact this
# constant got wrong. Widening any existing rule to fire on every
# accumulator write inside a field-bounded loop would flag that ordinary
# idiom broadly. Spec: this file's third and fourth snippets (the minimal
# pair) differ only in whether the write index is the loop variable's own
# use as a direct field index, or a same-array write through a separately
# incremented accumulator.
#
# verify_current_expected: attention-engine-gap

test "rank1305: jpegli's Huffman LUT is sized 758 (too small for an incomplete code) and BuildJpegHuffmanTable writes past it unchecked"
  lang cpp
  file huffman.cc
  reject VYQL-MEM-010
  reject VYQL-MEM-017
  reject_review code.FieldDerivedIndexAccess
  code
  ```
  namespace jpegli {

  constexpr int kJpegHuffmanRootTableBits = 8;
  constexpr int kJpegHuffmanMaxBitLength = 16;
  // 758 entries: enough for a complete Huffman code (zlib/enough.c), not
  // enough for every incomplete code the histogram check below still allows.
  constexpr int kJpegHuffmanLutSize = 758;

  struct HuffmanTableEntry {
    uint8_t bits;
    uint16_t value;
  };

  static inline int NextTableBitSize(const int* count, int len) {
    int left = 1 << (len - kJpegHuffmanRootTableBits);
    while (len < kJpegHuffmanMaxBitLength) {
      left -= count[len];
      if (left <= 0) break;
      ++len;
      left <<= 1;
    }
    return len - kJpegHuffmanRootTableBits;
  }

  // count/symbols come straight from the file's DHT marker
  // (JHUFF_TBL::bits/huffval); lut points into a buffer sized only
  // kJpegHuffmanLutSize entries.
  void BuildJpegHuffmanTable(const uint32_t* count, const uint32_t* symbols,
                             HuffmanTableEntry* lut) {
    HuffmanTableEntry code;
    HuffmanTableEntry* table;
    int len, idx, key, reps, low, table_bits, table_size;
    int tmp_count[kJpegHuffmanMaxBitLength + 1] = {0};
    for (len = 1; len <= kJpegHuffmanMaxBitLength; ++len) tmp_count[len] = count[len];

    table = lut;
    table_bits = kJpegHuffmanRootTableBits;
    table_size = 1 << table_bits;
    key = 0;
    idx = 0;
    for (len = 1; len <= kJpegHuffmanRootTableBits; ++len) {
      for (; tmp_count[len] > 0; --tmp_count[len]) {
        code.bits = len;
        code.value = symbols[idx++];
        reps = 1 << (kJpegHuffmanRootTableBits - len);
        while (reps--) {
          table[key++] = code;
        }
      }
    }

    table += table_size;
    table_size = 0;
    low = 0;
    for (len = kJpegHuffmanRootTableBits + 1; len <= kJpegHuffmanMaxBitLength; ++len) {
      for (; tmp_count[len] > 0; --tmp_count[len]) {
        if (low >= table_size) {
          table += table_size;
          table_bits = NextTableBitSize(tmp_count, len);
          table_size = 1 << table_bits;
          low = 0;
          lut[key].bits = table_bits + kJpegHuffmanRootTableBits;
          lut[key].value = (table - lut) - key;
          ++key;
        }
        code.bits = len - kJpegHuffmanRootTableBits;
        code.value = symbols[idx++];
        reps = 1 << (table_bits - code.bits);
        while (reps--) {
          table[low++] = code;
        }
      }
    }
  }

  }  // namespace jpegli
  ```

test "rank1305: fix widens the constant to 1024; the write loops themselves are unchanged"
  lang cpp
  file huffman.cc
  reject VYQL-MEM-010
  reject VYQL-MEM-017
  reject_review code.FieldDerivedIndexAccess
  code
  ```
  namespace jpegli {

  constexpr int kJpegHuffmanRootTableBits = 8;
  constexpr int kJpegHuffmanMaxBitLength = 16;
  // Widened to fit the worst case for an incomplete code too.
  constexpr int kJpegHuffmanLutSize = 1024;

  struct HuffmanTableEntry {
    uint8_t bits;
    uint16_t value;
  };

  static inline int NextTableBitSize(const int* count, int len) {
    int left = 1 << (len - kJpegHuffmanRootTableBits);
    while (len < kJpegHuffmanMaxBitLength) {
      left -= count[len];
      if (left <= 0) break;
      ++len;
      left <<= 1;
    }
    return len - kJpegHuffmanRootTableBits;
  }

  void BuildJpegHuffmanTable(const uint32_t* count, const uint32_t* symbols,
                             HuffmanTableEntry* lut) {
    HuffmanTableEntry code;
    HuffmanTableEntry* table;
    int len, idx, key, reps, low, table_bits, table_size;
    int tmp_count[kJpegHuffmanMaxBitLength + 1] = {0};
    for (len = 1; len <= kJpegHuffmanMaxBitLength; ++len) tmp_count[len] = count[len];

    table = lut;
    table_bits = kJpegHuffmanRootTableBits;
    table_size = 1 << table_bits;
    key = 0;
    idx = 0;
    for (len = 1; len <= kJpegHuffmanRootTableBits; ++len) {
      for (; tmp_count[len] > 0; --tmp_count[len]) {
        code.bits = len;
        code.value = symbols[idx++];
        reps = 1 << (kJpegHuffmanRootTableBits - len);
        while (reps--) {
          table[key++] = code;
        }
      }
    }

    table += table_size;
    table_size = 0;
    low = 0;
    for (len = kJpegHuffmanRootTableBits + 1; len <= kJpegHuffmanMaxBitLength; ++len) {
      for (; tmp_count[len] > 0; --tmp_count[len]) {
        if (low >= table_size) {
          table += table_size;
          table_bits = NextTableBitSize(tmp_count, len);
          table_size = 1 << table_bits;
          low = 0;
          lut[key].bits = table_bits + kJpegHuffmanRootTableBits;
          lut[key].value = (table - lut) - key;
          ++key;
        }
        code.bits = len - kJpegHuffmanRootTableBits;
        code.value = symbols[idx++];
        reps = 1 << (table_bits - code.bits);
        while (reps--) {
          table[low++] = code;
        }
      }
    }
  }

  }  // namespace jpegli
  ```

test "rank1305: minimal pair -- a struct-field count used directly as an index is caught"
  lang c
  file huffman.c
  expect VYQL-MEM-010
  expect_review code.FieldDerivedIndexAccess
  code
  ```
  struct hrd_state { unsigned count; int rate[32]; };

  void direct_index(struct hrd_state *s) {
      s->rate[s->count] = 1;
  }
  ```

test "rank1305: minimal pair -- the identical unchecked count used as a for trip count, written through a separate accumulator rather than the loop variable, is not"
  lang c
  file huffman.c
  reject VYQL-MEM-010
  reject_review code.FieldDerivedIndexAccess
  code
  ```
  struct hrd_state { unsigned count; int rate[32]; };

  void loop_write(struct hrd_state *s) {
      int i, key = 0;
      for (i = 0; i < s->count; i++) {
          s->rate[key++] = 1;
      }
  }
  ```
