test "rank1775: the command-line responder held in a local before registration"
  lang go
  file defaults.go
  expect VYQL-SEC-043
  code
  ```
  package server

  import (
  	"net/http"
  	"net/http/pprof"
  )

  func MetricsHandler() http.Handler {
  	mux := http.NewServeMux()
  	handler := pprof.Cmdline
  	mux.HandleFunc("/debug/pprof/cmdline", handler)
  	return mux
  }
  ```

test "rank1775: a selector that only shares the method name is not the pprof responder"
  lang go
  file defaults.go
  reject VYQL-SEC-043
  code
  ```
  package server

  import "net/http"

  type pprof2 struct{}

  func (pprof2) Cmdline(w http.ResponseWriter, r *http.Request) {}

  func MetricsHandler() http.Handler {
  	mux := http.NewServeMux()
  	mux.HandleFunc("/debug/pprof/cmdline", pprof2.Cmdline)
  	return mux
  }
  ```
