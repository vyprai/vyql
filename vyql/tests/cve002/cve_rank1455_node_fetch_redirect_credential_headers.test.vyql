  code
  ```
  function redirectToCanonical(req, res, target) {
  	const headers = { 'Location': target, 'Content-Length': '0' };

  	res.statusCode = 302;
  	res.writeHead(302, headers);
  	res.end();
  }

  module.exports = { redirectToCanonical };
  ```
