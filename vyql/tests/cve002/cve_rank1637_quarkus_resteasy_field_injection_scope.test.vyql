# Rank 1637 / CVE-2025-1247: Quarkus RESTEasy Reactive registered every
# @Path resource class as a @Singleton CDI bean by default
# (ResteasyReactiveCDIProcessor.beanDefiningAnnotations maps PATH to
# BuiltinScope.SINGLETON), so a resource that takes its request parameters
# by field injection -- @QueryParam/@HeaderParam/@PathParam/@FormParam/
# @MatrixParam/@CookieParam/@BeanParam or the Rest* variants on fields --
# held one request's values in a bean shared by every concurrent request,
# serving user A's parameters to user B (CWE-488, exposure of a data
# element to the wrong session). The fixed revision (merge d8df15cec of
# PR #46178; the combined diff is empty so the change reads via
# `git diff 620f645ac d8df15cec`) adds a build step, not a line change:
# ResteasyReactiveScanner gains hasJaxRsFieldInjection walking fields and
# superclasses, and ResteasyReactiveCDIProcessor.requestScopedResources
# either adds @RequestScoped to a scope-less field-injection resource or
# fails the build with a DeploymentException when an explicit non-request
# scope (@Dependent, @ApplicationScoped, @Singleton) is set. The
# PATH->SINGLETON registration line itself is untouched at both revisions,
# and the remediation is present at <fix> and absent at <fix>^. No pool
# correction.
#
# ATTENTION, wiring-not-dataflow family (the 1514/1535/1540/1556/1557/1593
# shape, here bean scoping rather than authorization). The leak is
# performed by the framework's bean lifecycle, so no application-level
# taint path exists, and the discriminator -- the runtime's singleton
# default -- is a property of the framework build, not of the application
# source. Two measured blockers sit in front of even a presence route,
# both re-verified on a fresh diagnosis with a positive-control probe
# binding (a `node.token contains "hello"` clause fires, so the probes
# below are live rather than silently unloaded):
# (1) Java field annotations produce no token anywhere -- the
#     field_declaration case in java.go lowers @HeaderParam String foo to
#     a bare Assign, so `node.token contains "HeaderParam"` matches
#     nothing at class or function scope;
# (2) a class's own annotations do not reach the class context node --
#     neither `node.context.classAnnotation` nor `node.token` carrying
#     "RequestScoped" matches at node.scope == "class", so the very
#     annotation the remediation adds is unreadable too.
# The safe method-parameter spelling IS extracted via
# jvParamAnnotationTokens (vyql match labels it code.HttpInput at the
# analysis.parameter.entry node), so the scanner sees exactly the form
# that is not the vulnerability. A binding on the framework's new
# requestScopedResources step would key on the fixing commit's own
# layout, and the 1380 counterweight does not apply: the control is a
# build-time processor step, no API-documented call remains inside a
# guarded application method. No CWE-488 or wrong-session vocabulary
# exists anywhere in the knowledge base, and minting a concept for this
# case alone is the per-case rot the ontology guards against. The two
# blocks below are a minimal pair: identical code except the @RequestScoped
# annotation on the resource class, which is the one construct any future
# detection has to discriminate on. Both assert reject VYQL-AUTH-079
# (code.SensitiveOperation, CWE-862) as the nearest existing rule; when
# wrong-session-exposure vocabulary lands, the scope-less form must flip
# to expect. Scanning extensions/resteasy-reactive reports the same 36
# findings and 147 review flags at <fix>^ and at <fix> (byte-identical
# sets; only the file counts move, java:1005 -> 1012), and the
# field-injection shape is more common at the fixed revision (121 -> 127
# files repo-wide), because the fix's own regression tests add six more
# scope-less resources -- an application-level binding scores higher on
# the fixed tree.

test "rank1637: request parameters field-injected into a scope-less resource"
  lang java
  file extensions/resteasy-reactive/rest/deployment/src/test/java/io/quarkus/resteasy/reactive/server/test/injection/HeaderFieldNoScopeTest.java
  reject VYQL-AUTH-079
  code
  ```
  package io.quarkus.resteasy.reactive.server.test.injection;

  import jakarta.enterprise.context.RequestScoped;
  import jakarta.ws.rs.GET;
  import jakarta.ws.rs.HeaderParam;
  import jakarta.ws.rs.Path;
  import jakarta.ws.rs.Produces;
  import jakarta.ws.rs.core.MediaType;

  import org.jboss.resteasy.reactive.RestHeader;

  public class HeaderFieldNoScopeTest {

      @Path("/test")
      public static class Resource {

          @HeaderParam("foo")
          String foo;

          @RestHeader
          String bar;

          @GET
          @Produces(MediaType.TEXT_PLAIN)
          public String hello() {
              return "foo: " + foo + ", bar: " + bar;
          }
      }
  }
  ```

test "rank1637: the same resource with @RequestScoped holds one request's values"
  lang java
  file extensions/resteasy-reactive/rest/deployment/src/test/java/io/quarkus/resteasy/reactive/server/test/injection/HeaderFieldRequestScopeTest.java
  reject VYQL-AUTH-079
  code
  ```
  package io.quarkus.resteasy.reactive.server.test.injection;

  import jakarta.enterprise.context.RequestScoped;
  import jakarta.ws.rs.GET;
  import jakarta.ws.rs.HeaderParam;
  import jakarta.ws.rs.Path;
  import jakarta.ws.rs.Produces;
  import jakarta.ws.rs.core.MediaType;

  import org.jboss.resteasy.reactive.RestHeader;

  public class HeaderFieldRequestScopeTest {

      @Path("/test")
      @RequestScoped
      public static class Resource {

          @HeaderParam("foo")
          String foo;

          @RestHeader
          String bar;

          @GET
          @Produces(MediaType.TEXT_PLAIN)
          public String hello() {
              return "foo: " + foo + ", bar: " + bar;
          }
      }
  }
  ```

test "rank1637: the method-parameter spelling of the same annotation is extracted"
  lang java
  file extensions/resteasy-reactive/rest/deployment/src/test/java/io/quarkus/resteasy/reactive/server/test/injection/HeaderParamMethodTest.java
  reject VYQL-AUTH-079
  code
  ```
  package io.quarkus.resteasy.reactive.server.test.injection;

  import jakarta.ws.rs.GET;
  import jakarta.ws.rs.HeaderParam;
  import jakarta.ws.rs.Path;
  import jakarta.ws.rs.Produces;
  import jakarta.ws.rs.core.MediaType;

  public class HeaderParamMethodTest {

      @Path("/test")
      public static class Resource {

          @GET
          @Produces(MediaType.TEXT_PLAIN)
          public String hello(@HeaderParam("foo") String foo) {
              return "foo: " + foo;
          }
      }
  }
  ```
