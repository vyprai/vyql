test "rank1306: minimal pair -- a local scalar a loop increments without bound, tested only against the array it indexes, is not"
  lang c
  file huffcdic.c
  reject VYQL-MEM-005
  reject VYQL-MEM-010
  reject VYQL-MEM-017
  reject_review code.FieldDerivedIndexAccess
  code
  ```
  struct hrd_state { int mincode[33]; int maxcode[33]; };

  void unbounded_table_walk(struct hrd_state *s, int code) {
      unsigned char idx = 0;
      while (code < s->mincode[idx]) {
          idx++;
      }
      int v = s->maxcode[idx];
  }
  ```

# The four walks below are copied from libmobi's own src/util.c and src/opf.c,
# each a sentinel-terminated table walk that any gate widened to catch the
# huffman walk would also hit: the same bare local, incremented in a loop, with
# no relational comparison of that local anywhere in the body. Each is safe
# because its table is defined, in the same translation unit, to end in a
# terminator entry -- a fact about the data that no code-level extractor can
# read. A future gate must still report none of them.

test "rank1306: pin -- a walk to an explicit terminator field is not the huffman walk"
  lang c
  file util.c
  reject VYQL-MEM-005
  reject VYQL-MEM-010
  reject VYQL-MEM-017
  reject_review code.FieldDerivedIndexAccess
  code
  ```
  typedef struct { int type; const char *name; } FileMeta;

  const FileMeta file_meta[] = {
      { 1, "book" },
      { 2, "news" },
      { 0, NULL },
  };

  FileMeta get_filemeta_by_type(int type) {
      size_t i = 0;
      while (file_meta[i].type != 0) {
          if (file_meta[i].type == type) {
              return file_meta[i];
          }
          i++;
      }
      return file_meta[i];
  }
  ```

test "rank1306: pin -- a walk to a NULL pointer entry is not the huffman walk"
  lang c
  file opf.c
  reject VYQL-MEM-005
  reject VYQL-MEM-010
  reject VYQL-MEM-017
  reject_review code.FieldDerivedIndexAccess
  code
  ```
  #include <string.h>

  const char *guide_types[] = { "cover", "toc", "index", NULL };

  int is_guide_type(const char *type) {
      size_t i = 0;
      size_t type_length = strlen(type);
      while (guide_types[i]) {
          if (strncmp(guide_types[i++], type, type_length) == 0) {
              return 1;
          }
      }
      return 0;
  }
  ```

test "rank1306: pin -- a walk copying up to a NUL into a fixed field is not the huffman walk"
  lang c
  file util.c
  reject VYQL-MEM-005
  reject VYQL-MEM-010
  reject VYQL-MEM-017
  reject_review code.FieldDerivedIndexAccess
  code
  ```
  #include <ctype.h>
  #include <string.h>

  #define NAME_SIZE_MAX 32

  typedef struct { char name[NAME_SIZE_MAX + 1]; } PalmHeader;

  void set_dbname(PalmHeader *ph, const char *name) {
      char dbname[NAME_SIZE_MAX + 1];
      memcpy(dbname, name, NAME_SIZE_MAX);
      dbname[NAME_SIZE_MAX] = '\0';
      char c;
      int i = 0;
      while ((c = dbname[i])) {
          if (!isalnum(c)) {
              c = '_';
          }
          ph->name[i++] = c;
      }
      ph->name[i] = '\0';
  }
  ```

test "rank1306: pin -- a walk gated on a positive tag field is not the huffman walk"
  lang c
  file util.c
  reject VYQL-MEM-005
  reject VYQL-MEM-010
  reject VYQL-MEM-017
  reject_review code.FieldDerivedIndexAccess
  code
  ```
  typedef struct { int tag; int len; const char *name; } ExthMeta;

  const ExthMeta exth_tags[] = {
      { 100, 4, "author" },
      { 101, 4, "publisher" },
      { 0, 0, NULL },
  };

  ExthMeta get_exthtagmeta_by_tag(int tag) {
      size_t i = 0;
      while (exth_tags[i].tag > 0) {
          if (exth_tags[i].tag == tag) {
              return exth_tags[i];
          }
          i++;
      }
      return (ExthMeta) {0, 0, NULL};
  }
  ```

