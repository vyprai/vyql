  use std::fs::OpenOptions;
  use std::path::Path;

  pub struct Store;

  impl Store {
      pub fn write_manifest<P: AsRef<Path>>(&self, dir: P, version: u32) -> std::io::Result<()> {
          let path = dir.as_ref().join(format!("manifest-{}.json", version));
          let mut f = OpenOptions::new()
              .write(true)
              .create(true)
              .open(&path)?;
          use std::io::Write;
          f.write_all(b"{}")
      }
  }
