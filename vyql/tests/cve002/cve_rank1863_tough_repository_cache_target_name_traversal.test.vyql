  reject VYQL-PATH-006
  code
  ```
  use std::fs::OpenOptions;
  use std::io::Read;
  use std::path::Path;

  pub struct Repository;
  pub struct Target;

  impl Repository {
      fn cache_target<P: AsRef<Path>>(&self, outdir: P, name: &str) -> Result<(), ()> {
          let t = self
              .targets
              .signed
              .find_target(name)
              .ok_or(())?;
          let (sha, filename) = self.target_digest_and_filename(t, name);
          let mut reader = self.fetch_target(t, &sha, filename.as_str())?;
          let path = outdir.as_ref().join(filename);
          if !path.starts_with(outdir.as_ref()) {
              return Err(());
          }
          let mut f = OpenOptions::new()
              .write(true)
              .create(true)
              .open(&path)?;
          std::io::copy(&mut reader, &mut f)?;
          Ok(())
      }
  }
  ```

test "rank1863: (d) an atomic fetch_add next to a local join is not a retrieval"
  lang rust
  file src/counter.rs
  reject VYQL-PATH-006
  code
  ```
  use std::fs::OpenOptions;
  use std::path::Path;
  use std::sync::atomic::AtomicUsize;

  pub struct Writer {
      count: AtomicUsize,
  }

  impl Writer {
      pub fn write_state<P: AsRef<Path>>(&self, dir: P, key: &str) -> std::io::Result<()> {
          let n = self.count.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
          let path = dir.as_ref().join(format!("state-{}.txt", n));
          let mut f = OpenOptions::new()
              .write(true)
              .create(true)
              .open(&path)?;
          use std::io::Write;
          f.write_all(key.as_str().as_bytes())
      }
  }
  ```

test "rank1863: (e) fetching by name and joining it but only reading the result back stays with the taint rules"
  lang rust
  file tough/src/cache.rs
  reject VYQL-PATH-006
  code
  ```
  use std::path::Path;

  pub struct Repository;
  pub struct Target;

  impl Repository {
      fn inspect_target<P: AsRef<Path>>(&self, outdir: P, name: &str) -> Result<String, ()> {
          let t = self
              .targets
              .signed
              .find_target(name)
              .ok_or(())?;
          let (sha, filename) = self.target_digest_and_filename(t, name);
          let mut reader = self.fetch_target(t, &sha, filename.as_str())?;
          let path = outdir.as_ref().join(filename);
          let mut buf = String::new();
          use std::io::Read;
          reader.read_to_string(&mut buf)?;
          std::fs::read_to_string(&path).map_err(|_| ())
      }
  }
  ```

