# Rank 1119 / CVE-2017-8827: GeniXCMS's forgot-password page is a procedural
# PHP script whose whole handler runs inline at module scope -- one
# isset($_POST['forgotpass']) block validates the form token, runs the CAPTCHA
# when the plugin is enabled, then looks the submitted username up and, for an
# active account, generates a new password, writes it onto the account with
# User::update and mails it. Nothing stands between an HTTP request and that
# generation, so the reset can be driven at machine speed -- exhausting mail
# and reset capacity or farming reset emails (CWE-287 recorded; the shape is
# CWE-307). The fix adds a session-keyed request cooldown: a
# User::lastRequestPassword() guard before the CAPTCHA check, backed by new
# User-class helpers that store the last request time and compare it against a
# 1200-second limit. The gxadmin/forgotpassword.php copy does not receive the
# guard in the same commit, so the fixed tree still contains one unthrottled
# handler.
#
# ATTENTION, rechecked: the miss is real and not a view artifact. Scanned
# fresh at both revisions (3 x --cache off runs, -exclude Vendor so the tree
# fits the 180s bound), the vulnerable tree reports 2107 findings and the
# fixed tree 2120 -- the fix is a release commit that adds a cache module,
# so the fixed tree has more code and more noise -- with VYQL-AUTH-105
# absent from both and the -flags only view carrying exactly two
# code.StateChangingOp flags on these files (User::update at
# forgotpassword.php:70/75 and gxadmin/forgotpassword.php:71), identical at
# both revisions. vyql match on the isolated handler labels the $_POST reads
# code.HttpInput and User::update code.StateChangingOp, and nothing else:
# no throttle label exists on either side. Nothing shipped since the first
# pass changes it -- the rate-limit vocabulary gained a C# arm
# (passwordVerificationRateLimitRequired301) and two Python arms
# (password_verification_attempt_limit, drf_authentication_view_throttle),
# all function-scoped, and PHP still has no RateLimitRequiredOp or
# RateLimitCheck binding at any scope. A genericity-clean PHP arm cannot be
# written for this handler: the PHP module context carries no endpoint
# identity (phpModuleContext emits lang=php plus AST tokens and raw text,
# php.go:414), the handler's authentication-sensitive signals are one
# project's own API (User::generatePass, User::update, Mail::send), and the
# generic key the other arms use -- the documented password-verification
# call of the ecosystem (password_verify, check_password_hash,
# PasswordHash+Verify) -- never appears, because this handler resets rather
# than verifies. The fix supplies no standard throttle vocabulary either:
# lastRequestPassword is a private name and the conventional spellings
# (throttle, RateLimiter, lockout, failed-attempt) are absent, so a
# negation over the standard vocabulary cannot suppress the patched
# revision, while naming lastRequestPassword repeats the one-project
# limiter binding the 1042/1079 ENGINE-GAPS entry already criticises. Both
# snippets reject VYQL-AUTH-105.
#
# verify_current_expected: attention-vocabulary-gap, both revisions rejected.

test "rank1119: the forgot-password handler resets and mails with no request limit"
  lang php
  file forgotpassword.php
  reject VYQL-AUTH-105
  code
  ```
  <?php
  $data = [];
  if (isset($_POST['forgotpass'])) {
      $token = Typo::cleanX($_POST['token']);
      if (!isset($_POST['token']) || !Token::validate($token)) {
          // VALIDATE ALL
          $alertDanger[] = TOKEN_NOT_EXIST;
      }
      if (Xaptcha::isEnable()) {
          if (!isset($_POST['g-recaptcha-response']) || $_POST['g-recaptcha-response'] == '') {
              $alertDanger[] = 'Please insert the Captcha';
          }
          if (!Xaptcha::verify($_POST['g-recaptcha-response'])) {
              $alertDanger[] = 'Your Captcha is not correct.';
          }
      }

      // Check token first
      if (!isset($alertDanger)) {
          /*check if username is exist or not */
          $username = Typo::cleanX(Typo::strip($_POST['username']));
          $sql = sprintf("SELECT `userid`,`email`,`status`,`activation` FROM `user` WHERE `userid` = '%s'", $username);
          $usr = Db::result($sql);
          if (Db::$num_rows == '1') {
              // check if user is active
              if ($usr[0]->status == '1') {
                  /* get user password */
                  $newpass = User::generatePass();
                  $id = User::id($username);
                  $pass = User::randpass($newpass);
                  $vars = array(
                              'id' => $id,
                              'user' => array(
                                          'pass' => $pass,
                                      ),
                          );
                  User::update($vars);
                  $msg = "Hello {$usr[0]->userid},

        You are requesting Password Reset at ".Site::$name.".
        Below are your new Password :

        {$newpass}
        ";
                  $vars = array(
                              'to' => $usr[0]->email,
                              'to_name' => $usr[0]->userid,
                              'message' => $msg,
                              'subject' => 'Password Reset at '.Site::$name,
                              'msgtype' => 'text',
                          );
                  if (Mail::send($vars)) {
                      $data['alertSuccess'][] = PASSWORD_SENT_NOTIF;
                  }
              } else {
                  $data['alertDanger'][] = ACOUNT_NOT_ACTIVE;
              }
          } elseif (Db::$num_rows == '0') {
              $data['alertDanger'][] = NO_USER;
          }

          Token::remove($token);
      } else {
          $data['alertDanger'][] = $alertDanger;
      }
  }
  ```

test "rank1119: the handler checks the per-user request cooldown before proceeding"
  lang php
  file forgotpassword.php
  reject VYQL-AUTH-105
  code
  ```
  <?php
  $data = [];
  if (isset($_POST['forgotpass'])) {
      $token = Typo::cleanX($_POST['token']);
      if (!isset($_POST['token']) || !Token::validate($token)) {
          // VALIDATE ALL
          $alertDanger[] = TOKEN_NOT_EXIST;
      }

      // check last request
      if (!User::lastRequestPassword()) {
          $alertDanger[] = 'You had reached request password Limit!';
      }
      if (Xaptcha::isEnable()) {
          if (!isset($_POST['g-recaptcha-response']) || $_POST['g-recaptcha-response'] == '') {
              $alertDanger[] = 'Please insert the Captcha';
          }
          if (!Xaptcha::verify($_POST['g-recaptcha-response'])) {
              $alertDanger[] = 'Your Captcha is not correct.';
          }
      }

      // Check token first
      if (!isset($alertDanger)) {
          $username = Typo::cleanX(Typo::strip($_POST['username']));
          $sql = sprintf("SELECT `userid`,`email`,`status`,`activation` FROM `user` WHERE `userid` = '%s'", $username);
          $usr = Db::result($sql);
          if (Db::$num_rows == '1' && $usr[0]->status == '1') {
              $newpass = User::generatePass();
              $pass = User::randpass($newpass);
              $vars = array(
                          'id' => User::id($username),
                          'user' => array('pass' => $pass),
                      );
              User::update($vars);
              $vars = array(
                          'to' => $usr[0]->email,
                          'message' => "Below are your new Password: {$newpass}",
                          'subject' => 'Password Reset',
                          'msgtype' => 'text',
                      );
          }
          Token::remove($token);
      } else {
          $data['alertDanger'][] = $alertDanger;
      }
  }
  ```
