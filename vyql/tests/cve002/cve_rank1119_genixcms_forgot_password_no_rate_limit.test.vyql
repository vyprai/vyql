# Rank 1119 / CVE-2017-8827: GeniXCMS's forgot-password handler accepts an
# unlimited number of reset requests with no throttle, so an attacker can
# exhaust reset capacity or brute-force the reset token (CWE-287, CWE-307).
#
# ATTENTION: vocabulary gap. code.RateLimitRequiredOp and VYQL-AUTH-105 cover
# this weakness, but every RateLimitRequiredOp/RateLimitCheck binding is
# Python-only; the endpoint is procedural PHP at module scope with no function
# for those bindings to attach to. Both snippets reject.
#
# verify_current_expected: attention-vocabulary-gap, both revisions rejected.

test "rank1119: the forgot-password handler has no rate-limit check"
  lang php
  file forgotpassword.php
  reject_review code.RateLimitRequiredOp
  code
  ```
  <?php
  if (isset($_POST['forgotpass'])) {
      $alertDanger = array();
      if (!Token::exist($_POST['token'])) {
          $alertDanger[] = TOKEN_NOT_EXIST;
      }
      if (Xaptcha::isEnable()) {
          if (!isset($_POST['g-recaptcha-response']) || $_POST['g-recaptcha-response'] == '') {
              $alertDanger[] = 'Please insert the Captcha';
          }
      }
      if (empty($alertDanger)) {
          User::sendResetToken($_POST['email']);
      }
  }
  ```

test "rank1119: the handler checks a per-user request limit before proceeding"
  lang php
  file forgotpassword.php
  reject_review code.RateLimitRequiredOp
  code
  ```
  <?php
  if (isset($_POST['forgotpass'])) {
      $alertDanger = array();
      if (!Token::exist($_POST['token'])) {
          $alertDanger[] = TOKEN_NOT_EXIST;
      }

      if (!User::lastRequestPassword()) {
          $alertDanger[] = 'You had reached request password Limit!';
      }
      if (Xaptcha::isEnable()) {
          if (!isset($_POST['g-recaptcha-response']) || $_POST['g-recaptcha-response'] == '') {
              $alertDanger[] = 'Please insert the Captcha';
          }
      }
      if (empty($alertDanger)) {
          User::sendResetToken($_POST['email']);
      }
  }
  ```
