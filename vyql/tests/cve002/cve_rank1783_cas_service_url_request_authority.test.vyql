  package org.springframework.security.cas.web.authentication;

  import javax.servlet.http.HttpServletRequest;

  interface SavedSource {
    String saved(HttpServletRequest request);
  }

  final class RequestSavedSource implements SavedSource {
    public String saved(HttpServletRequest request) {
      return "u:" + request.getRequestURI();
    }
  }

  final class ServiceUrlDispatch {
    private final Logger logger = LoggerFactory.getLogger(ServiceUrlDispatch.class);

    void variableForm(SavedSource source, HttpServletRequest request) {
      logger.debug("saved: " + source.saved(request));
    }
  }
