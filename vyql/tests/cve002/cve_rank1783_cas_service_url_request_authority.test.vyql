  package org.springframework.security.cas.web.authentication;

  import javax.servlet.http.HttpServletRequest;

  final class ServiceUrlCtor {
    private final Logger logger = LoggerFactory.getLogger(ServiceUrlCtor.class);
    private final String serviceUrl;

    ServiceUrlCtor(HttpServletRequest request) {
      this.serviceUrl = request.getRequestURI();
    }

    String getServiceUrl() {
      return serviceUrl;
    }

    void consume(HttpServletRequest request) {
      logger.debug("saved: " + new ServiceUrlCtor(request).getServiceUrl());
    }
  }
