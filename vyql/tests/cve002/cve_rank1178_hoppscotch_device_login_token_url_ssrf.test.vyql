test "rank1178 hoppscotch: device-login token delivery fetches attacker redirect_uri unchecked"
  lang javascript
  file device-login.vue
  expect VYQL-RF-001
  code
  ```
  <script setup lang="ts">
  async function proceedLogin() {
    const url = new URL(window.location.href)
    const redirect_uri = url.searchParams.get("redirect_uri")

    const res = await axios.get(
      `${backendUrl}/auth/desktop?redirect_uri=${redirect_uri}`,
      { withCredentials: true }
    )

    const tokens = res.data

    await axios.get(
      `${redirect_uri}?access_token=${tokens.access_token}&refresh_token=${tokens.refresh_token}`
    )
  }
  </script>
  ```

test "rank1178 hoppscotch: device-login validates redirect_uri is a loopback address before token delivery"
  lang javascript
  file device-login.vue
  reject VYQL-RF-001
  code
  ```
  <script setup lang="ts">
  function isLoopbackUri(uri) {
    try {
      const url = new URL(uri)
      const loopbackHosts = ["localhost", "127.0.0.1", "[::1]"]
      return (
        url.protocol === "http:" &&
        !url.username &&
        !url.password &&
        loopbackHosts.includes(url.hostname)
      )
    } catch {
      return false
    }
  }

  async function proceedLogin() {
    const url = new URL(window.location.href)
    const redirect_uri = url.searchParams.get("redirect_uri")

    if (!isLoopbackUri(redirect_uri)) {
      throw new Error("Invalid redirect URI: must be a loopback address")
    }

    const res = await axios.get(
      `${backendUrl}/auth/desktop?redirect_uri=${encodeURIComponent(redirect_uri)}`,
      { withCredentials: true }
    )

    const tokens = res.data

    await axios.get(
      `${redirect_uri}?access_token=${encodeURIComponent(tokens.access_token)}&refresh_token=${encodeURIComponent(tokens.refresh_token)}`
    )
  }
  </script>
  ```
