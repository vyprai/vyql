          if (yyval.re_node == NULL)
            yr_re_node_destroy(yyvsp[-2].re_node);
          if (yyval.re_node == NULL)
            yr_re_node_destroy(yyvsp[0].re_node);
        }
  #line 1627 "hex_grammar.c" /* yacc.c:1646  */
