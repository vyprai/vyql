test "rank1395: the same shape under other frameworks' names, with the requirement a route field and the grant a credentials scope list"
  lang javascript
  file packages/backend/src/router/dispatch.ts
  expect VYQL-AUTH-178
  expect_review code.UndeclaredScopeSkipsEnforcement
  code
  ```
  export function requireRouteScope(route: Route, credentials: AccessToken | null) {
    if (credentials && route.meta.scope && !credentials.scopes.includes(route.meta.scope)) {
      throw new InsufficientScopeError(`token lacks ${route.meta.scope}`);
    }

    if (credentials && route.meta.audience && !credentials.claims.has(route.meta.audience)) {
      throw new AudienceMismatchError(route.meta.audience);
    }
  }
  ```

test "rank1395: a membership test against a fixed literal requirement is an ordinary constant check"
  lang javascript
  file packages/backend/src/server/api/StreamingApiServerService.ts
  reject VYQL-AUTH-178
  reject_review code.UndeclaredScopeSkipsEnforcement
  code
  ```
  export class StreamingApiServerService {
    private attach(server: http.Server): void {
      this.#wss = new WebSocket.Server({ noServer: true });

      server.on('upgrade', async (request, socket, head) => {
        const q = new URL(request.url!, `http://${request.headers.host}`).searchParams;
        const token = q.get('i');

        let user: MiLocalUser | null = null;
        let app: MiAccessToken | null = null;

        try {
          [user, app] = await this.authenticateService.authenticate(token);

          if (app !== null && !app.permission.some(p => p === 'read:account')) {
            throw new AuthenticationError('Your app does not have necessary permissions to use websocket API.');
          }
        } catch (e) {
          if (e instanceof AuthenticationError) {
            socket.write([
              'HTTP/1.1 401 Unauthorized',
              'WWW-Authenticate: Bearer realm="Misskey", error="invalid_token"',
            ].join('\r\n') + '\r\n\r\n');
          } else {
            socket.write('HTTP/1.1 500 Internal Server Error\r\n\r\n');
          }
          socket.destroy();
          return;
        }

        this.#wss.handleUpgrade(request, socket, head, (ws) => {
          this.#wss.emit('connection', ws, request, { user, app });
        });
      });
    }
  }
  ```

test "rank1395: a guarded allowlist that is not a permission collection stays an input validation"
  lang javascript
  file packages/backend/src/server/api/UserService.ts
  reject VYQL-AUTH-178
  reject_review code.UndeclaredScopeSkipsEnforcement
  code
  ```
  export class UserService {
    public async update(updatePayload: { type?: string; permissions?: object }, user: { permissions: { librariesAccessible: string[] } }) {
      if (updatePayload.permissions && typeof updatePayload.permissions !== 'object') {
        throw new ValidationError('permissions must be an object');
      }

      if (updatePayload.type && !Database.userModel.accountTypes.includes(updatePayload.type)) {
        throw new ValidationError('unknown account type');
      }

      if (user.permissions.librariesAccessible.join(',') !== '') {
        this.logger.info('libraries accessible changed');
      }
    }
  }
  ```
