# Rank 1606 / CVE-2017-0909: private_address_check decided which hosts an
# outbound request may reach from a short exclusion list, so addresses in
# reserved ranges the list omitted -- 0.0.0.0/8, the shared-address block
# 100.64.0.0/10, the documentation nets, multicast, the IPv4-mapped IPv6
# embeddings -- passed the check and received requests (SSRF protection
# bypass through an incomplete range list, CWE-284/CWE-918; PR #3 by
# EdOverflow, "Increase exclusion list"). CIDR_LIST in
# lib/private_address_check.rb carried loopback, link-local and RFC 1918
# alone (::1/64 besides being the wrong mask). Pool commit 516ab853e7
# (the merge) is the real fix, readable via git diff against its parent:
# the list is rebuilt from the Reserved_IP_addresses table -- every
# special-purpose range, with per-entry comments and the correct ::1/128
# mask. No pool correction.
#
# Held ATTENTION, reserved-range completeness, reconfirmed at the span
# tip. Fresh scans of the real checkout at both revisions report zero
# findings and zero flags in the findings and -flags views (3 x
# --cache-off runs each), and `vyql match` labels only require sinks and
# library param-sources: no Ruby binding covers IPAddr, Socket
# .getaddrinfo, or the include?-guard construct, and the request-forgery
# allowlist vocabulary that does exist (VYQL-RF-057 PermissiveHost
# Allowlist) is bound to JavaScript image-config patterns only. A probe
# binding on the construct itself (IPAddr.new plus the include? guard)
# labels 8 nodes on the vulnerable revision and 28 on the fixed one --
# the guard is the same any? { include? } at both, so no shape-level
# binding discriminates; only the literal set differs, and that
# comparison is against the IANA special-purpose registry, which is
# external data no layer can carry: a binding emitting "the list is
# incomplete" is judgement in the labelling layer, a rule naming the
# missing ranges is a data table in the judgement layer, and neither DSL
# has a counting predicate for an entry-count threshold -- which would
# key on the fix's own layout regardless (the project's later commit
# 86f0693 rebuilt the 2017 list again for RFC 9780/9637/9602 ranges and
# synthesized IPv4-mapped embeddings, so any snapshot embeds the same
# defect class it detects). The precision cost is measured: 19 non-test
# source files across the rank clones hold the same IPAddr.new +
# include? shape -- better_errors' two-entry loopback allowlist and
# vagrant's subnet checks are correct instances of exactly this form --
# so a completeness verdict flags ~19 lookalikes per one true positive,
# the ratio measured unshippable before. The gem's own README states
# the duty as "private network (RFC 1918)", so the completeness
# requirement is the advisory's reading, not a property the code or its
# documentation expresses. No engine construct is mishandled -- the
# array, any?, include? and getaddrinfo call all label -- so no
# ENGINE-GAPS.md entry. No definition change shipped. Spec cve_rank1606
# pins the short list and the complete form on the real file shapes,
# both asserting reject VYQL-RF-001: when reserved-range completeness
# vocabulary lands, the short list must flip to expect.

test "rank1606: the exclusion list covers the common ranges only"
  lang ruby
  file lib/private_address_check.rb
  reject VYQL-RF-001
  code
  ```
  require "ipaddr"
  require "socket"

  module PrivateAddressCheck
    module_function

    CIDR_LIST = [
      # Loopback
      IPAddr.new("127.0.0.0/8"),
      IPAddr.new("::1/64"),

      # Link Local,
      IPAddr.new("169.254.0.0/16"),

      # RFC 1918
      IPAddr.new("10.0.0.0/8"),
      IPAddr.new("172.16.0.0/12"),
      IPAddr.new("192.168.0.0/16"),

      # RFC 4193
      IPAddr.new("fc00::/7"),
    ]

    def private_address?(address)
      CIDR_LIST.any? do |cidr|
        cidr.include?(address)
      end
    end

    def resolves_to_private_address?(hostname)
      ips = Socket.getaddrinfo(hostname, nil).map { |info| IPAddr.new(info[3]) }
      return true if ips.empty?

      ips.any? do |ip|
        private_address?(ip)
      end
    end
  end
  ```

test "rank1606: the fixed revision covers every reserved allocation"
  lang ruby
  file lib/private_address_check.rb
  reject VYQL-RF-001
  code
  ```
  require "ipaddr"
  require "socket"

  module PrivateAddressCheck
    module_function

    # https://en.wikipedia.org/wiki/Reserved_IP_addresses
    CIDR_LIST = [
      IPAddr.new("127.0.0.0/8"),     # Loopback
      IPAddr.new("::1/128"),         # Loopback
      IPAddr.new("0.0.0.0/8"),       # Current network (only valid as source address)
      IPAddr.new("169.254.0.0/16"),  # Link-local
      IPAddr.new("10.0.0.0/8"),      # Private network
      IPAddr.new("100.64.0.0/10"),   # Shared Address Space
      IPAddr.new("172.16.0.0/12"),   # Private network
      IPAddr.new("192.0.0.0/24"),    # IETF Protocol Assignments
      IPAddr.new("192.0.2.0/24"),    # TEST-NET-1, documentation and examples
      IPAddr.new("192.88.99.0/24"),  # IPv6 to IPv4 relay (includes 2002::/16)
      IPAddr.new("192.168.0.0/16"),  # Private network
      IPAddr.new("198.18.0.0/15"),   # Network benchmark tests
      IPAddr.new("198.51.100.0/24"), # TEST-NET-2, documentation and examples
      IPAddr.new("203.0.113.0/24"),  # TEST-NET-3, documentation and examples
      IPAddr.new("224.0.0.0/4"),     # IP multicast (former Class D network)
      IPAddr.new("240.0.0.0/4"),     # Reserved (former Class E network)
      IPAddr.new("255.255.255.255"), # Broadcast
      IPAddr.new("64:ff9b::/96"),    # IPv4/IPv6 translation (RFC 6052)
      IPAddr.new("100::/64"),        # Discard prefix (RFC 6666)
      IPAddr.new("2001::/32"),       # Teredo tunneling
      IPAddr.new("2001:10::/28"),    # Deprecated (previously ORCHID)
      IPAddr.new("2001:20::/28"),    # ORCHIDv2
      IPAddr.new("2001:db8::/32"),   # Addresses used in documentation and example source code
      IPAddr.new("2002::/16"),       # 6to4
      IPAddr.new("fc00::/7"),        # Unique local address
      IPAddr.new("fe80::/10"),       # Link-local address
      IPAddr.new("ff00::/8")         # Multicast
    ]

    def private_address?(address)
      CIDR_LIST.any? do |cidr|
        cidr.include?(address)
      end
    end

    def resolves_to_private_address?(hostname)
      ips = Socket.getaddrinfo(hostname, nil).map { |info| IPAddr.new(info[3]) }
      return true if ips.empty?

      ips.any? do |ip|
        private_address?(ip)
      end
    end
  end
  ```
