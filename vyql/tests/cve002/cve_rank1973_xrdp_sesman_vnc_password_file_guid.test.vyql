# Rank 1973 / CVE-2013-1430 (neutrinolabs/xrdp, CWE-256/CWE-312: the
# stored credential is password-equivalent). The pool row's commit
# 93c55e58a8 is the v0.9.1 release-tag merge, not a fix; the advisory
# GHSA-26xv-5c8j-w237 references PR #497, closed unmerged. The
# released fix is 57905d7 "vnc: change password file to use guid hash"
# (PR #523), an ancestor of v0.9.1: remediation confirmed at 57905d7, the
# vulnerable construct confirmed at its parent.
#
# On every successful RDP login to an XVNC-backed session, sesman seeds
# ~/.vnc/sesman_<username>_passwd from the user's actual login password:
# session_start_fork's XVNC branch calls env_check_password_file(
# passwd_file, password) (sesman/session.c:702 at the parent), and the
# helper stores sha1("xrdp_vnc" + password + password) truncated to eight
# hex characters, DES3-encrypted under the hard-coded g_fixedkey
# (sesman/sesman.c:31), into that file. Key and construction are public,
# so the file is the equivalent of the cleartext password. The fixed revision keeps
# env_check_password_file byte-identical and instead seeds the file with
# the hex string of a per-session GUID generated by g_random
# (sesman/scp_v0.c); vnc.c's challenge response takes the same guid
# route, with the password-bearing call left only as a no-guid fallback.
#
# Measured on the real checkout, --cache off: whole tree 909 findings /
# 173 at or above high at BOTH revisions, identical counts; the
# fix-carrying subtree (sesman/ + vnc/) 348 findings on each of three
# runs per revision with identical rule histograms, and zero findings in
# sesman/env.c and vnc/vnc.c at either revision. The only finding in any
# fix-carrying file is an unrelated VYQL-NUM-003 arithmetic row on
# sesman/session.c:65.
#
# Diagnosis, in step-4 order. Nothing labels the credential: the C source
# concepts are CliArgument/ComputedSizeValue/EnvVariable/HttpInput/
# StdinInput only, the password enters the process inside the in_uint8a
# #define (common/parse.h:339) so its network origin produces no nodes
# (the macro-body family on file, ranks 1203/1307), and the labelable
# points (scp_session_set_password, session_start's password parameter)
# are xrdp-internal names with no credential-input concept to emit.
# Nothing labels the write as credential persistence: no sink concept for
# secret material exists, and the os_calls wrappers g_file_open_ex/
# g_file_write are unbound. Even with probe labels on both ends (source
# code.HttpInput at the session.c:702 argument, sink code.FileUseSink at
# the g_file_write buffer argument, env.c:78) vyql trace reports the
# source reaching no sink: every hop from passwd to the written buffer is
# an out-parameter fill through calls absent from the hardcoded
# cPropagators/cReaders tables -- ssl_sha1_transform, g_snprintf,
# g_strncpy, ssl_des3_encrypt -- the out-parameter family on file (1206,
# and 1204's project-defined-helper form).
#
# No layer can discriminate the two revisions. sesman/env.c is unchanged
# by the fixed revision, so the hard-coded-key angle (VYQL-SEC-002's class) fires or
# does not fire identically at both revisions. The only revision-
# discriminating token is the identity of the second argument at
# session.c:702 -- `password` versus `guid_str`; keying on that spelling
# keys on the fixed revision's own vocabulary (rename the helper or the parameter
# and the flag dies), and the shape-only substitute, an argument spelled
# password reaching a call, matches 78 call sites in this tree for
# exactly one true positive -- the measured-unshippable precision shape.
#
# verify_current_expected: attention, every case asserts reject. When a
# credential-persistence concept lands with the out-parameter
# propagation it needs, the first case must flip to expect while the
# guid-seeded form stays reject; the third case pins the precision wall
# that any name-keyed shortcut would hit.

test "rank1973: the XVNC session seeds the VNC password file with the login password under a public fixed key"
  lang c
  file session_password.c
  reject VYQL-AUTH-107
  reject VYQL-SEC-002
  code
  ```
  /* Modelled on sesman/sesman.c (g_fixedkey), sesman/env.c
     (env_check_password_file, unchanged by the fix) and the XVNC branch
     of session_start_fork at sesman/session.c:702 of the fix's parent:
     the password received from the RDP client over SCP becomes the
     stored VNC credential. */
  unsigned char g_fixedkey[8] = { 23, 82, 107, 6, 35, 78, 88, 7 };

  extern int g_strlen(const char *s);
  extern int g_snprintf(char *dest, int len, const char *fmt, ...);
  extern void g_strncpy(char *dest, const char *src, int len);
  extern void g_mirror_memcpy(void *dest, const void *src, int len);
  extern int g_file_open_ex(const char *filename, int aread, int awrite,
                            int acreate, int aappend);
  extern int g_file_write(int fd, const char *data, int len);
  extern int g_file_close(int fd);
  extern void *ssl_sha1_info_create(void);
  extern void ssl_sha1_transform(void *sha1, const char *data, int len);
  extern void ssl_sha1_complete(void *sha1, char *hash);
  extern void *ssl_des3_encrypt_info_create(const char *key, int mode);
  extern void ssl_des3_encrypt(void *des, int len, const char *src,
                               char *dst);
  extern void env_set_user(const char *username, char **passwd_file,
                           int display);

  int
  env_check_password_file(const char *filename, const char *passwd)
  {
      char encryptedPasswd[16];
      char key[24];
      char passwd_hash[20];
      char passwd_hash_text[40];
      int fd;
      int passwd_bytes;
      void *des;
      void *sha1;

      passwd_bytes = g_strlen(passwd);
      sha1 = ssl_sha1_info_create();
      ssl_sha1_transform(sha1, "xrdp_vnc", 8);
      ssl_sha1_transform(sha1, passwd, passwd_bytes);
      ssl_sha1_transform(sha1, passwd, passwd_bytes);
      ssl_sha1_complete(sha1, passwd_hash);
      g_snprintf(passwd_hash_text, 39, "%2.2x%2.2x%2.2x%2.2x",
                 passwd_hash[0], passwd_hash[1],
                 passwd_hash[2], passwd_hash[3]);
      passwd = passwd_hash_text;

      g_strncpy(encryptedPasswd, passwd, 8);
      g_mirror_memcpy(key, g_fixedkey, 8);
      des = ssl_des3_encrypt_info_create(key, 0);
      ssl_des3_encrypt(des, 8, encryptedPasswd, encryptedPasswd);
      fd = g_file_open_ex(filename, 0, 1, 1, 1);
      g_file_write(fd, encryptedPasswd, 8);
      g_file_close(fd);
      return 0;
  }

  static int
  session_start_fork(int width, int height, int bpp, char *username,
                     char *password, long data, unsigned char type)
  {
      char *passwd_file;

      if (type == 0) /* SESMAN_SESSION_TYPE_XVNC */
      {
          env_set_user(username, &passwd_file, 0);
          env_check_password_file(passwd_file, password);
      }
      return 0;
  }
  ```

test "rank1973: the fixed revision seeds the same file with the per-session random GUID string"
  lang c
  file session_guid.c
  reject VYQL-AUTH-107
  code
  ```
  /* Modelled on the same branch at the fix (57905d7): the file helper is
     unchanged, but the value it receives is the hex string of the
     session GUID filled by g_random in sesman/scp_v0.c, so nothing
     derived from the login password is persisted. */
  extern int g_snprintf(char *dest, int len, const char *fmt, ...);
  extern void env_set_user(const char *username, char **passwd_file,
                           int display);
  extern int env_check_password_file(const char *filename,
                                     const char *passwd);

  static int
  session_start_fork(int width, int height, int bpp, char *username,
                     unsigned char *guid, long data, unsigned char type)
  {
      char *passwd_file;
      char guid_str[64];
      char *pguid_str;
      int index;

      if (type == 0) /* SESMAN_SESSION_TYPE_XVNC */
      {
          env_set_user(username, &passwd_file, 0);
          if (guid != 0)
          {
              pguid_str = guid_str;
              for (index = 0; index < 16; index++)
              {
                  g_snprintf(pguid_str, 4, "%2.2x", guid[index]);
                  pguid_str += 2;
              }
              guid_str[32] = 0;
              env_check_password_file(passwd_file, guid_str);
          }
      }
      return 0;
  }
  ```

test "rank1973: an argument spelled password reaching a call is the ordinary idiom of every authentication path"
  lang c
  file password_check.c
  reject VYQL-AUTH-107
  code
  ```
  /* The precision wall for any name-keyed shortcut: passing a value
     spelled `password` to a call is what every login verification does
     (78 such call sites in this tree), and nothing is persisted here.
     The discriminator has to know that the callee persists the value in
     a recoverable form, which is exactly the fact no layer holds. */
  extern int check_password_against_hash(const char *username,
                                         const char *password);

  int
  verify_login(const char *username, const char *password)
  {
      if (check_password_against_hash(username, password) != 0)
      {
          return 1;
      }
      return 0;
  }
  ```
