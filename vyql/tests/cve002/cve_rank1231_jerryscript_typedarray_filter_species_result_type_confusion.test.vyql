# Rank 1231 / CVE-2021-42863: JerryScript's `%TypedArray%.prototype.filter`
# in jerry-core/ecma/builtin-objects/typedarray/ecma-builtin-typedarray-prototype.c
# collects the elements the callback keeps into a local byte array sized from
# the *source* typed array (`info_p->length * info_p->element_size`), then asks
# `ecma_typedarray_species_create` for the result object and copies the whole
# local array into it with
# `memcpy (ecma_typedarray_get_buffer (obj_p), pass_value_list_p, pass_value_p - pass_value_list_p)`.
# The species constructor is script-reachable: assigning a different typed array
# constructor to the receiver's `constructor` property makes the result a typed
# array with a smaller element type, so the byte count taken from the source
# overruns the result's buffer. `test(Float64Array, Float32Array)` with a
# five-element source writes eight bytes per kept element into a buffer that
# holds four, a heap out-of-bounds write reachable from ordinary script
# (CWE-843 leading to CWE-787).
#
# Fix 4e8d6344a8b5cf8f00bd3d5e869147af06d0189e (the pool row carries the flag
# because the advisory references only issue #4793 and pull request #4794, not a
# commit; that pull request's single commit is this one, its message and diff
# match the advisory, and it is not a release bump -- no pool correction needed)
# drops the raw copy. It buffers the kept values as ecma values in an
# `ecma_collection_t`, reads the *result's* own metadata with
# `ecma_typedarray_get_info (obj_p)`, and writes each value through
# `ecma_get_typedarray_setter_fn (target_info.id)`, advancing by the result's
# `element_size`, so every value is converted into the result's value range.
#
# code.SpeciesResultBufferMissingElementTypeCheck (VYQL-MEM-054) names the
# shape: a raw memory copy whose destination is the buffer of an object a
# species constructor produced, in a function that never reads that object's
# own element type or size. Any correct implementation has to consult the
# result's element metadata, because the ECMAScript species protocol lets
# script pick the result's constructor, so reading it is the neutralising
# control the binding checks for.
#
# verify_current_expected: fixed

test "rank1231: filter copies raw source bytes into the species-created result buffer"
  lang c
  expect VYQL-MEM-054
  file ecma-builtin-typedarray-prototype.c
  ```
  static ecma_value_t
  ecma_builtin_typedarray_prototype_filter (ecma_value_t this_arg,
                                            ecma_typedarray_info_t *info_p,
                                            ecma_value_t cb_func_val,
                                            ecma_value_t cb_this_arg)
  {
    ecma_typedarray_getter_fn_t getter_cb = ecma_get_typedarray_getter_fn (info_p->id);
    ecma_object_t *func_object_p = ecma_get_object_from_value (cb_func_val);
    ecma_value_t ret_value = ECMA_VALUE_ERROR;

    if (info_p->length == 0)
    {
      return ecma_op_create_typedarray_with_type_and_length (info_p->id, 0);
    }

    JMEM_DEFINE_LOCAL_ARRAY (pass_value_list_p, info_p->length * info_p->element_size, lit_utf8_byte_t);

    lit_utf8_byte_t *pass_value_p = pass_value_list_p;
    uint32_t byte_pos = 0;

    for (uint32_t index = 0; index < info_p->length; index++)
    {
      ecma_value_t current_index = ecma_make_uint32_value (index);
      ecma_value_t get_value = getter_cb (info_p->buffer_p + byte_pos);
      ecma_value_t call_args[] = { get_value, current_index, this_arg };
      ecma_value_t call_value = ecma_op_function_call (func_object_p, cb_this_arg, call_args, 3);

      ecma_fast_free_value (current_index);
      ecma_fast_free_value (get_value);

      if (ECMA_IS_VALUE_ERROR (call_value))
      {
        goto cleanup;
      }

      if (ecma_op_to_boolean (call_value))
      {
        memcpy (pass_value_p, info_p->buffer_p + byte_pos, info_p->element_size);
        pass_value_p += info_p->element_size;
      }

      byte_pos += info_p->element_size;
      ecma_free_value (call_value);
    }

    uint32_t pass_num = (uint32_t) ((pass_value_p - pass_value_list_p) >> info_p->shift);
    ecma_value_t collected = ecma_make_number_value (pass_num);
    ret_value = ecma_typedarray_species_create (this_arg, &collected, 1);
    ecma_free_value (collected);

    if (!ECMA_IS_VALUE_ERROR (ret_value))
    {
      ecma_object_t *obj_p = ecma_get_object_from_value (ret_value);

      JERRY_ASSERT (ecma_typedarray_get_offset (obj_p) == 0);

      memcpy (ecma_typedarray_get_buffer (obj_p),
              pass_value_list_p,
              (size_t) (pass_value_p - pass_value_list_p));
    }

  cleanup:
    JMEM_FINALIZE_LOCAL_ARRAY (pass_value_list_p);

    return ret_value;
  }
  ```

test "rank1231: filter writes each kept value through the result's own element setter"
  lang c
  reject VYQL-MEM-054
  file ecma-builtin-typedarray-prototype.c
  ```
  static ecma_value_t
  ecma_builtin_typedarray_prototype_filter (ecma_value_t this_arg,
                                            ecma_typedarray_info_t *info_p,
                                            ecma_value_t cb_func_val,
                                            ecma_value_t cb_this_arg)
  {
    ecma_typedarray_getter_fn_t getter_cb = ecma_get_typedarray_getter_fn (info_p->id);
    ecma_object_t *func_object_p = ecma_get_object_from_value (cb_func_val);
    ecma_value_t ret_value = ECMA_VALUE_ERROR;

    if (info_p->length == 0)
    {
      return ecma_op_create_typedarray_with_type_and_length (info_p->id, 0);
    }

    ecma_collection_t *collected_p = ecma_new_collection ();
    uint32_t byte_pos = 0;

    for (uint32_t index = 0; index < info_p->length; index++)
    {
      ecma_value_t current_index = ecma_make_uint32_value (index);
      ecma_value_t get_value = getter_cb (info_p->buffer_p + byte_pos);
      ecma_value_t call_args[] = { get_value, current_index, this_arg };
      ecma_value_t call_value = ecma_op_function_call (func_object_p, cb_this_arg, call_args, 3);

      ecma_fast_free_value (current_index);

      if (ECMA_IS_VALUE_ERROR (call_value))
      {
        ecma_fast_free_value (get_value);
        goto cleanup;
      }

      if (ecma_op_to_boolean (call_value))
      {
        ecma_collection_push_back (collected_p, get_value);
      }
      else
      {
        ecma_fast_free_value (get_value);
      }

      byte_pos += info_p->element_size;
      ecma_fast_free_value (call_value);
    }

    ecma_value_t collected = ecma_make_number_value (collected_p->item_count);
    ret_value = ecma_typedarray_species_create (this_arg, &collected, 1);
    ecma_free_value (collected);

    if (!ECMA_IS_VALUE_ERROR (ret_value))
    {
      ecma_object_t *obj_p = ecma_get_object_from_value (ret_value);
      ecma_typedarray_info_t target_info = ecma_typedarray_get_info (obj_p);

      JERRY_ASSERT (target_info.offset == 0);

      ecma_typedarray_setter_fn_t target_typedarray_setter_cb = ecma_get_typedarray_setter_fn (target_info.id);
      uint32_t target_byte_index = 0;

      for (uint32_t idx = 0; idx < collected_p->item_count; idx++)
      {
        ecma_value_t set_element = target_typedarray_setter_cb (target_info.buffer_p + target_byte_index,
                                                                collected_p->buffer_p[idx]);

        if (ECMA_IS_VALUE_ERROR (set_element))
        {
          goto cleanup;
        }

        target_byte_index += target_info.element_size;
      }
    }

  cleanup:
    ecma_collection_free (collected_p);

    return ret_value;
  }
  ```

# A raw copy into the species-created result is safe once the function reads
# that result's own element metadata and sizes the copy from it, so the
# metadata read is the neutralising control rather than the absence of memcpy.

test "rank1231: a raw copy sized from the result's own element metadata is not reported"
  lang c
  reject VYQL-MEM-054
  file ecma-builtin-typedarray-prototype.c
  ```
  static ecma_value_t
  ecma_builtin_typedarray_prototype_filter (ecma_value_t this_arg,
                                            ecma_typedarray_info_t *info_p,
                                            ecma_value_t cb_func_val,
                                            ecma_value_t cb_this_arg)
  {
    ecma_value_t ret_value = ECMA_VALUE_ERROR;

    JMEM_DEFINE_LOCAL_ARRAY (pass_value_list_p, info_p->length * info_p->element_size, lit_utf8_byte_t);

    lit_utf8_byte_t *pass_value_p = pass_value_list_p;
    uint32_t pass_num = (uint32_t) ((pass_value_p - pass_value_list_p) >> info_p->shift);
    ecma_value_t collected = ecma_make_number_value (pass_num);

    ret_value = ecma_typedarray_species_create (this_arg, &collected, 1);
    ecma_free_value (collected);

    if (!ECMA_IS_VALUE_ERROR (ret_value))
    {
      ecma_object_t *obj_p = ecma_get_object_from_value (ret_value);
      ecma_typedarray_info_t target_info = ecma_typedarray_get_info (obj_p);

      if (target_info.id == info_p->id)
      {
        memcpy (ecma_typedarray_get_buffer (obj_p),
                pass_value_list_p,
                (size_t) (target_info.length * target_info.element_size));
      }
    }

    JMEM_FINALIZE_LOCAL_ARRAY (pass_value_list_p);

    return ret_value;
  }
  ```

# Most typed array builtins hand the species-created object straight back to
# the caller and never touch its buffer, so calling the species constructor is
# not itself the finding.

test "rank1231: a builtin that returns the species-created result untouched is not reported"
  lang c
  reject VYQL-MEM-054
  file ecma-builtin-typedarray-prototype.c
  ```
  static ecma_value_t
  ecma_builtin_typedarray_prototype_subarray (ecma_value_t this_arg,
                                              ecma_typedarray_info_t *info_p,
                                              ecma_value_t begin,
                                              ecma_value_t end)
  {
    uint32_t begin_index_uint32 = 0;
    uint32_t subarray_length = 0;
    uint32_t begin_byte_offset = info_p->offset + begin_index_uint32 * info_p->element_size;

    ecma_value_t arguments_p[3] =
    {
      ecma_make_object_value (info_p->array_buffer_p),
      ecma_make_uint32_value (begin_byte_offset),
      ecma_make_uint32_value (subarray_length)
    };

    ecma_value_t ret_value = ecma_typedarray_species_create (this_arg, arguments_p, 3);

    ecma_free_value (arguments_p[1]);
    ecma_free_value (arguments_p[2]);

    return ret_value;
  }
  ```
