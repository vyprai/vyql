# Rank 1301 / CVE-2019-6978: libgd's gdImageJpegPtr() (and the gdImageGifPtr()
# and gdImageWBMPPtr() siblings) called the void gdImage*Ctx() writer and then
# unconditionally handed the dynamic gdIOCtx to gdDPExtractData() and freed it
# with out->gd_free(out). gdImageJpegCtx() has internal early-return failure
# paths (a failed row allocation, a longjmp out of libjpeg's fatal error
# handler) that leave the dynamic buffer never populated, but the void return
# type gives the Ptr() wrapper no way to see that, so it extracts and frees an
# IO context built from a write that never happens. The fixed revision
# introduces static helpers (_gdImageJpegCtx() etc.) that return 0 on success
# and 1 on failure, and gates the extract on that result.
#
# ATTENTION, engine gap: no rule reports the wrapper at either revision. The
# full findings view over the real revision pair (three --cache off runs per
# side, timeout 180, --max-ram 6GB) returns the identical rule mix on both
# sides -- 1901 findings each -- with zero findings inside any of the three
# wrappers; the only cross-revision difference is three extra VYQL-MEM-005
# rows at gdft.c:1795 on the fixed side, a file the fix does not touch, i.e.
# a cross-file effect of the new branch structure in the wrong direction for
# coverage. Resolution is not the blocker on the real tree: `vyql resolve` on
# the vulnerable src/gd_jpeg.c reports 42 resolved call sites including
# gdImageJpegCtx and gdDPExtractData, and taint paths traverse
# gdDPExtractData -> trimDynamic -> gdReallocDynamic interprocedurally, so the
# engine sees the calls and simply has no observation for a void writer whose
# failure is visible only inside its own body. No binding, concept or rule in
# the knowledge base names gdDPExtractData, gdNewDynamicCtx or any
# gdImage*Ctx writer.
#
# A caller-side binding cannot carry this: the caller shape is provably not
# the discriminator. gdImageGdPtr (src/gd_gd.c) is token-for-token the same
# caller -- bare void writer call, then unconditional gdDPExtractData, then
# out->gd_free(out) -- and is safe, because _gdImageGd has no failure path at
# all; gdImagePngPtr and gdImageBmpPtr already gate their extracts on
# int-returning helpers at the vulnerable revision; and gdImageGifAnimAddPtr
# repeats the ungated void-writer form with a real internal failure path
# (`if (!pim) return;` in gdImageGifAnimAddCtx) under a name outside this
# CVE's three. Whether the ungated form is a finding depends entirely on the
# callee's internal early returns, which no function-scope predicate can see,
# so keying on the three names is a repro list that the next member of the
# class (gdImageGifAnimAddPtr today) walks past, and keying on the fixed
# form's helper rename encodes the fix's own layout rather than its contract.
# libgd's own documentation states no failure contract either: gd.h declares
# the Ctx writers as plain void writers, and gd_io_dp.c's comment for
# gdDPExtractData promises only that it "will return the pointer to the
# internal data, and reset the internal storage".
#
# Detecting this needs a sequence-sensitive observation over two statements
# (a void call with an internal early-return failure path, followed by an
# unconditional extract-then-free of a resource that call is supposed to
# populate) that no existing declarative binding predicate can express; the
# closest prior art, ccLifetimeReleaseReturnObservations and
# ccReallocFailureInputFreeObservations in internal/extract/frontend/treesitter/c.go,
# both introduced a new classification for their own shape rather than reusing
# one, and this shape is a third: return-value-free void writer + no-fail-
# signal caller. Minting that classification and its regex is a design call
# this loop does not make unreviewed, so this stays a gap rather than a
# same-iteration fix. VYQL-MEM-011 (code.FailurePathOwnedBufferFree, CWE-415)
# is the rule this shape converts under once the observation exists; its
# generated wrapper already consumes node.analysis ~= "lifetime.release_then_return".
#
# verify_current_expected: attention-engine-gap

test "rank1301: JpegPtr extracts and frees the IO context without checking whether the Ctx writer failed"
  lang c
  file src/gd_jpeg.c
  reject VYQL-MEM-008
  reject VYQL-MEM-011
  code
  ```
  typedef struct gdImageStruct *gdImagePtr;
  typedef struct gdIOCtx gdIOCtx;

  struct gdIOCtx {
      void (*gd_free)(struct gdIOCtx *ctx);
  };

  gdIOCtx *gdNewDynamicCtx(int initialSize, void *data);
  void *gdDPExtractData(gdIOCtx *ctx, int *size);
  void gdImageJpegCtx(gdImagePtr im, gdIOCtx *outfile, int quality);

  void *gdImageJpegPtr(gdImagePtr im, int *size, int quality)
  {
      void *rv;
      gdIOCtx *out = gdNewDynamicCtx(2048, NULL);
      if (out == NULL) return NULL;
      gdImageJpegCtx(im, out, quality);
      rv = gdDPExtractData(out, size);
      out->gd_free(out);
      return rv;
  }
  ```

test "rank1301: fix gates the extract on the Ctx writer's own success/failure result"
  lang c
  file src/gd_jpeg.c
  reject VYQL-MEM-008
  reject VYQL-MEM-011
  code
  ```
  typedef struct gdImageStruct *gdImagePtr;
  typedef struct gdIOCtx gdIOCtx;

  struct gdIOCtx {
      void (*gd_free)(struct gdIOCtx *ctx);
  };

  gdIOCtx *gdNewDynamicCtx(int initialSize, void *data);
  void *gdDPExtractData(gdIOCtx *ctx, int *size);
  static int _gdImageJpegCtx(gdImagePtr im, gdIOCtx *outfile, int quality);

  void *gdImageJpegPtr(gdImagePtr im, int *size, int quality)
  {
      void *rv;
      gdIOCtx *out = gdNewDynamicCtx(2048, NULL);
      if (out == NULL) return NULL;
      if (!_gdImageJpegCtx(im, out, quality)) {
          rv = gdDPExtractData(out, size);
      } else {
          rv = NULL;
      }
      out->gd_free(out);
      return rv;
  }
  ```
