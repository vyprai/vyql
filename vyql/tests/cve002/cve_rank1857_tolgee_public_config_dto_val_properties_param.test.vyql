test "rank1857: the same member declared in the class body is the spelling the frontend does lower"
  lang kotlin
  file PublicConfigurationDTO.kt
  reject VYQL-SEC-041
  code
  ```
  import io.tolgee.configuration.tolgee.TolgeeProperties
  import org.springframework.web.bind.annotation.CrossOrigin
  import org.springframework.web.bind.annotation.GetMapping
  import org.springframework.web.bind.annotation.RequestMapping
  import org.springframework.web.bind.annotation.RestController

  @RestController
  @CrossOrigin(origins = ["*"])
  @RequestMapping("/api/public/")
  class ConfigurationController(
    private val configuration: TolgeeProperties,
  ) {
    @GetMapping(value = ["configuration"])
    fun getPublicConfiguration(): PublicConfigurationDTO {
      return PublicConfigurationDTO(properties = configuration)
    }
  }

  class PublicConfigurationDTO(
    properties: TolgeeProperties,
  ) {
    val properties: TolgeeProperties = properties

    val appName: String = properties.appName
    val maxUploadFileSize: Int = properties.maxUploadFileSize
  }
  ```

test "rank1857: a constructor-injected configuration object in a non-response component is the ordinary idiom"
  lang kotlin
  file StartupImportCommandLineRunner.kt
  reject VYQL-SEC-041
  code
  ```
  import io.tolgee.configuration.tolgee.TolgeeProperties

  class StartupImportCommandLineRunner(
    val tolgeeProperties: TolgeeProperties,
  ) {
    fun run(args: Array<String>) {
      if (!tolgeeProperties.import.enabled) {
        return
      }
      importData(tolgeeProperties.import.path)
    }

    fun importData(path: String) {}
  }
  ```

test "rank1857: returning the configuration object itself is the same leak in a form no Kotlin binding covers either"
  lang kotlin
  file ConfigurationController.kt
  reject VYQL-SEC-041
  code
  ```
  import io.tolgee.configuration.tolgee.TolgeeProperties
  import org.springframework.web.bind.annotation.CrossOrigin
  import org.springframework.web.bind.annotation.GetMapping
  import org.springframework.web.bind.annotation.RequestMapping
  import org.springframework.web.bind.annotation.RestController

  @RestController
  @CrossOrigin(origins = ["*"])
  @RequestMapping("/api/public/")
  class ConfigurationController(
    private val configuration: TolgeeProperties,
  ) {
    @GetMapping(value = ["configuration"])
    fun getPublicConfiguration(): TolgeeProperties {
      return configuration
    }
  }
