                  r := mload(add(signature, 0x20))
                  s := mload(add(signature, 0x40))
                  v := byte(0, mload(add(signature, 0x60)))
              }
              return tryRecover(hash, r, s, v);
          } else {
              revert("ECDSA: invalid signature length");
          }
      }

      function tryRecover(bytes32, bytes32, bytes32, uint8) internal pure returns (address) {
          revert("not implemented in snippet");
      }
  }
  ```
