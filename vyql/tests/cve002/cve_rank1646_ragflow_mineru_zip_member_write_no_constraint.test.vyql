  import io
  import os
  import tarfile


  def test_sync_nodes_only_diff(tmp_source, tmp_target, node_ip, sync):
      with open(os.path.join(tmp_source, "level0_new.txt"), "w") as f:
          f.write("Data\n")

      unpack, pack_actor, files_stats = sync(
          source_ip=node_ip,
          source_path=tmp_source,
          target_ip=node_ip,
          target_path=tmp_target,
      )

      tarball = pack_actor.get_full_data()
      with tarfile.open(fileobj=io.BytesIO(tarball)) as tar:
          files_in_tar = tar.getnames()
          assert "subdir/level1.txt" in files_in_tar
