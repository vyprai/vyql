  import os
  import tarfile


  def extract_archive_to_dir(archive_path, dest_dir):
      os.makedirs(dest_dir, exist_ok=True)
      with tarfile.open(archive_path, "r") as tar:
          for member in tar.getmembers():
              pass
          tar.extractall(path=dest_dir, filter="data")
      return dest_dir
