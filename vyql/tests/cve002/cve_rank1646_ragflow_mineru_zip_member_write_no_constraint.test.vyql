test "rank1646: (e) a tar member written per entry with no constraint is the same weakness"
  lang python
  expect VYQL-PATH-007
  expect_review code.ArchiveSymlinkFilterBypass
  code
  ```
  import os
  import tarfile


  def unpack_tarball(tar_path, dest_dir):
      with tarfile.open(tar_path) as tar:
          for member in tar.getmembers():
              if member.isreg():
                  target = os.path.join(dest_dir, member.name)
                  os.makedirs(os.path.dirname(target), exist_ok=True)
                  with open(target, "wb") as out:
                      out.write(tar.extractfile(member).read())
  ```

test "rank1646: (f) a manual loop that rejects `..` components and non-relative names stays quiet"
  lang python
  reject VYQL-PATH-007
  reject_review code.ArchiveSymlinkFilterBypass
  code
  ```
  import os
  import zipfile


  def unpack(local_path, dest):
      with zipfile.ZipFile(local_path) as archive:
          for name in archive.namelist():
              if os.path.isabs(name) or name.startswith("\\"):
                  raise ValueError(f"absolute member name: {name}")
              parts = name.replace("\\", "/").split("/")
              if any(p == ".." for p in parts):
                  raise ValueError(f"traversal member name: {name}")
              target = os.path.join(dest, *parts)
              os.makedirs(os.path.dirname(target), exist_ok=True)
              with open(target, "wb") as out:
                  out.write(archive.read(name))
  ```

