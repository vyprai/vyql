  file src/Umbraco.Core/Services/TemporaryFileService.cs
  code
  ```
  using System.IO;

  namespace Umbraco.Cms.Api.Management.Controllers.TemporaryFile
  {
      public class TemporaryFileModelBase
      {
          public string FileName { get; set; } = string.Empty;
          public System.Guid Key { get; set; }
      }

      public class CreateTemporaryFileModel : TemporaryFileModelBase
      {
          public required Func<Stream> OpenReadStream { get; set; }
      }

      public class TemporaryFileModel : CreateTemporaryFileModel
      {
          public DateTime AvailableUntil { get; set; }
      }

      public class TemporaryFileService
      {
          private readonly LocalFileSystemTemporaryFileRepository _temporaryFileRepository;

          public async Task<TemporaryFileModel?> CreateAsync(CreateTemporaryFileModel createModel)
          {
              if (Validate(createModel) != 0)
              {
                  return null;
              }

              var temporaryFileModel = new TemporaryFileModel
              {
                  Key = createModel.Key,
                  FileName = createModel.FileName,
                  OpenReadStream = createModel.OpenReadStream,
                  AvailableUntil = DateTime.Now.AddDays(1)
              };

              await _temporaryFileRepository.SaveAsync(temporaryFileModel);
              return temporaryFileModel;
          }

          private int Validate(TemporaryFileModelBase temporaryFileModel)
          {
              if (IsAllowedFileExtension(temporaryFileModel.FileName) == false)
              {
                  return 1;
              }

              if (IsValidFileName(temporaryFileModel.FileName) == false)
              {
                  return 5;
              }

              return 0;
          }

          private bool IsAllowedFileExtension(string fileName)
          {
              var extension = Path.GetExtension(fileName)[1..];
              return extension == "txt";
          }

          private static bool IsValidFileName(string fileName) =>
              !string.IsNullOrEmpty(fileName) && fileName.IndexOfAny(Path.GetInvalidFileNameChars()) < 0;
      }
  }
  ```
