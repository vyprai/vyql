# Rank 1047 / CVE-2026-27211: cloud-hypervisor protected sector 0 of a raw disk
# image against guest writes, but only for the write request type (CWE-73).
# check_request in virtio-devices/src/block.rs guarded one arm:
#
#   if request_type == RequestType::Out && disable_sector0_writes && request.sector == 0 {
#       return Err(...);
#   }
#
# Discard and WriteZeroes carry their own sector numbers inside the request
# payload, read later in Request::execute_async in block/src/lib.rs, and nothing
# checked those, so a guest could still zero sector 0 and rewrite the header that
# decides how the host interprets the image. The fixed revision threads
# disable_sector0_writes into execute_async and rejects discard_sector == 0 and
# wz_offset == 0 there.
#
# ATTENTION, and it is the same missing relation recorded for ranks 1039
# and 1040: a guard covers one branch of a request-type dispatch and not the
# siblings that have the same effect. No branch is wrong when read alone, and
# nothing compares a guard across the arms of a dispatch, so there is no
# condition to state. Three ranks in this block now turn on it, in three
# languages and three protocols, which makes it the most repeated cause here.
#
# The discriminator that is present in the code is the request-type constant,
# and keying on RequestType::Out, Discard and WriteZeroes detects this device
# model rather than the weakness, exactly as POOL_OP_ and smallscep.UpdateReq
# would have at 1039 and 1040.
#
# Both revisions of block/src/lib.rs report the same 14 findings, every one
# VYQL-MEM-006 at low confidence, and none about the sector check.
#
# verify_current_expected: attention-analysis-gap

test "rank1047: the sector zero guard covers the write type only"
  lang rust
  file virtio-devices/src/block.rs
  reject VYQL-AUTH-001
  code
  ```
  impl BlockEpollHandler {
      fn check_request(
          acked_features: u64,
          request: &Request,
          disable_sector0_writes: bool,
      ) -> result::Result<(), Error> {
          let request_type = request.request_type;

          if request_type == RequestType::Out && disable_sector0_writes && request.sector == 0 {
              return Err(Error::InvalidSector0Write);
          }

          if request_type == RequestType::Discard && !block_features::discard(acked_features) {
              return Err(Error::UnsupportedRequest);
          }

          Ok(())
      }

      fn process_queue(&mut self) -> result::Result<(), Error> {
          for mut desc_chain in self.queue.iter().unwrap() {
              let request = Request::parse(&mut desc_chain, &self.mem)?;

              Self::check_request(self.acked_features, &request, self.disable_sector0_writes)?;

              request.execute_async(
                  &self.mem,
                  self.disk_nsectors.load(Ordering::SeqCst),
                  self.disk_image.as_mut(),
                  &self.serial,
                  desc_chain.head_index() as u64,
              )?;
          }

          Ok(())
      }
  }
  ```

test "rank1047: the discard path reads its own sector and does not check it"
  lang rust
  file block/src/lib.rs
  reject VYQL-AUTH-001
  code
  ```
  impl Request {
      pub fn execute_async(
          &mut self,
          mem: &GuestMemoryMmap,
          disk_nsectors: u64,
          disk_image: &mut dyn AsyncIo,
          serial: &[u8],
          user_data: u64,
      ) -> result::Result<ExecuteAsync, ExecuteError> {
          match self.request_type {
              RequestType::Discard => {
                  let mut discard_sector = [0u8; 8];
                  let mut discard_num_sectors = [0u8; 4];
                  mem.read_slice(&mut discard_sector, data_addr)
                      .map_err(ExecuteError::Read)?;

                  let discard_sector = u64::from_le_bytes(discard_sector);
                  let discard_num_sectors = u32::from_le_bytes(discard_num_sectors);

                  let discard_offset = discard_sector * SECTOR_SIZE;
                  let discard_length = (discard_num_sectors as u64) * SECTOR_SIZE;

                  disk_image
                      .discard(discard_offset, discard_length, user_data)
                      .map_err(ExecuteError::Discard)?;
              }
              _ => {}
          }

          Ok(ExecuteAsync::default())
      }
  }
  ```

test "rank1047: fix rejects sector zero on the discard path too"
  lang rust
  file block/src/lib.rs
  reject VYQL-AUTH-001
  code
  ```
  impl Request {
      pub fn execute_async(
          &mut self,
          mem: &GuestMemoryMmap,
          disk_nsectors: u64,
          disk_image: &mut dyn AsyncIo,
          serial: &[u8],
          disable_sector0_writes: bool,
          user_data: u64,
      ) -> result::Result<ExecuteAsync, ExecuteError> {
          match self.request_type {
              RequestType::Discard => {
                  let mut discard_sector = [0u8; 8];
                  let mut discard_num_sectors = [0u8; 4];
                  mem.read_slice(&mut discard_sector, data_addr)
                      .map_err(ExecuteError::Read)?;

                  let discard_sector = u64::from_le_bytes(discard_sector);

                  if discard_sector == 0 && disable_sector0_writes {
                      return Err(ExecuteError::BadRequest(Error::InvalidOffset));
                  }

                  let discard_num_sectors = u32::from_le_bytes(discard_num_sectors);

                  let discard_offset = discard_sector * SECTOR_SIZE;
                  let discard_length = (discard_num_sectors as u64) * SECTOR_SIZE;

                  disk_image
                      .discard(discard_offset, discard_length, user_data)
                      .map_err(ExecuteError::Discard)?;
              }
              _ => {}
          }

          Ok(ExecuteAsync::default())
      }
  }
  ```
