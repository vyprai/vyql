# Rank 1544 / CVE-2025-70888: osslsigncode verified the signer
# certificate's extended key usage but never its keyUsage
# digitalSignature bit, so signing with a certificate whose key usage
# does not permit signatures produced Authenticode signatures the
# platform must reject (improper certificate validation, CWE-295;
# issue #475 / PR #477). verify_authenticode in osslsigncode.c
# checked only `if (!(X509_get_extended_key_usage(signer) &
# XKU_CODE_SIGN)) { fprintf(...); goto out; }` -- the RFC 5280
# section 4.2.1.3 keyUsage constraint went unchecked. POOL
# CORRECTION applied in place: the row held d787541107 (a
# test-certificate companion change -- the nocommit flag was right);
# the real fix is 6390ae2, "Add keyUsage digitalSignature validation
# for signer certificate", found from the advisory's PR #477
# reference. The fix adds `if (!(X509_get_key_usage(signer) &
# X509v3_KU_DIGITAL_SIGNATURE)) { fprintf(stderr, "Signer
# certificate rejected: keyUsage does not permit
# digitalSignature\n"); goto out; }`. No further pool correction.
#
# ATTENTION, certificate-usage validation. The check that exists
# covers one RFC 5280 extension while the sibling constraint is
# absent -- constraint-completeness over certificate extensions,
# the same present-but-incomplete family as ranks 1540 (permission
# branches) and 1564 (unquoted bind types): nothing can ask "does
# the signer validation cover every extension its signature type
# requires" -- X509 extension semantics are protocol vocabulary. A
# binding on osslsigncode's own verify_authenticode would detect
# this tool rather than the weakness. Measured on the real code:
# scanning osslsigncode.c reports 147 findings at both revisions
# (memory heuristics; none change). No ENGINE-GAPS.md entry. No
# definition change shipped. Spec cve_rank1544 records the
# eku-only check and the keyUsage-gated form, both asserting reject
# VYQL-CRY-024: when certificate-usage vocabulary lands, the eku-only
# form must flip to expect.

test "rank1544: the signer certificate is judged by one extension"
  lang c
  file osslsigncode.c
  reject VYQL-CRY-024
  code
  ```
  #include <stdio.h>

  #define XKU_CODE_SIGN 0x0001

  typedef struct X509 X509;

  int X509_get_extended_key_usage(const X509 *x);
  int X509_get_key_usage(const X509 *x);

  static int verify_signer(X509 *signer)
  {
      /* check extended key usage flag XKU_CODE_SIGN */
      if (!(X509_get_extended_key_usage(signer) & XKU_CODE_SIGN)) {
          fprintf(stderr, "Unsupported Signer's certificate purpose XKU_CODE_SIGN\n");
          return 0;
      }
      return 1;
  }
  ```

test "rank1544: the fix also requires the signature bit"
  lang c
  file osslsigncode.c
  reject VYQL-CRY-024
  code
  ```
  #include <stdio.h>

  #define XKU_CODE_SIGN 0x0001
  #define X509v3_KU_DIGITAL_SIGNATURE 0x0001

  typedef struct X509 X509;

  int X509_get_extended_key_usage(const X509 *x);
  int X509_get_key_usage(const X509 *x);

  static int verify_signer(X509 *signer)
  {
      /*
       * Verify that:
       * - extendedKeyUsage, if present, permits codeSigning (RFC 5280 section 4.2.1.12)
       * - keyUsage, if present, permits digitalSignature (RFC 5280 section 4.2.1.3)
       */
      if (!(X509_get_extended_key_usage(signer) & XKU_CODE_SIGN)) {
          fprintf(stderr, "Signer certificate rejected: extendedKeyUsage does not permit codeSigning\n");
          return 0;
      }
      if (!(X509_get_key_usage(signer) & X509v3_KU_DIGITAL_SIGNATURE)) {
          fprintf(stderr, "Signer certificate rejected: keyUsage does not permit digitalSignature\n");
          return 0;
      }
      return 1;
  }
  ```
