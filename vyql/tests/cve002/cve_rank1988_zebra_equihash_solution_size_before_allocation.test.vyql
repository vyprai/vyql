  code
  ```
  //! Equihash Solution and related items.

  use std::io;

  use crate::serialization::{
      CompactSizeMessage, SerializationError, ZcashDeserialize, ZcashDeserializeInto,
      ZcashSerialize,
  };

  /// The size of an Equihash solution in bytes (always 1344).
  pub(crate) const SOLUTION_SIZE: usize = 1344;

  /// The size of an Equihash solution in bytes on Regtest (always 36).
  pub(crate) const REGTEST_SOLUTION_SIZE: usize = 36;

  pub enum Solution {
      Common([u8; SOLUTION_SIZE]),
      Regtest([u8; REGTEST_SOLUTION_SIZE]),
  }

  impl Solution {
      pub fn from_bytes(bytes: &[u8]) -> Result<Self, SerializationError> {
          match bytes.len() {
              SOLUTION_SIZE => Ok(Solution::Common(bytes.try_into().unwrap())),
              REGTEST_SOLUTION_SIZE => Ok(Solution::Regtest(bytes.try_into().unwrap())),
              length => Err(SerializationError::Parse(
                  "incorrect equihash solution size",
              )),
          }
      }
  }

  impl ZcashDeserialize for Solution {
      fn zcash_deserialize<R: io::Read>(mut reader: R) -> Result<Self, SerializationError> {
          let len: CompactSizeMessage = (&mut reader).zcash_deserialize_into()?;
          let len: usize = len.into();

          if len > SOLUTION_SIZE {
              return Err(SerializationError::Parse(
                  "incorrect equihash solution size",
              ));
          }

          // the fix's helper renamed: the comparison, not the name, must carry
          let solution = read_zcash_byte_vector(len, &mut reader)?;
          Self::from_bytes(&solution)
      }
  }
  ```

test "rank1988: the fixed-size read every other consensus type uses, with no length prefix at all"
  lang rust
  file equihash.rs
  reject VYQL-DOS-006
  reject_review code.LengthDerivedAllocation
  code
  ```
  //! Equihash Solution and related items.

  use std::io;

  use crate::serialization::{SerializationError, ZcashDeserialize, ZcashSerialize};

  /// The size of an Equihash solution in bytes (always 1344).
  pub(crate) const SOLUTION_SIZE: usize = 1344;

  /// The size of an Equihash solution in bytes on Regtest (always 36).
  pub(crate) const REGTEST_SOLUTION_SIZE: usize = 36;

  pub enum Solution {
      Common([u8; SOLUTION_SIZE]),
      Regtest([u8; REGTEST_SOLUTION_SIZE]),
  }

  impl ZcashDeserialize for Solution {
      fn zcash_deserialize<R: io::Read>(mut reader: R) -> Result<Self, SerializationError> {
          let mut bytes = [0u8; SOLUTION_SIZE];
          reader.read_exact(&mut bytes)?;
          Ok(Solution::Common(bytes))
      }
  }
  ```

test "rank1988: a byte vector narrowed by another type's constructor is not this shape"
  lang rust
  file backup.rs
  reject VYQL-DOS-006
  reject_review code.LengthDerivedAllocation
  code
  ```
  use std::{io, sync::Arc};

  use crate::{amount::Amount, block::Block, serialization::ZcashDeserializeInto};

  pub struct NonFinalizedBlockBackup {
      pub block: Arc<Block>,
      pub deferred_pool_balance_change: Amount,
  }

  impl NonFinalizedBlockBackup {
      /// Constructs a new backup from a vector of bytes read off local disk.
      fn from_bytes(bytes: Vec<u8>) -> Result<Self, io::Error> {
          let (deferred_pool_balance_change_bytes, block_bytes) = bytes
              .split_at_checked(std::mem::size_of::<Amount>())
              .ok_or(io::Error::new(io::ErrorKind::InvalidInput, "input is too short"))?;

          Ok(Self {
              block: Arc::new(
                  block_bytes
                      .zcash_deserialize_into()
                      .map_err(|err| io::Error::new(io::ErrorKind::InvalidData, err))?,
              ),
              deferred_pool_balance_change: Amount::from_bytes(
                  deferred_pool_balance_change_bytes
                      .try_into()
                      .expect("slice from `split_at_checked()` should fit in [u8; 8]"),
              )
              .map_err(|err| io::Error::new(io::ErrorKind::InvalidData, err))?,
          })
      }
  }
  ```
