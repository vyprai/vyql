test "rank1851: minimal pair, same extent inside a passed-by-ref aggregate -- silent"
  lang cpp
  file extent_by_rect.cxx
  reject VYQL-MEM-003
  code
  ```
  #include <string.h>
  #include <sys/socket.h>

  struct Extent {
    int x, x2;
    int width() const { return x2 - x; }
  };

  // The tainted value enters inside the aggregate; field reads and accessor
  // calls on the parameter never carry it back out.
  void copyExtent(const Extent& e, unsigned char* b)
  {
    int w = e.width();
    memcpy(b, b, w);
    memcpy(b, b, e.x2 - e.x);
  }

  void drive(int sock, int ox)
  {
    unsigned char tmp[64];
    int n = recv(sock, tmp, 64, 0);
    copyExtent(Extent(ox, ox + n), tmp);
  }
  ```
