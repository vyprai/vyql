# Rank 1032 / CVE-2017-1000458: Bro's TCP content-line analyzer writes a zero
# byte before the start of its line buffer. DoDeliverOnce holds the line in
# buf with a running offset, and on '\n' after a '\r' it drops the carriage
# return by decrementing:
#
#   case '\n':
#     if ( last_char == '\r' )
#       {
#       --offset; // remove '\r'
#       EMIT_LINE
#       }
#
# with EMIT_LINE a macro that begins buf[offset] = '\0'. A packet ending in
# '\r' can leave offset at 0 while last_char stays '\r', so the next packet
# starting with '\n' decrements to -1 and the macro writes buf[-1] (CWE-787).
# The fix 6c0f101a62 adds the lower bound: when offset is 0 it swallows the
# character and re-sets last_char instead of decrementing.
#
# ATTENTION, engine gaps, and the first of them is the one already recorded at
# rank 1026, now measured on a second codebase.
#
#  - The index guard analysis knows only upper bounds and only field-derived
#    indices. ccIndexAccessObservations requires ccStructuredIndex, that is an
#    index containing "->" or ".", so the plain local offset is never observed;
#    and ccHasUpperBoundGuard has no lower-bound or decrement notion, so even
#    once observed a decremented index counts as guarded wherever any "< N"
#    comparison exists. This is what the two revisions differ by, so nothing
#    can separate them: both report the same three rows, one VYQL-MEM-016 for
#    an unrelated memcpy and two VYQL-MEM-006, with identical fingerprints.
#  - An indexed access inside a preprocessor macro body is not observed at all.
#    The two snippets below that carry the vulnerable code differ only in
#    whether the write sits in the EMIT_LINE macro or inline: vyql match labels
#    buf.__subscript as code.IndexAccess in the inline form and reports no such
#    node in the macro form. The real code uses the macro, so the write that
#    lands out of bounds is invisible before any guard question is reached.
#
# verify_current_expected: attention-engine-gap

test "rank1032: the carriage return is removed by decrementing an offset that can be zero"
  lang cpp
  file src/analyzer/protocol/tcp/ContentLine.cc
  reject VYQL-MEM-010
  code
  ```
  #define EMIT_LINE \
  	{ \
  	buf[offset] = '\0'; \
  	ForwardStream(offset, buf, 1); \
  	offset = 0; \
  	return 1; \
  	}

  int DoDeliverOnce(int len, const unsigned char* data, char* buf, int& offset, char last_char)
  	{
  	char c = data[0];
  	if ( c == '\n' )
  		{
  		if ( last_char == '\r' )
  			{
  			--offset; // remove '\r'
  			EMIT_LINE
  			}
  		}
  	return 0;
  	}
  ```

test "rank1032: same decrement inline, so the write is visible and still unjudged"
  lang cpp
  file src/analyzer/protocol/tcp/ContentLine.cc
  reject VYQL-MEM-010
  code
  ```
  int DoDeliverOnce(int len, const unsigned char* data, char* buf, int& offset, char last_char)
  	{
  	char c = data[0];
  	if ( c == '\n' )
  		{
  		if ( last_char == '\r' )
  			{
  			--offset;
  			buf[offset] = '\0';
  			ForwardStream(offset, buf, 1);
  			offset = 0;
  			return 1;
  			}
  		}
  	return 0;
  	}
  ```

test "rank1032: fix swallows the character when there is nothing to remove"
  lang cpp
  file src/analyzer/protocol/tcp/ContentLine.cc
  reject VYQL-MEM-010
  code
  ```
  #define EMIT_LINE \
  	{ \
  	buf[offset] = '\0'; \
  	ForwardStream(offset, buf, 1); \
  	offset = 0; \
  	return 1; \
  	}

  int DoDeliverOnce(int len, const unsigned char* data, char* buf, int& offset, char last_char)
  	{
  	char c = data[0];
  	if ( c == '\n' )
  		{
  		if ( last_char == '\r' )
  			{
  			if ( offset == 0 )
  				{
  				last_char = c;
  				return 0;
  				}
  			--offset; // remove '\r'
  			EMIT_LINE
  			}
  		}
  	return 0;
  	}
  ```
