  import java.nio.file.Files
  import java.nio.file.Path

  class Context(val pathParamMap: Map<String, String>)

  open class ContextDsl(private val ctx: Context) {
      fun requireParameter(name: String): String = parameter(name)!!
      fun parameter(name: String): String? = ctx.pathParamMap()[name]
  }

  class Location private constructor(private val uri: String) {
      companion object {
          fun of(uri: String): Location = Location(uri)
      }
      override fun toString(): String = uri
  }

  fun String?.toLocation(): Location =
      if (this != null) Location.of(this) else Location.of("")

  class JavadocRawRequest(val repository: String, val gav: Location, val resource: Location)

  class Container(val javadocUnpackPath: Path)

  class JavadocFacade(private val container: Container) {
      fun findRawJavadocResource(request: JavadocRawRequest): ByteArray =
          with (request) {
              Files.newInputStream(container.javadocUnpackPath.resolve(resource.toString())).readBytes()
          }
  }

  class JavadocRoutes(private val ctx: Context, private val container: Container) : ContextDsl(ctx) {
      val javadoc = JavadocFacade(container)
      fun handler(): ByteArray {
          val request = JavadocRawRequest("releases", Location.of("javadoc/1.0.0"), requireParameter("resource").toLocation())
          return javadoc.findRawJavadocResource(request)
