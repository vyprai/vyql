# Rank 1619 / CVE-2022-24790: Puma read the request's framing values
# and converted them leniently, so a request whose declared framing
# disagreed with its bytes was accepted (HTTP request smuggling
# through lenient header and chunk parsing, CWE-444;
# GHSA-h99w-9q5r-gjq9). Three places in lib/puma/client.rb: setup_body
# read @env[TRANSFER_ENCODING2] and fell through to the Content-Length
# reading whenever the value was neither comma-listed-with-chunked nor
# chunked itself -- "identity" or any unknown encoding was silently
# ignored; the same method read @env[CONTENT_LENGTH] and converted with
# String#to_i, which stops at the first non-digit, so "5abc" framed
# five bytes; and read_chunked_body parsed each chunk-size line with
# line.strip.to_i(16), the same lenient stop, and wrote part[0..-3]
# without checking the part ends with \r\n. A proxy in front and Puma
# behind then drew the message boundary in different places. The fixing
# commit 5bb7d202e (the advisory's own reference) reconciles the two
# framings: an ALLOWED_TRANSFER_ENCODING allowlist with the last value
# required to be chunked exactly once, @env.delete TRANSFER_ENCODING2
# when the chunked reading is taken, a /[^\d]/ rejection before the
# Content-Length conversion, and a /[^\h]/ rejection plus a \r\n-ending
# check on chunked segments, raising HttpParserError or
# HttpParserError501 on each violation.
#
# The reader is reported by rubyHttpMessageBodyFramingConflict
# (VYQL-INJ-249): it assigns both framing values out of the Rack
# environment store in one method and never deletes the conflicting
# key. The lenient form below expects the finding; the reconciled form,
# which deletes the transfer-encoding key when it takes the chunked
# reading and refuses every other value, rejects it. The guarded
# Content-Length and chunk-size regex checks add no token the binding
# can see: a `value =~ CONSTANT` guard is not extracted as a call in
# either operand order, so those guards are not what separates the two
# forms here.

test "rank1619: the request reader takes both framings without reconciling them"
  lang ruby
  file lib/puma/client.rb
  expect VYQL-INJ-249
  code
  ```
  class Client
    CHUNKED = "chunked".freeze

    def setup_body(body)
      te = @env[TRANSFER_ENCODING2]
      if te
        if te.include?(",")
          te.split(",").each do |part|
            if CHUNKED.casecmp(part.strip) == 0
              return setup_chunked_body(body)
            end
          end
        elsif CHUNKED.casecmp(te) == 0
          return setup_chunked_body(body)
        end
      end

      cl = @env[CONTENT_LENGTH]
      remain = cl.to_i - body.bytesize
      @body_remain = remain
      false
    end

    def read_chunked_body(chunk)
      io = StringIO.new(chunk)
      while !io.eof?
        line = io.gets
        if line.end_with?("\r\n")
          len = line.strip.to_i(16)
          len += 2
          part = io.read(len)
          got = part.size
          if got == len
            write_chunk(part[0..-3]) # to skip the ending \r\n
          end
        else
          @prev_chunk = line
          return false
        end
      end
      false
    end
  end
  ```

test "rank1619: the reconciled reader removes the conflicting framing key"
  lang ruby
  file lib/puma/client.rb
  reject VYQL-INJ-249
  code
  ```
  class Client
    CHUNKED = "chunked".freeze
    ALLOWED_TRANSFER_ENCODING = %w[compress deflate gzip].freeze
    CONTENT_LENGTH_VALUE_INVALID = /[^\d]/.freeze
    CHUNK_SIZE_INVALID = /[^\h]/.freeze

    def setup_body(body)
      te = @env[TRANSFER_ENCODING2]
      if te
        te_lwr = te.downcase
        if te.include? ','
          te_ary = te_lwr.split ','
          te_count = te_ary.count CHUNKED
          te_valid = te_ary[0..-2].all? { |e| ALLOWED_TRANSFER_ENCODING.include? e }
          if te_ary.last == CHUNKED && te_count == 1 && te_valid
            @env.delete TRANSFER_ENCODING2
            return setup_chunked_body body
          elsif te_count >= 1
            raise HttpParserError, "Invalid Transfer-Encoding, multiple chunked: '#{te}'"
          elsif !te_valid
            raise HttpParserError501, "Invalid Transfer-Encoding, unknown value: '#{te}'"
          end
        elsif te_lwr == CHUNKED
          @env.delete TRANSFER_ENCODING2
          return setup_chunked_body body
        elsif ALLOWED_TRANSFER_ENCODING.include? te_lwr
          raise HttpParserError, "Invalid Transfer-Encoding, single value must be chunked: '#{te}'"
        else
          raise HttpParserError501, "Invalid Transfer-Encoding, unknown value: '#{te}'"
        end
      end

      cl = @env[CONTENT_LENGTH]
      if cl
        if cl =~ CONTENT_LENGTH_VALUE_INVALID
          raise HttpParserError, "Invalid Content-Length: #{cl.inspect}"
        end
      end
      remain = cl.to_i - body.bytesize
      @body_remain = remain
      false
    end

    def read_chunked_body(chunk)
      io = StringIO.new(chunk)
      while !io.eof?
        line = io.gets
        if line.end_with?("\r\n")
          chunk_hex = line.strip[/\A[^;]+/]
          if chunk_hex =~ CHUNK_SIZE_INVALID
            raise HttpParserError, "Invalid chunk size: '#{chunk_hex}'"
          end
          len = chunk_hex.to_i(16)
          len += 2
          part = io.read(len)
          got = part.size
          if got == len && part.end_with?("\r\n")
            write_chunk(part[0..-3]) # to skip the ending \r\n
          else
            raise HttpParserError, "Chunk size mismatch"
          end
        else
          @prev_chunk = line
          return false
        end
      end
      false
    end
  end
  ```
