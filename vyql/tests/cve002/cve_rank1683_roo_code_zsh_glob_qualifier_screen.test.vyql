  export function isSafeGlob(word: string): boolean {
    return !/[*?]/.test(word) || !/\{[^}]*\}/.test(word)
  }
  ```

test "rank1683: an independent screener spelling the substitution forms differently is flagged"
  lang javascript
  file screen.ts
  expect VYQL-INJ-272
  expect_review code.IncompleteShellSubstitutionDenylist
  code
  ```
  export function isSafeToRun(cmd: string): boolean {
    const commandSubstitution = /\$\(/.test(cmd)
    const processSubstitution = /<\(|>\(|=\(/.test(cmd)
    const backtickSubstitution = new RegExp("`").test(cmd)
    return !commandSubstitution && !processSubstitution && !backtickSubstitution
  }
  ```
