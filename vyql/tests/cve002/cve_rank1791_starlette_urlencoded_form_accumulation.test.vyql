# Rank 1791 / CVE-2026-54283 (CWE-400/CWE-770): a urlencoded form body
# arrives as ASGI chunks, and starlette hands each whole chunk to
# python-multipart's QuerystringParser through a callbacks dict. The
# library's contract is that the consumer receives the parse piecemeal
# -- on_field_name and on_field_data are called with a (data, start,
# end) window per fragment, on_field_end once per completed field --
# and the parser itself accepts no limit of any kind, so a consumer
# that wants max_part_size or max_fields enforced has to enforce them
# at the point the fragments arrive. FormParser accumulated instead:
#
#   def on_field_name(self, data, start, end) -> None:      # formparsers.py
#       message = (FormMessage.FIELD_NAME, data[start:end])
#       self.messages.append(message)
#
#   async for chunk in self.stream:
#       if chunk:
#           parser.write(chunk)        # every callback for the whole
#       else:                          # chunk runs and returns here
#           parser.finalize()
#       messages = list(self.messages)
#       self.messages.clear()
#       for message_type, message_bytes in messages:
#           elif message_type == FormMessage.FIELD_NAME:
#               if len(field_name) + len(field_value) + len(message_bytes) > self.max_part_size:
#                   raise MultiPartException("Field exceeded maximum size ...")
#
# Both caps are correct and both are reached -- but only after
# parser.write has returned, by which time self.messages holds
# every fragment of the chunk. A single chunk of `f0=&f1=&f2=...` with
# 100,000 fields materialises ~200,000 tuples before the first
# field_count comparison runs, and a chunk with one 50 MB field
# materialises the field before the first size comparison runs: the
# request allocates proportional to the body while the caps sit
# unenforced on the other side of the write call. The advisory's own
# regression test drives exactly this, a single-yield stream.
#
# 25b8e179 ("Enforce `FormParser` limits in parser callbacks (#3331)")
# moves the caps into the callbacks -- _current_field_size and
# _current_fields counters incremented in on_field_name/on_field_data
# and on_field_end with the comparison and the raise ahead of the
# append, and on_field_start resetting the size counter -- and deletes
# the three comparisons from the drain loop. The sibling class in the
# same file had the correct shape: MultiPartParser.on_part_data
# compares len(self._current_part.data) + len(message_bytes) against
# max_part_size inside the callback, and on_headers_finished compares
# both counters inside the callback, which is why the multipart path
# is never affected. The pool's repository is the kludex fork; the SHA
# resolves there directly and the commit is the PR head, so no
# correction is needed and encode/starlette is the same tree.
#
# What fires without this change. `timeout 180 ./bin/vyql scan --cache off
# --max-ram 6GB` over the whole checkout at `<fix>^` reports 190
# findings (147 at or above high), none of them in
# starlette/formparsers.py -- repeated over three --cache off runs,
# zero each time. `vyql match` on the file labels only generic
# code.Param / code.ExternalEntryInput params from
# library.param-source@syntactic plus an unrelated core.ResourceRelease
# at line 290: no source, no sink, no control on the accumulation, the
# counters, the caps or the write call. Findings elsewhere in the tree
# are not coverage.
#
# No binding is shippable here, and the reason is structural rather
# than a missing name. The discrimination cannot be anchored on
# parse(): the patched parse() is a strict subset of the vulnerable
# one -- the fixed revision deletes the three comparisons and adds nothing -- so
# any binding reading parse() fires on both revisions and, because the
# patched loop carries fewer comparisons, fires harder on the
# remediation than on the defect. The discrimination lives in the
# callbacks, and the only anchor that separates them is the python-
# multipart callback contract itself (on_field_name / on_field_data
# appending a data[start:end] window with no comparison in the same
# body), which would detect this library's consumers rather than the
# weakness, and whose discriminator is neither necessary nor
# sufficient: a consumer that bounds a running byte total before
# parser.write, equally correct under the same contract, leaves its
# callbacks comparison-free and would be flagged. The generic form is
# enumerated rather than sampled, because a three-file class gives a
# vacuous zero: across every repository cloned for this campaign
# (88,997 Python files), a `def on_*` method that appends to self with
# no ordering comparison matches 170 methods in 22 unrelated projects
# -- nicegui 24, ray 22, sentry 12, llama_index 11, OctoPrint 10,
# mlflow 6 -- which is ordinary event-handler and collector code, not
# parser accumulation. `def on_field_name` itself appears in exactly
# three real files corpus-wide: python-multipart's own deprecated
# parse_form convenience wrapper (identical and unremediated at both
# its revisions) and this one.
#
# This is the cross-iteration budget family from its placement side:
# ranks 1534 (baggage member accumulation), 1554 (optional-route
# combination expansion), 1559 (DNS wire length), 1572 (an
# over-generous cap), 1586 and 1776 (JSON nesting depth) and 1612 (a
# dispatch branch bypassing the depth counter) all recorded that the
# corpus's CWE-400 rules judge per-iteration progress, not a budget
# applied at the point the accumulation grows; here the budget exists
# and is applied, just downstream of the growth. Reading the callbacks
# from the function that registers them is the attribution gap
# measured at rank 1397 in Python and named as a family in seven
# languages -- the class-body text route cannot substitute, because
# both revisions' class bodies contain the comparisons inside parse().
# No ENGINE-GAPS.md entry: the piece is accumulation-placement
# vocabulary, not a localised construct. No definition change shipped.
# Spec cve_rank1791 records the accumulate-then-cap form and the
# in-callback cap, both asserting reject VYQL-DOS-029: when
# accumulation-placement vocabulary lands, the accumulate-then-cap
# form must flip to expect.

test "rank1791: the urlencoded callbacks accumulate the whole chunk and the caps run only after the write returns"
  lang python
  file starlette/formparsers.py
  reject VYQL-DOS-029
  code
  ```
  class FormParser:
      def __init__(
          self,
          headers: Headers,
          stream: AsyncGenerator[bytes, None],
          *,
          max_fields: int | float = 1000,
          max_part_size: int = 1024 * 1024,  # 1MB
      ) -> None:
          self.headers = headers
          self.stream = stream
          self.max_fields = max_fields
          self.max_part_size = max_part_size
          self.messages: list[tuple[FormMessage, bytes]] = []

      def on_field_start(self) -> None:
          message = (FormMessage.FIELD_START, b"")
          self.messages.append(message)

      def on_field_name(self, data: bytes, start: int, end: int) -> None:
          message = (FormMessage.FIELD_NAME, data[start:end])
          self.messages.append(message)

      def on_field_data(self, data: bytes, start: int, end: int) -> None:
          message = (FormMessage.FIELD_DATA, data[start:end])
          self.messages.append(message)

      def on_field_end(self) -> None:
          message = (FormMessage.FIELD_END, b"")
          self.messages.append(message)

      def on_end(self) -> None:
          message = (FormMessage.END, b"")
          self.messages.append(message)

      async def parse(self) -> FormData:
          callbacks: QuerystringCallbacks = {
              "on_field_start": self.on_field_start,
              "on_field_name": self.on_field_name,
              "on_field_data": self.on_field_data,
              "on_field_end": self.on_field_end,
              "on_end": self.on_end,
          }

          parser = multipart.QuerystringParser(callbacks)
          field_name = bytearray()
          field_value = bytearray()

          items: list[tuple[str, str | UploadFile]] = []
          field_count = 0

          async for chunk in self.stream:
              if chunk:
                  parser.write(chunk)
              else:
                  parser.finalize()
              messages = list(self.messages)
              self.messages.clear()
              for message_type, message_bytes in messages:
                  if message_type == FormMessage.FIELD_START:
                      field_name = bytearray()
                      field_value = bytearray()
                  elif message_type == FormMessage.FIELD_NAME:
                      if len(field_name) + len(field_value) + len(message_bytes) > self.max_part_size:
                          raise MultiPartException(f"Field exceeded maximum size of {int(self.max_part_size / 1024)}KB.")
                      field_name.extend(message_bytes)
                  elif message_type == FormMessage.FIELD_DATA:
                      if len(field_name) + len(field_value) + len(message_bytes) > self.max_part_size:
                          raise MultiPartException(f"Field exceeded maximum size of {int(self.max_part_size / 1024)}KB.")
                      field_value.extend(message_bytes)
                  elif message_type == FormMessage.FIELD_END:
                      field_count += 1
                      if field_count > self.max_fields:
                          raise MultiPartException(f"Too many fields. Maximum number of fields is {self.max_fields}.")
                      name = unquote_plus(field_name.decode("latin-1"))
                      value = unquote_plus(field_value.decode("latin-1"))
                      items.append((name, value))

          return FormData(items)
  ```

test "rank1791: the caps move into the callbacks ahead of the append"
  lang python
  file starlette/formparsers.py
  reject VYQL-DOS-029
  code
  ```
  class FormParser:
      def __init__(
          self,
          headers: Headers,
          stream: AsyncGenerator[bytes, None],
          *,
          max_fields: int | float = 1000,
          max_part_size: int = 1024 * 1024,  # 1MB
      ) -> None:
          self.headers = headers
          self.stream = stream
          self.max_fields = max_fields
          self.max_part_size = max_part_size
          self.messages: list[tuple[FormMessage, bytes]] = []
          self._current_field_size = 0
          self._current_fields = 0

      def on_field_start(self) -> None:
          self._current_field_size = 0
          message = (FormMessage.FIELD_START, b"")
          self.messages.append(message)

      def on_field_name(self, data: bytes, start: int, end: int) -> None:
          self._current_field_size += end - start
          if self._current_field_size > self.max_part_size:
              raise MultiPartException(f"Field exceeded maximum size of {int(self.max_part_size / 1024)}KB.")
          message = (FormMessage.FIELD_NAME, data[start:end])
          self.messages.append(message)

      def on_field_data(self, data: bytes, start: int, end: int) -> None:
          self._current_field_size += end - start
          if self._current_field_size > self.max_part_size:
              raise MultiPartException(f"Field exceeded maximum size of {int(self.max_part_size / 1024)}KB.")
          message = (FormMessage.FIELD_DATA, data[start:end])
          self.messages.append(message)

      def on_field_end(self) -> None:
          self._current_fields += 1
          if self._current_fields > self.max_fields:
              raise MultiPartException(f"Too many fields. Maximum number of fields is {self.max_fields}.")
          message = (FormMessage.FIELD_END, b"")
          self.messages.append(message)

      def on_end(self) -> None:
          message = (FormMessage.END, b"")
          self.messages.append(message)

      async def parse(self) -> FormData:
          callbacks: QuerystringCallbacks = {
              "on_field_start": self.on_field_start,
              "on_field_name": self.on_field_name,
              "on_field_data": self.on_field_data,
              "on_field_end": self.on_field_end,
              "on_end": self.on_end,
          }

          parser = multipart.QuerystringParser(callbacks)
          field_name = bytearray()
          field_value = bytearray()

          items: list[tuple[str, str | UploadFile]] = []

          async for chunk in self.stream:
              if chunk:
                  parser.write(chunk)
              else:
                  parser.finalize()
              messages = list(self.messages)
              self.messages.clear()
              for message_type, message_bytes in messages:
                  if message_type == FormMessage.FIELD_START:
                      field_name = bytearray()
                      field_value = bytearray()
                  elif message_type == FormMessage.FIELD_NAME:
                      field_name.extend(message_bytes)
                  elif message_type == FormMessage.FIELD_DATA:
                      field_value.extend(message_bytes)
                  elif message_type == FormMessage.FIELD_END:
                      name = unquote_plus(field_name.decode("latin-1"))
                      value = unquote_plus(field_value.decode("latin-1"))
                      items.append((name, value))

          return FormData(items)
  ```

test "rank1791: the multipart sibling caps inside its own callback"
  lang python
  file starlette/formparsers.py
  reject VYQL-DOS-029
  code
  ```
  class MultiPartParser:
      max_part_size = 1024 * 1024  # 1MB

      def __init__(self, headers: Headers, stream: AsyncGenerator[bytes, None]) -> None:
          self.headers = headers
          self.stream = stream
          self.max_part_size = 1024 * 1024
          self._current_part = MultipartPart()

      def on_part_data(self, data: bytes, start: int, end: int) -> None:
          message_bytes = data[start:end]
          if self._current_part.file is None:
              if len(self._current_part.data) + len(message_bytes) > self.max_part_size:
                  raise MultiPartException(f"Part exceeded maximum size of {int(self.max_part_size / 1024)}KB.")
              self._current_part.data.extend(message_bytes)
          else:
              self._file_parts_to_write.append((self._current_part, message_bytes))
  ```
