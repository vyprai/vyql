# PraisonAI's agent code sandbox runs operator-approved Python behind three
# layers: an AST pre-check, a text-pattern blocklist, and a restricted
# `__builtins__` dict. `_execute_code_direct` in
# src/praisonai-agents/praisonaiagents/tools/python_tools.py builds
# `safe_builtins` with `'len': len` in it, installs it as the code's
# `__builtins__`, calls `_validate_code_ast(code)`, and only then runs
# `exec(compiled_code, globals_dict, locals_dict)`. `_validate_code_ast`
# walks the parsed tree rejecting `ast.Attribute` nodes whose `attr` is in a
# frozenset of dunder and frame-introspection names -- 44 of them at the
# vulnerable revision, covering `__globals__`, `__builtins__`,
# `__subclasses__`, `__code__`, `f_globals`, `f_builtins`, `gi_frame`,
# `cr_frame` and the whole `__getattribute__` family. The one it did not
# name is `__self__`: every C-implemented builtin function carries it, and
# `len.__self__` is the real builtins module, so code the checker passed
# recovered the unrestricted module from the one builtin the sandbox
# deliberately kept (sandbox escape through blocklist incompleteness,
# CWE-693/CWE-94; GHSA-4mr5-g6f9-cfrh). The same 44 names were inlined a
# second time into the `safe_execute()` wrapper that `_execute_code_sandboxed`
# writes for subprocess mode. Fix b0d8f777 (PR #1684, "security batch - 10
# hardening fixes") hoists the set to module scope, adds `'__self__'` --
# the in-code comment credits the GHSA: "C builtins leak real builtins
# module" -- extends the blocked-call check from bare names to attribute
# calls, and adds `__self__` to the text-pattern list. The pool row's
# a72e156c4d is the v4.6.40 release bump; b0d8f777 is the fix.
#
# ## Re-measured at the current tip
#
# Three `--cache off` runs per revision (timeout 180, --max-ram 6GB) over
# src/praisonai-agents/praisonaiagents/tools, the directory the fix lands
# in: 27 findings at 402d7ed9^'s tree and 27 at b0d8f777, identical rule
# multisets on all six runs (11 SEC-001, 6 INJ-059, 4 AUTH-105, 3 SEC-045,
# 1 DOS-003, 1 CRY-003, 1 AUTH-126), and none of them on python_tools.py,
# because auto-profiling picks `api` for that directory and the file
# reports 0 findings under it; under `--profile library` the file reports
# 7 at both revisions, 5 of them VYQL-INJ-003 on the exec paths the file
# itself opens. The whole monorepo is not measurable under the ceiling:
# every full-tree run aborts with "reached 5.7 GiB of resident memory,
# past the ceiling of -max-ram 6GB". `vyql match` on the vulnerable file
# labels `code.CodeEval` on the `compile()` calls (:503/:507/:513/:514,
# :808), `code.CommandExecution` (:285) and `code.FilePathAccess`
# (:336/:779), and the denylist's own membership tests only as the generic
# `__binop.in` -> `core.PathAccessCheck` control (:75/:83/:93/:96) -- the
# frozenset itself carries no label, so the first-pass zero was real and
# not a `-flags` replacement misread.
#
# ## The later-shipped denylist-gap vocabulary declines this code
#
# `code.SandboxHostObjectMemberDenylistGap` (VYQL-INJ-271) and
# `code.RestrictedEvalNestedScopeNameFilterGap` (VYQL-INJ-274) both landed
# after the first pass reviewed this rank and neither fires here: INJ-271's
# only feeders are javascript bindings over a Proxy `Reflect.get`, and
# INJ-274's python binding anchors on a receiverless `compile()` plus a
# `.co_names` read, which this filter never does -- it is `ast.parse` and
# `ast.walk`, the case that binding's own comment excludes.
#
# ## What a binding would have to key on
#
# Throwaway probes emitting the existing consumed concept, measured on the
# real file at both revisions:
#
# - needle `'__self__'`, module scope, anchored on a quoted
#   `__subclasses__` literal: 1 finding at the parent, 0 at the fix. It
#   discriminates, and it is the fixing commit's own single added string.
# - needle `'__func__'` -- `__self__`'s documented sibling on every bound
#   method, and equally absent from the patched 45-entry set: 1 finding at
#   the parent and 1 at the fix. The documentation-anchored form of the
#   rule flags the patched revision too, because the fix closes one member
#   of a family whose reference set the language reference does not give.
# - the anchor decides the collateral. The narrow form (`__subclasses__`)
#   has a corpus population of exactly one file: across the 618 corpus
#   checkouts, 79 Python files call `ast.walk` and this is the only one
#   that rejects attribute access against a quoted dunder set; BenchmarkPython
#   contains no `ast.walk` call at all and BenchmarkJava no `__subclasses__`.
#   The broad form (`__globals__`/`__builtins__`) fires 4 for 1 on the four
#   in-corpus files carrying both shapes: IPython's autoreload.py, whose
#   `func_attrs`/`mod_attrs` lists copy attributes between old and new
#   function objects during hot reload and are not a security control;
#   job_workflow.py, which blocks every `__`-prefixed attribute by prefix
#   and so is not an enumeration at all; unified_server.py, which evals
#   behind `{"__builtins__": {}}` with no attribute denylist; and this file.
#
# So the discriminating spelling answers this application rather than the
# weakness -- the genericity test fails on measurement, not on taste -- and
# reusing `SandboxHostObjectMemberDenylistGap` would misreport it, since
# that concept's condition is a live host object forwarded behind a
# property-name denylist, not an AST pre-check over source text. Not an
# engine gap: no taint path is interrupted, the filter runs and its
# membership test is even labelled; the missing thing is a reference set
# for the escape surface, the same blocklist-completeness family as the
# picklescan table and the SQL-function denylist.
#
# Pin both revisions as a double miss. When a blocklist-completeness
# condition that can compare a sandbox's attribute denylist against the
# interpreter's own escape surface lands, the first block must flip to
# expect.
#
# verify_current_expected: attention-vocabulary-gap, both revisions rejected.

test "rank1600: the attribute denylist omits the c-builtin receiver escape"
  lang python
  file src/praisonai-agents/praisonaiagents/tools/python_tools.py
  reject VYQL-INJ-003
  code
  ```
  import ast
  import io
  from contextlib import redirect_stdout, redirect_stderr


  def _validate_code_ast(code: str):
      try:
          tree = ast.parse(code)
      except SyntaxError:
          return None  # let compile() handle syntax errors later

      _blocked_attrs = frozenset({
          '__subclasses__', '__bases__', '__mro__', '__globals__',
          '__code__', '__class__', '__dict__', '__builtins__',
          '__import__', '__loader__', '__spec__', '__init_subclass__',
          '__set_name__', '__reduce__', '__reduce_ex__',
          '__traceback__', '__qualname__', '__module__',
          '__wrapped__', '__closure__', '__annotations__',
          # Frame/code object introspection
          'gi_frame', 'gi_code', 'cr_frame', 'cr_code',
          'ag_frame', 'ag_code', 'tb_frame', 'tb_next',
          'f_globals', 'f_locals', 'f_builtins', 'f_code',
          'co_consts', 'co_names',
          '__getattribute__', '__getattr__', '__setattr__', '__delattr__',
          '__dir__', '__get__', '__set__', '__delete__',
      })

      for node in ast.walk(tree):
          if isinstance(node, (ast.Import, ast.ImportFrom)):
              return f"Import statements are not allowed"
          if isinstance(node, ast.Attribute):
              if node.attr in _blocked_attrs:
                  return f"Access to attribute '{node.attr}' is restricted"
          if isinstance(node, ast.Call):
              func = node.func
              if isinstance(func, ast.Name) and func.id in (
                  'exec', 'eval', 'compile', '__import__',
                  'open', 'input', 'breakpoint',
                  'setattr', 'delattr', 'dir',
              ):
                  return f"Call to '{func.id}' is not allowed"
      return None


  def _execute_code_direct(code, max_output_size=10000):
      # Restricted __builtins__: len is deliberately kept
      safe_builtins = {
          'print': print,
          'len': len,
          'range': range,
          'isinstance': isinstance,
          '__import__': None,
          'eval': None,
          'exec': None,
          'compile': None,
          'open': None,
      }
      globals_dict = {'__builtins__': safe_builtins}
      locals_dict = {}

      # Security check 1: AST-based validation
      ast_error = _validate_code_ast(code)
      if ast_error:
          return {'result': None, 'stderr': f'Security Error: {ast_error}', 'success': False}

      stdout_buffer = io.StringIO()
      try:
          compiled_code = compile(code, '<string>', 'exec')
          with redirect_stdout(stdout_buffer):
              exec(compiled_code, globals_dict, locals_dict)
      except Exception:
          return {'result': None, 'stderr': 'execution failed', 'success': False}
      return {'result': None, 'stdout': stdout_buffer.getvalue(), 'success': True}
  ```

test "rank1600: the fixed revision names the c-builtin receiver escape"
  lang python
  file src/praisonai-agents/praisonaiagents/tools/python_tools.py
  reject VYQL-INJ-003
  code
  ```
  import ast
  import io
  from contextlib import redirect_stdout, redirect_stderr


  _SANDBOX_BLOCKED_ATTRS = frozenset({
      '__subclasses__', '__bases__', '__mro__', '__globals__',
      '__code__', '__class__', '__dict__', '__builtins__',
      '__import__', '__loader__', '__spec__', '__init_subclass__',
      '__set_name__', '__reduce__', '__reduce_ex__',
      '__traceback__', '__qualname__', '__module__',
      '__wrapped__', '__closure__', '__annotations__',
      '__self__',  # C builtins leak real builtins module (GHSA-4mr5-g6f9-cfrh)
      # Frame/code object introspection
      'gi_frame', 'gi_code', 'cr_frame', 'cr_code',
      'ag_frame', 'ag_code', 'tb_frame', 'tb_next',
      'f_globals', 'f_locals', 'f_builtins', 'f_code',
      'co_consts', 'co_names',
      '__getattribute__', '__getattr__', '__setattr__', '__delattr__',
      '__dir__', '__get__', '__set__', '__delete__',
  })

  _SANDBOX_BLOCKED_CALLS = frozenset({
      'exec', 'eval', 'compile', '__import__',
      'open', 'input', 'breakpoint',
      'setattr', 'delattr', 'dir', 'vars',
  })


  def _validate_code_ast(code: str):
      try:
          tree = ast.parse(code)
      except SyntaxError:
          return None  # let compile() handle syntax errors later

      for node in ast.walk(tree):
          if isinstance(node, (ast.Import, ast.ImportFrom)):
              return f"Import statements are not allowed"
          if isinstance(node, ast.Attribute):
              if node.attr in _SANDBOX_BLOCKED_ATTRS:
                  return f"Access to attribute '{node.attr}' is restricted"
          if isinstance(node, ast.Call):
              func = node.func
              if isinstance(func, ast.Name) and func.id in _SANDBOX_BLOCKED_CALLS:
                  return f"Call to '{func.id}' is not allowed"
              if isinstance(func, ast.Attribute) and func.attr in _SANDBOX_BLOCKED_CALLS:
                  return f"Call to '{func.attr}' is not allowed"
      return None


  def _execute_code_direct(code, max_output_size=10000):
      # Restricted __builtins__: len is deliberately kept
      safe_builtins = {
          'print': print,
          'len': len,
          'range': range,
          'isinstance': isinstance,
          '__import__': None,
          'eval': None,
          'exec': None,
          'compile': None,
          'open': None,
      }
      globals_dict = {'__builtins__': safe_builtins}
      locals_dict = {}

      # Security check 1: AST-based validation
      ast_error = _validate_code_ast(code)
      if ast_error:
          return {'result': None, 'stderr': f'Security Error: {ast_error}', 'success': False}

      stdout_buffer = io.StringIO()
      try:
          compiled_code = compile(code, '<string>', 'exec')
          with redirect_stdout(stdout_buffer):
              exec(compiled_code, globals_dict, locals_dict)
      except Exception:
          return {'result': None, 'stderr': 'execution failed', 'success': False}
      return {'result': None, 'stdout': stdout_buffer.getvalue(), 'success': True}
  ```
