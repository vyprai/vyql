# Rank 1862 / CVE-2026-49853: simple_httpclient follows a 3xx itself, and the
# request it builds for the next hop starts from `copy.copy(self.request.request)`
# -- the whole previous request, header store included, whose `Authorization`
# header the connection constructor has materialized from the request's
# credential fields and whose `Cookie` header the caller attached. The 3xx is
# written by the server the first request reached, so that server chooses the
# next host via `Location`, and the copy hands it whatever basic-auth credential
# or session cookie the caller meant for the original host. No injection is
# involved: the URL fetched is exactly the one the client is told to fetch.
# CWE-200.
#
# The pool row carried `nocommit`, and wrongly: the advisory's SHA
# e8fc7edb238f1022e39f9d0b9d297fc7c21fb0a5 resolves on a plain clone and `git
# show` reads it in full -- "simple_httpclient: Strip auth headers on
# cross-origin redirects". The fixed revision compares the origins of the original and
# redirected URLs (scheme and netloc) and, when they differ, clears the
# credential fields (`auth_username`, `auth_password`), strips userinfo from the
# URL, and deletes `Authorization` and `Cookie` from the copied headers.
# Clearing the fields is load-bearing, not incidental: the constructor of the
# next connection rebuilds the Authorization header from them, so deleting the
# header alone would leave the leak half-open.
#
# Vocabulary. The class is in the ontology:
# `code.CredentialHeadersForwardedAcrossRedirect` (VYQL-SEC-052), minted for
# node-fetch's CVE-2022-0235 at rank 1455 with a JavaScript binding. This rank
# widens that concept's language coverage to Python -- no new concept, rule or
# CWE. Nearest neighbours re-checked and rejected for the same reasons 1455
# records: `code.UrlPolicyNotReappliedOnRedirect` is CWE-918 about a URL policy
# surviving the hop, `core.RedirectAllowlist`/`code.RedirectTargetSink` are the
# server-side open redirect, `code.InsecureCookieFlag` is a cookie attribute
# fact. None of them is a client forwarding its caller's credentials.
#
# The Python binding reads the same three facts as the JavaScript one through
# the tokens the Python frontend emits: a `Location` read (follower, not
# emitter), a `.headers[` subscript on the next request's header store, and a
# redirect budget stored on the request object. The budget needles carry a
# leading dot because a Python assignment token embeds the whole right-hand
# side: without it `response = self.fetch(url, follow_redirects=False)` -- the
# ordinary shape of a test asserting on a 3xx -- matches the keyword argument
# inside the call text and reported the test suite. The negation is on
# assignment tokens rather than the `literal` tokens the JavaScript binding
# uses, because on a Python function context a `literal` predicate has no
# function anchor: a credential header spelled anywhere in the module -- in
# tornado's case by the very constructor that builds the Authorization header
# the leak is about -- silences the follower that never considers dropping it.
# Measured: the vulnerable `finish` reports with that constructor in the file
# only under the assignment-token negation.
#
# Discrimination, three `--cache off` scans each of the three reachable
# assignment sites (simple_httpclient.py, httpclient.py, websocket.py -- the
# whole package exceeds a 180s bound, and a grep over all clones finds no other
# Python file that stores a redirect budget): 1 VYQL-SEC-052 at `finish` on
# e8fc7edb^ every run, 0 on e8fc7edb every run. The other two files are clean
# at both revisions, as is the redirect-heavy httpclient_test.py. Across the 53
# clone directories under /tmp/cve-work no Python file outside tornado stores
# a redirect budget at all, so the collateral set is empty.
#
# Hostile variants, all measured:
#   - the follower clearing `new_request.auth = None` (the requests/httpx
#     field spelling) with no header names anywhere                     -> 0
#   - the strip list held in a local (`auth_headers = ["Authorization",
#     "Cookie"]`) assigned before the delete loop                       -> 0
#   - a comment naming Authorization and Cookie above the copy          -> 1
#     (assignment and literal tokens are AST-derived; prose cannot silence)
#   - a handler writing a Location header (emitter, not follower)       -> 0
#   - a test capturing `self.fetch(url, follow_redirects=False)` and
#     reading `response.headers["Location"]`                            -> 0
#
# Known residual, stated in the binding as well: a strip written as a bare list
# literal in a `for` statement, with no credential field cleared in the same
# function, names its headers only in `literal` tokens and is reported. That is
# the price of refusing the file-wide literal route, and it is the same
# over-reporting direction as the JavaScript binding's module-constant residual.
test "rank1862: a redirect follower copying the previous request into the next hop"
  lang python
  file tornado/simple_httpclient.py
  expect VYQL-SEC-052
  expect_review code.CredentialHeadersForwardedAcrossRedirect
  code
  ```
  import copy
  import urllib.parse

  class _HTTPConnection(httputil.HTTPMessageDelegate):
      def _should_follow_redirect(self) -> bool:
          if self.request.follow_redirects:
              assert self.request.max_redirects is not None
              return (
                  self.code in (301, 302, 303, 307, 308)
                  and self.request.max_redirects > 0
                  and self.headers is not None
                  and self.headers.get("Location") is not None
              )
          return False

      def finish(self) -> None:
          original_request = getattr(self.request, "original_request", self.request)
          if self._should_follow_redirect():
              new_request = copy.copy(self.request.request)
              new_request.url = urllib.parse.urljoin(
                  self.request.url, self.headers["Location"]
              )
              assert self.request.max_redirects is not None
              new_request.max_redirects = self.request.max_redirects - 1
              del new_request.headers["Host"]
              if (self.code == 303 and self.request.method != "HEAD") or (
                  self.code in (301, 302) and self.request.method == "POST"
              ):
                  new_request.method = "GET"
                  new_request.body = None
              new_request.original_request = original_request
              fut = self.client.fetch(new_request, raise_error=False)
              fut.add_done_callback(lambda f: self.final_callback(f.result()))
              self._on_end_request()
              return
  ```

test "rank1862: the same follower stripping the credential headers on a cross-origin hop"
  lang python
  file tornado/simple_httpclient.py
  reject VYQL-SEC-052
  reject_review code.CredentialHeadersForwardedAcrossRedirect
  code
  ```
  import copy
  import urllib.parse

  class _HTTPConnection(httputil.HTTPMessageDelegate):
      def finish(self) -> None:
          original_request = getattr(self.request, "original_request", self.request)
          if self._should_follow_redirect():
              new_request = copy.copy(self.request.request)
              new_request.url = urllib.parse.urljoin(
                  self.request.url, self.headers["Location"]
              )
              new_request.headers = self.request.headers.copy()
              parsed_orig_url = urllib.parse.urlsplit(original_request.url)
              parsed_new_url = urllib.parse.urlsplit(new_request.url)
              if (
                  parsed_orig_url.scheme != parsed_new_url.scheme
                  or parsed_orig_url.netloc != parsed_new_url.netloc
              ):
                  # Cross-origin redirect: strip auth headers.
                  new_request.auth_username = None
                  new_request.auth_password = None
                  if "@" in parsed_new_url.netloc:
                      if parsed_new_url.port is not None:
                          new_netloc = f"{parsed_new_url.hostname}:{parsed_new_url.port}"
                      else:
                          assert parsed_new_url.hostname is not None
                          new_netloc = parsed_new_url.hostname
                      parsed_new_url = parsed_new_url._replace(netloc=new_netloc)
                  new_request.url = urllib.parse.urlunsplit(parsed_new_url)
                  for h in ["Authorization", "Cookie"]:
                      try:
                          del new_request.headers[h]
                      except KeyError:
                          pass
              assert self.request.max_redirects is not None
              new_request.max_redirects = self.request.max_redirects - 1
              del new_request.headers["Host"]
              new_request.original_request = original_request
              fut = self.client.fetch(new_request, raise_error=False)
              fut.add_done_callback(lambda f: self.final_callback(f.result()))
              self._on_end_request()
              return
  ```

test "rank1862: an independently spelled credential-field clear is the same control"
  lang python
  file lib/redirect.py
  reject VYQL-SEC-052
  reject_review code.CredentialHeadersForwardedAcrossRedirect
  code
  ```
  import copy
  import urllib.parse

  class RedirectFollower:
      def next_hop(self, response):
          new_request = copy.copy(self.request)
          new_request.url = urllib.parse.urljoin(
              self.request.url, response.headers["Location"]
          )
          new_request.auth = None
          new_request.max_redirects = self.request.max_redirects - 1
          del new_request.headers["Host"]
          return self.client.fetch(new_request, raise_error=False)
  ```

test "rank1862: a strip list held in a local is the same control"
  lang python
  file lib/redirect.py
  reject VYQL-SEC-052
  reject_review code.CredentialHeadersForwardedAcrossRedirect
  code
  ```
  import copy
  import urllib.parse

  class RedirectFollower:
      def next_hop(self, response):
          new_request = copy.copy(self.request)
          new_request.url = urllib.parse.urljoin(
              self.request.url, response.headers["Location"]
          )
          auth_headers = ["Authorization", "Cookie"]
          for h in auth_headers:
              del new_request.headers[h]
          new_request.max_redirects = self.request.max_redirects - 1
          return self.client.fetch(new_request, raise_error=False)
  ```

test "rank1862: a handler writing a Location header is emitting a redirect, not following one"
  lang python
  file lib/routes.py
  reject VYQL-SEC-052
  reject_review code.CredentialHeadersForwardedAcrossRedirect
  code
  ```
  from tornado.web import RequestHandler

  class RedirectHandler(RequestHandler):
      def get(self):
          target = self.get_argument("next")
          self.set_status(302)
          self.set_header("Location", target)
          self.finish()
  ```

