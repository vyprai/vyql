test "rank1249: MCP tool schema declares a wallet mnemonic as a tool parameter"
  lang javascript
  file index.ts
  expect VYQL-SEC-046
  expect_review code.McpToolSchemaSecretParameter
  code
  ```
  import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
  import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
  import { z } from "zod";
  import { sendTokens } from "./tools/tx-builder.js";

  const server = new McpServer({ name: "cosmos-mcp", version: "0.3.0" });

  server.tool(
    "send_tokens",
    "Send tokens to an address. Requires mnemonic.",
    {
      chain_id: z.string().describe("Chain ID"),
      mnemonic: z.string().describe("Sender wallet mnemonic (never stored)"),
      recipient: z.string().describe("Recipient bech32 address"),
      amount: z.string().describe("Amount in base denom"),
      memo: z.string().optional().describe("TX memo"),
    },
    async ({ chain_id, mnemonic, recipient, amount, memo }) => {
      const result = await sendTokens(chain_id, mnemonic, recipient, amount, memo);
      return { content: [{ type: "text" as const, text: JSON.stringify(result, null, 2) }] };
    }
  );
  ```

test "rank1249: MCP tool schema takes an opaque wallet handle instead of the mnemonic"
  lang javascript
  file index.ts
  reject VYQL-SEC-046
  reject_review code.McpToolSchemaSecretParameter
  code
  ```
  import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
  import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
  import { z } from "zod";
  import { sendTokens } from "./tools/tx-builder.js";

  const server = new McpServer({ name: "cosmos-mcp", version: "0.3.0" });

  const WALLET_ID_DESC =
    "Opaque wallet handle previously registered via `cosmos-mcp wallet add <id>`. " +
    "The mnemonic itself is encrypted at rest and never crosses this API boundary.";

  server.tool(
    "send_tokens",
    "Send tokens to an address. Requires a registered wallet_id.",
    {
      chain_id: z.string().describe("Chain ID"),
      wallet_id: z.string().describe(WALLET_ID_DESC),
      recipient: z.string().describe("Recipient bech32 address"),
      amount: z.string().describe("Amount in base denom"),
      memo: z.string().optional().describe("TX memo"),
    },
    async ({ chain_id, wallet_id, recipient, amount, memo }) => {
      const result = await sendTokens(chain_id, wallet_id, recipient, amount, memo);
      return { content: [{ type: "text" as const, text: JSON.stringify(result, null, 2) }] };
    }
  );
  ```

test "rank1249: MCP tool handler passes an enrolled mnemonic to a signer"
  lang javascript
  file index.ts
  reject VYQL-SEC-046
  reject_review code.McpToolSchemaSecretParameter
  code
  ```
  import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
  import { z } from "zod";
  import { signAndBroadcast } from "./chain.js";
  import { readEnrolledWallet } from "./wallet/store.js";

  const server = new McpServer({ name: "cosmos-mcp", version: "0.3.0" });

  server.tool(
    "send_tokens",
    "Send tokens using a registered wallet handle.",
    {
      chain_id: z.string().describe("Chain ID"),
      wallet_id: z.string().describe("Registered wallet handle"),
      recipient: z.string().describe("Recipient bech32 address"),
    },
    async ({ chain_id, wallet_id, recipient }) => {
      const enrolled = await readEnrolledWallet(wallet_id);
      const result = await signAndBroadcast({ mnemonic: enrolled.secret, chain: chain_id, to: recipient });
      return { content: [{ type: "text" as const, text: JSON.stringify(result, null, 2) }] };
    }
  );
  ```
