  code
  ```
  <?php

  class CubeCart_Smarty_Security extends Smarty_Security
  {
      private $dangerous_php = array(
          'exec', 'system', 'passthru', 'shell_exec', 'popen', 'proc_open',
          'eval', 'assert', 'create_function', 'call_user_func',
          'forward_static_call', 'forward_static_call_array', 'iterator_apply',
          'file_put_contents', 'fwrite', 'fopen', 'unlink', 'copy',
          'error_log',
          'fputcsv', 'gzwrite', 'gzputs', 'bzwrite',
          'imagepng', 'imagejpeg', 'imagegif', 'imagewebp', 'imagebmp',
          'file_get_contents', 'file', 'readfile', 'fgets', 'fread',
          'readgzfile', 'gzfile', 'gzopen', 'gzread', 'gzgets',
          'gzpassthru', 'gzdecode', 'gzinflate',
          'bzopen', 'bzread', 'bzdecompress',
          'fpassthru', 'readlink', 'linkinfo', 'realpath',
          'glob', 'scandir', 'opendir', 'readdir', 'closedir',
          'pathinfo', 'fileowner', 'filegroup', 'fileperms',
          'simplexml_load_file', 'simplexml_import_dom',
          'curl_init', 'curl_exec',
          'gethostbyname', 'gethostbyaddr', 'gethostbynamel', 'gethostname',
          'dns_get_record', 'dns_check_record', 'checkdnsrr', 'getmxrr',
          'pclose', 'pcntl_fork', 'pcntl_signal', 'pcntl_wait',
          'posix_kill', 'posix_setuid', 'posix_setgid', 'posix_setsid',
          'phpinfo',
      );

      public $php_functions = array();

      public $php_modifiers = array();

      public function __construct($smarty)
      {
          parent::__construct($smarty);
          $dangerous = $this->dangerous_php;
          $smarty->registerDefaultPluginHandler(function ($name, $type, $template, &$callback, &$script, &$cacheable) use ($dangerous) {
              if ($type === Smarty::PLUGIN_MODIFIER && is_callable($name) && !in_array($name, $dangerous)) {
                  $callback = $name;
                  return true;
              }
              return false;
          });
      }

      public function isTrustedPhpFunction($function_name, $compiler)
      {
          if (in_array($function_name, $this->dangerous_php)) {
              $compiler->trigger_template_error("PHP function '{$function_name}' not allowed by security setting");
              return false;
          }
          return true;
      }

      public function isTrustedPhpModifier($modifier_name, $compiler)
      {
          if (in_array($modifier_name, $this->dangerous_php)) {
              $compiler->trigger_template_error("modifier '{$modifier_name}' not allowed by security setting");
              return false;
          }
          return true;
      }
  }
  ```

test "rank1903: Smarty's own policy trusts a function by allow-list membership"
  lang php
  file smarty_security.php
  reject VYQL-INJ-024
  code
  ```
  <?php

  class Smarty_Security
  {
      public $php_functions = array('isset', 'empty', 'count', 'sizeof', 'in_array', 'is_array', 'time');

      public $php_modifiers = array('escape', 'count', 'sizeof', 'nl2br');

      public function isTrustedPhpFunction($function_name, $compiler)
      {
          if (isset($this->php_functions)
              && (empty($this->php_functions) || in_array($function_name, $this->php_functions))
          ) {
              return true;
          }
          $compiler->trigger_template_error("PHP function '{$function_name}' not allowed by security setting");
          return false;
      }

      public function isTrustedPhpModifier($modifier_name, $compiler)
      {
          if (isset($this->php_modifiers)
              && (empty($this->php_modifiers) || in_array($modifier_name, $this->php_modifiers))
          ) {
              return true;
          }
          $compiler->trigger_template_error("modifier '{$modifier_name}' not allowed by security setting");
          return false;
      }
  }
  ```

test "rank1903: a subclass that only restricts directories and classes, not the trust hook"
  lang php
  file storefront_security.class.php
  reject VYQL-INJ-024
  code
  ```
  <?php

  class Storefront_Security extends Smarty_Security
  {
      public $static_classes = array('Catalogue');

      public $streams = array('file');

      public function __construct($smarty)
      {
          parent::__construct($smarty);
          $this->secure_dir = array(CC_ROOT_DIR . '/js/', CC_ROOT_DIR . '/modules/');
      }
  }
  ```

test "rank1903: a subclass that overrides the hook with its own trusted list"
  lang php
  file catalogue_security.class.php
  reject VYQL-INJ-024
  code
  ```
  <?php

  class Catalogue_Security extends Smarty_Security
  {
      private $allowed_functions = array('isset', 'count', 'in_array', 'sprintf');

      public function isTrustedPhpFunction($function_name, $compiler)
      {
          if (!in_array($function_name, $this->allowed_functions)) {
              $compiler->trigger_template_error("PHP function '{$function_name}' not allowed by security setting");
              return false;
          }
          return true;
      }
  }
  ```
