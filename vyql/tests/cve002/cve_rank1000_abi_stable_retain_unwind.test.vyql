# Rank 1000 / CVE-2020-36212: abi_stable RString::retain copied the standard
# library's compaction loop (rust-lang/rust#78498). The caller's predicate runs
# between the raw byte copy and the final set_len, so a panic in it leaves the
# string with its stale pre-compaction length and the drop that follows
# observes moved-out bytes.

test "rank1000: retain runs the caller predicate before restoring the length"
  lang rust
  expect VYQL-MEM-052
  expect_review code.ClosureUnwindStaleLength
  code
  ```
  pub struct RString { inner: RVec<u8> }

  impl RString {
      pub fn retain<F>(&mut self, mut pred: F)
      where
          F: FnMut(char) -> bool,
      {
          let len = self.len();
          let mut del_bytes = 0;
          let mut idx = 0;

          while idx < len {
              let ch = unsafe { self.get_unchecked(idx..len).chars().next().unwrap() };
              let ch_len = ch.len_utf8();

              if !pred(ch) {
                  del_bytes += ch_len;
              } else if del_bytes > 0 {
                  unsafe {
                      ptr::copy(
                          self.inner.as_ptr().add(idx),
                          self.inner.as_mut_ptr().add(idx - del_bytes),
                          ch_len,
                      );
                  }
              }

              idx += ch_len;
          }

          if del_bytes > 0 {
              unsafe { self.inner.set_len(len - del_bytes); }
          }
      }
  }
  ```

test "rank1000: zeroing the length before the loop makes a panic safe"
  lang rust
  reject VYQL-MEM-052
  reject_review code.ClosureUnwindStaleLength
  code
  ```
  pub struct RString { inner: RVec<u8> }

  impl RString {
      pub fn retain<F>(&mut self, mut pred: F)
      where
          F: FnMut(char) -> bool,
      {
          let len = self.len();
          let mut del_bytes = 0;
          let mut idx = 0;

          unsafe {
              self.inner.set_len(0);
          }

          while idx < len {
              let ch = unsafe { self.get_unchecked(idx..len).chars().next().unwrap() };
              let ch_len = ch.len_utf8();

              if !pred(ch) {
                  del_bytes += ch_len;
              } else if del_bytes > 0 {
                  unsafe {
                      ptr::copy(
                          self.inner.as_ptr().add(idx),
                          self.inner.as_mut_ptr().add(idx - del_bytes),
                          ch_len,
                      );
                  }
              }

              idx += ch_len;
          }

          unsafe {
              self.inner.set_len(len - del_bytes);
          }
      }
  }
  ```

test "rank1000: a straight-line copy with no caller closure is not this bug"
  lang rust
  reject VYQL-MEM-052
  reject_review code.ClosureUnwindStaleLength
  code
  ```
  pub struct RVec2<T> { p: *mut T, len: usize }

  impl<T> RVec2<T> {
      pub fn extend_from_copy_slice(&mut self, slic_: &[T]) {
          self.reserve(slic_.len());
          let old_len = self.len;
          unsafe {
              let entries = self.p.add(old_len);
              ptr::copy(slic_.as_ptr(), entries, slic_.len());
              self.set_len(old_len + slic_.len());
          }
      }
  }
  ```
