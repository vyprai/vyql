test "rank1811: the item action requiring administration at the vulnerable revision"
  lang java
  file SupportObjectActionAdminister.java
  reject VYQL-AUTH-079
  code
  ```
  import hudson.model.Action;
  import jenkins.model.Jenkins;
  import net.sf.json.JSONObject;
  import org.kohsuke.stapler.StaplerRequest;
  import org.kohsuke.stapler.StaplerResponse;
  import org.kohsuke.stapler.verb.POST;

  import java.io.IOException;

  public class SupportObjectActionAdminister implements Action {
      @POST
      public final void doGenerateAndDownload(StaplerRequest req, StaplerResponse rsp) throws IOException {
          Jenkins.get().checkPermission(Jenkins.ADMINISTER);
          rsp.setContentType("application/zip");
          JSONObject json = req.getSubmittedForm();
          SupportPlugin.writeBundle(rsp.getOutputStream(), SupportPlugin.getComponents(json));
      }
  }
  ```

test "rank1811: the permission declaration that makes the grant separable from administration"
  lang java
  file SupportPluginPermission.java
  reject VYQL-AUTH-079
  code
  ```
  import hudson.Plugin;
  import hudson.model.Messages;
  import hudson.security.Permission;
  import hudson.security.PermissionGroup;
  import hudson.security.PermissionScope;
  import jenkins.model.Jenkins;

  public class SupportPluginPermission extends Plugin {
      public static final PermissionGroup SUPPORT_PERMISSIONS =
              new PermissionGroup(SupportPluginPermission.class, Messages.SupportPlugin_PermissionGroup());

      public static final Permission CREATE_BUNDLE =
              new Permission(SUPPORT_PERMISSIONS, "DownloadBundle", Messages.SupportPlugin_CreateBundle(),
                      Jenkins.ADMINISTER, PermissionScope.JENKINS);
  }
  ```
