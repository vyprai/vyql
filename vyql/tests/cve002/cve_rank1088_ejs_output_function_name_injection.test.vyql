# Rank 1088 / CVE-2022-29078: EJS concatenated the outputFunctionName compile
# option straight into the JavaScript source it generates for a template, and
# then compiled that source with the Function constructor, so a value for
# outputFunctionName that is not an identifier becomes part of the compiled
# code (CWE-74). Applications commonly spread request data into EJS options
# through frameworks that flatten nested query keys, such as Express's
# settings[view options][outputFunctionName], which is how the advisory frames
# reachability. lib/ejs.js has
#
#   if (opts.outputFunctionName) {
#     prepended += '  var ' + opts.outputFunctionName + ' = __append;' + '\n';
#   }
#   ...
#   fn = new ctor(opts.localsName + ', escapeFn, include, rethrow', src);
#
# where src is the generated source string carrying whatever was concatenated
# above, and ctor is Function (or its async constructor, resolved dynamically).
# outputFunctionName = 'x;console.log(1);x' turns into
# console.log(1) executing at compile time. The fix 15ee698583 adds
#
#   var _JS_IDENTIFIER = /^[a-zA-Z_$][0-9a-zA-Z_$]*$/;
#   if (!_JS_IDENTIFIER.test(opts.outputFunctionName)) {
#     throw new Error('outputFunctionName is not a valid JS identifier.');
#   }
#
# and the same check for localsName and each destructuredLocals entry.
#
# ATTENTION, and the diagnosis found two independent binding-layer limitations
# for JavaScript's Function constructor, both measured with a real HTTP source.
#
#  - code.CodeEval for Function is anchored at args[0] only. new
#    Function(tainted, 'return 1;') reports; new Function('a, b', tainted), the
#    same tainted value as the last argument -- the function body, which is
#    where injected code actually runs -- does not. Function(params..., body)
#    always executes the last argument; a first-argument-only anchor misses the
#    shape that matters in nearly every real exploit of this constructor,
#    ejs's own generated src included.
#  - The binding matches callee.path ~= "Function" textually, so it requires the
#    call site to name Function directly. ejs assigns ctor = Function (or an
#    async variant resolved at runtime) and calls new ctor(...); that call site
#    names ctor, not Function, and is invisible to the binding at any argument
#    position, including args[0] where a direct call does report.
#
# Scanning lib/ejs.js at the vulnerable revision reports 0 findings; vyql match
# labels no source and no sink around the compile path.
#
# verify_current_expected: attention-vocabulary-gap

test "rank1088: outputFunctionName is concatenated into the generated source"
  lang javascript
  file lib/ejs.js
  reject VYQL-INJ-003
  code
  ```
  function compile(template, opts) {
    var prepended = '';
    var src;
    var ctor = Function;

    prepended += '  var __output = "";\n' +
      '  function __append(s) { if (s !== undefined && s !== null) __output += s }\n';
    if (opts.outputFunctionName) {
      prepended += '  var ' + opts.outputFunctionName + ' = __append;' + '\n';
    }

    src = prepended + template;
    var fn = new ctor(opts.localsName + ', escapeFn, include, rethrow', src);
    return fn;
  }
  ```

test "rank1088: the fix requires outputFunctionName to be a plain identifier"
  lang javascript
  file lib/ejs.js
  reject VYQL-INJ-003
  code
  ```
  var _JS_IDENTIFIER = /^[a-zA-Z_$][0-9a-zA-Z_$]*$/;

  function compile(template, opts) {
    var prepended = '';
    var src;
    var ctor = Function;

    prepended += '  var __output = "";\n' +
      '  function __append(s) { if (s !== undefined && s !== null) __output += s }\n';
    if (opts.outputFunctionName) {
      if (!_JS_IDENTIFIER.test(opts.outputFunctionName)) {
        throw new Error('outputFunctionName is not a valid JS identifier.');
      }
      prepended += '  var ' + opts.outputFunctionName + ' = __append;' + '\n';
    }

    src = prepended + template;
    var fn = new ctor(opts.localsName + ', escapeFn, include, rethrow', src);
    return fn;
  }
  ```

# The argument-position pair. Same source, same Function constructor call;
# only which argument carries the tainted value differs.

test "rank1088: a tainted first argument to Function reaches the sink"
  lang javascript
  file args0.js
  expect VYQL-INJ-003
  code
  ```
  function compile(req) {
    var opts = req.query;
    var fn = new Function(opts.params, 'return 1;');
    return fn;
  }
  ```

test "rank1088: the same value as Function's body argument does not"
  lang javascript
  file args1.js
  reject VYQL-INJ-003
  code
  ```
  function compile(req) {
    var opts = req.query;
    var fn = new Function('a, b', opts.body);
    return fn;
  }
  ```

# The alias pair. Same tainted argument at args[0], where a direct call already
# reports; only whether the constructor is called by name or through a local
# variable differs.

test "rank1088: a direct call to Function is a recognized sink"
  lang javascript
  file direct.js
  expect VYQL-INJ-003
  code
  ```
  function compile(req) {
    var opts = req.query;
    var fn = new Function(opts.params, 'return 1;');
    return fn;
  }
  ```

test "rank1088: the same call through a local alias of Function is not"
  lang javascript
  file aliased.js
  reject VYQL-INJ-003
  code
  ```
  function compile(req) {
    var opts = req.query;
    var ctor = Function;
    var fn = new ctor(opts.params, 'return 1;');
    return fn;
  }
  ```
