# Rank 1088 / CVE-2022-29078: EJS concatenates the `outputFunctionName` compile
# option into generated template source and compiles it with `Function`, so a
# non-identifier value becomes executable code (CWE-74). The advisory frames the
# consumer side as server-side template injection through the compile options an
# application passes, so the reportable signal for a project is the dependency:
# an ejs pin below 3.1.7, the first fixed release.
#
# The dependency route reports and discriminates: a consumer manifest pinning
# ^3.1.6 gets VYQL-SCA-001 naming CVE-2022-29078, and the ^3.1.7 pin is clean.
# The library's own compile path still reports nothing at either revision: the
# Function-constructor sink is labelled only where the call site names Function,
# while ejs assigns `ctor = Function` and calls `new ctor(...)` -- the
# aliased-callee pair pins that miss. The argument-position pair records the
# widened anchor: any argument of a directly-named Function call is generated
# code, the MDN-documented signature running the last argument as the body.
#
# verify_current_expected: fixed

test "rank1088: a consumer pinning ejs below the first fixed release is reported"
  lang javascript
  file index.js
  code
  ```
  var ejs = require('ejs');
  var tpl = '<%= user.name %>';

  app.set('view engine', 'ejs');
  app.get('/', function (req, res) {
    res.render('index', {}, req.query.settings);
  });
  ```
  file package.json
  expect VYQL-SCA-001
  expect_evidence VYQL-SCA-001 CVE-2022-29078
  code
  ```
  {
    "name": "app",
    "dependencies": {
      "ejs": "^3.1.6"
    }
  }
  ```

test "rank1088: a consumer at the first fixed release is clean"
  lang javascript
  file index.js
  code
  ```
  var ejs = require('ejs');
  var tpl = '<%= user.name %>';

  app.set('view engine', 'ejs');
  app.get('/', function (req, res) {
    res.render('index', {}, req.query.settings);
  });
  ```
  file package.json
  reject VYQL-SCA-001
  code
  ```
  {
    "name": "app",
    "dependencies": {
      "ejs": "^3.1.7"
    }
  }
  ```

test "rank1088: outputFunctionName is concatenated into the generated source"
  lang javascript
  file lib/ejs.js
  reject VYQL-INJ-003
  code
  ```
  function compile(template, opts) {
    var prepended = '';
    var src;
    var ctor = Function;

    prepended += '  var __output = "";\n' +
      '  function __append(s) { if (s !== undefined && s !== null) __output += s }\n';
    if (opts.outputFunctionName) {
      prepended += '  var ' + opts.outputFunctionName + ' = __append;' + '\n';
    }

    src = prepended + template;
    var fn = new ctor(opts.localsName + ', escapeFn, include, rethrow', src);
    return fn;
  }
  ```

test "rank1088: the fixed revision requires outputFunctionName to be a plain identifier"
  lang javascript
  file lib/ejs.js
  reject VYQL-INJ-003
  code
  ```
  var _JS_IDENTIFIER = /^[a-zA-Z_$][0-9a-zA-Z_$]*$/;

  function compile(template, opts) {
    var prepended = '';
    var src;
    var ctor = Function;

    prepended += '  var __output = "";\n' +
      '  function __append(s) { if (s !== undefined && s !== null) __output += s }\n';
    if (opts.outputFunctionName) {
      if (!_JS_IDENTIFIER.test(opts.outputFunctionName)) {
        throw new Error('outputFunctionName is not a valid JS identifier.');
      }
      prepended += '  var ' + opts.outputFunctionName + ' = __append;' + '\n';
    }

    src = prepended + template;
    var fn = new ctor(opts.localsName + ', escapeFn, include, rethrow', src);
    return fn;
  }
  ```

# The argument-position pair. Same source, same Function constructor call;
# only which argument carries the tainted value differs. Any argument is
# generated code: with one argument it is the body, with several the last one
# is, which is the MDN-documented signature.

test "rank1088: a tainted first argument to Function reaches the sink"
  lang javascript
  file args0.js
  expect VYQL-INJ-003
  code
  ```
  function compile(req) {
    var opts = req.query;
    var fn = new Function(opts.params, 'return 1;');
    return fn;
  }
  ```

test "rank1088: the same value as Function's body argument reports"
  lang javascript
  file args1.js
  expect VYQL-INJ-003
  code
  ```
  function compile(req) {
    var opts = req.query;
    var fn = new Function('a, b', opts.body);
    return fn;
  }
  ```

# The alias pair. Same tainted argument at args[0], where a direct call
# reports; only whether the constructor is called by name or through a local
# variable differs. ejs's own compile path is this shape.

test "rank1088: a direct call to Function is a recognized sink"
  lang javascript
  file direct.js
  expect VYQL-INJ-003
  code
  ```
  function compile(req) {
    var opts = req.query;
    var fn = new Function(opts.params, 'return 1;');
    return fn;
  }
  ```

test "rank1088: the same call through a local alias of Function is not"
  lang javascript
  file aliased.js
  reject VYQL-INJ-003
  code
  ```
  function compile(req) {
    var opts = req.query;
    var ctor = Function;
    var fn = new ctor(opts.params, 'return 1;');
    return fn;
  }
  ```
