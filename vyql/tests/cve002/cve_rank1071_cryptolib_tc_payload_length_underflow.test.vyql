# Rank 1071 / CVE-2025-30356: CryptoLib computes a telecommand frame's payload
# length by subtracting header sizes from the declared length in unsigned
# arithmetic, so a small declared length wraps to a huge one (CWE-191, CWE-787).
#
# VYQL-MEM-016 fires on the memcpy sized by that length. The fixed form still
# copies with a length derived the same way (via a signed intermediate), so both
# snippets expect the finding; the rule does not land on the underflowing
# subtraction itself.
#
# verify_current_expected: caught-partial

test "rank1071: the declared frame length is subtracted unsigned"
  lang c
  file src/core/crypto_tc.c
  expect VYQL-MEM-016
  code
  ```
  #include <stdint.h>
  #include <string.h>

  #define TC_FRAME_HEADER_SIZE 5

  typedef struct
  {
      uint16_t fl;
  } TC_FramePrimaryHeader_t;

  int32_t Crypto_TC_ApplySecurity_Cam(const uint8_t *p_in_frame, uint16_t in_frame_length, uint8_t *p_out,
                                      uint8_t segment_hdr_len, uint8_t fecf_len)
  {
      TC_FramePrimaryHeader_t temp_tc_header;
      uint16_t tf_payload_len = 0x0000;

      temp_tc_header.fl = ((uint16_t)p_in_frame[2] << 8) | p_in_frame[3];

      if (temp_tc_header.fl <= TC_FRAME_HEADER_SIZE - segment_hdr_len - fecf_len + 1)
      {
          return -1;
      }

      tf_payload_len = temp_tc_header.fl - TC_FRAME_HEADER_SIZE - segment_hdr_len - fecf_len + 1;

      memcpy(p_out, &p_in_frame[TC_FRAME_HEADER_SIZE + segment_hdr_len], tf_payload_len);
      return 0;
  }
  ```

test "rank1071: the same subtraction taken signed and rejected when negative"
  lang c
  file src/core/crypto_tc.c
  expect VYQL-MEM-016
  code
  ```
  #include <stdint.h>
  #include <string.h>

  #define TC_FRAME_HEADER_SIZE 5

  typedef struct
  {
      uint16_t fl;
  } TC_FramePrimaryHeader_t;

  int32_t Crypto_TC_ApplySecurity_Cam(const uint8_t *p_in_frame, uint16_t in_frame_length, uint8_t *p_out,
                                      uint8_t segment_hdr_len, uint8_t fecf_len)
  {
      TC_FramePrimaryHeader_t temp_tc_header;
      uint16_t tf_payload_len = 0x0000;

      temp_tc_header.fl = ((uint16_t)p_in_frame[2] << 8) | p_in_frame[3];

      if (temp_tc_header.fl + 1 != in_frame_length)
      {
          return -1;
      }

      int16_t payload_calc = temp_tc_header.fl - TC_FRAME_HEADER_SIZE - segment_hdr_len - fecf_len + 1;
      if (payload_calc < 0)
      {
          return -1;
      }

      tf_payload_len = (uint16_t)payload_calc;

      memcpy(p_out, &p_in_frame[TC_FRAME_HEADER_SIZE + segment_hdr_len], tf_payload_len);
      return 0;
  }
  ```
