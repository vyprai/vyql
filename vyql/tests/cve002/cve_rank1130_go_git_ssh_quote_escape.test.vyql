# Rank 1130 / CVE-2026-45570: go-git's SSH transport wraps the repository path
# in literal single quotes with no escaping of embedded quotes, so a path
# containing `'` can break out of the quoted region on a shell-evaluating SSH
# server (CWE-116).
#
# ATTENTION: vocabulary gap. code.CommandLineAssemblyReview describes the
# shape, but its bindings depend on language-specific frontend markers Go does
# not emit. Both snippets reject.
#
# verify_current_expected: attention-vocabulary-gap, both revisions rejected.

test "rank1130: the path is wrapped in single quotes with no escaping"
  lang go
  file ssh.go
  reject_review code.CommandLineAssemblyReview
  code
  ```
  package ssh

  import (
      "fmt"
      "strings"
  )

  func buildCommand(req *transport.Request) string {
      var b strings.Builder
      fmt.Fprintf(&b, "%s '%s'", req.Command, req.URL.Path)
      for _, arg := range req.Args {
          fmt.Fprintf(&b, " '%s'", arg)
      }
      return b.String()
  }
  ```

test "rank1130: embedded quote and bang characters are escaped before wrapping"
  lang go
  file ssh.go
  reject_review code.CommandLineAssemblyReview
  code
  ```
  package ssh

  import "strings"

  func buildCommand(req *transport.Request) string {
      var b strings.Builder
      b.WriteString(req.Command)
      b.WriteByte(' ')
      writeShellQuote(&b, req.URL.Path)
      for _, arg := range req.Args {
          b.WriteByte(' ')
          writeShellQuote(&b, arg)
      }
      return b.String()
  }

  func writeShellQuote(b *strings.Builder, s string) {
      b.WriteByte('\'')
      for i := 0; i < len(s); i++ {
          c := s[i]
          if c == '\'' || c == '!' {
              b.WriteString(`'\`)
              b.WriteByte(c)
              b.WriteByte('\'')
              continue
          }
          b.WriteByte(c)
      }
      b.WriteByte('\'')
  }
  ```
