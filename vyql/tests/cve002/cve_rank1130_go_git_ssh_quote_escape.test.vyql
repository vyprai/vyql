# The v4 module has no fixed release: the same unquoted endpointToCommand is
# present at its last tag (v4.13.1) and the line is end-of-life, so every pin
# of it carries the advisory and there is no min_safe to compare against.

test "rank1130: a go-git v4 pin carries the advisory with no fixed release"
  lang go
  file git.go
  code
  ```
  package git

  import (
      "github.com/go-git/go-git"
      "github.com/go-git/go-billy/osfs"
  )

  type CloneOptions struct {
      RepositoryURL string
  }

  type gitClient struct{}

  func (c *gitClient) Download(dst string, opt *CloneOptions) error {
      wt := osfs.New(dst)
      _, err := git.Clone(nil, wt, &git.CloneOptions{
          URL: opt.RepositoryURL,
      })
      return err
  }
  ```
  file go.mod
  code
  ```
  module example.com/gitimport

  go 1.13

  require github.com/go-git/go-git v4.13.1+incompatible
  ```
  expect VYQL-SCA-001
  expect_evidence VYQL-SCA-001 CVE-2026-45570

# Both revisions of the library's own command assembly, kept so a later reader
# can see what the patch changes rather than inferring it from the advisory
# text: the unpatched form wraps the path and each arg in literal single
# quotes, the patched form routes them through writeShellQuote. Neither
# reports today, which is the honest state -- the quoting relation inside a
# format string is not a shape any Go context feature states.

test "rank1130: the unpatched transport wraps the path in literal single quotes"
  lang go
  file ssh.go
  code
  ```
  package ssh

  import (
      "fmt"
      "strings"

      "github.com/go-git/go-git/v6/plumbing/transport"
  )

  func buildCommand(req *transport.Request) string {
      var b strings.Builder
      fmt.Fprintf(&b, "%s '%s'", req.Command, req.URL.Path)
      for _, arg := range req.Args {
          fmt.Fprintf(&b, " '%s'", arg)
      }
      return b.String()
  }
  ```
  reject_review code.CommandLineAssemblyReview

test "rank1130: the patched transport escapes the path before wrapping it"
  lang go
  file ssh.go
  code
  ```
  package ssh

  import (
      "strings"

      "github.com/go-git/go-git/v6/plumbing/transport"
  )

  func buildCommand(req *transport.Request) string {
      var b strings.Builder
      b.WriteString(req.Command)
      b.WriteByte(' ')
      writeShellQuote(&b, req.URL.Path)
      for _, arg := range req.Args {
          b.WriteByte(' ')
          writeShellQuote(&b, arg)
      }
      return b.String()
  }

  func writeShellQuote(b *strings.Builder, s string) {
      b.WriteByte('\'')
      for i := 0; i < len(s); i++ {
          c := s[i]
          if c == '\'' || c == '!' {
              b.WriteString(`'\`)
              b.WriteByte(c)
              b.WriteByte('\'')
              continue
          }
          b.WriteByte(c)
      }
      b.WriteByte('\'')
  }
  ```
  reject_review code.CommandLineAssemblyReview

# verify_current_expected: fixed-dependency-route
