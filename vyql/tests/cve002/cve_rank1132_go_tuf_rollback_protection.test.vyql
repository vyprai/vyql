# The library's own update sequence, both revisions, held here so a later
# reader can see the patched form rather than inferring it from the advisory
# text. No code-level rule reports either shape: code.ProtocolStateReview
# carries this CWE family but every Go binding for it is a named analysis of
# one incident's calls, and the discriminator here is an ordering requirement
# across two methods (load-and-verify local metadata before trusting a new
# download) that the flat per-function context facts cannot express, so the
# reviews stay pinned as non-reporting.

test "rank1132: Update downloads new metadata with no prior trusted version loaded"
  lang go
  file client.go
  code
  ```
  package client

  func (c *Client) Update() (data.TargetFiles, error) {
      if err := c.UpdateRoots(); err != nil {
          return nil, err
      }

      // Get timestamp.json, extract snapshot.json file meta and save the
      // timestamp.json locally
      timestampJSON, err := c.downloadMetaUnsafe("timestamp.json", defaultTimestampDownloadLimit)
      if err != nil {
          return nil, err
      }
      snapshotMeta, err := c.decodeTimestamp(timestampJSON)
      if err != nil {
          return nil, err
      }
      if err := c.local.SetMeta("timestamp.json", timestampJSON); err != nil {
          return nil, err
      }
      return nil, nil
  }
  ```
  reject_review code.ProtocolStateReview

test "rank1132: Update loads and verifies prior trusted metadata before downloading anything new"
  lang go
  file client.go
  code
  ```
  package client

  func (c *Client) Update() (data.TargetFiles, error) {
      if err := c.UpdateRoots(); err != nil {
          return nil, err
      }

      // Load trusted metadata files, if any, and verify them against the latest root
      c.getLocalMeta()

      // 5.4.1 - Download the timestamp metadata
      timestampJSON, err := c.downloadMetaUnsafe("timestamp.json", defaultTimestampDownloadLimit)
      if err != nil {
          return nil, err
      }
      // 5.4.(2,3 and 4) - Verify timestamp against various attacks
      // Returns the extracted snapshot metadata
      snapshotMeta, err := c.decodeTimestamp(timestampJSON)
      if err != nil {
          return nil, err
      }
      // 5.4.5 - Persist the timestamp metadata
      if err := c.local.SetMeta("timestamp.json", timestampJSON); err != nil {
          return nil, err
      }
      return nil, nil
  }
  ```
  reject_review code.ProtocolStateReview
