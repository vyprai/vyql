# Rank 1132 / CVE-2022-29173: go-tuf's update client downloaded and trusted
# new timestamp/snapshot metadata without first loading whatever metadata it
# had already verified and stored locally, so it held no last-known-good
# version to compare a newly-served file against, letting a malicious or
# compromised repository roll a client back to older, superseded metadata
# (CWE-354). TUF's rollback protection depends entirely on the client already
# having the previous timestamp/snapshot version in memory when it inspects a
# new download; a consumer's Update call is correct code doing what the library
# documents, and whether the library skips its load-prior-trusted-state step is
# invisible from the consumer, so the report that belongs to this CVE is the
# dependency finding: a pin below v0.3.0, the release the advisory names as
# first fixed.

test "rank1132: a go-tuf pin below the first rollback-protected release is a dependency finding"
  lang go
  file main.go
  code
  ```
  package main

  import (
      "fmt"
      "log"

      tuf "github.com/theupdateframework/go-tuf/client"
  )

  func main() {
      log.SetFlags(0)

      remote, err := tuf.HTTPRemoteStore("https://updates.example.com", nil, nil)
      if err != nil {
          log.Fatalln("ERROR:", err)
      }
      c := tuf.NewClient(tuf.MemoryLocalStore(), remote)

      if _, err := update(c); err != nil {
          log.Fatalln("ERROR:", err)
      }
  }

  func update(c *tuf.Client) error {
      if _, err := c.Update(); err != nil && !tuf.IsLatestSnapshot(err) {
          return fmt.Errorf("update: %w", err)
      }
      return nil
  }
  ```
  file go.mod
  code
  ```
  module example.com/fleet-updater

  go 1.16

  require github.com/theupdateframework/go-tuf v0.2.0
  ```
  expect VYQL-SCA-001
  expect VYQL-SCA-002
  expect_evidence VYQL-SCA-001 CVE-2022-29173

