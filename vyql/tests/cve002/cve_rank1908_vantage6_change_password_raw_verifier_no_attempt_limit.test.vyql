# An authenticated change-password handler re-verifies the current password
# with the account model's bare `check_password` -- a single bcrypt
# comparison and nothing else. The login flow of the same project keeps a
# failed-attempt counter, an `is_blocked` lockout check and a
# `max_failed_attempts` policy, all inside its `user_login` routine; wiring
# the change-password endpoint to the bare verifier hands out the
# comparison's answer bit once per request with none of that machinery, so a
# holder of any authenticated session can drive the endpoint at machine
# speed and brute-force the user's current password (CWE-307).
#
# The fixed revision routes the verification through the same `user_login` routine the
# login endpoint uses, so the failed-attempt counter and lockout apply to
# the change-password route as well.
#
# Measured on the real repository, union of three --cache off runs per
# revision: the vulnerable tree reports VYQL-AUTH-105 on the handler plus
# two same-class review rows on the server's own test files, which call
# `check_password` in both revisions; the patched tree drops the handler
# row and keeps the two test rows. Renaming the login routine the fixed revision calls
# (`user_login` -> `authenticate_user`) leaves the patched revision clean,
# because the discriminator is the raw verifier call the handler itself
# makes, not the fixed revision's helper name. Across every other clone in the working
# pool no Python file contains any account-level verifier call, and a full
# scan of one unrelated Python tree reports no row from this binding.

test "rank1908: change-password verifies the current password through the bare account verifier"
  lang python
  file recover.py
  expect VYQL-AUTH-105
  code
  ```
  from http import HTTPStatus

  from flask import g, request

  from vantage6.server.resource import ServicesResources, with_user
  from vantage6.server.resource.common.auth_helper import user_login
  from vantage6.server.model.user import User


  class ChangePassword(ServicesResources):
      """Let user change their password with old password as verification."""

      @with_user
      def patch(self):
          body = request.get_json()
          errors = change_pw_schema.validate(body)
          if errors:
              return {
                  "msg": "Request body is incorrect",
                  "errors": errors,
              }, HTTPStatus.BAD_REQUEST

          old_password = body.get("current_password")
          new_password = body.get("new_password")

          user = g.user
          log.info("Changing password for user %s", user.id)

          # check if the old password is correct
          pw_correct = user.check_password(old_password)
          if not pw_correct:
              return {
                  "msg": "Your current password is not correct!"
              }, HTTPStatus.UNAUTHORIZED

          # set password
          msg = user.set_password(new_password)
          if msg:
              return {"msg": msg}, HTTPStatus.BAD_REQUEST

          log.info("Successful password change for '%s'", user.username)
          return {"msg": "The password has been changed successfully!"}, HTTPStatus.OK
  ```

test "rank1908: change-password verifies through the login routine that counts failed attempts"
  lang python
  file recover.py
  reject VYQL-AUTH-105
  code
  ```
  from http import HTTPStatus

  from flask import g, request

  from vantage6.server.resource import ServicesResources, with_user
  from vantage6.server.resource.common.auth_helper import user_login
  from vantage6.server.model.user import User


  class ChangePassword(ServicesResources):
      """Let user change their password with old password as verification."""

      @with_user
      def patch(self):
          body = request.get_json()
          errors = change_pw_schema.validate(body)
          if errors:
              return {
                  "msg": "Request body is incorrect",
                  "errors": errors,
              }, HTTPStatus.BAD_REQUEST

          old_password = body.get("current_password")
          new_password = body.get("new_password")

          user: User = g.user
          log.info("Changing password for user %s", user.id)

          # check if the old password is correct
          user_or_error, code = user_login(
              self.config, user.username, old_password, self.mail
          )
          if code != HTTPStatus.OK:
              return user_or_error, code

          # set password
          msg = user.set_password(new_password)
          if msg:
              return {"msg": msg}, HTTPStatus.BAD_REQUEST

          log.info("Successful password change for '%s'", user.username)
          return {"msg": "The password has been changed successfully!"}, HTTPStatus.OK
  ```

test "rank1908: the login routine itself keeps its failed-attempt machinery"
  lang python
  file auth_helper.py
  reject VYQL-AUTH-105
  code
  ```
  import logging
  from http import HTTPStatus

  from flask import current_app, Flask, request
  from flask_mail import Mail
  from threading import Thread

  from vantage6.server.globals import DEFAULT_MAX_FAILED_ATTEMPTS
  from vantage6.server.model.user import User

  log = logging.getLogger("auth_helper")


  def verify_credentials(config: dict, username: str, password: str, mail: Mail):
      """Verify credentials and apply the failed-attempt lockout policy."""
      log.info("Trying to login '%s'", username)
      failed_login_msg = "Failed to login"

      username_exists = User.username_exists(username)
      random_username = User.get_first_user().username
      user = (
          User.get_by_username(username)
          if username_exists
          else User.get_by_username(random_username)
      )

      password_policy = config.get("password_policy", {})
      max_failed_attempts = password_policy.get(
          "max_failed_attempts", DEFAULT_MAX_FAILED_ATTEMPTS
      )
      inactivation_time = password_policy.get(
          "inactivation_minutes", DEFAULT_INACTIVATION_MINUTES
      )

      is_blocked, min_rem = user.is_blocked(max_failed_attempts, inactivation_time)

      if user.check_password(password) and not is_blocked and username_exists:
          user.failed_login_attempts = 0
          user.save()
          return user, HTTPStatus.OK

      t1 = Thread(
          target=__handle_failed_login,
          args=(current_app._get_current_object(), username_exists, username),
      )
      t1.start()

      return {"msg": failed_login_msg}, HTTPStatus.UNAUTHORIZED
  ```

