test "rank1485: gap C, the execution step called directly reaches the shell"
  lang go
  file service/internal/executor/executor.go
  expect VYQL-INJ-002
  code
  ```
  package executor

  import (
  	"context"
  	"net/http"
  	"os/exec"
  )

  type ExecutionRequest struct{ Arguments map[string]string }

  type Executor struct{ chainOfCommand []func(*ExecutionRequest) bool }

  func stepExec(req *ExecutionRequest) bool {
  	_ = exec.CommandContext(context.Background(), "sh", "-c", req.Arguments["webhook_path"]).Run()
  	return true
  }

  func (e *Executor) execChain(req *ExecutionRequest) {
  	stepExec(req)
  }

  func HandleWebhook(r *http.Request, e *Executor) {
  	args := map[string]string{"webhook_path": r.URL.Path}
  	e.execChain(&ExecutionRequest{Arguments: args})
  }
  ```

test "rank1485: gap C, the same step invoked through the chain-of-command slice reaches nothing"
  lang go
  file service/internal/executor/executor.go
  reject VYQL-INJ-002
  code
  ```
  package executor

  import (
  	"context"
  	"net/http"
  	"os/exec"
  )

  type ExecutionRequest struct{ Arguments map[string]string }

  type Executor struct{ chainOfCommand []func(*ExecutionRequest) bool }

  func stepExec(req *ExecutionRequest) bool {
  	_ = exec.CommandContext(context.Background(), "sh", "-c", req.Arguments["webhook_path"]).Run()
  	return true
  }

  func DefaultExecutor() *Executor {
  	return &Executor{chainOfCommand: []func(*ExecutionRequest) bool{stepExec}}
  }

  func (e *Executor) execChain(req *ExecutionRequest) {
  	for _, step := range e.chainOfCommand {
  		if !step(req) {
  			break
  		}
  	}
  }

  func HandleWebhook(r *http.Request, e *Executor) {
  	args := map[string]string{"webhook_path": r.URL.Path}
  	e.execChain(&ExecutionRequest{Arguments: args})
  }
  ```
