# Rank 1687 / CVE-2024-32971 (GHSA-q9p4-hw9m-fj2v, CWE-440): the Apollo
# Router keys its query-plan caches on a QueryHash that
# QueryHashVisitor::hash_query computes as a SHA-256 over the *projection* of
# the operation the traversal visits -- field names, parent type names,
# argument names and values -- deliberately normalized so that formatting and
# aliases do not change the key. The fixed revision differs from 1.44.0 that projection is the entire
# input set: the serialized operation text and the supergraph schema string
# are not hashed at all, and the CachingQueryKey display hash that fronts the
# in-memory and Redis plan caches mixed in only the operation name, cache
# metadata and plan options. Two genuinely different operations can project to
# the same visited fields, so with distributed query-plan caching over Redis
# an operation could retrieve and run the plan cached for a different
# operation -- the advisory's "unexpected operations being executed". The fixed revision
# (bundled into the v1.45.1 release commit ff9f6665, which the advisory itself
# references and which reads in full as a normal diff) hashes the serialized
# executable document into hash_query, threads the raw schema SDL through
# hash_subqueries into the subgraph (schema-aware) hash, adds the schema SDL
# to CachingQueryKey, and, when the visitor meets an introspection field
# (__schema / __type), hashes the whole schema string so introspection
# results cannot be misaligned to a superseded schema.
#
# ATTENTION, vocabulary gap on a logic property whose only syntactic
# discriminator is the fixed revision's own added statement. The defect is an omission
# inside a pure hashing function: there is no untrusted source flowing to a
# dangerous sink, and the client-supplied query *does* reach hash_query
# (vyql match on the vulnerable change.rs labels its parameters
# code.ExternalEntryInput) -- what is wrong is that the digest covers too
# little of it, which is a fact about the projection, not about any call.
# The sole difference in hash_query between the two revisions is one added
# statement, executable.to_string().hash(&mut visitor), plus a threaded
# schema_str parameter. A binding keyed on the absence of that call keys on
# the fixing commit's own layout, and .hash() on a to_string() result is one
# of unbounded spellings for folding text into a digest -- every correct
# implementation that incorporates its input differently would be flagged.
# The nearest concepts each carry an assumption this code contradicts:
# code.WeakHash (VYQL-CRY-001) judges the algorithm, and this digest is
# SHA-256; code.NamespacedSubjectKeyCollision (VYQL-AUTH-010) assumes a
# Kubernetes reflector cache of ServiceAccount subjects;
# code.PublicVisibilityCacheInvalidationMissing (VYQL-AUTH-036) assumes
# sandbox-proxy public-status entries;
# code.SessionHashMissingAuthorizationState (VYQL-AUTH-058) assumes session
# validity hashes over passwords with mutable authorization fields. Widening
# any of them to "a cache key omits an input the cached artifact depends on"
# is a rewrite of its condition, not a language widening, and would mint a
# concept per CVE rather than per weakness class. The cross-procedural
# control-view gap measured for Rust at rank 1364 does not apply here: the
# fix is intra-procedural, inside hash_query itself.
#
# Measured on the real tree at the vulnerable revision (bounded scan, timeout 180,
# --max-ram 6GB): 1041 findings across the repository, zero on
# apollo-router/src/spec/query/change.rs; the one hash-shaped label nearby,
# code.WeakHash at caching_query_planner.rs:519, sits on stats_report_key_hash
# (a SHA-1 of a stats-report key, unconnected to this CVE) and yields no
# finding. Findings in fetch.rs are NullableDeref rows on unrelated
# formatting code.
#
# verify_current_expected: attention-vocabulary-gap

test "rank1687: hash_query digests only the visited projection of the operation, so distinct operations sharing visited fields collide in the plan-cache key"
  lang rust
  file apollo-router/src/spec/query/change.rs
  reject VYQL-CRY-001
  reject VYQL-AUTH-010
  reject VYQL-AUTH-058
  code
  ```
  impl<'a> QueryHashVisitor<'a> {
      pub(crate) fn hash_query(
          schema: &'a schema::Schema,
          executable: &'a executable::ExecutableDocument,
          operation_name: Option<&str>,
      ) -> Result<Vec<u8>, BoxError> {
          let mut visitor = QueryHashVisitor::new(schema, executable);
          traverse::document(&mut visitor, executable, operation_name)?;
          Ok(visitor.finish())
      }

      pub(crate) fn finish(self) -> Vec<u8> {
          self.hasher.finalize().as_slice().into()
      }
  }
  ```

test "rank1687: the fixed revision folds the serialized operation text into the digest and threads the schema string through the subgraph hash"
  lang rust
  file apollo-router/src/spec/query/change.rs
  reject VYQL-CRY-001
  reject VYQL-AUTH-010
  reject VYQL-AUTH-058
  code
  ```
  impl<'a> QueryHashVisitor<'a> {
      pub(crate) fn hash_query(
          schema: &'a schema::Schema,
          schema_str: &str,
          executable: &'a executable::ExecutableDocument,
          operation_name: Option<&str>,
      ) -> Result<Vec<u8>, BoxError> {
          let mut visitor = QueryHashVisitor::new(schema, schema_str, executable);
          traverse::document(&mut visitor, executable, operation_name)?;
          executable.to_string().hash(&mut visitor);
          Ok(visitor.finish())
      }

      pub(crate) fn finish(self) -> Vec<u8> {
          self.hasher.finalize().as_slice().into()
      }
  }
  ```

test "rank1687: the visitor hashes a field from parent type, name and arguments only, so an introspection field carries none of the schema it answers from"
  lang rust
  file apollo-router/src/spec/query/change.rs
  reject VYQL-CRY-001
  reject VYQL-AUTH-010
  reject VYQL-AUTH-036
  code
  ```
  impl<'a> Visitor for QueryHashVisitor<'a> {
      fn field(
          &mut self,
          parent_type: &str,
          field_def: &ast::FieldDefinition,
          node: &executable::Field,
      ) -> Result<(), BoxError> {
          self.hash_field(
              parent_type.to_string(),
              field_def.name.as_str().to_string(),
              field_def,
              &node.arguments,
          )?;

          traverse::field(self, field_def, node)
      }
  }
  ```

test "rank1687: the fixed revision folds the whole schema string into the digest when the visitor meets an introspection field"
  lang rust
  file apollo-router/src/spec/query/change.rs
  reject VYQL-CRY-001
  reject VYQL-AUTH-010
  reject VYQL-AUTH-036
  code
  ```
  impl<'a> Visitor for QueryHashVisitor<'a> {
      fn field(
          &mut self,
          parent_type: &str,
          field_def: &ast::FieldDefinition,
          node: &executable::Field,
      ) -> Result<(), BoxError> {
          if !self.seen_introspection && (field_def.name == "__schema" || field_def.name == "__type")
          {
              self.seen_introspection = true;
              self.schema_str.hash(self);
          }

          self.hash_field(
              parent_type.to_string(),
              field_def.name.as_str().to_string(),
              field_def,
              &node.arguments,
          )?;

          traverse::field(self, field_def, node)
      }
  }
  ```

test "rank1687: the in-memory plan-cache key mixes operation name, metadata and plan options but not the schema the executed plans compute against"
  lang rust
  file apollo-router/src/query_planner/caching_query_planner.rs
  reject VYQL-CRY-001
  reject VYQL-AUTH-010
  reject VYQL-AUTH-058
  code
  ```
  #[derive(Debug, Clone, PartialEq, Eq)]
  pub(crate) struct CachingQueryKey {
      pub(crate) query: String,
      pub(crate) operation: Option<String>,
      pub(crate) hash: Arc<QueryHash>,
      pub(crate) metadata: CacheKeyMetadata,
      pub(crate) plan_options: PlanOptions,
  }

  impl std::fmt::Display for CachingQueryKey {
      fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
          let mut hasher = Sha256::new();
          hasher.update(self.operation.as_deref().unwrap_or("-"));
          let operation = hex::encode(hasher.finalize());

          let mut hasher = Sha256::new();
          hasher.update(&serde_json::to_vec(&self.metadata).expect("serialization should not fail"));
          hasher.update(
              &serde_json::to_vec(&self.plan_options).expect("serialization should not fail"),
          );
          let metadata = hex::encode(hasher.finalize());

          Ok(())
      }
  }
  ```

test "rank1687: the fixed revision adds the schema SDL to the plan-cache key"
  lang rust
  file apollo-router/src/query_planner/caching_query_planner.rs
  reject VYQL-CRY-001
  reject VYQL-AUTH-010
  reject VYQL-AUTH-058
  code
  ```
  #[derive(Debug, Clone, PartialEq, Eq)]
  pub(crate) struct CachingQueryKey {
      pub(crate) query: String,
      pub(crate) sdl: Arc<String>,
      pub(crate) operation: Option<String>,
      pub(crate) hash: Arc<QueryHash>,
      pub(crate) metadata: CacheKeyMetadata,
      pub(crate) plan_options: PlanOptions,
  }

  impl std::fmt::Display for CachingQueryKey {
      fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
          let mut hasher = Sha256::new();
          hasher.update(self.operation.as_deref().unwrap_or("-"));
          let operation = hex::encode(hasher.finalize());

          let mut hasher = Sha256::new();
          hasher.update(&serde_json::to_vec(&self.metadata).expect("serialization should not fail"));
          hasher.update(
              &serde_json::to_vec(&self.plan_options).expect("serialization should not fail"),
          );
          hasher.update(&serde_json::to_vec(&self.sdl).expect("serialization should not fail"));
          let metadata = hex::encode(hasher.finalize());

          Ok(())
      }
  }
  ```
