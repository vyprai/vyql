# Rank 1268 / CVE-2020-12691 (OSSA-2020-004): OpenStack Keystone's
# PATCH /v3/credentials/{id} handler authorizes the update against the
# credential's state as stored *before* the update, then applies the
# caller-supplied body -- including `user_id` and `project_id`, the fields
# that determine who the credential authenticates as -- straight into
# storage with no second check. Any authenticated user who can create an
# EC2 credential for themselves on a project where they hold any role can
# then PATCH that credential's `user_id`/`project_id` to a victim's, and
# every later `POST /ec2tokens` request signed with it issues a token for
# the victim -- including an admin, which turns any single role assignment
# into a path to full masquerade (CVSS 8.8).
#
# Fix commit 95b2bbeab113d9f04d1c81f7f1b48bf692bce979 (a Gerrit merge of
# 206392a4) changes keystone/api/credentials.py's `CredentialResource.patch`
# (pre-fix at keystone/api/credentials.py:155-167 in parent 02447bfb) to
# build `target = {'credential': dict(current, **credential)}` -- the record
# as it would exist *after* the caller's fields are merged in -- and run a
# second `ENFORCER.enforce_call(action='identity:update_credential',
# target_attr=target)` against that merged result, on top of the original
# pre-update enforcement. It also adds `_validate_blob_update_keys`, which
# rejects a PATCH that changes an EC2 credential's `trust_id`/`app_cred_id`/
# `access_token_id`, closing the same masquerade path through credentials
# created under a scoped token.
#
# ATTENTION, engine gap. `vyql match` on a minimal pair extracted from this
# file labels only `flask.request.view_args` as code.HttpInput; nothing else
# in the method is labelled, on either revision. `vyql resolve` shows
# `ENFORCER.enforce_call`, `PROVIDERS.credential_api.get_credential` and
# `PROVIDERS.credential_api.update_credential` all unresolved -- no Python
# binding names any of them, so no rule can see this method at all, and
# `vyql explain` reports no findings on either revision. Scanning the real
# `keystone/api/credentials.py` at both revisions with
# `vyql scan --cache off --max-ram 5GB` reports 0
# findings both times.
#
# Not mechanical: the closest three existing rules by CWE and by their own
# review text -- VYQL-AUTH-046 (code.CommentUpdateMissingOwnershipConstraint,
# "comment update criteria select a comment by id without constraining the
# row to the current author"), VYQL-AUTH-076
# (code.OwnedResourceDeleteMissingOwnershipCheck, "a delete handler ... acts
# without an observed owner/admin authorization check") and VYQL-AUTH-099
# (code.MassAssignmentSink, "user-controlled data is bulk-applied to an
# object or record without a field allowlist") -- all confirmed not firing
# on either revision above, and none of their `reviewCondition` text
# actually states this shape: an authorization decision computed from a
# resource's *pre*-update state, followed by an unfiltered merge of
# request-body fields (including the fields that define who owns/scopes the
# resource) into storage, with no authorization re-check against the
# *post*-merge state. That is a new classification -- recognizing "which
# merged fields are privilege-relevant" and "is the merged target
# re-authorized" needs a dedicated `python_review` tag alongside the
# existing ones in `internal/extract/frontend/treesitter/python.go` (see
# `owned_resource_delete_missing_ownership_check` at line 1286 for the
# nearest sibling shape and pattern), wired to a new `code.*` review concept
# the way `vyql/review/concepts/review/OwnedResourceDeleteMissingOwnershipCheck.vyql`
# wires its tag today. Designing that classifier's positive/negative shapes
# (an update handler that re-derives its enforcement target from the merged
# request body vs. one that does not) is itself the design work this loop
# does not do. Blocks any CVE whose fix is "re-authorize after merging
# caller-supplied fields, not only before."
#
# verify_current_expected: attention-engine-gap, both revisions rejected.

test "rank1268: PATCH enforces on the pre-update credential, then merges the request body unfiltered"
  lang python
  file keystone/api/credentials.py
  reject VYQL-AUTH-046
  reject VYQL-AUTH-076
  reject VYQL-AUTH-099
  code
  ```
  import hashlib

  import flask
  from oslo_serialization import jsonutils

  from keystone.common import provider_api
  from keystone.common import rbac_enforcer
  from keystone.common import validation
  from keystone.credential import schema
  from keystone import exception
  from keystone.server import flask as ks_flask

  PROVIDERS = provider_api.ProviderAPIs
  ENFORCER = rbac_enforcer.RBACEnforcer


  def _build_target_enforcement():
      target = {}
      try:
          target['credential'] = PROVIDERS.credential_api.get_credential(
              flask.request.view_args.get('credential_id')
          )
      except exception.NotFound:
          pass
      return target


  class CredentialResource(ks_flask.ResourceBase):
      collection_key = 'credentials'
      member_key = 'credential'

      def patch(self, credential_id):
          # Update Credential
          ENFORCER.enforce_call(
              action='identity:update_credential',
              build_target=_build_target_enforcement
          )
          PROVIDERS.credential_api.get_credential(credential_id)

          credential = self.request_body_json.get('credential', {})
          validation.lazy_validate(schema.credential_update, credential)
          self._require_matching_id(credential)
          ref = PROVIDERS.credential_api.update_credential(
              credential_id, credential)
          return self.wrap_member(ref)
  ```

test "rank1268: PATCH re-authorizes against the merged post-update target and rejects scope changes"
  lang python
  file keystone/api/credentials.py
  reject VYQL-AUTH-046
  reject VYQL-AUTH-076
  reject VYQL-AUTH-099
  code
  ```
  import hashlib

  import flask
  import six
  from oslo_serialization import jsonutils

  from keystone.common import provider_api
  from keystone.common import rbac_enforcer
  from keystone.common import validation
  from keystone.credential import schema
  from keystone import exception
  from keystone.i18n import _
  from keystone.server import flask as ks_flask

  PROVIDERS = provider_api.ProviderAPIs
  ENFORCER = rbac_enforcer.RBACEnforcer


  def _build_target_enforcement():
      target = {}
      try:
          target['credential'] = PROVIDERS.credential_api.get_credential(
              flask.request.view_args.get('credential_id')
          )
      except exception.NotFound:
          pass
      return target


  class CredentialResource(ks_flask.ResourceBase):
      collection_key = 'credentials'
      member_key = 'credential'

      def _validate_blob_json(self, ref):
          blob = jsonutils.loads(ref.get('blob'))
          if not blob or not isinstance(blob, dict):
              raise exception.ValidationError(attribute='blob',
                                              target='credential')
          return blob

      def _validate_blob_update_keys(self, credential, ref):
          if credential.get('type', '').lower() == 'ec2':
              new_blob = self._validate_blob_json(ref)
              old_blob = credential.get('blob')
              if isinstance(old_blob, six.string_types):
                  old_blob = jsonutils.loads(old_blob)
              for key in ['trust_id', 'app_cred_id', 'access_token_id']:
                  if old_blob.get(key) != new_blob.get(key):
                      message = _('%s can not be updated for credential') % key
                      raise exception.ValidationError(message=message)

      def patch(self, credential_id):
          # Update Credential
          ENFORCER.enforce_call(
              action='identity:update_credential',
              build_target=_build_target_enforcement
          )
          current = PROVIDERS.credential_api.get_credential(credential_id)

          credential = self.request_body_json.get('credential', {})
          validation.lazy_validate(schema.credential_update, credential)
          self._validate_blob_update_keys(current.copy(), credential.copy())
          self._require_matching_id(credential)
          # Check that the user hasn't illegally modified the owner or scope
          target = {'credential': dict(current, **credential)}
          ENFORCER.enforce_call(
              action='identity:update_credential', target_attr=target
          )
          ref = PROVIDERS.credential_api.update_credential(
              credential_id, credential)
          return self.wrap_member(ref)
  ```
