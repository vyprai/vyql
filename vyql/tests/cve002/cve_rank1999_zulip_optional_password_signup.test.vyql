# Rank 1999 / CVE-2019-18933 (CWE-287): Zulip's accounts_register made the
# registration form's password field optional for social-auth signup --
#
#	if not (password_auth_enabled(realm) and password_required):
#	    form['password'].field.required = False
#
# but then read the password back under the realm-level condition only:
#
#	if form.is_valid():
#	    if password_auth_enabled(realm):
#	        password = form.cleaned_data['password']
#	    else:
#	        password = None
#
# An SSO user signing up in a realm that also allows password authentication
# took the first branch with an unrequired field, so `cleaned_data['password']`
# is the empty string, and the empty string -- unlike the None the else branch
# assigns -- is a value Django's `set_password` will hash into a *usable*
# password. The account comes alive with a credential any unauthenticated
# attacker can present: EmailAuthBackend's `check_password("")` matches, and
# the stolen session yields the user's API key. The advisory metadata's
# commit is the "Release Zulip Server 2.0.7" release commit; the fixing change is
# 0c2cc41d2 ("CVE-2019-18933: Fix insecure account creation via social
# authentication", backported to 2.0.x as 1cdec46aa), which adds the
# field-consultation conjunct `and form['password'].field.required`, changes
# the bot-creation call's `password=''` to `password=None`, and adds a
# defensive `if password == "": return None` to EmailAuthBackend.
#
# `vyql match` at the parent labelled nothing on the password shape (a scan
# of the four fix-carrying files reported 27 findings, all redirects and
# trust-boundary rows). Two token facts decided the binding's shape, both
# measured on the real file: the relaxation assignment renders its subscript
# key away (`assign:form[].field.required=False`), so the relaxation conjunct
# cannot name the field and the password anchor has to be the consumption;
# and the assignment is mirrored into an `expr:` token of its own, so a
# negation reading `expr contains "field.required"` suppresses the vulnerable
# form itself -- the discrimination needs `expr endsWith ".field.required"`,
# which the patched condition's final conjunct satisfies and the mirrored
# assignment (ending `=False`) does not. That negation stayed function-
# confined in measurement, unlike `contains` over `expr:`.
#
# Detection keys on Django's documented surfaces only -- `Field.required`
# relaxed at runtime, `cleaned_data['password']` consumed, `set_password` /
# `create_user` receiving it -- and the two documented counterweights decline
# it: consulting the field's required-ness at the point of consumption, and
# coalescing the value to null (`or None`, the documented way absence becomes
# an unusable password). Residuals, stated in the binding: a truthiness guard
# on the value (`if not password:`) and a bare `field.required` condition
# emit no boolean-operator token and do not decline; a final conjunct spelled
# `...fields['password'].required` is outside the negation needle; the
# `.get('password')` consumption spelling and class-level `required=False`
# declarations are outside the shape.
#
# Measured on the real checkout (zerver/views/registration.py, three
# `--cache off` runs each): VYQL-AUTH-169 1 -> 0 across the fixed revisioned revision, fingerprint
# stable across runs. Reachable set across the ~197 clones (exhaustive
# per-function enumeration of the relaxation-plus-consumption conjunction,
# 17204 Python files): exactly one function -- this one. The only other tree
# carrying a runtime password-field relaxation (wagtail's PasswordChangeForm,
# which relaxes old/new password fields in the form's __init__) does not
# consume in the same function and reports 0 of 7 findings on its
# wagtail/admin/forms subtree. The bot-creation `password=''` hunk is
# deliberately not in the shape: the empty-string-literal spelling enumerates
# to 27 occurrences across the clones, overwhelmingly database and proxy
# connection defaults (a different weakness), and Zulip's own
# create_user_profile nulls passwords for bot accounts before
# set_password sees them, so that hunk is not the exploitable path.
# /tmp/bench/BenchmarkPython contains no `cleaned_data['password']`,
# `set_password` or `create_user` occurrence, so the corpus cannot move.
#
# verify_current_expected: fixed

test "rank1999: a signup flow making the password field optional and consuming its cleaned value reports the empty credential"
  lang python
  expect VYQL-AUTH-169
  code
  ```
  def accounts_register(request, password_auth_enabled, password_required):
      form = RegistrationForm(request.POST)
      if not (password_auth_enabled(request.realm) and password_required):
          # SSO signup: no password prompted for this user
          form['password'].field.required = False

      if form.is_valid():
          if password_auth_enabled(request.realm):
              password = form.cleaned_data['password']
          else:
              # SSO users don't need no passwords
              password = None

          full_name = form.cleaned_data['full_name']
          short_name = email_to_username(email)
          user_profile = do_create_user(email, password, request.realm, full_name, short_name)
          return user_profile
  ```

test "rank1999: consulting the field's required-ness before consuming the password is not reported"
  lang python
  reject VYQL-AUTH-169
  code
  ```
  def accounts_register(request, password_auth_enabled, password_required):
      form = RegistrationForm(request.POST)
      if not (password_auth_enabled(request.realm) and password_required):
          # SSO signup: no password prompted for this user
          form['password'].field.required = False

      if form.is_valid():
          if password_auth_enabled(request.realm) and form['password'].field.required:
              password = form.cleaned_data['password']
          else:
              # None causes Django to create an unusable password
              password = None

          full_name = form.cleaned_data['full_name']
          short_name = email_to_username(email)
          user_profile = do_create_user(email, password, request.realm, full_name, short_name)
          return user_profile
  ```

test "rank1999: coalescing the cleaned password to null is not reported"
  lang python
  reject VYQL-AUTH-169
  code
  ```
  def accounts_register(request, password_auth_enabled, password_required):
      form = RegistrationForm(request.POST)
      if not (password_auth_enabled(request.realm) and password_required):
          # SSO signup: no password prompted for this user
          form['password'].field.required = False

      if form.is_valid():
          # an absent password becomes None, an unusable password
          password = form.cleaned_data['password'] or None

          full_name = form.cleaned_data['full_name']
          short_name = email_to_username(email)
          user_profile = do_create_user(email, password, request.realm, full_name, short_name)
          return user_profile
  ```

test "rank1999: the relaxation token carries no field name, so an unrelated field relaxed beside a consumed password is still reported"
  lang python
  expect VYQL-AUTH-169
  code
  ```
  def accounts_register(request, password_auth_enabled):
      form = RegistrationForm(request.POST)
      if not password_auth_enabled(request.realm):
          # the realm's subdomain is optional, the password is not
          form['realm_subdomain'].field.required = False

      if form.is_valid():
          password = form.cleaned_data['password']
          full_name = form.cleaned_data['full_name']
          user_profile = do_create_user(email, password, request.realm, full_name, short_name)
          return user_profile
  ```

  # Known limit, pinned rather than hidden: the assignment token renders the
  # relaxed field's subscript key away (`assign:form[].field.required=False`),
  # so the binding cannot tell which field was relaxed and anchors on the
  # password consumption instead. A function that relaxes an unrelated field
  # and consumes a still-required password matches. The exhaustive enumeration
  # across the ~197 clones found no such function outside this CVE's own
  # signup flow, so the direction costs nothing measured.
