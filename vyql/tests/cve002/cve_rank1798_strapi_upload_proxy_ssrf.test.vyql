# The Strapi upload plugin shipped a server-side fetch proxy reachable by
# any authenticated admin request. GET /upload/proxy (registered in
# packages/strapi-plugin-upload/config/routes.json with an empty policy
# list) routed to controllers/proxy.js uploadProxy, which read
# ctx.query.url, re-parsed it for an http/https protocol check and an
# is-valid-domain hostname check, and then handed the very same query
# parameter to node-fetch a second time -- forwarding the caller's own
# headers minus origin/host/authorization and relaying the response status
# and body back. Neither check constrains where the server connects: a
# syntactically valid public hostname passes both, and every
# network-internal address the resolver will answer for is reachable
# through the plugin's own origin (CWE-918). The fixed revision removes the proxy
# entirely -- the route entry, the controller and its e2e test are deleted,
# and the admin media library components stop calling
# `${strapi.backendURL}/${pluginId}/proxy?url=...` and fetch file.fileURL
# from the browser directly, so no server-side request is made at all.
#
# CAUGHT by the existing SSRF rule: javascript.input's ctx.query binding
# labels the query read code.HttpInput, javascript.sinks' node-fetch
# binding labels the first argument code.UrlFetch, and VYQL-RF-001
# (taint core.UserControlledData -> code.UrlFetch) reports the hop; the
# rule's core.AllowlistValidation unless-clauses stay unsatisfied because
# a protocol allowlist and a hostname syntax check are not an address
# allowlist. Nothing new is added here -- the spec pins the pair.

test "rank1798: upload proxy fetches the caller-chosen query url server-side"
  lang javascript
  file packages/strapi-plugin-upload/controllers/proxy.js
  expect VYQL-RF-001
  code
  ```
  'use strict';

  const _ = require('lodash');
  const fetch = require('node-fetch');
  const isValidDomain = require('is-valid-domain');

  module.exports = {
    async uploadProxy(ctx) {
      try {
        const url = new URL(ctx.query.url);

        if (!['http:', 'https:'].includes(url.protocol)) {
          throw new Error('Unexpected url protocol');
        }

        if (!isValidDomain(url.hostname)) {
          throw new Error('Invalid url hostname');
        }
      } catch (err) {
        ctx.status = 400;
        ctx.body = 'Invalid URL';
        return;
      }

      try {
        const res = await fetch(new URL(ctx.query.url), {
          headers: _.omit(ctx.request.headers, ['origin', 'host', 'authorization']),
        });

        ctx.status = res.status;
        ctx.body = res.body;
      } catch (err) {
        ctx.status = 500;
        ctx.body = 'Internal Server Error';
      }
    },
  };
  ```

test "rank1798: the media library downloads the file url in the browser"
  lang javascript
  file packages/strapi-plugin-upload/admin/src/containers/ModalStepper/index.js
  reject VYQL-RF-001
  code
  ```
  import axios from 'axios';

  const getDataToDownload = async (file, tracker) => {
    const { source } = file;

    return axios
      .get(file.fileURL, {
        responseType: 'blob',
        cancelToken: source.token,
        timeout: 60000,
        onDownloadProgress: (progressEvent) => tracker.onProgress(progressEvent),
      })
      .then(({ data }) => data);
  };

  export default getDataToDownload;
  ```

test "rank1798: a program-authored url is the documented node-fetch form"
  lang javascript
  file packages/strapi-plugin-upload/controllers/remote.js
  reject VYQL-RF-001
  code
  ```
  'use strict';

  const fetch = require('node-fetch');

  module.exports = {
    async healthcheck() {
      const res = await fetch(new URL('https://strapi.io/status'), {
        method: 'HEAD',
      });

      return { up: res.ok };
    },
  };
  ```
