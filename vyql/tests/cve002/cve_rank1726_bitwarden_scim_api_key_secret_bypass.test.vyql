# Rank 1726 / CVE-2026-43640: Bitwarden's organization api-key endpoints
# released the SCIM API key without the master-password re-authentication the
# sibling key types require. Both PostApiKey and PostRotateApiKey guarded the
# credential release with `if (model.Type != OrganizationApiKeyType.Scim &&
# !await _userService.VerifySecretAsync(user, model.Secret)) throw; else
# return new ApiKeyResponseModel(organizationApiKey);` -- the verification is
# the second operand of the conjunction, so a caller who posts Type == Scim
# makes the first operand false, the verification never evaluates, and the key
# is returned with only the ManageScim permission standing (CWE-287). The fixed revision
# drops the type operand and verifies the secret for every key type.
#
# FIXED by a concept, a rule and one binding: code.GatedSecretVerificationBypass
# states the class -- a credential release whose secret verification is a
# skip-able conjunct rather than the whole guard. Nothing fired before: the
# scan of the vulnerable revision reports nothing at either guard. The C#
# binding anchors on the standard credential-verification vocabulary (a
# Verify/Check call negated behind `&&`) plus a credential-named release in the
# same function, so any endpoint that releases an ApiKey/AccessToken/
# ClientSecret/SecretKey/Credential while its verification sits behind another
# conjunct reports. The verification as the sole condition -- the patched form
# -- does not match, and neither does the sibling reset-password-enrollment
# endpoint, which gates the same verification behind the TDE check but releases
# no credential.

test "rank1726: api-key release with the secret verification skip-able behind the key-type conjunct"
  lang csharp
  file Api/AdminConsole/Controllers/OrganizationsController.cs
  expect VYQL-AUTH-149
  expect_review code.GatedSecretVerificationBypass
  code
  ```
  using System;
  using System.Threading.Tasks;

  namespace Bitwarden.Api.AdminConsole.Controllers
  {
      public class OrganizationsController : Controller
      {
          private readonly IUserService _userService;
          private readonly IGetOrganizationApiKeyQuery _getOrganizationApiKeyQuery;

          [HttpPost("{id}/api-key")]
          public async Task<ApiKeyResponseModel> ApiKey(string id, [FromBody] OrganizationApiKeyRequestModel model)
          {
              var organizationApiKey = await _getOrganizationApiKeyQuery
                                           .GetOrganizationApiKeyAsync(new Guid(id), model.Type);
              var user = await _userService.GetUserByPrincipalAsync(User);
              if (user == null)
              {
                  throw new UnauthorizedAccessException();
              }

              if (model.Type != OrganizationApiKeyType.Scim
                  && !await _userService.VerifySecretAsync(user, model.Secret))
              {
                  await Task.Delay(2000);
                  throw new BadRequestException("MasterPasswordHash", "Invalid password.");
              }

              var response = new ApiKeyResponseModel(organizationApiKey);
              return response;
          }
      }
  }
  ```

test "rank1726: the same endpoint verifying the secret as the whole guard"
  lang csharp
  file Api/AdminConsole/Controllers/OrganizationsController.cs
  reject VYQL-AUTH-149
