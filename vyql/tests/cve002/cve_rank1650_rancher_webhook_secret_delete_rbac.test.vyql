# Rank 1650 / CVE-2023-22647: Rancher's admission webhook let a
# standard user's secret delete strand the RBAC that granted access
# to that secret's name, so the permission outlived the resource it
# is scoped to (improper preservation of permissions, CWE-269/CWE-281;
# GHSA-p976-h52c-26p6). Rancher's cloud-credential controller
# (pkg/controllers/management/cloudcredential/controller.go) creates a
# Role and RoleBinding owned by the secret and granting the creator
# verbs on that one secret name; a user who deletes their own secret
# with OrphanDependents: true or PropagationPolicy: Orphan keeps the
# owned Role and RoleBinding alive, and the surviving grant on the
# secret NAME attaches to whatever secret is created under that name
# next -- the advisory's "secret being deleted, but their read-level
# permissions to the secret being preserved" -- reaching service
# account tokens in the local cluster and Administrator. The webhook's
# secret mutator (pkg/resources/mutation/secret/secret.go) handled
# Create only: it stamped the creator annotation on
# provisioning.cattle.io/cloud-credential secrets and allowed every
# other request, and no handler ran at Delete time at all. The pool
# row names rancher/rancher at efc731b553, the merge of the
# release/v2.7.4-clean PR -- a release merge bundling four CVE fixes
# (the manage-namespaces verb for CVE-2020-10676, the Azure provider
# rework for CVE-2023-22648) whose only relation to this CVE is
# bumping CATTLE_RANCHER_WEBHOOK_MIN_VERSION from 2.0.3+up0.3.3 to
# 2.0.4+up0.3.4. The fixing change is in the rancher/webhook repository, the
# release the bump ships: e7d89fd adds a Delete validator that denies
# orphaning deletes of secrets owning Roles or RoleBindings, and
# 09947e7 (companion, same release) adds Delete to the secret mutator
# and de-powers the per-secret get rule to delete-only verbs as the
# secret goes away. The row is corrected in place: it belongs to rancher/webhook
# at e7d89fd61afaa0697a92f9a6d05036ea86960a3b.
#
# ATTENTION, deletion-time revocation vocabulary, the
# authorization-by-wiring family of ranks 1514/1535/1540/1556/1557/
# 1593. The defect is an absent admission control: the vulnerable
# revision contains no Delete path to label, no tainted value reaches
# a sink, and the single semantically relevant line -- Operations()
# returning Create only -- is ordinary for a mutator that only stamps
# create-time defaults (the machineconfigs mutator in the same file
# is Create-only and harmless). Telling the two apart needs the
# product knowledge that this resource carries per-name RBAC that
# Kubernetes garbage collection would otherwise own; that fact lives
# in rancher's controller, not in this repository or in the admission
# API's documentation, so the genericity test fails any Create-only
# mutator binding, and keying on the remediation's own calls
# (roleController.Update, GetByIndex) detects the fixed revision's layout rather
# than the weakness. The 1380 counterweight does not apply: no
# API-documented call remains inside a guarded function, because the
# fix adds two whole handlers rather than a check inside an existing
# one. The corpus has no concept for "a permission grant survives the
# deletion of the resource it is scoped to" -- the nearest rule,
# VYQL-AUTH-028 (OverbroadRolePermissionGrant, CWE-269/CWE-863,
# escalating through PrivilegeEscalation and IncorrectAuthorization),
# judges static role permission tables, and VYQL-AUTH-076
# (OwnedResourceDeleteMissingOwnershipCheck) judges delete handlers
# that skip an ownership check, the inverse failure. Measured on the
# real code: scanning rancher/webhook at e7d89fd^ and at v0.3.4
# reports the same eight findings at both revisions over three runs
# each (three VYQL-CFG-010 privileged-container rows on .drone.yml,
# four VYQL-CRY-001 weak-hash marks in the generated wrangler
# factories, one VYQL-CFG-011 host-namespace-share on the helm
# chart); vyql match on the secret mutator, the validator and
# handlers.go at both revisions reports no source and no sink label
# (the patched validator draws only two incidental
# core.SafeDeserialization control labels on its json.Unmarshal).
# No ENGINE-GAPS.md entry: nothing is localised to a construct, the
# missing piece is a revocation-on-delete review concept whose
# binding site needs knowledge outside the webhook's own API. No
# definition change shipped. Spec cve_rank1650 records the
# Create-only mutator that grants on create and the delete-time
# revocation form, both asserting reject VYQL-AUTH-028: when
# deletion-revocation vocabulary lands, the Create-only form must
# flip to expect.

test "rank1650: the secret mutator handles create only"
  lang go
  file pkg/resources/mutation/secret/secret.go
  reject VYQL-AUTH-028
  code
  ```
  package secret

  import (
      "fmt"

      "github.com/rancher/webhook/pkg/admission"
      "github.com/rancher/webhook/pkg/auth"
      objectsv1 "github.com/rancher/webhook/pkg/generated/objects/core/v1"
      "github.com/rancher/webhook/pkg/patch"
      admissionv1 "k8s.io/api/admission/v1"
      admissionregistrationv1 "k8s.io/api/admissionregistrationv1"
  )

  // Mutator implements admission.MutatingAdmissionWebhook.
  type Mutator struct{}

  // Operations returns list of operations handled by this mutator.
  func (m *Mutator) Operations() []admissionregistrationv1.OperationType {
      return []admissionregistrationv1.OperationType{admissionregistrationv1.Create}
  }

  // Admit is the entrypoint for the mutator.
  func (m *Mutator) Admit(request *admission.Request) (*admissionv1.AdmissionResponse, error) {
      secret, err := objectsv1.SecretFromRequest(&request.AdmissionRequest)
      if err != nil {
          return nil, err
      }

      if secret.Type != "provisioning.cattle.io/cloud-credential" {
          return &admissionv1.AdmissionResponse{
              Allowed: true,
          }, nil
      }

      // the creator is granted a role scoped to this secret's name,
      // so on create the annotation names the principal behind it
      newSecret := secret.DeepCopy()
      if newSecret.Annotations == nil {
          newSecret.Annotations = make(map[string]string)
      }
      newSecret.Annotations[auth.CreatorIDAnn] = request.UserInfo.Username
      response := &admissionv1.AdmissionResponse{}
      if err := patch.CreatePatch(request.Object.Raw, newSecret, response); err != nil {
          return nil, fmt.Errorf("failed to create patch: %w", err)
      }
      response.Allowed = true
      return response, nil
  }
  ```

test "rank1650: the fixed revision revokes the grant as the secret is deleted"
  lang go
  file pkg/resources/mutation/secret/secret.go
  reject VYQL-AUTH-028
  code
  ```
  package secret

  import (
      "fmt"

      "github.com/rancher/webhook/pkg/admission"
      "github.com/rancher/webhook/pkg/auth"
      objectsv1 "github.com/rancher/webhook/pkg/generated/objects/core/v1"
      v1 "github.com/rancher/wrangler/pkg/generated/controllers/rbac/v1"
      "github.com/rancher/webhook/pkg/patch"
      admissionv1 "k8s.io/api/admission/v1"
      admissionregistrationv1 "k8s.io/api/admissionregistrationv1"
      corev1 "k8s.io/api/core/v1"
      rbacv1 "k8s.io/api/rbac/v1"
      apierrors "k8s.io/apimachinery/pkg/api/errors"
  )

  // Mutator implements admission.MutatingAdmissionWebhook.
  type Mutator struct {
      roleController        v1.RoleController
      roleBindingController v1.RoleBindingController
  }

  // Operations returns list of operations handled by this mutator.
  func (m *Mutator) Operations() []admissionregistrationv1.OperationType {
      return []admissionregistrationv1.OperationType{admissionregistrationv1.Create, admissionregistrationv1.Delete}
  }

  // Admit is the entrypoint for the mutator.
  func (m *Mutator) Admit(request *admission.Request) (*admissionv1.AdmissionResponse, error) {
      secret, err := objectsv1.SecretFromRequest(&request.AdmissionRequest)
      if err != nil {
          return nil, err
      }
      switch request.Operation {
      case admissionv1.Create:
          return m.admitCreate(secret, request)
      case admissionv1.Delete:
          return m.admitDelete(secret, request)
      default:
          return nil, fmt.Errorf("operation type %q not handled", request.Operation)
      }
  }

  // admitDelete checks for roleBindings owned by this secret which grant
  // access to a role granting access to this secret; if found, the role is
  // redacted so that it only grants delete access, and the permission does
  // not survive the secret that scopes it.
  func (m *Mutator) admitDelete(secret *corev1.Secret, request *admission.Request) (*admissionv1.AdmissionResponse, error) {
      roleBindings, err := m.roleBindingController.Cache().GetByIndex(roleBindingOwnerIndex, fmt.Sprintf(ownerFormat, secret.Namespace, secret.Name))
      if err != nil {
          return nil, fmt.Errorf("unable to determine if secret %s/%s has rbac references: %w", secret.Namespace, secret.Name, err)
      }
      for _, roleBinding := range roleBindings {
          role, err := m.roleController.Cache().Get(roleBinding.Namespace, roleBinding.RoleRef.Name)
          if err != nil {
              if apierrors.IsNotFound(err) {
                  continue
              }
              return nil, err
          }
          rules, amended := amendRulesToOnlyPermitDelete(role.Rules, secret.Name)
          if amended {
              role.Rules = rules
              if _, err := m.roleController.Update(role); err != nil && !apierrors.IsNotFound(err) {
                  return nil, err
              }
          }
      }
      return &admissionv1.AdmissionResponse{Allowed: true}, nil
  }

  // amendRulesToOnlyPermitDelete changes rules granting get level access to
  // the named secret so that they only give delete access.
  func amendRulesToOnlyPermitDelete(rules []rbacv1.PolicyRule, secretName string) ([]rbacv1.PolicyRule, bool) {
      amended := false
      for i, rule := range rules {
          apiGroupMatches := len(rule.APIGroups) == 1 && (rule.APIGroups[0] == "" || rule.APIGroups[0] == "*")
          resourceMatches := len(rule.Resources) == 1 && rule.Resources[0] == "secrets"
          nameMatches := len(rule.ResourceNames) == 1 && rule.ResourceNames[0] == secretName
          hasGet := false
          for _, verb := range rule.Verbs {
              if verb == "get" || verb == "*" {
                  hasGet = true
                  break
              }
          }
          if apiGroupMatches && resourceMatches && nameMatches && hasGet {
              amended = true
              rule.Verbs = []string{"delete"}
              rules[i] = rule
          }
      }
      return rules, amended
  }
  ```
