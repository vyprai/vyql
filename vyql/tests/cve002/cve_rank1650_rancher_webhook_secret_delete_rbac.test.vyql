# Rancher's admission webhook let a standard user's secret delete strand
# the RBAC that granted access to that secret's name, so the permission
# outlived the resource it is scoped to (improper preservation of
# permissions, CWE-269/CWE-281; GHSA-p976-h52c-26p6). Rancher's
# cloud-credential controller (pkg/controllers/management/cloudcredential/
# controller.go, in the rancher repository) creates a Role and RoleBinding
# owned by the secret and granting the creator verbs on that one secret
# name; a user who deletes their own secret with OrphanDependents: true or
# PropagationPolicy: Orphan keeps the owned Role and RoleBinding alive, and
# the surviving grant on the secret NAME attaches to whatever secret is
# created under that name next -- the advisory's "secret being deleted, but
# their read-level permissions to the secret being preserved" -- reaching
# service account tokens in the local cluster and Administrator. The
# webhook's secret mutator (pkg/resources/mutation/secret/secret.go) handled
# Create only: it stamped the creator annotation on
# provisioning.cattle.io/cloud-credential secrets and allowed every other
# request, and no handler ran at Delete time at all.
#
# The fixing change is in this repository, not in the rancher release the
# advisory's first reference names. e7d89fd (verified against the parent
# 1b9d829) adds a Delete validator (pkg/resources/validation/secret/
# secret.go) that denies an orphaning delete of a secret owning Roles or
# RoleBindings; the companion 09947e7, in the same v0.3.4 release, adds
# Delete to the secret mutator and de-powers the per-secret get rule to
# delete-only verbs as the secret goes away.
#
# ATTENTION, deletion-time revocation, the authorization-by-wiring family
# of ranks 1514/1535/1540/1556/1557/1593, rechecked. The defect is an
# absent admission control, and the grant it strands is created in another
# repository, so the vulnerable file holds no RBAC code at all: grepping
# the vulnerable revision for role or rolebinding construction outside
# generated and mock code returns only the fleetworkspace mutator. No
# tainted value reaches a sink and no Delete path exists to label.
#
# Re-measured on the real checkout with the current knowledge base: three
# --cache off runs per revision over the vulnerable parent, the fixing
# commit and the v0.3.4 release each report the identical eight findings
# (three VYQL-CFG-010 privileged-container rows on .drone.yml, four
# VYQL-CRY-001 weak-hash marks in the generated wrangler factories, one
# VYQL-CFG-011 host-namespace-share on the helm chart) and the identical
# five review flags (four lock acquire/release pairs in pkg/health, one
# resource release in pkg/codegen) -- zero added, zero removed by
# fingerprint at every step, and nothing on the secret mutator, the secret
# validator or handlers.go. vyql match on those three files at both
# revisions reports no source and no sink label; the patched validator
# draws only two incidental core.SafeDeserialization control labels on its
# json.Unmarshal.
#
# The one discriminator available inside this repository was measured
# rather than assumed. A presence binding on the mutator's Operations list
# -- Create named, neither Delete nor Update -- fires on exactly three
# functions at the vulnerable revision and reports VYQL-AUTH-028 at each:
# fleetworkspace.go:58, machineconfigs.go:30 and secret.go:32. At the
# fixing commit e7d89fd it still fires on the same three, because that
# commit adds a validator and leaves every mutator untouched, so the
# binding does not discriminate the row's own fix. Only at v0.3.4, where
# the companion commit adds Delete to the secret mutator, does the row
# count drop to two -- and both survivors are benign: the machineconfigs
# mutator stamps default labels, and the fleetworkspace mutator is this
# repository's own legitimate create-time granter, building a
# creator-bound ClusterRole scoped by ResourceNames and a ClusterRoleBinding
# owned by the workspace's namespace. One true positive in three, with the
# false positives being the shape the binding most wants to catch.
#
# Nothing in the admission API makes Create-only deficient, so the
# genericity test fails that binding: Operations is documented as the list
# of operations this mutator handles, and a mutator that stamps
# create-time defaults is expected to list Create alone. Keying the
# remediation's own vocabulary detects layout instead: roleController,
# roleBindingOwnerIndex, GetByIndex and amendRulesToOnlyPermitDelete occur
# only in the fixed revision's non-generated code, GetByIndex at the parent
# appearing only in mocks and tests. Keying the resource type is equally
# inert and not ours to write: "provisioning.cattle.io/cloud-credential"
# occurs at exactly one non-test site at both revisions and the fix does
# not touch it. The 1380 counterweight does not apply, because the fix adds
# two whole admission handlers rather than a check inside an existing
# function, so no documented call is left inside a guarded body.
#
# No later-shipped vocabulary answers it. The auth concepts added since the
# first pass ask about sessions, scopes and ignored results --
# LogoutWithoutSessionInvalidation, SessionAuthStateOwnerBindingMissing,
# SessionUserInstallWithoutAuthenticationCheck, UndeclaredScopeSkipsEnforcement,
# UnverifiedCredential, WildcardAuthScopeCredentialRegistration,
# IgnoredAuthorizationResult, RequestScopePolicyReview,
# RemoteMethodCodeExecutionMissingAuthorization -- and the nearest existing
# rule VYQL-AUTH-028 (OverbroadRolePermissionGrant, CWE-269/CWE-863) judges
# static role permission tables, while VYQL-AUTH-076
# (OwnedResourceDeleteMissingOwnershipCheck) judges delete handlers that
# skip an ownership check, the inverse failure. What is missing is the
# question whether a permission grant survives the deletion of the
# resource it is scoped to, whose binding site needs the controller-side
# knowledge that this resource carries per-name RBAC; that fact lives in
# rancher's cloud-credential controller, not in this repository or in the
# admission API's documentation. No ENGINE-GAPS.md entry: nothing is
# localised to a construct. No definition change shipped. Spec cve_rank1650
# records the Create-only mutator and both remediation forms, all
# asserting reject VYQL-AUTH-028: when deletion-revocation vocabulary
# lands, the Create-only form must flip to expect.

test "rank1650: the secret mutator handles create only"
  lang go
  file pkg/resources/mutation/secret/secret.go
  reject VYQL-AUTH-028
  code
  ```
  package secret

  import (
      "fmt"

      "github.com/rancher/webhook/pkg/admission"
      "github.com/rancher/webhook/pkg/auth"
      objectsv1 "github.com/rancher/webhook/pkg/generated/objects/core/v1"
      "github.com/rancher/webhook/pkg/patch"
      "github.com/sirupsen/logrus"
      admissionv1 "k8s.io/api/admission/v1"
      admissionregistrationv1 "k8s.io/api/admissionregistration/v1"
  )

  // Mutator implements admission.MutatingAdmissionWebhook.
  type Mutator struct{}

  // Operations returns list of operations handled by this mutator.
  func (m *Mutator) Operations() []admissionregistrationv1.OperationType {
      return []admissionregistrationv1.OperationType{admissionregistrationv1.Create}
  }

  // Admit is the entrypoint for the mutator.
  func (m *Mutator) Admit(request *admission.Request) (*admissionv1.AdmissionResponse, error) {
      if request.DryRun != nil && *request.DryRun {
          return &admissionv1.AdmissionResponse{
              Allowed: true,
          }, nil
      }

      secret, err := objectsv1.SecretFromRequest(&request.AdmissionRequest)
      if err != nil {
          return nil, err
      }

      if secret.Type != "provisioning.cattle.io/cloud-credential" {
          return &admissionv1.AdmissionResponse{
              Allowed: true,
          }, nil
      }

      // the creator holds a role scoped to this secret's name, granted by
      // the controller that owns the secret, so the annotation records the
      // principal the grant belongs to
      logrus.Debugf("[secret-mutation] adding creatorID %v to secret: %v", request.UserInfo.Username, secret.Name)
      newSecret := secret.DeepCopy()
      if newSecret.Annotations == nil {
          newSecret.Annotations = make(map[string]string)
      }
      newSecret.Annotations[auth.CreatorIDAnn] = request.UserInfo.Username
      response := &admissionv1.AdmissionResponse{}
      if err := patch.CreatePatch(request.Object.Raw, newSecret, response); err != nil {
          return nil, fmt.Errorf("failed to create patch: %w", err)
      }
      response.Allowed = true
      return response, nil
  }
  ```

test "rank1650: the fixed revision denies orphaning deletes of rbac-owning secrets"
  lang go
  file pkg/resources/validation/secret/secret.go
  reject VYQL-AUTH-028
  code
  ```
  package secret

  import (
      "encoding/json"
      "fmt"
      "net/http"

      "github.com/rancher/webhook/pkg/admission"
      objectsv1 "github.com/rancher/webhook/pkg/generated/objects/core/v1"
      v1 "github.com/rancher/wrangler/pkg/generated/controllers/rbac/v1"
      admissionv1 "k8s.io/api/admission/v1"
      admissionregistrationv1 "k8s.io/api/admissionregistration/v1"
      corev1 "k8s.io/api/core/v1"
      rbacv1 "k8s.io/api/rbac/v1"
      metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
  )

  // Validator implements admission.ValidatingAdmissionWebhook.
  type Validator struct {
      roleCache        v1.RoleCache
      roleBindingCache v1.RoleBindingCache
  }

  // Operations returns list of operations handled by this validator.
  func (v *Validator) Operations() []admissionregistrationv1.OperationType {
      return []admissionregistrationv1.OperationType{admissionregistrationv1.Delete}
  }

  // Admit is the entrypoint for the validator. Admit will return an error if it is unable to process the request.
  func (v *Validator) Admit(request *admission.Request) (*admissionv1.AdmissionResponse, error) {
      if request.DryRun != nil && *request.DryRun {
          return admission.ResponseAllowed(), nil
      }

      var deleteOpts metav1.DeleteOptions
      err := json.Unmarshal(request.Options.Raw, &deleteOpts)
      if err != nil {
          return nil, fmt.Errorf("unable to unmarshal delete options %w", err)
      }
      hasOrphanDependents := deleteOpts.OrphanDependents != nil && *deleteOpts.OrphanDependents
      hasOrphanPolicy := deleteOpts.PropagationPolicy != nil && *deleteOpts.PropagationPolicy == metav1.DeletePropagationOrphan
      // we are only concerned with requests that attempt to orphan resources
      if !hasOrphanDependents && !hasOrphanPolicy {
          return admission.ResponseAllowed(), nil
      }
      secret, err := objectsv1.SecretFromRequest(&request.AdmissionRequest)
      if err != nil {
          return nil, fmt.Errorf("unable to read secret from request: %w", err)
      }
      roles, roleBindings, err := v.getRbacRefs(secret)
      if err != nil {
          return nil, fmt.Errorf("unable to determine if secret has rbac refs: %w", err)
      }
      // requests which orphan non-rbac resources are allowed
      if len(roles) == 0 && len(roleBindings) == 0 {
          return admission.ResponseAllowed(), nil
      }
      // secret orphans rbac resources, deny the request
      return &admissionv1.AdmissionResponse{
          Allowed: false,
          Result: &metav1.Status{
              Status:  "Failure",
              Message: "A secret which owns RBAC objects cannot be deleted with OrphanDependents: true or PropagationPolicy: Orphan",
              Reason:  metav1.StatusReasonBadRequest,
              Code:    http.StatusBadRequest,
          },
      }, nil
  }

  // getRbacRefs checks to see if there are any existing rbac resources which could be orphaned by this delete call
  func (v *Validator) getRbacRefs(secret *corev1.Secret) ([]*rbacv1.Role, []*rbacv1.RoleBinding, error) {
      roles, err := v.roleCache.GetByIndex(roleOwnerIndex, fmt.Sprintf(ownerFormat, secret.Namespace, secret.Name))
      if err != nil {
          return nil, nil, err
      }
      roleBindings, err := v.roleBindingCache.GetByIndex(roleBindingOwnerIndex, fmt.Sprintf(ownerFormat, secret.Namespace, secret.Name))
      if err != nil {
          return nil, nil, err
      }
      return roles, roleBindings, nil
  }
  ```

test "rank1650: the release revokes the grant as the secret is deleted"
  lang go
  file pkg/resources/mutation/secret/secret.go
  reject VYQL-AUTH-028
  code
  ```
  package secret

  import (
      "fmt"

      "github.com/rancher/webhook/pkg/admission"
      objectsv1 "github.com/rancher/webhook/pkg/generated/objects/core/v1"
      v1 "github.com/rancher/wrangler/pkg/generated/controllers/rbac/v1"
      admissionv1 "k8s.io/api/admission/v1"
      admissionregistrationv1 "k8s.io/api/admissionregistration/v1"
      corev1 "k8s.io/api/core/v1"
      rbacv1 "k8s.io/api/rbac/v1"
      apierrors "k8s.io/apimachinery/pkg/api/errors"
  )

  // Mutator implements admission.MutatingAdmissionWebhook.
  type Mutator struct {
      roleController        v1.RoleController
      roleBindingController v1.RoleBindingController
  }

  // Operations returns list of operations handled by this mutator.
  func (m *Mutator) Operations() []admissionregistrationv1.OperationType {
      return []admissionregistrationv1.OperationType{admissionregistrationv1.Create, admissionregistrationv1.Delete}
  }

  // Admit is the entrypoint for the mutator.
  func (m *Mutator) Admit(request *admission.Request) (*admissionv1.AdmissionResponse, error) {
      secret, err := objectsv1.SecretFromRequest(&request.AdmissionRequest)
      if err != nil {
          return nil, err
      }
      switch request.Operation {
      case admissionv1.Create:
          return m.admitCreate(secret, request)
      case admissionv1.Delete:
          return m.admitDelete(secret, request)
      default:
          return nil, fmt.Errorf("operation type %q not handled", request.Operation)
      }
  }

  // admitDelete checks for roleBindings owned by this secret which grant
  // access to a role granting access to this secret; if found, the role is
  // redacted so that it only grants delete access, and the permission does
  // not survive the secret that scopes it.
  func (m *Mutator) admitDelete(secret *corev1.Secret, request *admission.Request) (*admissionv1.AdmissionResponse, error) {
      roleBindings, err := m.roleBindingController.Cache().GetByIndex(roleBindingOwnerIndex, fmt.Sprintf(ownerFormat, secret.Namespace, secret.Name))
      if err != nil {
          return nil, fmt.Errorf("unable to determine if secret %s/%s has rbac references: %w", secret.Namespace, secret.Name, err)
      }
      for _, roleBinding := range roleBindings {
          role, err := m.roleController.Cache().Get(roleBinding.Namespace, roleBinding.RoleRef.Name)
          if err != nil {
              if apierrors.IsNotFound(err) {
                  continue
              }
              return nil, err
          }
          rules, amended := amendRulesToOnlyPermitDelete(role.Rules, secret.Name)
          if amended {
              role.Rules = rules
              if _, err := m.roleController.Update(role); err != nil && !apierrors.IsNotFound(err) {
                  return nil, err
              }
          }
      }
      return &admissionv1.AdmissionResponse{Allowed: true}, nil
  }

  // amendRulesToOnlyPermitDelete changes rules granting get level access to
  // the named secret so that they only give delete access.
  func amendRulesToOnlyPermitDelete(rules []rbacv1.PolicyRule, secretName string) ([]rbacv1.PolicyRule, bool) {
      amended := false
      for i, rule := range rules {
          apiGroupMatches := len(rule.APIGroups) == 1 && (rule.APIGroups[0] == "" || rule.APIGroups[0] == "*")
          resourceMatches := len(rule.Resources) == 1 && rule.Resources[0] == "secrets"
          nameMatches := len(rule.ResourceNames) == 1 && rule.ResourceNames[0] == secretName
          hasGet := false
          for _, verb := range rule.Verbs {
              if verb == "get" || verb == "*" {
                  hasGet = true
                  break
              }
          }
          if apiGroupMatches && resourceMatches && nameMatches && hasGet {
              amended = true
              rule.Verbs = []string{"delete"}
              rules[i] = rule
          }
      }
      return rules, amended
  }
  ```
