  fn entry_path(pax_extensions: Option<&[u8]>) -> io::Result<()> {
      if let Some(pax) = pax_extensions {
          let _ = pax.len();
      }
      Ok(())
  }
  ```

test "tokio-tar: patched framing consults the pax records before sizing the data read"
  lang rust
  file src/archive.rs
  reject VYQL-VAL-035
  code
  ```
  use std::io;

  struct Header;

  impl Header {
      fn new_old() -> Header {
          Header
      }

      fn entry_size(&self) -> io::Result<u64> {
          Ok(0)
      }
  }

  struct PaxExtension<'a>(&'a [u8]);

  impl<'a> PaxExtension<'a> {
      fn key(&self) -> Result<&str, ()> {
          Ok("")
      }

      fn value(&self) -> Result<&str, ()> {
          Ok("")
      }
  }

  struct PaxIter<'a>(Option<PaxExtension<'a>>);

  impl<'a> Iterator for PaxIter<'a> {
      type Item = Result<PaxExtension<'a>, ()>;

      fn next(&mut self) -> Option<Self::Item> {
          None
      }
  }

  fn pax_extensions(data: &[u8]) -> PaxIter<'_> {
      let _ = data;
      PaxIter(None)
  }

  struct Archive;

  impl Clone for Archive {
      fn clone(&self) -> Archive {
          Archive
      }
  }

  impl Archive {
      fn take(&self, _size: u64) -> Archive {
          Archive
      }
  }

  struct EntryIo;

  impl EntryIo {
      fn data(_archive: Archive) -> EntryIo {
          EntryIo
      }
  }

  fn poll_next_raw(pax_extensions_data: Option<&[u8]>) -> io::Result<u64> {
      let mut header = Header::new_old();
      let mut size = header.entry_size()?;
      if let Some(pax) = pax_extensions_data.map(pax_extensions) {
          for extension in pax {
              let extension = extension.map_err(|_e| io::Error::other("parse"))?;
              let Ok(key) = extension.key() else {
                  continue;
              };
              match key {
                  "size" => {
                      let size_str =
                          extension.value().map_err(|_e| io::Error::other("value"))?;
                      size = size_str
                          .parse::<u64>()
                          .map_err(|_e| io::Error::other("size"))?;
                  }
                  _ => {
                      continue;
                  }
              }
          }
      }
      let data = EntryIo::data(Archive.clone().take(size));
      let _ = data;
      Ok(size)
  }
  ```

test "tokio-tar: a lookup-helper consult in the framing function clears the flag"
  lang rust
  file src/archive.rs
  reject VYQL-VAL-035
  code
  ```
  use std::io;

  struct Header;

  impl Header {
      fn new_old() -> Header {
          Header
      }

      fn entry_size(&self) -> io::Result<u64> {
          Ok(0)
      }
  }

  fn pax_extensions_value(_data: &[u8], _key: &str) -> Option<u64> {
      None
  }

  struct Archive;

  impl Clone for Archive {
      fn clone(&self) -> Archive {
          Archive
      }
  }

  impl Archive {
      fn take(&self, _size: u64) -> Archive {
          Archive
      }
  }

  struct EntryIo;

  impl EntryIo {
      fn data(_archive: Archive) -> EntryIo {
          EntryIo
      }
  }

  fn poll_next_raw(pax_extensions: Option<&[u8]>) -> io::Result<u64> {
      let mut header = Header::new_old();
      let mut size = header.entry_size()?;
      if let Some(pax_size) = pax_extensions.and_then(|p| pax_extensions_value(p, "size")) {
          size = pax_size;
      }
      let data = EntryIo::data(Archive.clone().take(size));
      let _ = data;
      let _ = header;
      Ok(size)
  }
  ```
