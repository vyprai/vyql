test "rank1153: the library's vulnerable jar code has no pin and is not the report"
  lang php
  file CookieJar.php
  code
  ```
  <?php
  namespace GuzzleHttp\Cookie;

  class CookieJar
  {
      public function extractCookies($request, $response)
      {
          if ($cookieHeader = $response->getHeader('Set-Cookie')) {
              foreach ($cookieHeader as $cookie) {
                  $sc = SetCookie::fromString($cookie);
                  if (!$sc->getDomain()) {
                      $sc->setDomain($request->getUri()->getHost());
                  }
                  $this->setCookie($sc);
              }
          }
      }
  }
  ```
  reject VYQL-SCA-001
  reject VYQL-SEC-025

test "rank1153: the library's fixed jar code drops a cookie whose domain does not match"
  lang php
  file CookieJar.php
  code
  ```
  <?php
  namespace GuzzleHttp\Cookie;

  class CookieJar
  {
      public function extractCookies($request, $response)
      {
          if ($cookieHeader = $response->getHeader('Set-Cookie')) {
              foreach ($cookieHeader as $cookie) {
                  $sc = SetCookie::fromString($cookie);
                  if (!$sc->getDomain()) {
                      $sc->setDomain($request->getUri()->getHost());
                  }
                  if (!$sc->matchesDomain($request->getUri()->getHost())) {
                      continue;
                  }
                  $this->setCookie($sc);
              }
          }
      }
  }
  ```
  reject VYQL-SCA-001
  reject VYQL-SEC-025
