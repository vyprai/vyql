# A note application verified passwords, TOTP secrets, recovery codes, sync
# login hashes and ETAPI tokens by comparing the submitted hash with === or
# Buffer.equals instead of a constant-time comparison. The fixed revision routes every
# verification through crypto.timingSafeEqual (via a constantTimeCompare
# helper) and a length check.

test "submitted password hash compared to stored hash with ==="
  lang javascript
  file verify.ts
  expect VYQL-CRY-006
  expect_review code.SecretComparisonReview
  code
  ```
  import optionService from "./options.js";
  import myScryptService from "./my_scrypt.js";
  import { toBase64 } from "./utils.js";

  function verifyPassword(password: string) {
      const givenPasswordHash = toBase64(myScryptService.getVerificationHash(password));

      const dbPasswordHash = optionService.getOptionOrNull("passwordVerificationHash");

      if (!dbPasswordHash) {
          return false;
      }

      return givenPasswordHash === dbPasswordHash;
  }
  ```

test "sync login hash rejected with !=="
  lang javascript
  file loginsync.ts
  expect VYQL-CRY-006
  expect_review code.SecretComparisonReview
  code
  ```
  import utils from "../services/utils.js";
  import options from "../services/options.js";

  function loginSync(req, timestampStr) {
      const documentSecret = options.getOption("documentSecret");
      const expectedHash = utils.hmac(documentSecret, timestampStr);

      const givenHash = req.body.hash;

      if (expectedHash !== givenHash) {
          return [400, { message: "Sync login credentials are incorrect." }];
      }

      req.session.loggedIn = true;
  }
  ```

test "password verification hash compared with Buffer.equals"
  lang javascript
  file password.ts
  expect VYQL-CRY-006
  expect_review code.SecretComparisonReview
  code
  ```
  import utils from "../services/utils.js";
  import optionService from "../services/options.js";
  import myScryptService from "../services/encryption/my_scrypt.js";

  function verifyPassword(submittedPassword: string) {
      const hashed_password = utils.fromBase64(optionService.getOption("passwordVerificationHash"));

      const guess_hashed = myScryptService.getVerificationHash(submittedPassword);

      return guess_hashed.equals(hashed_password);
  }
  ```

test "constant-time comparison of password hashes and buffers"
  lang javascript
  file verify_patched.ts
  reject VYQL-CRY-006
  reject_review code.SecretComparisonReview
  code
  ```
  import crypto from "crypto";
  import optionService from "../services/options.js";
  import myScryptService from "../services/encryption/my_scrypt.js";
  import { constantTimeCompare } from "../services/utils.js";

  function verifyPassword(password: string) {
      const givenPasswordHash = toBase64(myScryptService.getVerificationHash(password));
      const dbPasswordHash = optionService.getOptionOrNull("passwordVerificationHash");

      if (!dbPasswordHash) {
          return false;
      }

      return constantTimeCompare(givenPasswordHash, dbPasswordHash);
  }

  function verifyPasswordBuffer(submittedPassword: string) {
      const hashed_password = utils.fromBase64(optionService.getOption("passwordVerificationHash"));
      const guess_hashed = myScryptService.getVerificationHash(submittedPassword);

      if (hashed_password.length !== guess_hashed.length) {
          return false;
      }
      return crypto.timingSafeEqual(guess_hashed, hashed_password);
  }
  ```
