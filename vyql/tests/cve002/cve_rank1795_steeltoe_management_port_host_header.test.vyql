  code
  ```
  using Microsoft.AspNetCore.Http;
  using Microsoft.Extensions.Logging;
  using System;
  using System.Collections.Generic;
  using System.Linq;
  using System.Threading.Tasks;

  namespace Steeltoe.Management.Endpoint.ManagementPort
  {
      public class ManagementPortMiddleware
      {
          private readonly RequestDelegate _next;
          private readonly ILogger<ManagementPortMiddleware> _logger;
          private readonly IManagementOptions _managementOptions;

          public ManagementPortMiddleware(RequestDelegate next, IEnumerable<IManagementOptions> managementOptions, ILogger<ManagementPortMiddleware> logger = null)
          {
              _next = next;
              _logger = logger;
              _managementOptions = managementOptions.OfType<ManagementEndpointOptions>().First();
          }

          public async Task InvokeAsync(HttpContext context)
          {
              string contextPath = _managementOptions.Path;
              bool isManagementPath = context.Request.Path.ToString().StartsWith(contextPath, StringComparison.OrdinalIgnoreCase);

              bool allowRequest = string.IsNullOrEmpty(_managementOptions.Port);
              allowRequest = allowRequest || (context.Connection.LocalPort.ToString() == _managementOptions.Port && isManagementPath);
              allowRequest = allowRequest || (context.Connection.LocalPort.ToString() != _managementOptions.Port && !isManagementPath);

              if (!allowRequest)
              {
                  context.Response.StatusCode = StatusCodes.Status404NotFound;
                  return;
              }

              await _next(context);
          }
      }
  }
  ```

test "rank1795: the Host header rendered into a URL is not a gate"
  lang csharp
  file Steeltoe/Management/src/EndpointCore/Hypermedia/ActuatorHypermediaEndpointMiddleware.cs
  reject VYQL-AUTH-159
  reject_review code.HostHeaderPortAccessCondition
  code
  ```
  using Microsoft.AspNetCore.Http;

  namespace Steeltoe.Management.Endpoint.Hypermedia
  {
      public class ActuatorHypermediaEndpointMiddleware
      {
          public string GetBaseUrl(HttpContext context)
          {
              string scheme = "http";
              // request.Host automatically includes or excludes the port based on whether it is standard for the scheme
              if (scheme == "https")
              {
                  return $"{scheme}://{context.Request.Host.Host}{context.Request.PathBase}{context.Request.Path}";
              }

              return $"{scheme}://{context.Request.Host}{context.Request.PathBase}{context.Request.Path}";
          }

          public void Note(HttpContext context)
          {
              _logger?.LogDebug("saw {0} on {1}", context.Request.Path, context.Request.Host.Port);
          }
      }
  }
  ```
