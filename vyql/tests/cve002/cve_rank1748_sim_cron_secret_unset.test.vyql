# CVE-2025-15099: sim's scheduled endpoints authenticated with a bearer
# comparison whose expected side is built from an optional configuration
# read. verifyCronAuth (apps/sim/lib/auth/internal.ts) read the request's
# authorization header and compared it against `Bearer ${env.CRON_SECRET}`
# with a plain !==. CRON_SECRET is z.string().optional() behind
# skipValidation: true, so a deployment that never sets it compares the
# caller's header against the literal text "Bearer undefined" (or "Bearer "
# for an empty value) and authorizes whoever sends that degenerate value --
# every cron route guarding with verifyCronAuth (schedules/execute, the
# webhook polls, the cleanup jobs) becomes callable unauthenticated. The fixed revision
# (e359dc2) makes the check fail closed: `if (!env.CRON_SECRET) return 401`
# ahead of the comparison, and the same commit gives
# validateWorkflowAccess's internal-secret comparison the conjunct form
# `env.INTERNAL_API_SECRET && internalSecret === env.INTERNAL_API_SECRET`.
#
# FIXED by a concept, a check concept, a rule and two bindings:
# code.OptionalSecretComparisonFailOpen states the class -- a credential
# comparison whose expected side comes from an environment read, with no
# fail-closed presence check on that read in the deciding function. The
# issue binding anchors on the two documented APIs involved: Headers.get
# returns whatever the client sent, and every environment wrapper types its
# reads string | undefined, so the equality can succeed against the
# interpolated undefined. core.ConfiguredSecretPresenceCheck labels the
# documented fail-closed idiom (`!env.X` rejecting ahead of the comparison)
# so VYQL-AUTH-150's unless can hold the comparison to it; the conjunct
# form (`env.X && supplied === env.X`) is handled on the comparison itself,
# since the guard cannot dominate its own operand. Measured on the real
# tree: apps/sim/lib reports VYQL-AUTH-150 at auth/internal.ts:74 on the
# vulnerable revision (630 findings over three --cache off runs against a
# 629 baseline) and 0 at the fixed revision (629, three runs);
# app/api/workflows reports the middleware comparison 1 -> 0 across the fixed revision.

test "rank1748: bearer comparison against an unset optional cron secret"
  lang javascript
  file lib/auth/internal.ts
  expect VYQL-AUTH-150
  expect_review code.OptionalSecretComparisonFailOpen
  code
  ```
  import { type NextRequest, NextResponse } from 'next/server'
  import { env } from '@/lib/core/config/env'

  export function verifyCronAuth(request: NextRequest, context?: string): NextResponse | null {
    const authHeader = request.headers.get('authorization')
    const expectedAuth = `Bearer ${env.CRON_SECRET}`
    if (authHeader !== expectedAuth) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
    }

    return null
  }
  ```

test "rank1748: the same comparison rejecting first when the secret is unset"
  lang javascript
  file lib/auth/internal.ts
  reject VYQL-AUTH-150
  code
  ```
  import { type NextRequest, NextResponse } from 'next/server'
  import { env } from '@/lib/core/config/env'

  export function verifyCronAuth(request: NextRequest, context?: string): NextResponse | null {
    if (!env.CRON_SECRET) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
    }

    const authHeader = request.headers.get('authorization')
    const expectedAuth = `Bearer ${env.CRON_SECRET}`
    if (authHeader !== expectedAuth) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
    }

    return null
  }
  ```

test "rank1748: the internal-secret comparison taken alone"
  lang javascript
  file app/api/workflows/middleware.ts
  expect VYQL-AUTH-150
  expect_review code.OptionalSecretComparisonFailOpen
  code
  ```
  import type { NextRequest } from 'next/server'
  import { env } from '@/lib/core/config/env'

  export async function validateWorkflowAccess(request: NextRequest): Promise<{ workflow?: any }> {
    const internalSecret = request.headers.get('X-Internal-Secret')
    if (internalSecret === env.INTERNAL_API_SECRET) {
      return { workflow: {} }
    }

    return { workflow: undefined }
  }
  ```

test "rank1748: the internal-secret comparison with presence as the conjunct"
  lang javascript
  file app/api/workflows/middleware.ts
  reject VYQL-AUTH-150
  code
  ```
  import type { NextRequest } from 'next/server'
  import { env } from '@/lib/core/config/env'

  export async function validateWorkflowAccess(request: NextRequest): Promise<{ workflow?: any }> {
    const internalSecret = request.headers.get('X-Internal-Secret')
    if (env.INTERNAL_API_SECRET && internalSecret === env.INTERNAL_API_SECRET) {
      return { workflow: {} }
    }

    return { workflow: undefined }
  }
  ```
