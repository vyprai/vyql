# Rank 1307 / CVE-2018-14682: libmspack's CHM index search compares an
# attacker-controlled entry name against the target filename with
# `compare()` (mspack/chmd.c), which decodes each side to a UTF-8 code
# point via GET_UTF8_CHAR and folds case with the TOLOWER() macro before
# comparing. Without towlower/tolower available, TOLOWER() falls back to a
# hand-rolled table lookup:
#
#   #define TOLOWER(x) (((x)<0||(x)>256)?(x):mspack_tolower_map[(x)])
#   static const unsigned char mspack_tolower_map[256] = { ... };
#
# `mspack_tolower_map` holds exactly 256 entries (valid indices 0-255), but
# the guard rejects only `x > 256`, so `x == 256` -- a code point search_chunk
# can produce while decoding a name pulled straight from a CHM chunk buffer
# read off the archive -- passes the guard and indexes one byte past the
# array, an out-of-bounds read (CWE-125). Fix 4fd9ccaa54e1aebde1e4b95fb01
# tightens the comparison to `x > 255`, the correct exclusive upper bound
# for a 256-entry table.
#
# ATTENTION, engine gap on record at rank 1203
# (see ENGINE-GAPS.md): the C/C++ frontend has no macro-expansion pass.
# `#define` bodies are harvested as text only (`ccMacroContextTokens`,
# feeding `macro_name:`/`macro_body:` context tokens) and `stmt()` skips
# every `preproc_*` node, so a construct living inside a function-like
# macro body never becomes a node -- here, the ternary and the array
# subscript inside TOLOWER() are invisible to node emission and every rule
# downstream of it, on both the vulnerable and the patched form alike,
# identically.
#
# Re-verified against the current knowledge base with a minimal pair
# naming no libmspack API: an env-derived int indexed straight into a
# fixed table through the exact guard-then-index shape. `vyql match`
# labels `code.EnvVariable` on the `getenv` source in all three files but
# `code.IndexAccessSink` only on the inline form, `return
# ((x)<0||(x)>256)?(x):mspack_tolower_map[(x)];`, which `vyql trace -from
# code.EnvVariable -to code.IndexAccessSink` reaches through
# atoi -> param -> Subscript and reports as VYQL-MEM-005 on a scan. The
# identical guard-then-index written as a function-like macro, `#define
# TOLOWER(x) (((x)<0||(x)>256)?(x):mspack_tolower_map[(x)])` used as
# `return TOLOWER(x);`, labels no sink at all: tree-sitter parses the
# macro invocation as a call expression to an unknown external function
# named TOLOWER, and the trace dead-ends there, tagged `⟂ no outgoing flow
# (callee not traced -- external or cross-package)`, on the vulnerable
# (`>256`) and patched (`>255`) macro alike -- the one character that
# differs between the revisions sits inside the very macro body that
# never gets walked, so no node carries the discriminator.
#
# The real revision pair measures the same (three --cache off runs per
# side, timeout 180, --max-ram 6GB): 522 findings on the vulnerable
# parent 0b0ef9344255 and 522 on fix 4fd9ccaa54e1, with the full
# finding-location set byte-identical across sides (534 distinct
# locations per side, zero difference, and zero run-to-run variation).
# chmd.c contributes 35 finding locations on both sides, none between
# lines 827 and 891 -- the TOLOWER definition, mspack_tolower_map and
# compare() -- and no finding anywhere names mspack_tolower_map or
# TOLOWER. The scanner cannot distinguish the fix from the vulnerability.
#
# No vocabulary route exists: no binding or rule in the tree consumes a
# `macro_body:` or `macro_name:` token, and one that did would have to key
# on the literal `>256` versus `>255` -- the fix's own vocabulary, matched
# as whole-file text -- to discriminate; generic macro-body text
# predicates (contains a subscript, contains a comparison) fire on both
# revisions equally. A real discriminator needs the guard bound correlated
# with the declared array extent, which requires expanding the body first:
# the preprocessing stage rank 1203 records -- recognizing every #define,
# substituting at each call site, handling macros that invoke other
# macros, keeping source-to-node line mapping sane -- shared by every C,
# C++ and Objective-C source the engine parses, still a staged design
# change rather than a bounded, one-function correction.
#
# verify_current_expected: attention-engine-gap, both revisions rejected.

test "rank1307: chmd TOLOWER() off-by-one lets a decoded name byte index one past mspack_tolower_map"
  lang c
  file chmd_compare.c
  reject VYQL-MEM-005
  reject_review code.IndexAccess
  code
  ```
  #include <stdio.h>
  #include <stdlib.h>
  #include <string.h>

  #define TOLOWER(x) (((x)<0||(x)>256)?(x):mspack_tolower_map[(x)])
  static const unsigned char mspack_tolower_map[256] = {0};

  #define GET_UTF8_CHAR(s, e, c) do {                                    \
      unsigned char x = *s++;                                            \
      if (x < 0x80) c = x;                                               \
      else if (x >= 0xC2 && x < 0xE0 && s < e) {                         \
          c = (x & 0x1F) << 6 | (*s++ & 0x3F);                           \
      }                                                                  \
      else c = 0xFFFD;                                                   \
  } while (0)

  static inline int compare(const char *s1, const char *s2, int l1, int l2) {
      register const unsigned char *p1 = (const unsigned char *) s1;
      register const unsigned char *p2 = (const unsigned char *) s2;
      register const unsigned char *e1 = p1 + l1, *e2 = p2 + l2;
      int c1, c2;

      while (p1 < e1 && p2 < e2) {
          GET_UTF8_CHAR(p1, e1, c1);
          GET_UTF8_CHAR(p2, e2, c2);
          if (c1 == c2) continue;
          c1 = TOLOWER(c1);
          c2 = TOLOWER(c2);
          if (c1 != c2) return c1 - c2;
      }
      return l1 - l2;
  }

  static int search_chunk(const char *filename, FILE *fh) {
      char chunk[4096];
      size_t chunk_len = fread(chunk, 1, sizeof(chunk), fh);
      if (!chunk_len) return -1;
      return compare(filename, chunk, (int) strlen(filename), (int) chunk_len);
  }

  int chmd_fast_find(const char *filename, FILE *fh) {
      return search_chunk(filename, fh);
  }
  ```

test "rank1307: chmd TOLOWER() with the corrected exclusive upper bound of 255"
  lang c
  file chmd_compare_fixed.c
  reject VYQL-MEM-005
  reject_review code.IndexAccess
  code
  ```
  #include <stdio.h>
  #include <stdlib.h>
  #include <string.h>

  #define TOLOWER(x) (((x)<0||(x)>255)?(x):mspack_tolower_map[(x)])
  static const unsigned char mspack_tolower_map[256] = {0};

  #define GET_UTF8_CHAR(s, e, c) do {                                    \
      unsigned char x = *s++;                                            \
      if (x < 0x80) c = x;                                               \
      else if (x >= 0xC2 && x < 0xE0 && s < e) {                         \
          c = (x & 0x1F) << 6 | (*s++ & 0x3F);                           \
      }                                                                  \
      else c = 0xFFFD;                                                   \
  } while (0)

  static inline int compare(const char *s1, const char *s2, int l1, int l2) {
      register const unsigned char *p1 = (const unsigned char *) s1;
      register const unsigned char *p2 = (const unsigned char *) s2;
      register const unsigned char *e1 = p1 + l1, *e2 = p2 + l2;
      int c1, c2;

      while (p1 < e1 && p2 < e2) {
          GET_UTF8_CHAR(p1, e1, c1);
          GET_UTF8_CHAR(p2, e2, c2);
          if (c1 == c2) continue;
          c1 = TOLOWER(c1);
          c2 = TOLOWER(c2);
          if (c1 != c2) return c1 - c2;
      }
      return l1 - l2;
  }

  static int search_chunk(const char *filename, FILE *fh) {
      char chunk[4096];
      size_t chunk_len = fread(chunk, 1, sizeof(chunk), fh);
      if (!chunk_len) return -1;
      return compare(filename, chunk, (int) strlen(filename), (int) chunk_len);
  }

  int chmd_fast_find(const char *filename, FILE *fh) {
      return search_chunk(filename, fh);
  }
  ```
