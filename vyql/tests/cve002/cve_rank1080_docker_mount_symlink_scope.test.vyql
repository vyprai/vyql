# Rank 1080 / CVE-2015-3629: Docker resolves a container mount destination in
# the host mount namespace and then mounts the resolved path inside the
# container, so a symlink in the image redirects the bind outside the container
# (CWE-59). The tree under test spells the resolver as the in-repo
# github.com/docker/docker/pkg/symlink, the package that is now published as
# github.com/moby/sys/symlink and is what the second pair exercises.
#
# ATTENTION: vocabulary gap. The weakness is resolution in the wrong namespace,
# not a missing canonicalization; a scoped resolution is a control, so a
# missing-control rule ranks the revisions backwards, and the boundary the value
# crosses -- resolved under one root, mounted under another -- is not
# expressible in any atom the function carries. Both revisions reject
# VYQL-PATH-001.
#
# verify_current_expected: attention-vocabulary-gap

test "rank1080: the mount destination is resolved in the host namespace"
  lang go
  file daemon/execdriver/native/create.go
  reject VYQL-PATH-001
  code
  ```
  package native

  import (
  	"path/filepath"
  	"syscall"

  	"github.com/moby/sys/symlink"
  )

  func (d *driver) setupMounts(container *configs.Config, c *execdriver.Command) error {
  	userMounts := make(map[string]struct{})
  	for _, m := range c.Mounts {
  		userMounts[m.Destination] = struct{}{}
  	}

  	var defaultMounts []*configs.Mount
  	for _, m := range container.Mounts {
  		if _, ok := userMounts[m.Destination]; !ok {
  			defaultMounts = append(defaultMounts, m)
  		}
  	}
  	container.Mounts = defaultMounts

  	for _, m := range c.Mounts {
  		dest, err := symlink.FollowSymlinkInScope(filepath.Join(c.Rootfs, m.Destination), c.Rootfs)
  		if err != nil {
  			return err
  		}
  		flags := syscall.MS_BIND | syscall.MS_REC
  		if !m.Writable {
  			flags |= syscall.MS_RDONLY
  		}
  		container.Mounts = append(container.Mounts, &configs.Mount{
  			Source:      m.Source,
  			Destination: dest,
  			Device:      "bind",
  			Flags:       flags,
  		})
  	}
  	return nil
  }
  ```

test "rank1080: the destination is passed through for the runtime to resolve"
  lang go
  file daemon/execdriver/native/create.go
  reject VYQL-PATH-001
  code
  ```
  package native

  import (
  	"syscall"
  )

  func (d *driver) setupMounts(container *configs.Config, c *execdriver.Command) error {
  	userMounts := make(map[string]struct{})
  	for _, m := range c.Mounts {
  		userMounts[m.Destination] = struct{}{}
  	}

  	var defaultMounts []*configs.Mount
  	for _, m := range container.Mounts {
  		if _, ok := userMounts[m.Destination]; !ok {
  			defaultMounts = append(defaultMounts, m)
  		}
  	}
  	container.Mounts = defaultMounts

  	for _, m := range c.Mounts {
  		flags := syscall.MS_BIND | syscall.MS_REC
  		if !m.Writable {
  			flags |= syscall.MS_RDONLY
  		}
  		container.Mounts = append(container.Mounts, &configs.Mount{
  			Source:      m.Source,
  			Destination: m.Destination,
  			Device:      "bind",
  			Flags:       flags,
  		})
  	}
  	return nil
  }
  ```

# The pair pins the shipped canonicalization label's reach. The same
# request-driven read, once through the package the shipped binding names --
# with that module required in the go.mod beside the source, so the package
# gate is satisfied -- and once through filepath.Base, which is bound with no
# package clause at all. Only the second is suppressed, so the first still
# reports VYQL-PATH-001: the package-gated method binding is rejected by the
# receiver-scope check, which compares the binding's package name against the
# call's recv_package and finds the module's host root there instead.

test "rank1080: a scoped resolution from a gated package does not neutralize"
  lang go
  file go.mod
  code
  ```
  module example.com/scope

  go 1.21

  require github.com/moby/sys/symlink v0.2.0
  ```

  file scope.go
  expect VYQL-PATH-001
  code
  ```
  package p

  import (
  	"net/http"
  	"os"

  	"github.com/moby/sys/symlink"
  )

  func h(w http.ResponseWriter, r *http.Request) {
  	p := r.URL.Query().Get("f")
  	dest, err := symlink.FollowSymlinkInScope(p, "/srv")
  	if err != nil {
  		return
  	}
  	b, _ := os.ReadFile(dest)
  	w.Write(b)
  }
  ```

test "rank1080: an ungated canonicalization on the same read does neutralize"
  lang go
  file scope.go
  reject VYQL-PATH-001
  code
  ```
  package p

  import (
  	"net/http"
  	"os"
  	"path/filepath"
  )

  func h(w http.ResponseWriter, r *http.Request) {
  	p := r.URL.Query().Get("f")
  	dest := filepath.Base(p)
  	b, _ := os.ReadFile(dest)
  	w.Write(b)
  }
  ```
