# Rank 1036 / CVE-2026-22872: the Capsule controller replicates the raw items of
# a TenantResource with its own cluster-admin credentials, and a tenant owner can
# put a cluster-scoped kind in there (CWE-20, CWE-863):
#
#   for rawIndex, item := range spec.RawItems {
#       tmplString := tpl.FastTemplate(string(item.Raw), fastContext)
#       codecFactory.UniversalDeserializer().Decode([]byte(tmplString), nil, &obj)
#       obj.SetNamespace(ns.Name)
#       r.createOrUpdate(ctx, &obj, objLabels, objAnnotations)
#   }
#
# SetNamespace is the whole confinement, and the Kubernetes API ignores that
# field for a cluster-scoped kind, so a ClusterRole or a
# ValidatingWebhookConfiguration written into the TenantResource is created at
# cluster level with the controller's privileges.
#
# ATTENTION. Two things block it, and the second is the one that decides it.
#
#  - Vocabulary gap. vyql match reports no source, no sink and no control on the
#    function. No binding anywhere names the apimachinery or controller-runtime
#    dynamic-object API: UniversalDeserializer, unstructured.Unstructured,
#    SetNamespace and controllerutil.CreateOrUpdate have zero occurrences across
#    the whole binding set, so there is nothing to label and no rule can fire.
#  - The discriminator is a privilege property, not a code shape. The fix
#    cc4fb45d706d writes the collected objects through a client built from an
#    impersonated service account instead of the manager's client. The decode,
#    the SetNamespace and the missing scope check are all still there afterwards,
#    unchanged. What the API server permits differs because the credential
#    differs, and the credential is chosen in another function and bound to the
#    controller by an RBAC manifest outside the Go source.
#
# A function-scoped presence binding over decode + SetNamespace + write does
# separate the two revisions, and it separates them for the wrong reason: the fix
# split HandleSection into handleRawItem and AddToAccumulation, so the three
# elements stop sharing a function. That detects the refactor, not the weakness,
# and an operator that keeps them together while writing with a scoped client
# would be reported.
#
# The scope check that would be the code-level control,
# validateClusterScopedObjectAllowed calling tpl.IsNamespacedGVK against a
# RESTMapper, exists only in later releases and is not what closed the advisory.
# Precision for such a binding cannot be measured here either: no Kubernetes
# operator corpus is available beyond this repository, and applying an embedded
# manifest is ordinary operator code wherever the client is already scoped.
#
# verify_current_expected: attention-vocabulary-gap

test "rank1036: tenant raw items are decoded and applied with the controller's own client"
  lang go
  file internal/controllers/resources/processor.go
  reject VYQL-AUTH-008
  code
  ```
  package resources

  import (
      "context"

      "k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
      "sigs.k8s.io/controller-runtime/pkg/client"
      "sigs.k8s.io/controller-runtime/pkg/controller/controllerutil"
  )

  type Processor struct {
      client client.Client
  }

  func (r *Processor) HandleSection(ctx context.Context, tnt Tenant, ns Namespace, spec ResourceSpec) error {
      for _, item := range spec.RawItems {
          fastContext := ContextForTenantAndNamespace(&tnt, &ns)
          tmplString := FastTemplate(string(item.Raw), fastContext)

          obj := unstructured.Unstructured{}
          if _, _, decodeErr := codecFactory.UniversalDeserializer().Decode([]byte(tmplString), nil, &obj); decodeErr != nil {
              continue
          }

          obj.SetNamespace(ns.Name)

          if rawErr := r.createOrUpdate(ctx, &obj); rawErr != nil {
              return rawErr
          }
      }

      return nil
  }

  func (r *Processor) createOrUpdate(ctx context.Context, obj *unstructured.Unstructured) error {
      actual, desired := &unstructured.Unstructured{}, obj.DeepCopy()

      actual.SetAPIVersion(desired.GetAPIVersion())
      actual.SetKind(desired.GetKind())
      actual.SetNamespace(desired.GetNamespace())
      actual.SetName(desired.GetName())

      _, err := controllerutil.CreateOrUpdate(ctx, r.client, actual, func() error {
          actual.SetUnstructuredContent(desired.Object)

          return nil
      })

      return err
  }
  ```

test "rank1036: fix keeps the decode and applies the object with an impersonated client"
  lang go
  file internal/controllers/resources/collect.go
  reject VYQL-AUTH-008
  code
  ```
  package resources

  import (
      "context"
      "fmt"

      corev1 "k8s.io/api/core/v1"
      "k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
      "sigs.k8s.io/controller-runtime/pkg/client"
  )

  func (co *Collector) handleRawItem(
      ctx context.Context,
      c client.Client,
      opts CollectorOptions,
      item RawExtension,
      ns *corev1.Namespace,
  ) (processed *unstructured.Unstructured, err error) {
      tmplString := FastTemplate(string(item.Raw), opts.Iterator.FastContext)

      obj := &unstructured.Unstructured{}
      if _, _, err := unstructured.UnstructuredJSONScheme.Decode([]byte(tmplString), nil, obj); err != nil {
          return nil, fmt.Errorf("decode unstructured: %w", err)
      }

      if ns != nil {
          obj.SetNamespace(ns.Name)
      }

      return obj, nil
  }

  func (r *namespacedResourceController) resourceClient(
      ctx context.Context,
      log logr.Logger,
      tntResource *capsulev1beta2.TenantResource,
  ) (client.Client, error) {
      sa := r.impersonatedServiceAccount(ctx, log, tntResource)
      if sa == nil {
          return r.client, nil
      }

      re, err := r.restConfig(ctx, tntResource)
      if err != nil {
          log.Error(err, "failed to load impersonated rest client")

          return nil, err
      }

      return r.impersonation.LoadOrCreate(ctx, log, re, r.client.Scheme(), *sa)
  }
  ```
