module tests.cve.rank1460.hono_node_server_static_component_decode;

# `decodeURIComponent` decodes every percent escape, including `%2F`, so the
# static handler composes a filesystem path with a separator the router never
# saw: `/static/admin%2Fsecret.txt` is one segment to route matching and to a
# middleware registered at `/static/admin/*`, and two segments to the handler.
# The middleware is skipped and the file is served. Rejecting `..` segments does
# not address this, because no `..` segment is involved. `decodeURI` leaves the
# reserved delimiters encoded and is the decoder for a whole path.

test "rank1460: static handler resolves the served file from a component-decoded request path"
  lang javascript
  file serve-static.ts
  expect VYQL-AUTH-127
  expect_review code.MiddlewarePathMatchNormalizationMismatch
  code
  ```
  import { createReadStream, statSync } from 'node:fs'
  import { join } from 'node:path'

  const getStats = (path: string) => {
    let stats
    try {
      stats = statSync(path)
    } catch {}
    return stats
  }

  export const serveStatic = (options: { root?: string } = { root: '' }) => {
    const root = options.root || ''

    return async (c: any, next: any) => {
      if (c.finalized) {
        return next()
      }

      let filename: string
      try {
        filename = decodeURIComponent(c.req.path)
        if (/(?:^|[\/\\])\.\.(?:$|[\/\\])/.test(filename)) {
          throw new Error()
        }
      } catch {
        return next()
      }

      const path = join(root, filename)
      const stats = getStats(path)
      if (!stats) {
        return next()
      }

      c.header('Content-Length', stats.size.toString())
      return c.body(createReadStream(path), 200)
    }
  }
  ```

test "rank1460: static handler that leaves reserved delimiters encoded is accepted"
  lang javascript
  file serve-static.ts
  reject VYQL-AUTH-127
  reject_review code.MiddlewarePathMatchNormalizationMismatch
  code
  ```
  import { createReadStream, statSync } from 'node:fs'
  import { join } from 'node:path'

  const getStats = (path: string) => {
    let stats
    try {
      stats = statSync(path)
    } catch {}
    return stats
  }

  type Decoder = (str: string) => string

  const tryDecode = (str: string, decoder: Decoder): string => {
    try {
      return decoder(str)
    } catch {
      return str.replace(/(?:%[0-9A-Fa-f]{2})+/g, (match) => {
        try {
          return decoder(match)
        } catch {
          return match
        }
      })
    }
  }

  const tryDecodeURI = (str: string) => tryDecode(str, decodeURI)

  export const serveStatic = (options: { root?: string } = { root: '' }) => {
    const root = options.root || ''

    return async (c: any, next: any) => {
      if (c.finalized) {
        return next()
      }

      let filename: string
      try {
        filename = tryDecodeURI(c.req.path)
        if (/(?:^|[\/\\])\.\.(?:$|[\/\\])/.test(filename)) {
          throw new Error()
        }
      } catch {
        return next()
      }

      const path = join(root, filename)
      const stats = getStats(path)
      if (!stats) {
        return next()
      }

      c.header('Content-Length', stats.size.toString())
      return c.body(createReadStream(path), 200)
    }
  }
  ```
