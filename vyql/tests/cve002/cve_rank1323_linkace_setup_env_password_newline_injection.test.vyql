# Rank 1323 / CVE-2026-45344 (GHSA-37m5-936h-w455): LinkAce's setup wizard
# writes the database credentials the user just typed back into the
# application's own .env file. app/Http/Controllers/Setup/DatabaseController.php
# takes them from a validated FormRequest, parks them on $this->dbConfig in
# createTempDatabaseConnection(), and storeConfigurationInEnv() rewrites .env
# with raw preg_replace() substitutions:
#
#   $envContent = preg_replace([
#       '/DB_PASSWORD=(.*)\S/',
#       ...
#   ], [
#       'DB_PASSWORD="' . ($this->dbConfig['password'] ?? '') . '"',
#       ...
#   ], $envContent);
#   File::put(base_path('.env'), $envContent);
#
# The dotenv format is line-oriented, so a db_password of
#   pw"
#   MAIL_MAILER=sendmail
#   MAIL_SENDMAIL_PATH="/bin/sh -c 'id >/tmp/x' -t"
#   X="
# closes the DB_PASSWORD assignment and appends environment variables of the
# attacker's choosing. /setup/* is reachable unauthenticated while setup is
# incomplete, so on an uninitialized instance the injected MAIL_SENDMAIL_PATH
# reaches Symfony Mailer's proc_open() on the next password-reset mail:
# pre-auth RCE (CWE-74).
#
# New PHP binding envFileRewriteWithRequestValues emits the shipped
# code.EnvFileVariableInjection concept (VYQL-INJ-156, the same one the
# JavaScript side uses for dotenv update helpers) for a PHP class that
# rewrites the application's .env file -- a ".env" path literal plus a
# File::put()/file_put_contents() write -- out of values read from the HTTP
# request, with no escaping or filtering call anywhere in the class. The class
# is the unit rather than the function because the read and the write sit in
# different methods joined only by a property on $this, which is how Laravel
# controllers are conventionally written. On the LinkAce tree it labels one
# class out of 992 PHP files: this one.
#
# Known limit, deliberately not papered over: LinkAce's shipped fix adds
# 'not_regex:/[\r\n]/' to app/Http/Requests/SetupDatabaseRequest.php, a
# declarative validation rule in a different class that Laravel applies before
# the controller action runs. Nothing in the binding layer can see a guard
# expressed that way, so the patched controller still reports. The rejects
# below therefore pin the two controls that are visible: a writer that filters
# the value itself, and a class that rewrites .env from data that never came
# from the request.

test "rank1323: the setup wizard interpolates the submitted DB password into a .env assignment line"
  lang php
  file app/Http/Controllers/Setup/DatabaseController.php
  expect VYQL-INJ-156
  expect_review code.EnvFileVariableInjection
  code
  ```
  <?php

  namespace App\Http\Controllers\Setup;

  use App\Http\Controllers\Controller;
  use App\Http\Requests\SetupDatabaseRequest;
  use Illuminate\Http\RedirectResponse;
  use Illuminate\Support\Facades\Config;
  use Illuminate\Support\Facades\File;

  class DatabaseController extends Controller
  {
      protected string $connection;
      protected array $dbConfig;

      public function configure(SetupDatabaseRequest $request): RedirectResponse
      {
          $this->createTempDatabaseConnection($request->validated());
          $this->storeConfigurationInEnv();

          return redirect()->route('setup.account');
      }

      protected function createTempDatabaseConnection(array $configuration): void
      {
          $this->connection = $configuration['connection'];
          $this->dbConfig = config('database.connections.' . $this->connection);

          $this->dbConfig['host'] = $configuration['db_host'];
          $this->dbConfig['port'] = $configuration['db_port'];
          $this->dbConfig['database'] = $configuration['db_name'];
          $this->dbConfig['username'] = $configuration['db_user'];
          $this->dbConfig['password'] = $configuration['db_password'];

          Config::set('database.connections.' . $this->connection, $this->dbConfig);
      }

      protected function storeConfigurationInEnv(): void
      {
          $envContent = File::get(base_path('.env'));

          $envContent = preg_replace([
              '/DB_CONNECTION=(.*)\S/',
              '/DB_HOST=(.*)\S/',
              '/DB_DATABASE=(.*)\S/',
              '/DB_USERNAME=(.*)\S/',
              '/DB_PASSWORD=(.*)\S/',
          ], [
              'DB_CONNECTION=' . $this->connection,
              'DB_HOST=' . ($this->dbConfig['host'] ?? ''),
              'DB_DATABASE=' . ($this->dbConfig['database'] ?? ''),
              'DB_USERNAME=' . ($this->dbConfig['username'] ?? ''),
              'DB_PASSWORD="' . ($this->dbConfig['password'] ?? '') . '"',
          ], $envContent);

          if ($envContent !== null) {
              File::put(base_path('.env'), $envContent);
          }
      }
  }
  ```

test "rank1323: a writer that strips the dotenv line terminators out of each value is not reported"
  lang php
  file app/Http/Controllers/Setup/DatabaseController.php
  reject VYQL-INJ-156
  reject_review code.EnvFileVariableInjection
  code
  ```
  <?php

  namespace App\Http\Controllers\Setup;

  use App\Http\Controllers\Controller;
  use App\Http\Requests\SetupDatabaseRequest;
  use Illuminate\Http\RedirectResponse;
  use Illuminate\Support\Facades\Config;
  use Illuminate\Support\Facades\File;

  class DatabaseController extends Controller
  {
      protected string $connection;
      protected array $dbConfig;

      public function configure(SetupDatabaseRequest $request): RedirectResponse
      {
          $this->createTempDatabaseConnection($request->validated());
          $this->storeConfigurationInEnv();

          return redirect()->route('setup.account');
      }

      protected function createTempDatabaseConnection(array $configuration): void
      {
          $this->connection = $configuration['connection'];
          $this->dbConfig = config('database.connections.' . $this->connection);

          $this->dbConfig['host'] = $configuration['db_host'];
          $this->dbConfig['port'] = $configuration['db_port'];
          $this->dbConfig['database'] = $configuration['db_name'];
          $this->dbConfig['username'] = $configuration['db_user'];
          $this->dbConfig['password'] = $configuration['db_password'];

          Config::set('database.connections.' . $this->connection, $this->dbConfig);
      }

      protected function envValue(?string $value): string
      {
          return str_replace(["\r", "\n", '"'], '', $value ?? '');
      }

      protected function storeConfigurationInEnv(): void
      {
          $envContent = File::get(base_path('.env'));

          $envContent = preg_replace([
              '/DB_CONNECTION=(.*)\S/',
              '/DB_HOST=(.*)\S/',
              '/DB_DATABASE=(.*)\S/',
              '/DB_USERNAME=(.*)\S/',
              '/DB_PASSWORD=(.*)\S/',
          ], [
              'DB_CONNECTION=' . $this->envValue($this->connection),
              'DB_HOST=' . $this->envValue($this->dbConfig['host'] ?? ''),
              'DB_DATABASE=' . $this->envValue($this->dbConfig['database'] ?? ''),
              'DB_USERNAME=' . $this->envValue($this->dbConfig['username'] ?? ''),
              'DB_PASSWORD="' . $this->envValue($this->dbConfig['password'] ?? '') . '"',
          ], $envContent);

          if ($envContent !== null) {
              File::put(base_path('.env'), $envContent);
          }
      }
  }
  ```

test "rank1323: rewriting .env with a locally generated key is not reported"
  lang php
  file app/Http/Middleware/SetupCheckMiddleware.php
  reject VYQL-INJ-156
  reject_review code.EnvFileVariableInjection
  code
  ```
  <?php

  namespace App\Http\Middleware;

  use Closure;
  use Illuminate\Encryption\Encrypter;
  use Illuminate\Http\Request;
  use Illuminate\Support\Facades\File;
  use Illuminate\Support\Facades\Log;

  class SetupCheckMiddleware
  {
      public const GENERIC_APP_KEY = 'someRandomStringWith32Characters';

      public function handle(Request $request, Closure $next): mixed
      {
          if (config('app.key') === self::GENERIC_APP_KEY) {
              $envContent = File::get(base_path('.env'));
              $envContent = preg_replace('/APP_KEY=(.*)\S/', 'APP_KEY=' . $this->generateRandomAppKey(), $envContent);
              File::put(base_path('.env'), $envContent);

              Log::warning('APP_KEY variable contained insecure standard value. New key was generated.');
              return redirect()->refresh();
          }

          if ($request->is('setup/*')) {
              return $next($request);
          }

          return $next($request);
      }

      protected function generateRandomAppKey(): string
      {
          return 'base64:' . base64_encode(Encrypter::generateKey(config('app.cipher')));
      }
  }
  ```
