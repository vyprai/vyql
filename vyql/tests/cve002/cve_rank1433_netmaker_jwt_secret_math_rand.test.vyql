# Rank 1433 / CVE-2022-0664 (GHSA-6rrw-4fm9-rghv): netmaker's server picks the
# HMAC secret that signs every node and user JWT in logic.SetJWTSecret
# (logic/jwts.go), and for two releases running that secret is predictable.
# Before 789cb27d48 it is not generated at all -- `var jwtSecretKey =
# []byte("(BytesOverTheWire)")`, compiled into every build, which is the CWE-321
# the advisory records and the state its affected ranges (<0.8.5, 0.9.0-0.9.3)
# describe. 789cb27d48 replaced the literal with logic.RandomString(64), which is
# `rand.New(rand.NewSource(time.Now().UnixNano()))` plus Intn over a 62-character
# alphabet -- math/rand, whose own documentation says its output "might be easily
# predictable regardless of how it's seeded". The line's comment calls the result
# a "512 bit random password" but its whole entropy is the nanosecond of first
# server start. 9bee126429, the commit the advisory names, is the second hotfix:
# it adds GenerateCryptoString, which draws from crypto/rand.Reader, and uses that
# for the signing secret instead. Either way a caller who can predict the secret
# signs their own token with IsAdmin: true and VerifyUserToken accepts it.
#
# ATTENTION, precision cost. The vulnerable fact is which generator feeds the
# key, and that is only ever visible across functions: RandomString lives in
# logic/util.go, the assignment in logic/jwts.go, the signing call in two more
# functions, and the value crosses the package-level `jwtSecretKey`. Nothing
# function-local separates the revisions except the helper's name, which is the
# fixing commit's own vocabulary. The taint route does express it -- a source on
# math/rand's own generator methods (Intn/Int31n/Int63n/Perm/..., the spellings
# crypto/rand does not share) reaching a sink on the key argument of
# jwt.Token.SignedString, hmac.New and aes.NewCipher runs the whole chain,
# subscript into charset, RandomString's return, the []byte conversion, the
# module variable, and the SignedString argument -- but it does not discriminate
# on the real repository. Measured over three --cache off runs each at
# 9bee126429^ and 9bee126429, the whole netmaker tree reports the same two HIGH
# findings on both revisions: at the patched revision the path is a 40-hop smear
# out of auth.fetchPassValue(logic.RandomString(64)) through
# database.FetchRecord, whose `return results[key]` carries its key parameter
# into its return value, and back out through logic.FetchJWTSecret into the same
# jwtSecretKey. Restricted to logic/ alone the same pair is 2 -> 0, so the
# discrimination exists at package granularity and is destroyed by whole-program
# reachability. Across 21 other Go checkouts the source produced two further
# false rows on one of them, both through fmt.Errorf's parameter-to-return
# summary from a _test.go file. A rule cannot constrain a taint path -- the rule
# language offers only `unless <path|endpoint> coveredBy <check>` -- so an
# intrinsic-property source such as "this value came from a non-cryptographic
# PRNG" reaches every sink the program can reach from any of its call sites.
#
# The hard-coded half is missed too and for a different reason: the Go frontend
# does synthesise analysis.secret.hardcoded for a secret-named target holding a
# plausible literal, but no Go binding consumes that facet, and the facet is not
# raised for `var jwtSecretKey = []byte("(BytesOverTheWire)")` because constStr
# does not see through the []byte conversion. Consuming it in Go is measured
# too: across ten Go checkouts it produces ten rows of which one is real
# (memos' `secret := "usememos"`), the rest config key names, audit event names
# and e2e-test constants.
#
# code.WeakJwtSecret (VYQL-CFG-022, CWE-321/347/798) is the concept that should
# carry this, and it is bound only in Python and JavaScript, where both bindings
# match a weak literal spelled into the jwt.sign/jwt.encode call itself. Neither
# shape reaches a Go server that assigns the secret to a package variable.
#
# verify_current_expected: attention-precision-cost, all three revisions rejected.

test "rank1433: a JWT signing secret compiled in as a literal"
  lang go
  file logic/jwts.go
  reject VYQL-CFG-022
  code
  ```
  package logic

  import (
  	"github.com/golang-jwt/jwt/v4"
  )

  var jwtSecretKey = []byte("(BytesOverTheWire)")

  // CreateUserJWT - creates a user jwt token
  func CreateUserJWT(username string, networks []string, isadmin bool) (string, error) {
  	claims := &models.UserClaims{
  		UserName: username,
  		Networks: networks,
  		IsAdmin:  isadmin,
  	}

  	token := jwt.NewWithClaims(jwt.SigningMethodHS256, claims)
  	return token.SignedString(jwtSecretKey)
  }

  // VerifyUserToken - verifies a user jwt token
  func VerifyUserToken(tokenString string) (string, error) {
  	claims := &models.UserClaims{}

  	token, err := jwt.ParseWithClaims(tokenString, claims, func(token *jwt.Token) (interface{}, error) {
  		return jwtSecretKey, nil
  	})
  	if err != nil || token == nil || !token.Valid {
  		return "", err
  	}
  	return claims.UserName, nil
  }
  ```

test "rank1433: the same signing secret drawn from math/rand at first start"
  lang go
  file logic/jwts.go
  reject VYQL-CFG-022
  code
  ```
  package logic

  import (
  	"math/rand"
  	"time"

  	"github.com/golang-jwt/jwt/v4"
  )

  var jwtSecretKey []byte

  // RandomString - returns a random string of a given length
  func RandomString(length int) string {
  	const charset = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

  	var seededRand *rand.Rand = rand.New(rand.NewSource(time.Now().UnixNano()))

  	b := make([]byte, length)
  	for i := range b {
  		b[i] = charset[seededRand.Intn(len(charset))]
  	}
  	return string(b)
  }

  // SetJWTSecret - sets the jwt secret on server startup
  func SetJWTSecret() {
  	currentSecret, jwtErr := FetchJWTSecret()
  	if jwtErr != nil {
  		jwtSecretKey = []byte(RandomString(64)) // 512 bit random password
  		if err := StoreJWTSecret(string(jwtSecretKey)); err != nil {
  			logger.FatalLog("something went wrong when configuring JWT authentication")
  		}
  	} else {
  		jwtSecretKey = []byte(currentSecret)
  	}
  }

  // CreateUserJWT - creates a user jwt token
  func CreateUserJWT(username string, networks []string, isadmin bool) (string, error) {
  	claims := &models.UserClaims{
  		UserName: username,
  		Networks: networks,
  		IsAdmin:  isadmin,
  	}

  	token := jwt.NewWithClaims(jwt.SigningMethodHS256, claims)
  	return token.SignedString(jwtSecretKey)
  }
  ```

test "rank1433: the same signing secret drawn from crypto/rand"
  lang go
  file logic/jwts.go
  reject VYQL-CFG-022
  code
  ```
  package logic

  import (
  	crand "crypto/rand"
  	"math/big"
  	"math/rand"
  	"time"

  	"github.com/golang-jwt/jwt/v4"
  )

  var jwtSecretKey []byte

  // RandomString - returns a random string of a given length
  func RandomString(length int) string {
  	const charset = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

  	var seededRand *rand.Rand = rand.New(rand.NewSource(time.Now().UnixNano()))

  	b := make([]byte, length)
  	for i := range b {
  		b[i] = charset[seededRand.Intn(len(charset))]
  	}
  	return string(b)
  }

  // GenerateCryptoString - generates random string of n length
  func GenerateCryptoString(n int) (string, error) {
  	const chars = "123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-"
  	ret := make([]byte, n)
  	for i := range ret {
  		num, err := crand.Int(crand.Reader, big.NewInt(int64(len(chars))))
  		if err != nil {
  			return "", err
  		}
  		ret[i] = chars[num.Int64()]
  	}

  	return string(ret), nil
  }

  // SetJWTSecret - sets the jwt secret on server startup
  func SetJWTSecret() {
  	currentSecret, jwtErr := FetchJWTSecret()
  	if jwtErr != nil {
  		newValue, err := GenerateCryptoString(64)
  		if err != nil {
  			logger.FatalLog("something went wrong when generating JWT signature")
  		}
  		jwtSecretKey = []byte(newValue) // 512 bit random password
  		if err := StoreJWTSecret(string(jwtSecretKey)); err != nil {
  			logger.FatalLog("something went wrong when configuring JWT authentication")
  		}
  	} else {
  		jwtSecretKey = []byte(currentSecret)
  	}
  }

  // CreateUserJWT - creates a user jwt token
  func CreateUserJWT(username string, networks []string, isadmin bool) (string, error) {
  	claims := &models.UserClaims{
  		UserName: username,
  		Networks: networks,
  		IsAdmin:  isadmin,
  	}

  	token := jwt.NewWithClaims(jwt.SigningMethodHS256, claims)
  	return token.SignedString(jwtSecretKey)
  }
  ```
