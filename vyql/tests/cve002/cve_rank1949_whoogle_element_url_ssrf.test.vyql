test "rank1949: minimal pair, chained-attribute receiver -- the call never links"
  lang python
  file request_send_pair.py
  reject VYQL-RF-001
  code
  ```
  import requests
  from flask import g, request


  class Request:
      def send(self, base_url='', query=''):
          response = requests.get((base_url or self.search_url) + query)
          return response


  def before_request_func():
      g.user_request = Request()


  def element():
      src_url = request.args.get('url')
      file_data = g.user_request.send(base_url=src_url).content
      return file_data
  ```
  # Identical class, source, sink and argument spelling as the previous
  # block; only the receiver is `g.user_request` instead of the plain name.
  # A chained-attribute receiver resolution fix must flip this block to
  # expect VYQL-RF-001.

test "rank1949: minimal pair, chained assignment -- both targets bind the fetched value"
  lang python
  file element_chained_assign.py
  expect VYQL-RF-001
  code
  ```
  import requests
  from flask import request


  class Request:
      def send(self, base_url='', query=''):
          response = requests.get((base_url or self.search_url) + query)
          return response


  user_request = None


  def before_request_func():
      global user_request
      user_request = Request()


  def element():
      element_url = src_url = request.args.get('url')
      file_data = user_request.send(base_url=src_url).content
      return file_data
  ```
  # `element_url = src_url = request.args.get('url')` is the endpoint's own
  # spelling, and src_url is the name the fetch argument reads. The Python
  # frontend lowered the nested assignment as a bare expression, leaving
  # src_url unbound, so the fetch argument carried no taint; assignStmts now
  # emits the nested assignment first, so this block reports like its
  # single-assignment sibling above.
