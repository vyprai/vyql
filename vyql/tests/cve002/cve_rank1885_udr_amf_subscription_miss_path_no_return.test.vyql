# The UDR's RemoveAmfSubscriptionsInfoProcedure, the SBI handler behind
# DELETE /nudr-dr/v1/subscription-data/{ueId}/ee-subscriptions/{subsId}/
# amf-subscriptions, panics on any request whose ueId is not in the
# subscription store (CWE-754 + CWE-704 -> panic-DoS, CVSS 6.5): it loads the
# UE context with a comma-ok
#
#   value, ok := udrSelf.UESubsCollection.Load(ueId)
#
# and the miss branch builds the 404 problem details and reports it through
# the NF logger but writes no response and does not return, so execution falls
# straight into
#
#   UESubsData := value.(*udr_context.UESubsData)
#
# a Go type assertion on a nil interface, which panics. Gin's recovery
# middleware turns the panic into a 500 and the endpoint stays repeatedly
# panicable by any peer holding a valid nudr-dr token. Fix commit 8a1d3c6
# (merge of PR #60) adds `c.Set(...); c.JSON(int(pd.Status), pd); return`
# inside both miss branches and rebinds the second lookup so the map entry's
# nilness is checked before the field read. The remediation is present at
# <fix> and the vulnerable construct at <fix>^; the second miss branch
# (SUBSCRIPTION_NOT_FOUND) has the identical no-return defect at the parent.
#
# The row's `repo!` flag resolves in the row's favour: the SHA lives in BOTH
# free5gc/udr and free5gc/free5gc with the identical tree hash (4db5629) --
# the umbrella vendors the component's history -- and the advisory's own
# description names the UDR handler and PR free5gc/udr#60. Failure mode 12,
# as at 1427 and 1556: the advisory records the umbrella while the component
# row is the right scan target.
#
# The first review held this as an engine gap on the ground that no presence
# predicate expresses branch containment, so no query could ask whether the
# miss branch terminates. That ground is half right and half wrong. Every
# *token* predicate is a flat function-scope fact, and a bare `return` emits
# no context token at all (goFunctionTokens' ReturnStmt case iterates
# x.Results only) -- but `node.context.scopeCall` is not a token predicate:
# it walks real graph call nodes in the same-or-nested lexical scope of the
# node it is evaluated on, and a call inside the miss branch has that branch
# as its scope. Anchoring on the problem construction inside the branch makes
# the containment askable after all, and the response write the fix adds is
# gin's documented Context.JSON -- the same call the six other Load handlers
# in this tree already make inside their miss branches, not the fixing
# commit's own naming.
#
# One leg of the query is an idiom observation rather than a security
# property, and it is stated here rather than hidden: the branch must report
# the miss through the NF logger. That separates a branch that handles the
# miss from one that only sets the problem variable for a guard that follows,
# which is the difference between the two USER_NOT_FOUND / SUBSCRIPTION_NOT
# branches (reported, unguarded, and the defect) and the trailing
# AMFSUBSCRIPTION_NOT_FOUND branch (sets the variable, defers to the closing
# `if pd != nil` block, and is safe). The cost is recall: a miss branch that
# reports nowhere and falls through is not covered.
#
# Measured, --cache off, three runs per revision: the UDR tree at 754d23b
# reports 2 VYQL-MEM-006 rows, both on this handler (lines 57 and 65, the two
# unguarded miss branches); at 8a1d3c6 it reports 0. The other twelve
# UESubsCollection.Load handlers in the tree, the safe sibling above the
# vulnerable handler among them, report nothing at either revision. ausf,
# pcf, nssf and bsf build their problem details as struct literals rather
# than through this helper and report nothing, and udm and smf do not use it.

test "rank1885: the miss branch records the 404 but does not return, then asserts the value"
  lang go
  file internal/sbi/processor/event_amf_subscription_info_document.go
  expect VYQL-MEM-006
  code
  ```
  package processor

  import (
      "github.com/gin-gonic/gin"

      "github.com/free5gc/openapi/models"
      udr_context "github.com/free5gc/udr/internal/context"
      "github.com/free5gc/udr/internal/logger"
      "github.com/free5gc/udr/internal/util"
      "github.com/free5gc/util/metrics/sbi"
  )

  func (p *Processor) RemoveAmfSubscriptionsInfoProcedure(c *gin.Context, subsId string, ueId string) {
      udrSelf := udr_context.GetSelf()
      value, ok := udrSelf.UESubsCollection.Load(ueId)
      var pd *models.ProblemDetails = nil

      if !ok {
          pd = util.ProblemDetailsNotFound("USER_NOT_FOUND")
          logger.DataRepoLog.Errorf("RemoveAmfSubscriptionsInfoProcedure err: %s", pd.Detail)
      }

      UESubsData := value.(*udr_context.UESubsData)
      _, ok = UESubsData.EeSubscriptionCollection[subsId]

      if !ok {
          pd = util.ProblemDetailsNotFound("SUBSCRIPTION_NOT_FOUND")
          logger.DataRepoLog.Errorf("RemoveAmfSubscriptionsInfoProcedure err: %s", pd.Detail)
      }

      if UESubsData.EeSubscriptionCollection[subsId].AmfSubscriptionInfos == nil {
          pd = util.ProblemDetailsNotFound("AMFSUBSCRIPTION_NOT_FOUND")
      }

      if pd != nil {
          logger.DataRepoLog.Errorf("RemoveAmfSubscriptionsInfoProcedure err: %s", pd.Detail)
          c.Set(sbi.IN_PB_DETAILS_CTX_STR, pd.Cause)
          c.JSON(int(pd.Status), pd)
          return
      }

      UESubsData.EeSubscriptionCollection[subsId].AmfSubscriptionInfos = nil
      c.Status(http.StatusNoContent)
  }
  ```

test "rank1885: the fixed revision returns from inside both miss branches"
  lang go
  file internal/sbi/processor/event_amf_subscription_info_document.go
  reject VYQL-MEM-006
  code
  ```
  package processor

  import (
      "github.com/gin-gonic/gin"

      "github.com/free5gc/openapi/models"
      udr_context "github.com/free5gc/udr/internal/context"
      "github.com/free5gc/udr/internal/logger"
      "github.com/free5gc/udr/internal/util"
      "github.com/free5gc/util/metrics/sbi"
  )

  func (p *Processor) RemoveAmfSubscriptionsInfoProcedure(c *gin.Context, subsId string, ueId string) {
      udrSelf := udr_context.GetSelf()
      value, ok := udrSelf.UESubsCollection.Load(ueId)
      var pd *models.ProblemDetails

      if !ok {
          pd = util.ProblemDetailsNotFound("USER_NOT_FOUND")
          logger.DataRepoLog.Errorf("RemoveAmfSubscriptionsInfoProcedure err: %s", pd.Detail)
          c.Set(sbi.IN_PB_DETAILS_CTX_STR, pd.Cause)
          c.JSON(int(pd.Status), pd)
          return
      }

      UESubsData := value.(*udr_context.UESubsData)
      eeSub, ok := UESubsData.EeSubscriptionCollection[subsId]

      if !ok {
          pd = util.ProblemDetailsNotFound("SUBSCRIPTION_NOT_FOUND")
          logger.DataRepoLog.Errorf("RemoveAmfSubscriptionsInfoProcedure err: %s", pd.Detail)
          c.Set(sbi.IN_PB_DETAILS_CTX_STR, pd.Cause)
          c.JSON(int(pd.Status), pd)
          return
      }

      if eeSub == nil || eeSub.AmfSubscriptionInfos == nil {
          pd = util.ProblemDetailsNotFound("AMFSUBSCRIPTION_NOT_FOUND")
      }

      if pd != nil {
          logger.DataRepoLog.Errorf("RemoveAmfSubscriptionsInfoProcedure err: %s", pd.Detail)
          c.Set(sbi.IN_PB_DETAILS_CTX_STR, pd.Cause)
          c.JSON(int(pd.Status), pd)
          return
      }

      eeSub.AmfSubscriptionInfos = nil
      c.Status(http.StatusNoContent)
  }
  ```

test "rank1885: the sibling handler with the safe idiom must stay silent"
  lang go
  file internal/sbi/processor/event_amf_subscription_info_document.go
  reject VYQL-MEM-006
  code
  ```
  package processor

  import (
      "github.com/gin-gonic/gin"

      "github.com/free5gc/openapi/models"
      udr_context "github.com/free5gc/udr/internal/context"
      "github.com/free5gc/udr/internal/logger"
      "github.com/free5gc/udr/internal/util"
      "github.com/free5gc/util/metrics/sbi"
  )

  func (p *Processor) CreateAMFSubscriptionsProcedure(c *gin.Context, subsId string, ueId string,
      AmfSubscriptionInfo []models.AmfSubscriptionInfo,
  ) {
      udrSelf := udr_context.GetSelf()
      value, ok := udrSelf.UESubsCollection.Load(ueId)
      if !ok {
          pd := util.ProblemDetailsNotFound("USER_NOT_FOUND")
          logger.DataRepoLog.Errorf("CreateAMFSubscriptionsProcedure err: %s", pd.Detail)
          c.Set(sbi.IN_PB_DETAILS_CTX_STR, pd.Cause)
          c.JSON(int(pd.Status), pd)
          return
      }
      UESubsData := value.(*udr_context.UESubsData)

      _, ok = UESubsData.EeSubscriptionCollection[subsId]
      if !ok {
          pd := util.ProblemDetailsNotFound("SUBSCRIPTION_NOT_FOUND")
          logger.DataRepoLog.Errorf("CreateAMFSubscriptionsProcedure err: %s", pd.Detail)
          c.Set(sbi.IN_PB_DETAILS_CTX_STR, pd.Cause)
          c.JSON(int(pd.Status), pd)
          return
      }

      UESubsData.EeSubscriptionCollection[subsId].AmfSubscriptionInfos = AmfSubscriptionInfo
      c.Status(http.StatusNoContent)
  }
  ```

