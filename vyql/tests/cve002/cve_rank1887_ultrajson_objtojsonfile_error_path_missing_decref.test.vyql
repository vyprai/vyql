# ujson's objToJSONFile (src/ujson/python/objToJSON.c) serialises an object
# with the internal objToJSON and hands the resulting string to a file
# object's write method. Every acquired reference in the function is
# released on the success path, but two error returns drop only part of
# what the function owns: when the second PyTuple_Pack (the one wrapping
# the serialised string for the write call) fails, and when
# PyObject_CallObject reports the write failing, the cleanup releases
# `write` and `argtuple` and returns NULL without dropping `string` -- the
# serialisation result, owned since `string = objToJSON(...)`. A
# caller-driven failing write (a file object whose write raises) leaks the
# whole serialised document on every call; repeated dumps grow the process
# without bound (CWE-401). The fix 82af1d0 adds Py_DECREF(string) to both
# error blocks and the missing bailout for the first PyTuple_Pack failing,
# which passed NULL straight into objToJSON.
#
# CPython reference-count calls carry the resource-handle and
# resource-release concepts (PyTuple_Pack / PyObject_GetAttr(String) /
# PyObject_CallObject as acquisitions, Py_DECREF / Py_XDECREF / Py_CLEAR as
# releases), so a C extension function that acquires a reference and drops
# it nowhere reports VYQL-RES-001 -- the third case below pins a real
# instance of that shape in the same module (object_is_decimal_type leaks
# both its module and its Decimal attribute on the success path, reported
# at ujson.c:126 on both revisions), and the fourth pins that a release
# silences the pairing.
#
# This function's bug stays invisible, in both revisions, and each half of
# the reason is measured on the real checkout rather than inferred:
#
#   * The leaked reference's acquisition is the internal objToJSON call
#     (objToJSON.c:917 at 82af1d0^, :922 at the fix). It is not among
#     `vyql resolve`'s unresolved sites, but no documented-API binding can
#     label a project-internal function's return as a new reference, so
#     `string` never carries code.ResourceHandle: `vyql match` labels the
#     four documented-API acquisitions (:906, :915, :928, :935) and not
#     :917.
#   * Those four labelled acquisitions are each genuinely released on every
#     path to exit -- write at :910/:921/:931/:938/:944, argtuple at
#     :922/:926/:939/:945, write_result at :943 -- so per-variable pairing
#     alone would also report nothing here.
#   * Labelling the acquisition alone does not separate either: a probe
#     adding objToJSON to the acquisition table labels objToJSON.c:917 as
#     code.ResourceHandle and leaves VYQL-RES-001 at exactly one finding
#     tree-wide (ujson.c:126, unchanged), because the type-state rule asks
#     whether *a* release post-dominates the acquisition and does not pair
#     the two by variable -- the Py_XDECREF calls that do run in each error
#     block satisfy the clause for the Py_DECREF that is missing beside
#     them.
#
# Both facts are missing together, so no single layer closes the pair: the
# acquisition half needs an ownership provenance that no library
# documentation states, and the pairing half is the per-variable
# release-set fact of the C reference-ownership liveness gap
# (postDominatesCovered is per-variable-blind; solvers.PostDominates is a
# structured-region approximation under which a trailing unconditional
# release covers even early returns that skip it). The bailout half is
# equally out of reach: the failed PyTuple_Pack result is passed to the
# internal call rather than dereferenced locally, so the nullable-result
# analysis (member-assignment then dereference) never fires either.
#
# Recheck measurements, three --cache off runs per revision (timeout 180,
# --max-ram 6GB): 430 findings on both revisions, byte-identical within a
# revision and byte-identical across revisions on every C finding -- the
# only output differences are line shifts in the fix's own python tests.
# The -flags only view reports 1595 flags, with core.ResourceRelease flags
# inside objToJSONFile at :910/:921/:922/:926/:931/:938/:939/:943-:946 at
# the parent and :910/:918/:926/:927/:931/:936/:937/:944-:953 at the fix:
# the added releases appear as flags, and no rule consumes a release count,
# so nothing discriminates.
#
# verify_current_expected: attention-engine-gap, both revisions rejected.

test "ujson: objToJSONFile error paths drop some owned references and not others"
  lang c
  file objToJSONFile.c
  reject VYQL-RES-001
  reject VYQL-MEM-018
  code
  ```
  #include <Python.h>

  static PyObject* objToJSON (PyObject* self, PyObject *args, PyObject *kwargs);

  PyObject* objToJSONFile(PyObject* self, PyObject *args, PyObject *kwargs)
  {
    PyObject *data;
    PyObject *file;
    PyObject *string;
    PyObject *write;
    PyObject *argtuple;
    PyObject *write_result;

    if (!PyArg_ParseTuple (args, "OO", &data, &file))
    {
      return NULL;
    }

    if (!PyObject_HasAttrString (file, "write"))
    {
      PyErr_Format (PyExc_TypeError, "expected file");
      return NULL;
    }

    write = PyObject_GetAttrString (file, "write");

    if (!PyCallable_Check (write))
    {
      Py_XDECREF(write);
      PyErr_Format (PyExc_TypeError, "expected file");
      return NULL;
    }

    argtuple = PyTuple_Pack(1, data);

    string = objToJSON (self, argtuple, kwargs);

    if (string == NULL)
    {
      Py_XDECREF(write);
      Py_XDECREF(argtuple);
      return NULL;
    }

    Py_XDECREF(argtuple);

    argtuple = PyTuple_Pack (1, string);
    if (argtuple == NULL)
    {
      Py_XDECREF(write);
      return NULL;
    }

    write_result = PyObject_CallObject (write, argtuple);
    if (write_result == NULL)
    {
      Py_XDECREF(write);
      Py_XDECREF(argtuple);
      return NULL;
    }

    Py_DECREF(write_result);
    Py_XDECREF(write);
    Py_DECREF(argtuple);
    Py_XDECREF(string);

    Py_RETURN_NONE;
  }
  ```

test "ujson: objToJSONFile error paths each drop every owned reference"
  lang c
  file objToJSONFile_fixed.c
  reject VYQL-RES-001
  reject VYQL-MEM-018
  code
  ```
  #include <Python.h>

  static PyObject* objToJSON (PyObject* self, PyObject *args, PyObject *kwargs);

  PyObject* objToJSONFile(PyObject* self, PyObject *args, PyObject *kwargs)
  {
    PyObject *data;
    PyObject *file;
    PyObject *string;
    PyObject *write;
    PyObject *argtuple;
    PyObject *write_result;

    if (!PyArg_ParseTuple (args, "OO", &data, &file))
    {
      return NULL;
    }

    if (!PyObject_HasAttrString (file, "write"))
    {
      PyErr_Format (PyExc_TypeError, "expected file");
      return NULL;
    }

    write = PyObject_GetAttrString (file, "write");

    if (!PyCallable_Check (write))
    {
      Py_XDECREF(write);
      PyErr_Format (PyExc_TypeError, "expected file");
      return NULL;
    }

    argtuple = PyTuple_Pack(1, data);
    if (argtuple == NULL)
    {
      Py_XDECREF(write);
      return NULL;
    }

    string = objToJSON (self, argtuple, kwargs);

    if (string == NULL)
    {
      Py_XDECREF(write);
      Py_XDECREF(argtuple);
      return NULL;
    }

    Py_XDECREF(argtuple);

    argtuple = PyTuple_Pack (1, string);
    if (argtuple == NULL)
    {
      Py_XDECREF(write);
      Py_DECREF(string);
      return NULL;
    }

    write_result = PyObject_CallObject (write, argtuple);
    if (write_result == NULL)
    {
      Py_XDECREF(write);
      Py_DECREF(string);
      Py_XDECREF(argtuple);
      return NULL;
    }

    Py_DECREF(write_result);
    Py_XDECREF(write);
    Py_DECREF(argtuple);
    Py_XDECREF(string);

    Py_RETURN_NONE;
  }
  ```

test "ujson: object_is_decimal_type leaks its imports on the success path"
  lang c
  file object_is_decimal_type.c
  expect VYQL-RES-001
  code
  ```
  #include <Python.h>

  int object_is_decimal_type(PyObject *obj)
  {
    PyObject *module = PyImport_ImportModule("decimal");
    if (module == NULL) {
      PyErr_Clear();
      return 0;
    }
    PyObject *type_decimal = PyObject_GetAttrString(module, "Decimal");
    if (type_decimal == NULL) {
      Py_DECREF(module);
      PyErr_Clear();
      return 0;
    }
    int result = PyObject_IsInstance(obj, type_decimal);
    if (result == -1) {
      Py_DECREF(module);
      Py_DECREF(type_decimal);
      PyErr_Clear();
      return 0;
    }
    return result;
  }
  ```

test "a write attribute released before returning is clean"
  lang c
  file use_writer.c
  reject VYQL-RES-001
  code
  ```
  #include <Python.h>

  PyObject* use_writer(PyObject *file)
  {
    PyObject *write = PyObject_GetAttrString(file, "write");
    Py_XDECREF(write);
    Py_RETURN_NONE;
  }
  ```
