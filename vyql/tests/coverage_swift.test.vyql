# Swift coverage breadth: ReDoS, weak crypto, and sanitizer recognition.

test "swift: env var -> NSRegularExpression is ReDoS"
  lang swift
  expect VYQL-DOS-001
  code
  ```
  func h() {
    let p = ProcessInfo.processInfo.environment["PAT"]!
    let _ = try! NSRegularExpression(pattern: p)
  }
  ```

test "swift: a constant pattern is clean (ReDoS)"
  lang swift
  reject VYQL-DOS-001
  code
  ```
  func h() { let _ = try! NSRegularExpression(pattern: "^[a-z]+$") }
  ```

test "swift: CryptoKit Insecure.MD5 is weak crypto"
  lang swift
  expect VYQL-CRY-001
  code
  ```
  func h(data: Data) { let _ = Insecure.MD5.hash(data: data) }
  ```

test "swift: CommonCrypto CC_MD5 is weak crypto"
  lang swift
  expect VYQL-CRY-001
  code
  ```
  func h() { CC_MD5(ptr, len, out) }
  ```
