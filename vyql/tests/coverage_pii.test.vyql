# A6 — PII / GDPR data exposure (CWE-532, VYQL-PII-001). A taint flow from a high-signal
# PII field/getter (ssn, credit_card, passport…) into a log sink. Non-PII fields and
# ordinary identifiers (username) are clean — the taxonomy is deliberately narrow.
# The PII taxonomy is a CONFIGURABLE cross-language list (bindings/pii.vyql), so it fires
# in any language, not just python.

test "pii: ssn field logged is flagged (python)"
  lang python
  expect VYQL-PII-001
  code
  ```
  import logging
  def h(user):
      logging.info(user.ssn)
  ```

test "pii: credit-card getter logged is flagged (python)"
  lang python
  expect VYQL-PII-001
  code
  ```
  import logging
  def h(user):
      logging.warning(user.get_credit_card())
  ```

test "pii: a non-PII field logged is clean (python)"
  lang python
  reject VYQL-PII-001
  code
  ```
  import logging
  def h(user):
      logging.info(user.username)
  ```

test "pii: a credit-card getter logged is flagged (java, cross-language taxonomy)"
  lang java
  expect VYQL-PII-001
  code
  ```
  class X {
    void f(Account a, Logger log) {
      log.info(a.getCreditCard());
    }
  }
  ```
