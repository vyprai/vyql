# Rank 985 / CVE-2024-1141: glance_store S3 driver logged access keys in
# debug messages for get/delete operations.

test "rank985: S3 access key is logged in debug context"
  lang python
  file glance_store/_drivers/s3.py
  expect VYQL-SEC-039
  expect_review code.CredentialAttributeLogExposure
  code
  ```
  class Store(object):
      def get(self, location):
          loc = location.store_location
          bucket = loc.bucket
          key = loc.key
          LOG.debug("Retrieved image object from S3 using s3_host=%(s3_host)s, "
                    "access_key=%(accesskey)s, bucket=%(bucket)s, "
                    "key=%(key)s)",
                    {'s3_host': loc.s3serviceurl, 'accesskey': loc.accesskey,
                     'bucket': bucket, 'key': key})

      def delete(self, location):
          loc = location.store_location
          bucket = loc.bucket
          key = loc.key
          LOG.debug("Deleting image object from S3 using s3_host=%(s3_host)s, "
                    "accesskey=%(accesskey)s, bucket=%(bucket)s, key=%(key)s)",
                    {'s3_host': loc.s3serviceurl, 'accesskey': loc.accesskey,
                     'bucket': bucket, 'key': key})
  ```

test "rank985: S3 access key is omitted from debug context"
  lang python
  file glance_store/_drivers/s3.py
  reject VYQL-SEC-039
  reject_review code.CredentialAttributeLogExposure
  code
  ```
  class Store(object):
      def get(self, location):
          loc = location.store_location
          bucket = loc.bucket
          key = loc.key
          LOG.debug("Retrieved image object from S3 using s3_host=%(s3_host)s, "
                    "bucket=%(bucket)s key=%(key)s)",
                    {'s3_host': loc.s3serviceurl, 'bucket': bucket, 'key': key})

      def delete(self, location):
          loc = location.store_location
          bucket = loc.bucket
          key = loc.key
          LOG.debug("Deleting image object from S3 using s3_host=%(s3_host)s, "
                    "bucket=%(bucket)s, key=%(key)s)",
                    {'s3_host': loc.s3serviceurl, 'bucket': bucket, 'key': key})
  ```
