# axios SSRF (VYQL-RF-001) precision: the `axios` binding must flag network CALLS
# (axios(cfg), axios.get(url)) but NOT member-access property assignments
# (axios.Cancel = ...), which `sink exact "axios"` enforces.

# --- positive: a direct axios(url) call on tainted input is SSRF ---
test "js: axios(url) direct call with tainted url is SSRF"
  lang javascript
  expect VYQL-RF-001
  code
  ```
  const axios = require('axios');
  function handler(req, res) {
    axios(req.query.target);
  }
  module.exports = handler;
  ```

# --- negative: assigning a property on the axios object is not a network sink ---
test "js: axios.Cancel property assignment is not SSRF"
  lang javascript
  reject VYQL-RF-001
  code
  ```
  const axios = require('axios');
  function setup(req, res) {
    const t = req.query.target;
    axios.Cancel = function () { return t; };
  }
  module.exports = setup;
  ```
