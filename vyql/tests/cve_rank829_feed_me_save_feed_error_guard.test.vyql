test "rank829: Feed Me save feed redirects before checking model errors"
  lang php
  file src/controllers/FeedsController.php
  expect VYQL-DOS-043
  expect_review code.FeedMeSaveFeedMissingErrorGuard
  code
  ```
  <?php
  class FeedsController extends Controller
  {
      public function actionSaveFeed()
      {
          $feed = $this->_getModelFromPost();

          return $this->_saveAndRedirect($feed, 'feed-me/feeds/', true);
      }

      private function _getModelFromPost()
      {
          $feed = new FeedModel();
          $feed->elementType = Craft::$app->getRequest()->getBodyParam('elementType', $feed->elementType);
          $feed->elementGroup = Craft::$app->getRequest()->getBodyParam('elementGroup', $feed->elementGroup);

          if (($feed->elementType === 'craft\elements\Asset') && empty($feed->elementGroup[$feed->elementType])) {
              $feed->addError('elementGroup', Craft::t('feed-me', 'Asset Volume is required'));
          }

          return $feed;
      }
  }
  ?>
  ```

test "rank829: Feed Me save feed checks model errors before redirect"
  lang php
  file src/controllers/FeedsController.php
  reject VYQL-DOS-043
  reject_review code.FeedMeSaveFeedMissingErrorGuard
  code
  ```
  <?php
  class FeedsController extends Controller
  {
      public function actionSaveFeed()
      {
          $feed = $this->_getModelFromPost();

          if ($feed->getErrors()) {
              $this->setFailFlash(Craft::t('feed-me', 'Couldn’t save the feed.'));
              Craft::$app->getUrlManager()->setRouteParams([
                  'feed' => $feed,
              ]);
              return null;
          }

          return $this->_saveAndRedirect($feed, 'feed-me/feeds/', true);
      }
  }
  ?>
  ```
