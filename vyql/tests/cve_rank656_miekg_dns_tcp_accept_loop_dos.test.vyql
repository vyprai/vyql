test "rank656: TCP accept loop blocks on per-connection read before goroutine"
  lang go
  expect VYQL-LIFE-005
  code
  ```
  package dns

  func (srv *Server) serveTCP(l Listener) error {
      reader := Reader(&defaultReader{srv})
      handler := srv.Handler
      rtimeout := srv.getReadTimeout()
      for {
          rw, err := l.Accept()
          if err != nil {
              return err
          }
          m, err := reader.ReadTCP(rw, rtimeout)
          if err != nil {
              continue
          }
          go srv.serve(rw.RemoteAddr(), handler, m, nil, nil, rw)
      }
  }
  ```

test "rank656: TCP accept loop reads inside per-connection goroutine"
  lang go
  reject VYQL-LIFE-005
  code
  ```
  package dns

  func (srv *Server) serveTCP(l Listener) error {
      reader := Reader(&defaultReader{srv})
      handler := srv.Handler
      rtimeout := srv.getReadTimeout()
      for {
          rw, err := l.Accept()
          if err != nil {
              return err
          }
          go func() {
              m, err := reader.ReadTCP(rw, rtimeout)
              if err != nil {
                  rw.Close()
                  return
              }
              srv.serve(rw.RemoteAddr(), handler, m, nil, nil, rw)
          }()
      }
  }
  ```
