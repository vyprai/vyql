# Rank 621 / CVE-2025-55988: DreamFactory forwarded request resource
# paths to the service manager before removing parent-directory segments.
test "rank621: backend service resource is dispatched without traversal stripping"
  lang php
  file RestController.php
  expect VYQL-PATH-028
  code
  ```
  <?php
  class RestController {
      protected function handleServiceRequest(ServiceRequest $request, $service, $resource = null)
      {
          $service = strtolower($service);
          if (!empty($resource)) {
              $uri = \Request::getRequestUri();
              if ((false === strpos($uri, '?') && '/' === substr($uri, strlen($uri) - 1, 1)) ||
                  ('/' === substr($uri, strpos($uri, '?') - 1, 1))
              ) {
                  $resource .= '/';
              }
          }
          return ServiceManager::handleServiceRequest($request, $service, $resource, false);
      }
  }
  ```

test "rank621: backend service resource removes traversal segments before dispatch"
  lang php
  file RestController.php
  reject VYQL-PATH-028
  code
  ```
  <?php
  class RestController {
      protected function handleServiceRequest(ServiceRequest $request, $service, $resource = null)
      {
          $service = strtolower($service);
          if (!empty($resource)) {
              $resource = str_replace(['..'], '', $resource);
              $uri = \Request::getRequestUri();
              if ((false === strpos($uri, '?') && '/' === substr($uri, strlen($uri) - 1, 1)) ||
                  ('/' === substr($uri, strpos($uri, '?') - 1, 1))
              ) {
                  $resource .= '/';
              }
          }
          return ServiceManager::handleServiceRequest($request, $service, $resource, false);
      }
  }
  ```
