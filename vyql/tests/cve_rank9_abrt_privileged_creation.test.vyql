test "rank9: creation notification triggers privileged post-create processing"
  lang c
  expect_review code.PrivilegedEntryPointReview
  code
  ```
  static int perform_http_xact(void) {
      if (url_type == CREATION_NOTIFICATION) {
          messagebuf_data[messagebuf_len] = '\0';
          return run_post_create(messagebuf_data);
      }
      return 0;
  }
  ```

test "rank9: creation notification requires privileged caller"
  lang c
  reject_review code.PrivilegedEntryPointReview
  code
  ```
  static int perform_http_xact(void) {
      if (url_type == CREATION_NOTIFICATION) {
          if (client_uid != 0) {
              return 403;
          }
          messagebuf_data[messagebuf_len] = '\0';
          return run_post_create(messagebuf_data);
      }
      return 0;
  }
  ```
