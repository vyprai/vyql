test "rank528: cramfsck appends image dirent name before traversal validation"
  lang c
  file cramfsck.c
  expect VYQL-PATH-026
  expect_review code.FilesystemImageDirentTraversal
  code
  ```
  #include <string.h>
  #include <stdlib.h>

  struct cramfs_inode {
      int namelen;
      int size;
      unsigned long offset;
  };

  void *romfs_read(unsigned long offset);
  struct cramfs_inode *iget(unsigned long offset);
  void expand_fs(char *path, struct cramfs_inode *i);
  void die(int a, int b, const char *fmt, ...);

  void do_directory(char *path, struct cramfs_inode *i)
  {
      int pathlen = strlen(path);
      int count = i->size;
      unsigned long offset = i->offset << 2;
      char *newpath = malloc(pathlen + 256);

      memcpy(newpath, path, pathlen);
      if (pathlen > 1) {
          newpath[pathlen] = '/';
          pathlen++;
      }

      while (count > 0) {
          struct cramfs_inode *child = iget(offset);
          int newlen = child->namelen << 2;

          offset += sizeof(struct cramfs_inode);
          memcpy(newpath + pathlen, romfs_read(offset), newlen);
          newpath[pathlen + newlen] = 0;
          if (newlen == 0)
              die(1, 0, "bad filename length");
          expand_fs(newpath, child);
          count -= sizeof(struct cramfs_inode) + newlen;
      }
  }
  ```

test "rank528: cramfsck rejects traversal and separator dirent names"
  lang c
  file cramfsck.c
  reject VYQL-PATH-026
  reject_review code.FilesystemImageDirentTraversal
  code
  ```
  #include <string.h>
  #include <stdlib.h>

  struct cramfs_inode {
      int namelen;
      int size;
      unsigned long offset;
  };

  void *romfs_read(unsigned long offset);
  struct cramfs_inode *iget(unsigned long offset);
  void expand_fs(char *path, struct cramfs_inode *i);
  void die(int a, int b, const char *fmt, ...);

  void do_directory(char *path, struct cramfs_inode *i)
  {
      int pathlen = strlen(path);
      int count = i->size;
      unsigned long offset = i->offset << 2;
      char *newpath = malloc(pathlen + 256);

      memcpy(newpath, path, pathlen);
      if (pathlen > 1) {
          newpath[pathlen] = '/';
          pathlen++;
      }

      while (count > 0) {
          struct cramfs_inode *child = iget(offset);
          int newlen = child->namelen << 2;

          offset += sizeof(struct cramfs_inode);
          memcpy(newpath + pathlen, romfs_read(offset), newlen);
          newpath[pathlen + newlen] = 0;
          if (newlen == 0)
              die(1, 0, "bad filename length");

          {
              const char *name = newpath + pathlen;
              if (strcmp(name, ".") == 0 || strcmp(name, "..") == 0 ||
                  strchr(name, '/') != NULL) {
                  die(1, 0, "bad filename: %s", name);
              }
          }

          expand_fs(newpath, child);
          count -= sizeof(struct cramfs_inode) + newlen;
      }
  }
  ```

test "rank528: image dirent traversal generalizes across names"
  lang c
  file cramfsck.c
  expect VYQL-PATH-026
  expect_review code.FilesystemImageDirentTraversal
  code
  ```
  void *romfs_read(unsigned long offset);
  void expand_fs(char *path, void *child);
  void memcpy(void *dst, void *src, int n);

  void walk_image(char *joined, int prefix_len, int entry_len, unsigned long where, void *node) {
      memcpy(joined + prefix_len, romfs_read(where), entry_len);
      joined[prefix_len + entry_len] = 0;
      expand_fs(joined, node);
  }
  ```
