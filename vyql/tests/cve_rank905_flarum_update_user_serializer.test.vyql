# Rank 905 / CVE-2018-19133: Flarum's user-update endpoint used the
# current-user serializer for arbitrary updated users, exposing private fields.

test "rank905: Flarum update user response uses current-user serializer for any target user"
  lang php
  file UpdateUserController.php
  expect VYQL-SEC-018
  expect_review code.SensitiveModelJsonSerializationExposure
  code
  ```
  <?php
  namespace Flarum\Api\Controller;

  use Flarum\Api\Serializer\CurrentUserSerializer;
  use Flarum\User\Command\EditUser;
  use Illuminate\Contracts\Bus\Dispatcher;
  use Psr\Http\Message\ServerRequestInterface;
  use Tobscure\JsonApi\Document;

  class UpdateUserController extends AbstractShowController
  {
      public $serializer = CurrentUserSerializer::class;
      protected $bus;

      public function __construct(Dispatcher $bus)
      {
          $this->bus = $bus;
      }

      protected function data(ServerRequestInterface $request, Document $document)
      {
          $id = array_get($request->getQueryParams(), 'id');
          $actor = $request->getAttribute('actor');
          $data = array_get($request->getParsedBody(), 'data', []);

          return $this->bus->dispatch(
              new EditUser($id, $actor, $data)
          );
      }
  }
  ```

test "rank905: Flarum update user response uses public serializer unless updating self"
  lang php
  file UpdateUserController.php
  reject VYQL-SEC-018
  reject_review code.SensitiveModelJsonSerializationExposure
  code
  ```
  <?php
  namespace Flarum\Api\Controller;

  use Flarum\Api\Serializer\CurrentUserSerializer;
  use Flarum\Api\Serializer\UserSerializer;
  use Flarum\User\Command\EditUser;
  use Illuminate\Contracts\Bus\Dispatcher;
  use Psr\Http\Message\ServerRequestInterface;
  use Tobscure\JsonApi\Document;

  class UpdateUserController extends AbstractShowController
  {
      public $serializer = UserSerializer::class;
      protected $bus;

      public function __construct(Dispatcher $bus)
      {
          $this->bus = $bus;
      }

      protected function data(ServerRequestInterface $request, Document $document)
      {
          $id = array_get($request->getQueryParams(), 'id');
          $actor = $request->getAttribute('actor');
          $data = array_get($request->getParsedBody(), 'data', []);

          if ($actor->id == $id) {
              $this->serializer = CurrentUserSerializer::class;
          }

          return $this->bus->dispatch(
              new EditUser($id, $actor, $data)
          );
      }
  }
  ```
