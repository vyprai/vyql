test "rank171: Aurora PostgreSQL dialect uses unqualified catalog routines"
  lang go
  expect VYQL-PATH-057
  expect_review code.UnqualifiedDatabaseRoutineReview
  code
  ```
  package dialects

  func (g *GlobalAuroraPgDatabaseDialect) IsDialect(conn driver.Conn) bool {
    if !utils.CheckExistenceQueries(conn,
      "SELECT 'aurora_global_db_status'::regproc",
      "SELECT 'aurora_global_db_instance_status'::regproc") {
      return false
    }

    regionCount := utils.GetFirstRowFromQuery(conn, "SELECT count(1) FROM aurora_global_db_status()")
    return regionCount != nil
  }

  func (g *GlobalAuroraPgDatabaseDialect) GetTopologyQuery() string {
    return "SELECT SERVER_ID FROM aurora_global_db_instance_status()"
  }
  ```

test "rank171: Aurora PostgreSQL dialect qualifies catalog routines"
  lang go
  reject VYQL-PATH-057
  reject_review code.UnqualifiedDatabaseRoutineReview
  code
  ```
  package dialects

  func (g *GlobalAuroraPgDatabaseDialect) IsDialect(conn driver.Conn) bool {
    if !utils.CheckExistenceQueries(conn,
      "SELECT 'pg_catalog.aurora_global_db_status'::regproc",
      "SELECT 'pg_catalog.aurora_global_db_instance_status'::regproc") {
      return false
    }

    regionCount := utils.GetFirstRowFromQuery(conn, "SELECT count(1) FROM pg_catalog.aurora_global_db_status()")
    return regionCount != nil
  }

  func (g *GlobalAuroraPgDatabaseDialect) GetTopologyQuery() string {
    return "SELECT SERVER_ID FROM pg_catalog.aurora_global_db_instance_status()"
  }
  ```
