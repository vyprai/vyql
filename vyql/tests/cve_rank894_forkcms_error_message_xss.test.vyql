test "rank894: ForkCMS error type parameter reaches template message without HTML escaping"
  lang php
  file index.php
  expect VYQL-INJ-004
  code
  ```
  <?php
  class BackendErrorIndex extends BackendBaseActionIndex
  {
      protected function parse()
      {
          $errorType = $this->getParameter('type');
          $this->tpl->assign('message', BL::err(SpoonFilter::toCamelCase($errorType, '-')));
      }
  }
  ```

test "rank894: ForkCMS error type is escaped before template message lookup"
  lang php
  file index.php
  reject VYQL-INJ-004
  code
  ```
  <?php
  class BackendErrorIndex extends BackendBaseActionIndex
  {
      protected function parse()
      {
          $errorType = $this->getParameter('type');
          $this->tpl->assign('message', BL::err(SpoonFilter::toCamelCase(htmlspecialchars($errorType), '-')));
      }
  }
  ```
