# Rank 246 / CVE-2026-40316: a privileged GitHub Actions workflow copied
# untrusted PR model files into the checked-out tree and then executed Django
# makemigrations, which imports model code.

test "rank246: pull_request_target workflow copies PR model code before makemigrations"
  lang config
  expect VYQL-INJ-044
  file .github/workflows/regenerate-migrations.yml
  code
  ```
  name: Regenerate Django Migrations

  on:
    pull_request_target:
      types:
        - labeled

  jobs:
    regenerate-migrations:
      runs-on: ubuntu-latest
      steps:
        - name: Copy model files from PR
          run: |
            echo "$CHANGED_MODELS" | while read -r file; do
              git show "$PR_SHA:$file" > "$file" 2>/dev/null || true
            done

        - name: Run makemigrations
          run: |
            poetry run python manage.py makemigrations
  ```

test "rank246: normal pull_request workflow model copy is outside privileged target pattern"
  lang config
  reject VYQL-INJ-044
  file .github/workflows/regenerate-migrations.yml
  code
  ```
  name: Regenerate Django Migrations

  on:
    pull_request:
      types:
        - labeled

  jobs:
    regenerate-migrations:
      runs-on: ubuntu-latest
      steps:
        - name: Copy model files from PR
          run: |
            echo "$CHANGED_MODELS" | while read -r file; do
              git show "$PR_SHA:$file" > "$file" 2>/dev/null || true
            done

        - name: Run makemigrations
          run: |
            poetry run python manage.py makemigrations
  ```
