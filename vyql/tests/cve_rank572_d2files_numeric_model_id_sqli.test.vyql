test "cve rank572 d2files: route model id must be cast before read validation and upload handler"
  lang php
  expect VYQL-INJ-073
  code
  ```
  <?php
  class D2filesController extends Controller {
      public function actionUpload($model_name, $model_id) {
          if (!$this->performReadValidation($model_name, $model_id)) {
              throw new CHttpException(403);
          }
          $oUploadHandler = new UploadHandlerD2files(array(
              'model_name' => $model_name,
              'model_id' => $model_id,
          ));
      }
  }
  ?>
  ```

test "cve rank572 d2files: cast route model id suppresses upload handler SQL review"
  lang php
  reject VYQL-INJ-073
  code
  ```
  <?php
  class D2filesController extends Controller {
      public function actionUpload($model_name, $model_id) {
          if (!$this->performReadValidation($model_name, (int)$model_id)) {
              throw new CHttpException(403);
          }
          $oUploadHandler = new UploadHandlerD2files(array(
              'model_name' => $model_name,
              'model_id' => (int)$model_id,
          ));
      }
  }
  ?>
  ```

test "cve rank572 d2files: download id must be cast before upload handler model id"
  lang php
  expect VYQL-INJ-073
  code
  ```
  <?php
  class D2filesController extends Controller {
      public function actionDownloadFile($id) {
          $oUploadHandler = new UploadHandlerD2files(array(
              'model_id' => $id,
              'download_via_php' => TRUE,
          ));
      }
  }
  ?>
  ```

