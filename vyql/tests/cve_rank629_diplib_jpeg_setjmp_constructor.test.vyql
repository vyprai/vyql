# Rank 629 / CVE-2021-39432: DIPlib registered libjpeg error handlers whose
# longjmp target was established inside wrapper constructors, so later libjpeg
# errors could jump into a returned stack frame and crash.
test "rank629: JPEG input constructor owns setjmp target used after construction"
  lang cpp
  file jpeg.cpp
  expect VYQL-DOS-022
  code
  ```
  #include <setjmp.h>
  #include "jpeglib.h"

  struct my_error_mgr {
    struct jpeg_error_mgr pub;
    jmp_buf setjmp_buffer;
  };

  using my_error_ptr = struct my_error_mgr*;

  void my_error_exit(j_common_ptr cinfo) {
    my_error_ptr myerr = reinterpret_cast<my_error_ptr>(cinfo->err);
    longjmp(myerr->setjmp_buffer, 1);
  }

  void my_output_message(j_common_ptr) {}

  class JpegInput {
   public:
    JpegInput(const char* filename) {
      infile_ = std::fopen(filename, "rb");
      cinfo_.err = jpeg_std_error(&jerr_.pub);
      jerr_.pub.error_exit = my_error_exit;
      jerr_.pub.output_message = my_output_message;
      if(setjmp(jerr_.setjmp_buffer)) {
        throw "Error reading JPEG file.";
      }
      jpeg_create_decompress(&cinfo_);
      jpeg_stdio_src(&cinfo_, infile_);
      jpeg_read_header(&cinfo_, TRUE);
    }

   private:
    FILE* infile_;
    jpeg_decompress_struct cinfo_;
    my_error_mgr jerr_;
  };
  ```

test "rank629: JPEG input constructor uses caller-owned setjmp target"
  lang cpp
  file jpeg.cpp
  reject VYQL-DOS-022
  code
  ```
  #include <csetjmp>
  #include <cstring>
  #include "jpeglib.h"

  struct my_error_mgr {
    struct jpeg_error_mgr pub;
    std::jmp_buf setjmp_buffer;
  };

  using my_error_ptr = struct my_error_mgr*;

  static void my_error_exit(j_common_ptr cinfo) {
    my_error_ptr myerr = reinterpret_cast<my_error_ptr>(cinfo->err);
    longjmp(myerr->setjmp_buffer, 1);
  }

  static void my_output_message(j_common_ptr) {}

  #define DIP__DECLARE_JPEG_EXIT(message) \
    std::jmp_buf setjmp_buffer; if(setjmp(setjmp_buffer)) { throw message; }

  class JpegInput {
   public:
    JpegInput(const char* filename, std::jmp_buf const& setjmp_buffer) {
      infile_ = std::fopen(filename, "rb");
      cinfo_.err = jpeg_std_error(&jerr_.pub);
      jerr_.pub.error_exit = my_error_exit;
      jerr_.pub.output_message = my_output_message;
      std::memcpy(jerr_.setjmp_buffer, setjmp_buffer, sizeof(setjmp_buffer));
      jpeg_create_decompress(&cinfo_);
      jpeg_stdio_src(&cinfo_, infile_);
      jpeg_read_header(&cinfo_, TRUE);
    }

   private:
    FILE* infile_;
    jpeg_decompress_struct cinfo_;
    my_error_mgr jerr_;
  };

  void ImageReadJPEG(const char* filename) {
    DIP__DECLARE_JPEG_EXIT("Error reading JPEG file");
    JpegInput jpeg(filename, setjmp_buffer);
  }
  ```
