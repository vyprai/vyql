# Rank 926 / CVE-2026-39849: Pi-hole FTL used a stub validator for
# dns.interface, allowing newline-bearing values before dnsmasq syntax use.

test "rank926: DNS interface config uses stub validator"
  lang c
  file config.c
  expect VYQL-VAL-015
  expect_review code.DnsInterfaceNewlineValidationMissing
  code
  ```
  void initConfig(struct config *conf)
  {
      conf->dns.interface.k = "dns.interface";
      conf->dns.interface.h = "Interface to use for DNS and DHCP";
      conf->dns.interface.a = cJSON_CreateStringReference("a valid interface name");
      conf->dns.interface.t = CONF_STRING;
      conf->dns.interface.f = FLAG_RESTART_FTL;
      conf->dns.interface.d.s = (char*)"";
      conf->dns.interface.c = validate_stub;

      conf->dns.hostRecord.k = "dns.hostRecord";
      conf->dns.hostRecord.t = CONF_STRING;
      conf->dns.hostRecord.c = validate_str_no_newline;
  }
  ```

test "rank926: DNS interface config rejects newlines"
  lang c
  file config.c
  reject VYQL-VAL-015
  reject_review code.DnsInterfaceNewlineValidationMissing
  code
  ```
  void initConfig(struct config *conf)
  {
      conf->dns.interface.k = "dns.interface";
      conf->dns.interface.h = "Interface to use for DNS and DHCP";
      conf->dns.interface.a = cJSON_CreateStringReference("a valid interface name");
      conf->dns.interface.t = CONF_STRING;
      conf->dns.interface.f = FLAG_RESTART_FTL;
      conf->dns.interface.d.s = (char*)"";
      conf->dns.interface.c = validate_str_no_newline;

      conf->dns.hostRecord.k = "dns.hostRecord";
      conf->dns.hostRecord.t = CONF_STRING;
      conf->dns.hostRecord.c = validate_str_no_newline;
  }
  ```
