# Scala language-gap narrowing: exhaustive coverage for adapter-claimed idioms.

test "scala exhaustive: request input reaches SQL execution"
  lang scala
  expect VYQL-INJ-001
  code
  ```
  object T {
    def handler(request: Request, stmt: Statement) = {
      val q = request.getQueryString("q").get
      stmt.executeQuery(q)
      stmt.executeUpdate(q)
      stmt.execute(q)
      SQL(q)
    }
  }
  ```

test "scala exhaustive: constant SQL execution is clean"
  lang scala
  reject VYQL-INJ-001
  code
  ```
  object T {
    def handler(stmt: Statement) = {
      stmt.executeQuery("select 1")
      SQL("select 1")
    }
  }
  ```

test "scala exhaustive: request input reaches command execution"
  lang scala
  expect VYQL-INJ-002
  code
  ```
  object T {
    def handler(request: Request) = {
      val cmd = request.getQueryString("cmd").get
      Runtime.getRuntime.exec(cmd)
      Process(cmd)
    }
  }
  ```

test "scala exhaustive: shell escaping suppresses command execution"
  lang scala
  reject VYQL-INJ-002
  code
  ```
  object T {
    def handler(request: Request) = {
      Runtime.getRuntime.exec(escapeShell(request.getQueryString("cmd").get))
    }
  }
  ```

test "scala exhaustive: file and archive APIs receive tainted paths"
  lang scala
  expect VYQL-PATH-001
  expect VYQL-PATH-004
  code
  ```
  object T {
    def handler(request: Request, archive: Archive) = {
      val p = request.getQueryString("path").get
      Source.fromFile(p)
      File(p).readText()
      archive.extractEntry(p)
    }
  }
  ```

test "scala exhaustive: canonicalized file and archive paths are clean"
  lang scala
  reject VYQL-PATH-001
  reject VYQL-PATH-004
  code
  ```
  object T {
    def handler(request: Request, archive: Archive) = {
      val p = safePath(request.getQueryString("path").get)
      Source.fromFile(p)
      archive.extractEntry(p)
    }
  }
  ```

test "scala exhaustive: Play and Akka HTTP clients fetch tainted URLs"
  lang scala
  expect VYQL-RF-001
  code
  ```
  object T {
    def handler(request: Request, ws: WSClient, http: HttpExt) = {
      val u = request.getQueryString("url").get
      ws.url(u)
      http.singleRequest(HttpRequest(uri = u))
    }
  }
  ```

test "scala exhaustive: constant HTTP client URLs are clean for SSRF"
  lang scala
  reject VYQL-RF-001
  code
  ```
  object T {
    def handler(ws: WSClient, http: HttpExt) = {
      ws.url("https://example.com")
      http.singleRequest(HttpRequest(uri = "https://example.com"))
    }
  }
  ```

