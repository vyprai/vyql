test "scala exhaustive: regex and deserialization sinks receive taint"
  lang scala
  expect VYQL-DOS-001
  expect VYQL-DESER-001
  code
  ```
  object T {
    def handler(request: Request, mapper: ObjectMapper, stream: ObjectInputStream) = {
      val v = request.getQueryString("v").get
      Pattern.compile(v)
      mapper.readValue(v, classOf[User])
      stream.readObject()
    }
  }
  ```

test "scala exhaustive: constant regex and deserialization data are clean"
  lang scala
  reject VYQL-DOS-001
  reject VYQL-DESER-001
  code
  ```
  object T {
    def handler(mapper: ObjectMapper) = {
      Pattern.compile("^[a-z]+$")
      mapper.readValue("{\"name\":\"a\"}", classOf[User])
    }
  }
  ```

test "scala exhaustive: HTML LDAP XPath trust-boundary and expression sinks receive taint"
  lang scala
  expect VYQL-INJ-004
  expect VYQL-INJ-005
  expect VYQL-INJ-006
  expect VYQL-CFG-014
  expect VYQL-INJ-016
  code
  ```
  object T {
    def handler(request: Request, out: Writer, ldap: DirContext, xpath: XPath, session: Session, parser: Parser) = {
      val v = request.getQueryString("v").get
      Html(v)
      out.write(v)
      ldap.search("dc=x", v, controls)
      xpath.evaluate(v, doc)
      session.setAttribute("role", v)
      parser.parseExpression(v)
    }
  }
  ```

test "scala exhaustive: encoders and validation suppress HTML LDAP XPath and trust-boundary findings"
  lang scala
  reject VYQL-INJ-004
  reject VYQL-INJ-005
  reject VYQL-INJ-006
  reject VYQL-CFG-014
  code
  ```
  object T {
    def handler(request: Request, out: Writer, ldap: DirContext, xpath: XPath, session: Session) = {
      val html = escapeHtml(request.getQueryString("v").get)
      val filter = encodeForLDAP(request.getQueryString("v").get)
      val xp = xpathEscape(request.getQueryString("v").get)
      val role = validateRole(request.getQueryString("v").get)
      out.write(html)
      ldap.search("dc=x", filter, controls)
      xpath.evaluate(xp, doc)
      session.setAttribute("role", role)
    }
  }
  ```

test "scala exhaustive: auth and IDOR findings are reported"
  lang scala
  expect VYQL-AUTH-001
  expect VYQL-AUTH-002
  code
  ```
  object T {
    def handler(request: Request, repo: Repo) = {
