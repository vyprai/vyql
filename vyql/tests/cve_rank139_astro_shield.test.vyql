# Rank 139 / CVE-2024-30250: Astro-Shield trusted caller-provided SRI metadata
# for dynamic external resources.

test "rank139: javascript SRI metadata registers unapproved external resource for review"
  lang javascript
  expect VYQL-INJ-198
  expect_review code.ExternalResourceIntegrityReview
  code
  ```
  const integrityRegex = /\s+integrity\s*=\s*("(?<integrity1>.*?)"|'(?<integrity2>.*?)')/i

  export const updateDynamicPageSriHashes = async (logger, content, globalHashes, sri) => {
    const processors = [{ regex: /<script(?<attrs>.*?)>/gi, t2: 'scripts' }]
    for (const { regex, t2 } of processors) {
      let match
      while ((match = regex.exec(content)) !== null) {
        const attrs = match.groups?.attrs ?? ''
        const srcMatch = /\s+src\s*=\s*"(?<src1>.*?)"/i.exec(attrs)
        const integrityMatch = integrityRegex.exec(attrs)
        const src = srcMatch?.groups?.src1

        if (integrityMatch) {
          const sriHash =
            integrityMatch.groups?.integrity1 ??
            integrityMatch.groups?.integrity2
          if (sriHash && src) {
            const globalHash = globalHashes[t2].get(src)
            if (globalHash) {
              if (globalHash !== sriHash) {
                throw new Error('mismatch')
              }
            } else {
              globalHashes[t2].set(src, sriHash)
            }
          }
        }
      }
    }
  }
  ```

test "rank139: javascript SRI metadata unknown resource removal is clean"
  lang javascript
  reject VYQL-INJ-198
  reject_review code.ExternalResourceIntegrityReview
  code
  ```
  const integrityRegex = /\s+integrity\s*=\s*("(?<integrity1>.*?)"|'(?<integrity2>.*?)')/i

  export const updateDynamicPageSriHashes = async (logger, content, globalHashes, sri) => {
    const processors = [{ regex: /<script(?<attrs>.*?)>/gi, t2: 'scripts' }]
    for (const { regex, t2 } of processors) {
      let match
      while ((match = regex.exec(content)) !== null) {
        const attrs = match.groups?.attrs ?? ''
        const srcMatch = /\s+src\s*=\s*"(?<src1>.*?)"/i.exec(attrs)
        const integrityMatch = integrityRegex.exec(attrs)
        const src = srcMatch?.groups?.src1

        if (integrityMatch) {
          const givenSriHash =
            integrityMatch.groups?.integrity1 ??
            integrityMatch.groups?.integrity2
          if (givenSriHash && src) {
            const globalHash = globalHashes[t2].get(src)
            if (globalHash) {
              if (globalHash !== givenSriHash) {
                logger.warn(`Detected integrity hash mismatch for resource "${src}". Removing it.`)
              }
            } else {
              logger.warn(`Detected reference to not explicitly allowed external resource "${src}". Removing it.`)
            }
          }
        }
      }
    }
  }
  ```
