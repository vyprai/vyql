# Rank 740 / CVE-2026-33872: elixir-nodejs accepted the next
# Node.js port protocol response after a timeout, allowing a stale response
# from one caller to be returned to another. The fix tags requests and
# responses with UIDs and discards UID mismatches.

test "rank740: Elixir port worker waits for uncorrelated async response"
  lang elixir
  expect VYQL-RACE-006
  expect_review code.PortRequestResponseCorrelationMissing
  code
  ```
  defmodule NodeJS.Worker do
    use GenServer

    defp get_response(data, timeout) do
      receive do
        {_port, {:data, {_flag, chunk}}} ->
          @prefix ++ protocol_data = data ++ chunk
          {:ok, protocol_data}
      after
        timeout -> {:error, :timeout}
      end
    end

    def handle_call({module, args, opts}, _from, [_, port] = state)
        when is_tuple(module) do
      timeout = Keyword.get(opts, :timeout)
      esm = Keyword.get(opts, :esm, false)
      body = Jason.encode!([Tuple.to_list(module), args, esm])
      Port.command(port, "#{body}\n")

      case get_response(~c"", timeout) do
        {:ok, response} -> {:reply, decode(response), state}
        {:error, :timeout} -> {:reply, {:error, :timeout}, state}
      end
    end
  end
  ```

test "rank740: Elixir port worker correlates responses by UID"
  lang elixir
  reject VYQL-RACE-006
  reject_review code.PortRequestResponseCorrelationMissing
  code
  ```
  defmodule NodeJS.Worker do
    use GenServer

    defp get_response(data, timeout, port, expected_uid) do
      receive do
        {^port, {:data, {_flag, chunk}}} ->
          @prefix ++ protocol_data = data ++ chunk
          case extract_uid(protocol_data) do
            {^expected_uid, response_data} -> {:ok, response_data}
            {_stale_uid, _response_data} -> get_response(~c"", timeout, port, expected_uid)
          end
      after
        timeout -> {:error, :timeout}
      end
    end

    defp extract_uid(data), do: {"0", data}

    def handle_call({module, args, opts}, _from, %{port: port, uid_counter: uid_counter} = state)
        when is_tuple(module) do
      timeout = Keyword.get(opts, :timeout)
      esm = Keyword.get(opts, :esm, false)
      uid = Integer.to_string(uid_counter)
      body = Jason.encode!([uid, Tuple.to_list(module), args, esm])
      Port.command(port, "#{body}\n")

      state = %{state | uid_counter: uid_counter + 1}

      case get_response(~c"", timeout, port, uid) do
        {:ok, response} -> {:reply, decode(response), state}
        {:error, :timeout} -> {:reply, {:error, :timeout}, state}
      end
    end
  end
  ```
