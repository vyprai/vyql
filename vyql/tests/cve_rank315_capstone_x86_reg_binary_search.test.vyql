test "rank315: Capstone X86_insn_reg_intel recomputes midpoint after invalid interval"
  lang c
  expect VYQL-MEM-022
  expect_review code.BinarySearchTableIndexGuardBypass
  code
  ```
  typedef int bool;
  typedef int x86_reg;
  enum cs_ac_type { CS_AC_INVALID };
  struct insn_reg { unsigned int insn; enum cs_ac_type access; x86_reg reg; };
  #define ARR_SIZE(x) (sizeof(x) / sizeof((x)[0]))

  static struct insn_reg insn_regs_intel[] = {
      { 10, CS_AC_INVALID, 1 },
      { 20, CS_AC_INVALID, 2 },
  };
  static struct insn_reg insn_regs_intel_sorted[2];
  static bool intel_regs_sorted = 0;

  x86_reg X86_insn_reg_intel(unsigned int id, enum cs_ac_type *access)
  {
      unsigned int first = 0;
      unsigned int last = ARR_SIZE(insn_regs_intel) - 1;
      unsigned int mid = ARR_SIZE(insn_regs_intel) / 2;

      if (!intel_regs_sorted) {
          intel_regs_sorted = 1;
      }

      while (first <= last) {
          if (insn_regs_intel_sorted[mid].insn < id) {
              first = mid + 1;
          } else if (insn_regs_intel_sorted[mid].insn == id) {
              if (access) {
                  *access = insn_regs_intel_sorted[mid].access;
              }
              return insn_regs_intel_sorted[mid].reg;
          } else {
              if (mid == 0)
                  break;
              last = mid - 1;
          }
          mid = (first + last) / 2;
      }

      return 0;
  }
  ```

test "rank315: Capstone X86_insn_reg_intel range-checks id before binary search"
  lang c
  reject VYQL-MEM-022
  reject_review code.BinarySearchTableIndexGuardBypass
  code
  ```
  typedef int bool;
  typedef int x86_reg;
  enum cs_ac_type { CS_AC_INVALID };
  struct insn_reg { unsigned int insn; enum cs_ac_type access; x86_reg reg; };
  #define ARR_SIZE(x) (sizeof(x) / sizeof((x)[0]))

  static struct insn_reg insn_regs_intel[] = {
      { 10, CS_AC_INVALID, 1 },
      { 20, CS_AC_INVALID, 2 },
  };
  static struct insn_reg insn_regs_intel_sorted[2];
  static bool intel_regs_sorted = 0;

  x86_reg X86_insn_reg_intel(unsigned int id, enum cs_ac_type *access)
  {
      unsigned int first = 0;
      unsigned int last = ARR_SIZE(insn_regs_intel) - 1;
      unsigned int mid;

      if (!intel_regs_sorted) {
          intel_regs_sorted = 1;
      }

      if (insn_regs_intel_sorted[0].insn > id ||
              insn_regs_intel_sorted[last].insn < id) {
          return 0;
      }

      while (first <= last) {
          mid = (first + last) / 2;
          if (insn_regs_intel_sorted[mid].insn < id) {
              first = mid + 1;
          } else if (insn_regs_intel_sorted[mid].insn == id) {
              if (access) {
                  *access = insn_regs_intel_sorted[mid].access;
              }
              return insn_regs_intel_sorted[mid].reg;
          } else {
              if (mid == 0)
                  break;
              last = mid - 1;
          }
      }

      return 0;
  }
  ```
