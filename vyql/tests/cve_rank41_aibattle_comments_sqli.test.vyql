# Rank 41 / CVE-2015-10041: AIBattle sendComments SQL injection.
# Ledger verification: VYQL-INJ-001 catches comments.php text flowing to SQL.

test "rank41: AIBattle comment text reaches SQL query"
  lang php
  expect VYQL-INJ-001
  code
  ```
  <?php
  $text = $_POST["text"];
  mysqli_query($db, "INSERT INTO comments(text) VALUES ('" . $text . "')");
  ?>
  ```

test "rank41: AIBattle comment text is parameterized"
  lang php
  reject VYQL-INJ-001
  code
  ```
  <?php
  $text = $_POST["text"];
  $stmt = $db->prepare("INSERT INTO comments(text) VALUES (?)");
  $stmt->bind_param("s", $text);
  $stmt->execute();
  ?>
  ```
