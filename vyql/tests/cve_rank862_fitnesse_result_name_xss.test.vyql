# Rank 862 / CVE-2020-2175: Jenkins FitNesse plugin returned a stored
# test-result name directly from getName(), allowing result-name XSS.

test "rank862: Jenkins TestResult getName returns raw stored name"
  lang java
  file ResultsDetails.java
  expect VYQL-INJ-173
  expect_review code.JenkinsTestResultNameXss
  code
  ```
  import hudson.tasks.test.TestResult;

  public class ResultsDetails extends TestResult {
      private String name;

      public ResultsDetails(String name) {
          this.name = name;
      }

      @Override
      public String getName() {
          return name;
      }
  }
  ```

test "rank862: Jenkins TestResult getName escapes stored name"
  lang java
  file ResultsDetails.java
  reject VYQL-INJ-173
  reject_review code.JenkinsTestResultNameXss
  code
  ```
  import hudson.tasks.test.TestResult;

  public class ResultsDetails extends TestResult {
      private String name;

      public ResultsDetails(String name) {
          this.name = name;
      }

      @Override
      public String getName() {
          return hudson.Util.escape(name);
      }
  }
  ```
