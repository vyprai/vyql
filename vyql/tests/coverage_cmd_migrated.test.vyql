# Coverage migrated out of go/cmd/vyql/main_test.go. These stay as data-driven
# rule specs so cmd package tests do not encode security knowledge directly.

test "javascript: ldapEscape assumption is reported but does not suppress LDAP injection"
  lang javascript
  expect VYQL-INJ-005
  expect_evidence VYQL-INJ-005 assumption
  code
  ```
  const ldap = require('ldapjs');
  function handler(req, res) {
    const name = req.query.name;
    const safe = ldapEscape(name);
    const client = ldap.createClient();
    client.search('ou=users', { filter: '(uid=' + safe + ')' }, function (err, r) {});
  }
  ```

test "javascript: prefix path guard is reported with an assumption note"
  lang javascript
  expect VYQL-PATH-001
  expect_evidence VYQL-PATH-001 assumption
  code
  ```
  const fs = require('fs');
  function handler(req, res) {
    const p = req.query.file;
    if (p.startsWith('/safe/')) {
      fs.readFile(p, function (e, d) {});
    }
  }
  ```

test "java: substring blocklist path guard is reported with an assumption note"
  lang java
  expect VYQL-PATH-001
  expect_evidence VYQL-PATH-001 assumption
  code
  ```
  import java.io.File;
  class T {
    void blocklist(javax.servlet.http.HttpServletRequest req) throws Exception {
      String p = req.getParameter("f");
      if (p.contains("..")) return;
      java.nio.file.Files.readAllBytes(new File(p).toPath());
    }
  }
  ```

test "java: constant membership allowlist suppresses path traversal"
  lang java
  reject VYQL-PATH-001
  code
  ```
  import java.io.File;
  import java.util.Arrays;
  class T {
    void allowlist(javax.servlet.http.HttpServletRequest req) throws Exception {
      String p = req.getParameter("g");
      String safe = Arrays.asList("a.txt", "b.txt").contains(p) ? p : "a.txt";
      java.nio.file.Files.readAllBytes(new File(safe).toPath());
    }
  }
  ```

test "javascript: replace replacement is inserted verbatim, not treated as a char filter"
  lang javascript
  expect VYQL-INJ-004
  reject_evidence VYQL-INJ-004 char-filter
  code
  ```
  function handler(req, res) {
    const payload = req.query.value;
    const html = '<article>{{value}}</article>'.replace('{{value}}', payload);
    res.type('html').send(html);
  }
  ```

test "javascript: ES module named import propagates taint"
  lang javascript
  expect VYQL-INJ-004
  file lib.js
  code
  ```
  export function readInput(req, key) {
    return req.query[key];
  }
  ```
  file handler.js
  code
  ```
  import { readInput } from './lib';
  export function handler(req, res) {
    const raw = readInput(req, 'q');
    res.send('<div>' + raw + '</div>');
  }
  ```

test "php: reused existing media URL controls upload destination"
  lang php
  expect VYQL-INJ-015
  code
  ```
  <?php
  class Standard {
    public function upload($item, $file) {
      $mime = $this->mimetype($file);
      $path = $item->getUrl() ?: $this->path($file->getClientFilename(), $mime, "catalog");
      $this->context()->fs("fs-media")->write($path, $file->getStream()->getContents());
    }
  }
  ```

test "php: upload destination derived from uploaded filename is clean"
  lang php
  reject VYQL-INJ-015
  code
  ```
  <?php
  class Standard {
    public function upload($item, $file) {
      $mime = $this->mimetype($file);
      $path = $this->path($file->getClientFilename(), $mime, "catalog");
      $this->context()->fs("fs-media")->write($path, $file->getStream()->getContents());
    }
  }
  ```

test "javascript: AJV limitItems template misses number keyword validation"
  lang javascript
  expect VYQL-INJ-029
  file vuln/_limitItems.jst
  code
  ```
  {{# def.definitions }}
  {{# def.errors }}
  {{# def.setupKeyword }}
  {{# def.$data }}

  {{ var $op = $keyword == 'maxItems' ? '>' : '<'; }}
  if ({{# def.$dataNotType:'number' }} {{=$data}}.length {{=$op}} {{=$schemaValue}}) {
    {{ var $errorKeyword = $keyword; }}
    {{# def.error:'_limitItems' }}
  }
  ```

test "javascript: AJV limitItems template with number keyword validation is clean"
  lang javascript
  reject VYQL-INJ-029
  file fixed/_limitItems.jst
  code
  ```
  {{# def.definitions }}
  {{# def.errors }}
  {{# def.setupKeyword }}
  {{# def.$data }}

  {{# def.numberKeyword }}

  {{ var $op = $keyword == 'maxItems' ? '>' : '<'; }}
  if ({{# def.$dataNotType:'number' }} {{=$data}}.length {{=$op}} {{=$schemaValue}}) {
    {{ var $errorKeyword = $keyword; }}
    {{# def.error:'_limitItems' }}
  }
  ```
