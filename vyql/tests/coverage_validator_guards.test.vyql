# SSRF / open-redirect / XXE allowlist validators + XML hardening are GUARD-pattern
# controls (they gate via control flow / configure the parser, rather than transforming the
# tainted value on its data path). B1 dominance connects them to the sink they cover, so a
# validator/hardener that dominates the sink suppresses; an unvalidated flow still fires.

test "ssrf: a URL allowlist validator dominating the fetch suppresses (RF-001)"
  lang python
  reject VYQL-RF-001
  code
  ```
  def fetch(request):
      url = request.args["url"]
      validate_url(url)
      requests.get(url)
  ```

test "ssrf: an unvalidated fetch is vulnerable (RF-001)"
  lang python
  expect VYQL-RF-001
  code
  ```
  def fetch(request):
      url = request.args["url"]
      requests.get(url)
  ```

test "open-redirect: a safe-url check dominating the redirect suppresses (RF-002)"
  lang python
  reject VYQL-RF-002
  code
  ```
  def go(request):
      target = request.args["next"]
      is_safe_url(target)
      return redirect(target)
  ```

test "open-redirect: an unvalidated redirect is vulnerable (RF-002)"
  lang python
  expect VYQL-RF-002
  code
  ```
  def go(request):
      target = request.args["next"]
      return redirect(target)
  ```

test "xxe: a hardened parser (resolve_entities=False) suppresses (DESER-002)"
  lang python
  reject VYQL-DESER-002
  code
  ```
  from lxml import etree
  def parse(request):
      data = request.data
      parser = etree.XMLParser(resolve_entities=False)
      etree.parse(data, parser)
  ```

test "xxe: an unhardened parse is vulnerable (DESER-002)"
  lang python
  expect VYQL-DESER-002
  code
  ```
  from lxml import etree
  def parse(request):
      data = request.data
      etree.parse(data)
  ```
