# Bash language-gap narrowing: exhaustive coverage for adapter-claimed shell idioms.

test "bash exhaustive: positional arg reaches eval"
  lang bash
  expect VYQL-INJ-003
  code
  ```
  payload=$1
  eval "$payload"
  ```

test "bash exhaustive: CGI env var reaches eval through braced expansion"
  lang bash
  expect VYQL-INJ-003
  code
  ```
  payload="${QUERY_STRING}"
  eval "$payload"
  ```

test "bash exhaustive: constant eval is clean"
  lang bash
  reject VYQL-INJ-003
  code
  ```
  payload="printf safe"
  eval "$payload"
  ```

test "bash exhaustive: shell interpreters -c execute tainted commands"
  lang bash
  expect VYQL-INJ-002
  code
  ```
  cmd="$QUERY_STRING"
  sh -c "$cmd"
  bash -c "$cmd"
  zsh -c "$cmd"
  ksh -c "$cmd"
  ```

test "bash exhaustive: constant shell interpreter commands are clean"
  lang bash
  reject VYQL-INJ-002
  code
  ```
  sh -c "printf safe"
  bash -c "printf safe"
  ```

test "bash exhaustive: language interpreter eval flags execute tainted code"
  lang bash
  expect VYQL-INJ-003
  code
  ```
  code="$QUERY_STRING"
  python -c "$code"
  python3 -c "$code"
  perl -e "$code"
  php -r "$code"
  node -e "$code"
  ```

test "bash exhaustive: constant language interpreter snippets are clean"
  lang bash
  reject VYQL-INJ-003
  code
  ```
  python -c "print('safe')"
  perl -e "print 'safe'"
  ```

test "bash exhaustive: curl and wget fetch tainted URLs"
  lang bash
  expect VYQL-RF-001
  code
  ```
  url="$HTTP_HOST"
  curl "$url"
  wget "$url"
  ```

test "bash exhaustive: constant fetch URLs are clean for SSRF"
  lang bash
  reject VYQL-RF-001
  code
  ```
  curl "https://api.example.com/v1"
  wget "https://static.example.com/file"
  ```

test "bash exhaustive: curl and wget cleartext URLs are reported"
  lang bash
  expect VYQL-CFG-006
  code
  ```
  curl "http://example.com"
  wget "http://example.com/file"
  ```

test "bash exhaustive: localhost and HTTPS URLs are clean for cleartext"
  lang bash
  reject VYQL-CFG-006
  code
  ```
  curl "http://127.0.0.1:8080/health"
  wget "https://example.com/file"
  ```

test "bash exhaustive: grep and egrep compile tainted regex patterns"
  lang bash
  expect VYQL-DOS-001
  code
  ```
  pattern="$QUERY_STRING"
  grep -E "$pattern" data.txt
  egrep "$pattern" data.txt
  ```

test "bash exhaustive: constant regex patterns are clean"
  lang bash
  reject VYQL-DOS-001
  code
  ```
  grep -E "^[a-z]+$" data.txt
  egrep "^ok$" data.txt
  ```

test "bash exhaustive: source and dot include tainted files"
  lang bash
  expect VYQL-PATH-002
  code
  ```
  inc="$QUERY_STRING"
  source "$inc"
  . "$inc"
  ```

test "bash exhaustive: constant include files are clean"
  lang bash
  reject VYQL-PATH-002
  code
  ```
  source "./lib/safe.sh"
  . "./lib/constants.sh"
  ```

test "bash exhaustive: filesystem utilities access tainted paths"
  lang bash
  expect VYQL-PATH-001
  code
  ```
  path="$QUERY_STRING"
  cat "$path"
  less "$path"
  head "$path"
  tail "$path"
  rm "$path"
  cp "$path" ./out
  mv "$path" ./out
  chmod 600 "$path"
  chown root "$path"
  tar -xf "$path"
  ```

test "bash exhaustive: constant filesystem paths are clean"
  lang bash
  reject VYQL-PATH-001
  code
  ```
  cat "./README.md"
  cp "./input.txt" "./out.txt"
  tar -xf "./archive.tar"
  ```

test "bash exhaustive: basename suppresses traversal into file utilities"
  lang bash
  reject VYQL-PATH-001
  code
  ```
  payload="${QUERY_STRING}"
  cat "./testfiles/$(basename -- "$payload")"
  ```

test "bash exhaustive: SQL clients execute tainted queries"
  lang bash
  expect VYQL-INJ-001
  code
  ```
  q="$QUERY_STRING"
  mysql -e "$q"
  psql -c "$q"
  sqlite3 app.db "$q"
  ```

test "bash exhaustive: constant SQL client queries are clean"
  lang bash
  reject VYQL-INJ-001
  code
  ```
  mysql -e "select 1"
  psql -c "select 1"
  sqlite3 app.db "select 1"
  ```

test "bash exhaustive: weak hash utilities are reported"
  lang bash
  expect VYQL-CRY-001
  code
  ```
  md5sum package.tar
  sha1sum package.tar
  ```

test "bash exhaustive: sha256sum is clean for weak hash"
  lang bash
  reject VYQL-CRY-001
  code
  ```
  sha256sum package.tar
  ```

test "bash exhaustive: RANDOM is weak randomness"
  lang bash
  expect VYQL-CRY-003
  code
  ```
  echo "$RANDOM"
  ```

test "bash exhaustive: openssl rand is clean for weak randomness"
  lang bash
  reject VYQL-CRY-003
  code
  ```
  echo "$(openssl rand -hex 16)"
  ```

test "bash exhaustive: world-writable chmod modes are reported"
  lang bash
  expect VYQL-CFG-008
  code
  ```
  chmod 777 ./upload
  chmod 666 ./log.txt
  chmod a+w ./shared
  ```

test "bash exhaustive: restrictive chmod modes are clean"
  lang bash
  reject VYQL-CFG-008
  code
  ```
  chmod 600 ./secret
  chmod 640 ./group-secret
  chmod 755 ./bin/tool
  ```

test "bash exhaustive: mktemp -u is unsafe temp-file generation"
  lang bash
  expect VYQL-PATH-003
  code
  ```
  name=$(mktemp -u)
  touch "$name"
  ```

test "bash exhaustive: ordinary mktemp is clean"
  lang bash
  reject VYQL-PATH-003
  code
  ```
  name=$(mktemp)
  printf ok > "$name"
  ```
