# P2 entry-point seeding: JAX-RS / Micronaut / Quarkus handler params.

test "java: JAX-RS @QueryParam -> SQL is injection"
  lang java
  expect VYQL-INJ-001
  code
  ```
  @Path("/users")
  public class UserResource {
    @GET
    public String find(@QueryParam("name") String name) throws Exception {
      Statement st = conn.createStatement();
      return st.executeQuery("SELECT * FROM users WHERE name = '" + name + "'").toString();
    }
  }
  ```

test "java: JAX-RS constant query is clean"
  lang java
  reject VYQL-INJ-001
  code
  ```
  @Path("/users")
  public class UserResource {
    @GET
    public String all() throws Exception {
      Statement st = conn.createStatement();
      return st.executeQuery("SELECT * FROM users").toString();
    }
  }
  ```

test "java: Micronaut @Get handler param -> command injection"
  lang java
  expect VYQL-INJ-002
  code
  ```
  @Controller("/ping")
  public class PingController {
    @Get
    public void ping(String host) throws Exception {
      Runtime.getRuntime().exec("ping " + host);
    }
  }
  ```

test "java: JAX-RS array handler param through loop -> logger.warn is log injection"
  lang java
  expect VYQL-INJ-009
  code
  ```
  @Path("/broadcasts")
  class BroadcastRestService {
    @DELETE
    @Path("/bulk")
    public Result deleteBroadcasts(String[] streamIds) {
      for (String id : streamIds) {
        logger.warn("It cannot delete {} and breaking the loop", id);
      }
      return new Result(false);
    }
  }
  ```

test "java: JAX-RS array handler param through superclass loop -> logger.warn is log injection"
  lang java
  expect VYQL-INJ-009
  code
  ```
  @Path("/broadcasts")
  class BroadcastRestService extends RestServiceBase {
    @DELETE
    @Path("/bulk")
    public Result deleteBroadcasts(String[] streamIds) {
      return super.deleteBroadcasts(streamIds);
    }
  }

  class RestServiceBase {
    protected Result deleteBroadcasts(String[] streamIds) {
      Result result = new Result(false);
      if (streamIds != null) {
        for (String id : streamIds) {
          result = deleteBroadcast(id);
          if (!result.isSuccess()) {
            logger.warn("It cannot delete {} and breaking the loop", id);
            break;
          }
        }
      }
      return result;
    }
  }
  ```

test "java: JAX-RS array handler param stripped of newlines before logger.warn is clean"
  lang java
  reject VYQL-INJ-009
  code
  ```
  @Path("/broadcasts")
  class BroadcastRestService extends RestServiceBase {
    @DELETE
    @Path("/bulk")
    public Result deleteBroadcasts(String[] streamIds) {
      return super.deleteBroadcasts(streamIds);
    }
  }

  class RestServiceBase {
    private static final String REPLACE_CHARS_FOR_SECURITY = "[\n\r]";

    protected Result deleteBroadcasts(String[] streamIds) {
      Result result = new Result(false);
      if (streamIds != null) {
        for (String id : streamIds) {
          result = deleteBroadcast(id);
          if (!result.isSuccess()) {
            id = id.replaceAll(REPLACE_CHARS_FOR_SECURITY, "_");
            logger.warn("It cannot delete {} and breaking the loop", id);
            break;
          }
        }
      }
      return result;
    }
  }
  ```
