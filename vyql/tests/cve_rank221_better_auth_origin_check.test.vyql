test "rank221: better-auth origin checker skips redirect validation for GET"
  lang javascript
  file origin-check.ts
  expect VYQL-RF-008
  expect_review code.MethodGatedRedirectValidationBypass
  code
  ```
  export const originCheckMiddleware = createAuthMiddleware(async (ctx) => {
      if (ctx.request?.method !== "POST") {
          return;
      }
      const { body, query, context } = ctx;
      const callbackURL = body?.callbackURL || query?.callbackURL;
      const redirectURL = body?.redirectTo;
      const trustedOrigins = context.trustedOrigins;
      const validateURL = (url, label) => {
          const isTrustedOrigin = trustedOrigins.some((origin) => url.startsWith(origin));
          if (!isTrustedOrigin) {
              throw new APIError("FORBIDDEN", { message: `Invalid ${label}` });
          }
      };
      callbackURL && validateURL(callbackURL, "callbackURL");
      redirectURL && validateURL(redirectURL, "redirectURL");
  });
  ```

test "rank221: better-auth origin checker validates redirect URLs for all methods"
