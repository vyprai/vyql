# Rank 230 / CVE-2021-39159: BinderHub git provider argument injection.
# Ledger verification: VYQL-INJ-002 catches user repository value reaching git.

test "rank230: BinderHub user repo reaches git subprocess"
  lang python
  expect VYQL-INJ-002
  code
  ```
  import subprocess

  def resolve(request):
      repo = request.args["repo"]
      subprocess.run("git ls-remote " + repo, shell=True)
  ```

test "rank230: BinderHub user repo is shell-quoted"
  lang python
  reject VYQL-INJ-002
  code
  ```
  import shlex
  import subprocess

  def resolve(request):
      repo = request.args["repo"]
      subprocess.run("git ls-remote " + shlex.quote(repo), shell=True)
  ```
