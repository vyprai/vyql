# Lua language-gap narrowing: exhaustive coverage for adapter-claimed idioms.

test "lua exhaustive: ngx.var reaches command execution"
  lang lua
  expect VYQL-INJ-002
  code
  ```
  function f()
    local cmd = ngx.var.arg_cmd
    os.execute(cmd)
    io.popen(cmd)
  end
  ```

test "lua exhaustive: constant commands are clean"
  lang lua
  reject VYQL-INJ-002
  code
  ```
  function f()
    os.execute("echo safe")
    io.popen("echo safe")
  end
  ```

test "lua exhaustive: load APIs evaluate tainted code"
  lang lua
  expect VYQL-INJ-003
  code
  ```
  function f()
    local code = ngx.var.arg_code
    loadstring(code)
    load(code)
    loadfile(code)
    dofile(code)
  end
  ```

test "lua exhaustive: constant load APIs are clean"
  lang lua
  reject VYQL-INJ-003
  code
  ```
  function f()
    loadstring("return 1")
    load("return 1")
  end
  ```

test "lua exhaustive: require and file loaders use tainted module paths"
  lang lua
  expect VYQL-INJ-023
  code
  ```
  function f()
    local mod = ngx.var.arg_mod
    require(mod)
    loadfile(mod)
    dofile(mod)
  end
  ```

test "lua exhaustive: constant dynamic loads are clean"
  lang lua
  reject VYQL-INJ-023
  code
  ```
  function f()
    require("safe.module")
    dofile("./safe.lua")
  end
  ```

test "lua exhaustive: file and lfs APIs access tainted paths"
  lang lua
  expect VYQL-PATH-001
  code
  ```
  function f()
    local p = ngx.var.arg_path
    io.open(p)
    io.lines(p)
    os.remove(p)
    os.rename(p, "./out")
    lfs.attributes(p)
    lfs.chdir(p)
    lfs.mkdir(p)
    lfs.rmdir(p)
    lfs.touch(p)
    lfs.chmod(p, "600")
  end
  ```

test "lua exhaustive: constant file paths are clean"
  lang lua
  reject VYQL-PATH-001
  code
  ```
  function f()
    io.open("./safe.txt")
    lfs.attributes("./safe.txt")
  end
  ```

test "lua exhaustive: SQL query methods receive tainted query text"
  lang lua
  expect VYQL-INJ-001
  code
  ```
  function f(db)
    local q = ngx.var.arg_q
    db:query(q)
    db:execute(q)
  end
  ```

test "lua exhaustive: SQL sanitizer suppresses query findings"
  lang lua
  reject VYQL-INJ-001
  code
  ```
  function f(db)
    local q = ngx.quote_sql_str(ngx.var.arg_q)
    db:query(q)
  end
  ```

test "lua exhaustive: ngx response writers render tainted HTML"
  lang lua
  expect VYQL-INJ-004
  code
  ```
  function f()
    ngx.say(ngx.var.arg_html)
    ngx.print(ngx.var.arg_html)
  end
  ```

test "lua exhaustive: escaped response writers are clean"
  lang lua
  reject VYQL-INJ-004
  code
  ```
  function f()
    ngx.say(escapeHtml(ngx.var.arg_html))
  end
  ```

test "lua exhaustive: HTTP clients fetch tainted URLs"
  lang lua
  expect VYQL-RF-001
  code
  ```
  function f(client)
    local url = ngx.var.arg_url
    http.request(url)
    client:request_uri(url)
  end
  ```

test "lua exhaustive: constant HTTP client URLs are clean for SSRF"
  lang lua
  reject VYQL-RF-001
  code
  ```
  function f(client)
    http.request("https://example.com")
    client:request_uri("https://example.com")
  end
  ```

test "lua exhaustive: cleartext HTTP client URLs are reported"
  lang lua
  expect VYQL-CFG-006
  code
  ```
  function f(client)
    http.request("http://example.com")
    client:request_uri("http://example.com")
  end
  ```

test "lua exhaustive: HTTPS and localhost URLs are clean for cleartext"
  lang lua
  reject VYQL-CFG-006
  code
  ```
  function f(client)
    http.request("https://example.com")
    client:request_uri("http://127.0.0.1:8080/health")
  end
  ```

test "lua exhaustive: ngx regex APIs compile tainted patterns"
  lang lua
  expect VYQL-DOS-001
  code
  ```
  function f()
    local pat = ngx.var.arg_pattern
    ngx.re.match("subject", pat)
    ngx.re.find("subject", pat)
    ngx.re.gsub("subject", pat, "x")
  end
  ```

test "lua exhaustive: constant regex patterns are clean"
  lang lua
  reject VYQL-DOS-001
  code
  ```
  function f()
    ngx.re.match("subject", "^[a-z]+$")
  end
  ```

test "lua exhaustive: LDAP and XPath queries receive tainted expressions"
  lang lua
  expect VYQL-INJ-005
  expect VYQL-INJ-006
  code
  ```
  function f(ld, xp)
    ld:search("base", ngx.var.arg_filter)
    xp:evaluate(ngx.var.arg_xpath)
  end
  ```

test "lua exhaustive: escaped LDAP and XPath expressions are clean"
  lang lua
  reject VYQL-INJ-005
  reject VYQL-INJ-006
  code
  ```
  function f(ld, xp)
    ld:search("base", encodeForLDAP(ngx.var.arg_filter))
    xp:evaluate(escapeXPath(ngx.var.arg_xpath))
  end
  ```

test "lua exhaustive: trust boundary stores tainted session values"
  lang lua
  expect VYQL-CFG-014
  code
  ```
  function f(session)
    session:set("user_id", ngx.var.arg_user)
  end
  ```

test "lua exhaustive: validated trust-boundary values are clean"
  lang lua
  reject VYQL-CFG-014
  code
  ```
  function f(session)
    session:set("role", validateRole(ngx.var.arg_role))
  end
  ```

test "lua exhaustive: auth and IDOR findings are reported"
  lang lua
  expect VYQL-AUTH-001
  expect VYQL-AUTH-002
  code
  ```
  function f(accounts)
    change_password()
    accounts:find_by_id(ngx.var.arg_id)
  end
  ```

test "lua exhaustive: auth and ownership guards suppress findings"
  lang lua
  reject VYQL-AUTH-001
  reject VYQL-AUTH-002
  code
  ```
  function f(accounts)
    require_auth()
    change_password()
    check_ownership(ngx.var.arg_id)
    accounts:find_by_id(ngx.var.arg_id)
  end
  ```

test "lua exhaustive: weak crypto and randomness are reported"
  lang lua
  expect VYQL-CRY-001
  expect VYQL-CRY-002
  expect VYQL-CRY-003
  code
  ```
  function f()
    md5.sum("data")
    sha1.sum("data")
    crypto.cipher("DES")
    crypto.cipher("RC4")
    math.random()
  end
  ```

test "lua exhaustive: stronger crypto and secure randomness are clean"
  lang lua
  reject VYQL-CRY-001
  reject VYQL-CRY-002
  reject VYQL-CRY-003
  code
  ```
  function f()
    sha256.sum("data")
    crypto.cipher("AES")
    resty.random.bytes(32)
  end
  ```

test "lua exhaustive: static IV and insecure cookie flags are reported"
  lang lua
  expect VYQL-CRY-004
  expect VYQL-CFG-007
  code
  ```
  function f(cookie)
    crypto.cipher("0000000000000000")
    cookie:set_secure(false)
    cookie:set_httponly(false)
  end
  ```

test "lua exhaustive: runtime IV and secure cookie flags are clean"
  lang lua
  reject VYQL-CRY-004
  reject VYQL-CFG-007
  code
  ```
  function f(cookie, iv)
    crypto.cipher(iv)
    cookie:set_secure(true)
    cookie:set_httponly(true)
  end
  ```

test "lua exhaustive: lfs chmod world-writable modes and os.tmpname are reported"
  lang lua
  expect VYQL-CFG-008
  expect VYQL-PATH-003
  code
  ```
  function f()
    lfs.chmod("./upload", "777")
    os.tmpname()
  end
  ```

test "lua exhaustive: restrictive chmod is clean"
  lang lua
  reject VYQL-CFG-008
  code
  ```
  function f()
    lfs.chmod("./secret", "600")
  end
  ```

test "lua exhaustive: resource handles closed are clean"
  lang lua
  reject VYQL-RES-001
  code
  ```
  function f()
    local fh = io.open("./safe.txt")
    fh:close()
    local s = socket.tcp()
    s:close()
  end
  ```

test "lua exhaustive: resource handles leak"
  lang lua
  expect VYQL-RES-001
  code
  ```
  function f()
    local fh = io.open("./safe.txt")
    fh:read("*a")
  end
  ```
