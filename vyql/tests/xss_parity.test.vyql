# XSS (CWE-79) coverage for web languages that lacked an HtmlRender sink.

test "go: query param -> template.HTML is template injection (already covered)"
  lang go
  expect VYQL-INJ-008
  code
  ```
  package m
  import "net/http"
  import "html/template"
  func h(r *http.Request) {
    x := r.URL.Query().Get("q")
    _ = template.HTML(x)
  }
  ```

test "elixir: params -> raw is XSS"
  lang elixir
  expect VYQL-INJ-004
  code
  ```
  defmodule H do
    def h(conn, params) do
      name = params["q"]
      raw(name)
    end
  end
  ```

test "scala: query string -> Html is XSS"
  lang scala
  expect VYQL-INJ-004
  code
  ```
  object H {
    def h(req: Request) = {
      val p = req.getQueryString
      Html(p)
    }
  }
  ```
