# Rank 274 / CVE-2020-15904: bsdiff4 checked the diff-block copy bounds
# before memcpy, then advanced newpos and copied the extra block without checking
# newpos + y against the destination allocation.

test "rank274: bsdiff4 extra block copy misses advanced destination bound"
  lang c
  expect VYQL-MEM-020
  expect_review code.MissingPostCopyBoundsCheck
  code
  ```
  void fail(void);
  void *memcpy(void *dest, const void *src, unsigned long n);

  void patch(char *newData, long newDataLength, char *diffBlock, long diffBlockLength, char *extraBlock, long extraBlockLength) {
    char *diffPtr = diffBlock;
    char *extraPtr = extraBlock;
    long newpos = 0;
    long x = 8;
    long y = 16;

    if (newpos + x > newDataLength ||
        diffPtr + x > diffBlock + diffBlockLength ||
        extraPtr + y > extraBlock + extraBlockLength) {
      fail();
    }
    memcpy(newData + newpos, diffPtr, x);
    diffPtr += x;
    newpos += x;
    memcpy(newData + newpos, extraPtr, y);
  }
  ```

test "rank274: bsdiff4 extra block copy checks advanced destination bound"
  lang c
  reject VYQL-MEM-020
  reject_review code.MissingPostCopyBoundsCheck
  code
  ```
  void fail(void);
  void *memcpy(void *dest, const void *src, unsigned long n);

  void patch(char *newData, long newDataLength, char *diffBlock, long diffBlockLength, char *extraBlock, long extraBlockLength) {
    char *diffPtr = diffBlock;
    char *extraPtr = extraBlock;
    long newpos = 0;
    long x = 8;
    long y = 16;

    if (newpos + x > newDataLength ||
        diffPtr + x > diffBlock + diffBlockLength) {
      fail();
    }
    memcpy(newData + newpos, diffPtr, x);
    diffPtr += x;
    newpos += x;
    if (newpos + y > newDataLength ||
        extraPtr + y > extraBlock + extraBlockLength) {
      fail();
    }
    memcpy(newData + newpos, extraPtr, y);
  }
  ```
