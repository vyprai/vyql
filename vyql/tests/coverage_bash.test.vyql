# Bash coverage breadth: SSRF via curl/wget.

test "bash: positional arg -> curl is SSRF"
  lang bash
  expect VYQL-RF-001
  code
  ```
  #!/bin/bash
  u="$1"
  curl "$u"
  ```

test "bash: a constant URL is clean (SSRF)"
  lang bash
  reject VYQL-RF-001
  code
  ```
  #!/bin/bash
  curl "https://api.example.com/v1"
  ```

test "bash: QUERY_STRING -> wget is SSRF"
  lang bash
  expect VYQL-RF-001
  code
  ```
  #!/bin/bash
  wget "$QUERY_STRING"
  ```
