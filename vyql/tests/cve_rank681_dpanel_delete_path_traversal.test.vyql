# Rank 681 / CVE-2025-66292: dpanel deleted a bound request path after storage
# resolution without checking that the path was local and cleaned.

test "rank681: dpanel delete handler removes bound request path without local check"
  lang go
  file attach.go
  expect VYQL-PATH-033
  code
  ```
  package controller

  import "os"

  type Attach struct{}

  func (self Attach) Delete(http *gin.Context) {
      type ParamsValidate struct {
          Path string `form:"path" binding:"required"`
      }
      params := ParamsValidate{}
      if !self.Validate(http, &params) {
          return
      }
      path := storage.Local{}.GetSaveRealPath(params.Path)
      _, err := os.Stat(path)
      if err == nil {
          os.Remove(path)
      }
      self.JsonSuccessResponse(http)
  }
  ```

test "rank681: dpanel delete handler requires local clean path before remove"
  lang go
  file attach.go
  reject VYQL-PATH-033
  code
  ```
  package controller

  import (
      "os"
      "path/filepath"
  )

  type Attach struct{}

  func (self Attach) Delete(http *gin.Context) {
      type ParamsValidate struct {
          Path string `form:"path" binding:"required"`
      }
      params := ParamsValidate{}
      if !self.Validate(http, &params) {
          return
      }
      if !filepath.IsLocal(params.Path) {
          return
      }
      params.Path = filepath.Clean(params.Path)
      path := storage.Local{}.GetSaveRealPath(params.Path)
      _, err := os.Stat(path)
      if err != nil {
          return
      }
      err = os.Remove(path)
      if err != nil {
          return
      }
      self.JsonSuccessResponse(http)
  }
  ```
