# Rank 304 / CVE-2021-3987: calibre-web allowed a logged-in user without the
# public-shelf edit role to create a public shelf because create_shelf delegated
# directly to create_edit_shelf without a role check.

test "rank304: calibre-web public shelf creation is review-worthy without role check"
  lang python
  expect_review code.AccessPolicyReview
  code
  ```
  @shelf.route("/shelf/create", methods=["GET", "POST"])
  @login_required
  def create_shelf():
      shelf = ub.Shelf()
      return create_edit_shelf(shelf, page_title=_(u"Create a Shelf"), page="shelfcreate")
  ```

test "rank304: calibre-web public shelf creation is guarded by role_edit_shelfs"
  lang python
  reject_review code.AccessPolicyReview
  code
  ```
  @shelf.route("/shelf/create", methods=["GET", "POST"])
  @login_required
  def create_shelf():
      if not current_user.role_edit_shelfs() and request.method == 'POST':
          flash(_(u"Sorry you are not allowed to create a public shelf"), category="error")
          return redirect(url_for('web.index'))
      else:
          shelf = ub.Shelf()
          return create_edit_shelf(shelf, page_title=_(u"Create a Shelf"), page="shelfcreate")
  ```
