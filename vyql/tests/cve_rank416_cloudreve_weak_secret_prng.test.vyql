test "rank416: Cloudreve admin secret reset uses math-rand-backed helper"
  lang go
  file site.go
  expect VYQL-CRY-007
  expect_review code.CloudreveWeakSecretPrng
  code
  ```
  package admin

  import (
      "context"

      "github.com/cloudreve/Cloudreve/v4/pkg/util"
  )

  func secretKeyPreProcessor(ctx context.Context, settings map[string]string) error {
      settings["secret_key"] = util.RandStringRunes(256)
      return nil
  }
  ```

test "rank416: Cloudreve admin secret reset uses crypto-rand-backed helper"
