# Rank 416 / CVE-2026-25726: Cloudreve generated critical persisted
# secrets with a math/rand-backed helper seeded from time.Now().UnixNano().

test "rank416: Cloudreve default secrets use math-rand-backed helper"
  lang go
  file setting.go
  expect VYQL-CRY-007
  expect_review code.CloudreveWeakSecretPrng
  code
  ```
  package inventory

  import "github.com/cloudreve/Cloudreve/v4/pkg/util"

  var DefaultSettings = map[string]any{
      "secret_key":   util.RandStringRunes(256),
      "hash_id_salt": util.RandStringRunes(64),
  }
  ```

test "rank416: Cloudreve default secrets use crypto-rand-backed helper"
  lang go
  file setting.go
  reject VYQL-CRY-007
  reject_review code.CloudreveWeakSecretPrng
  code
  ```
  package inventory

  import "github.com/cloudreve/Cloudreve/v4/pkg/util"

  var DefaultSettings = map[string]any{
      "secret_key":   util.RandStringRunesCrypto(256),
      "hash_id_salt": util.RandStringRunesCrypto(64),
  }
  ```

test "rank416: Cloudreve session secret uses math-rand-backed helper"
  lang go
  file conf.go
  expect VYQL-CRY-007
  expect_review code.CloudreveWeakSecretPrng
  code
  ```
  package conf

  import "github.com/cloudreve/Cloudreve/v4/pkg/util"

  func NewIniConfigProvider() {
      confContent := util.Replace(map[string]string{
          "{SessionSecret}": util.RandStringRunes(64),
      }, defaultConf)
      _ = confContent
  }
  ```

test "rank416: Cloudreve session secret uses crypto-rand-backed helper"
