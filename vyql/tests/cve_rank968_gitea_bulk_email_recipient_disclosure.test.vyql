# Rank 968 / CVE-2018-1000803: Gitea sent notification emails with the
# whole recipient slice, exposing all recipient addresses. The fix sends one
# message per recipient.

test "rank968: issue notification sends the collected recipient slice"
  lang go
  profile generic
  file models/issue_mail.go
  expect VYQL-SEC-036
  expect_review code.BulkEmailRecipientDisclosure
  code
  ```
  package models

  import "github.com/Unknwon/com"

  type Engine interface{}
  type Issue struct{}
  type User struct {
      ID int64
      Name string
      Email string
  }
  type Comment struct{}

  func getUserEmailsByNames(e Engine, names []string) []string { return nil }
  func SendIssueCommentMail(issue *Issue, doer *User, content string, comment *Comment, tos []string) {}
  func SendIssueMentionMail(issue *Issue, doer *User, content string, comment *Comment, tos []string) {}

  func mailIssueCommentToParticipants(e Engine, issue *Issue, doer *User, content string, comment *Comment, mentions []string) error {
      tos := make([]string, 0, len(mentions))
      names := make([]string, 0, len(mentions))
      for _, to := range []*User{{Email: "a@example.test", Name: "a"}, {Email: "b@example.test", Name: "b"}} {
          tos = append(tos, to.Email)
          names = append(names, to.Name)
      }

      SendIssueCommentMail(issue, doer, content, comment, tos)

      names = append(names, doer.Name)
      tos = make([]string, 0, len(mentions))
      for i := range mentions {
          if com.IsSliceContainsStr(names, mentions[i]) {
              continue
          }
          tos = append(tos, mentions[i])
      }
      SendIssueMentionMail(issue, doer, content, comment, getUserEmailsByNames(e, tos))
      return nil
  }
  ```

test "rank968: issue notification sends one message per recipient"
  lang go
  profile generic
  file models/issue_mail.go
  reject VYQL-SEC-036
  reject_review code.BulkEmailRecipientDisclosure
  code
  ```
  package models

  import "github.com/Unknwon/com"

  type Engine interface{}
  type Issue struct{}
  type User struct {
      ID int64
      Name string
      Email string
  }
  type Comment struct{}

  func getUserEmailsByNames(e Engine, names []string) []string { return nil }
  func SendIssueCommentMail(issue *Issue, doer *User, content string, comment *Comment, tos []string) {}
  func SendIssueMentionMail(issue *Issue, doer *User, content string, comment *Comment, tos []string) {}

  func mailIssueCommentToParticipants(e Engine, issue *Issue, doer *User, content string, comment *Comment, mentions []string) error {
      tos := make([]string, 0, len(mentions))
      names := make([]string, 0, len(mentions))
      for _, to := range []*User{{Email: "a@example.test", Name: "a"}, {Email: "b@example.test", Name: "b"}} {
          tos = append(tos, to.Email)
          names = append(names, to.Name)
      }

      for _, to := range tos {
          SendIssueCommentMail(issue, doer, content, comment, []string{to})
      }

      names = append(names, doer.Name)
      tos = make([]string, 0, len(mentions))
      for i := range mentions {
          if com.IsSliceContainsStr(names, mentions[i]) {
              continue
          }
          tos = append(tos, mentions[i])
      }

      emails := getUserEmailsByNames(e, tos)
      for _, to := range emails {
          SendIssueMentionMail(issue, doer, content, comment, []string{to})
      }
      return nil
  }
  ```
