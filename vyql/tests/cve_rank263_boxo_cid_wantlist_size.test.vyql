# Rank 263 / CVE-2023-25568: Boxo Bitswap accepted oversized or
# identity CIDs into peer wantlist state and task queues before enforcing
# CID size/type limits.

test "rank263: peer wantlist entries are stored and queued without CID size/type guards"
  lang go
  expect VYQL-DOS-008
  expect_review code.UnboundedProtocolStateByIdentifier
  code
  ```
  package decision

  func (e *Engine) MessageReceived(ctx Context, p Peer, m BitSwapMessage) {
      entries := m.Wantlist()
      wants, cancels := e.splitWantsCancels(entries)
      wants, denials := e.splitWantsDenials(p, wants)

      e.lock.Lock()
      if m.Full() {
          e.peerLedger.ClearPeerWantlist(p)
      }
      s := uint(e.peerLedger.WantlistSizeForPeer(p))
      if wouldBe := s + uint(len(wants)); wouldBe > e.maxQueuedWantlistEntriesPerPeer {
          wants = wants[:e.maxQueuedWantlistEntriesPerPeer]
      }
      for _, entry := range wants {
          e.peerLedger.Wants(p, entry.Entry)
      }
      for _, entry := range cancels {
          if e.peerLedger.CancelWant(p, entry.Cid) {
              e.peerRequestQueue.Remove(entry.Cid, p)
          }
      }
      e.lock.Unlock()

      var activeEntries []Task
      for _, entry := range wants {
          activeEntries = append(activeEntries, Task{Topic: entry.Cid})
      }
      if len(activeEntries) > 0 {
          e.peerRequestQueue.PushTasksTruncated(e.maxQueuedWantlistEntriesPerPeer, p, activeEntries...)
      }
      _ = denials
  }
  ```

test "rank263: peer wantlist entries reject identity and oversized CIDs before state growth"
  lang go
  reject VYQL-DOS-008
  reject_review code.UnboundedProtocolStateByIdentifier
  code
  ```
  package decision

  func (e *Engine) MessageReceived(ctx Context, p Peer, m BitSwapMessage) bool {
      entries := m.Wantlist()
      wants, cancels := e.splitWantsCancels(entries)
      wants, denials := e.splitWantsDenials(p, wants)

      e.lock.Lock()
      if m.Full() {
          e.peerLedger.ClearPeerWantlist(p)
      }
      s := uint(e.peerLedger.WantlistSizeForPeer(p))
      if wouldBe := s + uint(len(wants)); wouldBe > e.maxQueuedWantlistEntriesPerPeer {
          wants = wants[:e.maxQueuedWantlistEntriesPerPeer]
      }

      filteredWants := wants[:0]
      for _, entry := range wants {
          if entry.Cid.Prefix().MhType == mh.IDENTITY {
              e.lock.Unlock()
              return true
          }
          if e.maxCidSize != 0 && uint(entry.Cid.ByteLen()) > e.maxCidSize {
              continue
          }
          e.peerLedger.Wants(p, entry.Entry)
          filteredWants = append(filteredWants, entry)
      }
      wants = filteredWants
      for _, entry := range cancels {
          if entry.Cid.Prefix().MhType == mh.IDENTITY {
              e.lock.Unlock()
              return true
          }
          if e.maxCidSize != 0 && uint(entry.Cid.ByteLen()) > e.maxCidSize {
              continue
          }
          if e.peerLedger.CancelWant(p, entry.Cid) {
              e.peerRequestQueue.Remove(entry.Cid, p)
          }
      }
      e.lock.Unlock()

      var activeEntries []Task
      for _, entry := range wants {
          activeEntries = append(activeEntries, Task{Topic: entry.Cid})
      }
      if len(activeEntries) > 0 {
          e.peerRequestQueue.PushTasksTruncated(e.maxQueuedWantlistEntriesPerPeer, p, activeEntries...)
      }
      _ = denials
      return false
  }
  ```
