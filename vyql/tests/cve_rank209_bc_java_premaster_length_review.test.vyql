test "rank209: TLS RSA premaster decrypt uses unverified length"
  lang java
  expect_review code.PremasterSecretLengthReview
  code
  ```
  import javax.crypto.Cipher;

  class JceDefaultTlsCredentialedDecryptor {
      Object crypto;

      Object safeDecryptPreMasterSecret(Object cryptoParams, Object rsaServerPrivateKey, byte[] encryptedPreMasterSecret) throws Exception {
          byte[] fallback = new byte[48];
          byte[] M = fallback.clone();
          try {
              Cipher c = Cipher.getInstance("RSA");
              c.init(Cipher.DECRYPT_MODE, null);
              M = c.doFinal(encryptedPreMasterSecret);
          } catch (Exception e) {
          }

          int correct = (3 ^ (M[0] & 0xff)) | (3 ^ (M[1] & 0xff));
          int mask = ~((correct & 1) - 1);
          for (int i = 0; i < 48; i++) {
              M[i] = (byte)((M[i] & (~mask)) | (fallback[i] & mask));
          }
          return createSecret(M);
      }

      Object createSecret(byte[] m) { return m; }
  }
  ```

test "rank209: TLS RSA premaster decrypt checks fixed length"
  lang java
  reject_review code.PremasterSecretLengthReview
  code
  ```
  import javax.crypto.Cipher;

  class JceDefaultTlsCredentialedDecryptor {
      Object crypto;

      Object safeDecryptPreMasterSecret(Object cryptoParams, Object rsaServerPrivateKey, byte[] encryptedPreMasterSecret) throws Exception {
          byte[] fallback = new byte[48];
          byte[] M = fallback.clone();
          try {
              Cipher c = Cipher.getInstance("RSA");
              c.init(Cipher.DECRYPT_MODE, null);
              byte[] m = c.doFinal(encryptedPreMasterSecret);
              if (m != null && m.length == 48) {
                  M = m;
              }
          } catch (Exception e) {
          }

          int correct = (3 ^ (M[0] & 0xff)) | (3 ^ (M[1] & 0xff));
          int mask = ~((correct & 1) - 1);
          for (int i = 0; i < 48; i++) {
              M[i] = (byte)((M[i] & (~mask)) | (fallback[i] & mask));
          }
          return createSecret(M);
      }

      Object createSecret(byte[] m) { return m; }
  }
  ```
