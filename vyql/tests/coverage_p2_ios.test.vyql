# P2 entry-point seeding: iOS deep-link URL scheme + WKScriptMessageHandler.

test "swift: iOS deep-link url -> WKWebView loadHTMLString is WebView injection"
  lang swift
  expect VYQL-MOB-001
  code
  ```
  func application(_ app: UIApplication, open url: URL, options: [UIApplication.OpenURLOptionsKey : Any]) -> Bool {
    let s = url.absoluteString
    webView.loadHTMLString(s, baseURL: nil)
    return true
  }
  ```

test "swift: WKScriptMessage body -> evaluateJavaScript is WebView injection"
  lang swift
  expect VYQL-MOB-001
  code
  ```
  func userContentController(_ controller: WKUserContentController, didReceive message: WKScriptMessage) {
    let payload = message.body
    webView.evaluateJavaScript("render(\(payload))")
  }
  ```

test "swift: a constant string to the WebView is clean"
  lang swift
  reject VYQL-MOB-001
  code
  ```
  func application(_ app: UIApplication, open url: URL, options: [UIApplication.OpenURLOptionsKey : Any]) -> Bool {
    webView.loadHTMLString("<h1>Welcome</h1>", baseURL: nil)
    return true
  }
  ```
