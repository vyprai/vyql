# Rank 897 / CVE-2026-45697: Formie Hidden fields evaluated submitted
# front-end values as Twig through Variables::getParsedValue.

test "rank897: formie hidden field evaluates submitted value as Twig"
  lang php
  file Hidden.php
  expect VYQL-INJ-008
  code
  ```
  <?php
  class Hidden extends FormField {
      public string $defaultOption = 'custom';
      public mixed $defaultValue = '';
      public string $handle = 'hidden';

      public function serializeValue(mixed $value, ?ElementInterface $element = null): mixed {
          $value = $_POST['hidden'];

          if ($this->defaultOption === 'custom') {
              if ($value === '') {
                  $value = $this->defaultValue;
              }

              $value = Variables::getParsedValue($value, $element);

              if ($element) {
                  $element->setFieldValue($this->handle, $value);
              }
          }

          return parent::serializeValue($value, $element);
      }
  }
  ```

test "rank897: formie hidden field only evaluates configured default value"
  lang php
  file Hidden.php
  reject VYQL-INJ-008
  code
  ```
  <?php
  class Hidden extends FormField {
      public string $defaultOption = 'custom';
      public mixed $defaultValue = '';
      public string $handle = 'hidden';

      public function serializeValue(mixed $value, ?ElementInterface $element = null): mixed {
          $value = $_POST['hidden'];

          if ($this->defaultOption === 'custom') {
              if ($value === '') {
                  $value = Variables::getParsedValue($this->defaultValue, $element);
              }

              if ($element) {
                  $element->setFieldValue($this->handle, $value);
              }
          }

          return parent::serializeValue($value, $element);
      }
  }
  ```
