# Rank 795 / CVE-2013-10024: WordPress plugin settings saved POST data via
# update_option without a nonce check; the patch added check_admin_referer.

test "rank795: PHP WordPress update_option from POST requires CSRF protection"
  lang php
  file exitpage.php
  expect VYQL-RF-028
  expect_review code.WordPressOptionUpdateMissingCsrf
  code
  ```
  <?php
  function exit_page_admin() {
      if ($_POST['xx']) {
          update_option('exitpagecontents', $_POST['xx']);
          update_option('redirecttoparent', $_POST['redirectpar']);
      }
  }
  ```

test "rank795: PHP WordPress update_option is guarded by check_admin_referer"
  lang php
  file exitpage.php
  reject VYQL-RF-028
  reject_review code.WordPressOptionUpdateMissingCsrf
  code
  ```
  <?php
  function exit_page_admin() {
      if (($_POST['xx']) && is_admin() &&
          check_admin_referer('exit_strategy_save', 'exit_strategy_nonce')) {
          update_option('exitpagecontents', $_POST['xx']);
          update_option('redirecttoparent', $_POST['redirectpar']);
      }
      wp_nonce_field('exit_strategy_save', 'exit_strategy_nonce');
  }
  ```
