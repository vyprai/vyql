# Rank 419 / CVE-2017-8052: Craft CMS TemplatesController allowed direct
# anonymous access to the template rendering action before the /templates
# action segment was denied in beforeAction().

test "rank419: Craft anonymous template render action has no direct-action guard"
  lang php
  file TemplatesController.php
  expect VYQL-INJ-076
  expect_review code.CraftAnonymousTemplateRenderActionXss
  code
  ```
  <?php
  namespace Craft;

  class TemplatesController extends BaseController
  {
      public $allowAnonymous = true;

      public function actionRender($template, array $variables = array())
      {
          if (craft()->templates->doesTemplateExist($template))
          {
              $this->renderTemplate($template, $variables);
          }
          else
          {
              throw new HttpException(404);
          }
      }
  }
  ```

test "rank419: Craft template render controller rejects direct templates action access"
  lang php
  file TemplatesController.php
  reject VYQL-INJ-076
  reject_review code.CraftAnonymousTemplateRenderActionXss
  code
  ```
  <?php
  namespace Craft;

  class TemplatesController extends BaseController
  {
      public $allowAnonymous = true;

      public function beforeAction($action)
      {
          $actionSegments = craft()->request->getActionSegments();
          if (isset($actionSegments[0]) && $actionSegments[0] === 'templates') {
              throw new HttpException(403);
          }

          return parent::beforeAction($action);
      }

      public function actionRender($template, array $variables = array())
      {
          if (craft()->templates->doesTemplateExist($template))
          {
              $this->renderTemplate($template, $variables);
          }
          else
          {
              throw new HttpException(404);
          }
      }
  }
  ```
