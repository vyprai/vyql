# Rank 472 / CVE-2024-32866: Conform parsed nested form keys and wrote
# derived path segments into plain objects without filtering prototype keys.

test "rank472: Conform nested form path writes can pollute prototypes"
  lang javascript
  file formdata.ts
  expect VYQL-INJ-013
  code
  ```
  export function getPaths(name) {
    return name
      .split(/\.|(\[\d*\])/)
      .reduce((result, segment) => {
        if (typeof segment !== 'undefined' && segment !== '') {
          result.push(segment);
        }
        return result;
      }, []);
  }

  export function setValue(target, name, valueFn) {
    const paths = getPaths(name);
    let index = -1;
    let pointer = target;
    while (pointer != null && ++index < paths.length) {
      const key = paths[index];
      const nextKey = paths[index + 1];
      const newValue = index != paths.length - 1
        ? pointer[key] ?? (typeof nextKey === 'number' ? [] : {})
        : valueFn(pointer[key]);
      pointer[key] = newValue;
      pointer = pointer[key];
    }
  }

  function parse(req) {
    const data = {};
    setValue(data, req.body.name, () => 'x');
    return data;
  }
  ```

test "rank472: Conform filters prototype path segments and checks own properties"
  lang javascript
  file formdata.ts
  reject VYQL-INJ-013
  code
  ```
  export function getPaths(name) {
    return name
      .split(/\.|(\[\d*\])/)
      .reduce((result, segment) => {
        if (
          typeof segment !== 'undefined' &&
          segment !== '' &&
          segment !== '__proto__' &&
          segment !== 'constructor' &&
          segment !== 'prototype'
        ) {
          result.push(segment);
        }
        return result;
      }, []);
  }

  export function setValue(target, name, valueFn) {
    const paths = getPaths(name);
    let index = -1;
    let pointer = target;
    while (pointer != null && ++index < paths.length) {
      const key = paths[index];
      const nextKey = paths[index + 1];
      const newValue = index != paths.length - 1
        ? Object.prototype.hasOwnProperty.call(pointer, key)
          ? pointer[key]
          : typeof nextKey === 'number'
          ? []
          : {}
        : valueFn(pointer[key]);
      pointer[key] = newValue;
      pointer = pointer[key];
    }
  }

  function parse(req) {
    const data = {};
    setValue(data, req.body.name, () => 'x');
    return data;
  }
  ```
