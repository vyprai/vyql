# Security misconfiguration (presence / named-value) rules:
#   CFG-002 session fixation (384), CFG-003 permissive CORS (942),
#   CFG-004 cert validation (295), CFG-005 JWT unverified (347),
#   CFG-006 cleartext (319), CFG-007 insecure cookie (614).

# --- Permissive CORS (VYQL-CFG-003) — header name AND "*" (multi-val) ---
test "js: setHeader ACAO * is permissive CORS"
  lang javascript
  expect VYQL-CFG-003
  code
  ```
  app.use((req, res) => { res.setHeader('Access-Control-Allow-Origin', '*'); });
  ```

test "js: a specific CORS origin is fine"
  lang javascript
  reject VYQL-CFG-003
  code
  ```
  app.use((req, res) => { res.setHeader('Access-Control-Allow-Origin', 'https://trusted.com'); });
  ```

test "go: Header().Set ACAO * is permissive CORS"
  lang go
  expect VYQL-CFG-003
  code
  ```
  package p
  import "net/http"
  func h(w http.ResponseWriter) { w.Header().Set("Access-Control-Allow-Origin", "*") }
  ```

test "java: setHeader ACAO * is permissive CORS"
  lang java
  expect VYQL-CFG-003
  code
  ```
  class H { void f(HttpServletResponse r) { r.setHeader("Access-Control-Allow-Origin", "*"); } }
  ```

test "java: a non-CORS header is fine"
  lang java
  reject VYQL-CFG-003
  code
  ```
  class H { void f(HttpServletResponse r) { r.setHeader("Content-Type", "text/html"); } }
  ```

test "python: headers.add ACAO * is permissive CORS"
  lang python
  expect VYQL-CFG-003
  code
  ```
  def view(response):
      response.headers.add("Access-Control-Allow-Origin", "*")
  ```

test "python: flask-cors origins='*' is permissive CORS"
  lang python
  expect VYQL-CFG-003
  code
  ```
  from flask_cors import CORS
  CORS(app, origins="*")
  ```

test "php: header(ACAO: *) is permissive CORS"
  lang php
  expect VYQL-CFG-003
  code
  ```
  <?php header("Access-Control-Allow-Origin: *");
  ```

test "php: a specific CORS origin is fine"
  lang php
  reject VYQL-CFG-003
  code
  ```
  <?php header("Access-Control-Allow-Origin: https://trusted.example");
  ```

# --- Insecure cookie (VYQL-CFG-007) — explicit flag-disable only ---
test "php: setcookie httponly=>false is insecure"
  lang php
  expect VYQL-CFG-007
  code
  ```
  <?php setcookie("sid", $v, ["httponly" => false]);
  ```

test "php: setcookie httponly=>true is fine"
  lang php
  reject VYQL-CFG-007
  code
  ```
  <?php setcookie("sid", $v, ["httponly" => true, "secure" => true]);
  ```

test "java: setHttpOnly(false) is insecure"
  lang java
  expect VYQL-CFG-007
  code
  ```
  class C { void f(Cookie c) { c.setHttpOnly(false); } }
  ```

test "java: setHttpOnly(true) is fine"
  lang java
  reject VYQL-CFG-007
  code
  ```
  class C { void f(Cookie c) { c.setHttpOnly(true); } }
  ```

test "go: http.Cookie HttpOnly:false is insecure"
  lang go
  expect VYQL-CFG-007
  code
  ```
  package p
  import "net/http"
  func h() *http.Cookie { return &http.Cookie{Name: "s", Value: "v", HttpOnly: false} }
  ```

test "go: http.Cookie HttpOnly:true is fine"
  lang go
  reject VYQL-CFG-007
  code
  ```
  package p
  import "net/http"
  func h() *http.Cookie { return &http.Cookie{Name: "s", Value: "v", HttpOnly: true} }
  ```

test "python: set_cookie httponly=False is insecure"
  lang python
  expect VYQL-CFG-007
  code
  ```
  def view(resp, v):
      resp.set_cookie("sid", v, httponly=False)
  ```

test "python: set_cookie httponly=True is fine"
  lang python
  reject VYQL-CFG-007
  code
  ```
  def view(resp, v):
      resp.set_cookie("sid", v, httponly=True)
  ```

test "python: set_cookie with omitted flags is not flagged"
  lang python
  reject VYQL-CFG-007
  code
  ```
  def view(resp, v):
      resp.set_cookie("sid", v)
  ```

test "js: res.cookie httpOnly:false is insecure"
  lang javascript
  expect VYQL-CFG-007
  code
  ```
  app.get('/', (req, res) => { res.cookie('sid', token, {httpOnly: false}); });
  ```

test "js: res.cookie without secure:true is insecure (CWE-614)"
  lang javascript
  expect VYQL-CFG-007
  code
  ```
  app.get('/', (req, res) => { res.cookie('sid', token, {httpOnly: true}); });
  ```

test "js: res.cookie with secure:true is fine"
  lang javascript
  reject VYQL-CFG-007
  code
  ```
  app.get('/', (req, res) => { res.cookie('sid', token, {httpOnly: true, secure: true}); });
  ```

# --- Cert validation disabled (VYQL-CFG-004) ---
test "php: curl VERIFYPEER=>false disables cert validation"
  lang php
  expect VYQL-CFG-004
  code
  ```
  <?php curl_setopt_array($ch, [CURLOPT_SSL_VERIFYPEER => false]);
  ```

test "php: curl VERIFYPEER=>true is fine"
  lang php
  reject VYQL-CFG-004
  code
  ```
  <?php curl_setopt_array($ch, [CURLOPT_SSL_VERIFYPEER => true]);
  ```

test "python: requests verify=False disables cert validation"
  lang python
  expect VYQL-CFG-004
  code
  ```
  import requests
  requests.get("https://x.com", verify=False)
  ```

test "python: requests verify=True is fine"
  lang python
  reject VYQL-CFG-004
  code
  ```
  import requests
  requests.get("https://x.com", verify=True)
  ```

test "python: optional LDAP TLS fallback disables cert validation"
  lang python
  expect VYQL-CFG-004
  code
  ```
  from ldap3 import Server, Tls
  import ssl

  def get_ldap_connection(conf):
      tls_configuration = None
      use_ssl = False
      try:
          cacert = conf.get("ldap", "cacert")
          tls_configuration = Tls(validate=ssl.CERT_REQUIRED, ca_certs_file=cacert)
          use_ssl = True
      except Exception:
          pass
      return Server(conf.get("ldap", "uri"), use_ssl, tls_configuration)
  ```

test "python: required LDAP TLS is clean"
  lang python
  reject VYQL-CFG-004
  code
  ```
  from ldap3 import Server, Tls
  import ssl

  def get_ldap_connection(conf):
      cacert = None
      try:
          cacert = conf.get("ldap", "cacert")
      except Exception:
          pass
      tls_configuration = Tls(validate=ssl.CERT_REQUIRED, ca_certs_file=cacert)
      return Server(conf.get("ldap", "uri"), use_ssl=True, tls=tls_configuration)
  ```

test "js: rejectUnauthorized:false disables cert validation"
  lang javascript
  expect VYQL-CFG-004
  code
  ```
  const https = require('https');
  https.request({hostname: 'x', rejectUnauthorized: false});
  ```

test "js: rejectUnauthorized:true is fine"
  lang javascript
  reject VYQL-CFG-004
  code
  ```
  const https = require('https');
  https.request({hostname: 'x', rejectUnauthorized: true});
  ```

test "go: tls.Config InsecureSkipVerify:true disables cert validation"
  lang go
  expect VYQL-CFG-004
  code
  ```
  package p
  import "crypto/tls"
  func h() *tls.Config { return &tls.Config{InsecureSkipVerify: true} }
  ```

test "go: tls.Config InsecureSkipVerify:false is fine"
  lang go
  reject VYQL-CFG-004
  code
  ```
  package p
  import "crypto/tls"
  func h() *tls.Config { return &tls.Config{InsecureSkipVerify: false} }
  ```

# --- JWT unverified (VYQL-CFG-005) ---
test "php: JWT::decode allowing alg none"
  lang php
  expect VYQL-CFG-005
  code
  ```
  <?php JWT::decode($jwt, $key, ["none"]);
  ```

test "php: JWT::decode with HS256 is fine"
  lang php
  reject VYQL-CFG-005
  code
  ```
  <?php JWT::decode($jwt, $key, ["HS256"]);
  ```

test "ruby: JWT.decode verify=false"
  lang ruby
  expect VYQL-CFG-005
  code
  ```
  JWT.decode(token, nil, false)
  ```

test "ruby: JWT.decode verify=true + HS256 is fine"
  lang ruby
  reject VYQL-CFG-005
  code
  ```
  JWT.decode(token, key, true, { algorithm: "HS256" })
  ```

test "python: jwt.decode algorithms=['none']"
  lang python
  expect VYQL-CFG-005
  code
  ```
  import jwt
  jwt.decode(token, algorithms=["none"])
  ```

test "python: jwt.decode with HS256 is fine"
  lang python
  reject VYQL-CFG-005
  code
  ```
  import jwt
  jwt.decode(token, key, algorithms=["HS256"])
  ```

# --- Cleartext channel (VYQL-CFG-006) — http:// to a client, loopback/https excluded ---
test "php: file_get_contents http:// is cleartext"
  lang php
  expect VYQL-CFG-006
  code
  ```
  <?php file_get_contents("http://insecure.example/api");
  ```

test "php: file_get_contents https:// is fine"
  lang php
  reject VYQL-CFG-006
  code
  ```
  <?php file_get_contents("https://secure.example/api");
  ```

test "php: file_get_contents loopback is excluded"
  lang php
  reject VYQL-CFG-006
  code
  ```
  <?php file_get_contents("http://127.0.0.1/api");
  ```

test "ruby: HTTParty.get http:// is cleartext"
  lang ruby
  expect VYQL-CFG-006
  code
  ```
  HTTParty.get("http://insecure.example/api")
  ```

test "ruby: HTTParty.get https:// is fine"
  lang ruby
  reject VYQL-CFG-006
  code
  ```
  HTTParty.get("https://secure.example/api")
  ```

test "csharp: DownloadString http:// is cleartext"
  lang csharp
  expect VYQL-CFG-006
  code
  ```
  class C { void F() { client.DownloadString("http://insecure.example/api"); } }
  ```

test "csharp: DownloadString https:// is fine"
  lang csharp
  reject VYQL-CFG-006
  code
  ```
  class C { void F() { client.DownloadString("https://secure.example/api"); } }
  ```

test "java: new URL http:// is cleartext"
  lang java
  expect VYQL-CFG-006
  code
  ```
  class H { void f() { new java.net.URL("http://insecure.example/api"); } }
  ```

test "java: new URL https:// is fine"
  lang java
  reject VYQL-CFG-006
  code
  ```
  class H { void f() { new java.net.URL("https://secure.example/api"); } }
  ```

test "go: http.Get http:// is cleartext"
  lang go
  expect VYQL-CFG-006
  code
  ```
  package p
  import "net/http"
  func h() { http.Get("http://insecure.example/api") }
  ```

test "go: http.Get https:// is fine"
  lang go
  reject VYQL-CFG-006
  code
  ```
  package p
  import "net/http"
  func h() { http.Get("https://secure.example/api") }
  ```

test "python: requests.get http:// is cleartext"
  lang python
  expect VYQL-CFG-006
  code
  ```
  import requests
  requests.get("http://insecure.example/api")
  ```

test "python: requests.get https:// is fine"
  lang python
  reject VYQL-CFG-006
  code
  ```
  import requests
  requests.get("https://secure.example/api")
  ```

# --- CSRF disabled (VYQL-CFG-001) ---
test "java: http.csrf().disable() disables CSRF protection"
  lang java
  expect VYQL-CFG-001
  code
  ```
  class Sec {
    void configure(HttpSecurity http) throws Exception {
      http.csrf().disable();
    }
  }
  ```

test "java: http.csrf().enable() is fine"
  lang java
  reject VYQL-CFG-001
  code
  ```
  class Sec {
    void configure(HttpSecurity http) throws Exception {
      http.csrf().enable();
    }
  }
  ```

# --- Session fixation (VYQL-CFG-002) ---
test "php: user-controlled session id is session fixation"
  lang php
  expect VYQL-CFG-002
  code
  ```
  <?php session_id($_GET['sid']);
  ```

test "php: a constant session id is fine"
  lang php
  reject VYQL-CFG-002
  code
  ```
  <?php session_id("fixed-value");
  ```
