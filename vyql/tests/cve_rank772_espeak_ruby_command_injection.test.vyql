# Rank 772 / CVE-2016-10193: espeak-ruby built shell strings from
# text/options/filename and executed them via system/Open3.capture3.

test "rank772: espeak ruby shell string reaches system and Open3"
  lang ruby
  profile library
  file speech.rb
  expect VYQL-INJ-002
  code
  ```
  require 'open3'

  module ESpeak
    class Speech
      attr_reader :options, :text

      def initialize(text, options={})
        @text = text
        @options = options
      end

      def speak
        system(espeak_command(command_options))
      end

      def save(filename)
        system(espeak_command(command_options, "--stdout") + " | " + lame_command(filename, command_options))
      end

      def bytes
        stdout_str, stderr_str, process = Open3.capture3(espeak_command(command_options, "--stdout") + " | " + std_lame_command(command_options))
        stdout_str
      end

      def bytes_wav
        stdout_str, stderr_str, process = Open3.capture3(espeak_command(command_options, "--stdout"))
        stdout_str
      end

      def sanitized_text
        @text.gsub(/(!|\?|"|`|\\)/, ' ').strip
      end

      private

      def command_options
        default_options.merge(symbolize_keys(options))
      end

      def default_options
        { :voice => 'en',
          :pitch => 50,
          :speed => 170,
          :capital => 1,
          :quiet => true }
      end

      def espeak_command(options, flags="")
        %|espeak "#{sanitized_text}" #{flags} -v#{options[:voice]} -p#{options[:pitch]} -k#{options[:capital]} -s#{options[:speed]}|
      end

      def std_lame_command(options)
        lame_command("-", options)
      end

      def lame_command(filename, options)
        "lame -V2 - #{filename} #{'--quiet' if options[:quiet] == true}"
      end

      def symbolize_keys(hash)
        hash.inject({}) do |options, (key, value)|
          options[(key.to_sym rescue key) || key] = value
          options
        end
      end
    end
  end
  ```

test "rank772: espeak ruby uses argv arrays and process stdin"
  lang ruby
  profile library
  file speech.rb
  reject VYQL-INJ-002
  code
  ```
  module ESpeak
    class Speech
      attr_reader :options, :text

      def initialize(text, options={})
        @text = text
        @options = options
      end

      def speak
        IO.popen(espeak_command(command_options), 'r').read
      end

      def save(filename)
        speech = bytes_wav
        res = IO.popen(lame_command(filename, command_options), 'r+') do |process|
          process.write(speech)
          process.close_write
          process.read
        end
        res.to_s
      end

      def bytes
        speech = bytes_wav
        res = IO.popen(std_lame_command(command_options), 'r+') do |process|
          process.write(speech)
          process.close_write
          process.read
        end
        res.to_s
      end

      def bytes_wav
        IO.popen(espeak_command(command_options, "--stdout"), 'r').read
      end

      private

      def command_options
        default_options.merge(symbolize_keys(options))
      end

      def default_options
        { :voice => 'en',
          :pitch => 50,
          :speed => 170,
          :capital => 1,
          :quiet => true }
      end

      def espeak_command(options, flags="")
        ['espeak', "#{@text}", "#{flags}", "-v#{options[:voice]}", "-p#{options[:pitch]}", "-k#{options[:capital]}", "-s#{options[:speed]}"]
      end

      def std_lame_command(options)
        lame_command("-", options)
      end

      def lame_command(filename, options)
        ['lame', '-V2', '-', "#{filename}", "#{'--quiet' if options[:quiet] == true}"]
      end

      def symbolize_keys(hash)
        hash.inject({}) do |options, (key, value)|
          options[(key.to_sym rescue key) || key] = value
          options
        end
      end
    end
  end
  ```
