# File-type ZIP parser coverage: older manual ZIP entry reads sized from
# zipHeader.compressedSize are still a useful DOS mechanic, but this is not the
# direct expected rule for the current rank 853 repository snapshot.

test "file-type: ZIP mimetype read is sized by compressed ZIP header"
  lang javascript
  file core.js
  expect VYQL-DOS-031
  expect_review code.ZipEntryCompressedSizeTokenRead
  code
  ```
  import * as Token from 'token-types';

  export class FileTypeParser {
    async parse(tokenizer) {
      const zipHeader = {
        compressedSize: 0,
        uncompressedSize: 0,
        filenameLength: 0,
        extraFieldLength: 0,
      };

      if (zipHeader.filename === 'mimetype' && zipHeader.compressedSize === zipHeader.uncompressedSize) {
        let mimeType = await tokenizer.readToken(new Token.StringType(zipHeader.compressedSize, 'utf-8'));
        mimeType = mimeType.trim();
        return mimeType;
      }
    }
  }
  ```

test "file-type: ZIP handler delegates bounded entry reads"
  lang javascript
  file core.js
  reject VYQL-DOS-031
  reject_review code.ZipEntryCompressedSizeTokenRead
  code
  ```
  import {ZipHandler} from '@tokenizer/inflate';

  export class FileTypeParser {
    async parse(tokenizer) {
      let fileType;
      await new ZipHandler(tokenizer).unzip(zipHeader => {
        if (zipHeader.filename === 'mimetype') {
          return {
            async handler(fileData) {
              const mimeType = new TextDecoder('utf-8').decode(fileData).trim();
              fileType = mimeType;
            },
            stop: true,
          };
        }

        return {};
      });

      return fileType ?? {ext: 'zip', mime: 'application/zip'};
    }
  }
  ```
