# Rank 773 / CVE-2021-41104: ESPHome applied web-server auth in the
# high-level request handler but registered OTA uploads through a shared base
# handler list that was not wrapped by the auth check.

test "rank773: raw shared OTA handler registry lacks auth middleware"
  lang cpp
  file web_server_base.h
  expect VYQL-AUTH-051
  code
  ```
  #include <ESPAsyncWebServer.h>

  class WebServerBase {
   public:
    void add_handler(AsyncWebHandler *handler) {
      this->handlers_.push_back(handler);
      if (this->server_ != nullptr)
        this->server_->addHandler(handler);
    }

    void add_ota_handler();

   protected:
    std::shared_ptr<AsyncWebServer> server_{nullptr};
    std::vector<AsyncWebHandler *> handlers_;
  };

  class OTARequestHandler : public AsyncWebHandler {
   public:
    void handleRequest(AsyncWebServerRequest *request) override;
    void handleUpload(AsyncWebServerRequest *request, const String &filename, size_t index, uint8_t *data, size_t len,
                      bool final) override;
    bool canHandle(AsyncWebServerRequest *request) override {
      return request->url() == "/update" && request->method() == HTTP_POST;
    }
  };
  ```

test "rank773: shared OTA handler registry is wrapped by auth middleware"
  lang cpp
  file web_server_base.h
  reject VYQL-AUTH-051
  code
  ```
  #include <ESPAsyncWebServer.h>

  namespace internal {
  struct Credentials {
    std::string username;
    std::string password;
  };

  class AuthMiddlewareHandler : public AsyncWebHandler {
   public:
    bool check_auth(AsyncWebServerRequest *request) {
      bool success = request->authenticate(credentials_->username.c_str(), credentials_->password.c_str());
      if (!success)
        request->requestAuthentication();
      return success;
    }

   protected:
    Credentials *credentials_;
  };
  }  // namespace internal

  class WebServerBase {
   public:
    void set_auth_username(std::string auth_username) { credentials_.username = auth_username; }
    void set_auth_password(std::string auth_password) { credentials_.password = auth_password; }
    void add_handler(AsyncWebHandler *handler);
    void add_ota_handler();

   protected:
    std::shared_ptr<AsyncWebServer> server_{nullptr};
    std::vector<AsyncWebHandler *> handlers_;
    internal::Credentials credentials_;
  };

  class OTARequestHandler : public AsyncWebHandler {
   public:
    void handleRequest(AsyncWebServerRequest *request) override;
    void handleUpload(AsyncWebServerRequest *request, const String &filename, size_t index, uint8_t *data, size_t len,
                      bool final) override;
    bool canHandle(AsyncWebServerRequest *request) override {
      return request->url() == "/update" && request->method() == HTTP_POST;
    }
  };
  ```

test "rank773: shared OTA handler registry generalizes across names"
  lang cpp
  file web_server_base.h
  expect VYQL-AUTH-051
  code
  ```
  class AsyncWebHandler {};
  class AsyncWebServerRequest {};

  class DeviceWeb {
   public:
    void add_handler(AsyncWebHandler *next_handler) {
      active_handlers.push_back(next_handler);
    }

   private:
    std::vector<AsyncWebHandler *> active_handlers;
  };

  class OTARequestHandler : public AsyncWebHandler {
   public:
    void handleUpload(AsyncWebServerRequest *request, const String &filename, size_t index, uint8_t *data, size_t len,
                      bool final);
  };
  ```
