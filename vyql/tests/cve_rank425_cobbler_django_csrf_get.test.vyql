# Rank 425 / CVE-2011-4952: Cobbler Django web UI state-changing actions
# were reachable through GET links before require_POST hardening.

test "rank425: Cobbler sync action lacks require_POST"
  lang python
  file views.py
  expect VYQL-RF-017
  expect_review code.CobblerDjangoStateChangeGetCsrf
  code
  ```
  from django.views.decorators.csrf import csrf_protect
  from django.http import HttpResponseRedirect

  @csrf_protect
  def sync(request):
      if not test_user_authenticated(request):
          return login(request, next="/cobbler_web/sync")
      remote.background_sync({"verbose": "True"}, request.session["token"])
      return HttpResponseRedirect("/cobbler_web/task_created")
  ```

test "rank425: Cobbler sync action requires POST"
  lang python
  file views.py
  reject VYQL-RF-017
  reject_review code.CobblerDjangoStateChangeGetCsrf
  code
  ```
  from django.views.decorators.csrf import csrf_protect
  from django.views.decorators.http import require_POST
  from django.http import HttpResponseRedirect

  @require_POST
  @csrf_protect
  def sync(request):
      if not test_user_authenticated(request):
          return login(request, next="/cobbler_web/sync")
      remote.background_sync({"verbose": "True"}, request.session["token"])
      return HttpResponseRedirect("/cobbler_web/task_created")
  ```
