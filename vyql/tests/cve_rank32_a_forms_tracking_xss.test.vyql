# Rank 32 / CVE-2013-10020: a-forms stored tracking-content XSS.
# Ledger verification: VYQL-INJ-004 catches the vulnerable tracking output.

test "rank32: a-forms renders tracking content without escaping"
  lang php
  expect VYQL-INJ-004
  code
  ```
  <?php
  $tracking = $_POST["tracking"];
  echo "<div class='tracking'>" . $tracking . "</div>";
  ?>
  ```

test "rank32: a-forms escapes tracking content"
  lang php
  reject VYQL-INJ-004
  code
  ```
  <?php
  $tracking = $_POST["tracking"];
  echo "<div class='tracking'>" . htmlspecialchars($tracking, ENT_QUOTES, "UTF-8") . "</div>";
  ?>
  ```
