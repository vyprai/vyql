# Rank 248 / CVE-2020-27153: BlueZ could reenter bt_att_cancel while
# disconnect_cb owned queue cleanup, causing request callbacks to use/free stale
# ATT client state. The fix adds an in-disc path that cancels callbacks without
# removing/freeing queue entries being cleaned by disconnect_cb.

test "rank248: ATT cancel removes queued ops during disconnect cleanup without guard"
  lang c
  expect VYQL-MEM-019
  expect_review code.ReentrantQueueCleanupReview
  code
  ```
  struct bt_att {
    void *req_queue;
    void *ind_queue;
    void *write_queue;
  };

  void *UINT_TO_PTR(unsigned int id);
  void *queue_remove_if(void *queue, int (*match)(void), void *id);
  void destroy_att_send_op(void *op);
  void wakeup_writer(struct bt_att *att);
  int match_op_id(void);

  int bt_att_cancel(struct bt_att *att, unsigned int id)
  {
    void *op;

    op = queue_remove_if(att->req_queue, match_op_id, UINT_TO_PTR(id));
    if (op)
      goto done;

    op = queue_remove_if(att->ind_queue, match_op_id, UINT_TO_PTR(id));
    if (op)
      goto done;

    op = queue_remove_if(att->write_queue, match_op_id, UINT_TO_PTR(id));
    if (op)
      goto done;

    return 0;

  done:
    destroy_att_send_op(op);
    wakeup_writer(att);
    return 1;
  }
  ```

test "rank248: reentrant queue cleanup generalizes across names"
  lang c
  expect VYQL-MEM-019
  expect_review code.ReentrantQueueCleanupReview
  code
  ```
  void *queue_remove_if(void *queue, int (*match)(void), void *id);
  void destroy_att_send_op(void *op);
  int match_id(void);

  int cancel_pending(struct session *state, unsigned int key) {
    void *entry;
    entry = queue_remove_if(state->requests, match_id, &key);
    if (!entry) entry = queue_remove_if(state->indications, match_id, &key);
    if (!entry) entry = queue_remove_if(state->writes, match_id, &key);
    if (entry) {
      destroy_att_send_op(entry);
      return 1;
    }
    return 0;
  }
  ```

test "rank248: ATT cancel uses disconnect cleanup diversion before queue removal"
  lang c
  reject VYQL-MEM-019
  reject_review code.ReentrantQueueCleanupReview
  code
  ```
  struct bt_att {
    int in_disc;
    void *req_queue;
    void *ind_queue;
    void *write_queue;
  };

  void *UINT_TO_PTR(unsigned int id);
  void *queue_remove_if(void *queue, int (*match)(void), void *id);
  void destroy_att_send_op(void *op);
  void wakeup_writer(struct bt_att *att);
  int match_op_id(void);
  int bt_att_disc_cancel(struct bt_att *att, unsigned int id);

  int bt_att_cancel(struct bt_att *att, unsigned int id)
  {
    void *op;

    if (att->in_disc)
      return bt_att_disc_cancel(att, id);

    op = queue_remove_if(att->req_queue, match_op_id, UINT_TO_PTR(id));
    if (op)
      goto done;

    op = queue_remove_if(att->ind_queue, match_op_id, UINT_TO_PTR(id));
    if (op)
      goto done;

    op = queue_remove_if(att->write_queue, match_op_id, UINT_TO_PTR(id));
    if (op)
      goto done;

    return 0;

  done:
    destroy_att_send_op(op);
    wakeup_writer(att);
    return 1;
  }
  ```
