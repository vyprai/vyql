# Rank 899 / CVE-2023-25166: @sideway/formula used an ambiguous numeric
# regex while parsing formula tokens, allowing excessive backtracking.

test "rank899: formula numeric regex has ambiguous optional decimal"
  lang javascript
  file index.js
  expect VYQL-DOS-003
  expect_review code.CatastrophicRegex
  code
  ```
  'use strict';

  const internals = {
    numberRx: /^(?:[0-9]*\.?[0-9]*){1}$/
  };

  exports.Parser = class {
    _parse(string) {
      let current = '';

      const flush = () => {
        if (current.match(internals.numberRx)) {
          return parseFloat(current);
        }
      };

      for (const c of string) {
        current += c;
      }

      return flush();
    }
  };
  ```

test "rank899: formula numeric regex separates optional decimal group"
  lang javascript
  file index.js
  reject VYQL-DOS-003
  reject_review code.CatastrophicRegex
  code
  ```
  'use strict';

  const internals = {
    numberRx: /^(?:[0-9]*(\.[0-9]*)?){1}$/
  };

  exports.Parser = class {
    _parse(string) {
      let current = '';

      const flush = () => {
        if (current.match(internals.numberRx)) {
          return parseFloat(current);
        }
      };

      for (const c of string) {
        current += c;
      }

      return flush();
    }
  };
  ```
