test "rank356: Ruby CGI escape_html multiplies input length before checked allocation"
  lang c
  expect VYQL-NUM-009
  expect_review code.RubyCgiEscapeHtmlLengthOverflow
  code
  ```
  #define HTML_ESCAPE_MAX_LEN 6
  typedef unsigned long VALUE;
  long RSTRING_LEN(VALUE str);
  char *RSTRING_PTR(VALUE str);
  char *ALLOCV_N(char kind, VALUE vbuf, long size);
  void ALLOCV_END(VALUE vbuf);

  static VALUE optimized_escape_html(VALUE str) {
    VALUE vbuf;
    char *buf = ALLOCV_N(char, vbuf, RSTRING_LEN(str) * HTML_ESCAPE_MAX_LEN);
    const char *cstr = RSTRING_PTR(str);
    const char *end = cstr + RSTRING_LEN(str);
    char *dest = buf;
    while (cstr < end) {
      *dest++ = *cstr++;
    }
    ALLOCV_END(vbuf);
    return str;
  }
  ```

test "rank356: Ruby CGI escape_html uses array element type so allocator checks element count"
  lang c
  reject VYQL-NUM-009
  reject_review code.RubyCgiEscapeHtmlLengthOverflow
  code
  ```
  #define HTML_ESCAPE_MAX_LEN 6
  typedef unsigned long VALUE;
  long RSTRING_LEN(VALUE str);
  char *RSTRING_PTR(VALUE str);
  char *ALLOCV_N(void *kind, VALUE vbuf, long size);
  void ALLOCV_END(VALUE vbuf);

  static VALUE optimized_escape_html(VALUE str) {
    VALUE vbuf;
    typedef char escape_buf[HTML_ESCAPE_MAX_LEN];
    char *buf = *ALLOCV_N(escape_buf, vbuf, RSTRING_LEN(str));
    const char *cstr = RSTRING_PTR(str);
    const char *end = cstr + RSTRING_LEN(str);
    char *dest = buf;
    while (cstr < end) {
      *dest++ = *cstr++;
    }
    ALLOCV_END(vbuf);
    return str;
  }
  ```

test "rank356: Ruby CGI escape allocation generalizes across names"
  lang c
  expect VYQL-NUM-009
  expect_review code.RubyCgiEscapeHtmlLengthOverflow
  code
  ```
  #define HTML_ESCAPE_MAX_LEN 6
  typedef unsigned long VALUE;
  long RSTRING_LEN(VALUE obj);
  char *RSTRING_PTR(VALUE obj);
  char *ALLOCV_N(char kind, VALUE storage, long size);
  void ALLOCV_END(VALUE storage);

  static VALUE render_safe_html(VALUE source) {
    VALUE scratch;
    char *buffer = ALLOCV_N(char, scratch, RSTRING_LEN(source) * HTML_ESCAPE_MAX_LEN);
    const char *cursor = RSTRING_PTR(source);
    const char *limit = cursor + RSTRING_LEN(source);
    char *write = buffer;
    while (cursor < limit) {
      *write++ = *cursor++;
    }
    ALLOCV_END(scratch);
    return source;
  }
  ```
