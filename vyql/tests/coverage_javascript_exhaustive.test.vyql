test "javascript exhaustive: request input reaches SQL command code-eval and dynamic-load sinks"
  lang javascript
  expect VYQL-INJ-001
  expect VYQL-INJ-002
  expect VYQL-INJ-003
  expect VYQL-INJ-023
  code
  ```
  function handler(req, db) {
    const q = req.query.q;
    const cmd = req.query.cmd;
    const mod = req.query.module;
    db.query(q);
    sequelize.query(q);
    child_process.exec(cmd);
    child_process.spawn("sh", ["-c", cmd]);
    eval(q);
    Function(q)();
    vm.runInNewContext(q);
    require(mod);
    import(mod);
  }
  ```

