  code
  ```
  function handler(req, res, zip) {
    const v = req.query.v;
    serialize.unserialize(v);
    yaml.load(v);
    axios.get(v);
    fetch(v);
    res.redirect(v);
    fs.readFile(v, () => {});
    fs.writeFile(v, req.body.data, () => {});
    zip.extractEntryTo(v, "/tmp", false, true);
  }
  ```

