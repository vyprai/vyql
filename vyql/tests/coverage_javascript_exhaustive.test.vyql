test "javascript exhaustive: LDAP XPath regex trust-boundary auth IDOR and CSRF findings are reported"
  lang javascript
  expect VYQL-INJ-005
  expect VYQL-INJ-006
  expect VYQL-DOS-001
  expect VYQL-CFG-014
  expect VYQL-AUTH-001
  expect VYQL-AUTH-002
  expect VYQL-RF-003
  code
  ```
  function handler(req, client, xpath, repo) {
    const v = req.query.v;
    client.search("dc=x", {filter: v}, () => {});
    xpath.select(v, doc);
    new RegExp(v);
    req.session.role = v;
    changePassword(v);
    repo.findUserById(req.params.id);
    transferFunds(v);
  }
  ```

test "javascript exhaustive: validation guards suppress trust auth IDOR and constant CSRF flow is clean"
  lang javascript
  reject VYQL-DOS-001
  reject VYQL-CFG-014
  reject VYQL-AUTH-001
  reject VYQL-AUTH-002
  reject VYQL-RF-003
  code
  ```
  function handler(req, repo) {
    const v = validator.isAlphanumeric(req.query.v) ? req.query.v : "guest";
    new RegExp("^[a-z]+$");
    req.session.role = Number(req.query.role);
    requireAuth(req);
    changePassword("system");
    checkOwnership(req.params.id);
    repo.findUserById(req.params.id);
    transferFunds("system");
  }
  ```

test "javascript exhaustive: crypto config cleartext electron package and resource findings are reported"
  lang javascript
  expect VYQL-CRY-001
  expect VYQL-CRY-002
  expect VYQL-CRY-003
  expect VYQL-CRY-004
  expect VYQL-CFG-001
  expect VYQL-CFG-003
  expect VYQL-CFG-004
  expect VYQL-CFG-005
  expect VYQL-CFG-006
  expect VYQL-CFG-007
  expect VYQL-CFG-009
  expect VYQL-DSK-001
  expect VYQL-INJ-019
  expect VYQL-RES-001
  code
  ```
  function handler(res) {
    crypto.createHash("md5");
    crypto.createCipheriv("aes-128-cbc", key, "0000000000000000");
    Math.random();
    lusca.csrf(false);
    https.request("https://example.com", {rejectUnauthorized: false});
    jwt.verify(token, key, {algorithms: ["none"]});
    axios.get("http://example.com");
    res.cookie("sid", "1", {httpOnly: false});
    res.setHeader("Access-Control-Allow-Origin", "*");
    res.setHeader("X-Frame-Options", "ALLOWALL");
    new BrowserWindow({webPreferences: {nodeIntegration: true, contextIsolation: false}});
    child_process.spawnSync("npm", ["install"]);
    const fd = fs.openSync("data.txt", "r");
  }
  ```

test "javascript exhaustive: stronger crypto secure config localhost and closed resources are clean"
  lang javascript
  reject VYQL-CRY-001
  reject VYQL-CRY-002
  reject VYQL-CRY-003
  reject VYQL-CRY-004
  reject VYQL-CFG-001
  reject VYQL-CFG-003
  reject VYQL-CFG-004
  reject VYQL-CFG-005
  reject VYQL-CFG-006
  reject VYQL-CFG-007
  reject VYQL-CFG-009
  reject VYQL-DSK-001
  reject VYQL-INJ-019
  reject VYQL-RES-001
  code
  ```
  function handler(res) {
    crypto.createHash("sha256");
    crypto.createCipheriv("aes-256-gcm", key, iv);
    crypto.randomBytes(16);
    lusca.csrf(true);
    https.request("https://example.com", {rejectUnauthorized: true});
    jwt.verify(token, key, {algorithms: ["RS256"]});
    axios.get("http://127.0.0.1:8080");
    res.cookie("sid", "1", {httpOnly: true, secure: true});
    res.setHeader("Access-Control-Allow-Origin", "https://example.com");
    res.setHeader("X-Frame-Options", "DENY");
    new BrowserWindow({webPreferences: {nodeIntegration: false, contextIsolation: true}});
    child_process.spawnSync("npm", ["--version"]);
    const fd = fs.openSync("data.txt", "r");
    fs.closeSync(fd);
  }
  ```
