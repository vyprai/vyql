test "rank992 javascript: glob-parent enclosure regex is catastrophic"
  lang javascript
  profile library
  expect VYQL-DOS-003
  expect_review code.CatastrophicRegex
  code
  ```
  var slash = '/';
  var enclosure = /[\{\[].*[\/]*.*[\}\]]$/;

  module.exports = function globParent(str) {
    if (enclosure.test(str)) {
      str += slash;
    }
    return str;
  };
  ```

test "rank992 javascript: glob-parent enclosure regex without slash ambiguity is clean"
  lang javascript
  profile library
  reject VYQL-DOS-003
  reject_review code.CatastrophicRegex
  code
  ```
  var slash = '/';
  var enclosure = /[\{\[].*[\}\]]$/;

  module.exports = function globParent(str) {
    if (enclosure.test(str)) {
      str += slash;
    }
    return str;
  };
  ```
