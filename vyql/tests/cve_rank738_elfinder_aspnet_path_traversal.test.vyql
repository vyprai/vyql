test "rank738: elFinder.AspNet extracts archive entries without root containment"
  lang csharp
  file FileSystemDriver.cs
  expect VYQL-PATH-037
  expect_review code.DotNetArchiveOrRenamePathTraversal
  code
  ```
  using System.IO;
  using System.IO.Compression;

  public class FileSystemDriver {
    public async Task ExtractAsync(string rootPath, string archivePath) {
      using (var archive = ZipFile.OpenRead(archivePath)) {
        string separator = Path.DirectorySeparatorChar.ToString();
        foreach (ZipArchiveEntry entry in archive.Entries) {
          string file = Path.Combine(rootPath, entry.FullName)
            .Replace("/", separator).Replace("\\", separator);
          entry.ExtractToFile(file, true);
        }
      }
    }
  }
  ```

test "rank738: elFinder.AspNet contains archive entries under root"
  lang csharp
  file FileSystemDriver.cs
  reject VYQL-PATH-037
  reject_review code.DotNetArchiveOrRenamePathTraversal
  code
  ```
  using System;
  using System.IO;
  using System.IO.Compression;

  public class FileSystemDriver {
    public async Task ExtractAsync(string rootPath, string archivePath) {
      using (var archive = ZipFile.OpenRead(archivePath)) {
        string separator = Path.DirectorySeparatorChar.ToString();
        foreach (ZipArchiveEntry entry in archive.Entries) {
          string file = Path.Combine(rootPath, entry.FullName)
            .Replace("/", separator).Replace("\\", separator);
          string destPath = Path.GetFullPath(file);
          if (!destPath.StartsWith(rootPath, StringComparison.OrdinalIgnoreCase)) {
            throw new NotSupportedException();
          }
          entry.ExtractToFile(file, true);
        }
      }
    }
  }
  ```

test "rank738: elFinder.AspNet renames paths without root containment"
  lang csharp
  file FileSystemDriver.cs
  expect VYQL-PATH-037
  code
  ```
  using System.IO;

  public class FileSystemDriver {
    public async Task RenameAsync(FullPath path, string name) {
      if (path.IsDirectory) {
        var newPath = new FileSystemDirectory(Path.Combine(path.Directory.Parent.FullName, name));
        Directory.Move(path.Directory.FullName, newPath.FullName);
      } else {
        var newPath = new FileSystemFile(Path.Combine(path.File.DirectoryName, name));
        File.Move(path.File.FullName, newPath.FullName);
      }
    }
  }
  ```

test "rank738: elFinder.AspNet contains rename targets under root"
  lang csharp
  file FileSystemDriver.cs
  reject VYQL-PATH-037
  reject_review code.DotNetArchiveOrRenamePathTraversal
  code
  ```
  using System;
  using System.IO;

  public class FileSystemDriver {
    public async Task RenameAsync(FullPath path, string name) {
      if (path.IsDirectory) {
        var newPath = new FileSystemDirectory(Path.Combine(path.Directory.Parent.FullName, name));
        string destPath = Path.GetFullPath(newPath.FullName);
        if (!destPath.StartsWith(path.RootVolume.RootDirectory, StringComparison.OrdinalIgnoreCase)) {
          throw new NotSupportedException();
        }
        Directory.Move(path.Directory.FullName, newPath.FullName);
      } else {
        var newPath = new FileSystemFile(Path.Combine(path.File.DirectoryName, name));
        string destPath = Path.GetFullPath(newPath.FullName);
        if (!destPath.StartsWith(path.RootVolume.RootDirectory, StringComparison.OrdinalIgnoreCase)) {
          throw new NotSupportedException();
        }
        File.Move(path.File.FullName, newPath.FullName);
      }
    }
  }
  ```
