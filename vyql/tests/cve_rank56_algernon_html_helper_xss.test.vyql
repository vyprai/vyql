# Rank 56 / CVE-2025-65754: Algernon HTML helper XSS.
# Fresh scan evidence includes VYQL-INJ-004 on the raw HTML helper path.

test "rank56: Algernon returns request-selected raw HTML"
  lang go
  expect VYQL-INJ-004
  code
  ```
  package p

  import (
    "fmt"
    "github.com/gin-gonic/gin"
  )

  func html(ctx *gin.Context) {
    body := ctx.Param("html")
    page := fmt.Sprintf("<main>%s</main>", body)
    ctx.Writer.WriteString(page)
  }
  ```

test "rank56: Algernon escapes helper HTML"
  lang go
  reject VYQL-INJ-004
  code
  ```
  package p

  import (
    "fmt"
    "github.com/gin-gonic/gin"
  )

  func htmlHelper(ctx *gin.Context) {
    body := ctx.Param("html")
    page := fmt.Sprintf("<main>%s</main>", body)
    ctx.Header("content-type", "image/png")
    ctx.Writer.WriteString(page)
  }
  ```
