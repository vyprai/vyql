# Rank 559 / CVE-2023-46739: CubeFS compared stored and supplied passwords
# with ordinary string inequality, leaking observable timing differences.

test "rank559: cubefs raw password field comparison needs constant-time review"
  lang go
  expect VYQL-CRY-006
  expect_review code.SecretComparisonReview
  code
  ```
  package master

  import "fmt"

  type accessKey struct {
    Password string
  }

  type validatePasswordArgs struct {
    Password string
    UserID   string
  }

  func validatePassword(ak accessKey, args validatePasswordArgs) error {
    if ak.Password != args.Password {
      return fmt.Errorf("user or password has err")
    }
    return nil
  }
  ```

test "rank559: cubefs hash-derived password strings are clean"
  lang go
  reject VYQL-CRY-006
  reject_review code.SecretComparisonReview
  code
  ```
  package master

  import (
    "crypto/sha256"
    "encoding/hex"
    "fmt"
  )

  type accessKey struct {
    Password string
  }

  type validatePasswordArgs struct {
    Password string
    UserID   string
  }

  func validatePassword(ak accessKey, args validatePasswordArgs) error {
    hashedPassword := sha256.Sum256([]byte(args.Password))
    hashedPasswordStr := hex.EncodeToString(hashedPassword[:])
    hashedPassword_ := sha256.Sum256([]byte(ak.Password))
    hashedPasswordStr_ := hex.EncodeToString(hashedPassword_[:])

    if hashedPasswordStr != hashedPasswordStr_ {
      return fmt.Errorf("user or password has err")
    }
    return nil
  }
  ```
