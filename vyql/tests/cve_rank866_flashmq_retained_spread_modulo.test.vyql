test "rank866: random retained-message spread modulo lacks zero guard"
  lang cpp
  expect VYQL-NUM-015
  expect_review code.RandomSpreadModuloZeroDenominator
  code
  ```
  namespace std { namespace chrono {
  struct milliseconds {
      long count() const;
  };
  struct steady_clock {
      static milliseconds now();
  };
  }}
  struct Settings {
      std::chrono::milliseconds setRetainedMessageDeferTimeout;
      std::chrono::milliseconds setRetainedMessageDeferTimeoutSpread;
  };
  struct ThreadData {
      long randomish();
      void queueSettingRetainedMessage(int, int, std::chrono::milliseconds);
  };
  void trySetRetainedMessages(Settings *settings, ThreadData *td) {
      const std::chrono::milliseconds spread(td->randomish() % settings->setRetainedMessageDeferTimeoutSpread.count());
      auto limit = std::chrono::steady_clock::now() + settings->setRetainedMessageDeferTimeout + spread;
      td->queueSettingRetainedMessage(1, 2, limit);
  }
  ```

test "rank866: zero spread guard suppresses random modulo denominator finding"
  lang cpp
  reject VYQL-NUM-015
  code
  ```
  namespace std { namespace chrono {
  struct milliseconds {
      static milliseconds zero();
      long count() const;
      milliseconds operator+(milliseconds) const;
      bool operator!=(milliseconds) const;
  };
  struct steady_clock {
      static milliseconds now();
  };
  }}
  struct Settings {
      std::chrono::milliseconds setRetainedMessageDeferTimeout;
      std::chrono::milliseconds setRetainedMessageDeferTimeoutSpread;
  };
  struct ThreadData {
      long randomish();
      void queueSettingRetainedMessage(int, int, std::chrono::milliseconds);
  };
  void trySetRetainedMessages(Settings *settings, ThreadData *td) {
      auto spread {settings->setRetainedMessageDeferTimeoutSpread};
      if (spread != std::chrono::milliseconds::zero()) {
          const long rnd = td->randomish();
          spread = std::chrono::milliseconds{rnd % spread.count()};
      }
      const auto randomized_timeout = settings->setRetainedMessageDeferTimeout + spread;
      auto limit = std::chrono::steady_clock::now() + randomized_timeout;
      td->queueSettingRetainedMessage(1, 2, limit);
  }
  ```
