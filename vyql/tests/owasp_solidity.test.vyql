# OWASP-replica coverage for Solidity — true positive plus opaque-predicate pruning.

test "solidity: tainted recipient -> transfer is an external-call sink"
  lang solidity
  expect VYQL-SC-001
  code
  ```
  contract C {
    function f(address payable to) public {
      to.transfer(1);
    }
  }
  ```

test "solidity: opaque-false if taints only the dead branch — clean"
  lang solidity
  reject VYQL-SC-001
  code
  ```
  contract C {
    function f(address payable to) public {
      address payable dest = payable(address(0));
      if (1 > 100) { dest = to; }
      dest.transfer(1);
    }
  }
  ```

test "solidity: opaque-false ternary selects the clean arm — clean"
  lang solidity
  reject VYQL-SC-001
  code
  ```
  contract C {
    function f(address payable to) public {
      address payable dest = (1 > 100) ? to : payable(address(0));
      dest.transfer(1);
    }
  }
  ```
