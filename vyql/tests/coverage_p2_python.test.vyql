# P2 entry-point seeding: FastAPI / Starlette / APIRouter handler params.

test "python: FastAPI path param -> SQL is injection"
  lang python
  expect VYQL-INJ-001
  code
  ```
  @app.get("/users/{name}")
  def find(name: str):
      cur.execute("SELECT * FROM users WHERE name = '" + name + "'")
  ```

test "python: FastAPI Query param -> os.system is command injection"
  lang python
  expect VYQL-INJ-002
  code
  ```
  @router.post("/ping")
  def ping(host: str = Query()):
      os.system("ping " + host)
  ```

test "python: FastAPI constant query is clean"
  lang python
  reject VYQL-INJ-001
  code
  ```
  @app.get("/users")
  def all_users():
      cur.execute("SELECT * FROM users")
  ```

test "python: a plain (undecorated) function param is not a source"
  lang python
  reject VYQL-INJ-001
  code
  ```
  def helper(name):
      cur.execute("SELECT * FROM users WHERE name = '" + name + "'")
  ```
