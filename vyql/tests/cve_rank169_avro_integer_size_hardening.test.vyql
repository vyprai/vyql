test "rank169: Avro wire length is narrowed before size validation"
  lang go
  expect_review code.IntegerSizeArithmetic
  code
  ```
  package avro

  func (r *Reader) readBytes(op string) []byte {
    size := int(r.ReadLong())
    if size < 0 {
      r.ReportError("ReadBytes", "invalid length")
      return nil
    }
    if maxSize := r.cfg.getMaxByteSliceSize(); maxSize > 0 && size > maxSize {
      r.ReportError("ReadBytes", "too large")
      return nil
    }
    buf := make([]byte, size)
    r.Read(buf)
    return buf
  }
  ```

test "rank169: Avro wire length is range-checked before narrowing"
  lang go
  reject_review code.IntegerSizeArithmetic
  code
  ```
  package avro

  import "math"

  func (r *Reader) readBytes(op string) []byte {
    size64 := r.ReadLong()
    if size64 < 0 {
      r.ReportError("ReadBytes", "invalid length")
      return nil
    }
    if maxSize := r.cfg.getMaxByteSliceSize(); maxSize > 0 && size64 > int64(maxSize) {
      r.ReportError("ReadBytes", "too large")
      return nil
    }
    if size64 > math.MaxInt {
      r.ReportError("ReadBytes", "length is too big")
      return nil
    }
    size := int(size64)
    buf := make([]byte, size)
    r.Read(buf)
    return buf
  }
  ```

test "rank169: Avro block counts are added before overflow-safe cap check"
  lang go
  expect_review code.IntegerSizeArithmetic
  code
  ```
  package avro

  func (d *arrayDecoder) Decode(ptr unsafe.Pointer, r *Reader) {
    size := 0
    for {
      l, _ := r.ReadBlockHeader()
      if l == 0 {
        break
      }
      start := size
      size += int(l)
      if size > r.cfg.getMaxSliceAllocSize() {
        r.ReportError("decode array", "too large")
        return
      }
      sliceType.UnsafeGrow(ptr, size)
      _ = start
    }
  }
  ```

test "rank169: Avro block counts use subtraction-form cap check before addition"
  lang go
  reject_review code.IntegerSizeArithmetic
  code
  ```
  package avro

  func (d *arrayDecoder) Decode(ptr unsafe.Pointer, r *Reader) {
    size := 0
    for {
      l, _ := r.ReadBlockHeader()
      if l == 0 {
        break
      }
      start := size
      if l > r.cfg.getMaxSliceAllocSize()-size {
        r.ReportError("decode array", "too large")
        return
      }
      size += l
      sliceType.UnsafeGrow(ptr, size)
      _ = start
    }
  }
  ```
