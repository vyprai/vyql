# Rank 642 / CVE-2021-3950: django-helpdesk saved uploaded FollowUpAttachment
# instances without running model validators on the FileField.
test "rank642: attachment model save bypasses file validators without full_clean"
  lang python
  file lib.py
  expect VYQL-INJ-141
  code
  ```
  def process_attachments(followup, attached_files):
      attachments = []
      for attached in attached_files:
          if attached.size:
              filename = smart_text(attached.name)
              att = FollowUpAttachment(
                  followup=followup,
                  file=attached,
                  filename=filename,
                  mime_type=attached.content_type or 'application/octet-stream',
                  size=attached.size,
              )
              att.save()
              attachments.append([filename, att.file])
      return attachments
  ```

test "rank642: attachment model runs full_clean before save"
  lang python
  file lib.py
  reject VYQL-INJ-141
  code
  ```
  def process_attachments(followup, attached_files):
      attachments = []
      for attached in attached_files:
          if attached.size:
              filename = smart_text(attached.name)
              att = FollowUpAttachment(
                  followup=followup,
                  file=attached,
                  filename=filename,
                  mime_type=attached.content_type or 'application/octet-stream',
                  size=attached.size,
              )
              att.full_clean()
              att.save()
              attachments.append([filename, att.file])
      return attachments
  ```
