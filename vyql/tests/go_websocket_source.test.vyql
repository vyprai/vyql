# A websocket connection is a handle, not request data. Labelling the handle as
# HTTP input spreads the label to every value derived from the connection --
# writers, sessions, whatever the handle is passed to -- none of which carries
# anything an attacker sent. The bytes a read returns are the attacker's data.

test "go websocket ReadMessage bytes are http input"
  lang go
  file ws_read.go
  expect VYQL-INJ-001
  code
  ```
  package main

  import (
      "database/sql"
      "net/http"

      "github.com/gorilla/websocket"
  )

  var upgrader = websocket.Upgrader{}

  func serve(db *sql.DB, w http.ResponseWriter, r *http.Request) {
      conn, err := upgrader.Upgrade(w, r, nil)
      if err != nil {
          return
      }
      _, msg, _ := conn.ReadMessage()
      _, _ = db.Query("SELECT * FROM t WHERE name = '" + string(msg) + "'")
  }
  ```

test "go websocket Upgrade result is not itself http input"
  lang go
  file ws_handle.go
  reject VYQL-INJ-001
  code
  ```
  package main

  import (
      "database/sql"
      "net/http"

      "github.com/gorilla/websocket"
  )

  var upgrader = websocket.Upgrader{}

  type writer struct{ c *websocket.Conn }

  func NewWriter(c *websocket.Conn) *writer { return &writer{c: c} }

  // local configuration, nothing read from the connection
  func (wr *writer) Meta() string { return "fixed-label" }

  // The request argument is nil so that nothing reaching the sink can come from
  // it. What is under test is whether the connection the upgrade returns is
  // treated as attacker-controlled on its own.
  func serve(db *sql.DB, w http.ResponseWriter) {
      conn, err := upgrader.Upgrade(w, nil, nil)
      if err != nil {
          return
      }
      wr := NewWriter(conn)
      _, _ = db.Query("SELECT * FROM t WHERE name = '" + wr.Meta() + "'")
  }
  ```
