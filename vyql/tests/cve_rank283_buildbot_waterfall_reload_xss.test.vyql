# Rank 283 / CVE-2009-2959: Buildbot's waterfall help page rendered a
# request-controlled reload value into radio-button HTML without escaping.

test "rank283: buildbot waterfall reload value is inserted into HTML unescaped"
  lang python
  expect VYQL-INJ-041
  code
  ```
  class WaterfallHelp:
      def body(self, request):
          show_reload_input = '<table>\n'
          times = [("none", "None")]
          current_reload_time = request.args.get("reload", ["none"])
          if current_reload_time:
              current_reload_time = current_reload_time[0]
          if current_reload_time not in [t[0] for t in times]:
              times.insert(0, (current_reload_time, current_reload_time))
          for value, name in times:
              checked = ""
              if value == current_reload_time:
                  checked = 'checked="checked"'
              show_reload_input += ('<tr>'
                                    '<td><input type="radio" name="reload" '
                                    'value="%s" %s></td> '
                                    '<td>%s</td></tr>\n'
                                    ) % (value, checked, name)
          return show_reload_input
  ```

test "rank283: buildbot waterfall reload value is escaped before HTML insertion"
  lang python
  reject VYQL-INJ-041
  code
  ```
  import html

  class WaterfallHelp:
      def body(self, request):
          show_reload_input = '<table>\n'
          times = [("none", "None")]
          current_reload_time = request.args.get("reload", ["none"])
          if current_reload_time:
              current_reload_time = current_reload_time[0]
          if current_reload_time not in [t[0] for t in times]:
              times.insert(0, (current_reload_time, current_reload_time))
          for value, name in times:
              checked = ""
              if value == current_reload_time:
                  checked = 'checked="checked"'
              show_reload_input += ('<tr>'
                                    '<td><input type="radio" name="reload" '
                                    'value="%s" %s></td> '
                                    '<td>%s</td></tr>\n'
                                    ) % (html.escape(value), checked, html.escape(name))
          return show_reload_input
  ```
