# Rank 439 / CVE-2025-47269: code-server path proxy accepted an
# unvalidated port path segment that could make the proxy contact a domain.

test "rank439: code-server path proxy interpolates unvalidated port"
  lang javascript
  file pathProxy.ts
  expect VYQL-RF-019
  expect_review code.CodeServerPathProxyPortConfusedProxy
  code
  ```
  import { Request } from "express"

  const getProxyTarget = (
    req: Request,
    opts?: {
      proxyBasePath?: string
    },
  ): string => {
    const base = (req as any).base || ""
    return `http://0.0.0.0:${req.params.port}${opts?.proxyBasePath || ""}/${req.originalUrl.slice(base.length)}`
  }
  ```

test "rank439: code-server path proxy normalizes port numerically"
  lang javascript
  file pathProxy.ts
  reject VYQL-RF-019
  reject_review code.CodeServerPathProxyPortConfusedProxy
  code
  ```
  import { Request } from "express"
  import { HttpCode, HttpError } from "../../common/http"

  const getProxyTarget = (
    req: Request,
    opts?: {
      proxyBasePath?: string
    },
  ): string => {
    const base = (req as any).base || ""
    let port: number
    try {
      port = parseInt(req.params.port, 10)
    } catch (err) {
      throw new HttpError("Invalid port", HttpCode.BadRequest)
    }
    return `http://0.0.0.0:${port}${opts?.proxyBasePath || ""}/${req.originalUrl.slice(base.length)}`
  }
  ```
