# B2 — reentrancy (CWE-841, VYQL-SC-004). A temporal order-rule over the structured CFG:
# an external call BEFORE a state write violates checks-effects-interactions. Ordering it
# the other way (state write first) is clean — the difference is path order, not presence.

test "reentrancy: external call before the state write is flagged (solidity)"
  lang solidity
  expect VYQL-SC-004
  code
  ```
  contract Bank {
      mapping(address => uint) balances;
      function withdraw(uint amount) public {
          msg.sender.call{value: amount}("");
          balances[msg.sender] -= amount;
      }
  }
  ```

test "reentrancy: state write before the external call is clean (checks-effects-interactions)"
  lang solidity
  reject VYQL-SC-004
  code
  ```
  contract Bank {
      mapping(address => uint) balances;
      function withdraw(uint amount) public {
          balances[msg.sender] -= amount;
          msg.sender.call{value: amount}("");
      }
  }
  ```
