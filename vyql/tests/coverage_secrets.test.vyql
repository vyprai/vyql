# A1 — hardcoded secret detection (CWE-798, SEC-002). The secretscan frontend runs
# alongside the language frontend on any source/config file.

test "secrets: hardcoded AWS access key is flagged"
  lang python
  expect VYQL-SEC-002
  code
  ```
  AWS_KEY = "AKIAIOSFODNN7EXAMPLE"
  ```

test "secrets: hardcoded Stripe live key is flagged"
  lang javascript
  expect VYQL-SEC-002
  code
  ```
  const key = "sk_live_4eC39HqLyjWDarjtT1zdp7dcABCDEFGH";
  ```

test "secrets: a high-confidence password literal is flagged"
  lang python
  expect VYQL-SEC-002
  code
  ```
  db_password = "S3cr3t!ProdPassw0rd"
  ```

test "secrets: a secret read from the environment is clean"
  lang python
  reject VYQL-SEC-002
  code
  ```
  import os
  api_key = os.environ["API_KEY"]
  ```

test "secrets: a placeholder value is clean"
  lang python
  reject VYQL-SEC-002
  code
  ```
  password = "changeme"
  ```

test "secrets: an interpolated/templated value is clean"
  lang javascript
  reject VYQL-SEC-002
  code
  ```
  const token = process.env.TOKEN;
  ```

# secretscan runs as a cross-language frontend over any text file; a `.env` file
# keys on no source frontend, so these exercise the scanner in isolation.
test "secrets: a provider token in a .env file is flagged"
  lang secretscan
  expect VYQL-SEC-002
  code
  ```
  DATABASE_URL=postgres://u:p@h/db
  AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
  ```

# Regression for the vulpy/good FP: a single-case dictionary-word "secret" has too
# few character classes to be a real credential (entropy gate).
test "secrets: a low-entropy single-case placeholder literal is clean"
  lang python
  reject VYQL-SEC-002
  code
  ```
  secret = "MYSUPERSECRETKEY"
  ```
