test "rank736: element-plus table popper escapes overflow tooltip HTML"
  lang javascript
  profile library
  file util.ts
  reject VYQL-INJ-004
  code
  ```
  import escapeHtml from 'escape-html'

  export function createTablePopper(parentNode, trigger, popperContent) {
    function renderContent() {
      const content = document.createElement('div')
      content.className = 'el-popper'
      popperContent = escapeHtml(popperContent)
      content.innerHTML = popperContent
      return content
    }
    return renderContent()
  }
  ```
