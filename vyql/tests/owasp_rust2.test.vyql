# OWASP-replica coverage for Rust — statement-if/match pruning (complements owasp_rust).

test "rust2: handler param -> Command.arg is command injection"
  lang rust
  expect VYQL-INJ-002
  code
  ```
  #[get("/")]
  fn h(x: String) {
    std::process::Command::new("sh").arg(x);
  }
  ```

test "rust2: reassignment in a live branch is still cmdi (no FN)"
  lang rust
  expect VYQL-INJ-002
  code
  ```
  #[get("/")]
  fn h(x: String) {
    let mut c = String::from("ls");
    if 1 < 100 { c = x; }
    std::process::Command::new("sh").arg(c);
  }
  ```

test "rust2: opaque-false if taints only the dead branch — clean cmdi"
  lang rust
  reject VYQL-INJ-002
  code
  ```
  #[get("/")]
  fn h(x: String) {
    let mut c = String::from("ls");
    if 1 > 100 { c = x; }
    std::process::Command::new("sh").arg(c);
  }
  ```

test "rust2: opaque match routes taint to a dead arm — clean cmdi"
  lang rust
  reject VYQL-INJ-002
  code
  ```
  #[get("/")]
  fn h(x: String) {
    let mut c = String::from("ls");
    match 1 { 9 => { c = x; }, _ => {} }
    std::process::Command::new("sh").arg(c);
  }
  ```
