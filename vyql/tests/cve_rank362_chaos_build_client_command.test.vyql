test "rank362: CHAOS BuildClient formats filename into shell build command"
  lang go
  expect VYQL-INJ-060
  expect_review code.UnsafeBuildClientCommandAssembly
  code
  ```
  package services

  import (
      "fmt"
      "os/exec"
  )

  type BuildClientBinaryInput struct {
      ServerAddress string
      ServerPort string
      OSTarget int
      Filename string
      RunHidden bool
  }

  type clientService struct {
      appVersion string
  }

  func (c clientService) GenerateNewToken() (string, error) {
      return "token", nil
  }

  func handleOSType(osType int) string { return "linux" }
  func runHidden(hidden bool) string { return "" }
  func handleFilename(osType int, filename string) string { return filename }

  func (c clientService) BuildClient(input BuildClientBinaryInput) (string, error) {
      token, err := c.GenerateNewToken()
      if err != nil {
          return "", err
      }

      const buildStr = `GO_ENABLED=1 GOOS=%s GOARCH=amd64 go build -ldflags '%s -s -w -X main.Version=%s -X main.ServerPort=%s -X main.ServerAddress=%s -X main.Token=%s -extldflags "-static"' -o ../temp/%s main.go`
      filename := handleFilename(input.OSTarget, input.Filename)
      buildCmd := fmt.Sprintf(buildStr, handleOSType(input.OSTarget), runHidden(input.RunHidden), c.appVersion, input.ServerPort, input.ServerAddress, token, filename)
      cmd := exec.Command("sh", "-c", buildCmd)
      cmd.Dir = "client/"
      return filename, nil
  }
  ```

test "rank362: CHAOS BuildClient normalizes filename and validates build fields"
  lang go
  reject VYQL-INJ-060
  reject_review code.UnsafeBuildClientCommandAssembly
  code
  ```
  package services

  import (
      "fmt"
      "os/exec"
  )

  var ErrInvalidServerAddress = fmt.Errorf("invalid address")
  var ErrInvalidServerPort = fmt.Errorf("invalid port")

  var utils = struct {
      IsValidIPAddress func(string) bool
      IsValidURL func(string) bool
      StringIsNumber func(string) bool
      NormalizeString func(string) (string, error)
  }{
      IsValidIPAddress: func(string) bool { return true },
      IsValidURL: func(string) bool { return true },
      StringIsNumber: func(string) bool { return true },
      NormalizeString: func(s string) (string, error) { return s, nil },
  }

  type BuildClientBinaryInput struct {
      ServerAddress string
      ServerPort string
      OSTarget int
      Filename string
      RunHidden bool
  }

  type clientService struct {
      appVersion string
  }

  func (c clientService) GenerateNewToken() (string, error) {
      return "token", nil
  }

  func handleOSType(osType int) string { return "linux" }
  func runHidden(hidden bool) string { return "" }
  func handleFilename(osType int, filename string) string { return filename }

  func (c clientService) BuildClient(input BuildClientBinaryInput) (string, error) {
      if !utils.IsValidIPAddress(input.ServerAddress) &&
          !utils.IsValidURL(input.ServerAddress) {
          return "", ErrInvalidServerAddress
      }

      if !utils.StringIsNumber(input.ServerPort) {
          return "", ErrInvalidServerPort
      }

      filename, err := utils.NormalizeString(input.Filename)
      if err != nil {
          return "", err
      }

      token, err := c.GenerateNewToken()
      if err != nil {
          return "", err
      }

      const buildStr = `GO_ENABLED=1 GOOS=%s GOARCH=amd64 go build -ldflags '%s -s -w -X main.Version=%s -X main.ServerPort=%s -X main.ServerAddress=%s -X main.Token=%s -extldflags "-static"' -o ../temp/%s main.go`
      filename = handleFilename(input.OSTarget, filename)
      buildCmd := fmt.Sprintf(buildStr, handleOSType(input.OSTarget), runHidden(input.RunHidden), c.appVersion, input.ServerPort, input.ServerAddress, token, filename)
      cmd := exec.Command("sh", "-c", buildCmd)
      cmd.Dir = "client/"
      return filename, nil
  }
  ```
