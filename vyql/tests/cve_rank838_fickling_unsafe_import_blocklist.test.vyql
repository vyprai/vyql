test "rank838: Python pickle unsafe import blocklist omits ctypes and pydoc"
  lang python
  expect VYQL-DESER-017
  expect_review code.PickleUnsafeImportBlocklistGap
  code
  ```
  class Pickled:
      def unsafe_imports(self):
          for node in self.properties.imports:
              if node.module in (
                  "__builtin__",
                  "__builtins__",
                  "builtins",
                  "os",
                  "posix",
                  "nt",
                  "subprocess",
                  "sys",
                  "socket",
                  "pty",
                  "marshal",
                  "types",
                  "runpy",
                  "cProfile",
              ):
                  yield node
              elif "eval" in (n.name for n in node.names):
                  yield node
  ```

test "rank838: Python pickle unsafe import blocklist includes ctypes and pydoc"
  lang python
  reject VYQL-DESER-017
  reject_review code.PickleUnsafeImportBlocklistGap
  code
  ```
  class Pickled:
      def unsafe_imports(self):
          for node in self.properties.imports:
              if node.module in (
                  "__builtin__",
                  "__builtins__",
                  "builtins",
                  "os",
                  "posix",
                  "nt",
                  "subprocess",
                  "sys",
                  "socket",
                  "pty",
                  "marshal",
                  "types",
                  "runpy",
                  "cProfile",
                  "ctypes",
                  "pydoc",
              ):
                  yield node
              elif "eval" in (n.name for n in node.names):
                  yield node
  ```
