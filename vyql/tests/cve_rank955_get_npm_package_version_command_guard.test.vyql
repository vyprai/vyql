# Rank 955 / CVE-2020-7795: get-npm-package-version interpolated package
# and registry values into npm shell command strings before denying shell
# metacharacters.

test "rank955: package name reaches execSync npm command template"
  lang javascript
  profile library
  file index.js
  expect VYQL-INJ-002
  code
  ```
  import { execSync } from "child_process";

  export function getPackageVersion(packageName, registry = "") {
    if (registry) {
      return execSync(`npm view ${packageName} version --registry ${registry}`);
    }
    return execSync(`npm view ${packageName} version`);
  }
  ```

test "rank955: shell metacharacter denylist guards execSync npm command template"
  lang javascript
  profile library
  file index.js
  reject VYQL-INJ-002
  code
  ```
  import { execSync } from "child_process";

  export function getPackageVersion(packageName, registry = "") {
    if (/[`$&{}[;|]/g.test(packageName) || /[`$&{}[;|]/g.test(registry)) {
      return null;
    }
    if (registry) {
      return execSync(`npm view ${packageName} version --registry ${registry}`);
    }
    return execSync(`npm view ${packageName} version`);
  }
  ```
