# ~46 generated JavaScript package bindings (content-type, css, esprima, @babel/parser, …)
# declare a RECEIVER-AGNOSTIC `callee.method == "parse"` deserialization sink, so depending
# on any one of them turned every `.parse()` in the codebase into a critical CWE-502 —
# JSON.parse included. JSON/Date/url/querystring parsing yields plain data and cannot
# instantiate arbitrary types, so it is not object deserialization. Genuinely unsafe
# loaders must keep firing.

test "js deser: JSON.parse of request data is not unsafe deserialization"
  lang javascript
  reject VYQL-DESER-001
  code
  ```
  function handler(req, res) {
    return JSON.parse(req.body);
  }
  ```

test "js deser: url.parse of request data is not unsafe deserialization"
  lang javascript
  reject VYQL-DESER-001
  code
  ```
  const url = require('url');
  function handler(req, res) {
    return url.parse(req.url);
  }
  ```

test "js deser: node-serialize unserialize of request data is unsafe deserialization"
  lang javascript
  expect VYQL-DESER-001
  code
  ```
  const serialize = require('node-serialize');
  function handler(req, res) {
    return serialize.unserialize(req.body);
  }
  ```
