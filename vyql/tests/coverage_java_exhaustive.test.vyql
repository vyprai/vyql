# Java core-language exhaustive coverage for adapter-claimed JVM and Android idioms.

test "java exhaustive: request input reaches SQL command code-eval reflection and dynamic-load sinks"
  lang java
  expect VYQL-INJ-001
  expect VYQL-INJ-002
  expect VYQL-INJ-003
  expect VYQL-INJ-023
  code
  ```
  class C {
    void h(HttpServletRequest req, Statement stmt, ScriptEngine engine) throws Exception {
      String v = req.getParameter("v");
      stmt.executeQuery(v);
      stmt.executeUpdate(v);
      Runtime.getRuntime().exec(v);
      new ProcessBuilder(v).start();
      engine.eval(v);
      Class.forName(v);
    }
  }
  ```

