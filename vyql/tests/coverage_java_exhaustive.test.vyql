  class C {
    void h(HttpServletRequest req, HttpServletResponse res, WebView webView, CSVWriter csv, Parser parser) throws Exception {
      String v = req.getParameter("v");
      webView.loadUrl(v);
      webView.addJavascriptInterface(this, "bridge");
      res.getWriter().write(v);
      Velocity.evaluate(ctx, out, "log", v);
      res.setHeader("X-Name", v);
      logger.info(v);
      System.out.printf(v);
      csv.writeNext(new String[] { v });
      BeanUtils.copyProperties(req.getParameterMap(), user);
      parser.parseExpression(v);
    }
  }
  ```

