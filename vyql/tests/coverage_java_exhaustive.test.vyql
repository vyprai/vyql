  reject VYQL-LIFE-001
  code
  ```
  class C {
    void h(HttpServletResponse res, File file, Lock lock) throws Exception {
      MessageDigest.getInstance("SHA-256");
      Cipher.getInstance("AES/GCM/NoPadding");
      new IvParameterSpec(iv);
      new SecureRandom();
      new URL("https://example.com");
      new URL("http://127.0.0.1:8080");
      cookie.setHttpOnly(true);
      cookie.setSecure(true);
      file.setWritable(false, false);
      Files.createTempFile("safe", ".tmp");
      res.setHeader("Access-Control-Allow-Origin", "https://example.com");
      res.setHeader("X-Frame-Options", "DENY");
      Socket s = new Socket("example.com", 443);
      s.close();
      lock.lock();
      lock.unlock();
    }
  }
  ```

test "java exhaustive: SQL literal cast returned without shared quoting is reported"
  lang java
  expect VYQL-INJ-030
  code
  ```
  class SimpleParameterList {
    public String toString(int index) {
      String uuid = paramValues[index].toString();
      return "'" + uuid + "'::uuid";
    }
  }
  ```

test "java exhaustive: SQL literal cast through shared quoting helper is clean"
  lang java
  reject VYQL-INJ-030
  code
  ```
  class SimpleParameterList {
    private static String quoteAndCast(String text, String type) {
      StringBuilder sb = new StringBuilder();
      Utils.escapeLiteral(sb, text, true);
      sb.append("::");
      sb.append(type);
      return sb.toString();
    }

    public String toString(int index) {
      String uuid = paramValues[index].toString();
      return quoteAndCast(uuid, "uuid");
    }
  }
  ```
