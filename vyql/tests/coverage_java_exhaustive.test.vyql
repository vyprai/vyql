test "java exhaustive: deserialization XXE file upload archive path and SSRF sinks receive taint"
  lang java
  expect VYQL-DESER-001
  expect VYQL-DESER-002
  expect VYQL-PATH-001
  expect VYQL-INJ-015
  expect VYQL-PATH-004
  expect VYQL-RF-001
  code
  ```
  class C {
    void h(HttpServletRequest req, DocumentBuilder builder, ObjectMapper mapper, MultipartFile file, Archive archive) throws Exception {
      String v = req.getParameter("v");
      mapper.readValue(v, Object.class);
      builder.parse(v);
      new File(v);
      Files.readAllBytes(Paths.get(v));
      file.transferTo(new File(v));
      archive.extractEntry(v);
      new URL(v).openConnection();
    }
  }
  ```

test "java exhaustive: hardened XML constant files fixed uploads archive paths and URLs are clean"
  lang java
  reject VYQL-DESER-002
  reject VYQL-PATH-001
  reject VYQL-INJ-015
  reject VYQL-PATH-004
  reject VYQL-RF-001
  code
  ```
  class C {
    void h(DocumentBuilderFactory f, MultipartFile file, Archive archive) throws Exception {
      f.setFeature("http://apache.org/xml/features/disallow-doctype-decl", true);
      f.newDocumentBuilder().parse("safe.xml");
      new File("safe.txt");
      file.transferTo(new File("uploads/fixed.dat"));
      archive.extractEntry("safe.txt");
      new URL("https://example.com").openConnection();
    }
  }
  ```

