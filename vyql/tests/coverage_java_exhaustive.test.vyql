test "java exhaustive: LDAP XPath regex trust-boundary auth IDOR and CSRF findings are reported"
  lang java
  expect VYQL-INJ-005
  expect VYQL-INJ-006
  expect VYQL-DOS-001
  expect VYQL-CFG-014
  expect VYQL-AUTH-001
  expect VYQL-AUTH-002
  expect VYQL-RF-003
  code
  ```
  class C {
    void h(HttpServletRequest req, DirContext ldap, XPath xpath, HttpSession session, Repo repo) throws Exception {
      String v = req.getParameter("v");
      ldap.search("dc=x", v, controls);
      xpath.evaluate(v, doc);
      Pattern.compile(v);
      session.setAttribute("role", v);
      changePassword(v);
      repo.findById(req.getParameter("id"));
      transferFunds(v);
    }
  }
  ```

test "java exhaustive: auth ownership validation and constants suppress trust auth IDOR and CSRF findings"
  lang java
  reject VYQL-DOS-001
  reject VYQL-CFG-014
  reject VYQL-AUTH-001
  reject VYQL-AUTH-002
  reject VYQL-RF-003
  code
  ```
  class C {
    void h(HttpServletRequest req, HttpSession session, Repo repo) throws Exception {
      Pattern.compile("^[a-z]+$");
      session.setAttribute("role", validateRole(req.getParameter("role")));
      requireAuth(req);
      changePassword("system");
      checkOwnership(req.getParameter("id"));
      repo.findById(req.getParameter("id"));
      transferFunds("system");
    }
  }
  ```

test "java exhaustive: crypto config cleartext permissions temp and lifecycle findings are reported"
  lang java
  expect VYQL-CRY-001
  expect VYQL-CRY-002
  expect VYQL-CRY-003
  expect VYQL-CRY-004
  expect VYQL-CFG-001
  expect VYQL-CFG-003
  expect VYQL-CFG-004
  expect VYQL-CFG-005
  expect VYQL-CFG-006
  expect VYQL-CFG-007
  expect VYQL-CFG-008
  expect VYQL-CFG-009
  expect VYQL-PATH-003
  expect VYQL-RES-001
  expect VYQL-LIFE-001
  code
  ```
  class C {
    void h(HttpSecurity http, HttpServletResponse res, File file, Lock lock) throws Exception {
      MessageDigest.getInstance("MD5");
      Cipher.getInstance("DES");
      new IvParameterSpec("0000000000000000".getBytes());
      new Random();
      http.csrf().disable();
      NoopHostnameVerifier.INSTANCE.verify("h", session);
      Algorithm.none();
      new URL("http://example.com");
      cookie.setHttpOnly(false);
      cookie.setSecure(false);
      file.setWritable(true, false);
      Files.createFile(Paths.get("/tmp/fixed"));
      res.setHeader("Access-Control-Allow-Origin", "*");
      res.setHeader("X-Frame-Options", "ALLOWALL");
      Socket s = new Socket("example.com", 443);
      lock.lock();
    }
  }
  ```

test "java exhaustive: stronger crypto secure config closed resources and unlocked locks are clean"
