  class C {
    void h(HttpServletRequest req, HttpServletResponse res, WebView webView, CSVWriter csv, Parser parser) throws Exception {
      String v = escapeHtml(req.getParameter("v"));
      webView.loadUrl("https://example.com");
      res.getWriter().write(v);
      Velocity.evaluate(ctx, out, "log", "Hello $name");
      res.setHeader("X-Name", "safe");
      logger.info("safe");
      System.out.printf("%s", v);
      csv.writeNext(new String[] { "safe" });
      BeanUtils.copyProperties(defaults, user);
      parser.parseExpression("name");
