# Rank 151 / CVE-2024-9312: authd derived local UID/GID values from
# attacker-controlled usernames before pre-auth registration enforced uniqueness.

test "rank151: go authd username-derived UID and GID requires identity review"
  lang go
  expect_review code.UserIdentityMappingReview
  code
  ```
  package nss

  import (
    "context"
    "encoding/json"

    users "github.com/ubuntu/authd/internal/users"
  )

  type Service struct {
    userManager *users.Manager
  }

  type Broker interface {
    UserPreCheck(context.Context, string) (string, error)
  }

  type UserEntry struct {
    Name string
    UID  uint32
    GID  uint32
  }

  func (s *Service) userPreCheck(ctx context.Context, username string, b Broker) (*UserEntry, error) {
    userinfo, err := b.UserPreCheck(ctx, username)
    if err != nil {
      return nil, err
    }

    var u UserEntry
    if err := json.Unmarshal([]byte(userinfo), &u); err != nil {
      return nil, err
    }

    u.UID = s.userManager.GenerateUID(u.Name)
    u.GID = s.userManager.GenerateGID(u.Name)
    return &u, nil
  }
  ```

test "rank151: go authd pre-auth registration is clean"
  lang go
  reject_review code.UserIdentityMappingReview
  code
  ```
  package nss

  import (
    "context"
    "encoding/json"

    users "github.com/ubuntu/authd/internal/users"
  )

  type Service struct {
    userManager *users.Manager
  }

  type Broker interface {
    UserPreCheck(context.Context, string) (string, error)
  }

  type UserEntry struct {
    Name string
    UID  uint32
    GID  uint32
  }

  func (s *Service) userPreCheck(ctx context.Context, username string, b Broker) (*UserEntry, error) {
    userinfo, err := b.UserPreCheck(ctx, username)
    if err != nil {
      return nil, err
    }

    var u UserEntry
    if err := json.Unmarshal([]byte(userinfo), &u); err != nil {
      return nil, err
    }

    u.UID, err = s.userManager.RegisterUserPreAuth(u.Name)
    if err != nil {
      return nil, err
    }
    return &u, nil
  }
  ```
