test "rank240: HTMLSerializer subclass without RCDATA escaping is mutation-XSS review-visible"
  lang python
  expect VYQL-INJ-200
  expect_review code.HtmlSanitizerLogicReview
  code
  ```
  from html5lib.serializer import HTMLSerializer

  class BleachHTMLSerializer(HTMLSerializer):
      def escape_base_amp(self, stoken):
          return stoken.replace("&amp;", "&")

      def serialize(self, treewalker, encoding=None):
          for stoken in super(BleachHTMLSerializer, self).serialize(treewalker, encoding):
              yield stoken
  ```

test "rank240: HTMLSerializer subclass with RCDATA escaping is clean"
  lang python
  reject VYQL-INJ-200
  reject_review code.HtmlSanitizerLogicReview
  code
  ```
  from html5lib.serializer import HTMLSerializer

  class BleachHTMLSerializer(HTMLSerializer):
      escape_rcdata = True

      def escape_base_amp(self, stoken):
          return stoken.replace("&amp;", "&")

      def serialize(self, treewalker, encoding=None):
          for stoken in super(BleachHTMLSerializer, self).serialize(treewalker, encoding):
              yield stoken
  ```
