# OWASP-replica coverage for PowerShell — true positive plus opaque-predicate pruning.

test "powershell: env query string -> Invoke-Expression is code injection"
  lang powershell
  expect VYQL-INJ-003
  code
  ```
  $x = $env:QUERY_STRING
  Invoke-Expression $x
  ```

test "powershell: tainted assign in a live branch is still code injection (no FN)"
  lang powershell
  expect VYQL-INJ-003
  code
  ```
  $x = $env:QUERY_STRING
  $c = "ls"
  if (1 -lt 100) { $c = $x }
  Invoke-Expression $c
  ```

test "powershell: opaque-false if taints only the dead branch — clean"
  lang powershell
  reject VYQL-INJ-003
  code
  ```
  $x = $env:QUERY_STRING
  $c = "ls"
  if (1 -gt 100) { $c = $x }
  Invoke-Expression $c
  ```

test "powershell: tainted assign in a live switch arm is still code injection (no FN)"
  lang powershell
  expect VYQL-INJ-003
  code
  ```
  $x = $env:QUERY_STRING
  $c = "ls"
  switch (1) {
    1 { $c = $x }
    default { $c = "p" }
  }
  Invoke-Expression $c
  ```

test "powershell: opaque switch routes taint to a dead arm — clean"
  lang powershell
  reject VYQL-INJ-003
  code
  ```
  $x = $env:QUERY_STRING
  $c = "ls"
  switch (1) {
    9 { $c = $x }
    default { $c = "p" }
  }
  Invoke-Expression $c
  ```
