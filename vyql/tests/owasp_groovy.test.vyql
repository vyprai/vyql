# OWASP-replica coverage for Groovy — true positive plus opaque-predicate pruning.

test "groovy: params -> sh is command injection"
  lang groovy
  expect VYQL-INJ-002
  code
  ```
  def h() {
    def b = params.BRANCH
    sh("echo " + b)
  }
  ```

test "groovy: opaque-false if taints only the dead branch — clean cmdi"
  lang groovy
  reject VYQL-INJ-002
  code
  ```
  def h() {
    def b = params.BRANCH
    def cmd = "ls"
    if (1 > 100) { cmd = b }
    sh("echo " + cmd)
  }
  ```

test "groovy: opaque switch routes taint to a dead arm — clean cmdi"
  lang groovy
  reject VYQL-INJ-002
  code
  ```
  def h() {
    def b = params.BRANCH
    def cmd = "ls"
    switch (1) { case 9: cmd = b; break; default: cmd = "pwd" }
    sh("echo " + cmd)
  }
  ```

test "groovy: tainted arg in a live switch arm is still cmdi (no FN)"
  lang groovy
  expect VYQL-INJ-002
  code
  ```
  def h() {
    def b = params.BRANCH
    switch (1) { case 1: sh(b); break; default: sh("ok") }
  }
  ```
