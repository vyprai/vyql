# Weak-hash (CWE-327/328) presence coverage for the thin-tier languages.

test "dart: md5.convert is a weak hash"
  lang dart
  expect VYQL-CRY-001
  code
  ```
  void h(List<int> b) {
    var d = md5.convert(b);
  }
  ```

test "lua: ngx.md5 is a weak hash"
  lang lua
  expect VYQL-CRY-001
  code
  ```
  local function h(s)
    return ngx.md5(s)
  end
  ```

test "bash: md5sum is a weak hash"
  lang bash
  expect VYQL-CRY-001
  code
  ```
  h() {
    md5sum "$1"
  }
  ```

test "groovy: MessageDigest MD5 is a weak hash"
  lang groovy
  expect VYQL-CRY-001
  code
  ```
  def h() {
    def md = MessageDigest.getInstance("MD5")
  }
  ```

test "elixir: :crypto.hash md5 is a weak hash"
  lang elixir
  expect VYQL-CRY-001
  code
  ```
  defmodule H do
    def h(data) do
      :crypto.hash(:md5, data)
    end
  end
  ```
