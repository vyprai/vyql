# Fires-coverage specs for the RealVuln detector suite. Each proves its rule fires;
# where the detector has a meaningful safe form, a reject case pins that too.

test "realvuln: DEBUG defaulting to true is flagged"
  lang python
  expect VYQL-AUTH-102
  code
  ```
  import os

  DEBUG = True
  ALLOWED_HOSTS = ["*"]
  ```

test "realvuln: DEBUG off is clean"
  lang python
  reject VYQL-AUTH-102
  code
  ```
  DEBUG = False
  ALLOWED_HOSTS = ["example.com"]
  ```

test "realvuln: a secret-named setting holding a literal is flagged"
  lang python
  expect VYQL-AUTH-101
  code
  ```
  SECRET_KEY = "django-insecure-8f3k2j4h5g6f7d8s9a0p1o2i3u4y5t6r7e8w9q"
  ```

test "realvuln: a secret read from the environment is clean"
  lang python
  reject VYQL-AUTH-101
  code
  ```
  import os

  SECRET_KEY = os.environ["SECRET_KEY"]
  ```

test "realvuln: f-string SQL reaching execute is flagged"
  lang python
  expect VYQL-INJ-203
  code
  ```
  def lookup(conn, user_id):
      cur = conn.cursor()
      cur.execute(f"SELECT * FROM users WHERE id = {user_id}")
      return cur.fetchall()
  ```

test "realvuln: parameterised SQL is clean"
  lang python
  reject VYQL-INJ-203
  code
  ```
  def lookup(conn, user_id):
      cur = conn.cursor()
      cur.execute("SELECT * FROM users WHERE id = %s", (user_id,))
      return cur.fetchall()
  ```

test "realvuln: f-string shell command is flagged"
  lang python
  expect VYQL-INJ-202
  code
  ```
  import os

  def archive(name):
      os.system(f"tar czf /tmp/{name}.tgz /data/{name}")
  ```

test "realvuln: argv-form subprocess is clean"
  lang python
  reject VYQL-INJ-202
  code
  ```
  import subprocess

  def archive(name):
      subprocess.run(["tar", "czf", "/tmp/out.tgz", name], check=True)
  ```

# the detector is scoped to route handlers: a bare `return {...}` is the FastAPI
# shape that has no JsonResponse(...) wrapper for the sink detectors to key on.

test "realvuln: a route returning exception detail is flagged"
  lang python
  expect VYQL-SEC-042
  code
  ```
  from fastapi import FastAPI

  app = FastAPI()

  @app.get("/work")
  def handler(request):
      try:
          return do_work(request)
      except Exception as e:
          return {"status": "error", "detail": str(e)}
  ```

test "realvuln: a plaintext password column is flagged"
  lang python
  expect VYQL-AUTH-107
  code
  ```
  from django.db import models

  class User(models.Model):
      email = models.CharField(max_length=255)
      password = models.CharField(max_length=128)
  ```

test "realvuln: csrf_exempt on a state-changing view is flagged"
  lang python
  expect VYQL-AUTH-103
  code
  ```
  from django.views.decorators.csrf import csrf_exempt

  @csrf_exempt
  def transfer(request):
      return move_funds(request.POST["to"], request.POST["amount"])
  ```

test "realvuln: a wildcard CORS header is flagged"
  lang python
  expect VYQL-AUTH-106
  code
  ```
  class Handler:
      def respond(self):
          self.send_header("Access-Control-Allow-Origin", "*")
          self.end_headers()
  ```

test "realvuln: a cookie set without the secure flag is flagged"
  lang python
  expect VYQL-AUTH-100
  code
  ```
  def login(request, response):
      response.set_cookie("session", make_token(request))
      return response
  ```

test "realvuln: a cookie set with secure=True is clean"
  lang python
  reject VYQL-AUTH-100
  code
  ```
  def login(request, response):
      response.set_cookie("session", make_token(request), secure=True, httponly=True)
      return response
  ```

test "realvuln: the console email backend leaks reset tokens to logs"
  lang python
  expect VYQL-SEC-045
  code
  ```
  EMAIL_BACKEND = "django.core.mail.backends.console.EmailBackend"
  ```

test "realvuln: an SMTP email backend is clean"
  lang python
  reject VYQL-SEC-045
  code
  ```
  EMAIL_BACKEND = "django.core.mail.backends.smtp.EmailBackend"
  ```

test "realvuln: a response body carrying a password field is flagged"
  lang python
  expect VYQL-SEC-044
  code
  ```
  from django.http import JsonResponse

  def profile(request, user):
      return JsonResponse({"email": user.email, "password": user.password})
  ```

test "realvuln: a route building raw HTML from input is flagged"
  lang python
  expect VYQL-INJ-204
  code
  ```
  from fastapi import FastAPI

  app = FastAPI()

  @app.get("/greet")
  def greet(name):
      return "<div class='greeting'>Hello " + name + "</div>"
  ```

test "realvuln: serving MEDIA_ROOT as static is flagged"
  lang python
  expect VYQL-AUTH-104
  code
  ```
  from django.conf import settings
  from django.conf.urls.static import static

  urlpatterns = static(settings.MEDIA_URL, document_root=settings.MEDIA_ROOT)
  ```

test "realvuln: a login handler with no rate limit is flagged"
  lang python
  expect VYQL-AUTH-105
  code
  ```
  def login(request):
      user = authenticate(request.POST["user"], request.POST["password"])
      return issue_session(user)
  ```

test "realvuln: a jwt decoded with signature verification off is flagged"
  lang python
  expect VYQL-AUTH-108
  code
  ```
  import jwt

  def read_claims(token):
      return jwt.decode(token, options={"verify_signature": False})
  ```

test "realvuln: a verified jwt is clean"
  lang python
  reject VYQL-AUTH-108
  code
  ```
  import jwt

  def read_claims(token, secret):
      return jwt.decode(token, secret, algorithms=["HS256"])
  ```

test "realvuln: an environment dump in a route response is flagged"
  lang python
  expect VYQL-SEC-043
  code
  ```
  import os
  from fastapi import FastAPI

  app = FastAPI()

  @app.get("/debug")
  def debug():
      return {"env": os.environ.get("DATABASE_URL"), "base": str(BASE_DIR)}
  ```

test "realvuln: a client-supplied role marker driving a privilege check is flagged"
  lang python
  expect VYQL-AUTH-098
  code
  ```
  from flask import request

  def admin_panel():
      badge = request.cookies.get("badge")
      if badge == "lead":
          return render_admin()
      return deny()
  ```

test "realvuln: request data bulk-applied to a model is flagged"
  lang python
  expect VYQL-AUTH-099
  code
  ```
  from flask import request

  def update_profile(user):
      user.update(request.get_json())
      return user
  ```

test "realvuln smell: a route returning a record is a data-exposure candidate"
  lang python
  expect VYQL-SMELL-DATA
  code
  ```
  from fastapi import FastAPI

  app = FastAPI()

  @app.get("/user")
  def get_user(user_id):
      return User.objects.get(pk=user_id)
  ```

test "realvuln smell: a role-string comparison is a weak-authz candidate"
  lang python
  expect VYQL-SMELL-AUTHZ
  code
  ```
  from flask import request

  def dashboard():
      role = request.headers.get("X-Role")
      if role == "admin":
          return admin_view()
      return user_view()
  ```

test "realvuln smell: an unauthenticated state change is a candidate"
  lang python
  expect VYQL-SMELL-STATE
  code
  ```
  from fastapi import FastAPI
  from flask import request

  app = FastAPI()

  @app.post("/orders/cancel")
  def cancel_order():
      order = Order.objects.get(pk=request.form["order_id"])
      order.update(request.form["order_id"])
  ```

test "realvuln smell: an order-total recomputation is a business-logic candidate"
  lang python
  expect VYQL-SMELL-LOGIC
  code
  ```
  from fastapi import FastAPI
  from flask import request

  app = FastAPI()

  @app.post("/checkout")
  def checkout(ledger):
      ledger["total"] = request.form.get("total")
      return ledger
  ```

test "realvuln smell: a login distinguishing unknown users is an enumeration candidate"
  lang python
  expect VYQL-SMELL-ENUM
  code
  ```
  from django.http import JsonResponse
  from flask import request

  def login():
      user = find_user(request.form["email"])
      if not user:
          return JsonResponse({"error": "no such user"}, status=404)
      return JsonResponse({"error": "wrong password"}, status=401)
  ```

test "realvuln smell: an unscoped object fetch is an IDOR candidate"
  lang python
  expect VYQL-SMELL-IDOR
  code
  ```
  from flask import request

  def view_profile():
      user = User.objects.get(request.args["id"])
      return render_profile(user)
  ```
