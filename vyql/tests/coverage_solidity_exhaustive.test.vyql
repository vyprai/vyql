# Solidity language-gap narrowing: exhaustive smart-contract coverage for adapter-claimed idioms.

test "solidity exhaustive: tainted call delegatecall callcode send and transfer are external-call sinks"
  lang solidity
  expect VYQL-SC-001
  code
  ```
  contract Bank {
    function payout(address payable to, bytes memory data, uint amount) public {
      to.call{value: amount}(data);
      to.delegatecall(data);
      to.callcode(data);
      to.send(amount);
      to.transfer(amount);
    }
  }
  ```

test "solidity exhaustive: state-var transfer recipient is clean for arbitrary external call"
  lang solidity
  reject VYQL-SC-001
  code
  ```
  contract Bank {
    address payable owner;
    function payout() public {
      owner.transfer(1);
    }
  }
  ```

test "solidity exhaustive: public selfdestruct with attacker beneficiary is privileged-op abuse"
  lang solidity
  expect VYQL-SC-002
  code
  ```
  contract C {
    function kill(address payable beneficiary) public {
      selfdestruct(beneficiary);
    }
  }
  ```

test "solidity exhaustive: hardcoded selfdestruct beneficiary is clean"
  lang solidity
  reject VYQL-SC-002
  code
  ```
  contract C {
    address payable owner;
    function kill() public {
      selfdestruct(owner);
    }
  }
  ```

test "solidity exhaustive: tx.origin authorization is reported"
  lang solidity
  expect VYQL-SC-003
  code
  ```
  contract C {
    address owner;
    function withdraw() public {
      require(tx.origin == owner);
      payable(msg.sender).transfer(address(this).balance);
    }
  }
  ```

test "solidity exhaustive: msg.sender authorization is clean"
  lang solidity
  reject VYQL-SC-003
  code
  ```
  contract C {
    address owner;
    function withdraw() public {
      require(msg.sender == owner);
      payable(msg.sender).transfer(address(this).balance);
    }
  }
  ```

test "solidity exhaustive: external call before state write is reentrancy"
  lang solidity
  expect VYQL-SC-004
  code
  ```
  contract Bank {
    mapping(address => uint) balances;
    function withdraw(uint amount) public {
      msg.sender.call{value: amount}("");
      balances[msg.sender] -= amount;
    }
  }
  ```

test "solidity exhaustive: state write before external call is clean for reentrancy"
  lang solidity
  reject VYQL-SC-004
  code
  ```
  contract Bank {
    mapping(address => uint) balances;
    function withdraw(uint amount) public {
      balances[msg.sender] -= amount;
      msg.sender.call{value: amount}("");
    }
  }
  ```
