# P5 framework depth (csharp): Dapper query variants, EF Core raw.

test "csharp: query string -> Dapper QueryFirst is SQLi"
  lang csharp
  expect VYQL-INJ-001
  code
  ```
  public class C {
    public object Get(HttpRequest request) {
      var name = request.QueryString["name"];
      return conn.QueryFirst("SELECT * FROM users WHERE name = '" + name + "'");
    }
  }
  ```

test "csharp: query string -> EF Core FromSqlRaw is SQLi"
  lang csharp
  expect VYQL-INJ-001
  code
  ```
  public class C {
    public object Get(HttpRequest request) {
      var name = request.QueryString["name"];
      return db.Users.FromSqlRaw("SELECT * FROM users WHERE name = '" + name + "'");
    }
  }
  ```

test "csharp: a constant Dapper query is clean"
  lang csharp
  reject VYQL-INJ-001
  code
  ```
  public class C {
    public object Get() {
      return conn.QueryFirst("SELECT * FROM users");
    }
  }
  ```
