# C# coverage breadth: XXE (XmlDocument/XDocument) and Blazor MarkupString XSS.

test "csharp: query string -> XmlDocument.LoadXml is XXE"
  lang csharp
  expect VYQL-DESER-002
  code
  ```
  public class C {
    public void H(HttpRequest request) {
      var u = request.QueryString["xml"];
      var doc = new XmlDocument();
      doc.LoadXml(u);
    }
  }
  ```

test "csharp: query string -> XmlReader.Create is XXE"
  lang csharp
  expect VYQL-DESER-002
  code
  ```
  public class C {
    public void H(HttpRequest request) {
      var u = request.QueryString["xml"];
      var reader = XmlReader.Create(new StringReader(u));
    }
  }
  ```

test "csharp: query string -> Blazor MarkupString is XSS"
  lang csharp
  expect VYQL-INJ-004
  code
  ```
  public class C {
    public object H(HttpRequest request) {
      var u = request.QueryString["q"];
      return new MarkupString(u);
    }
  }
  ```

test "csharp: a constant is clean (XXE)"
  lang csharp
  reject VYQL-DESER-002
  code
  ```
  public class C {
    public void H() {
      var doc = new XmlDocument();
      doc.LoadXml("<root/>");
    }
  }
  ```
