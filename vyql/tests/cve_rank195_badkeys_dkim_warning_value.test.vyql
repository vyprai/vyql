test "rank195: badkeys DKIM warning includes unneutralized parsed key type"
  lang python
  expect VYQL-INJ-036
  code
  ```
  import base64
  import binascii

  from .utils import _warnmsg

  PUBPRE = "-----BEGIN PUBLIC KEY-----\n"
  PUBPOST = "\n-----END PUBLIC KEY-----"
  EDASN1 = b"\x30\x2a\x30\x05\x06\x03\x2b\x65\x70\x03\x21\x00"

  def parsedkim(line):
      dkim = {}
      for x in line.split(";"):
          s = x.split("=", 1)
          if len(s) != 2:
              continue
          key = s[0].strip()
          value = s[1].strip()
          dkim[key] = value
      if "k" not in dkim:
          dkim["k"] = "rsa"
      if dkim["k"] == "rsa":
          return PUBPRE + dkim["p"] + PUBPOST
      if dkim["k"] == "ed25519":
          rawed = base64.b64decode(dkim["p"].encode("ascii"))
          der = EDASN1 + rawed
          return PUBPRE + base64.b64encode(der).decode() + PUBPOST
      _warnmsg(f"Unknown DKIM key type {dkim['k']}")
      return False
  ```

test "rank195: badkeys DKIM warning omits parsed key type value"
  lang python
  reject VYQL-INJ-036
  code
  ```
  import base64
  import binascii

  from .utils import _warnmsg

  PUBPRE = "-----BEGIN PUBLIC KEY-----\n"
  PUBPOST = "\n-----END PUBLIC KEY-----"
  EDASN1 = b"\x30\x2a\x30\x05\x06\x03\x2b\x65\x70\x03\x21\x00"

  def parsedkim(line):
      dkim = {}
      for x in line.split(";"):
          s = x.split("=", 1)
          if len(s) != 2:
              continue
          key = s[0].strip()
          value = s[1].strip()
          dkim[key] = value
      if "k" not in dkim:
          dkim["k"] = "rsa"
      if dkim["k"] == "rsa":
          return PUBPRE + dkim["p"] + PUBPOST
      if dkim["k"] == "ed25519":
          rawed = base64.b64decode(dkim["p"].encode("ascii"))
          der = EDASN1 + rawed
          return PUBPRE + base64.b64encode(der).decode() + PUBPOST
      _warnmsg("Unknown DKIM key type")
      return False
  ```
