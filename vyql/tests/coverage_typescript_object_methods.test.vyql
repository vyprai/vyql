test "typescript: object generator method redirect query to location href is DOM XSS"
  lang javascript
  file login.ts
  expect VYQL-INJ-004
  code
  ```
  import { getPageQuery } from '@/utils/utils';

  const Model = {
    effects: {
      *login() {
        const params = getPageQuery();
        let { redirect } = params as { redirect: string };
        if (redirect) {
          window.location.href = redirect;
        }
      },
    },
  };

  export default Model;
  ```
