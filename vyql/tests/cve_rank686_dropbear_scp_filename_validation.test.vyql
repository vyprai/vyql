test "rank686: Dropbear scp accepts remote dot or empty filename"
  lang c
  expect VYQL-PATH-006
  code
  ```
  int atomicio(int (*fn)(), int fd, char *buf, unsigned long n);
  int read(int fd, char *buf, unsigned long n);
  int open(const char *path, int flags, int mode);
  int snprintf(char *str, unsigned long size, const char *format, ...);
  unsigned long strlen(const char *s);
  char *strchr(const char *s, int c);
  int strcmp(const char *a, const char *b);
  void exit(int);
  #define O_WRONLY 1
  #define O_CREAT 64
  #define NULL ((void*)0)

  int remin, targisdir;
  char *targ;

  void sink(int argc, char **argv) {
      char ch, *cp, *np, buf[2048];
      char *namebuf;
      unsigned long need;
      int mode = 0644;

      cp = buf;
      atomicio(read, remin, cp, 1);
      while (cp < &buf[sizeof(buf) - 1] && ch != '\n') {
          atomicio(read, remin, &ch, sizeof(ch));
          *cp++ = ch;
      }
      *cp = 0;
      cp = buf;
      if (*cp++ != ' ')
          exit(1);
      if (strchr(cp, '/') != NULL || strcmp(cp, "..") == 0) {
          exit(1);
      }
      if (targisdir) {
          need = strlen(targ) + strlen(cp) + 250;
          snprintf(namebuf, need, "%s%s%s", targ, strcmp(targ, "/") ? "/" : "", cp);
          np = namebuf;
      } else {
          np = targ;
      }
      open(np, O_WRONLY|O_CREAT, mode);
  }
  ```

test "rank686: Dropbear scp rejects dot and empty remote filenames"
  lang c
  reject VYQL-PATH-006
  code
  ```
  int atomicio(int (*fn)(), int fd, char *buf, unsigned long n);
  int read(int fd, char *buf, unsigned long n);
  int open(const char *path, int flags, int mode);
  int snprintf(char *str, unsigned long size, const char *format, ...);
  unsigned long strlen(const char *s);
  char *strchr(const char *s, int c);
  int strcmp(const char *a, const char *b);
  void exit(int);
  #define O_WRONLY 1
  #define O_CREAT 64
  #define NULL ((void*)0)

  int remin, targisdir;
  char *targ;

  void sink(int argc, char **argv) {
      char ch, *cp, *np, buf[2048];
      char *namebuf;
      unsigned long need;
      int mode = 0644;

      cp = buf;
      atomicio(read, remin, cp, 1);
      while (cp < &buf[sizeof(buf) - 1] && ch != '\n') {
          atomicio(read, remin, &ch, sizeof(ch));
          *cp++ = ch;
      }
      *cp = 0;
      cp = buf;
      if (*cp++ != ' ')
          exit(1);
      if (*cp == '\0' || strchr(cp, '/') != NULL ||
          strcmp(cp, ".") == 0 || strcmp(cp, "..") == 0) {
          exit(1);
      }
      if (targisdir) {
          need = strlen(targ) + strlen(cp) + 250;
          snprintf(namebuf, need, "%s%s%s", targ, strcmp(targ, "/") ? "/" : "", cp);
          np = namebuf;
      } else {
          np = targ;
      }
      open(np, O_WRONLY|O_CREAT, mode);
  }
  ```

test "rank686: remote listing download path generalizes across names"
  lang c
  expect VYQL-PATH-006
  code
  ```
  char *strchr(const char *s, int c);
  int strcmp(const char *a, const char *b);
  int snprintf(char *str, unsigned long size, const char *format, ...);
  int open(const char *path, int flags, int mode);
  #define O_WRONLY 1
  #define O_CREAT 64
  #define NULL ((void*)0)

  void receive(char *remote_name, char *target_dir, char *joined) {
    if (strchr(remote_name, '/') != NULL || strcmp(remote_name, "..") == 0) {
      return;
    }
    snprintf(joined, 4096, "%s/%s", target_dir, remote_name);
    open(joined, O_WRONLY|O_CREAT, 0644);
  }
  ```
