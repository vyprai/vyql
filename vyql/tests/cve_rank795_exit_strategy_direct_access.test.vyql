# Rank 795 / CVE-2013-10024: Exit Strategy plugin allowed direct execution of
# the plugin file before WordPress loaded, exposing PHP full paths through
# undefined WordPress API calls.

test "rank795: WordPress plugin direct access lacks loader guard"
  lang php
  file exitpage.php
  expect VYQL-SEC-004
  expect_review code.AbsolutePathDisclosure
  code
  ```
  <?php
  /*
  Plugin Name: Wordpress Exit Strategy
  Version: 1.55
  */

  add_option("exitpagecontents", "body", "Contents of the Exit page", "yes");
  add_action("wp_head", "autoredirect");
  add_action("admin_menu", "exitpageadmin");
  function exitpageadmin() {
      add_options_page("Exit page admin", "Exit Strategy", 8, __file__, "exit_page_admin");
  }
  ```

test "rank795: WordPress plugin direct access guarded before WP APIs"
  lang php
  file exitpage.php
  reject VYQL-SEC-004
  reject_review code.AbsolutePathDisclosure
  code
  ```
  <?php
  /*
  Plugin Name: Wordpress Exit Strategy
  Version: 1.59
  */

  if (!function_exists("add_action")) {
      echo "";
      die;
  }
  add_option("exitpagecontents", "body", "Contents of the Exit page", "yes");
  add_action("wp_head", "autoredirect");
  add_action("admin_menu", "exitpageadmin");
  function exitpageadmin() {
      add_options_page("Exit page admin", "Exit Strategy", 8, __file__, "exit_page_admin");
  }
  ```
