# OWASP-replica coverage for Perl — true positive plus opaque-predicate pruning.

test "perl: CGI param -> system is command injection"
  lang perl
  expect VYQL-INJ-002
  code
  ```
  sub h {
    my $cgi = CGI->new;
    my $x = $cgi->param('id');
    system("echo " . $x);
  }
  ```

test "perl: tainted assign in a live branch is still cmdi (no FN)"
  lang perl
  expect VYQL-INJ-002
  code
  ```
  sub h {
    my $cgi = CGI->new;
    my $x = $cgi->param('id');
    my $c = "ls";
    if (1 < 100) { $c = $x; }
    system("echo " . $c);
  }
  ```

test "perl: opaque-false if taints only the dead branch — clean cmdi"
  lang perl
  reject VYQL-INJ-002
  code
  ```
  sub h {
    my $cgi = CGI->new;
    my $x = $cgi->param('id');
    my $c = "ls";
    if (1 > 100) { $c = $x; }
    system("echo " . $c);
  }
  ```

test "perl: opaque-false ternary selects the clean arm — clean cmdi"
  lang perl
  reject VYQL-INJ-002
  code
  ```
  sub h {
    my $cgi = CGI->new;
    my $x = $cgi->param('id');
    my $c = (1 > 100) ? $x : "ls";
    system("echo " . $c);
  }
  ```
