test "rank845: fixed chunk growth can underallocate before indexing"
  lang c
  file funcs.c
  expect VYQL-MEM-042
  expect_review code.FixedChunkCapacityGrowthIndex
  code
  ```
  #include <stdlib.h>

  struct level_info {
    int got_match;
  };

  struct cont {
    unsigned int len;
    struct level_info *li;
  };

  struct magic_set {
    struct cont c;
  };

  int file_check_mem(struct magic_set *ms, unsigned int level) {
    size_t len;

    if (level >= ms->c.len) {
      len = (ms->c.len += 20) * sizeof(*ms->c.li);
      ms->c.li = (ms->c.li == 0) ? malloc(len) : realloc(ms->c.li, len);
      if (ms->c.li == 0) {
        return -1;
      }
    }
    ms->c.li[level].got_match = 0;
    return 0;
  }
  ```

test "rank845: capacity grown to requested level suppresses fixed chunk finding"
  lang c
  file funcs.c
  reject VYQL-MEM-042
  reject_review code.FixedChunkCapacityGrowthIndex
  code
  ```
  #include <stdlib.h>

  struct level_info {
    int got_match;
  };

  struct cont {
    unsigned int len;
    struct level_info *li;
  };

  struct magic_set {
    struct cont c;
  };

  int file_check_mem(struct magic_set *ms, unsigned int level) {
    size_t len;

    if (level >= ms->c.len) {
      len = (ms->c.len = 20 + level) * sizeof(*ms->c.li);
      ms->c.li = (ms->c.li == 0) ? malloc(len) : realloc(ms->c.li, len);
      if (ms->c.li == 0) {
        return -1;
      }
    }
    ms->c.li[level].got_match = 0;
    return 0;
  }
  ```
