test "rank149: AUSF resync dereferences context without existence checks"
  lang go
  expect VYQL-MEM-006
  code
  ```
  package processor

  import (
      ausf_context "github.com/free5gc/ausf/internal/context"
      "github.com/free5gc/openapi/models"
  )

  type Processor struct{}
  type Ctx struct{}

  func (p *Processor) UeAuthPostRequestProcedure(c *Ctx, updateAuthenticationInfo models.AuthenticationInfo) {
      supiOrSuci := updateAuthenticationInfo.SupiOrSuci
      if updateAuthenticationInfo.ResynchronizationInfo != nil {
          ausfCurrentSupi := ausf_context.GetSupiFromSuciSupiMap(supiOrSuci)
          ausfCurrentContext := ausf_context.GetAusfUeContext(ausfCurrentSupi)
          if updateAuthenticationInfo.ResynchronizationInfo.Rand == "" {
              updateAuthenticationInfo.ResynchronizationInfo.Rand = ausfCurrentContext.Rand
          }
          lastEapID := ausfCurrentContext.EapID
          _ = lastEapID
      }
  }
  ```

test "rank149: AUSF resync checks mapping and context before dereference"
  lang go
  reject VYQL-MEM-006
  code
  ```
  package processor

  import (
      ausf_context "github.com/free5gc/ausf/internal/context"
      "github.com/free5gc/openapi/models"
  )

  type Processor struct{}
  type Ctx struct{}

  func (p *Processor) UeAuthPostRequestProcedure(c *Ctx, updateAuthenticationInfo models.AuthenticationInfo) {
      supiOrSuci := updateAuthenticationInfo.SupiOrSuci
      if updateAuthenticationInfo.ResynchronizationInfo != nil {
          if !ausf_context.CheckIfSuciSupiPairExists(supiOrSuci) {
              return
          }
          ausfCurrentSupi := ausf_context.GetSupiFromSuciSupiMap(supiOrSuci)
          if !ausf_context.CheckIfAusfUeContextExists(ausfCurrentSupi) {
              return
          }
          ausfCurrentContext := ausf_context.GetAusfUeContext(ausfCurrentSupi)
          if updateAuthenticationInfo.ResynchronizationInfo.Rand == "" {
              updateAuthenticationInfo.ResynchronizationInfo.Rand = ausfCurrentContext.Rand
          }
          lastEapID := ausfCurrentContext.EapID
          _ = lastEapID
      }
  }
  ```
