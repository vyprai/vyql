# Rank 919 / CVE-2022-21685: Frontier ModExp gas accounting subtracted one
# from a zero exponent bit length before adding the positive exponent-length term.

test "rank919: modexp zero exponent bit length underflows before addition"
  lang rust
  file lib.rs
  expect VYQL-NUM-016
  expect_review code.ModexpZeroExponentIterationUnderflow
  code
  ```
  fn calculate_iteration_count(exp_length: u64, exponent: &BigUint) -> u64 {
      let mut iteration_count = 0;
      if exp_length > 32 {
          let bytes: [u8; 32] = [0xFF; 32];
          let max_256_bit_uint = BigUint::from_bytes_be(&bytes);
          iteration_count =
              (8 * (exp_length - 32)) + ((exponent.bitand(max_256_bit_uint)).bits() - 1);
      }
      max(iteration_count, 1)
  }
  ```

test "rank919: modexp zero exponent subtracts after positive length addition"
  lang rust
  file lib.rs
  reject VYQL-NUM-016
  reject_review code.ModexpZeroExponentIterationUnderflow
  code
  ```
  fn calculate_iteration_count(exp_length: u64, exponent: &BigUint) -> u64 {
      let mut iteration_count = 0;
      if exp_length > 32 {
          let bytes: [u8; 32] = [0xFF; 32];
          let max_256_bit_uint = BigUint::from_bytes_be(&bytes);
          iteration_count =
              (8 * (exp_length - 32)) + exponent.bitand(max_256_bit_uint).bits() - 1;
      }
      max(iteration_count, 1)
  }
  ```
