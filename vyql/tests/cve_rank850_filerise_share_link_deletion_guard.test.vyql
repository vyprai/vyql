# Rank 850 / CVE-2026-33070: FileRise deleted public share links by
# request token before requiring an authenticated, CSRF-protected admin request.

test "rank850: php share-link deletion without auth and CSRF guards"
  lang php
  file FileController.php
  expect VYQL-AUTH-059
  expect_review code.ShareLinkDeletionMissingAuthGuard
  code
  ```
  <?php
  class FileController {
      public function deleteShareLink()
      {
          header('Content-Type: application/json');
          $token = $_POST['token'] ?? '';
          if (!$token) {
              echo json_encode(['success' => false, 'error' => 'No token provided']);
              return;
          }

          $deleted = null;
          $sourceId = $this->normalizeSourceId($_POST['sourceId'] ?? '');
          if ($sourceId !== '' && class_exists('SourceContext') && SourceContext::sourcesEnabled()) {
              $perms = $this->loadPerms($_SESSION['username'] ?? '');
              if ($this->isAdmin($perms)) {
                  $deleted = $this->withSourceContext($sourceId, function () use ($token) {
                      return FileModel::deleteShareLink($token);
                  }, true);
              }
          }
          if ($deleted === null) {
              $deleted = FileModel::deleteShareLink($token);
          }
          echo json_encode($deleted ? ['success' => true] : ['success' => false]);
      }
  }
  ?>
  ```

test "rank850: php share-link deletion with auth and CSRF guards"
  lang php
  file FileController.php
  reject VYQL-AUTH-059
  reject_review code.ShareLinkDeletionMissingAuthGuard
  code
  ```
  <?php
  class FileController {
      public function deleteShareLink()
      {
          $this->jsonStart();
          if (!$this->checkCsrf()) {
              return;
          }
          if (!$this->requireAuth()) {
              return;
          }
          $username = $_SESSION['username'] ?? '';
          $perms = $this->loadPerms($username);
          if (!$this->isAdmin($perms)) {
              $this->jsonOut(['success' => false, 'error' => 'Admin only'], 403);
              return;
          }

          $token = $_POST['token'] ?? '';
          if (!$token) {
              $this->jsonOut(['success' => false, 'error' => 'No token provided'], 400);
              return;
          }
          $deleted = FileModel::deleteShareLink($token);
          $this->jsonOut($deleted ? ['success' => true] : ['success' => false]);
      }
  }
  ?>
  ```
