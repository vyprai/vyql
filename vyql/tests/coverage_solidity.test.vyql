# Solidity coverage breadth: tx.origin authorization anti-pattern.

test "solidity: tx.origin used for authorization is CWE-477"
  lang solidity
  expect VYQL-SC-003
  code
  ```
  contract C {
    address owner;
    function withdraw() public {
      require(tx.origin == owner);
      payable(msg.sender).transfer(address(this).balance);
    }
  }
  ```

test "solidity: msg.sender authorization is clean (no tx.origin)"
  lang solidity
  reject VYQL-SC-003
  code
  ```
  contract C {
    address owner;
    function withdraw() public {
      require(msg.sender == owner);
      payable(msg.sender).transfer(address(this).balance);
    }
  }
  ```
