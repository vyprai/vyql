# Go core-language exhaustive coverage for adapter-claimed backend idioms.

test "go exhaustive: HTTP input reaches SQL command dynamic-load SSRF path upload and archive sinks"
  lang go
  expect VYQL-INJ-001
  expect VYQL-INJ-002
  expect VYQL-INJ-023
  expect VYQL-RF-001
  expect VYQL-PATH-001
  expect VYQL-INJ-015
  expect VYQL-PATH-004
  code
  ```
  package main
  func h(w http.ResponseWriter, r *http.Request, db *sql.DB) {
    v := r.URL.Query().Get("v")
    db.Query(v)
    exec.Command("sh", "-c", v).Run()
    plugin.Open(v)
    http.Get(v)
    os.Open(v)
    os.Create(v)
    extractEntry(v)
  }
  ```

test "go exhaustive: constants and filepath.Base suppress command path upload archive and SSRF findings"
  lang go
  reject VYQL-INJ-001
  reject VYQL-INJ-002
  reject VYQL-INJ-023
  reject VYQL-RF-001
  reject VYQL-PATH-001
  reject VYQL-INJ-015
  reject VYQL-PATH-004
  code
  ```
  package main
  func h(w http.ResponseWriter, r *http.Request, db *sql.DB) {
    p := filepath.Base(r.URL.Query().Get("p"))
    db.Query("select 1")
    exec.Command("sh", "-c", "whoami").Run()
    plugin.Open("safe.so")
    http.Get("https://example.com")
    os.Open(p)
    os.Create("uploads/fixed.dat")
    extractEntry(p)
  }
  ```

