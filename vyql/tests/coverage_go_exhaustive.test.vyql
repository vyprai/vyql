test "go exhaustive: HTML header log CSV LDAP XPath regex trust auth and IDOR findings are reported"
  lang go
  expect VYQL-INJ-004
  expect VYQL-INJ-010
  expect VYQL-INJ-009
  expect VYQL-INJ-014
  expect VYQL-INJ-005
  expect VYQL-INJ-006
  expect VYQL-DOS-001
  expect VYQL-CFG-014
  expect VYQL-AUTH-001
  expect VYQL-AUTH-002
  code
  ```
  package main
  func h(w http.ResponseWriter, r *http.Request, ldap *ldap.Conn, doc *xpath.Doc, sess *session.Store, repo Repo, writer *csv.Writer) {
    v := r.URL.Query().Get("v")
    template.HTML(v)
    w.Header().Set("X-Name", v)
    log.Print(v)
    writer.Write([]string{v})
    ldap.Search(v)
    doc.XPath(v)
    regexp.Compile(v)
    sess.Set("role", v)
    ChangePassword(v)
    repo.FindByID(r.URL.Query().Get("id"))
  }
  ```

test "go exhaustive: encoders validators constants and guards suppress web trust auth and IDOR findings"
  lang go
  reject VYQL-INJ-004
  reject VYQL-INJ-010
  reject VYQL-INJ-009
  reject VYQL-INJ-014
  reject VYQL-INJ-005
  reject VYQL-INJ-006
  reject VYQL-DOS-001
  reject VYQL-CFG-014
  reject VYQL-AUTH-001
  reject VYQL-AUTH-002
  code
  ```
  package main
  func h(w http.ResponseWriter, r *http.Request, ldap *ldap.Conn, doc *xpath.Doc, sess *session.Store, repo Repo, writer *csv.Writer) {
    v := r.URL.Query().Get("v")
    template.HTML(html.EscapeString(v))
    w.Header().Set("X-Name", "safe")
    log.Print("safe")
    writer.Write([]string{"safe"})
    ldap.Search(support.EscapeLDAP(v))
    doc.XPath(support.XPathLiteral(v))
    regexp.Compile("^[a-z]+$")
    sess.Set("role", support.AllowRole(v))
    RequireAuth(r)
    ChangePassword("system")
    CheckOwnership(r.URL.Query().Get("id"))
    repo.FindByID(r.URL.Query().Get("id"))
  }
  ```

test "go exhaustive: crypto config permission temp cleartext resource and lock findings are reported"
  lang go
  expect VYQL-CRY-001
  expect VYQL-CRY-002
  expect VYQL-CRY-003
  expect VYQL-CRY-004
  expect VYQL-CFG-003
  expect VYQL-CFG-004
  expect VYQL-CFG-005
  expect VYQL-CFG-006
  expect VYQL-CFG-007
  expect VYQL-CFG-008
  expect VYQL-CFG-009
  expect VYQL-PATH-003
  expect VYQL-RES-001
  expect VYQL-LIFE-001
  code
  ```
  package main
  func h(w http.ResponseWriter, mu *sync.Mutex) {
    md5.New()
    des.NewCipher(key)
    cipher.NewCBCEncrypter(block, []byte("0000000000000000"))
    rand.Intn(10)
    os.Chmod("/tmp/x", 0777)
    os.Create("/tmp/fixed")
    tls.Config{InsecureSkipVerify: true}
    parser.ParseUnverified(token, claims)
    http.Get("http://example.com")
    http.Cookie{HttpOnly: false, Secure: false}
    w.Header().Set("Access-Control-Allow-Origin", "*")
    w.Header().Set("X-Frame-Options", "ALLOWALL")
    net.Dial("tcp", "example.com:443")
    mu.Lock()
  }
  ```

test "go exhaustive: stronger crypto secure config closed resources and unlocked locks are clean"
  lang go
  reject VYQL-CRY-001
  reject VYQL-CRY-002
  reject VYQL-CRY-003
  reject VYQL-CRY-004
  reject VYQL-CFG-003
  reject VYQL-CFG-004
  reject VYQL-CFG-005
  reject VYQL-CFG-006
  reject VYQL-CFG-007
  reject VYQL-CFG-008
  reject VYQL-CFG-009
  reject VYQL-PATH-003
  reject VYQL-RES-001
  reject VYQL-LIFE-001
  code
  ```
  package main
  func h(w http.ResponseWriter, mu *sync.Mutex) {
    sha256.New()
    aes.NewCipher(key)
    cipher.NewCBCEncrypter(block, iv)
    cryptoRand.Read(buf)
    os.Chmod("/tmp/x", 0600)
    os.CreateTemp("", "safe")
    tls.Config{InsecureSkipVerify: false}
    http.Get("https://example.com")
    http.Get("http://127.0.0.1:8080")
    http.Cookie{HttpOnly: true, Secure: true}
    w.Header().Set("Access-Control-Allow-Origin", "https://example.com")
    w.Header().Set("X-Frame-Options", "DENY")
    c, _ := net.Dial("tcp", "example.com:443")
    c.Close()
    mu.Lock()
    mu.Unlock()
  }
  ```

test "go exhaustive: public HTML helper return is an XSS sink"
  lang go
  profile library
  expect VYQL-INJ-004
  code
  ```
  package themes

  import "bytes"

  func MessagePageBytes(title string, body []byte, theme string) []byte {
    var buf bytes.Buffer
    buf.WriteString("<!doctype html><html><head><title>")
    buf.WriteString(title)
    buf.WriteString("</title></head><body><h1>")
    buf.WriteString(title)
    buf.WriteString("</h1>")
    buf.Write(body)
    return buf.Bytes()
  }
  ```

test "go exhaustive: gin response writer string is an XSS sink"
  lang go
  expect VYQL-INJ-004
  code
  ```
  package controllers

  import (
    "fmt"
    "github.com/gin-gonic/gin"
  )

  func Plist(c *gin.Context) {
    name := c.Param("data")
    plist := fmt.Sprintf("<plist><string>%s</string></plist>", name)
    c.Writer.WriteString(plist)
  }
