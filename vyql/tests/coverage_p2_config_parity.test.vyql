# --- Insecure permissions (VYQL-CFG-008) ---
test "c: chmod 0777 is insecure permission"
  lang c
  expect VYQL-CFG-008
  code
  ```
  int main(){ chmod("/tmp/x", 0777); return 0; }
  ```

test "c: chmod 0600 is clean"
  lang c
  reject VYQL-CFG-008
  code
  ```
  int main(){ chmod("/tmp/x", 0600); return 0; }
  ```

test "cpp: chmod 0777 is insecure permission"
  lang cpp
  expect VYQL-CFG-008
  code
  ```
  int main(){ chmod("/tmp/x", 0777); return 0; }
  ```

test "cpp: chmod 0600 is clean"
  lang cpp
  reject VYQL-CFG-008
  code
  ```
  int main(){ chmod("/tmp/x", 0600); return 0; }
  ```

test "java: setWritable true false is insecure permission"
  lang java
  expect VYQL-CFG-008
  code
  ```
  class C { void f(File file) { file.setWritable(true, false); } }
  ```

test "java: owner-only setWritable is clean"
  lang java
  reject VYQL-CFG-008
  code
  ```
  class C { void f(File file) { file.setWritable(true, true); } }
  ```

test "php: chmod 0777 is insecure permission"
  lang php
  expect VYQL-CFG-008
  code
  ```
  <?php chmod("/tmp/x", 0777);
  ```

test "php: chmod 0600 is clean"
  lang php
  reject VYQL-CFG-008
  code
  ```
  <?php chmod("/tmp/x", 0600);
  ```

test "ruby: File.chmod 0777 is insecure permission"
  lang ruby
  expect VYQL-CFG-008
  code
  ```
  File.chmod(0777, "/tmp/x")
  ```

test "ruby: File.chmod 0600 is clean"
  lang ruby
  reject VYQL-CFG-008
  code
  ```
  File.chmod(0600, "/tmp/x")
  ```

test "csharp: OtherWrite unix file mode is insecure permission"
  lang csharp
  expect VYQL-CFG-008
  code
  ```
  class C { void F() { File.SetUnixFileMode("/tmp/x", UnixFileMode.OtherWrite); } }
  ```

test "csharp: UserRead unix file mode is clean"
  lang csharp
  reject VYQL-CFG-008
  code
  ```
  class C { void F() { File.SetUnixFileMode("/tmp/x", UnixFileMode.UserRead); } }
  ```

test "go: Chmod 0777 is insecure permission"
  lang go
  expect VYQL-CFG-008
  code
  ```
  package p
  import "os"
  func f() {
    os.Chmod("/tmp/x", 0777)
  }
  ```

test "go: Chmod 0600 is clean"
  lang go
  reject VYQL-CFG-008
  code
  ```
  package p
  import "os"
  func f() {
    os.Chmod("/tmp/x", 0600)
  }
  ```

test "python: chmod 0o777 is insecure permission"
  lang python
  expect VYQL-CFG-008
  code
  ```
  import os
  def f():
      os.chmod("/tmp/x", 0o777)
  ```

test "python: chmod 0o600 is clean"
  lang python
  reject VYQL-CFG-008
  code
  ```
  import os
  def f():
      os.chmod("/tmp/x", 0o600)
  ```

# --- Insecure temp file (VYQL-PATH-003) ---
test "cpp: mktemp is insecure temp file"
  lang cpp
  expect VYQL-PATH-003
  code
  ```
  int main(){ char *p = mktemp("/tmp/fooXXXXXX"); return 0; }
  ```

test "cpp: mkstemp is clean"
  lang cpp
  reject VYQL-PATH-003
  code
  ```
  int main(){ int fd = mkstemp("/tmp/fooXXXXXX"); return fd; }
  ```

test "c: mktemp is insecure temp file"
  lang c
  expect VYQL-PATH-003
  code
  ```
  int main(){ char *p = mktemp("/tmp/fooXXXXXX"); return 0; }
  ```

test "c: mkstemp is clean"
  lang c
  reject VYQL-PATH-003
  code
  ```
  int main(){ int fd = mkstemp("/tmp/fooXXXXXX"); return fd; }
  ```

test "python: tempfile.mktemp is insecure temp file"
  lang python
  expect VYQL-PATH-003
  code
  ```
  import tempfile
  def f():
      tempfile.mktemp()
  ```

test "python: NamedTemporaryFile is clean"
  lang python
  reject VYQL-PATH-003
  code
  ```
  import tempfile
  def f():
      tempfile.NamedTemporaryFile()
  ```

test "java: fixed file create under tmp is insecure temp file"
  lang java
  expect VYQL-PATH-003
  code
  ```
  class C {
    void f() throws Exception {
      Files.createFile(Paths.get("/tmp/vyql-fixed-name"));
    }
  }
  ```

test "java: createTempFile is clean"
  lang java
  reject VYQL-PATH-003
  code
  ```
  class C {
    void f() throws Exception {
      Files.createTempFile("vyql", ".tmp");
    }
  }
  ```

test "go: fixed os.Create under tmp is insecure temp file"
  lang go
  expect VYQL-PATH-003
  code
  ```
  package p
  import "os"
  func f() {
    os.Create("/tmp/vyql-fixed-name")
  }
  ```

test "go: CreateTemp is clean"
  lang go
  reject VYQL-PATH-003
  code
  ```
  package p
  import "os"
  func f() {
    os.CreateTemp("", "vyql-*")
  }
  ```

test "php: fixed fopen write under tmp is insecure temp file"
  lang php
  expect VYQL-PATH-003
  code
  ```
  <?php function f(){ fopen("/tmp/vyql-fixed-name", "w"); }
  ```

test "php: tmpfile is clean"
  lang php
  reject VYQL-PATH-003
  code
  ```
  <?php function f(){ tmpfile(); }
  ```

test "ruby: fixed File.open write under tmp is insecure temp file"
  lang ruby
  expect VYQL-PATH-003
  code
  ```
  def f
    File.open("/tmp/vyql-fixed-name", "w")
  end
  ```

test "ruby: Tempfile.new is clean"
  lang ruby
  reject VYQL-PATH-003
  code
  ```
  def f
    Tempfile.new("vyql")
  end
  ```
