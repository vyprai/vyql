# P2 parity: config/crypto presence checks with positive and negative fixtures.

# --- Certificate validation disabled (VYQL-CFG-004) ---
test "java: hostname verifier returning true disables cert validation"
  lang java
  expect VYQL-CFG-004
  code
  ```
  class C { void f(Client client) { client.setHostnameVerifier((host, session) -> true); } }
  ```

test "java: hostname verifier returning false is clean"
  lang java
  reject VYQL-CFG-004
  code
  ```
  class C { void f(Client client) { client.setHostnameVerifier((host, session) -> false); } }
  ```

test "kotlin: NoopHostnameVerifier disables cert validation"
  lang kotlin
  expect VYQL-CFG-004
  code
  ```
  fun f(client: Client) {
    client.setHostnameVerifier(NoopHostnameVerifier.INSTANCE)
  }
  ```

test "kotlin: default hostname verifier is clean"
  lang kotlin
  reject VYQL-CFG-004
  code
  ```
  fun f(client: Client) {
    client.setHostnameVerifier(DefaultHostnameVerifier.INSTANCE)
  }
  ```

test "csharp: dangerous certificate validator disables cert validation"
  lang csharp
  expect VYQL-CFG-004
  code
  ```
  class C { void F() { var v = HttpClientHandler.DangerousAcceptAnyServerCertificateValidator; } }
  ```

test "csharp: default handler has no cert validation disablement"
  lang csharp
  reject VYQL-CFG-004
  code
  ```
  class C { void F() { var handler = new HttpClientHandler(); } }
  ```

test "swift: allowing any HTTPS certificate disables validation"
  lang swift
  expect VYQL-CFG-004
  code
  ```
  func f(session: Session) {
    session.allowsAnyHTTPSCertificate(true)
  }
  ```

test "swift: rejecting arbitrary HTTPS certificates is clean"
  lang swift
  reject VYQL-CFG-004
  code
  ```
  func f(session: Session) {
    session.allowsAnyHTTPSCertificate(false)
  }
  ```

test "javascript: rejectUnauthorized false disables cert validation"
  lang javascript
  expect VYQL-CFG-004
  code
  ```
  const https = require("https");
  function f() {
    https.request({ rejectUnauthorized: false });
  }
  ```

test "javascript: rejectUnauthorized true is clean"
  lang javascript
  reject VYQL-CFG-004
  code
  ```
  const https = require("https");
  function f() {
    https.request({ rejectUnauthorized: true });
  }
  ```

test "python: requests verify false disables cert validation"
  lang python
  expect VYQL-CFG-004
  code
  ```
  import requests
  def f():
      requests.get("https://example.com", verify=False)
  ```

test "python: requests verify true is clean"
  lang python
  reject VYQL-CFG-004
  code
  ```
  import requests
  def f():
      requests.get("https://example.com", verify=True)
  ```

test "php: curl verify peer false disables cert validation"
  lang php
  expect VYQL-CFG-004
  code
  ```
  <?php
  function f($ch) {
      curl_setopt_array($ch, [CURLOPT_SSL_VERIFYPEER => false]);
  }
  ?>
  ```

test "php: curl verify peer true is clean"
  lang php
  reject VYQL-CFG-004
  code
  ```
  <?php
  function f($ch) {
      curl_setopt_array($ch, [CURLOPT_SSL_VERIFYPEER => true]);
  }
  ?>
  ```

test "go: InsecureSkipVerify true disables cert validation"
  lang go
  expect VYQL-CFG-004
  code
  ```
  package p
  import "crypto/tls"
  func f() {
    _ = &tls.Config{InsecureSkipVerify: true}
  }
  ```

test "go: InsecureSkipVerify false is clean"
  lang go
  reject VYQL-CFG-004
  code
  ```
  package p
  import "crypto/tls"
  func f() {
    _ = &tls.Config{InsecureSkipVerify: false}
  }
  ```

test "ruby: VERIFY_NONE disables cert validation"
  lang ruby
  expect VYQL-CFG-004
  code
  ```
  def f(http)
    http.verify_mode = OpenSSL::SSL::VERIFY_NONE
  end
  ```

test "ruby: VERIFY_PEER is clean for cert validation"
  lang ruby
  reject VYQL-CFG-004
  code
  ```
  def f(http)
    http.verify_mode = OpenSSL::SSL::VERIFY_PEER
  end
  ```

# --- CSRF disabled (VYQL-CFG-001) ---
test "javascript: lusca csrf false disables CSRF"
  lang javascript
  expect VYQL-CFG-001
  code
  ```
  app.use(lusca.csrf(false));
  ```

test "javascript: lusca csrf true is clean"
  lang javascript
  reject VYQL-CFG-001
  code
  ```
  app.use(lusca.csrf(true));
  ```

test "php: disabling VerifyCsrfToken middleware disables CSRF"
  lang php
  expect VYQL-CFG-001
  code
  ```
  <?php $this->withoutMiddleware("VerifyCsrfToken");
  ```

test "php: keeping auth middleware is clean for CSRF disabled"
  lang php
  reject VYQL-CFG-001
  code
  ```
  <?php $this->withoutMiddleware("Authenticate");
  ```

test "csharp: IgnoreAntiforgeryToken disables CSRF"
  lang csharp
  expect VYQL-CFG-001
  code
  ```
  class C { void F() { IgnoreAntiforgeryToken(); } }
  ```

test "csharp: ValidateAntiForgeryToken is clean"
  lang csharp
  reject VYQL-CFG-001
  code
  ```
  class C { void F() { ValidateAntiForgeryToken(); } }
  ```

test "java: csrf disable is reported"
  lang java
  expect VYQL-CFG-001
  code
  ```
  class C { void f(HttpSecurity http) { http.csrf().disable(); } }
  ```

test "java: csrf configured without disable is clean"
  lang java
  reject VYQL-CFG-001
  code
  ```
  class C { void f(HttpSecurity http) { http.csrf(); } }
  ```

test "kotlin: csrf disable is reported"
  lang kotlin
  expect VYQL-CFG-001
  code
  ```
  fun f(http: HttpSecurity) {
    http.csrf().disable()
  }
  ```

test "kotlin: csrf configured without disable is clean"
  lang kotlin
  reject VYQL-CFG-001
  code
  ```
  fun f(http: HttpSecurity) {
    http.csrf()
  }
  ```

test "ruby: skipping verify_authenticity_token disables CSRF"
  lang ruby
  expect VYQL-CFG-001
  code
  ```
  class ApplicationController
    skip_before_action :verify_authenticity_token
  end
  ```

test "ruby: skipping unrelated callback is clean for CSRF disabled"
  lang ruby
  reject VYQL-CFG-001
  code
  ```
  class ApplicationController
    skip_before_action :set_locale
  end
  ```

# --- JWT signature not verified (VYQL-CFG-005) ---
test "java: Algorithm.none is unverified JWT"
  lang java
  expect VYQL-CFG-005
  code
  ```
  class C { void f(String token) { JWT.require(Algorithm.none()).build().verify(token); } }
  ```

test "java: HMAC algorithm is clean for JWT verification"
  lang java
  reject VYQL-CFG-005
  code
  ```
  class C { void f(String token) { JWT.require(Algorithm.HMAC256("k")).build().verify(token); } }
  ```

test "go: ParseUnverified is unverified JWT"
  lang go
  expect VYQL-CFG-005
  code
  ```
  package p
  func f(token string, claims Claims) {
    jwt.ParseUnverified(token, claims)
  }
  ```

test "go: ParseWithClaims is clean for JWT verification"
  lang go
  reject VYQL-CFG-005
  code
  ```
  package p
  func f(token string, claims Claims) {
    jwt.ParseWithClaims(token, claims, keyfunc)
  }
  ```

test "javascript: algorithms none is unverified JWT"
  lang javascript
  expect VYQL-CFG-005
  code
  ```
  const jwt = require("jsonwebtoken");
  function f(token) {
    jwt.verify(token, "k", { algorithms: ["none"] });
  }
  ```

test "javascript: HS256 algorithm is clean for JWT verification"
  lang javascript
  reject VYQL-CFG-005
  code
  ```
  const jwt = require("jsonwebtoken");
  function f(token) {
    jwt.verify(token, "k", { algorithms: ["HS256"] });
  }
  ```

test "python: verify_signature false is unverified JWT"
  lang python
  expect VYQL-CFG-005
  code
  ```
  import jwt
  def f(token):
      jwt.decode(token, options={"verify_signature": False})
  ```

test "python: verify_signature true is clean for JWT verification"
  lang python
  reject VYQL-CFG-005
  code
  ```
  import jwt
  def f(token):
      jwt.decode(token, options={"verify_signature": True})
  ```

test "php: none algorithm is unverified JWT"
  lang php
  expect VYQL-CFG-005
  code
  ```
  <?php
  function f($token) {
      JWT::decode($token, "k", ["none"]);
  }
  ?>
  ```

test "php: HS256 algorithm is clean for JWT verification"
  lang php
  reject VYQL-CFG-005
  code
  ```
  <?php
  function f($token) {
      JWT::decode($token, "k", ["HS256"]);
  }
  ?>
  ```

test "ruby: verify false is unverified JWT"
  lang ruby
  expect VYQL-CFG-005
  code
  ```
  def f(token)
    JWT.decode(token, nil, false)
  end
  ```

test "ruby: verify true is clean for JWT verification"
  lang ruby
  reject VYQL-CFG-005
  code
  ```
  def f(token)
    JWT.decode(token, "k", true)
  end
  ```

test "csharp: RequireSignedTokens false is unverified JWT"
  lang csharp
  expect VYQL-CFG-005
  code
  ```
  class C {
    void F() {
      var p = new TokenValidationParameters { RequireSignedTokens = false };
    }
  }
  ```

test "csharp: RequireSignedTokens true is clean for JWT verification"
  lang csharp
  reject VYQL-CFG-005
  code
  ```
  class C {
    void F() {
      var p = new TokenValidationParameters { RequireSignedTokens = true };
    }
  }
  ```

test "csharp: ValidateIssuerSigningKey false is unverified JWT"
  lang csharp
  expect VYQL-CFG-005
  code
  ```
  class C {
    void F() {
      var p = new TokenValidationParameters { ValidateIssuerSigningKey = false };
    }
  }
