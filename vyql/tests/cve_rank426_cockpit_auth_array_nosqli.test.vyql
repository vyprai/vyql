# Rank 426 / CVE-2020-35846: Cockpit Auth::check accepted array
# auth[user]/auth[password] values before scalar type validation.

test "rank426: Cockpit auth check authenticates untyped auth array"
  lang php
  file Auth.php
  expect VYQL-INJ-082
  expect_review code.CockpitAuthArrayNosqlInjection
  code
  ```
  <?php
  namespace Cockpit\Controller;

  class Auth extends \LimeExtra\Controller {
      public function check() {
          if ($data = $this->param('auth')) {
              if (isset($data['user']) && $this->app->helper('utils')->isEmail($data['user'])) {
                  $data['email'] = $data['user'];
                  $data['user'] = '';
              }

              if (!$this->app->helper('csfr')->isValid('login', $this->param('csfr'), true)) {
                  return ['success' => false, 'error' => 'Csfr validation failed'];
              }

              $user = $this->module('cockpit')->authenticate($data);
              return $user ? ['success' => true] : ['success' => false];
          }
      }
  }
  ```

test "rank426: Cockpit auth check requires scalar credentials"
  lang php
  file Auth.php
  reject VYQL-INJ-082
  reject_review code.CockpitAuthArrayNosqlInjection
  code
  ```
  <?php
  namespace Cockpit\Controller;

  class Auth extends \LimeExtra\Controller {
      public function check() {
          if ($data = $this->param('auth')) {
              if (!\is_string($data['user']) || !\is_string($data['password'])) {
                  return ['success' => false, 'error' => 'Pre-condition failed'];
              }

              if (isset($data['user']) && $this->app->helper('utils')->isEmail($data['user'])) {
                  $data['email'] = $data['user'];
                  $data['user'] = '';
              }

              if (!$this->app->helper('csfr')->isValid('login', $this->param('csfr'), true)) {
                  return ['success' => false, 'error' => 'Csfr validation failed'];
              }

              $user = $this->module('cockpit')->authenticate($data);
              return $user ? ['success' => true] : ['success' => false];
          }
      }
  }
  ```
