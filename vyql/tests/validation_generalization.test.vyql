# Generalized coverage for external validation-style gaps. These are synthetic
# framework patterns only; they intentionally do not mirror any benchmark repo file.

test "validation: express render view name is classified as SSTI"
  lang javascript
  expect VYQL-INJ-008
  code
  ```
  app.get('/preview', (req, res) => {
    const view = req.query.view;
    res.render(view, { user: req.user });
  });
  ```

test "validation: mustache render template source is classified as SSTI"
  lang javascript
  expect VYQL-INJ-008
  code
  ```
  app.post('/tpl', (req, res) => {
    const template = req.body.template;
    res.send(Mustache.render(template, { ok: true }));
  });
  ```

test "validation: flask qualified render template string is SSTI"
  lang python
  expect VYQL-INJ-008
  code
  ```
  import flask

  @app.route('/tpl')
  def tpl():
      return flask.render_template_string(flask.request.args["template"])
  ```

test "validation: graphql resolver args flow to SQL query"
  lang javascript
  expect VYQL-INJ-001
  code
  ```
  const resolvers = {
    Query: {
      user: {
        resolve(parent, args) {
          return db.query("select * from users where id = " + args.id);
        }
      }
    }
  };
  ```

test "validation: graphql mutation args flow to Python SQL query"
  lang python
  expect VYQL-INJ-001
  code
  ```
  class UpdateUser(graphene.Mutation):
      def mutate(root, info, name):
          return db.execute("update users set name = '%s'" % name)
  ```

test "validation: weak JavaScript JWT secret is flagged"
  lang javascript
  expect VYQL-CFG-022
  code
  ```
  const jwt = require('jsonwebtoken');
  module.exports = token => jwt.verify(token, "secret");
  ```

test "validation: weak Python JWT secret is flagged"
  lang python
  expect VYQL-CFG-022
  code
  ```
  import jwt
  jwt.decode(token, "secret", algorithms=["HS256"])
  ```

test "validation: JSON object hardcoded credential is flagged"
  lang javascript
  expect VYQL-SEC-002
  code
  ```
  const cfg = { "password": "ProdPassw0rd!" };
  ```

test "validation: JavaScript request-promise URL fetch is SSRF"
  lang javascript
  expect VYQL-RF-001
  code
  ```
  app.get('/proxy', async (req, res) => {
    const body = await rp(req.query.url);
    res.send(body);
  });
  ```

test "validation: Python FileResponse path is traversal"
  lang python
  expect VYQL-PATH-001
  code
  ```
  from starlette.responses import FileResponse

  @app.get('/download')
  def download(path):
      return FileResponse(path)
  ```
