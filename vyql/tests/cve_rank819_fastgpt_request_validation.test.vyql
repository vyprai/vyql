# Rank 819 / CVE-2026-40252: FastGPT API handlers used request body/query
# fields directly in regex and Mongo query construction before schema parsing
# and regex escaping were added.

test "rank819: search key reaches regex compilation"
  expect VYQL-DOS-001
  graph
  ```
  node src core.UserControlledData
  node sink code.RegexCompileSink
  edge FLOWS src -> sink
  ```

test "rank819: request field reaches nosql query"
  expect VYQL-INJ-007
  graph
  ```
  node src core.UserControlledData
  node sink code.NosqlQuery
  edge FLOWS src -> sink
  ```

