test "rank604: websocket header option parsing uses whitespace regex split"
  lang javascript
  file 01_http.js
  expect VYQL-DOS-003
  expect_review code.CatastrophicRegex
  code
  ```
  const {
    ArrayPrototypeSome,
    StringPrototypeSplit,
    StringPrototypeToLowerCase,
  } = primordials;

  function upgradeWebSocket(request) {
    const upgrade = request.headers.get("upgrade");
    const upgradeHasWebSocketOption = upgrade !== null &&
      ArrayPrototypeSome(
        StringPrototypeSplit(upgrade, /\s*,\s*/),
        (option) => StringPrototypeToLowerCase(option) === "websocket",
      );
    if (!upgradeHasWebSocketOption) {
      throw new TypeError("Invalid Header");
    }
  }
  ```

test "rank604: websocket header option parsing splits comma then trims"
  lang javascript
  file 01_http.js
  reject VYQL-DOS-003
  reject_review code.CatastrophicRegex
  code
  ```
  const {
    ArrayPrototypeSome,
    StringPrototypeSplit,
    StringPrototypeToLowerCase,
    StringPrototypeTrim,
  } = primordials;

  function upgradeWebSocket(request) {
    const upgrade = request.headers.get("upgrade");
    const upgradeHasWebSocketOption = upgrade !== null &&
      ArrayPrototypeSome(
        StringPrototypeSplit(upgrade, ","),
        (option) =>
          StringPrototypeToLowerCase(StringPrototypeTrim(option)) === "websocket",
      );
    if (!upgradeHasWebSocketOption) {
      throw new TypeError("Invalid Header");
    }
  }
  ```
