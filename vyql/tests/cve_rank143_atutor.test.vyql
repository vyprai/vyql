# Rank 143 / CVE-2015-1583: ATutor's admin user creation form accepted a
# state-changing POST without a CSRF guard before inserting the new member.

test "rank143: php POST-driven insert through queryDB requires CSRF protection"
  lang php
  expect VYQL-RF-003
  code
  ```
  <?php
  admin_authenticate(AT_ADMIN_PRIV_USERS);

  if (isset($_POST['submit'])) {
    $sql = "INSERT INTO %smembers VALUES ('$_POST[login]', '$_POST[email]')";
    queryDB($sql, array(TABLE_PREFIX));
  }
  ?>
  ```

test "rank143: php POST-driven insert through queryDB with CSRF protection is clean"
  lang php
  reject VYQL-RF-003
  code
  ```
  <?php
  admin_authenticate(AT_ADMIN_PRIV_USERS);

  if (isset($_POST['submit'])) {
    csrf_token();
    $sql = "INSERT INTO %smembers VALUES ('$_POST[login]', '$_POST[email]')";
    queryDB($sql, array(TABLE_PREFIX));
  }
  ?>
  ```
