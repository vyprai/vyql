# Rank 249 / CVE-2025-13466: body-parser counted urlencoded
# parameters with String.split(...).length before enforcing parameterLimit,
# allocating an array proportional to attacker-controlled body size.

test "rank249: urlencoded parameter counting allocates split array before limit"
  lang javascript
  expect VYQL-DOS-007
  expect_review code.UnboundedDelimiterSplitCount
  code
  ```
  function parameterCount (body, limit) {
    var len = body.split('&').length

    return len > limit ? undefined : len - 1
  }
  ```

test "rank249: urlencoded parameter counting exits before unbounded split allocation"
  lang javascript
  reject VYQL-DOS-007
  reject_review code.UnboundedDelimiterSplitCount
  code
  ```
  function parameterCount (body, limit) {
    let count = 0
    let index = -1
    do {
      count++
      if (count > limit) return undefined
      index = body.indexOf('&', index + 1)
    } while (index !== -1)
    return count
  }
  ```
