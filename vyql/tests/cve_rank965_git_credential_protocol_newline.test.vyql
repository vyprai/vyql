# Rank 965 / CVE-2020-5260: Git's credential protocol writes line-oriented
# key=value records. A value containing a newline could inject a second record
# until credential_write_item rejected '\n' before fprintf.

test "rank965: credential writer emits values without newline validation"
  lang c
  profile api
  file credential.c
  expect VYQL-INJ-193
  expect_review code.CredentialProtocolNewlineInjection
  code
  ```
  #include <stdio.h>

  static void credential_write_item(FILE *fp, const char *key, const char *value)
  {
    if (!value)
      return;
    fprintf(fp, "%s=%s\n", key, value);
  }
  ```

test "rank965: credential writer rejects embedded newlines"
  lang c
  profile api
  file credential.c
  reject VYQL-INJ-193
  reject_review code.CredentialProtocolNewlineInjection
  code
  ```
  #include <stdio.h>
  #include <string.h>

  void die(const char *fmt, const char *key);

  static void credential_write_item(FILE *fp, const char *key, const char *value)
  {
    if (!value)
      return;
    if (strchr(value, '\n'))
      die("credential value for %s contains newline", key);
    fprintf(fp, "%s=%s\n", key, value);
  }
  ```
