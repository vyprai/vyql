# Rank 556 / CVE-2026-44312: css_parser disabled TLS certificate validation
# for HTTPS @import fetches.

test "rank556: css_parser disables TLS verification for HTTPS imports"
  lang ruby
  file lib/css_parser/parser.rb
  expect VYQL-CFG-004
  expect_review code.CertValidationDisabled
  code
  ```
  require 'net/http'
  require 'openssl'

  class Parser
    def read_remote_file(uri)
      if uri.scheme == 'https'
        http = Net::HTTP.new(uri.host, uri.port)
        http.use_ssl = true
        http.verify_mode = OpenSSL::SSL::VERIFY_NONE
      else
        http = Net::HTTP.new(uri.host, uri.port)
      end
      http.get(uri.request_uri)
    end
  end
  ```

test "rank556: css_parser verifies TLS certificates for HTTPS imports"
  lang ruby
  file lib/css_parser/parser.rb
  reject VYQL-CFG-004
  reject_review code.CertValidationDisabled
  code
  ```
  require 'net/http'
  require 'openssl'

  class Parser
    def read_remote_file(uri)
      http = Net::HTTP.new(uri.host, uri.port)
      if uri.scheme == 'https'
        http.use_ssl = true
        http.verify_mode = OpenSSL::SSL::VERIFY_PEER
      end
      http.get(uri.request_uri)
    end
  end
  ```

