# Business logic (graph specs) — unauthorized actions and invalid transitions.

test "an unguarded refund action (BIZ-001)"
  expect VYQL-BIZ-001
  graph
  ```
  node refund business.Refund
  ```

test "a refund action guarded by an authorization check is clean (BIZ-001)"
  reject VYQL-BIZ-001
  graph
  ```
  node refund business.Refund
  node authz core.AuthorizationCheck {coverage=endpoint}
  edge CHECKS authz -> refund
  ```

test "an invalid transition into Refunded (BIZ-002)"
  expect VYQL-BIZ-002
  graph
  ```
  node t1 analysis.Transition { machine = Order, from = Created, to = Refunded }
  ```

# Path-sensitive authorization (B1): a permission check suppresses only the actions it
# DOMINATES. These carry CFG metadata (region/order) and NO explicit CHECKS edge — the
# same dominance-label mechanism used by v2 coveredBy rules on real code.

test "path-sensitive authz: a check dominating the refund suppresses (BIZ-001)"
  reject VYQL-BIZ-001
  graph
  ```
  node authz core.AuthorizationCheck {region=/fn1, order=1, coverage=endpoint}
  node refund business.Refund {region=/fn1, order=5}
  ```

test "path-sensitive authz: a check in a sibling branch does NOT cover the refund (BIZ-001)"
  expect VYQL-BIZ-001
  graph
  ```
  node authz core.AuthorizationCheck {region=/fn1/if2.e, order=2, coverage=endpoint}
  node refund business.Refund {region=/fn1/if2.t, order=5}
  ```
