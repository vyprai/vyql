# Supply chain (graph specs) — vulnerable dependencies, reachability-gated.

test "a vulnerable dependency is flagged (SCA-001)"
  expect VYQL-SCA-001
  reject VYQL-SCA-002
  graph
  ```
  node dep sbom.VulnerableDependency
  label dep sbom.VulnerableDependencyFact
  ```

test "a reachable vulnerable dependency is higher severity (SCA-002)"
  expect VYQL-SCA-001
  expect VYQL-SCA-002
  graph
  ```
  node dep sbom.VulnerableDependency
  label dep sbom.VulnerableDependencyFact
  label dep sbom.ReachableSymbol
  ```

test "a typosquatting / known-bad dependency is flagged (SCA-003)"
  expect VYQL-SCA-003
  graph
  ```
  node dep sbom.SuspiciousDependency
  label dep sbom.SuspiciousDependencyFact
  ```

test "a confirmed-malicious dependency is flagged (SCA-004)"
  expect VYQL-SCA-004
  graph
  ```
  node dep sbom.MaliciousDependency
  label dep sbom.MaliciousDependencyFact
  ```

test "a vulnerable HTTP parser dependency is request-smuggling relevant (SCA-005)"
  expect VYQL-SCA-005
  graph
  ```
  node dep sbom.HttpRequestSmugglingDependency
  label dep sbom.HttpRequestSmugglingDependencyFact
  ```
