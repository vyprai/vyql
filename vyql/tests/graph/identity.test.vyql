# Identity & privilege (graph specs) — escalation paths and toxic combinations.

test "external principal escalates to admin (IDN-001)"
  expect VYQL-IDN-001
  graph
  ```
  node ext identity.ExternalPrincipal
  node admin identity.AdminPrivilege { priv_level = ADMIN }
  edge STEP ext -> admin { ability = sts:AssumeRole }
  ```

test "anonymous escalates to admin (IDN-002)"
  expect VYQL-IDN-002
  graph
  ```
  node anon identity.Anonymous
  node admin identity.AdminPrivilege { priv_level = ADMIN }
  edge STEP anon -> admin { ability = iam:PassRole }
  ```

test "CI principal escalates to super-admin (IDN-003)"
  expect VYQL-IDN-003
  graph
  ```
  node ci identity.CiPrincipal
  node sadmin identity.SuperAdminPrivilege { priv_level = SUPERADMIN }
  edge STEP ci -> sadmin { ability = iam:PutRolePolicy }
  ```

test "internet-reachable workload that can escalate to admin (IDN-004 toxic combo)"
  expect VYQL-IDN-004
  graph
  ```
  node internet cloud.Internet
  node pod cloud.Container
  node wid identity.WorkloadIdentity { workload = pod }
  node admin identity.AdminPrivilege { priv_level = ADMIN }
  edge NET internet -> pod { rule = sg-pub:8080 }
  edge STEP wid -> admin { ability = create-pod }
  ```
