# Runtime (graph specs) — rules over a pre-aggregated runtime snapshot.

test "connection to a known mining pool (RTM-001)"
  expect VYQL-RTM-001
  graph
  ```
  node pool cloud.Internet
  label pool threat.MiningPool
  node conn runtime.Connection { dst = pool }
  ```

test "process running an undeclared image is workload drift (RTM-002)"
  expect VYQL-RTM-002
  graph
  ```
  node proc runtime.Process { image = xmrig }
  ```

test "process running a declared image is clean (RTM-002)"
  reject VYQL-RTM-002
  graph
  ```
  node proc runtime.Process { image = nginx }
  ```

test "runtime http request reaches shell execution (RTM-003)"
  expect VYQL-RTM-003
  graph
  ```
  node req runtime.HttpRequest
  node sh runtime.ShellExecution
  edge FLOWS req -> sh
  ```
