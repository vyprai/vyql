# Rank 947 / CVE-2024-4701: Genie rejected exact ".." attachment filenames
# but allowed embedded dot segments before writing them below the attachment root.

test "rank947: attachment filename write rejects exact dotdot only"
  lang java
  file LocalFileSystemAttachmentServiceImpl.java
  expect VYQL-PATH-053
  expect_review code.EmbeddedDotSegmentFilenameWrite
  code
  ```
  import java.io.File;
  import java.io.InputStream;
  import java.nio.file.Files;
  import java.nio.file.Path;
  import java.util.Set;
  import org.springframework.core.io.Resource;

  class LocalFileSystemAttachmentServiceImpl {
      private Path attachmentsDirectoryPath;

      void saveAttachments(Set<Resource> attachments) throws Exception {
          Path attachmentsBasePath = attachmentsDirectoryPath.resolve("job");
          for (Resource attachment : attachments) {
              try (InputStream inputStream = attachment.getInputStream()) {
                  String filename = attachment.getFilename();
                  if (filename != null) {
                      if (filename.contains("/") || filename.contains("\\")
                          || filename.equals(".") || filename.equals("..")) {
                          throw new IllegalArgumentException(filename);
                      }

                      String attachmentCanonicalPath =
                          createTempFile(String.valueOf(attachmentsBasePath), filename).getCanonicalPath();
                      String baseCanonicalPath = new File(String.valueOf(attachmentsBasePath)).getCanonicalPath();
                      if (!attachmentCanonicalPath.startsWith(baseCanonicalPath)
                          || attachmentCanonicalPath.equals(baseCanonicalPath)) {
                          throw new IllegalArgumentException(filename);
                      }
                  }

                  Path attachmentPath = attachmentsBasePath.resolve(filename);
                  Files.copy(inputStream, attachmentPath);
              }
          }
      }

      File createTempFile(String attachmentsBasePath, String filename) {
          return new File(attachmentsBasePath, filename);
      }
  }
  ```

