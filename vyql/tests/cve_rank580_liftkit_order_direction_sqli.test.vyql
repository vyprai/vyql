test "rank580: query builder must allowlist ORDER BY direction"
  lang php
  expect VYQL-INJ-124
  code
  ```
  <?php
  abstract class Query
  {
      protected $orderBys = array();

      public function orderBy($field, $direction = 'ASC')
      {
          $this->orderBys[] = array(
              'field' => $this->filterIdentifier($field),
              'direction' => $direction,
          );
          return $this;
      }

      protected function processOrderBy()
      {
          if (empty($this->orderBys)) {
              return '';
          }
          $sql = "ORDER BY ";
          $orderBys = array();
          foreach ($this->orderBys as $orderBy) {
              $orderBys[] = $orderBy['field'] . ' ' . $orderBy['direction'];
          }
          return $sql . implode(', ', $orderBys);
      }
  }
  ```

test "rank580: query builder normalizes ORDER BY direction"
  lang php
  reject VYQL-INJ-124
  code
  ```
  <?php
  abstract class Query
  {
      const QUERY_ORDER_ASC = 'ASC';
      const QUERY_ORDER_DESC = 'DESC';

      protected $orderBys = array();

      public function orderBy($field, $direction = self::QUERY_ORDER_ASC)
      {
          $this->orderBys[] = array(
              'field' => $this->filterIdentifier($field),
              'direction' => $direction,
          );
          return $this;
      }

      protected function processOrderBy()
      {
          if (empty($this->orderBys)) {
              return '';
          }
          $sql = "ORDER BY ";
          $orderBys = array();
          foreach ($this->orderBys as $orderBy) {
              $direction = (strtoupper($orderBy['direction']) == self::QUERY_ORDER_DESC)
                  ? self::QUERY_ORDER_DESC
                  : self::QUERY_ORDER_ASC;
              $orderBys[] = $orderBy['field'] . ' ' . $direction;
          }
          return $sql . implode(', ', $orderBys);
      }
  }
  ```
