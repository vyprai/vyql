# Rank 459 / CVE-2024-8953: Composio mathematical calculator unsafe eval.
# Ledger verification: VYQL-INJ-003 catches request-controlled eval.

test "rank459: Composio calculator evaluates user expression"
  lang python
  expect VYQL-INJ-003
  code
  ```
  def calculate(request):
      expression = request.args["expression"]
      return eval(expression)
  ```

test "rank459: Composio calculator evaluates a constant expression"
  lang python
  reject VYQL-INJ-003
  code
  ```
  def calculate(request):
      return eval("1 + 1")
  ```
