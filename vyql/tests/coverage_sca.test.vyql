test "sca: Python dependency manifests produce dependency findings"
  lang python
  expect VYQL-SCA-001
  expect VYQL-SCA-004
  file app.py
  code
  ```
  import flask
  ```
  file requirements.txt
  code
  ```
  flask==0.12.2
  colourama==0.1
  requests==2.31.0
  ```

test "sca: setup.py install_requires vulnerable certificate validation dependency is reported"
  lang python
  expect VYQL-SCA-006
  file app.py
  code
  ```
  import awscrt
  ```
  file setup.py
  code
  ```
  from setuptools import setup

  setup(
      install_requires=[
          'awscrt==0.11.20',
      ],
  )
  ```

test "sca: setup.py patched certificate validation dependency is clean"
  lang python
  reject VYQL-SCA-006
  file app.py
  code
  ```
  import awscrt
  ```
  file setup.py
  code
  ```
  from setuptools import setup

  setup(
      install_requires=[
          'awscrt==0.11.22',
      ],
  )
  ```

test "sca: setup.cfg unbounded requests dependency can select vulnerable TLS validation release"
  lang config
  expect VYQL-SCA-006
  file setup.cfg
  code
  ```
  [options]
  install_requires =
      requests[socks]>=2.22.0
  ```

test "sca: setup.cfg requests dependency capped at patched TLS validation release is clean"
  lang config
  reject VYQL-SCA-006
  file setup.cfg
  code
  ```
  [options]
  install_requires =
      requests[socks] >=2.22.0, <=2.31.0
  ```

test "sca: vulnerable git submodule commit is reported"
  lang python
  expect VYQL-SCA-005
  gitlink vendor/llhttp 69d6db2008508489d19267a0dcab30602b16fc5b
  file app.py
  code
  ```
  import aiohttp
  ```
  file .gitmodules
  code
  ```
  [submodule "vendor/llhttp"]
  path = vendor/llhttp
  url = https://github.com/nodejs/llhttp.git
  ```

test "sca: patched git submodule commit is clean"
  lang python
  reject VYQL-SCA-005
  gitlink vendor/llhttp 7e18596bae8f63692ded9d3250d5d984fe90dcfb
  file app.py
  code
  ```
  import aiohttp
  ```
  file .gitmodules
  code
  ```
  [submodule "vendor/llhttp"]
  path = vendor/llhttp
  url = https://github.com/nodejs/llhttp.git
  ```
