# Rank 916 / CVE-2026-49472: bundled Expat tokenizer name lead-byte paths
# checked name classes without first rejecting invalid encoded characters.

test "rank916: XML tokenizer lead-byte name cases lack invalid-character guard"
  lang c
  file xmltok_impl.c
  expect VYQL-VAL-014
  expect_review code.XmlLeadByteNameValidationMissing
  code
  ```
  #ifndef IS_INVALID_CHAR
  #define IS_INVALID_CHAR(enc, ptr, n) (0)
  #endif

  #define CHECK_NAME_CASE(n, enc, ptr, end, nextTokPtr) \
     case BT_LEAD ## n: \
       if (end - ptr < n) \
         return XML_TOK_PARTIAL_CHAR; \
       if (!IS_NAME_CHAR(enc, ptr, n)) { \
         *nextTokPtr = ptr; \
         return XML_TOK_INVALID; \
       } \
       ptr += n; \
       break;

  #define CHECK_NMSTRT_CASE(n, enc, ptr, end, nextTokPtr) \
     case BT_LEAD ## n: \
       if (end - ptr < n) \
         return XML_TOK_PARTIAL_CHAR; \
       if (!IS_NMSTRT_CHAR(enc, ptr, n)) { \
         *nextTokPtr = ptr; \
         return XML_TOK_INVALID; \
       } \
       ptr += n; \
       break;
  ```

test "rank916: XML tokenizer lead-byte name cases reject invalid characters first"
  lang c
  file xmltok_impl.c
  reject VYQL-VAL-014
  reject_review code.XmlLeadByteNameValidationMissing
  code
  ```
  #ifndef IS_INVALID_CHAR
  #define IS_INVALID_CHAR(enc, ptr, n) (0)
  #endif

  #define CHECK_NAME_CASE(n, enc, ptr, end, nextTokPtr) \
     case BT_LEAD ## n: \
       if (end - ptr < n) \
         return XML_TOK_PARTIAL_CHAR; \
       if (IS_INVALID_CHAR(enc, ptr, n) || ! IS_NAME_CHAR(enc, ptr, n)) { \
         *nextTokPtr = ptr; \
         return XML_TOK_INVALID; \
       } \
       ptr += n; \
       break;

  #define CHECK_NMSTRT_CASE(n, enc, ptr, end, nextTokPtr) \
     case BT_LEAD ## n: \
       if (end - ptr < n) \
         return XML_TOK_PARTIAL_CHAR; \
       if (IS_INVALID_CHAR(enc, ptr, n) || ! IS_NMSTRT_CHAR(enc, ptr, n)) { \
         *nextTokPtr = ptr; \
         return XML_TOK_INVALID; \
       } \
       ptr += n; \
       break;
  ```
