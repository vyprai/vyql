test "rank245: WordPress importer restart clears data without nonce check"
  lang php
  expect VYQL-RF-006
  code
  ```
  <?php
  class Blogger_Import
  {
      function restart()
      {
          global $wpdb;
          $options = get_option('blogger_importer');

          delete_option('blogger_importer');
          $wpdb->query("DELETE FROM $wpdb->postmeta WHERE meta_key = 'blogger_author'");
          wp_redirect('?import=blogger');
      }

      function start()
      {
          if (isset($_POST['restart']))
              $this->restart();
      }
  }
  ```

test "rank245: WordPress importer restart requires nonce before clearing data"
  lang php
  reject VYQL-RF-006
  code
  ```
  <?php
  class Blogger_Import
  {
      function restart()
      {
          global $wpdb;
          $options = get_option('blogger_importer');

          if (check_admin_referer('clear-blogger-importer', 'clear-blogger-importer-nonce')) {
              delete_option('blogger_importer');
              $wpdb->query("DELETE FROM $wpdb->postmeta WHERE meta_key = 'blogger_author'");
          }
          wp_redirect('?import=blogger');
          exit;
      }

      function start()
      {
          if (isset($_POST['restart']))
              $this->restart();
      }
  }
  ```
