# Rank 368 / CVE-2026-23842: ChatterBot SQLStorageAdapter could exhaust
# SQLAlchemy sessions/connections under concurrent get_response calls because
# session factories lacked bounded pool defaults and generator-backed queries
# closed sessions only after full consumption.

test "rank368: ChatterBot SQLAlchemy storage lacks scoped sessions and pool cleanup"
  lang python
  expect VYQL-DOS-014
  expect_review code.ChatterBotSqlalchemySessionPoolExhaustion
  code
  ```
  from sqlalchemy import create_engine
  from sqlalchemy.orm import sessionmaker

  class SQLStorageAdapter:
      def __init__(self, **kwargs):
          self.database_uri = kwargs.get("database_uri")
          self.engine = create_engine(self.database_uri)
          self.Session = sessionmaker(bind=self.engine, expire_on_commit=True)

      def filter(self, **kwargs):
          Statement = self.get_model("statement")
          session = self.Session()
          statements = session.query(Statement)
          for statement in statements:
              yield self.model_to_object(statement)
          session.close()
  ```

test "rank368: ChatterBot SQLAlchemy storage scopes sessions and always closes"
  lang python
  reject VYQL-DOS-014
  reject_review code.ChatterBotSqlalchemySessionPoolExhaustion
  code
  ```
  from sqlalchemy import create_engine
  from sqlalchemy.orm import scoped_session, sessionmaker

  class SQLStorageAdapter:
      def __init__(self, **kwargs):
          self.database_uri = kwargs.get("database_uri")
          pool_config = {
              "pool_size": kwargs.get("pool_size", 5),
              "max_overflow": kwargs.get("max_overflow", 10),
              "pool_timeout": kwargs.get("pool_timeout", 30),
          }
          self.engine = create_engine(self.database_uri, **pool_config)
          session_factory = sessionmaker(bind=self.engine, expire_on_commit=True)
          self.Session = scoped_session(session_factory)

      def filter(self, **kwargs):
          Statement = self.get_model("statement")
          session = self.Session()
          try:
              statements = session.query(Statement)
              for statement in statements:
                  yield self.model_to_object(statement)
          finally:
              session.close()
  ```
