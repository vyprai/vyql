# Rank 404 / CVE-2025-8917: ClearML safe_extract validated archive member
# names but did not validate symbolic or hard-link targets before tar.extractall.

test "rank404: clearml safe_extract omits symlink and hard-link target checks"
  lang python
  expect VYQL-PATH-007
  expect_review code.ArchiveSymlinkFilterBypass
  code
  ```
  def safe_extract(tar, path=".", members=None, numeric_owner=False):
      for member in tar.getmembers():
          member_path = os.path.join(path, member.name)
          if not is_within_directory(path, member_path):
              raise Exception("Attempted Path Traversal in Tar File")
      tar.extractall(path, members, numeric_owner=numeric_owner)
  ```

test "rank404: clearml safe_extract validates link targets before extraction"
  lang python
  reject VYQL-PATH-007
  reject_review code.ArchiveSymlinkFilterBypass
  code
  ```
  def safe_extract(tar, path=".", members=None, numeric_owner=False):
      base_dir = os.path.abspath(path)
      for member in tar.getmembers():
          member_path = os.path.abspath(os.path.join(base_dir, member.name))
          if not is_within_directory(base_dir, member_path):
              raise Exception("Path traversal detected in archive member")

          if member.issym() or member.islnk():
              link_target = os.path.abspath(os.path.join(base_dir, member.linkname))
              if not is_within_directory(base_dir, link_target):
                  raise Exception("Link target escapes extraction dir")
      tar.extractall(path=base_dir, members=members, numeric_owner=numeric_owner)
  ```
