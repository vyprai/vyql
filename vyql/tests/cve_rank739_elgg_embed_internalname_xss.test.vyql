# Rank 739 / CVE-2011-2935: Elgg embed modal copied the
# request-controlled internalname parameter into an embed view without
# HTML entity escaping. The fix applies htmlentities() before elgg_view().

test "rank739: Elgg embed view receives internalname without HTML escaping"
  lang php
  expect VYQL-INJ-162
  expect_review code.RequestViewVariableHtmlEscapeMissing
  code
  ```
  <?php
  if (!is_callable('elgg_view')) exit;

  $internalname = get_input('internalname');

  if (!isloggedin()) exit;

  echo elgg_view('embed/media', array(
    'entities' => $entities,
    'internalname' => $internalname,
  ));
  ```

test "rank739: Elgg embed view escapes internalname before rendering"
  lang php
  reject VYQL-INJ-162
  reject_review code.RequestViewVariableHtmlEscapeMissing
  code
  ```
  <?php
  if (!is_callable('elgg_view')) exit;

  $internalname = get_input('internalname');
  $internalname = htmlentities($internalname);

  if (!isloggedin()) exit;

  echo elgg_view('embed/media', array(
    'entities' => $entities,
    'internalname' => $internalname,
  ));
  ```
