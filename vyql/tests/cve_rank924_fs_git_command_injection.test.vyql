# Rank 924 / CVE-2017-1000451: fs-git assembled a git --git-dir shell
# command string from caller-controlled paths and executed it through exec().

test "rank924: git-dir helper shell string flows to child_process.exec"
  lang javascript
  file index.ts
  expect VYQL-INJ-182
  expect_review code.GitDirShellCommandStringExecution
  code
  ```
  import * as child_process from "child_process";

  export class FSGit {
      constructor(public path: string, public ref = "master") {}

      readFile(path: string): Promise<Buffer> {
          const command = this._buildCommand("show", `${this.ref}:${path}`);
          return new Promise((resolve, reject) => {
              child_process.exec(command, { encoding: "buffer" }, (err, stdout) => {
                  if (err) reject(err);
                  else resolve(stdout);
              });
          });
      }

      private _buildCommand(...args: string[]): string {
          return `git --git-dir=${this.path} ${args.join(" ")}`;
      }
  }
  ```

test "rank924: git-dir helper uses execFile argv execution"
  lang javascript
  file index.ts
  reject VYQL-INJ-182
  reject_review code.GitDirShellCommandStringExecution
  code
  ```
  import * as child_process from "child_process";

  export class FSGit {
      constructor(public path: string, public ref = "master") {}

      readFile(path: string): Promise<Buffer> {
          const command = this._buildCommand("show", `${this.ref}:${path}`);
          return new Promise((resolve, reject) => {
              child_process.execFile(command.base, command.args, { encoding: "buffer" }, (err, stdout) => {
                  if (err) reject(err);
                  else resolve(stdout);
              });
          });
      }

      private _buildCommand(...args: string[]): { base: string; args: string[]; } {
          return { base: "git", args: [`--git-dir=${this.path}`, ...args] };
      }
  }
  ```
