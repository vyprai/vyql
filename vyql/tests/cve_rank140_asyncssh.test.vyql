# Rank 140 / CVE-2018-7749: AsyncSSH accepted global/channel requests before
# authentication completed. The patch rejects non-userauth packet types until
# `_auth_complete` is true.

test "rank140: python asyncssh pre-auth packet dispatch requires protocol-state review"
  lang python
  expect VYQL-AUTH-082
  expect_review code.ProtocolStateReview
  code
  ```
  class SSHConnection:
      def _recv_packet(self, pkttype, seq, packet):
          if self._kex and MSG_KEX_FIRST <= pkttype <= MSG_KEX_LAST:
              processed = self._kex.process_packet(pkttype, seq, packet)
          elif (self._auth and
                MSG_USERAUTH_FIRST <= pkttype <= MSG_USERAUTH_LAST):
              processed = self._auth.process_packet(pkttype, seq, packet)
          else:
              processed = self.process_packet(pkttype, seq, packet,
                                              pkttype not in
                                              self._excluded_recv_pkttypes)
          return processed
  ```

test "rank140: python asyncssh pre-auth packet dispatch guard is clean"
  lang python
  reject VYQL-AUTH-082
  reject_review code.ProtocolStateReview
  code
  ```
  class SSHConnection:
      def _recv_packet(self, pkttype, seq, packet):
          if self._kex and MSG_KEX_FIRST <= pkttype <= MSG_KEX_LAST:
              processed = self._kex.process_packet(pkttype, seq, packet)
          elif (self._auth and
                MSG_USERAUTH_FIRST <= pkttype <= MSG_USERAUTH_LAST):
              processed = self._auth.process_packet(pkttype, seq, packet)
          elif pkttype > MSG_USERAUTH_LAST and not self._auth_complete:
              raise DisconnectError(DISC_PROTOCOL_ERROR,
                                    'Invalid request received before '
                                    'authentication was complete')
          else:
              processed = self.process_packet(pkttype, seq, packet,
                                              pkttype not in
                                              self._excluded_recv_pkttypes)
          return processed
  ```
