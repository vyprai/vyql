# Rank 741 / CVE-2020-13822: elliptic accepted non-canonical DER
# ECDSA signatures. The fix rejects invalid long-form lengths and
# unnecessary leading zeroes before constructing BN(r)/BN(s).

test "rank741: elliptic DER import accepts non-canonical leading zeroes"
  lang javascript
  expect VYQL-CRY-018
  expect_review code.DerSignatureNonCanonicalImport
  code
  ```
  function getLength(buf, p) {
    var initial = buf[p.place++];
    if (!(initial & 0x80)) {
      return initial;
    }
    var octetLen = initial & 0xf;
    var val = 0;
    for (var i = 0, off = p.place; i < octetLen; i++, off++) {
      val <<= 8;
      val |= buf[off];
    }
    p.place = off;
    return val;
  }

  Signature.prototype._importDER = function _importDER(data, enc) {
    var len = getLength(data, p);
    var rlen = getLength(data, p);
    var r = data.slice(p.place, rlen + p.place);
    var slen = getLength(data, p);
    var s = data.slice(p.place, slen + p.place);
    if (r[0] === 0 && (r[1] & 0x80)) {
      r = r.slice(1);
    }
    if (s[0] === 0 && (s[1] & 0x80)) {
      s = s.slice(1);
    }
    this.r = new BN(r);
    this.s = new BN(s);
  };
  ```

test "rank741: elliptic DER import rejects non-canonical encodings"
  lang javascript
  reject VYQL-CRY-018
  reject_review code.DerSignatureNonCanonicalImport
  code
  ```
  function getLength(buf, p) {
    var initial = buf[p.place++];
    if (!(initial & 0x80)) {
      return initial;
    }
    var octetLen = initial & 0xf;
    if (octetLen === 0 || octetLen > 4) {
      return false;
    }
    var val = 0;
    for (var i = 0, off = p.place; i < octetLen; i++, off++) {
      val <<= 8;
      val |= buf[off];
      val >>>= 0;
    }
    if (val <= 0x7f) {
      return false;
    }
    p.place = off;
    return val;
  }

  Signature.prototype._importDER = function _importDER(data, enc) {
    var len = getLength(data, p);
    var rlen = getLength(data, p);
    var r = data.slice(p.place, rlen + p.place);
    var slen = getLength(data, p);
    var s = data.slice(p.place, slen + p.place);
    if (r[0] === 0) {
      if (r[1] & 0x80) {
        r = r.slice(1);
      } else {
        return false;
      }
    }
    if (s[0] === 0) {
      if (s[1] & 0x80) {
        s = s.slice(1);
      } else {
        return false;
      }
    }
    this.r = new BN(r);
    this.s = new BN(s);
  };
  ```
