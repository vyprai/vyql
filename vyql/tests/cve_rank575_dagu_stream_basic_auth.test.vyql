test "rank575: stream basic auth options must require authentication"
  lang go
  expect VYQL-AUTH-033
  code
  ```
  package frontend

  type Server struct {
      config Config
  }

  type Config struct {
      Server ServerConfig
  }

  type ServerConfig struct {
      Auth AuthConfig
  }

  type AuthConfig struct {
      Mode string
      Basic BasicConfig
  }

  type BasicConfig struct {
      Username string
      Password string
  }

  type Options struct {
      Realm string
      BasicAuthEnabled bool
      AuthRequired bool
      Creds map[string]string
  }

  const AuthModeBasic = "basic"

  func (srv *Server) buildStreamAuthOptions(realm string) Options {
      authCfg := srv.config.Server.Auth
      if authCfg.Mode == AuthModeBasic {
          return Options{
              Realm: realm,
              BasicAuthEnabled: true,
              Creds: map[string]string{authCfg.Basic.Username: authCfg.Basic.Password},
          }
      }
      return Options{Realm: realm, AuthRequired: true}
  }
  ```

test "rank575: stream basic auth options with AuthRequired true are accepted"
  lang go
  reject VYQL-AUTH-033
  code
  ```
  package frontend

  type Server struct {
      config Config
  }

  type Config struct {
      Server ServerConfig
  }

  type ServerConfig struct {
      Auth AuthConfig
  }

  type AuthConfig struct {
      Mode string
      Basic BasicConfig
  }

  type BasicConfig struct {
      Username string
      Password string
  }

  type Options struct {
      Realm string
      BasicAuthEnabled bool
      AuthRequired bool
      Creds map[string]string
  }

  const AuthModeBasic = "basic"

  func (srv *Server) buildStreamAuthOptions(realm string) Options {
      authCfg := srv.config.Server.Auth
      if authCfg.Mode == AuthModeBasic {
          return Options{
              Realm: realm,
              BasicAuthEnabled: true,
              AuthRequired: true,
              Creds: map[string]string{authCfg.Basic.Username: authCfg.Basic.Password},
          }
      }
      return Options{Realm: realm, AuthRequired: true}
  }
  ```
