# Kotlin coverage breadth: SSRF, ReDoS, deserialization, weak crypto.

test "kotlin: request param -> URL.openConnection is SSRF"
  lang kotlin
  expect VYQL-RF-001
  code
  ```
  fun h(req: HttpServletRequest) {
    val u = req.getParameter("url")
    val conn = URL(u).openConnection()
  }
  ```

test "kotlin: a constant URL is clean (SSRF)"
  lang kotlin
  reject VYQL-RF-001
  code
  ```
  fun h() { val conn = URL("https://api.example.com/v1").openConnection() }
  ```

test "kotlin: request param -> Pattern.compile is ReDoS"
  lang kotlin
  expect VYQL-DOS-001
  code
  ```
  fun h(req: HttpServletRequest) {
    val u = req.getParameter("p")
    val pat = Pattern.compile(u)
  }
  ```

test "kotlin: MessageDigest MD5 is weak crypto"
  lang kotlin
  expect VYQL-CRY-001
  code
  ```
  fun h() { val md = MessageDigest.getInstance("MD5") }
  ```

test "kotlin: MessageDigest SHA-256 is clean (weak crypto)"
  lang kotlin
  reject VYQL-CRY-001
  code
  ```
  fun h() { val md = MessageDigest.getInstance("SHA-256") }
  ```

test "kotlin: request param -> readValue is unsafe deserialization"
  lang kotlin
  expect VYQL-DESER-001
  code
  ```
  fun h(req: HttpServletRequest) {
    val u = req.getParameter("blob")
    val obj = mapper.readValue(u, Foo::class.java)
  }
  ```
