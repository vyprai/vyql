# Rank 0 / CVE-2024-2352: 1Panel command injection.
# Fresh scan evidence includes VYQL-INJ-002 command-injection findings.

test "rank0: 1Panel request host reaches shell command"
  lang go
  expect VYQL-INJ-002
  code
  ```
  package main

  import (
    "net/http"
    "os/exec"
  )

  func handler(w http.ResponseWriter, r *http.Request) {
    host := r.URL.Query().Get("host")
    exec.Command("sh", "-c", "ping "+host).Run()
  }
  ```

test "rank0: 1Panel shell command uses constant argument"
  lang go
  reject VYQL-INJ-002
  code
  ```
  package main

  import "os/exec"

  func handler() {
    exec.Command("sh", "-c", "ping 127.0.0.1").Run()
  }
  ```
