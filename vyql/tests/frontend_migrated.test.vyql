test "javascript library option object reaches prototype option sink"
  lang javascript
  profile library
  expect VYQL-INJ-013
  code
  ```
  exports.compile = function compile(template, optsParam) {
    var opts = optsParam || {};
    var options = {};
    options.outputFunctionName = opts.outputFunctionName;
  };
  ```

test "javascript exported CommonJS parameter reaches shell command sink"
  lang javascript
  profile library
  expect VYQL-INJ-002
  code
  ```
  const cp = require('child_process');
  module.exports = function killport(port) {
    cp.exec('lsof -i:' + port);
  };
  ```

test "javascript destructured exported values reach shell command sink"
  lang javascript
  profile library
  expect VYQL-INJ-002
  code
  ```
  module.exports = function launch(file, specifiedEditor) {
    const parsed = parseFile(file);
    let { fileName } = parsed;
    const [editor, ...args] = guessEditor(specifiedEditor);
    args.push(fileName);
    childProcess.spawn('cmd.exe', ['/C', editor].concat(args), {});
  };
  ```
