# Rank 406 / CVE-2023-48052: HTTPie 3.2.2 needed to pin requests to
# 2.31.0 to avoid missing TLS certificate validation.

test "rank406: httpie setup.cfg requests dependency lacks upper cert-validation-safe bound"
  lang config
  file setup.cfg
  expect VYQL-SCA-006
  code
  ```
  [options]
  install_requires =
      pip
      requests[socks]>=2.22.0
      requests-toolbelt>=0.9.1
  ```

test "rank406: httpie setup.cfg requests dependency pins the safe upper bound"
  lang config
  file setup.cfg
  reject VYQL-SCA-006
  code
  ```
  [options]
  install_requires =
      pip
      requests[socks] >=2.22.0, <=2.31.0
      requests-toolbelt>=0.9.1
  ```
