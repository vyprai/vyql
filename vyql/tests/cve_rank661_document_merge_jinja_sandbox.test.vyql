test "rank661: Jinja document template environment is not sandboxed"
  lang python
  expect VYQL-INJ-024
  code
  ```
  from jinja2 import Environment, pass_context

  def get_jinja_filters():
      return {"image": image}

  def get_jinja_env():
      jinja_env = Environment(extensions=settings.DOCXTEMPLATE_JINJA_EXTENSIONS)
      jinja_env.filters.update(get_jinja_filters())
      return jinja_env
  ```

test "rank661: Jinja document template environment uses sandbox"
  lang python
  reject VYQL-INJ-024
  code
  ```
  from jinja2 import pass_context
  from jinja2.sandbox import SandboxedEnvironment

  def get_jinja_filters():
      return {"image": image}

  def get_jinja_env():
      jinja_env = SandboxedEnvironment(extensions=settings.DOCXTEMPLATE_JINJA_EXTENSIONS)
      jinja_env.filters.update(get_jinja_filters())
      return jinja_env
  ```
