  ```

test "perl exhaustive: HTML escaping suppresses response rendering"
  lang perl
  reject VYQL-INJ-004
  code
  ```
  my $html = encode_entities(param("html"));
  print($html);
  ```

test "perl exhaustive: LDAP XPath and trust-boundary sinks receive tainted data"
  lang perl
  expect VYQL-INJ-005
  expect VYQL-INJ-006
  expect VYQL-CFG-014
  code
  ```
  my $filter = param("filter");
  my $xp = param("xpath");
  my $role = param("role");
  $ldap->search(base => "dc=x", filter => $filter);
  $xpath->find($xp);
  $session->param("role", $role);
  ```

test "perl exhaustive: LDAP XPath and trust-boundary controls suppress findings"
  lang perl
  reject VYQL-INJ-005
  reject VYQL-INJ-006
  reject VYQL-CFG-014
  code
  ```
  my $filter = encodeForLDAP(param("filter"));
  my $xp = escapeXPath(param("xpath"));
  my $role = validateRole(param("role"));
  $ldap->search(base => "dc=x", filter => $filter);
  $xpath->find($xp);
  $session->param("role", $role);
  ```

test "perl exhaustive: auth and IDOR findings are reported"
  lang perl
  expect VYQL-AUTH-001
  expect VYQL-AUTH-002
  code
  ```
  change_password();
  $repo->find_by_id(param("id"));
  ```

test "perl exhaustive: auth and ownership guards suppress findings"
  lang perl
  reject VYQL-AUTH-001
  reject VYQL-AUTH-002
  code
  ```
  sub handler {
    require_auth();
    change_password();
    check_ownership(param("id"));
    $repo->find_by_id(param("id"));
  }
  ```

test "perl exhaustive: cookie weak crypto permission temp and deserialization findings"
  lang perl
  expect VYQL-CFG-007
  expect VYQL-CRY-001
  expect VYQL-CRY-002
  expect VYQL-CRY-003
  expect VYQL-CRY-004
  expect VYQL-CFG-008
  expect VYQL-PATH-003
  expect VYQL-DESER-001
  expect VYQL-DESER-002
  code
  ```
  secure("false");
  httponly("false");
  md5_hex("x");
  sha1_hex("x");
  Crypt::CBC::new("DES");
  Crypt::CBC::new("0000000000000000");
  rand();
  chmod("0777", "file");
  tmpnam();
  Storable::thaw(param("blob"));
  $parser->parse_string(param("xml"));
  ```

test "perl exhaustive: secure config and stronger crypto are clean"
  lang perl
  reject VYQL-CFG-007
  reject VYQL-CRY-001
  reject VYQL-CRY-002
  reject VYQL-CRY-003
  reject VYQL-CRY-004
  reject VYQL-CFG-008
  code
  ```
  secure("true");
  httponly("true");
  sha256_hex("x");
  Crypt::CBC::new("AES");
  chmod("0600", "file");
  ```

test "perl exhaustive: resource handles closed are clean"
  lang perl
  reject VYQL-RES-001
  code
  ```
  open(my $fh, "<", "safe.txt");
  close($fh);
  my $sock = IO::Socket::INET->new("example.com:443");
  close($sock);
  ```

test "perl exhaustive: resource handles leak"
  lang perl
  expect VYQL-RES-001
  code
  ```
  open(my $fh, "<", "safe.txt");
  print <$fh>;
  ```
