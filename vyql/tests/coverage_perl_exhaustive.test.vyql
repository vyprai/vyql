# Perl language-gap narrowing: exhaustive coverage for adapter-claimed idioms.

test "perl exhaustive: CGI params reach command and code execution"
  lang perl
  expect VYQL-INJ-002
  expect VYQL-INJ-003
  code
  ```
  my $cmd = param("cmd");
  system($cmd);
  exec($cmd);
  readpipe($cmd);
  eval($cmd);
  ```

test "perl exhaustive: shell escaping suppresses command execution"
  lang perl
  reject VYQL-INJ-002
  code
  ```
  my $cmd = quotemeta(param("cmd"));
  system($cmd);
  ```

test "perl exhaustive: require loads tainted modules dynamically"
  lang perl
  expect VYQL-INJ-023
  code
  ```
  my $module = param("module");
  require($module);
  ```

test "perl exhaustive: constant require is clean"
  lang perl
  reject VYQL-INJ-023
  code
  ```
  require("Safe/Module.pm");
  ```

test "perl exhaustive: DBI query methods receive tainted SQL"
  lang perl
  expect VYQL-INJ-001
  code
  ```
  my $q = param("q");
  $dbh->do($q);
  $dbh->prepare($q);
  $dbh->selectall_arrayref($q);
  $dbh->selectrow_array($q);
  $dbh->selectrow_arrayref($q);
  $dbh->selectall_hashref($q);
  ```

test "perl exhaustive: constant DBI queries are clean"
  lang perl
  reject VYQL-INJ-001
  code
  ```
  $dbh->do("select 1");
  $dbh->prepare("select 1");
  ```

test "perl exhaustive: file APIs access tainted paths"
  lang perl
  expect VYQL-PATH-001
  code
  ```
  my $p = param("path");
  open(my $fh, "<", $p);
  sysopen(my $sfh, $p, 0);
  opendir(my $dh, $p);
  unlink($p);
  ```

test "perl exhaustive: safePath suppresses file traversal"
  lang perl
  reject VYQL-PATH-001
  code
  ```
  my $p = safePath(param("path"));
  open(my $fh, "<", $p);
  ```

test "perl exhaustive: archive extraction receives tainted member paths"
  lang perl
  expect VYQL-PATH-004
  code
  ```
  my $entry = param("entry");
  Archive::Extract::extract($archive, $entry);
  $zip->extractMember($entry);
  ```

test "perl exhaustive: URL fetch APIs fetch tainted URLs"
  lang perl
  expect VYQL-RF-001
  code
  ```
  my $url = param("url");
  getstore($url);
  getprint($url);
  mirror($url);
  $ua->request($url);
  ```

test "perl exhaustive: constant URL fetches are clean for SSRF"
  lang perl
  reject VYQL-RF-001
  code
  ```
  getstore("https://example.com/file");
  $ua->request("https://example.com");
  ```

test "perl exhaustive: cleartext URL fetches are reported"
  lang perl
  expect VYQL-CFG-006
  code
  ```
  getstore("http://example.com/file");
  getprint("http://example.com");
  mirror("http://example.com");
  $ua->request("http://example.com");
  ```

test "perl exhaustive: HTTPS and localhost URLs are clean for cleartext"
  lang perl
  reject VYQL-CFG-006
  code
  ```
  getstore("https://example.com/file");
  $ua->request("http://127.0.0.1:8080/health");
  ```

test "perl exhaustive: response writers render tainted HTML"
  lang perl
  expect VYQL-INJ-004
  code
  ```
  my $html = param("html");
  print($html);
  printf($html);
