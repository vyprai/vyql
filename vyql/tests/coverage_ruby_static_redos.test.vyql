# Ruby static-regex ReDoS coverage: user input matched by a vulnerable literal pattern.

test "ruby: case match against ambiguous quantified regex is ReDoS"
  lang ruby
  profile library
  expect VYQL-DOS-002
  code
  ```
  class BooleanTypecaster
    def call(value)
      case value
      when /\A[-+]?(0+\.?0*|0*\.?0+)\z/
        !value.to_f.zero?
      else
        value
      end
    end
  end
  ```

test "ruby: possessive quantified case regex is not static ReDoS"
  lang ruby
  profile library
  reject VYQL-DOS-002
  code
  ```
  class BooleanTypecaster
    def call(value)
      case value
      when /\A[-+]?(0++\.?0*|0*+\.?0+)\z/
        !value.to_f.zero?
      else
        value
      end
    end
  end
  ```
