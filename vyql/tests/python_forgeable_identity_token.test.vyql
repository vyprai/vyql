test "python authn: reversible Base64 identity cookie is forgeable"
  lang python
  expect VYQL-AUTH-096
  code
  ```
  import base64

  def generate_identity_token(identity):
      return base64.b64encode(str(identity).encode()).decode()

  def authenticate_account(db, name, password):
      account = get_account_by_name(db, name)
      if not verify_password(password, account.password_hash):
          return None
      return account

  def login(response, account):
      token = generate_identity_token(account.id)
      response.set_cookie("identity", token)

  def current_identity(request):
      token = request.cookies.get("identity")
      return int(base64.b64decode(token).decode())
  ```

test "python authn: signed identity cookie has integrity"
  lang python
  reject VYQL-AUTH-096
  code
  ```
  from jose import jwt

  def generate_identity_token(identity):
      return jwt.encode({"sub": str(identity)}, SECRET_KEY, algorithm="HS256")

  def authenticate_account(db, name, password):
      account = get_account_by_name(db, name)
      if not verify_password(password, account.password_hash):
          return None
      return account

  def login(response, account):
      response.set_cookie("identity", generate_identity_token(account.id))

  def current_identity(request):
      token = request.cookies.get("identity")
      return jwt.decode(token, SECRET_KEY, algorithms=["HS256"])["sub"]
  ```

test "python authn: ordinary Base64 content encoding is not an identity credential"
  lang python
  reject VYQL-AUTH-096
  code
  ```
  import base64

  def authenticate_account(db, name, password):
      account = get_account_by_name(db, name)
      if not verify_password(password, account.password_hash):
          return None
      return account

  def remember_attachment(response, contents):
      payload = base64.b64encode(contents).decode()
      response.set_cookie("attachment", payload)

  def load_attachment(request):
      payload = request.cookies.get("attachment")
      return base64.b64decode(payload)
  ```

test "python authn: HMAC-protected Base64 identity cookie has integrity"
  lang python
  reject VYQL-AUTH-096
  code
  ```
  import base64
  import hashlib
  import hmac

  def generate_identity_token(identity):
      payload = str(identity).encode()
      signature = hmac.new(SECRET_KEY, payload, hashlib.sha256).digest()
      return base64.b64encode(payload + b"." + signature).decode()

  def authenticate_account(db, name, password):
      account = get_account_by_name(db, name)
      if not verify_password(password, account.password_hash):
          return None
      return account

  def login(response, account):
      response.set_cookie("identity", generate_identity_token(account.id))

  def current_identity(request):
      token = request.cookies.get("identity")
      payload, signature = base64.b64decode(token).rsplit(b".", 1)
      expected = hmac.new(SECRET_KEY, payload, hashlib.sha256).digest()
      if not hmac.compare_digest(signature, expected):
          raise ValueError("invalid token")
      return int(payload.decode())
  ```

test "python authn: internal reversible Base64 helper without issuance is clean"
  lang python
  reject VYQL-AUTH-096
  code
  ```
  import base64

  def encode_internal_id(record_id):
      return base64.b64encode(str(record_id).encode()).decode()

  def decode_internal_id(value):
      return int(base64.b64decode(value).decode())

  def authenticate_account(db, name, password):
      account = get_account_by_name(db, name)
      if not verify_password(password, account.password_hash):
          return None
      return account

  def audit(account):
      write_audit_entry(encode_internal_id(account.id))
  ```

test "python authn: signed company credential mirrors repaired route flow"
  lang python
  reject VYQL-AUTH-096
  code
  ```
  from jose import jwt

  def generate_user_token(data):
      return jwt.encode(data, SECRET_KEY, algorithm="HS256")

  def authenticate_company(db, name, password):
      company = get_company_by_name(db, name)
      if not verify_password(password, company.hashed_password):
          return None
      return company

  def login_for_access_token(response, company):
      user_token = generate_user_token({"sub": str(company.id)})
      response.set_cookie(key="user_token", value=f"Bearer {user_token}", httponly=True)

  def validate_token(request):
      token = request.cookies.get("user_token")
      return jwt.decode(token.split(" ")[1], SECRET_KEY, algorithms=["HS256"])
  ```
