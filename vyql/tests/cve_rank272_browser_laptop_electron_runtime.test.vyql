module tests.cve.rank272.browser_laptop_electron_runtime;

# verify_current_expected: skip-fresh-target
# Rank 272 / CVE-2016-10718: Brave before 0.13.0 allowed script-driven
# window.close() to close a tab not opened by script. The corpus patch points at
# an unrelated context-menu delay; repository evidence ties the security fix to
# the Brave Electron runtime upgrade to 1.4.20.

test "rank272: Brave Electron runtime before 1.4.20 is vulnerable"
  lang javascript
  expect VYQL-SCA-001
  file app.js
  code
  ```
  window.addEventListener("load", () => {});
  ```
  file .npmrc
  code
  ```
  runtime = electron
  target = 1.4.0
  target_arch = x64
  brave_electron_version = 1.4.18
  disturl = https://atom.io/download/atom-shell
  ```

test "rank272: Brave Electron runtime 1.4.20 is clean"
  lang javascript
  reject VYQL-SCA-001
  file app.js
  code
  ```
  window.addEventListener("load", () => {});
  ```
  file .npmrc
  code
  ```
  runtime = electron
  target = 1.4.0
  target_arch = x64
  brave_electron_version = 1.4.20
  disturl = https://atom.io/download/atom-shell
  ```

test "rank272: later Brave Electron runtime is clean"
  lang javascript
  reject VYQL-SCA-001
  file app.js
  code
  ```
  window.addEventListener("load", () => {});
  ```
  file .npmrc
  code
  ```
  runtime = electron
  target = 2.0.17
  target_arch = x64
  brave_electron_version = 2.0.17
  disturl = http://brave-laptop-binaries.s3.amazonaws.com/atom-shell/dist
  ```
