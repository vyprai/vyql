# Rank 442 / CVE-2023-26113: Collection.js extend prototype pollution.

test "rank442: Collection.js extend recursively merges __proto__ keys"
  lang javascript
  file extend.js
  expect VYQL-INJ-088
  expect_review code.CollectionExtendPrototypePollution
  code
  ```
  Collection.prototype.extend = function (deepOrParams, args) {
    const data = this.data;
    const p = {};
    const promise = Promise.resolve();

    function setVal(data, key, val) {
      data[key] = val;
    }

    for (let i = 0; i < arguments.length; i++) {
      const arg = arguments[i];
      promise.then(() => $C(arg).forEach((el, key) => {
        let src = byLink(data, [key]);
        const val = el;
        const childExt = $C(src || {}).extend(p, val);
        byLink(data, [key], {value: childExt});
        setVal(data, key, val);
      }, p));
    }
  };
  ```

test "rank442: Collection.js extend skips __proto__ keys"
  lang javascript
  file extend.js
  reject VYQL-INJ-088
  reject_review code.CollectionExtendPrototypePollution
  code
  ```
  Collection.prototype.extend = function (deepOrParams, args) {
    const data = this.data;
    const p = {};
    const promise = Promise.resolve();

    function setVal(data, key, val) {
      data[key] = val;
    }

    for (let i = 0; i < arguments.length; i++) {
      const arg = arguments[i];
      promise.then(() => $C(arg).forEach((el, key) => {
        if (key === '__proto__') {
          return;
        }

        let src = byLink(data, [key]);
        const val = el;
        const childExt = $C(src || {}).extend(p, val);
        byLink(data, [key], {value: childExt});
        setVal(data, key, val);
      }, p));
    }
  };
  ```
