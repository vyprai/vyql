# Rank 969 / CVE-2023-2138: @nuxtlabs/github-module placed the GitHub token
# into Nuxt public runtime config. The fix keeps token in private runtimeConfig.

test "rank969: Nuxt module merges token-bearing config into public runtime config"
  lang javascript
  profile library
  file src/module.ts
  expect VYQL-SEC-037
  expect_review code.NuxtPublicRuntimeConfigSecretExposure
  code
  ```
  import { defu } from 'defu'
  import { defineNuxtModule } from '@nuxt/kit'

  export default defineNuxtModule({
    setup (options, nuxt) {
      const config = {
        api: options.api || process.env.GITHUB_OWNER,
        owner: options.owner || process.env.GITHUB_OWNER,
        branch: options.branch || process.env.GITHUB_BRANCH,
        repo: options.repo || process.env.GITHUB_REPO,
        token: options.token || process.env.GITHUB_TOKEN
      }

      nuxt.options.runtimeConfig.public.github = defu(nuxt.options.runtimeConfig.public.github, config)
      nuxt.options.runtimeConfig.github = defu(nuxt.options.runtimeConfig.github, config)
    }
  })
  ```

test "rank969: Nuxt module keeps token in private runtime config"
  lang javascript
  profile library
  file src/module.ts
  reject VYQL-SEC-037
  reject_review code.NuxtPublicRuntimeConfigSecretExposure
  code
  ```
  import { defu } from 'defu'
  import { defineNuxtModule } from '@nuxt/kit'

  export default defineNuxtModule({
    setup (options, nuxt) {
      const config = {
        api: options.api || process.env.GITHUB_OWNER,
        owner: options.owner || process.env.GITHUB_OWNER,
        branch: options.branch || process.env.GITHUB_BRANCH,
        repo: options.repo || process.env.GITHUB_REPO
      }

      nuxt.options.runtimeConfig.public.github = defu(nuxt.options.runtimeConfig.public.github, config)
      nuxt.options.runtimeConfig.github = defu(nuxt.options.runtimeConfig.github, {
        token: options.token || process.env.GITHUB_TOKEN
      }, config)
    }
  })
  ```
