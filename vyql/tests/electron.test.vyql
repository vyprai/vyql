# Desktop / Electron threat model: the renderer config and renderer->main escape are the
# high-risk surface. nodeIntegration/contextIsolation misconfig lets web content run Node.

test "electron: BrowserWindow nodeIntegration:true is insecure"
  lang javascript
  expect VYQL-DSK-001
  code
  ```
  const win = new BrowserWindow({ webPreferences: { nodeIntegration: true } });
  ```

test "electron: contextIsolation:false is insecure"
  lang javascript
  expect VYQL-DSK-001
  code
  ```
  const win = new BrowserWindow({ webPreferences: { contextIsolation: false } });
  ```

test "electron: webview attach hook without contextIsolation is insecure"
  lang javascript
  expect VYQL-DSK-001
  code
  ```
  function createMainWindow() {
    mainWindow.webContents.on('will-attach-webview', (event, webPreferences) => {
      webPreferences.nodeIntegration = false;
    });
  }
  ```

test "electron: webview attach hook enables contextIsolation is clean"
  lang javascript
  reject VYQL-DSK-001
  code
  ```
  function createMainWindow() {
    mainWindow.webContents.on('will-attach-webview', (event, webPreferences) => {
      webPreferences.nodeIntegration = false;
      webPreferences.contextIsolation = true;
    });
  }
  ```

test "electron: secure renderer config is clean"
  lang javascript
  reject VYQL-DSK-001
  code
  ```
  const win = new BrowserWindow({ webPreferences: { nodeIntegration: false, contextIsolation: true } });
  ```

test "electron: tainted shell.openExternal is command-ish execution"
  lang javascript
  expect VYQL-INJ-002
  code
  ```
  const { shell } = require('electron');
  function open(req) { shell.openExternal(req.query.url); }
  ```
