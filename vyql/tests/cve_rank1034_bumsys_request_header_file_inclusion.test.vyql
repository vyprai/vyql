# Rank 1034 / CVE-2023-2551: Bumsys includes a PHP file chosen by the caller.
# The API router takes the route name straight from a request header:
#
#   $header = getallheaders();
#   $api_module = SYSTEM_API . "v1/routes/{$header["route"]}.php";
#   if( file_exists($api_module) ) { require_once($api_module); }
#
# so a header holding ../../ reaches require_once and executes whatever the
# traversal lands on (CWE-98). The fix 86e29dd23d wraps the name in basename.
# The same commit fixes a second inclusion, where $pageSlug comes from
# $_SERVER['REQUEST_URI'] and is concatenated into $ModulePageLink for a bare
# require; there the fix strips "./" and "../" from the slug.
#
# The header route is now reported. getallheaders and its alias
# apache_request_headers were only bound behind a dependency on the
# ralouphie/getallheaders polyfill, so an application calling the built-in
# function had no source at all; both names are bound directly now, which is
# what the PHP manual describes them as, request headers and nothing else.
#
# The patched form is still reported, and deliberately so. basename is a
# core.PathCanonicalization control, and the ontology holds that canonicalization
# neutralises path.PathTraversal but not path.FileInclusion, because stripping
# the directory still leaves every file in the remaining directory includable.
# core.PathAccessCheck, an allow-list, is the control that neutralises inclusion.
# This is how the rule already behaved for every other source: the same include
# guarded by basename with $_GET as the source reports too, so the new binding
# changes which code is visible, not what counts as defended.
#
# The slug half of the fix is not reachable. $pageSlug is assigned in one file
# and read in another, and $ModulePageLink is assigned in a third, so nothing
# crosses the require boundary: the three files together report nothing while
# the same code in one file reports, which is the last case below.

test "rank1034: a route name from a request header reaches require_once"
  lang php
  file include/system/api/v1/index.php
  expect VYQL-PATH-002
  code
  ```
  <?php
  $header = getallheaders();
  $route = $header["Route"];
  $api_module = SYSTEM_API . "v1/routes/{$route}.php";
  if( file_exists($api_module) ) {
      require_once($api_module);
  }
  ```

test "rank1034: apache_request_headers is the same source under its other name"
  lang php
  file include/system/api/v1/index.php
  expect VYQL-PATH-002
  code
  ```
  <?php
  $header = apache_request_headers();
  $api_module = SYSTEM_API . "v1/routes/{$header["Route"]}.php";
  require_once($api_module);
  ```

test "rank1034: a fixed route name is not a finding"
  lang php
  file include/system/api/v1/index.php
  reject VYQL-PATH-002
  code
  ```
  <?php
  $header = getallheaders();
  $api_module = SYSTEM_API . "v1/routes/invoice.php";
  require_once($api_module);
  ```

test "rank1034: the slug inclusion is reported while the assignment stays in one file"
  lang php
  file core/route.php
  expect VYQL-PATH-002
  code
  ```
  <?php
  function pageSlug() {
      $URI = explode(root_domain(), rtrim($_SERVER['HTTP_HOST'].$_SERVER['REQUEST_URI'], "/"));
      $URI = explode("?", $URI[1]);
      return trim($URI[0], '/');
  }
  $slug = pageSlug();
  $ModulePageLink = DIR_MODULE . $slug . ".php";
  require $ModulePageLink;
  ```
