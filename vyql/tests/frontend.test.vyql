# Frontend / SPA threat model: the browser DOM is the trust boundary. Attacker-controlled
# URL / referrer / window-name / web-storage flows into a DOM sink. Reuses the existing
# XSS (INJ-004), open-redirect (RF-002), and code-eval (INJ-003) rules via new DOM sources
# + property-write sink modeling.

test "DOM-XSS: location.hash -> element.innerHTML"
  lang javascript
  expect VYQL-INJ-004
  code
  ```
  document.getElementById('out').innerHTML = location.hash;
  ```

test "DOM-XSS: document.referrer -> innerHTML"
  lang javascript
  expect VYQL-INJ-004
  code
  ```
  el.innerHTML = document.referrer;
  ```

test "DOM-XSS: location.search -> document.write"
  lang javascript
  expect VYQL-INJ-004
  code
  ```
  document.write(window.location.search);
  ```

test "DOM-XSS: window.name -> outerHTML"
  lang javascript
  expect VYQL-INJ-004
  code
  ```
  node.outerHTML = window.name;
  ```

test "DOM-XSS: localStorage value -> insertAdjacentHTML"
  lang javascript
  expect VYQL-INJ-004
  code
  ```
  el.insertAdjacentHTML('beforeend', localStorage.getItem('msg'));
  ```

test "DOM-XSS: parsed API model field -> innerHTML"
  lang javascript
  expect VYQL-INJ-004
  file state.js
  ```
  let workspace;
  export async function initializeWorkspace(id) {
    const response = await fetch('/api/workspaces/' + id);
    const data = await response.json();
    workspace = data.results;
  }
  export function getCurrentWorkspace() {
    return workspace;
  }
  ```
  file editor.js
  ```
  import { getCurrentWorkspace } from './state.js';
  function renderTopic(i) {
    const span = document.createElement('span');
    span.innerHTML = getCurrentWorkspace().topics[i].topicName;
  }
  ```

test "clean: parsed API model field -> textContent"
  lang javascript
  reject VYQL-INJ-004
  file state.js
  ```
  let workspace;
  export async function initializeWorkspace(id) {
    const response = await fetch('/api/workspaces/' + id);
    const data = await response.json();
    workspace = data.results;
  }
  export function getCurrentWorkspace() {
    return workspace;
  }
  ```
  file editor.js
  ```
  import { getCurrentWorkspace } from './state.js';
  function renderTopic(i) {
    const span = document.createElement('span');
    span.textContent = getCurrentWorkspace().topics[i].topicName;
  }
  ```

test "DOM-XSS: reassigned API array element -> innerHTML"
  lang javascript
  expect VYQL-INJ-004
  code
  ```
  document.addEventListener("DOMContentLoaded", async () => {
    let discordMembers = [];
    async function loadDiscordMembers() {
      const response = await fetch("/api/discord-members");
      const data = await response.json();
      if (data.success && data.members) {
        discordMembers = data.members;
        populateDiscordMemberSelect();
      }
    }
    function populateDiscordMemberSelect() {
      const optionsContainer = document.querySelector(".custom-select-options");
      discordMembers.forEach((member) => {
        const option = document.createElement("div");
        option.innerHTML = `<img src="${member.avatar}" alt="">`;
        optionsContainer.appendChild(option);
      });
    }
  });
  ```

test "clean: reassigned API array element rendered with DOM API"
  lang javascript
  reject VYQL-INJ-004
  code
  ```
  document.addEventListener("DOMContentLoaded", async () => {
    let discordMembers = [];
    async function loadDiscordMembers() {
      const response = await fetch("/api/discord-members");
      const data = await response.json();
      if (data.success && data.members) {
        discordMembers = data.members;
        populateDiscordMemberSelect();
      }
    }
    function populateDiscordMemberSelect() {
      const optionsContainer = document.querySelector(".custom-select-options");
      discordMembers.forEach((member) => {
        const option = document.createElement("div");
        const avatar = document.createElement("img");
        avatar.src = member.avatar;
        option.appendChild(avatar);
        optionsContainer.appendChild(option);
      });
    }
  });
  ```

test "open redirect: location.hash -> location.href"
  lang javascript
  expect VYQL-RF-002
  code
  ```
  window.location.href = location.hash;
  ```

test "open redirect: location.search -> location.assign"
  lang javascript
  expect VYQL-RF-002
  code
  ```
  location.assign(location.search);
  ```

test "DOM code injection: location.search -> eval"
  lang javascript
  expect VYQL-INJ-003
  code
  ```
  eval(location.search);
  ```

test "clean: a constant innerHTML assignment"
  lang javascript
  reject VYQL-INJ-004
  code
  ```
  el.innerHTML = "<b>welcome</b>";
  ```

test "DOM-XSS: data-original-title tooltip text -> innerHTML"
  lang javascript
  expect VYQL-INJ-004
  code
  ```
  function getTextHeight(text) {
    const tag = document.createElement('div');
    tag.innerHTML = text;
  }
  function isTitleEllipsized(node) {
    const title = node.dataset.originalTitle;
    getTextHeight(title);
  }
  ```

test "clean: data-original-title tooltip text -> innerText"
  lang javascript
  reject VYQL-INJ-004
  code
  ```
  function getTextHeight(text) {
    const tag = document.createElement('div');
    tag.innerText = text;
  }
  function isTitleEllipsized(node) {
    const title = node.dataset.originalTitle;
    getTextHeight(title);
  }
  ```

test "clean: a same-origin constant redirect"
  lang javascript
  reject VYQL-RF-002
  code
  ```
  window.location.href = "/dashboard";
  ```

# Framework breadth
test "angular: bypassSecurityTrustHtml on tainted input is XSS"
  lang javascript
  expect VYQL-INJ-004
  code
  ```
  function render(sanitizer) {
    const u = location.hash;
    return sanitizer.bypassSecurityTrustHtml(u);
  }
  ```

