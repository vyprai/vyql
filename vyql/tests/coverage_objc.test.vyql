# Objective-C coverage breadth: SSRF, ReDoS, weak crypto.

test "objc: env var -> NSURL/dataTaskWithURL is SSRF"
  lang objc
  expect VYQL-RF-001
  code
  ```
  void h() {
    char *u = getenv("URL");
    NSURL *url = [NSURL URLWithString:u];
    [session dataTaskWithURL:url];
  }
  ```

test "objc: a constant URL is clean (SSRF)"
  lang objc
  reject VYQL-RF-001
  code
  ```
  void h() {
    NSURL *url = [NSURL URLWithString:@"https://api.example.com/v1"];
    [session dataTaskWithURL:url];
  }
  ```

test "objc: env var -> NSRegularExpression is ReDoS"
  lang objc
  expect VYQL-DOS-001
  code
  ```
  void h() {
    char *u = getenv("PAT");
    [NSRegularExpression regularExpressionWithPattern:u options:0 error:nil];
  }
  ```

test "objc: CC_MD5 is weak crypto"
  lang objc
  expect VYQL-CRY-001
  code
  ```
  void h() { CC_MD5(data, len, out); }
  ```
