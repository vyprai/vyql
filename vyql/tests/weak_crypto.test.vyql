# Weak crypto (CWE-327): WeakCipher (VYQL-CRY-002) + WeakHash (VYQL-CRY-001),
# presence rules. Named-value matching on the algorithm-spec string where the
# idiom allows (java/php/ruby), constructor presence elsewhere (csharp/go).

test "java: Cipher.getInstance(DES) is a weak cipher"
  lang java
  expect VYQL-CRY-002
  code
  ```
  class C { void f() { Cipher.getInstance("DES/CBC/PKCS5Padding"); } }
  ```

test "java: MessageDigest.getInstance(MD5) is a weak hash"
  lang java
  expect VYQL-CRY-001
  code
  ```
  class C { void f() { MessageDigest.getInstance("MD5"); } }
  ```

test "java: AES/CBC is a strong cipher"
  lang java
  reject VYQL-CRY-002
  code
  ```
  class C { void f() { Cipher.getInstance("AES/CBC/PKCS5Padding"); } }
  ```

test "java: SHA-256 is a strong hash"
  lang java
  reject VYQL-CRY-001
  code
  ```
  class C { void f() { MessageDigest.getInstance("SHA-256"); } }
  ```

test "php: openssl_encrypt with des-ede3-cbc is a weak cipher"
  lang php
  expect VYQL-CRY-002
  code
  ```
  <?php openssl_encrypt($d, "des-ede3-cbc", $k);
  ```

test "php: hash('md5') is a weak hash"
  lang php
  expect VYQL-CRY-001
  code
  ```
  <?php hash("md5", $d);
  ```

test "php: openssl_encrypt with aes-256-gcm is a strong cipher"
  lang php
  reject VYQL-CRY-002
  code
  ```
  <?php openssl_encrypt($d, "aes-256-gcm", $k);
  ```

test "ruby: Digest::MD5 is a weak hash"
  lang ruby
  expect VYQL-CRY-001
  code
  ```
  Digest::MD5.hexdigest(data)
  ```

test "ruby: OpenSSL::Cipher.new('des-cbc') is a weak cipher"
  lang ruby
  expect VYQL-CRY-002
  code
  ```
  OpenSSL::Cipher.new("des-cbc")
  ```

test "ruby: Digest::SHA256 is a strong hash"
  lang ruby
  reject VYQL-CRY-001
  code
  ```
  Digest::SHA256.hexdigest(data)
  ```

test "csharp: DES.Create is a weak cipher"
  lang csharp
  expect VYQL-CRY-002
  code
  ```
  class C { void F() { var d = DES.Create(); } }
  ```

test "csharp: MD5.Create is a weak hash"
  lang csharp
  expect VYQL-CRY-001
  code
  ```
  class C { void F() { var h = MD5.Create(); } }
  ```

test "csharp: SHA256.Create is a strong hash"
  lang csharp
  reject VYQL-CRY-001
  code
  ```
  class C { void F() { var h = SHA256.Create(); } }
  ```

test "go: des.NewCipher is a weak cipher"
  lang go
  expect VYQL-CRY-002
  code
  ```
  package p
  import "crypto/des"
  func h(key []byte) { _, _ = des.NewCipher(key) }
  ```

test "go: aes.NewCipher is a strong cipher"
  lang go
  reject VYQL-CRY-002
  code
  ```
  package p
  import "crypto/aes"
  func h(key []byte) { _, _ = aes.NewCipher(key) }
  ```

test "go: md5.New is a weak hash"
  lang go
  expect VYQL-CRY-001
  code
  ```
  package p
  import "crypto/md5"
  func h() { _ = md5.New() }
  ```

test "go: sha256.New is a strong hash"
  lang go
  reject VYQL-CRY-001
  code
  ```
  package p
  import "crypto/sha256"
  func h() { _ = sha256.New() }
  ```
