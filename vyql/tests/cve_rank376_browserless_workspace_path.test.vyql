# Rank 376 / CVE-2020-7758: browserless-chrome joined the workspace route
# wildcard into workspaceDir and returned/deleted that path without checking
# that the resulting path stayed inside the workspace.

test "rank376: browserless workspace route path can escape workspace"
  lang javascript
  expect VYQL-PATH-018
  expect_review code.BrowserlessWorkspaceFilePathTraversal
  code
  ```
  import path from 'path';
  import rimraf from 'rimraf';

  export const getRoutes = (workspaceDir, router) => {
    router.get(/^\/workspace\/(.*)/, async (req, res) => {
      const file = req.params[0];

      if (!file) {
        return res.sendStatus(400);
      }

      const filePath = path.join(workspaceDir, file);
      const hasFile = await exists(filePath);

      if (!hasFile) {
        return res.sendStatus(404);
      }

      return res.sendFile(filePath, {dotfiles: 'allow'});
    });

    router.delete(/^\/workspace\/(.*)/, async (req, res) => {
      const file = req.params[0];

      if (!file) {
        return res.sendStatus(400);
      }

      const filePath = path.join(workspaceDir, file);
      const hasFile = await exists(filePath);

      if (!hasFile) {
        return res.sendStatus(404);
      }

      rimraf(filePath, () => {});
      return res.sendStatus(204);
    });
  };
  ```

test "rank376: browserless workspace route containment check suppresses focused rule"
  lang javascript
  reject VYQL-PATH-018
  reject_review code.BrowserlessWorkspaceFilePathTraversal
  code
  ```
  import path from 'path';
  import rimraf from 'rimraf';

  export const getRoutes = (workspaceDir, router) => {
    router.get(/^\/workspace\/(.*)/, async (req, res) => {
      const file = req.params[0];

      if (!file) {
        return res.sendStatus(400);
      }

      const filePath = path.join(workspaceDir, file);

      if (!filePath.includes(workspaceDir)) {
        return res.sendStatus(404);
      }

      const hasFile = await exists(filePath);

      if (!hasFile) {
        return res.sendStatus(404);
      }

      return res.sendFile(filePath, {dotfiles: 'allow'});
    });

    router.delete(/^\/workspace\/(.*)/, async (req, res) => {
      const file = req.params[0];

      if (!file) {
        return res.sendStatus(400);
      }

      const filePath = path.join(workspaceDir, file);

      if (!filePath.includes(workspaceDir)) {
        return res.sendStatus(404);
      }

      const hasFile = await exists(filePath);

      if (!hasFile) {
        return res.sendStatus(404);
      }

      rimraf(filePath, () => {});
      return res.sendStatus(204);
    });
  };
  ```
