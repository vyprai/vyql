test "rank610 desktopcommandermcp: Office search compiles caller pattern as regex"
  lang javascript
  expect VYQL-DOS-001
  code
  ```
  class SearchManager {
    async startSearch(options) {
      return this.searchExcelFiles("/tmp", options.pattern, options.ignoreCase !== false);
    }

    async searchExcelFiles(rootPath, pattern, ignoreCase) {
      const flags = ignoreCase ? "i" : "";
      const regex = new RegExp(pattern, flags);
      for (const rowText of rows) {
        if (regex.test(rowText)) {
          results.push(rowText);
        }
      }
    }
  }
  ```

test "rank610 desktopcommandermcp: Office search treats caller pattern as literal"
  lang javascript
  reject VYQL-DOS-001
  code
  ```
  class SearchManager {
    async startSearch(options) {
      return this.searchExcelFiles("/tmp", options.pattern, options.ignoreCase !== false);
    }

    async searchExcelFiles(rootPath, pattern, ignoreCase) {
      const searchTerm = ignoreCase ? pattern.toLowerCase() : pattern;
      for (const rowText of rows) {
        const textToSearch = ignoreCase ? rowText.toLowerCase() : rowText;
        if (textToSearch.indexOf(searchTerm) !== -1) {
          results.push(rowText);
        }
      }
    }
  }
  ```
