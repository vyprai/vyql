# Rank 545 / CVE-2026-30892: crun exec parsed a bare numeric --user
# value but returned before assigning the parsed UID into the zeroed process
# user structure, so "-u 1" became UID 0/GID 0.

test "rank545: crun user parser returns default root before parsed uid assignment"
  lang c
  file exec.c
  expect VYQL-AUTH-031
  expect_review code.ParsedUserIdDefaultRootPrivilegeEscalation
  code
  ```
  typedef struct {
    int uid;
    int gid;
  } runtime_spec_schema_config_schema_process_user;

  extern void *xmalloc0(unsigned long size);
  extern long long strtoll(const char *nptr, char **endptr, int base);

  static runtime_spec_schema_config_schema_process_user *
  make_oci_process_user(const char *userspec)
  {
    runtime_spec_schema_config_schema_process_user *u;
    char *endptr = 0;
    long long l;

    if (userspec == 0)
      return 0;

    u = xmalloc0(sizeof(runtime_spec_schema_config_schema_process_user));
    l = strtoll(userspec, &endptr, 10);
    if (*endptr == '\0')
      return u;
    if (*endptr != ':')
      return 0;

    u->uid = (int) l;
    l = strtoll(endptr + 1, &endptr, 10);
    u->gid = (int) l;
    return u;
  }
  ```

test "rank545: crun user parser assigns parsed uid before bare uid return"
  lang c
  file exec.c
  reject VYQL-AUTH-031
  reject_review code.ParsedUserIdDefaultRootPrivilegeEscalation
  code
  ```
  typedef struct {
    int uid;
    int gid;
  } runtime_spec_schema_config_schema_process_user;

  extern void *xmalloc0(unsigned long size);
  extern long long strtoll(const char *nptr, char **endptr, int base);

  static runtime_spec_schema_config_schema_process_user *
  make_oci_process_user(const char *userspec)
  {
    runtime_spec_schema_config_schema_process_user *u;
    char *endptr = 0;
    long long l;

    if (userspec == 0)
      return 0;

    u = xmalloc0(sizeof(runtime_spec_schema_config_schema_process_user));
    l = strtoll(userspec, &endptr, 10);
    u->uid = (int) l;
    if (*endptr == '\0')
      return u;
    if (*endptr != ':')
      return 0;

    l = strtoll(endptr + 1, &endptr, 10);
    u->gid = (int) l;
    return u;
  }
  ```
