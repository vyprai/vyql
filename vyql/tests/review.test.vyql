test "review: android passcode back navigation bypass is surfaced"
  lang kotlin
  expect_review code.AuthFlowBypassReview
  code
  ```
  import android.view.KeyEvent

  class PassCodeActivity {
    companion object {
      const val ACTION_CHECK = "ACTION_CHECK"
    }
    val intent: Intent = Intent()

    override fun onKeyDown(keyCode: Int, event: KeyEvent): Boolean {
      if (keyCode == KeyEvent.KEYCODE_BACK && event.repeatCount == 0) {
        if (ACTION_CHECK == intent.action) {
          moveTaskToBack(true)
          finishAndRemoveTask()
        }
        return true
      }
      return super.onKeyDown(keyCode, event)
    }
  }
  ```

test "review: authentication challenge attempt-limit logic is surfaced"
  lang go
  expect_review code.AuthAttemptLimitReview
  code
  ```
  package session

  const challengeMaxTries = 5

  var errTooMany error
  var errWrong error

  type service struct {
      challenges map[string]challenge
  }
  type challenge struct {
      tries int
      value string
  }

  func (s *service) SolveChallenge(challengeId string, challengeSolution string) error {
      challenge := s.challenges[challengeId]
      if challenge.tries >= challengeMaxTries {
          return errTooMany
      }
      if challenge.value != challengeSolution {
          challenge.tries++
          s.challenges[challengeId] = challenge
          return errWrong
      }
      return nil
  }
  ```

