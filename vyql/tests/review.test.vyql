test "review: auth checks and targets are surfaced"
  lang java
  expect_review core.AuthorizationCheck
  expect_review core.AuthenticationCheck
  expect_review code.SensitiveOperation
  expect_review code.AuthenticationRequiredOp
  code
  ```
  class User {
    boolean isAuthenticated() { return true; }
  }
  class Admin {
    void handle(User user, String id) {
      hasRole("ADMIN");
      deleteUser(id);
    }
    void update(User user) {
      if (!user.isAuthenticated()) {
        return;
      }
      changePassword("new");
    }
    void deleteUser(String id) {}
    void changePassword(String password) {}
    boolean hasRole(String role) { return true; }
  }
  ```

test "review: jenkins workspace access is an authorization-sensitive operation"
  lang java
  expect_review code.SensitiveOperation
  code
  ```
  class DescriptorImpl {
    FormValidation doCheckApksToSign(AbstractProject project, String value) throws IOException {
      if (project == null) {
        return FormValidation.warning("no project");
      }
      FilePath someWorkspace = project.getSomeWorkspace();
      return FormValidation.ok();
    }
  }
  ```

test "review: jenkins workspace permission check is surfaced near workspace access"
  lang java
  expect_review core.AuthorizationCheck
  expect_review code.SensitiveOperation
  code
  ```
  class DescriptorImpl {
    FormValidation doCheckApksToSign(AbstractProject project, String value) throws IOException {
      if (project == null) {
        return FormValidation.warning("no project");
      }
      project.checkPermission(Item.WORKSPACE);
      FilePath someWorkspace = project.getSomeWorkspace();
      return FormValidation.ok();
    }
  }
  ```

test "review: android passcode back navigation bypass is surfaced"
  lang kotlin
  expect_review code.AuthFlowBypassReview
  code
  ```
  import android.view.KeyEvent

  class PassCodeActivity {
    companion object {
      const val ACTION_CHECK = "ACTION_CHECK"
    }
    val intent: Intent = Intent()

    override fun onKeyDown(keyCode: Int, event: KeyEvent): Boolean {
      if (keyCode == KeyEvent.KEYCODE_BACK && event.repeatCount == 0) {
        if (ACTION_CHECK == intent.action) {
          moveTaskToBack(true)
          finishAndRemoveTask()
        }
        return true
      }
      return super.onKeyDown(keyCode, event)
    }
  }
  ```

test "review: authentication challenge attempt-limit logic is surfaced"
  lang go
  expect_review code.AuthAttemptLimitReview
  code
  ```
  package session

  const challengeMaxTries = 5

  var errTooMany error
  var errWrong error

  type service struct {
      challenges map[string]challenge
  }
  type challenge struct {
      tries int
      value string
  }

  func (s *service) SolveChallenge(challengeId string, challengeSolution string) error {
      challenge := s.challenges[challengeId]
      if challenge.tries >= challengeMaxTries {
          return errTooMany
      }
      if challenge.value != challengeSolution {
          challenge.tries++
          s.challenges[challengeId] = challenge
          return errWrong
      }
      return nil
  }
  ```

test "review: memory attention points are surfaced"
  lang c
  expect_review code.IndexAccess
  expect_review code.IntegerSizeArithmetic
  code
  ```
  struct bar { unsigned long addr; unsigned long size; };
  struct dev { struct bar bar[8]; };
  int pci_emul_mem_handler(struct dev *pdi, unsigned long addr, int size, long arg2) {
    int bidx = (int) arg2;
    return addr + size <= pdi->bar[bidx].addr + pdi->bar[bidx].size;
  }
  ```

test "review: starttls buffer handoff is surfaced"
  lang python
  expect_review code.ProtocolStateReview
  code
  ```
  class SMTP:
      def connection_made(self, transport):
          seen_starttls = self._original_transport is not None
          if self.transport is not None and seen_starttls:
              self._reader._transport = transport
              self._writer._transport = transport
              self.transport = transport
              self.session.ssl = self._tls_protocol._extra
          else:
              super().connection_made(transport)
  ```

test "review: fixed starttls buffer handoff is clean"
  lang python
  reject_review code.ProtocolStateReview
  code
  ```
  class SMTP:
      def connection_made(self, transport):
          seen_starttls = self._original_transport is not None
          if self.transport is not None and seen_starttls:
              self._reader._transport = transport
              self._writer._transport = transport
              self.transport = transport
              self._reader._buffer.clear()
              self.session.ssl = self._tls_protocol._extra
          else:
              super().connection_made(transport)
  ```

test "review: go timer stop without state guard is surfaced"
  lang go
  expect_review code.ProtocolStateReview
  code
  ```
  package main
  import "fmt"
  type UE struct { T3550 *Timer }
  type Timer struct{}
  func (t *Timer) Stop() {}
  func (ue *UE) StopT3550() {
    if ue.T3550 == nil {
      return
    }
    ue.T3550.Stop()
    ue.T3550 = nil
  }
  func HandleRegistrationComplete(ue *UE) error {
    ue.StopT3550()
    return nil
  }
  var _ = fmt.Errorf
  ```

test "review: go timer stop with state guard is clean"
  lang go
  reject_review code.ProtocolStateReview
  code
  ```
  package main
  import "fmt"
  type UE struct { T3550 *Timer }
  type Timer struct{}
  func (t *Timer) Stop() {}
  func (ue *UE) StopT3550() {
    if ue.T3550 == nil {
      return
    }
    ue.T3550.Stop()
    ue.T3550 = nil
  }
  func HandleRegistrationComplete(ue *UE) error {
    if ue.T3550 == nil {
      return fmt.Errorf("unexpected Registration Complete: T3550 not running")
    }
    ue.StopT3550()
    return nil
  }
  ```

