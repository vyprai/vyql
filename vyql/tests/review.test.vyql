test "review: go previous-state protocol check is surfaced"
  lang go
  expect_review code.ProtocolStateReview
  code
  ```
  package main
  import "errors"
  type ATXID [32]byte
  type NodeID [32]byte
  type ActivationTx struct {
    PrevATXID ATXID
    SmesherID NodeID
  }
  type DB struct{}
  var db DB
  var atxs = struct {
    GetLastIDByNodeID func(DB, NodeID) (ATXID, error)
  }{}
  func ContextuallyValidateAtx(atx *ActivationTx) error {
    lastAtx, err := atxs.GetLastIDByNodeID(db, atx.SmesherID)
    if err == nil && atx.PrevATXID == lastAtx {
      return nil
    }
    if err == nil && atx.PrevATXID != lastAtx {
      return errors.New("last atx is not the one referenced")
    }
    if err != nil && atx.PrevATXID != (ATXID{}) {
      return err
    }
    return nil
  }
  ```

test "review: go request-resource scope mismatch check is surfaced"
  lang go
  expect_review code.RequestScopePolicyReview
  code
  ```
  package main
  import "net/http"
  type RequestInfo struct {
    APIGroup string
    Resource string
    Namespace string
    Verb string
  }
  var apirequest = struct {
    RequestInfoFrom func(any) (*RequestInfo, bool)
  }{}
  var apiextensions = struct {
    HasServedCRDVersion func(*CRD, string) bool
  }{}
  type CRD struct {
    Spec struct { Scope string }
  }
  type Lister struct{}
  func (l Lister) Get(name string) (*CRD, error) { return nil, nil }
  type Handler struct { crdLister Lister }
  func (r *Handler) serveResource(w http.ResponseWriter, req *http.Request, crd *CRD) {}
  func (r *Handler) ServeHTTP(w http.ResponseWriter, req *http.Request) {
    requestInfo, _ := apirequest.RequestInfoFrom(req.Context())
    crdName := requestInfo.Resource + "." + requestInfo.APIGroup
    crd, _ := r.crdLister.Get(crdName)
    if !apiextensions.HasServedCRDVersion(crd, "v1") {
      return
    }
    r.serveResource(w, req, crd)
  }
  ```

test "review: go request-resource scope mismatch guard is clean"
  lang go
  reject_review code.RequestScopePolicyReview
  code
  ```
  package main
  import "net/http"
  type RequestInfo struct {
    APIGroup string
    Resource string
    Namespace string
    Verb string
  }
  var apirequest = struct {
    RequestInfoFrom func(any) (*RequestInfo, bool)
  }{}
  var apiextensions = struct {
    HasServedCRDVersion func(*CRD, string) bool
    NamespaceScoped string
  }{}
  var possiblyAcrossAllNamespacesVerbs = struct {
    Has func(string) bool
  }{}
  type CRD struct {
    Spec struct { Scope string }
  }
  type Lister struct{}
  func (l Lister) Get(name string) (*CRD, error) { return nil, nil }
  type Delegate struct{}
  func (d Delegate) ServeHTTP(w http.ResponseWriter, req *http.Request) {}
  type Handler struct {
    crdLister Lister
    delegate Delegate
  }
  func (r *Handler) serveResource(w http.ResponseWriter, req *http.Request, crd *CRD) {}
  func (r *Handler) ServeHTTP(w http.ResponseWriter, req *http.Request) {
    requestInfo, _ := apirequest.RequestInfoFrom(req.Context())
    crdName := requestInfo.Resource + "." + requestInfo.APIGroup
    crd, _ := r.crdLister.Get(crdName)
    namespacedCRD := crd.Spec.Scope == apiextensions.NamespaceScoped
    namespacedReq := len(requestInfo.Namespace) > 0
    if !namespacedCRD && namespacedReq {
      r.delegate.ServeHTTP(w, req)
      return
    }
    if namespacedCRD && !namespacedReq && !possiblyAcrossAllNamespacesVerbs.Has(requestInfo.Verb) {
      r.delegate.ServeHTTP(w, req)
      return
    }
    if !apiextensions.HasServedCRDVersion(crd, "v1") {
      return
    }
    r.serveResource(w, req, crd)
  }
  ```

test "review: go admission ignoring all pod subresources is surfaced"
  lang go
  expect_review code.AdmissionSubresourcePolicyReview
  code
  ```
  package main
  type Attributes interface {
    GetResource() Resource
    GetSubresource() string
  }
  type Resource string
  func (r Resource) GroupResource() Resource { return r }
  type Constraint struct{}
  func (c *Constraint) Admit(a Attributes) error {
    ignore, err := shouldIgnore(a)
    if err != nil {
      return err
    }
    if ignore {
      return nil
    }
    return c.computeSecurityContext(a)
  }
  func (c *Constraint) computeSecurityContext(a Attributes) error { return nil }
  func shouldIgnore(a Attributes) (bool, error) {
    if a.GetResource().GroupResource() != Resource("pods") {
      return true, nil
    }
    if len(a.GetSubresource()) != 0 {
      return true, nil
    }
    return false, nil
  }
  ```

test "review: go admission explicit pod subresource policy is clean"
  lang go
  reject_review code.AdmissionSubresourcePolicyReview
  code
  ```
  package main
  type Attributes interface {
    GetResource() Resource
    GetSubresource() string
  }
  type Resource string
  func (r Resource) GroupResource() Resource { return r }
  type stringSet struct{}
  func (s stringSet) Has(v string) bool { return true }
  var ignoredSubresources = stringSet{}
  type Constraint struct{}
  func (c *Constraint) Admit(a Attributes) error {
    ignore, err := shouldIgnore(a)
    if err != nil {
      return err
    }
    if ignore {
      return nil
    }
    return c.computeSecurityContext(a)
  }
  func (c *Constraint) computeSecurityContext(a Attributes) error { return nil }
  func shouldIgnore(a Attributes) (bool, error) {
    if a.GetResource().GroupResource() != Resource("pods") {
      return true, nil
    }
    if subresource := a.GetSubresource(); len(subresource) != 0 && ignoredSubresources.Has(subresource) {
      return true, nil
    }
    return false, nil
  }
  ```

