test "review: csharp html sanitizer parser pipeline is surfaced"
  lang csharp
  expect_review code.HtmlSanitizerLogicReview
  code
  ```
  using HtmlAgilityPack;

  class AntiSamyDomScanner {
    public string Scan(string html) {
      var htmlDocument = new HtmlDocument();
      htmlDocument.LoadHtml(html);
      ProcessChildren(htmlDocument.DocumentNode);
      return htmlDocument.DocumentNode.InnerHtml.Trim();
    }

    private void ProcessChildren(HtmlNode node) {}
  }
  ```

