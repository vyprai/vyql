test "rank839: Python viewer scope grants configuration read"
  lang python
  expect VYQL-AUTH-028
  expect_review code.OverbroadRolePermissionGrant
  code
  ```
  from enum import Enum
  from fides.common.api.scope_registry import (
      CLIENT_READ,
      CONFIG_READ,
      CONFIG_UPDATE,
      CONNECTION_READ,
      MESSAGING_CREATE_OR_UPDATE,
      MESSAGING_DELETE,
      SCOPE_REGISTRY,
      STORAGE_CREATE_OR_UPDATE,
      STORAGE_DELETE,
      USER_PERMISSION_ASSIGN_OWNERS,
  )

  OWNER = "owner"
  VIEWER = "viewer"
  CONTRIBUTOR = "contributor"

  class RoleRegistryEnum(Enum):
      owner = OWNER
      viewer = VIEWER
      contributor = CONTRIBUTOR

  viewer_scopes = [
      CLIENT_READ,
      CONFIG_READ,
      CONNECTION_READ,
  ]

  not_contributor_scopes = [
      STORAGE_CREATE_OR_UPDATE,
      STORAGE_DELETE,
      MESSAGING_CREATE_OR_UPDATE,
      MESSAGING_DELETE,
      CONFIG_UPDATE,
      USER_PERMISSION_ASSIGN_OWNERS,
  ]

  ROLES_TO_SCOPES_MAPPING = {
      OWNER: sorted(SCOPE_REGISTRY),
      VIEWER: sorted(viewer_scopes),
      CONTRIBUTOR: sorted(list(set(SCOPE_REGISTRY) - set(not_contributor_scopes))),
  }
  ```

test "rank839: Python viewer and contributor scopes exclude configuration read"
  lang python
  reject VYQL-AUTH-028
  reject_review code.OverbroadRolePermissionGrant
  code
  ```
