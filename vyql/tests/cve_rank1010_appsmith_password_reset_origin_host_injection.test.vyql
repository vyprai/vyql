# Rank 1010 / CVE-2026-22794: Appsmith account takeover through password-reset
# Origin header injection. The forgotPassword and email-verification endpoints
# take the request Origin header, store it as the DTO baseUrl, and build the
# reset-token link from it without validating it against the configured
# APPSMITH_BASE_URL. An attacker sends a reset request with a spoofed Origin, so
# the victim's reset email links to the attacker host carrying the real token
# (CWE-346, CWE-640). The fix 6f9ee6226b adds validateBaseUrl(), which rejects a
# provided base URL that does not equal APPSMITH_BASE_URL when it is configured.
#
# ATTENTION, extractor/engine gap. The right concept already exists:
# code.PasswordRecoveryLinkHostControl (VYQL-AUTH-003, CWE-640), "password
# recovery notifications build reset links from request-derived host metadata".
# It fires only through a frontend-computed review tag
# (phpReview == "password_recovery_link_host_control") that the PHP extractor
# produces and the Java extractor does not, so it never fires on this code.
# Reaching it in Java precisely requires either that extractor classification
# (engine work, out of scope for this loop) or new taint machinery: the danger
# is that the reset-link host is request-derived, which is a cross-function fact
# (the controller sets baseUrl from @RequestHeader("Origin"), the service sends
# the email). A function-scoped presence binding cannot see the host's origin,
# so keying on "reset email built from getBaseUrl without validateBaseUrl" would
# fire on every application that builds reset links from a configured base URL,
# which is the safe majority. The existing taint finding VYQL-INJ-004 follows
# the DTO to the reset URL but mislabels the reset-URL sink as HtmlRender (XSS),
# not CWE-346/640, and does not key on the base-URL validation control.
#
# verify_current_expected: attention-engine-gap

test "rank1010: reset link built from request Origin baseUrl with no base-URL validation"
  lang java
  file UserServiceCEImpl.java
  reject VYQL-AUTH-003
  code
  ```
  public class UserServiceCEImpl {
      private Mono<Boolean> forgotPasswordTokenGenerate(ResetUserPasswordDTO resetUserPasswordDTO) {
          String email = resetUserPasswordDTO.getEmail();
          String token = generateToken(email);
          String resetUrl = String.format(
                  FORGOT_PASSWORD_CLIENT_URL_FORMAT,
                  resetUserPasswordDTO.getBaseUrl(),
                  EncryptionHelper.encrypt("email=" + email + "&token=" + token));
          return emailService.sendForgotPasswordEmail(email, resetUrl, resetUserPasswordDTO.getBaseUrl());
      }
  }
  ```

test "rank1010: fix validates the provided base URL against APPSMITH_BASE_URL first"
  lang java
  file UserServiceCEImpl.java
  reject VYQL-AUTH-003
  code
  ```
  public class UserServiceCEImpl {
      @Value("${APPSMITH_BASE_URL:}")
      private String appsmithBaseUrl;

      private Mono<Void> validateBaseUrl(String providedBaseUrl) {
          if (!StringUtils.hasText(appsmithBaseUrl)) {
              return Mono.empty();
          }
          if (!appsmithBaseUrl.equals(providedBaseUrl)) {
              return Mono.error(new AppsmithException(AppsmithError.INVALID_PARAMETER, "Origin"));
          }
          return Mono.empty();
      }

      private Mono<Boolean> forgotPasswordTokenGenerate(ResetUserPasswordDTO resetUserPasswordDTO) {
          return validateBaseUrl(resetUserPasswordDTO.getBaseUrl()).then(Mono.defer(() -> {
              String email = resetUserPasswordDTO.getEmail();
              String token = generateToken(email);
              String resetUrl = String.format(
                      FORGOT_PASSWORD_CLIENT_URL_FORMAT,
                      resetUserPasswordDTO.getBaseUrl(),
                      EncryptionHelper.encrypt("email=" + email + "&token=" + token));
              return emailService.sendForgotPasswordEmail(email, resetUrl, resetUserPasswordDTO.getBaseUrl());
          }));
      }
  }
  ```
