# B2 — resource leak (CWE-772, VYQL-RES-001). A type-state rule: a handle allocated but
# not released on EVERY path to function exit leaks. `closed_by` is a POST-dominance check
# over the structured CFG — a close in only one branch does not cover the others.

test "resource-leak: a socket closed on every path is clean (python)"
  lang python
  reject VYQL-RES-001
  code
  ```
  import socket
  def f():
      s = socket.socket()
      s.close()
  ```

test "resource-leak: a socket never closed leaks (python)"
  lang python
  expect VYQL-RES-001
  code
  ```
  import socket
  def f():
      s = socket.socket()
      s.send(b"x")
  ```

test "resource-leak: a socket closed only in one branch leaks on the others (python)"
  lang python
  expect VYQL-RES-001
  code
  ```
  import socket
  def f(cond):
      s = socket.socket()
      if cond:
          s.close()
  ```

test "resource-leak: a Go connection closed on every path is clean"
  lang go
  reject VYQL-RES-001
  code
  ```
  package p
  import "net"
  func f() {
    c, _ := net.Dial("tcp", "example.com:443")
    c.Close()
  }
  ```

test "resource-leak: a Go connection never closed leaks"
  lang go
  expect VYQL-RES-001
  code
  ```
  package p
  import "net"
  func f() {
    c, _ := net.Dial("tcp", "example.com:443")
    c.Write([]byte("x"))
  }
  ```

test "resource-leak: a Go connection closed only in one branch leaks on the others"
  lang go
  expect VYQL-RES-001
  code
  ```
  package p
  import "net"
  func f(cond bool) {
    c, _ := net.Dial("tcp", "example.com:443")
    if cond {
      c.Close()
    }
  }
  ```

test "resource-leak: a Java socket closed on every path is clean"
  lang java
  reject VYQL-RES-001
  code
  ```
  class C {
    void f() throws Exception {
      Socket s = new Socket("example.com", 443);
      s.close();
    }
  }
  ```

test "resource-leak: a Java socket never closed leaks"
  lang java
  expect VYQL-RES-001
  code
  ```
  class C {
    void f() throws Exception {
      Socket s = new Socket("example.com", 443);
      s.getInputStream();
    }
  }
  ```

test "resource-leak: a Java socket closed only in one branch leaks on the others"
  lang java
  expect VYQL-RES-001
  code
  ```
  class C {
    void f(boolean cond) throws Exception {
      Socket s = new Socket("example.com", 443);
      if (cond) {
        s.close();
      }
    }
  }
  ```

test "resource-leak: a C# file handle closed on every path is clean"
  lang csharp
  reject VYQL-RES-001
  code
  ```
  class C {
    void F() {
      var f = File.Open("data.txt", FileMode.Open);
      f.Close();
    }
  }
  ```

test "resource-leak: a C# file handle never closed leaks"
  lang csharp
  expect VYQL-RES-001
  code
  ```
  class C {
    void F() {
      var f = File.Open("data.txt", FileMode.Open);
      f.ReadByte();
    }
  }
  ```

test "resource-leak: a C# file handle closed only in one branch leaks on the others"
  lang csharp
  expect VYQL-RES-001
  code
  ```
  class C {
    void F(bool cond) {
      var f = File.Open("data.txt", FileMode.Open);
      if (cond) {
        f.Close();
      }
    }
  }
  ```

test "resource-leak: a C# file handle disposed on every path is clean"
  lang csharp
  reject VYQL-RES-001
  code
  ```
  class C {
    void F() {
      var f = File.Open("data.txt", FileMode.Open);
      f.Dispose();
    }
  }
  ```

test "resource-leak: a PHP file handle closed on every path is clean"
  lang php
  reject VYQL-RES-001
  code
  ```
  <?php function f(){ $h = fopen("data.txt", "r"); fclose($h); }
  ```

test "resource-leak: a PHP file handle never closed leaks"
  lang php
  expect VYQL-RES-001
  code
  ```
  <?php function f(){ $h = fopen("data.txt", "r"); fread($h, 1); }
  ```

test "resource-leak: a PHP file handle closed only in one branch leaks on the others"
  lang php
  expect VYQL-RES-001
  code
  ```
  <?php function f($cond){ $h = fopen("data.txt", "r"); if ($cond) { fclose($h); } }
  ```

test "resource-leak: a Ruby socket closed on every path is clean"
  lang ruby
  reject VYQL-RES-001
  code
  ```
  def f
    s = TCPSocket.open("example.com", 443)
    s.close
  end
  ```

test "resource-leak: a Ruby socket never closed leaks"
  lang ruby
  expect VYQL-RES-001
  code
  ```
  def f
    s = TCPSocket.open("example.com", 443)
    s.write("x")
  end
  ```

test "resource-leak: a Ruby socket closed only in one branch leaks on the others"
  lang ruby
  expect VYQL-RES-001
  code
  ```
  def f(cond)
    s = TCPSocket.open("example.com", 443)
    if cond
      s.close
    end
  end
  ```
