test "rank397: clasp remote script filename escapes local content directory"
  lang javascript
  file files.ts
  expect VYQL-PATH-019
  expect_review code.ClaspRemoteFilePathTraversal
  code
  ```
  import path from 'path';
  import {google} from 'googleapis';

  interface ProjectFile {
    readonly localPath: string;
    readonly remotePath?: string;
    readonly source?: string;
    readonly type?: string;
  }

  function getFileExtension(type: string | null | undefined) {
    return type === 'HTML' ? '.html' : '.js';
  }

  export class Files {
    private options: any;

    async fetchRemote(versionNumber?: number): Promise<ProjectFile[]> {
      const credentials = this.options.credentials;
      const contentDir = this.options.files.contentDir;
      const scriptId = this.options.project.scriptId;
      const script = google.script({version: 'v1', auth: credentials});
      const response = await script.projects.getContent({scriptId, versionNumber});
      const files = response.data.files ?? [];

      return files.map(f => {
        const ext = getFileExtension(f.type);
        const localPath = path.relative(process.cwd(), path.resolve(contentDir, `${f.name}${ext}`));

        return {
          localPath: localPath,
          remotePath: f.name ?? undefined,
          source: f.source ?? undefined,
          type: f.type ?? undefined,
        };
      });
    }
  }
  ```

test "rank397: clasp rejects remote script filenames outside content directory"
  lang javascript
  file files.ts
  reject VYQL-PATH-019
  reject_review code.ClaspRemoteFilePathTraversal
  code
  ```
  import path from 'path';
  import {google} from 'googleapis';

  interface ProjectFile {
    readonly localPath: string;
    readonly remotePath?: string;
    readonly source?: string;
    readonly type?: string;
  }

  function getFileExtension(type: string | null | undefined) {
    return type === 'HTML' ? '.html' : '.js';
  }

  function isInside(parentPath: string, childPath: string): boolean {
    const relative = path.relative(parentPath, childPath);
    return relative !== '' && !relative.startsWith('..') && !path.isAbsolute(relative);
  }

  export class Files {
    private options: any;

    async fetchRemote(versionNumber?: number): Promise<ProjectFile[]> {
      const credentials = this.options.credentials;
      const contentDir = this.options.files.contentDir;
      const scriptId = this.options.project.scriptId;
      const script = google.script({version: 'v1', auth: credentials});
      const response = await script.projects.getContent({scriptId, versionNumber});
      const files = response.data.files ?? [];
      const absoluteContentDir = path.resolve(contentDir);

      return files.map(f => {
        const ext = getFileExtension(f.type);
        const resolvedPath = path.resolve(contentDir, `${f.name}${ext}`);
        if (!isInside(absoluteContentDir, resolvedPath)) {
          throw new Error('remote path escapes content directory');
        }
        const localPath = path.relative(process.cwd(), resolvedPath);

        return {
          localPath,
          remotePath: f.name ?? undefined,
          source: f.source ?? undefined,
          type: f.type ?? undefined,
        };
      });
    }
  }
  ```
