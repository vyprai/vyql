test "rank236: C nullable file-transfer result is dereferenced without a guard"
  lang c
  expect VYQL-MEM-018
  expect_review code.UncheckedNullableResultDeref
  code
  ```
  typedef int gboolean;
  typedef void *gpointer;
  typedef int gint;
  typedef int b_input_condition;

  struct file_transfer { void *data; int (*write)(struct file_transfer *, char *, int); };
  struct prpl_xfer_data { struct file_transfer *ft; };
  struct PurpleXfer { void *account; char *who; char *filename; int size; void *ui_data; };

  struct file_transfer *imcb_file_send_start(void *ic, char *who, char *filename, int size);

  static gboolean prplcb_xfer_new_send_cb(gpointer data, gint fd, b_input_condition cond)
  {
      struct PurpleXfer *xfer = data;
      void *ic = xfer->account;
      struct prpl_xfer_data *px = xfer->ui_data;
      const char *who = xfer->who;

      px->ft = imcb_file_send_start(ic, (char *) who, xfer->filename, xfer->size);
      px->ft->data = px;
      return 0;
  }
  ```

test "rank236: C nullable file-transfer result is guarded before dereference"
  lang c
  reject VYQL-MEM-018
  reject_review code.UncheckedNullableResultDeref
  code
  ```
  typedef int gboolean;
  typedef void *gpointer;
  typedef int gint;
  typedef int b_input_condition;

  struct file_transfer { void *data; int (*write)(struct file_transfer *, char *, int); };
  struct prpl_xfer_data { struct file_transfer *ft; };
  struct PurpleXfer { void *account; char *who; char *filename; int size; void *ui_data; };

  struct file_transfer *imcb_file_send_start(void *ic, char *who, char *filename, int size);

  static gboolean prplcb_xfer_new_send_cb(gpointer data, gint fd, b_input_condition cond)
  {
      struct PurpleXfer *xfer = data;
      void *ic = xfer->account;
      struct prpl_xfer_data *px = xfer->ui_data;
      const char *who = xfer->who;

      px->ft = imcb_file_send_start(ic, (char *) who, xfer->filename, xfer->size);
      if (!px->ft) {
          return 0;
      }
      px->ft->data = px;
      return 0;
  }
  ```
