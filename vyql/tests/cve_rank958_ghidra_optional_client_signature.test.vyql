# Rank 958 / CVE-2026-52754: Ghidra PKI authentication skipped
# client signature verification when the callback signature was absent.

test "rank958: PKI authentication treats client signature as optional"
  lang java
  profile api
  file PKIAuthenticationModule.java
  expect VYQL-AUTH-072
  expect_review code.OptionalClientSignatureVerification
  code
  ```
  import java.security.Signature;
  import java.security.cert.X509Certificate;
  import javax.security.auth.login.FailedLoginException;
  import javax.security.auth.login.LoginException;

  class PKIAuthenticationModule {
    String authenticate(UserManager userMgr, SignatureCallback sigCb, byte[] token)
        throws LoginException {
      X509Certificate[] certChain = sigCb.getCertificateChain();
      Trust.validateClient(certChain);
      byte[] sigBytes = sigCb.getSignature();
      if (sigBytes != null) {
        Signature sig = Signature.getInstance(certChain[0].getSigAlgName());
        sig.initVerify(certChain[0]);
        sig.update(token);
        if (!sig.verify(sigBytes)) {
          throw new FailedLoginException("Incorrect signature");
        }
      }
      return userMgr.getUserByDistinguishedName(certChain[0].getSubjectX500Principal());
    }
  }
  class SignatureCallback {
    X509Certificate[] getCertificateChain() { return null; }
    byte[] getSignature() { return null; }
  }
  class UserManager {
    String getUserByDistinguishedName(Object dn) { return "user"; }
  }
  class Trust {
    static void validateClient(X509Certificate[] certChain) {}
  }
  ```

test "rank958: PKI authentication requires client signature"
  lang java
  profile api
  file PKIAuthenticationModule.java
  reject VYQL-AUTH-072
  reject_review code.OptionalClientSignatureVerification
  code
  ```
  import java.security.Signature;
  import java.security.cert.X509Certificate;
  import javax.security.auth.login.FailedLoginException;
  import javax.security.auth.login.LoginException;

  class PKIAuthenticationModule {
    String authenticate(UserManager userMgr, SignatureCallback sigCb, byte[] token)
        throws LoginException {
      X509Certificate[] certChain = sigCb.getCertificateChain();
      Trust.validateClient(certChain);
      byte[] sigBytes = sigCb.getSignature();
      if (sigBytes == null) {
        throw new FailedLoginException("Client signature required");
      }
      Signature sig = Signature.getInstance(certChain[0].getSigAlgName());
      sig.initVerify(certChain[0]);
      sig.update(token);
      if (!sig.verify(sigBytes)) {
        throw new FailedLoginException("Incorrect signature");
      }
      return userMgr.getUserByDistinguishedName(certChain[0].getSubjectX500Principal());
    }
  }
  class SignatureCallback {
    X509Certificate[] getCertificateChain() { return null; }
    byte[] getSignature() { return null; }
  }
  class UserManager {
    String getUserByDistinguishedName(Object dn) { return "user"; }
  }
  class Trust {
    static void validateClient(X509Certificate[] certChain) {}
  }
  ```
