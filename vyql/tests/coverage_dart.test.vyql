# Dart (Flutter / dart:io / sqflite) coverage: SQLi, command, SSRF, path.

test "dart: env var -> sqflite rawQuery is SQL injection"
  lang dart
  expect VYQL-INJ-001
  code
  ```
  void handle() {
    var name = Platform.environment["NAME"];
    db.rawQuery("SELECT * FROM users WHERE name = '" + name + "'");
  }
  ```

test "dart: a constant query is clean"
  lang dart
  reject VYQL-INJ-001
  code
  ```
  void handle() {
    db.rawQuery("SELECT * FROM users");
  }
  ```

test "dart: env var -> Process.run is command injection"
  lang dart
  expect VYQL-INJ-002
  code
  ```
  void handle() {
    var cmd = Platform.environment["CMD"];
    Process.run(cmd, []);
  }
  ```

test "dart: env var -> http.get is SSRF"
  lang dart
  expect VYQL-RF-001
  code
  ```
  void handle() {
    var url = Platform.environment["URL"];
    http.get(url);
  }
  ```

test "dart: env var -> File is path traversal"
  lang dart
  expect VYQL-PATH-001
  code
  ```
  void handle() {
    var path = Platform.environment["FILE"];
    File(path).readAsString();
  }
  ```
