# Rank 970 / CVE-2019-1003018: Jenkins GitHub OAuth plugin rendered the OAuth
# clientSecret field with f:textbox. The fix uses f:password so the value is
# masked and round-tripped in encrypted form.

test "rank970: Jenkins Jelly secret-like field uses textbox"
  lang config
  profile library
  file src/main/resources/org/jenkinsci/plugins/GithubSecurityRealm/config.jelly
  expect VYQL-SEC-038
  expect_review code.JenkinsJellySecretTextboxExposure
  code
  ```
  <?jelly escape-by-default='true'?>
  <j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
      <f:entry title="Client Secret" field="clientSecret" help="/plugin/github-oauth/help/realm/client-secret-help.html">
          <f:textbox />
      </f:entry>
  </j:jelly>
  ```

test "rank970: Jenkins Jelly secret-like field uses password"
  lang config
  profile library
  file src/main/resources/org/jenkinsci/plugins/GithubSecurityRealm/config.jelly
  reject VYQL-SEC-038
  reject_review code.JenkinsJellySecretTextboxExposure
  code
  ```
  <?jelly escape-by-default='true'?>
  <j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
      <f:entry title="Client Secret" field="clientSecret" help="/plugin/github-oauth/help/realm/client-secret-help.html">
          <f:password />
      </f:entry>
  </j:jelly>
  ```
