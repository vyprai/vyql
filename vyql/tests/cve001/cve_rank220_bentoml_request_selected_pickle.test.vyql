test "rank220: BentoML main endpoint accepts request-selected pickle serde"
  lang python
  expect VYQL-DESER-010
  expect_review code.RequestSelectedDeserializationFormat
  code
  ```
  class ServiceAppFactory:
      async def api_endpoint(self, name, request):
          from ..serde import ALL_SERDE

          media_type = request.headers.get("Content-Type", "application/json")
          media_type = media_type.split(";")[0].strip()

          method = self.service.apis[name]
          serde = ALL_SERDE.get(media_type, ALL_SERDE["application/json"])()
          input_data = await method.input_spec.from_http_request(request, serde)
          return input_data
  ```

test "rank220: BentoML main endpoint rejects pickle serde before request deserialization"
  lang python
  reject VYQL-DESER-010
  reject_review code.RequestSelectedDeserializationFormat
  code
  ```
  class ServiceAppFactory:
      async def api_endpoint(self, name, request):
          from http import HTTPStatus
          from ..serde import ALL_SERDE

          media_type = request.headers.get("Content-Type", "application/json")
          media_type = media_type.split(";")[0].strip()

          if self.is_main and media_type == "application/vnd.bentoml+pickle":
              raise BentoMLException(
                  "application/vnd.bentoml+pickle is not allowed in main server",
                  error_code=HTTPStatus.UNSUPPORTED_MEDIA_TYPE,
              )

          method = self.service.apis[name]
          serde = ALL_SERDE.get(media_type, ALL_SERDE["application/json"])()
          input_data = await method.input_spec.from_http_request(request, serde)
          return input_data
  ```
