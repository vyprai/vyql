test "rank737: elFinder zipdl joins temp filename before separator validation"
  lang php
  file elFinder.class.php
  expect VYQL-PATH-036
  expect_review code.TempPathJoinBeforeSeparatorCheck
  code
  ```
  <?php
  class elFinder {
    protected function zipdl($args) {
      $targets = $args['targets'];
      if (count($targets) !== 4 || ($volume = $this->volume($targets[0])) == false) {
        return array('error' => 'File not found');
      }
      $file = $targets[1];
      $path = $volume->getTempPath().DIRECTORY_SEPARATOR.$file;
      $GLOBALS['elFinderTempFiles'][$path] = true;
      if (!is_readable($path)) {
        return array('error' => 'File not found');
      }
      return fopen($path, 'rb');
    }
  }
  ?>
  ```

test "rank737: elFinder zipdl rejects path separators before temp path use"
  lang php
  file elFinder.class.php
  reject VYQL-PATH-036
  reject_review code.TempPathJoinBeforeSeparatorCheck
  code
  ```
  <?php
  class elFinder {
    protected function zipdl($args) {
      $targets = $args['targets'];
      if (count($targets) !== 4 || ($volume = $this->volume($targets[0])) == false) {
        return array('error' => 'File not found');
      }
      $file = $targets[1];
      if (strpos($file, DIRECTORY_SEPARATOR) !== false) {
        return array('error' => 'File not found');
      }
      $path = $volume->getTempPath().DIRECTORY_SEPARATOR.$file;
      $GLOBALS['elFinderTempFiles'][$path] = true;
      if (!is_writable($path)) {
        return array('error' => 'File not found');
      }
      return fopen($path, 'rb');
    }
  }
  ?>
  ```
