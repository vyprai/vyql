test "rank318: capsule-proxy impersonation headers lack hop-by-hop stripping"
  lang go
  expect VYQL-AUTH-011
  expect_review code.HopByHopHeaderAuthBypass
  code
  ```
  package webserver

  import (
      "fmt"
      "net/http"
  )

  type kubeFilter struct {
      bearerToken string
  }

  type httpRequest struct{}

  func newHTTP(request *http.Request) httpRequest { return httpRequest{} }
  func (h httpRequest) GetUserAndGroups() (string, []string, error) {
      return "alice", []string{"team"}, nil
  }

  func (n kubeFilter) impersonateHandler(writer http.ResponseWriter, request *http.Request) {
      hr := newHTTP(request)
      username, groups, err := hr.GetUserAndGroups()
      if err != nil {
          return
      }

      if len(n.bearerToken) > 0 {
          request.Header.Set("Authorization", fmt.Sprintf("Bearer %s", n.bearerToken))
      }

      request.Header.Add("Impersonate-User", username)
      for _, group := range groups {
          request.Header.Add("Impersonate-Group", group)
      }
  }
  ```

test "rank318: capsule-proxy drops hop-by-hop headers before impersonation"
  lang go
  reject VYQL-AUTH-011
  reject_review code.HopByHopHeaderAuthBypass
  code
  ```
  package webserver

  import (
      "fmt"
      "net/http"
  )

  type kubeFilter struct {
      bearerToken string
  }

  type httpRequest struct{}

  func newHTTP(request *http.Request) httpRequest { return httpRequest{} }
  func (h httpRequest) GetUserAndGroups() (string, []string, error) {
      return "alice", []string{"team"}, nil
  }
  func (n kubeFilter) removingHopByHopHeaders(request *http.Request) {}

  func (n kubeFilter) impersonateHandler(writer http.ResponseWriter, request *http.Request) {
      hr := newHTTP(request)
      username, groups, err := hr.GetUserAndGroups()
      if err != nil {
          return
      }

      if len(n.bearerToken) > 0 {
          request.Header.Set("Authorization", fmt.Sprintf("Bearer %s", n.bearerToken))
      }
      n.removingHopByHopHeaders(request)

      request.Header.Add("Impersonate-User", username)
      for _, group := range groups {
          request.Header.Add("Impersonate-Group", group)
      }
  }
  ```
