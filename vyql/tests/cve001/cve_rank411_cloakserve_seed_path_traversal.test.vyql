# Rank 411 / CVE-2026-45727: CloakBrowser cloakserve used the request-supplied
# fingerprint seed as a Chrome profile directory component. The fix adds a
# strict SAFE_SEED_RE allowlist before joining the seed under data_dir.

test "rank411: cloakserve fingerprint seed reaches profile directory path"
  lang python
  expect VYQL-PATH-001
  expect VYQL-PATH-021
  expect_review code.CloakserveFingerprintSeedPathTraversal
  code
  ```
  import asyncio
  import os
  import shutil

  class ChromePool:
      def __init__(self, data_dir):
          self._data_dir = data_dir

      async def get_or_launch(self, seed):
          if seed is None:
              seed_key = "__default__"
          else:
              seed_key = seed
          user_data_dir = os.path.join(self._data_dir, seed_key)
          os.makedirs(user_data_dir, exist_ok=True)
          await asyncio.to_thread(shutil.rmtree, user_data_dir, True)

  async def handle_ws_seed(request):
      pool = request.app["pool"]
      seed = request.match_info["seed"]
      return await pool.get_or_launch(seed=seed)
  ```

test "rank411: cloakserve validates fingerprint seed before profile directory path"
  lang python
  reject VYQL-PATH-021
  reject_review code.CloakserveFingerprintSeedPathTraversal
  code
  ```
  import asyncio
  import os
  import re
  from aiohttp import web

  SAFE_SEED_RE = re.compile(r"^[A-Za-z0-9_-]{1,128}$")
  RESERVED_SEEDS = {"__default__"}

  class ChromePool:
      def __init__(self, data_dir):
          self._data_dir = data_dir

      def _safe_rmtree(self, path):
          return None

      async def get_or_launch(self, seed):
          if seed is None:
              seed_key = "__default__"
          else:
              if not SAFE_SEED_RE.match(seed) or seed in RESERVED_SEEDS:
                  raise web.HTTPBadRequest(text="Invalid fingerprint seed")
              seed_key = seed
          user_data_dir = os.path.join(self._data_dir, seed_key)
          os.makedirs(user_data_dir, exist_ok=True)
          await asyncio.to_thread(self._safe_rmtree, user_data_dir)

  async def handle_ws_seed(request):
      pool = request.app["pool"]
      seed = request.match_info["seed"]
      return await pool.get_or_launch(seed=seed)
  ```
