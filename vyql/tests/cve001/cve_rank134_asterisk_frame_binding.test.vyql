# IAX2 full-frame call binding. The chan_iax2.c match() that walks the call
# table accepts an incoming frame as an existing call on the peer's source call
# number alone; the frame's destination call number is consulted only in the
# branch where no peer number is known yet, so a full frame that is required to
# carry our call number is bound to the call without that number being checked.
# The fix threads a full_frame flag down from socket_process() through
# find_callno() and requires the destination number to equal the call's own
# number before a full frame is taken for it.

test "rank134: c iax2 call match binding a frame on the source number alone reports the frame-binding rule"
  lang c
  expect VYQL-AUTH-087
  expect_review code.ProtocolFrameBindingReview
  code
  ```
  struct sockaddr_in {
      struct { unsigned int s_addr; } sin_addr;
      unsigned short sin_port;
  };
  enum { TRANSFER_NONE, TRANSFER_BEGIN, TRANSFER_READY, TRANSFER_REL, TRANSFER_MEDIAPASS };
  struct chan_iax2_pvt {
      struct sockaddr_in addr;
      struct sockaddr_in transfer;
      int transferring;
      unsigned short transfercallno;
      unsigned short peercallno;
      unsigned short callno;
  };

  static int match(struct sockaddr_in *sin, unsigned short callno,
                   unsigned short dcallno, const struct chan_iax2_pvt *cur)
  {
      if ((cur->addr.sin_addr.s_addr == sin->sin_addr.s_addr) &&
          (cur->addr.sin_port == sin->sin_port)) {
          /* This is the main host */
          if ((cur->peercallno == callno) ||
              ((dcallno == cur->callno) && !cur->peercallno)) {
              /* That's us.  Be sure we keep track of the peer call number */
              return 1;
          }
      }
      if ((cur->transfer.sin_addr.s_addr == sin->sin_addr.s_addr) &&
          (cur->transfer.sin_port == sin->sin_port) && (cur->transferring)) {
          /* We're transferring */
          if ((dcallno == cur->callno) ||
              (cur->transferring == TRANSFER_MEDIAPASS && cur->transfercallno == callno))
              return 1;
      }
      return 0;
  }
  ```

test "rank134: c iax2 call match requiring the destination number for a full frame is clean"
  lang c
  reject VYQL-AUTH-087
  reject_review code.ProtocolFrameBindingReview
  code
  ```
  struct sockaddr_in {
      struct { unsigned int s_addr; } sin_addr;
      unsigned short sin_port;
  };
  enum { TRANSFER_NONE, TRANSFER_BEGIN, TRANSFER_READY, TRANSFER_REL, TRANSFER_MEDIAPASS };
  struct chan_iax2_pvt {
      struct sockaddr_in addr;
      struct sockaddr_in transfer;
      int transferring;
      unsigned short transfercallno;
      unsigned short peercallno;
      unsigned short callno;
  };

  static int match(struct sockaddr_in *sin, unsigned short callno,
                   unsigned short dcallno, const struct chan_iax2_pvt *cur,
                   int full_frame)
  {
      if ((cur->addr.sin_addr.s_addr == sin->sin_addr.s_addr) &&
          (cur->addr.sin_port == sin->sin_port)) {
          /* This is the main host */
          if ( (cur->peercallno == 0 || cur->peercallno == callno) &&
               (full_frame ? dcallno == cur->callno : 1) ) {
              /* That's us.  Be sure we keep track of the peer call number */
              return 1;
          }
      }
      if ((cur->transfer.sin_addr.s_addr == sin->sin_addr.s_addr) &&
          (cur->transfer.sin_port == sin->sin_port) && (cur->transferring)) {
          /* We're transferring */
          if ((dcallno == cur->callno) ||
              (cur->transferring == TRANSFER_MEDIAPASS && cur->transfercallno == callno))
              return 1;
      }
      return 0;
  }
  ```

test "rank134: an if-return guard on the destination number is clean without a ternary"
  lang c
  reject VYQL-AUTH-087
  reject_review code.ProtocolFrameBindingReview
  code
  ```
  struct sockaddr_in {
      struct { unsigned int s_addr; } sin_addr;
      unsigned short sin_port;
  };
  struct chan_iax2_pvt {
      struct sockaddr_in addr;
      unsigned short peercallno;
      unsigned short callno;
  };

  static int match(struct sockaddr_in *sin, unsigned short callno,
                   unsigned short dcallno, const struct chan_iax2_pvt *cur,
                   int full_frame)
  {
      if ((cur->addr.sin_addr.s_addr == sin->sin_addr.s_addr) &&
          (cur->addr.sin_port == sin->sin_port)) {
          /* This is the main host */
          if (full_frame && dcallno != cur->callno) {
              return 0;
          }
          if (cur->peercallno == 0 || cur->peercallno == callno) {
              /* That's us.  Be sure we keep track of the peer call number */
              return 1;
          }
      }
      return 0;
  }
  ```
