test "rank542: appsec request parser allocates client ContentLength before bounded body read"
  lang go
  expect VYQL-DOS-006
  expect_review code.LengthDerivedAllocation
  code
  ```
  package appsec

  import (
    "bytes"
    "fmt"
    "io"
    "net/http"
  )

  func NewParsedRequestFromRequest(r *http.Request) error {
    contentLength := max(r.ContentLength, 0)
    body := make([]byte, contentLength)
    if r.Body != nil {
      _, err := io.ReadFull(r.Body, body)
      if err != nil {
        return fmt.Errorf("unable to read body: %s", err)
      }
      r.Body = io.NopCloser(bytes.NewBuffer(body))
    }
    return nil
  }
  ```

test "rank542: appsec request parser bounds body reads before buffering"
  lang go
  reject VYQL-DOS-006
  reject_review code.LengthDerivedAllocation
  code
  ```
  package appsec

  import (
    "bytes"
    "io"
    "net/http"
  )

  func readRequestBody(r *http.Request, maxSize int64) ([]byte, error) {
    if maxSize <= 0 {
      maxSize = 1048576
    }
    body, err := io.ReadAll(io.LimitReader(r.Body, maxSize+1))
    if int64(len(body)) > maxSize {
      _, _ = io.Copy(io.Discard, r.Body)
      body = nil
    }
    r.Body = io.NopCloser(bytes.NewBuffer(body))
    return body, err
  }
  ```
