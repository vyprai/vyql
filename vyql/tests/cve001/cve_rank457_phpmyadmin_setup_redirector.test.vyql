# Rank 457 / CVE-2011-1941: phpMyAdmin 3.4.0 routed setup-mode
# external links through url.php even though setup could not rely on normal token
# protection for the redirector.

test "rank457: phpMyAdmin setup uses redirector for external URL"
  lang php
  expect VYQL-RF-020
  expect_review code.PhpMyAdminSetupRedirectorOpenRedirect
  code
  ```
  <?php
  function PMA_linkURL($url) {
      $params = array();
      $params['url'] = $url;
      $goto = 'url.php' . PMA_generate_common_url($params);
      if (!preg_match('#^https?://#', $url)) {
          return $url;
      } elseif (defined('PMA_SETUP')) {
          return '../' . $goto;
      } else {
          return './' . $goto;
      }
  }
  ```

test "rank457: phpMyAdmin setup returns external URL without redirector"
  lang php
  reject VYQL-RF-020
  reject_review code.PhpMyAdminSetupRedirectorOpenRedirect
  code
  ```
  <?php
  function PMA_linkURL($url) {
      if (!preg_match('#^https?://#', $url) || defined('PMA_SETUP')) {
          return $url;
      } else {
          $params = array();
          $params['url'] = $url;
          return './url.php' . PMA_generate_common_url($params);
      }
  }
  ```
