# Rank 477 / CVE-2020-15178: PrestaShop contactform inserted the submitted
# message into mail template variables after stripslashes/nl2br but before HTML
# escaping. The v4.3.0 fix wraps the message in Tools::htmlentitiesUTF8 first.

test "rank477: PrestaShop contactform message email variable is unescaped"
  lang php
  file contactform.php
  expect VYQL-INJ-101
  expect_review code.PrestaShopContactformMessageEmailXss
  code
  ```
  <?php
  class Contactform extends Module
  {
      public function sendMessage()
      {
          $message = Tools::getValue('message');
          $from = Tools::getValue('from');

          $var_list = [
              '{message}' => Tools::nl2br(Tools::stripslashes($message)),
              '{email}' => $from,
          ];

          Mail::Send(1, 'contact', 'Message from contact form', $var_list, 'merchant@example.com');
      }
  }
  ```

test "rank477: PrestaShop contactform message email variable is escaped"
  lang php
  file contactform.php
  reject VYQL-INJ-101
  reject_review code.PrestaShopContactformMessageEmailXss
  code
  ```
  <?php
  class Contactform extends Module
  {
      public function sendMessage()
      {
          $message = Tools::getValue('message');
          $from = Tools::getValue('from');

          $var_list = [
              '{message}' => Tools::nl2br(Tools::htmlentitiesUTF8(Tools::stripslashes($message))),
              '{email}' => $from,
          ];

          Mail::Send(1, 'contact', 'Message from contact form', $var_list, 'merchant@example.com');
      }
  }
  ```
