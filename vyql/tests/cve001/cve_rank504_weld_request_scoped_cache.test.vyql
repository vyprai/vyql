# Rank 504 / CVE-2014-8122: Weld began a new request-scoped ThreadLocal
# cache without ending a previous unmatched request lifecycle on the same thread.

test "rank504: ThreadLocal request cache overwritten without cleanup"
  lang java
  expect VYQL-RACE-004
  expect_review code.ThreadLocalScopeOverwriteWithoutCleanup
  code
  ```
  package org.jboss.weld.context.cache;
  import java.util.LinkedList;
  import java.util.List;

  public class RequestScopedCache {
      private static final ThreadLocal<List<RequestScopedItem>> CACHE = new ThreadLocal<List<RequestScopedItem>>();

      public static void beginRequest() {
          CACHE.set(new LinkedList<RequestScopedItem>());
      }

      public static void endRequest() {
          final List<RequestScopedItem> result = CACHE.get();
          CACHE.remove();
          if (result != null) {
              for (final RequestScopedItem item : result) {
                  item.invalidate();
              }
          }
      }
  }
  ```

test "rank504: ThreadLocal request cache begins after cleanup"
  lang java
  reject VYQL-RACE-004
  reject_review code.ThreadLocalScopeOverwriteWithoutCleanup
  code
  ```
  package org.jboss.weld.context.cache;
  import java.util.LinkedList;
  import java.util.List;

  public class RequestScopedCache {
      private static final ThreadLocal<List<RequestScopedItem>> CACHE = new ThreadLocal<List<RequestScopedItem>>();

      public static void beginRequest() {
          endRequest();
          CACHE.set(new LinkedList<RequestScopedItem>());
      }

      public static void endRequest() {
          final List<RequestScopedItem> result = CACHE.get();
          if (result != null) {
              CACHE.remove();
              for (final RequestScopedItem item : result) {
                  item.invalidate();
              }
          }
      }
  }
  ```
