# Rank 650 / CVE-2024-21910: django-tinymce vendored TinyMCE before
# 5.10.0, whose image/link URL handling allowed XSS.

test "rank650: vendored TinyMCE 5.5.0 is vulnerable"
  lang javascript
  file tinymce/static/tinymce/plugins/image/plugin.min.js
  expect VYQL-SCA-001
  code
  ```
  /**
   * Copyright (c) Tiny Technologies, Inc. All rights reserved.
   *
   * Version: 5.5.0 (2020-09-29)
   */
  !function(){ window.tinymce = window.tinymce || {}; }();
  ```

test "rank650: vendored TinyMCE 5.10.1 is clean"
  lang javascript
  file tinymce/static/tinymce/plugins/image/plugin.min.js
  reject VYQL-SCA-001
  code
  ```
  /**
   * Copyright (c) Tiny Technologies, Inc. All rights reserved.
   *
   * Version: 5.10.1 (2021-11-03)
   */
  !function(){ window.tinymce = window.tinymce || {}; }();
  ```
