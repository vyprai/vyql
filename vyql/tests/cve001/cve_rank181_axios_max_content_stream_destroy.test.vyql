test "rank181: Axios maxContentLength rejection does not stop the response stream"
  lang javascript
  expect VYQL-DOS-004
  file http.js
  code
  ```
  module.exports = function httpAdapter(config) {
    var req = transport.request(options, function handleResponse(res) {
      var stream = res;
      var responseBuffer = [];
      stream.on('data', function handleStreamData(chunk) {
        responseBuffer.push(chunk);

        if (config.maxContentLength > -1 && Buffer.concat(responseBuffer).length > config.maxContentLength) {
          reject(createError('maxContentLength size of ' + config.maxContentLength + ' exceeded',
            config, null, req));
        }
      });
    });
  };
  ```

test "rank181: Axios maxContentLength rejection destroys the response stream"
  lang javascript
  reject VYQL-DOS-004
  file http.js
  code
  ```
  module.exports = function httpAdapter(config) {
    var req = transport.request(options, function handleResponse(res) {
      var stream = res;
      var responseBuffer = [];
      stream.on('data', function handleStreamData(chunk) {
        responseBuffer.push(chunk);

        if (config.maxContentLength > -1 && Buffer.concat(responseBuffer).length > config.maxContentLength) {
          stream.destroy();
          reject(createError('maxContentLength size of ' + config.maxContentLength + ' exceeded',
            config, null, req));
        }
      });
    });
  };
  ```
