test "rank327: Cargo crate extraction can overwrite .cargo-ok through symlink"
  lang rust
  expect VYQL-PATH-012
  expect_review code.ArchiveMarkerSymlinkOverwrite
  code
  ```
  use std::fs::{File, OpenOptions};
  use std::io::Write;
  use std::path::{Path, PathBuf};

  const PACKAGE_SOURCE_LOCK: &str = ".cargo-ok";

  fn unpack_package(tarball: &File, parent: &Path, dst: PathBuf, prefix: &Path) -> anyhow::Result<()> {
      let path = dst.join(PACKAGE_SOURCE_LOCK);
      let mut tar = tar::Archive::new(tarball);

      for entry in tar.entries()? {
          let mut entry = entry?;
          let entry_path = entry.path()?.into_owned();
          if !entry_path.starts_with(prefix) {
              anyhow::bail!("invalid archive prefix");
          }
          let mut result = entry.unpack_in(parent).map_err(anyhow::Error::from);
          if result.is_err() {
              result = entry.unpack_in(parent).map_err(anyhow::Error::from);
          }
          result?;
      }

      let mut ok = OpenOptions::new()
          .create(true)
          .read(true)
          .write(true)
          .open(&path)?;
      write!(ok, "ok")?;
      Ok(())
  }
  ```

test "rank327: Cargo filters .cargo-ok entries and creates marker atomically"
  lang rust
  reject VYQL-PATH-012
  reject_review code.ArchiveMarkerSymlinkOverwrite
  code
  ```
  use std::fs::{File, OpenOptions};
  use std::io::Write;
  use std::path::{Path, PathBuf};

  const PACKAGE_SOURCE_LOCK: &str = ".cargo-ok";

  fn unpack_package(tarball: &File, parent: &Path, dst: PathBuf, prefix: &Path) -> anyhow::Result<()> {
      let path = dst.join(PACKAGE_SOURCE_LOCK);
      let mut tar = tar::Archive::new(tarball);

      for entry in tar.entries()? {
          let mut entry = entry?;
          let entry_path = entry.path()?.into_owned();
          if !entry_path.starts_with(prefix) {
              anyhow::bail!("invalid archive prefix");
          }
          if entry_path
              .file_name()
              .map_or(false, |p| p == PACKAGE_SOURCE_LOCK)
          {
              continue;
          }
          let mut result = entry.unpack_in(parent).map_err(anyhow::Error::from);
          if result.is_err() {
              result = entry.unpack_in(parent).map_err(anyhow::Error::from);
          }
          result?;
      }

      let mut ok = OpenOptions::new()
          .create_new(true)
          .read(true)
          .write(true)
          .open(&path)?;
      write!(ok, "ok")?;
      Ok(())
  }
  ```
