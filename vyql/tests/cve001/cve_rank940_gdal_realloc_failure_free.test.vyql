# Rank 940 / CVE-2019-17545: GDAL OGRExpatRealloc freed the original
# pointer when its allocation guard rejected an oversized realloc request.

test "rank940: realloc failure path frees original pointer"
  lang cpp
  file ogr_expat.cpp
  expect VYQL-MEM-049
  expect_review code.ReallocFailurePathInputFree
  code
  ```
  static bool CanAlloc(unsigned long size);

  static void* OGRExpatRealloc(void *ptr, unsigned long size)
  {
      if (CanAlloc(size))
          return realloc(ptr, size);

      free(ptr);
      return nullptr;
  }
  ```

test "rank940: realloc failure path preserves original pointer ownership"
  lang cpp
  file ogr_expat.cpp
  reject VYQL-MEM-049
  reject_review code.ReallocFailurePathInputFree
  code
  ```
  static bool CanAlloc(unsigned long size);

  static void* OGRExpatRealloc(void *ptr, unsigned long size)
  {
      if (CanAlloc(size))
          return realloc(ptr, size);

      return nullptr;
  }
  ```
