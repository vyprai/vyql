# Rank 962 / CVE-2018-1000186: GHPRB Jenkins descriptor endpoints
# created/tested GitHub credentials without POST or administrator checks.

test "rank962: Jenkins credential endpoint creates token without POST/admin guard"
  lang java
  profile api
  file GhprbGitHubAuth.java
  expect VYQL-AUTH-073
  expect_review code.JenkinsCredentialEndpointMissingPostPermission
  code
  ```
  import hudson.model.Descriptor;
  import hudson.util.FormValidation;
  import org.kohsuke.github.GHAuthorization;
  import org.kohsuke.github.GitHub;
  import org.kohsuke.github.GitHubBuilder;
  import org.kohsuke.stapler.QueryParameter;
  import java.util.Arrays;

  public class GhprbGitHubAuth {
    public static final class DescriptorImpl extends Descriptor<GhprbGitHubAuth> {
      public FormValidation doCreateApiToken(
          @QueryParameter("serverAPIUrl") String serverAPIUrl,
          @QueryParameter("username") String username,
          @QueryParameter("password") String password) throws Exception {
        GitHub gh = new GitHubBuilder().withEndpoint(serverAPIUrl).build();
        GHAuthorization token = gh.createToken(Arrays.asList(GHAuthorization.REPO), "Jenkins", null);
        return FormValidation.ok("Access token created: " + token.getToken());
      }
    }
  }
  ```

test "rank962: Jenkins credential endpoint requires POST and admin permission"
  lang java
  profile api
  file GhprbGitHubAuth.java
  reject VYQL-AUTH-073
  reject_review code.JenkinsCredentialEndpointMissingPostPermission
  code
  ```
  import hudson.model.Descriptor;
  import hudson.util.FormValidation;
  import jenkins.model.Jenkins;
  import org.kohsuke.github.GHAuthorization;
  import org.kohsuke.github.GitHub;
  import org.kohsuke.github.GitHubBuilder;
  import org.kohsuke.stapler.QueryParameter;
  import org.kohsuke.stapler.verb.POST;
  import java.util.Arrays;

  public class GhprbGitHubAuth {
    public static final class DescriptorImpl extends Descriptor<GhprbGitHubAuth> {
      @POST
      public FormValidation doCreateApiToken(
          @QueryParameter("serverAPIUrl") String serverAPIUrl,
          @QueryParameter("username") String username,
          @QueryParameter("password") String password) throws Exception {
        Jenkins.getInstance().checkPermission(Jenkins.ADMINISTER);
        GitHub gh = new GitHubBuilder().withEndpoint(serverAPIUrl).build();
        GHAuthorization token = gh.createToken(Arrays.asList(GHAuthorization.REPO), "Jenkins", null);
        return FormValidation.ok("Access token created: " + token.getToken());
      }
    }
  }
  ```
