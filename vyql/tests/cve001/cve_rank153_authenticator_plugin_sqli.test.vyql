# Rank 153 / CVE-2013-10013: Bricco authenticator-plugin DBAuthenticator
# passed login credentials as the generated-columns argument to prepareStatement
# and then executed the SQL text directly, leaving the authentication SQL unsafe.

test "rank153: java authenticator prepareStatement variables misuse is SQLi"
  lang java
  expect VYQL-INJ-030
  code
  ```
  import java.sql.PreparedStatement;
  import java.sql.ResultSet;
  import java.sql.SQLException;
  import java.sql.Statement;
  import java.util.List;
  import neo.dbaccess.Transaction;

  class DBAuthenticator {
    String table;

    AuthenticatedUser authenticate(String username, String password, String ipaddress) throws Exception {
      List result = null;
      String sql = "SELECT * FROM " + table + " WHERE username = ? AND password = '?'";
      String[] preparedVariables = new String[] { username, password };
      new Query(sql, preparedVariables, result).execute(null);
      return null;
    }

    private static class Query {
      private String query;
      private String[] variables;
      private List list;

      Query(String query, String[] variables, List list) {
        this.query = query;
        this.variables = variables;
        this.list = list;
      }

      public void execute(Transaction t) throws SQLException {
        Statement st = t.getConnection().prepareStatement(query, variables);
        try {
          ResultSet rs = st.executeQuery(query);
        } finally {
          st.close();
        }
      }
    }
  }
  class AuthenticatedUser {}
  ```

test "rank153: java authenticator bound PreparedStatement is clean"
  lang java
  reject VYQL-INJ-030
  code
  ```
  import java.sql.PreparedStatement;
  import java.sql.ResultSet;
  import java.sql.SQLException;
  import java.util.List;
  import neo.dbaccess.Transaction;

  class DBAuthenticator {
    String table;

    AuthenticatedUser authenticate(String username, String password, String ipaddress) throws Exception {
      List result = null;
      String sql = "SELECT * FROM " + table + " WHERE username = ? AND password = ?";
      new Query(sql, new String[] { username, password }, result).execute(null);
      return null;
    }

    private static class Query {
      private String query;
      private String[] args;
      private List list;

      Query(String query, String[] args, List list) {
        this.query = query;
        this.args = args;
        this.list = list;
      }

      public void execute(Transaction t) throws SQLException {
        PreparedStatement prepStmt = t.getConnection().prepareStatement(query);
        prepStmt.setString(1, args[0]);
        prepStmt.setString(2, args[1]);
        try {
          ResultSet rs = prepStmt.executeQuery();
        } finally {
          prepStmt.close();
        }
      }
    }
  }
  class AuthenticatedUser {}
  ```
