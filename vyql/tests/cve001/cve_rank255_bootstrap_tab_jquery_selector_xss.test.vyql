test "rank255: bootstrap tab jQuery root selector can parse attacker-controlled HTML"
  lang javascript
  expect VYQL-INJ-004
  code
  ```
  +function ($) {
    function Tab(element) {
      this.element = $(element)
    }

    Tab.prototype.show = function () {
      var $this = this.element
      var selector = $this.data('target')

      if (!selector) {
        selector = $this.attr('href')
        selector = selector && selector.replace(/.*(?=#[^\s]*$)/, '')
      }

      var $target = $(selector)
      $target.addClass('active')
    }
  }(jQuery);
  ```

test "rank255: bootstrap tab document find selector does not parse HTML"
  lang javascript
  reject VYQL-INJ-004
  code
  ```
  +function ($) {
    function Tab(element) {
      this.element = $(element)
    }

    Tab.prototype.show = function () {
      var $this = this.element
      var selector = $this.data('target')

      if (!selector) {
        selector = $this.attr('href')
        selector = selector && selector.replace(/.*(?=#[^\s]*$)/, '')
      }

      var $target = $(document).find(selector)
      $target.addClass('active')
    }
  }(jQuery);
  ```
