test "rank703: comment update by id lacks current author constraint"
  lang php
  expect VYQL-AUTH-046
  expect_review code.CommentUpdateMissingOwnershipConstraint
  code
  ```
  <?php
  class comment
  {
      function updateComment($id, $comment)
      {
          $tp = e107::getParser();
          $comment = $tp->toText($comment);
          $comment = trim($comment);

          if(!e107::getDb()->update("comments","comment_comment=\"".$tp->toDB($comment)."\" WHERE comment_id = ".intval($id).""))
          {
              return "Update Failed";
          }
      }
  }
  ?>
  ```

test "rank703: comment update by id constrains to current author"
  lang php
  reject VYQL-AUTH-046
  reject_review code.CommentUpdateMissingOwnershipConstraint
  code
  ```
  <?php
  class comment
  {
      function updateComment($id, $comment)
      {
          $tp = e107::getParser();
          $comment = $tp->toText($comment);
          $comment = trim($comment);

          if(!e107::getDb()->update("comments","comment_comment=\"".$tp->toDB($comment)."\" WHERE comment_id = ".(int) $id.' AND comment_author_id = '.(int) USERID))
          {
              return "Update Failed";
          }
      }
  }
  ?>
  ```
