test "rank599: package-manager probe command string uses shell true"
  lang python
  expect VYQL-INJ-129
  expect_review code.ShellTruePackageManagerProbe
  code
  ```
  import distutils.spawn
  import subprocess

  def check_for_libaio_pkg():
      libs = dict(
          dpkg=["-l", "libaio-dev", "apt"],
          pacman=["-Q", "libaio", "pacman"],
          rpm=["-q", "libaio-devel", "yum"],
      )
      for pkgmgr, data in libs.items():
          flag, lib, tool = data
          path = distutils.spawn.find_executable(pkgmgr)
          if path is not None:
              cmd = f"{pkgmgr} {flag} {lib}"
              result = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, shell=True)
              return result.wait() == 0
      return False
  ```

test "rank599: package-manager probe uses argv array"
  lang python
  reject VYQL-INJ-129
  reject_review code.ShellTruePackageManagerProbe
  code
  ```
  import distutils.spawn
  import subprocess

  def check_for_libaio_pkg():
      libs = dict(
          dpkg=["-l", "libaio-dev", "apt"],
          pacman=["-Q", "libaio", "pacman"],
          rpm=["-q", "libaio-devel", "yum"],
      )
      for pkgmgr, data in libs.items():
          flag, lib, tool = data
          path = distutils.spawn.find_executable(pkgmgr)
          if path is not None:
              cmd = [pkgmgr, flag, lib]
              result = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
              return result.wait() == 0
      return False
  ```
