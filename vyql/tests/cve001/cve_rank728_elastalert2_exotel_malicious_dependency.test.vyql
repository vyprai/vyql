test "rank728: elastalert2 open exotel range can resolve malicious release"
  lang python
  expect VYQL-SCA-001
  expect VYQL-SCA-004
  file requirements.txt
  code
  ```
  exotel>=0.1.5
  ```
  file setup.py
  code
  ```
  from setuptools import setup

  setup(
      install_requires=[
          'exotel>=0.1.5',
      ],
  )
  ```

test "rank728: elastalert2 pinned exotel release avoids malicious version"
  lang python
  reject VYQL-SCA-001
  reject VYQL-SCA-004
  file requirements.txt
  code
  ```
  exotel==0.1.5
  ```
  file setup.py
  code
  ```
  from setuptools import setup

  setup(
      install_requires=[
          'exotel==0.1.5',
      ],
  )
  ```
