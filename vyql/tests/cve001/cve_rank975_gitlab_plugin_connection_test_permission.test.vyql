test "rank975: Jenkins GitLab connection test lacks administrator permission"
  lang java
  file src/main/java/com/dabsquared/gitlabjenkins/connection/GitLabConnectionConfig.java
  expect VYQL-AUTH-045
  expect_review code.JenkinsRemoteValidationMissingPermission
  code
  ```
  import hudson.util.FormValidation;
  import org.kohsuke.stapler.QueryParameter;

  class GitLabConnectionConfig {
      public FormValidation doTestConnection(@QueryParameter String url,
                                             @QueryParameter String apiTokenId,
                                             @QueryParameter String clientBuilderId,
                                             @QueryParameter boolean ignoreCertificateErrors) {
          new GitLabConnection("", url, apiTokenId, clientBuilderId, ignoreCertificateErrors)
              .getClient()
              .getCurrentUser();
          return FormValidation.ok("OK");
      }
  }
  class GitLabConnection {
      GitLabConnection(String name, String url, String apiTokenId, String clientBuilderId, boolean ignoreCertificateErrors) {}
      GitLabClient getClient() { return null; }
  }
  class GitLabClient {
      Object getCurrentUser() { return null; }
  }
  ```

test "rank975: Jenkins GitLab connection test checks administrator permission"
  lang java
  file src/main/java/com/dabsquared/gitlabjenkins/connection/GitLabConnectionConfig.java
  reject VYQL-AUTH-045
  reject_review code.JenkinsRemoteValidationMissingPermission
  code
  ```
  import hudson.util.FormValidation;
  import jenkins.model.Jenkins;
  import org.kohsuke.stapler.QueryParameter;
  import org.kohsuke.stapler.interceptor.RequirePOST;

  class GitLabConnectionConfig {
      @RequirePOST
      public FormValidation doTestConnection(@QueryParameter String url,
                                             @QueryParameter String apiTokenId,
                                             @QueryParameter String clientBuilderId,
                                             @QueryParameter boolean ignoreCertificateErrors) {
          Jenkins.getActiveInstance().checkPermission(Jenkins.ADMINISTER);
          new GitLabConnection("", url, apiTokenId, clientBuilderId, ignoreCertificateErrors)
              .getClient()
              .getCurrentUser();
          return FormValidation.ok("OK");
      }
  }
  class GitLabConnection {
      GitLabConnection(String name, String url, String apiTokenId, String clientBuilderId, boolean ignoreCertificateErrors) {}
      GitLabClient getClient() { return null; }
  }
  class GitLabClient {
      Object getCurrentUser() { return null; }
  }
  ```
