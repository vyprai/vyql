# Rank 160 / CVE-2024-49376: Autolab's UsersController declared per-action
# authorization levels through `action_auth_level` but switched the
# enforcing before_action off for the whole controller with an unscoped
# `skip_before_action :authenticate_for_action`, so the password-update
# actions were reachable by any signed-in user regardless of the level they
# declared. The fix restores the filter for those actions with an `except:`
# scope and registers the level `update_password_for_user` declares.

test "rank160: autolab skips the enforcement filter while declaring action levels"
  lang ruby
  file users_controller.rb
  expect VYQL-AUTH-080
  expect_review code.AccessPolicyReview
  code
  ```
  class UsersController < ApplicationController
    skip_before_action :set_course
    skip_before_action :authorize_user_for_course
    skip_before_action :authenticate_for_action
    skip_before_action :update_persistent_announcements

    action_auth_level :destroy, :administrator
    def destroy
      @user = User.find(params[:id])
      @user.destroy
      redirect_to(users_path)
    end

    def update_password_for_user
      @user = User.find_by(id: params[:id])
      return if params[:user].nil? || params[:user].is_a?(String) || @user.nil?

      if params[:user][:password] != params[:user][:password_confirmation]
        flash[:error] = "Passwords do not match"
      elsif @user.update(password: params[:user][:password])
        flash[:success] = "Password changed successfully"
        redirect_to(root_path)
      else
        flash[:error] = "Password #{@user.errors[:password][0]}"
      end
    end
  end
  ```

test "rank160: autolab scopes the skip and registers the password action level"
  lang ruby
  file users_controller.rb
  reject VYQL-AUTH-080
  reject_review code.AccessPolicyReview
  code
  ```
  class UsersController < ApplicationController
    skip_before_action :set_course
    skip_before_action :authorize_user_for_course
    skip_before_action :authenticate_for_action,
                       except: [:change_password_for_user, :update_password_for_user,
                                :lti_launch_link_course]
    skip_before_action :update_persistent_announcements

    action_auth_level :destroy, :administrator
    def destroy
      @user = User.find(params[:id])
      @user.destroy
      redirect_to(users_path)
    end

    action_auth_level :update_password_for_user, :administrator
    def update_password_for_user
      @user = User.find_by(id: params[:id])
      return if params[:user].nil? || params[:user].is_a?(String) || @user.nil?

      if params[:user][:password] != params[:user][:password_confirmation]
        flash[:error] = "Passwords do not match"
      elsif @user.update(password: params[:user][:password])
        flash[:success] = "Password changed successfully"
        redirect_to(root_path)
      else
        flash[:error] = "Password #{@user.errors[:password][0]}"
      end
    end
  end
  ```
