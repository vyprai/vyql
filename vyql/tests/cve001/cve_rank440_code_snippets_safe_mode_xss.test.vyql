# Rank 440 / CVE-2021-25008: Code Snippets reflected XSS through
# snippets-safe-mode query propagation.

test "rank440: Code Snippets safe-mode request value is copied into query args"
  lang php
  file class-code-snippets.php
  expect VYQL-INJ-086
  expect_review code.CodeSnippetsSafeModeQueryXss
  code
  ```
  <?php

  class Code_Snippets
  {
    public function add_safe_mode_query_var( $url ) {
      if ( isset( $_REQUEST['snippets-safe-mode'] ) ) {
        return add_query_arg( 'snippets-safe-mode', $_REQUEST['snippets-safe-mode'], $url );
      }

      return $url;
    }
  }
  ```

test "rank440: Code Snippets safe-mode query value is coerced before propagation"
  lang php
  file class-code-snippets.php
  reject VYQL-INJ-086
  reject_review code.CodeSnippetsSafeModeQueryXss
  code
  ```
  <?php

  class Code_Snippets
  {
    public function add_safe_mode_query_var( $url ) {
      if ( isset( $_REQUEST['snippets-safe-mode'] ) ) {
        return add_query_arg( 'snippets-safe-mode', (bool) $_REQUEST['snippets-safe-mode'], $url );
      }

      return $url;
    }
  }
  ```
