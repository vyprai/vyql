# Rank 999 / CVE-2025-14831: GnuTLS intersected name-constraint lists with
# pairwise nested work before switching to sorted single-pass processing.

test "rank999: pairwise name constraint intersection is flagged"
  lang c
  file name_constraints.c
  expect VYQL-DOS-039
  expect_review code.PairwiseConstraintIntersectionDos
  code
  ```
  static int name_constraints_node_list_intersect(
      struct name_constraints_node_list_st *permitted,
      const struct name_constraints_node_list_st *permitted2)
  {
      struct name_constraints_node_st *tmp;
      struct name_constraints_node_list_st removed = { 0 };
      int ret;

      for (size_t i = 0; i < permitted->size; i++) {
          for (size_t j = 0; j < permitted2->size; j++) {
              if (permitted->data[i]->type == permitted2->data[j]->type)
                  name_constraints_node_list_add(&removed, permitted->data[i]);
          }
      }

      for (size_t i = 0; i < permitted2->size; i++) {
          const struct name_constraints_node_st *t2 = permitted2->data[i];
          for (size_t j = 0; j < removed.size; j++) {
              ret = name_constraints_intersect_nodes(removed.data[j], t2, &tmp);
              if (ret < 0)
                  return ret;
              if (tmp != NULL)
                  name_constraints_node_list_add(permitted, tmp);
          }
      }

      return 0;
  }
  ```

test "rank999: sorted name constraint merge is clean"
  lang c
  file name_constraints.c
  reject VYQL-DOS-039
  reject_review code.PairwiseConstraintIntersectionDos
  code
  ```
  static int name_constraints_node_list_intersect(
      struct name_constraints_node_list_st *permitted,
      struct name_constraints_node_list_st *permitted2)
  {
      struct name_constraints_node_st *nc1, *nc2;
      struct name_constraints_node_list_st result = { 0 };
      size_t i = 0, j = 0;
      int ret;

      ret = ensure_sorted(permitted);
      if (ret < 0)
          return ret;
      ret = ensure_sorted(permitted2);
      if (ret < 0)
          return ret;

      while (i < permitted->size || j < permitted2->size) {
          nc1 = (i < permitted->size) ? permitted->sorted_view[i] : NULL;
          nc2 = (j < permitted2->size) ? permitted2->sorted_view[j] : NULL;

          switch (compare_name_constraint_nodes(nc1, nc2)) {
          case NC_INCLUDED_BY:
              ret = name_constraints_node_list_add(&result, nc1);
              i++;
              break;
          default:
              j++;
              break;
          }
      }

      return ret;
  }
  ```
