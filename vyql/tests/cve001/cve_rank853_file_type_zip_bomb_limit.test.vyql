# Rank 853 / CVE-2026-32630: file-type allowed known-size ZIP entry
# decompression to expand up to Number.MAX_SAFE_INTEGER during type probing.

test "rank853: JavaScript deflate ZIP probing uses max safe integer output limit"
  lang javascript
  file core.js
  expect VYQL-DOS-032
  expect_review code.DeflateDecompressionMaxSafeIntegerLimit
  code
  ```
  const maximumZipEntrySizeInBytes = 1024 * 1024;

  async function decompressDeflateRawWithLimit(fileData, options) {
    return fileData;
  }

  function hasUnknownFileSize(tokenizer) {
    return !Number.isFinite(tokenizer.fileInfo.size);
  }

  ZipHandler.prototype.inflate = async function (zipHeader, fileData, callback) {
    if (zipHeader.compressedMethod === 0) {
      return callback(fileData);
    }

    if (zipHeader.compressedMethod !== 8) {
      throw new Error(`Unsupported ZIP compression method: ${zipHeader.compressedMethod}`);
    }

    const maximumLength = hasUnknownFileSize(this.tokenizer) ? maximumZipEntrySizeInBytes : Number.MAX_SAFE_INTEGER;
    const uncompressedData = await decompressDeflateRawWithLimit(fileData, {maximumLength});
    return callback(uncompressedData);
  };
  ```

test "rank853: JavaScript deflate ZIP probing uses fixed archive-entry output limit"
  lang javascript
  file core.js
  reject VYQL-DOS-032
  reject_review code.DeflateDecompressionMaxSafeIntegerLimit
  code
  ```
  const maximumZipEntrySizeInBytes = 1024 * 1024;

  async function decompressDeflateRawWithLimit(fileData, options) {
    return fileData;
  }

  ZipHandler.prototype.inflate = async function (zipHeader, fileData, callback) {
    if (zipHeader.compressedMethod === 0) {
      return callback(fileData);
    }

    if (zipHeader.compressedMethod !== 8) {
      throw new Error(`Unsupported ZIP compression method: ${zipHeader.compressedMethod}`);
    }

    const uncompressedData = await decompressDeflateRawWithLimit(fileData, {maximumLength: maximumZipEntrySizeInBytes});
    return callback(uncompressedData);
  };
  ```
