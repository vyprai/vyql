# Rank 29 / CVE-2018-1002204: adm-zip joined archive entry names into
# extraction targets before checking that the resolved path stayed under the
# requested output directory.

test "rank29: adm-zip writes archive entry names without containment check"
  lang javascript
  file adm-zip.js
  expect VYQL-PATH-004
  code
  ```
  var pth = require("path");
  var AdmZip = require("adm-zip");

  function restore(req) {
    var archivePath = pth.resolve("/tmp/uploads", req.query.archive);
    var targetPath = pth.resolve("/srv/extract", req.query.name);
    var zip = new AdmZip(archivePath);
    zip.extractAllTo(targetPath, true);
  }
  ```

test "rank29: adm-zip rejects archive entry paths outside target directory"
  lang javascript
  file adm-zip.js
  reject VYQL-PATH-004
  code
  ```
  const path = require("path");
  const AdmZip = require("adm-zip");
  const { isWithin } = require("./files");

  function importPlugin(req) {
    const archivePath = path.resolve("/tmp/plugins", req.query.name + ".zip");
    const pluginFolder = path.resolve("/tmp/plugins", req.query.name);
    const zip = new AdmZip(archivePath);

    for (const entry of zip.getEntries()) {
      const entryPath = path.resolve(pluginFolder, entry.entryName);
      if (!isWithin(pluginFolder, entryPath) && pluginFolder !== entryPath) {
        throw new Error("bad zip entry");
      }
    }

    zip.extractAllTo(pluginFolder, true);
  }
  ```
