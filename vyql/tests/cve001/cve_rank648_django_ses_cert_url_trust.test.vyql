# Rank 648 / CVE-2023-33185: django-ses accepted broad amazonaws certificate
# URL suffixes for SNS/SES signature verification.
test "rank648: SNS signing certificate URL trusts broad domain suffix"
  lang python
  file utils.py
  expect VYQL-RF-025
  code
  ```
  from urllib.parse import urlparse
  from django_ses import settings

  class EventMessageVerifier:
      def __init__(self, notification):
          self._data = notification

      def _get_cert_url(self):
          cert_url = self._data.get("SigningCertURL")
          if not cert_url:
              return None
          if not cert_url.startswith("https://"):
              return None
          url_obj = urlparse(cert_url)
          for trusted_domain in settings.EVENT_CERT_DOMAINS:
              parts = trusted_domain.split(".")
              if url_obj.netloc.split(".")[-len(parts) :] == parts:
                  return cert_url
          return None
  ```

test "rank648: SNS signing certificate URL requires SimpleNotificationService pem"
  lang python
  file utils.py
  reject VYQL-RF-025
  code
  ```
  import re
  from urllib.parse import urlparse
  from django_ses import settings

  SES_REGEX_CERT_URL = re.compile(
      "(?i)^https://sns\\.[a-z0-9\\-]+\\.amazonaws\\.com(\\.cn)?/SimpleNotificationService\\-[a-z0-9]+\\.pem$"
  )

  class EventMessageVerifier:
      def __init__(self, notification):
          self._data = notification

      def _get_cert_url(self):
          cert_url = self._data.get("SigningCertURL")
          if not cert_url:
              return None
          if not cert_url.startswith("https://"):
              return None
          url_obj = urlparse(cert_url)
          for trusted_domain in settings.EVENT_CERT_DOMAINS:
              parts = trusted_domain.split(".")
              if "amazonaws.com" in trusted_domain:
                  if not SES_REGEX_CERT_URL.match(cert_url):
                      return None
              if url_obj.netloc.split(".")[-len(parts) :] == parts:
                  return cert_url
          return None
  ```
