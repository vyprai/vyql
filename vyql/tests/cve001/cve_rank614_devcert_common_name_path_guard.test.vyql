test "rank614: devcert common name reaches generated certificate paths without path guard"
  lang javascript
  profile library
  expect VYQL-PATH-001
  code
  ```
  const fs = require('fs');

  export default function generateDevCert(commonName) {
    if (!commonName.match(/^(.|\.){1,64}$/)) {
      throw new Error("invalid common name");
    }
    const certPath = makeCertificate(commonName);
    return fs.readFileSync(certPath).toString();
  }
  ```

test "rank614: anchored alnum common name regex guards generated certificate paths"
  lang javascript
  profile library
  reject VYQL-PATH-001
  code
  ```
  const fs = require('fs');

  export default function generateDevCert(commonName) {
    if (!commonName.match(/^(a-zA-Z0-9|\.){1,64}$/)) {
      throw new Error("invalid common name");
    }
    const certPath = makeCertificate(commonName);
    return fs.readFileSync(certPath).toString();
  }
  ```
