# Rank 957 / CVE-2025-31479: Typer pretty exceptions could print
# GH_TOKEN from local variables into GitHub Actions logs.

test "rank957: Typer app shows locals while GH token is read"
  lang python
  profile api
  file main.py
  expect VYQL-SEC-033
  expect_review code.TyperPrettyExceptionLocalsSecretExposure
  code
  ```
  import os
  import requests
  import typer

  app = typer.Typer()

  @app.command()
  def main(github_api_url: str = "https://api.github.com"):
      headers = {}
      token = os.environ.get("GH_TOKEN")
      if token:
          headers["Authorization"] = f"Bearer {token}"
      response = requests.get(f"{github_api_url}/repos/example/project", headers=headers)
      response.raise_for_status()
  ```

test "rank957: Typer app hides locals while GH token is read"
  lang python
  profile api
  file main.py
  reject VYQL-SEC-033
  reject_review code.TyperPrettyExceptionLocalsSecretExposure
  code
  ```
  import os
  import requests
  import typer

  app = typer.Typer(pretty_exceptions_show_locals=False)

  @app.command()
  def main(github_api_url: str = "https://api.github.com"):
      headers = {}
      token = os.environ.get("GH_TOKEN")
      if token:
          headers["Authorization"] = f"Bearer {token}"
      response = requests.get(f"{github_api_url}/repos/example/project", headers=headers)
      response.raise_for_status()
  ```
