# Rank 93 / CVE-2025-62232: APISIX basic-auth credential logging.
# Ledger verification: VYQL-SEC-001 catches secret value reaching log output.

test "rank93: APISIX logs basic-auth credential material"
  lang java
  expect VYQL-SEC-001
  code
  ```
  class BasicAuthLogger {
      private void logInfo(String message) {
          System.out.println(message);
      }

      private void authenticate(KeyPair key) {
          logInfo("credential=" + key.getKeyMaterial().substring(0, 160));
      }
  }

  interface KeyPair {
      String getKeyMaterial();
  }
  ```

test "rank93: APISIX logs credential metadata only"
  lang java
  reject VYQL-SEC-001
  code
  ```
  class BasicAuthLogger {
      private void logInfo(String message) {
          System.out.println(message);
      }

      private void authenticate(KeyPair key) {
          logInfo("credential fingerprint=" + key.getKeyFingerprint());
      }
  }

  interface KeyPair {
      String getKeyFingerprint();
      String getKeyMaterial();
  }
  ```
