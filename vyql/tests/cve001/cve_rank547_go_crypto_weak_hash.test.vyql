# Rank 547 / CVE-2020-9283: Go crypto SSH signature verification coverage.
# Ledger verification: VYQL-CRY-001 catches the crypto weakness family in ssh/keys.go.

test "rank547: Go crypto weak hash helper is reported"
  lang go
  expect VYQL-CRY-001
  code
  ```
  package main

  import "crypto/md5"

  func verify(data []byte) {
      _ = md5.New()
  }
  ```

test "rank547: Go crypto stronger hash helper is clean"
  lang go
  reject VYQL-CRY-001
  code
  ```
  package main

  import "crypto/sha256"

  func verify(data []byte) {
      _ = sha256.New()
  }
  ```
