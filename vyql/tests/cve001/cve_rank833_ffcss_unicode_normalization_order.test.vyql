test "rank833: Go delimiter filter before Unicode compatibility normalization"
  lang go
  expect VYQL-VAL-009
  expect_review code.UnicodeNormalizationAfterFilterBypass
  code
  ```
  package ffcss

  import (
    "regexp"
    "strings"

    "golang.org/x/text/unicode/norm"
  )

  func lookupPreprocess(s string) string {
    return strings.ToLower(norm.NFKD.String(regexp.MustCompile(`[-_ .]`).ReplaceAllString(s, "")))
  }
  ```

