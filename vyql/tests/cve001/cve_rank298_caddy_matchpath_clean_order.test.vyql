test "rank298: Caddy MatchPath trims trailing dots before path cleaning"
lang go
expect VYQL-RF-011
expect_review code.PathMatcherNormalizationOrderBypass
code
```
package caddyhttp

import (
	"net/http"
	"net/url"
	"path"
	"strings"
)

type MatchPath []string

func (m MatchPath) Match(r *http.Request) bool {
	unescapedPath, err := url.PathUnescape(r.URL.Path)
	if err != nil {
		return false
	}

	lowerPath := strings.ToLower(unescapedPath)
	lowerPath = strings.TrimRight(lowerPath, ". ")
	lowerPath = path.Clean(lowerPath)

	if lowerPath != "/" && strings.HasSuffix(r.URL.Path, "/") {
		lowerPath = lowerPath + "/"
	}
	return lowerPath != ""
}
```

test "rank298: Caddy MatchPath cleans path before trimming trailing dots"
lang go
reject VYQL-RF-011
code
```
package caddyhttp

import (
	"net/http"
	"net/url"
	"path"
	"strings"
)

type MatchPath []string

func (m MatchPath) Match(r *http.Request) bool {
	unescapedPath, err := url.PathUnescape(r.URL.Path)
	if err != nil {
		return false
	}

	lowerPath := strings.ToLower(unescapedPath)
	lowerPath = path.Clean(lowerPath)
	lowerPath = strings.TrimRight(lowerPath, ". ")

	if lowerPath != "/" && strings.HasSuffix(r.URL.Path, "/") {
		lowerPath = lowerPath + "/"
	}
	return lowerPath != ""
}
```
