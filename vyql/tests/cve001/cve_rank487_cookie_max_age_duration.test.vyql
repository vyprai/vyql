# Rank 487 / CVE-2017-18589: cookie-rs parsed a Max-Age integer and passed it
# directly to Duration::seconds, which could panic for very large values.

test "rank487: cookie Max-Age passes parsed seconds directly to Duration"
  lang rust
  file parse.rs
  expect VYQL-DOS-019
  expect_review code.CookieMaxAgeDurationSecondsPanic
  code
  ```
  fn parse_inner<'c>(s: &str, decode: bool) -> Result<Cookie<'c>, ParseError> {
      let mut cookie = Cookie::new("foo", "bar");
      for attr in attributes {
          let (key, value) = match attr.find('=') {
              Some(i) => (attr[..i].trim(), Some(attr[(i + 1)..].trim())),
              None => (attr.trim(), None),
          };

          match (&*key.to_ascii_lowercase(), value) {
              ("max-age", Some(v)) => {
                  cookie.max_age = match v.parse() {
                      Ok(val) if val <= 0 => Some(Duration::zero()),
                      Ok(val) => Some(Duration::seconds(val)),
                      Err(_) => continue,
                  };
              }
              _ => {}
          }
      }
      Ok(cookie)
  }
  ```

test "rank487: cookie Max-Age clamps parsed seconds before Duration"
  lang rust
  file parse.rs
  reject VYQL-DOS-019
  reject_review code.CookieMaxAgeDurationSecondsPanic
  code
  ```
  fn parse_inner<'c>(s: &str, decode: bool) -> Result<Cookie<'c>, ParseError> {
      let mut cookie = Cookie::new("foo", "bar");
      for attr in attributes {
          let (key, value) = match attr.find('=') {
              Some(i) => (attr[..i].trim(), Some(attr[(i + 1)..].trim())),
              None => (attr.trim(), None),
          };

          match (&*key.to_ascii_lowercase(), value) {
              ("max-age", Some(v)) => {
                  cookie.max_age = match v.parse() {
                      Ok(val) if val <= 0 => Some(Duration::zero()),
                      Ok(val) => {
                          let val = cmp::min(val, Duration::max_value().num_seconds());
                          Some(Duration::seconds(val))
                      }
                      Err(_) => continue,
                  };
              }
              _ => {}
          }
      }
      Ok(cookie)
  }
  ```
