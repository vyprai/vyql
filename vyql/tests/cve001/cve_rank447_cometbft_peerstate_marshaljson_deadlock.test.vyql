# Rank 447 / CVE-2023-34450: CometBFT PeerState.MarshalJSON locked
# PeerState and then marshaled the same receiver, re-entering MarshalJSON.

test "rank447: CometBFT PeerState MarshalJSON recursively marshals locked receiver"
  lang go
  file reactor.go
  expect VYQL-LIFE-003
  expect_review code.RecursiveJsonMarshalUnderLock
  code
  ```
  package consensus

  import (
      "sync"

      cmtjson "github.com/cometbft/cometbft/libs/json"
  )

  type PeerState struct {
      mtx sync.Mutex
      PRS string `json:"round_state"`
  }

  func (ps *PeerState) MarshalJSON() ([]byte, error) {
      ps.mtx.Lock()
      defer ps.mtx.Unlock()

      return cmtjson.Marshal(ps)
  }
  ```

test "rank447: CometBFT PeerState MarshalJSON uses alias type while locked"
  lang go
  file reactor.go
  reject VYQL-LIFE-003
  reject_review code.RecursiveJsonMarshalUnderLock
  code
  ```
  package consensus

  import (
      "sync"

      cmtjson "github.com/cometbft/cometbft/libs/json"
  )

  type PeerState struct {
      mtx sync.Mutex
      PRS string `json:"round_state"`
  }

  func (ps *PeerState) MarshalJSON() ([]byte, error) {
      ps.mtx.Lock()
      defer ps.mtx.Unlock()

      type jsonPeerState PeerState
      return cmtjson.Marshal((*jsonPeerState)(ps))
  }
  ```
