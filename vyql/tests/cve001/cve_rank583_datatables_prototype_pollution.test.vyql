# Rank 583 / CVE-2020-28458: DataTables prototype pollution path validation.
# Ledger verification: VYQL-INJ-013 catches constructor/prototype path writes.

test "rank583: DataTables path keys can write prototypes"
  lang javascript
  profile library
  expect VYQL-INJ-013
  code
  ```
  function assignPath(target, path, value) {
    const parts = path.split(".");
    let cur = target;
    for (let i = 0; i < parts.length - 1; i++) {
      cur = cur[parts[i]] || (cur[parts[i]] = {});
    }
    cur[parts[parts.length - 1]] = value;
  }

  exports.set = function set(path, value) {
    const row = {};
    assignPath(row, path, value);
    return row;
  };
  ```

test "rank583: DataTables rejects prototype path components"
  lang javascript
  profile library
  reject VYQL-INJ-013
  code
  ```
  function assignPath(target, path, value) {
    const parts = path.split(".");
    if (parts.includes("__proto__") || parts.includes("constructor") || parts.includes("prototype")) {
      return target;
    }
    let cur = target;
    for (let i = 0; i < parts.length - 1; i++) {
      cur = cur[parts[i]] || (cur[parts[i]] = {});
    }
    cur[parts[parts.length - 1]] = value;
    return target;
  }
  ```
