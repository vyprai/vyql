test "rank295: cached-path-relative uses plain object buckets for caller path keys"
lang javascript
expect VYQL-INJ-049
expect_review code.PrototypeKeyCachePoisoning
code
```
var path = require('path')
var relative = path.relative
var lastCwd = process.cwd()
var cache = Object.create(null)

module.exports = cachedPathRelative

function cachedPathRelative (from, to) {
  var cwd = process.cwd()
  if (cwd !== lastCwd) {
    cache = {}
    lastCwd = cwd
  }

  if (cache[from] && cache[from][to]) return cache[from][to]

  var result = relative.call(path, from, to)

  cache[from] = cache[from] || {}
  cache[from][to] = result

  return result
}
```

test "rank295: cached-path-relative uses null-prototype cache buckets"
lang javascript
reject VYQL-INJ-049
reject_review code.PrototypeKeyCachePoisoning
code
```
var path = require('path')
var relative = path.relative
var lastCwd = process.cwd()
var cache = Object.create(null)

module.exports = cachedPathRelative

function cachedPathRelative (from, to) {
  var cwd = process.cwd()
  if (cwd !== lastCwd) {
    cache = Object.create(null)
    lastCwd = cwd
  }

  if (cache[from] && cache[from][to]) return cache[from][to]

  var result = relative.call(path, from, to)

  cache[from] = cache[from] || Object.create(null)
  cache[from][to] = result

  return result
}
```
