# Rank 915 / CVE-2026-32752: FreeScout allowed editing customer-created
# conversation threads without checking the user's mailbox access.

test "rank915: customer thread edit policy lacks mailbox access check"
  lang php
  file ThreadPolicy.php
  expect VYQL-AUTH-066
  expect_review code.CustomerThreadEditMissingMailboxAuthorization
  code
  ```
  <?php
  namespace App\Policies;

  use App\Thread;
  use App\User;
  use Illuminate\Auth\Access\HandlesAuthorization;

  class ThreadPolicy
  {
      use HandlesAuthorization;

      public function edit(User $user, Thread $thread)
      {
          if (($thread->created_by_user_id
              && in_array($thread->type, [Thread::TYPE_MESSAGE, Thread::TYPE_NOTE])
              && ($user->isAdmin() || ($user->hasPermission(User::PERM_EDIT_CONVERSATIONS) && $thread->created_by_user_id == $user->id)))
              || ($thread->created_by_customer_id && in_array($thread->type, [Thread::TYPE_CUSTOMER]))
          ) {
              return true;
          } else {
              return false;
          }
      }
  }
  ```

test "rank915: customer thread edit policy checks mailbox access"
  lang php
  file ThreadPolicy.php
  reject VYQL-AUTH-066
  reject_review code.CustomerThreadEditMissingMailboxAuthorization
  code
  ```
  <?php
  namespace App\Policies;

  use App\Thread;
  use App\User;
  use Illuminate\Auth\Access\HandlesAuthorization;

  class ThreadPolicy
  {
      use HandlesAuthorization;

      public function edit(User $user, Thread $thread)
      {
          if ((
                  $thread->created_by_user_id
                  && in_array($thread->type, [Thread::TYPE_MESSAGE, Thread::TYPE_NOTE])
                  && ($user->isAdmin() || ($user->hasPermission(User::PERM_EDIT_CONVERSATIONS) && $thread->created_by_user_id == $user->id))
              ) || (
                  $thread->created_by_customer_id
                  && in_array($thread->type, [Thread::TYPE_CUSTOMER])
                  && $thread->conversation
                  && ($user->isAdmin() || $thread->conversation->userHasAccessToMailbox($user->id))
              )
          ) {
              return true;
          } else {
              return false;
          }
      }
  }
  ```
