test "rank654: ASP.NET log filename reaches File.OpenText"
  lang csharp
  expect VYQL-PATH-001
  code
  ```
  using System.IO;
  using System.Web.Http;

  public class ServerSettingsLogsController : ApiController
  {
      [HttpGet]
      public object GetLogFile(string fileName)
      {
          var logFilePath = Path.Combine(AppRoot, @"portals\_default\logs", fileName);
          return CreateLogFileResponse(logFilePath);
      }

      private static object CreateLogFileResponse(string logFilePath)
      {
          if (!File.Exists(logFilePath))
          {
              return null;
          }

          using (var reader = File.OpenText(logFilePath))
          {
              return reader.ReadToEnd();
          }
      }
  }
  ```

test "rank654: Path.GetFileName canonicalizes ASP.NET log filename"
  lang csharp
  reject VYQL-PATH-001
  code
  ```
  using System.IO;
  using System.Web.Http;

  public class ServerSettingsLogsController : ApiController
  {
      [HttpGet]
      public object GetLogFile(string fileName)
      {
          var cleanedFileName = Path.GetFileName(fileName);
          var logFilePath = Path.Combine(AppRoot, @"portals\_default\logs", cleanedFileName);
          return CreateLogFileResponse(logFilePath);
      }

      private static object CreateLogFileResponse(string logFilePath)
      {
          if (!File.Exists(logFilePath))
          {
              return null;
          }

          using (var reader = File.OpenText(logFilePath))
          {
              return reader.ReadToEnd();
          }
      }
  }
  ```
