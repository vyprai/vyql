test "rank109: APR strmatch uses signed char-derived table indexes"
  lang c
  expect_review code.IndexAccess
  expect_review code.IntegerSizeArithmetic
  code
  ```
  typedef unsigned long apr_size_t;
  int apr_tolower(int ch);

  void apr_strmatch_precompile(const char *s, apr_size_t length, int case_sensitive) {
      apr_size_t shift[256];
      apr_size_t i;
      if (case_sensitive) {
          for (i = 0; i < length - 1; i++) {
              shift[(int)s[i]] = length - i - 1;
          }
      } else {
          for (i = 0; i < length - 1; i++) {
              shift[apr_tolower(s[i])] = length - i - 1;
          }
      }
  }
  ```
