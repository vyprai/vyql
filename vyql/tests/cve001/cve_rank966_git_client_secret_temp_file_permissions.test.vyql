# Rank 966 / CVE-2017-1000242: Jenkins git-client wrote SSH keys and
# askpass scripts containing credentials to default-permission temporary files.
# The fix creates temp files with owner-only POSIX permissions.

test "rank966: credential helper material is written to default-permission temp file"
  lang java
  profile api
  file src/main/java/org/jenkinsci/plugins/gitclient/CliGitAPIImpl.java
  expect VYQL-SEC-035
  expect_review code.SensitiveTempFileDefaultPermission
  code
  ```
  import java.io.File;
  import java.io.PrintWriter;
  import java.nio.charset.Charset;

  class Secret {
      static String toString(Secret s) { return "secret"; }
  }

  class SSHUserPrivateKey {
      Secret getPassphrase() { return new Secret(); }
  }

  class CliGitAPIImpl {
      private File createUnixSshAskpass(SSHUserPrivateKey sshUser) throws Exception {
          File ssh = File.createTempFile("pass", ".sh");
          try (PrintWriter w = new PrintWriter(ssh, Charset.defaultCharset().toString())) {
              w.println("echo '" + Secret.toString(sshUser.getPassphrase()) + "'");
          }
          return ssh;
      }
  }
  ```

test "rank966: credential helper temp file uses owner-only permissions"
  lang java
  profile api
  file src/main/java/org/jenkinsci/plugins/gitclient/CliGitAPIImpl.java
  reject VYQL-SEC-035
  reject_review code.SensitiveTempFileDefaultPermission
  code
  ```
  import java.io.File;
  import java.nio.file.Files;
  import java.nio.file.attribute.FileAttribute;
  import java.nio.file.attribute.PosixFilePermission;
  import java.nio.file.attribute.PosixFilePermissions;
  import java.util.Set;

  class Secret {
      static String toString(Secret s) { return "secret"; }
  }

  class SSHUserPrivateKey {
      Secret getPassphrase() { return new Secret(); }
  }

  class CliGitAPIImpl {
      private File createTempFile(String prefix, String suffix) throws Exception {
          Set<PosixFilePermission> ownerOnly = PosixFilePermissions.fromString("rw-------");
          FileAttribute fileAttribute = PosixFilePermissions.asFileAttribute(ownerOnly);
          return Files.createTempFile(prefix, suffix, fileAttribute).toFile();
      }

      private File createUnixSshAskpass(SSHUserPrivateKey sshUser) throws Exception {
          File ssh = createTempFile("pass", ".sh");
          try (java.io.PrintWriter w = new java.io.PrintWriter(ssh)) {
              w.println("echo '" + Secret.toString(sshUser.getPassphrase()) + "'");
          }
          return ssh;
      }
  }
  ```
