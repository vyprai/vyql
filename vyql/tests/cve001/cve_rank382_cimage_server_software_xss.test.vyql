# Rank 382 / CVE-2016-15022: cimage check_system.php echoed
# $_SERVER['SERVER_SOFTWARE'] into HTML. The fix wraps it with
# htmlentities().

test "rank382: cimage echoes server software without HTML escaping"
  lang php
  expect VYQL-INJ-004
  code
  ```
  <?php
  echo 'Running on: ' . $_SERVER['SERVER_SOFTWARE'] . '<br><br>';
  ```

test "rank382: cimage escapes server software before echoing"
  lang php
  reject VYQL-INJ-004
  code
  ```
  <?php
  echo 'Running on: ' . htmlentities($_SERVER['SERVER_SOFTWARE']) . '<br><br>';
  ```
