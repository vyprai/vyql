# Rank 273 / CVE-2020-7790: Browsershot let caller-controlled file:// URLs
# reach headless-browser navigation, allowing arbitrary local files in output.

test "rank273: browsershot file URL reaches page.goto"
  lang javascript
  expect VYQL-PATH-008
  expect_review code.LocalFileUrlNavigation
  code
  ```
  const puppeteer = require('puppeteer');
  const [, , ...args] = process.argv;
  const request = JSON.parse(args[0]);

  const callChrome = async pup => {
    const puppet = pup || puppeteer;
    const browser = await puppet.launch({});
    const page = await browser.newPage();
    const requestOptions = {};

    await page.goto(request.url, requestOptions);
  };
  ```

test "rank273: browsershot handles file URLs before page.goto"
  lang javascript
  reject VYQL-PATH-008
  reject_review code.LocalFileUrlNavigation
  code
  ```
  const puppeteer = require('puppeteer');
  const fs = require('fs');
  const URL = require('url').URL;
  const [, , ...args] = process.argv;
  const request = JSON.parse(args[0]);

  const callChrome = async pup => {
    const puppet = pup || puppeteer;
    const browser = await puppet.launch({});
    const page = await browser.newPage();
    const requestOptions = {};

    if (request.url.trim().toLowerCase().substring(0, 4) === 'file') {
      await page.setContent(fs.readFileSync(new URL(request.url), 'utf-8'), requestOptions);
    } else {
      await page.goto(request.url, requestOptions);
    }
  };
  ```
