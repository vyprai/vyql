test "rank343: cc-switch proxy allows any CORS origin"
  lang rust
  expect VYQL-CFG-003
  expect_review code.PermissiveCors
  code
  ```
  use axum::Router;
  use tower_http::cors::{Any, CorsLayer};

  impl ProxyServer {
      fn build_router(&self) -> Router {
          let cors = CorsLayer::new()
              .allow_origin(Any)
              .allow_methods(Any)
              .allow_headers(Any);

          Router::new()
              .layer(cors)
      }
  }
  ```

