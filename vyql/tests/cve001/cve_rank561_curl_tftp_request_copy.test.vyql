# Rank 561 / CVE-2006-1061: curl TFTP request packet unbounded copy.
# Fresh scan evidence includes VYQL-MEM-002 at lib/tftp.c sprintf/strcpy-like copy.

test "rank561: curl TFTP request uses unbounded sprintf"
  lang c
  expect VYQL-MEM-002
  code
  ```
  void f(char *dst, char *name) {
      sprintf(dst, "%s", name);
  }
  ```

test "rank561: curl TFTP request uses bounded snprintf"
  lang c
  reject VYQL-MEM-002
  code
  ```
  void f(char *dst, char *name) {
      snprintf(dst, 256, "%s", name);
  }
  ```
