# Rank 640 / CVE-2018-6596: django-anymail compared webhook Basic Auth
# credentials with ordinary string membership instead of constant-time compare.
test "rank640: Anymail webhook basic auth membership compare leaks timing"
  lang python
  file base.py
  expect VYQL-CRY-006
  expect_review code.SecretComparisonReview
  code
  ```
  class AnymailBasicAuthMixin(object):
      basic_auth = None

      def validate_request(self, request):
          if self.basic_auth:
              basic_auth = get_request_basic_auth(request)
              if basic_auth is None or basic_auth not in self.basic_auth:
                  raise AnymailWebhookValidationFailure("Missing or invalid basic auth")
  ```

test "rank640: Anymail webhook basic auth uses constant-time compare"
  lang python
  file base.py
  reject VYQL-CRY-006
  reject_review code.SecretComparisonReview
  code
  ```
  from django.utils.crypto import constant_time_compare

  class AnymailBasicAuthMixin(object):
      basic_auth = None

      def validate_request(self, request):
          if self.basic_auth:
              request_auth = get_request_basic_auth(request)
              auth_ok = any(constant_time_compare(request_auth, allowed_auth)
                            for allowed_auth in self.basic_auth)
              if not auth_ok:
                  raise AnymailWebhookValidationFailure("Missing or invalid basic auth")
  ```
