# Rank 971 / CVE-2022-36885: Jenkins GitHub plugin compared webhook HMAC
# signatures with StringUtils.equals. The fix uses MessageDigest.isEqual.

test "rank971: webhook signature digest uses ordinary string equality"
  lang java
  profile api
  file src/main/java/org/jenkinsci/plugins/github/webhook/GHWebhookSignature.java
  expect VYQL-CRY-006
  expect_review code.SecretComparisonReview
  code
  ```
  package org.jenkinsci.plugins.github.webhook;

  import org.apache.commons.lang3.StringUtils;

  class GHWebhookSignature {
      public String sha1() {
          return "computed";
      }

      public boolean matches(String digest) {
          String computed = sha1();
          return StringUtils.equals(computed, digest);
      }
  }
  ```

test "rank971: webhook signature digest uses constant-time comparison"
  lang java
  profile api
  file src/main/java/org/jenkinsci/plugins/github/webhook/GHWebhookSignature.java
  reject VYQL-CRY-006
  reject_review code.SecretComparisonReview
  code
  ```
  package org.jenkinsci.plugins.github.webhook;

  import java.nio.charset.StandardCharsets;
  import java.security.MessageDigest;

  class GHWebhookSignature {
      public String sha1() {
          return "computed";
      }

      public boolean matches(String digest) {
          String computed = sha1();
          if (digest == null || computed == null) {
              return false;
          }
          return MessageDigest.isEqual(computed.getBytes(StandardCharsets.UTF_8), digest.getBytes(StandardCharsets.UTF_8));
      }
  }
  ```
