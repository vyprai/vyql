test "rank350: Centreon contact list decodes stored contact name and alias"
  lang php
  expect VYQL-INJ-055
  expect_review code.CentreonMyAccountContactXss
  code
  ```
  <?php
  $elemArr[] = array(
      "RowMenu_name" => html_entity_decode($contact["contact_name"], ENT_QUOTES, "UTF-8"),
      "RowMenu_desc" => CentreonUtils::escapeSecure(
          html_entity_decode($contact["contact_alias"], ENT_QUOTES, "UTF-8")
      ),
  );
  ```

test "rank350: Centreon contact list uses illegal-character escape mode"
  lang php
  reject VYQL-INJ-055
  reject_review code.CentreonMyAccountContactXss
  code
  ```
  <?php
  $elemArr[] = array(
      "RowMenu_name" => CentreonUtils::escapeSecure(
          html_entity_decode($contact["contact_name"], ENT_QUOTES, "UTF-8"),
          CentreonUtils::ESCAPE_ILLEGAL_CHARS
      ),
      "RowMenu_desc" => CentreonUtils::escapeSecure(
          html_entity_decode($contact["contact_alias"], ENT_QUOTES, "UTF-8"),
          CentreonUtils::ESCAPE_ILLEGAL_CHARS
      ),
  );
  ```
