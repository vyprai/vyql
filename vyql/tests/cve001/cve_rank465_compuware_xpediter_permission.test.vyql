# Rank 465 / CVE-2022-36897: Jenkins Compuware Xpediter Code Coverage exposed
# descriptor fill endpoints that enumerated host connections and credentials
# without Item/Configure or Overall/Administer checks.

test "rank465: Xpediter Code Coverage fill endpoints enumerate config without permission checks"
  lang java
  file CodeCoverageBuilder.java
  expect VYQL-AUTH-025
  expect_review code.JenkinsDescriptorConfigEnumerationMissingPermission
  code
  ```
  import com.cloudbees.plugins.credentials.CredentialsProvider;
  import hudson.model.Item;
  import hudson.security.ACL;
  import hudson.util.ListBoxModel;
  import hudson.util.ListBoxModel.Option;
  import jenkins.model.Jenkins;
  import org.apache.commons.lang.StringUtils;
  import org.kohsuke.stapler.AncestorInPath;
  import org.kohsuke.stapler.QueryParameter;

  public class CodeCoverageBuilder {
    public static class DescriptorImpl {
      public ListBoxModel doFillConnectionIdItems(@AncestorInPath Jenkins context,
                                                  @QueryParameter String connectionId,
                                                  @AncestorInPath Item project) {
        CpwrGlobalConfiguration globalConfig = CpwrGlobalConfiguration.get();
        HostConnection[] hostConnections = globalConfig.getHostConnections();

        ListBoxModel model = new ListBoxModel();
        model.add(new Option(StringUtils.EMPTY, StringUtils.EMPTY, false));

        for (HostConnection connection : hostConnections) {
          boolean isSelected = connectionId != null && connectionId.matches(connection.getConnectionId());
          model.add(new Option(connection.getDescription() + " [" + connection.getHostPort() + ']',
            connection.getConnectionId(), isSelected));
        }

        return model;
      }

      public ListBoxModel doFillCredentialsIdItems(@AncestorInPath Jenkins context,
                                                   @QueryParameter String credentialsId,
                                                   @AncestorInPath Item project) {
        List<StandardCredentials> creds = CredentialsProvider.lookupCredentials(
          StandardCredentials.class, project, ACL.SYSTEM, Collections.<DomainRequirement>emptyList());

        ListBoxModel model = new ListBoxModel();
        model.add(new Option(StringUtils.EMPTY, StringUtils.EMPTY, false));

        for (StandardCredentials c : creds) {
          boolean isSelected = credentialsId != null && credentialsId.matches(c.getId());
          model.add(new Option(c.getDescription(), c.getId(), isSelected));
        }

        return model;
      }
    }
  }
  ```

test "rank465: Xpediter Code Coverage fill endpoints check configure or admin permission"
  lang java
  file CodeCoverageBuilder.java
  reject VYQL-AUTH-025
  reject_review code.JenkinsDescriptorConfigEnumerationMissingPermission
  code
  ```
  import com.cloudbees.plugins.credentials.CredentialsProvider;
  import hudson.model.Item;
  import hudson.security.ACL;
  import hudson.util.ListBoxModel;
  import hudson.util.ListBoxModel.Option;
  import jenkins.model.Jenkins;
  import org.apache.commons.lang.StringUtils;
  import org.kohsuke.stapler.AncestorInPath;
  import org.kohsuke.stapler.QueryParameter;

  public class CodeCoverageBuilder {
    public static class DescriptorImpl {
      public ListBoxModel doFillConnectionIdItems(@AncestorInPath Jenkins context,
                                                  @QueryParameter String connectionId,
                                                  @AncestorInPath Item project) {
        if (project == null) {
          Jenkins.get().checkPermission(Jenkins.ADMINISTER);
        } else {
          project.checkPermission(Item.CONFIGURE);
        }

        CpwrGlobalConfiguration globalConfig = CpwrGlobalConfiguration.get();
        HostConnection[] hostConnections = globalConfig.getHostConnections();

        ListBoxModel model = new ListBoxModel();
        for (HostConnection connection : hostConnections) {
          model.add(new Option(connection.getDescription(), connection.getConnectionId(), false));
        }

        return model;
      }

      public ListBoxModel doFillCredentialsIdItems(@AncestorInPath Jenkins context,
                                                   @QueryParameter String credentialsId,
                                                   @AncestorInPath Item project) {
        if (project == null) {
          Jenkins.get().checkPermission(Jenkins.ADMINISTER);
        } else {
          project.checkPermission(Item.CONFIGURE);
        }

        List<StandardCredentials> creds = CredentialsProvider.lookupCredentials(
          StandardCredentials.class, project, ACL.SYSTEM, Collections.<DomainRequirement>emptyList());

        ListBoxModel model = new ListBoxModel();
        for (StandardCredentials c : creds) {
          model.add(new Option(c.getDescription(), c.getId(), false));
        }

        return model;
      }
    }
  }
  ```
