# Rank 250 / CVE-2026-39387: BoidCMS page template metadata was
# concatenated into a theme path and required. The fix allowlists the page
# template against the theme template list before including it.

test "rank250: page template metadata reaches require without allowlist"
  lang php
  expect VYQL-PATH-002
  code
  ```
  <?php
  function render($templates) {
    $tpl = $_GET['tpl'];
    $tpl_path = 'themes/site/' . $tpl;
    if (is_file($tpl_path)) {
      require_once $tpl_path;
    }
  }
  ```

test "rank250: page template metadata is allowlisted before require"
  lang php
  reject VYQL-PATH-002
  code
  ```
  <?php
  function render($templates) {
    $tpl = $_GET['tpl'];
    $tpl_path = 'themes/site/' . $tpl;
    if (in_array($tpl, $templates) && is_file($tpl_path)) {
      require_once $tpl_path;
    }
  }
  ```
