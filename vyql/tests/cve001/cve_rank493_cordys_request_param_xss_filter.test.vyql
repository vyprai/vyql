# Rank 493 / CVE-2026-10514: CordysCRM trimmed request strings but left
# XSS escaping disabled by default; the fix adds URL-scoped escaping.

test "rank493: Cordys request string deserializer depends on disabled global escape flag"
  lang java
  file RequestParamTrimConfig.java
  expect VYQL-INJ-108
  expect_review code.CordysRequestParamXssFilterDisabled
  code
  ```
  import com.fasterxml.jackson.core.JsonParser;
  import com.fasterxml.jackson.databind.DeserializationContext;
  import com.fasterxml.jackson.databind.deser.std.StdScalarDeserializer;
  import org.apache.commons.lang3.StringUtils;
  import org.springframework.boot.autoconfigure.jackson.Jackson2ObjectMapperBuilderCustomizer;
  import org.springframework.web.util.HtmlUtils;
  import java.io.IOException;

  public class RequestParamTrimConfig {
      private boolean escape;

      public Jackson2ObjectMapperBuilderCustomizer jackson2ObjectMapperBuilderCustomizer() {
          return jacksonObjectMapperBuilder -> {
              jacksonObjectMapperBuilder.deserializerByType(String.class, new StdScalarDeserializer<String>(String.class) {
                  @Override
                  public String deserialize(JsonParser jsonParser, DeserializationContext ctx) throws IOException {
                      String value = StringUtils.trim(jsonParser.getValueAsString());
                      if (escape) {
                          return HtmlUtils.htmlEscape(value);
                      }
                      return value;
                  }
              });
          };
      }
  }
  ```

test "rank493: Cordys request string deserializer uses URL-scoped XSS filter"
  lang java
  file RequestParamTrimConfig.java
  reject VYQL-INJ-108
  reject_review code.CordysRequestParamXssFilterDisabled
  code
  ```
  import com.fasterxml.jackson.core.JsonParser;
  import com.fasterxml.jackson.databind.DeserializationContext;
  import com.fasterxml.jackson.databind.deser.std.StdScalarDeserializer;
  import org.apache.commons.lang3.StringUtils;
  import org.springframework.boot.autoconfigure.jackson.Jackson2ObjectMapperBuilderCustomizer;
  import org.springframework.util.AntPathMatcher;
  import org.springframework.web.util.HtmlUtils;
  import java.io.IOException;

  public class RequestParamTrimConfig {
      private String xssFilterUrlList;

      public Jackson2ObjectMapperBuilderCustomizer jackson2ObjectMapperBuilderCustomizer() {
          AntPathMatcher pathMatcher = new AntPathMatcher();
          return builder -> builder.deserializerByType(String.class, new StdScalarDeserializer<String>(String.class) {
              @Override
              public String deserialize(JsonParser p, DeserializationContext ctxt) throws IOException {
                  String rawValue = p.getValueAsString();
                  String trimmedValue = StringUtils.trim(rawValue);
                  if (shouldEscapeXss(pathMatcher)) {
                      return HtmlUtils.htmlEscape(trimmedValue);
                  }
                  return trimmedValue;
              }
          });
      }

      private boolean shouldEscapeXss(AntPathMatcher pathMatcher) {
          return StringUtils.isNotBlank(xssFilterUrlList);
      }
  }
  ```
