# Rank 628 / CVE-2018-6561: dijit ViewSource stripped script and iframe
# markup but did not strip inline on* event handler attributes before returning
# edited HTML to the rich-text editor.
test "rank628: HTML source filter strips scripts and iframes but not event handlers"
  lang javascript
  file ViewSource.js
  expect VYQL-INJ-136
  code
  ```
  define([
    "dojo/_base/declare",
    "../_Plugin"
  ], function(declare, _Plugin){
    var ViewSource = declare("dijit._editor.plugins.ViewSource", _Plugin, {
      stripScripts: true,
      stripComments: true,
      stripIFrames: true,

      _stripScripts: function(html){
        if(html){
          html = html.replace(/<\s*script[^>]*>((.|\s)*?)<\\?\/\s*script\s*>/ig, "");
          html = html.replace(/<\s*script\b([^<>]|\s)*>?/ig, "");
          html = html.replace(/<[^>]*=(\s|)*[("|')]javascript:[^$1][(\s|.)]*[$1][^>]*>/ig, "");
        }
        return html;
      },

      _stripComments: function(html){
        if(html){
          html = html.replace(/<!--(.|\s){1,}?-->/g, "");
        }
        return html;
      },

      _stripIFrames: function(html){
        if(html){
          html = html.replace(/<\s*iframe[^>]*>((.|\s)*?)<\\?\/\s*iframe\s*>/ig, "");
        }
        return html;
      },

      _filter: function(html){
        if(html){
          if(this.stripScripts){
            html = this._stripScripts(html);
          }
          if(this.stripComments){
            html = this._stripComments(html);
          }
          if(this.stripIFrames){
            html = this._stripIFrames(html);
          }
        }
        return html;
      }
    });
    return ViewSource;
  });
  ```

test "rank628: HTML source filter also strips event handler attributes"
  lang javascript
  file ViewSource.js
  reject VYQL-INJ-136
  code
  ```
  define([
    "dojo/_base/declare",
    "../_Plugin"
  ], function(declare, _Plugin){
    var ViewSource = declare("dijit._editor.plugins.ViewSource", _Plugin, {
      stripScripts: true,
      stripComments: true,
      stripIFrames: true,
      stripEventHandlers: true,

      _stripScripts: function(html){
        if(html){
          html = html.replace(/<\s*script[^>]*>((.|\s)*?)<\\?\/\s*script\s*>/ig, "");
          html = html.replace(/<\s*script\b([^<>]|\s)*>?/ig, "");
          html = html.replace(/<[^>]*=(\s|)*[("|')]javascript:[^$1][(\s|.)]*[$1][^>]*>/ig, "");
        }
        return html;
      },

      _stripComments: function(html){
        if(html){
          html = html.replace(/<!--(.|\s){1,}?-->/g, "");
        }
        return html;
      },

      _stripIFrames: function(html){
        if(html){
          html = html.replace(/<\s*iframe[^>]*>((.|\s)*?)<\\?\/\s*iframe\s*>/ig, "");
        }
        return html;
      },

      _stripEventHandlers: function(html){
        if(html){
          var matches = html.match(/<[a-z]+?\b(.*?on.*?(['"]).*?\2.*?)+>/gim);
          if(matches){
            for(var i = 0, l = matches.length; i < l; i++){
              var match = matches[i];
              var replacement = match.replace(/\s+on[a-z]*\s*=\s*(['"])(.*?)\1/igm, "");
              html = html.replace(match, replacement);
            }
          }
        }
        return html;
      },

      _filter: function(html){
        if(html){
          if(this.stripScripts){
            html = this._stripScripts(html);
          }
          if(this.stripComments){
            html = this._stripComments(html);
          }
          if(this.stripIFrames){
            html = this._stripIFrames(html);
          }
          if(this.stripEventHandlers){
            html = this._stripEventHandlers(html);
          }
        }
        return html;
      }
    });
    return ViewSource;
  });
  ```
