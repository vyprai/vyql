# Rank 155 / CVE-2024-29901: AuthKit middleware copied the incoming request
# headers into the forwarded header set without removing the session header, so
# a client-supplied x-workos-session value survived on the no-cookie and
# refresh-failure paths and downstream getUser() read it as the middleware-owned
# session channel.

test "rank155: typescript authkit middleware must strip client session header"
  lang javascript
  expect VYQL-AUTH-082
  expect_review code.ProtocolStateReview
  code
  ```
  import { cookies } from 'next/headers';
  import { NextRequest, NextResponse } from 'next/server';

  const sessionHeaderName = 'x-workos-session';
  const middlewareHeaderName = 'x-workos-middleware';
  const cookieName = 'authkit';

  async function getSessionFromCookie() {
    return undefined;
  }

  async function verifyAccessToken(token) {
    return false;
  }

  async function encryptSession(session) {
    return 'sealed';
  }

  async function updateSession(request, debug) {
    const session = await getSessionFromCookie();
    const newRequestHeaders = new Headers(request.headers);

    newRequestHeaders.set('x-url', request.url);
    newRequestHeaders.set(middlewareHeaderName, 'true');

    // If no session, just continue
    if (!session) {
      return NextResponse.next({
        request: { headers: newRequestHeaders },
      });
    }

    const hasValidSession = await verifyAccessToken(session.accessToken);

    if (hasValidSession) {
      newRequestHeaders.set(sessionHeaderName, cookies().get(cookieName)!.value);
      return NextResponse.next({
        request: { headers: newRequestHeaders },
      });
    }

    try {
      const encryptedSession = await encryptSession(session);
      newRequestHeaders.set(sessionHeaderName, encryptedSession);

      const response = NextResponse.next({
        request: { headers: newRequestHeaders },
      });
      response.cookies.set(cookieName, encryptedSession);
      return response;
    } catch (e) {
      console.warn('Failed to refresh', e);
      const response = NextResponse.next();
      response.cookies.delete(cookieName);
      return response;
    }
  }
  ```

test "rank155: typescript authkit middleware strips client session header"
  lang javascript
  reject VYQL-AUTH-082
  reject_review code.ProtocolStateReview
  code
  ```
  import { cookies } from 'next/headers';
  import { NextRequest, NextResponse } from 'next/server';

  const sessionHeaderName = 'x-workos-session';
  const middlewareHeaderName = 'x-workos-middleware';
  const cookieName = 'authkit';

  async function getSessionFromCookie() {
    return undefined;
  }

  async function verifyAccessToken(token) {
    return false;
  }

  async function encryptSession(session) {
    return 'sealed';
  }

  async function updateSession(request, debug) {
    const session = await getSessionFromCookie();
    const newRequestHeaders = new Headers(request.headers);

    newRequestHeaders.set('x-url', request.url);
    newRequestHeaders.set(middlewareHeaderName, 'true');

    newRequestHeaders.delete(sessionHeaderName);

    // If no session, just continue
    if (!session) {
      return NextResponse.next({
        request: { headers: newRequestHeaders },
      });
    }

    const hasValidSession = await verifyAccessToken(session.accessToken);

    if (hasValidSession) {
      newRequestHeaders.set(sessionHeaderName, cookies().get(cookieName)!.value);
      return NextResponse.next({
        request: { headers: newRequestHeaders },
      });
    }

    try {
      const encryptedSession = await encryptSession(session);
      newRequestHeaders.set(sessionHeaderName, encryptedSession);

      const response = NextResponse.next({
        request: { headers: newRequestHeaders },
      });
      response.cookies.set(cookieName, encryptedSession);
      return response;
    } catch (e) {
      console.warn('Failed to refresh', e);
      const response = NextResponse.next({
        request: { headers: newRequestHeaders },
      });
      response.cookies.delete(cookieName);
      return response;
    }
  }
  ```
