# Rank 864 / CVE-2024-21641: Flarum accepted an arbitrary logout return URL
# and passed it directly to RedirectResponse.

test "rank864: Flarum logout return parameter redirects without allowlist"
  lang php
  file LogOutController.php
  expect VYQL-RF-037
  expect_review code.LogoutReturnUrlRedirectWithoutAllowlist
  code
  ```
  <?php
  use Illuminate\Support\Arr;
  use Laminas\Diactoros\Response\RedirectResponse;

  class LogOutController {
      public function handle($request) {
          $url = Arr::get($request->getQueryParams(), 'return', $this->url->to('forum')->base());

          if ($actor->isGuest()) {
              return new RedirectResponse($url);
          }

          $response = new RedirectResponse($url);
          return $response;
      }
  }
  ```

test "rank864: Flarum logout return parameter is host allowlisted"
  lang php
  file LogOutController.php
  reject VYQL-RF-037
  reject_review code.LogoutReturnUrlRedirectWithoutAllowlist
  code
  ```
  <?php
  use Illuminate\Support\Arr;
  use Laminas\Diactoros\Response\RedirectResponse;

  class LogOutController {
      public function handle($request) {
          $base = $this->url->to('forum')->base();
          $returnUrl = Arr::get($request->getQueryParams(), 'return');
          $return = $this->sanitizeReturnUrl((string) $returnUrl, $base);

          if ($actor->isGuest()) {
              return new RedirectResponse($return);
          }

          $response = new RedirectResponse($return);
          return $response;
      }

      protected function sanitizeReturnUrl(string $url, string $base) {
          $parsedUrl = new Uri($url);
          if (in_array($parsedUrl->getHost(), $this->getAllowedRedirectDomains())) {
              return $parsedUrl;
          }
          return new Uri($base);
      }
  }
  ```
