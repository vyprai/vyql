# Rank 798 / CVE-2017-20160: express-param returned array-valued duplicated
# HTTP parameters directly. The fix collapses Array.isArray(value) to one value.

test "rank798: JavaScript Express parameter lookup returns raw array-capable values"
  lang javascript
  file fetchParams.js
  expect VYQL-VAL-008
  expect_review code.ExpressParamArrayValuePollution
  code
  ```
  function getValue(req, keyName) {
    if (req.params && req.params[keyName] !== undefined) {
      return req.params[keyName];
    } else if (req.body && req.body[keyName] !== undefined) {
      return req.body[keyName];
    } else if (req.query && req.query[keyName] !== undefined) {
      return req.query[keyName];
    } else {
      return undefined;
    }
  }
  ```

test "rank798: JavaScript Express parameter lookup collapses duplicated arrays"
  lang javascript
  file fetchParams.js
  reject VYQL-VAL-008
  reject_review code.ExpressParamArrayValuePollution
  code
  ```
  function getValue(req, keyName) {
    var value;
    if (req.params && req.params[keyName] !== undefined) {
      value = req.params[keyName];
    } else if (req.body && req.body[keyName] !== undefined) {
      value = req.body[keyName];
    } else if (req.query && req.query[keyName] !== undefined) {
      value = req.query[keyName];
    }
    if (Array.isArray(value)) {
      value = value[value.length - 1];
    }
    return value;
  }
  ```
