# Rank 949 / CVE-2020-7981: Geocoder's bounding-box SQL helper
# interpolated coordinate bounds before numeric coercion.

test "rank949: bounding-box SQL helper interpolates raw coordinate bounds"
  lang ruby
  profile library
  file sql.rb
  expect VYQL-INJ-188
  expect_review code.UnvalidatedCoordinateSqlInterpolation
  code
  ```
  module Geocoder
    module Sql
      extend self

      def within_bounding_box(sw_lat, sw_lng, ne_lat, ne_lng, lat_attr, lon_attr)
        spans = "#{lat_attr} BETWEEN #{sw_lat} AND #{ne_lat} AND "
        if sw_lng.to_f > ne_lng.to_f
          spans + "(#{lon_attr} BETWEEN #{sw_lng} AND 180 OR " +
          "#{lon_attr} BETWEEN -180 AND #{ne_lng})"
        else
          spans + "#{lon_attr} BETWEEN #{sw_lng} AND #{ne_lng}"
        end
      end
    end
  end
  ```

test "rank949: numeric coordinate coercion suppresses focused SQL finding"
  lang ruby
  profile library
  file sql.rb
  reject VYQL-INJ-188
  reject_review code.UnvalidatedCoordinateSqlInterpolation
  code
  ```
  module Geocoder
    module Sql
      extend self

      def within_bounding_box(sw_lat, sw_lng, ne_lat, ne_lng, lat_attr, lon_attr)
        spans = "#{lat_attr} BETWEEN #{sw_lat.to_f} AND #{ne_lat.to_f} AND "
        if sw_lng.to_f > ne_lng.to_f
          spans + "(#{lon_attr} BETWEEN #{sw_lng.to_f} AND 180 OR " +
          "#{lon_attr} BETWEEN -180 AND #{ne_lng.to_f})"
        else
          spans + "#{lon_attr} BETWEEN #{sw_lng.to_f} AND #{ne_lng.to_f}"
        end
      end
    end
  end
  ```
