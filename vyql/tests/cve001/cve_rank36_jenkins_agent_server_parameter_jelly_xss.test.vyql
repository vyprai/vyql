# Rank 36 / CVE-2022-25191: Jenkins Agent Server Parameter Plugin Jelly XSS.
# Ledger verification: VYQL-INJ-004 catches unescaped it.name in a script string.

test "rank36: agent server parameter renders name into script"
  lang config
  file index.jelly
  expect VYQL-INJ-004
  code
  ```
  <?jelly escape-by-default='true'?>
  <j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <script>
      const serverName = "${it.name}";
    </script>
  </j:jelly>
  ```

test "rank36: agent server parameter escapes name before script"
  lang config
  file index.jelly
  reject VYQL-INJ-004
  code
  ```
  <?jelly escape-by-default='true'?>
  <j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <script>
      const serverName = "${h.escape(it.name)}";
    </script>
  </j:jelly>
  ```
