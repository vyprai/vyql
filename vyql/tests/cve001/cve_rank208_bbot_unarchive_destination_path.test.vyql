# Rank 208 / CVE-2025-10284: bbot unarchive destination path traversal/collision.
# Ledger verification: VYQL-PATH-001 catches archive-derived output paths.

test "rank208: bbot archive event controls extraction destination"
  lang python
  expect VYQL-PATH-001
  code
  ```
  import os

  def unarchive(request, archive):
      output_dir = request.args["output"]
      if not os.path.exists(output_dir):
          os.makedirs(output_dir)
      archive.extractall(output_dir)
  ```

test "rank208: bbot archive extraction uses fixed destination"
  lang python
  reject VYQL-PATH-001
  code
  ```
  import os

  def unarchive(request, archive):
      output_dir = "/tmp/bbot-output"
      if not os.path.exists(output_dir):
          os.makedirs(output_dir)
      archive.extractall(output_dir)
  ```
