test "rank706: downloaded template directory copy keeps hidden glob mode enabled"
  lang javascript
  expect VYQL-PATH-034
  expect_review code.TemplateDirectoryHiddenGlobCopy
  code
  ```
  const fs = require('fs');
  const path = require('path');

  function downloadTemplate(cli, templateInfo, options) {
    const d = new Download(options, cli);
    const absSourceDir = d.download('easyjs-awesome-template', templateInfo.name);
    const files = fs.readdirSync(absSourceDir);
    const dist = options.dist || templateInfo.dist;
    files.forEach(name => {
      const file = path.join(absSourceDir, name);
      if (fs.statSync(file).isDirectory()) {
        d.copy(file, dist);
      }
    });
  }
  ```

test "rank706: downloaded template directory copy disables hidden glob mode"
  lang javascript
  reject VYQL-PATH-034
  reject_review code.TemplateDirectoryHiddenGlobCopy
  code
  ```
  const fs = require('fs');
  const path = require('path');

  function downloadTemplate(cli, templateInfo, options) {
    const d = new Download(options, cli);
    const absSourceDir = d.download('easyjs-awesome-template', templateInfo.name);
    const files = fs.readdirSync(absSourceDir);
    const dist = options.dist || templateInfo.dist;
    files.forEach(name => {
      const file = path.join(absSourceDir, name);
      if (fs.statSync(file).isDirectory()) {
        d.copy(file, dist, { hide: false });
      }
    });
  }
  ```
