# Rank 878 / CVE-2026-35194: Flink JSON row code generation embedded row
# field names directly into generated Java string literals. The fix escapes
# field names with EncodingUtils.escapeJava before interpolation.

test "rank878: generated Java JSON row code uses unescaped field names"
  lang scala
  file flink-table/flink-table-planner/src/main/scala/org/apache/flink/table/planner/codegen/JsonGenerateUtils.scala
  expect VYQL-INJ-175
  expect_review code.UnescapedGeneratedJavaStringFieldName
  code
  ```
  object JsonGenerateUtils {
    private def generateRowConverter(ctx: CodeGeneratorContext, rowType: LogicalType): String = {
      val fieldNames = toScala(LogicalTypeChecks.getFieldNames(rowType))
      val fieldTypes = toScala(LogicalTypeChecks.getFieldTypes(rowType))

      val populateObjectCode = fieldNames.zipWithIndex.map {
        case (fieldName, idx) =>
          val fieldType = fieldTypes(idx)
          s"""
             |objNode.set(
             |    "$fieldName",
             |    ${createNullableNodeTerm(ctx, "rowData", idx.toString, fieldType)});
             |""".stripMargin
      }.mkString

      val methodCode =
        s"""
           |private ObjectNode convertRow(RowData rowData) {
           |    ObjectNode objNode = jsonUtils.getNodeFactory().objectNode();
           |    $populateObjectCode
           |    return objNode;
           |}
           |""".stripMargin

      ctx.addReusableMember(methodCode)
      "convertRow"
    }
  }
  ```

test "rank878: generated Java JSON row code escapes field names"
  lang scala
  file flink-table/flink-table-planner/src/main/scala/org/apache/flink/table/planner/codegen/JsonGenerateUtils.scala
  reject VYQL-INJ-175
  reject_review code.UnescapedGeneratedJavaStringFieldName
  code
  ```
  object JsonGenerateUtils {
    private def generateRowConverter(ctx: CodeGeneratorContext, rowType: LogicalType): String = {
      val fieldNames = toScala(LogicalTypeChecks.getFieldNames(rowType)).map(EncodingUtils.escapeJava)
      val fieldTypes = toScala(LogicalTypeChecks.getFieldTypes(rowType))

      val populateObjectCode = fieldNames.zipWithIndex.map {
        case (fieldName, idx) =>
          val fieldType = fieldTypes(idx)
          s"""
             |objNode.set(
             |    "$fieldName",
             |    ${createNullableNodeTerm(ctx, "rowData", idx.toString, fieldType)});
             |""".stripMargin
      }.mkString

      val methodCode =
        s"""
           |private ObjectNode convertRow(RowData rowData) {
           |    ObjectNode objNode = jsonUtils.getNodeFactory().objectNode();
           |    $populateObjectCode
           |    return objNode;
           |}
           |""".stripMargin

      ctx.addReusableMember(methodCode)
      "convertRow"
    }
  }
  ```
