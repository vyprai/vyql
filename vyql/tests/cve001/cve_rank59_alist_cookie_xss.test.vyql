# Rank 59 / CVE-2024-47067: Alist cookie-derived XSS in helper response.
# Ledger verification: VYQL-INJ-004 touches patched server/handles/helper.go.

test "rank59: Alist writes cookie-derived HTML response"
  lang go
  expect VYQL-INJ-004
  code
  ```
  package p

  import (
    "fmt"
    "github.com/gin-gonic/gin"
  )

  func helper(ctx *gin.Context) {
    token, _ := ctx.Cookie("token")
    ctx.Writer.WriteString(fmt.Sprintf("<script>%s</script>", token))
  }
  ```

test "rank59: Alist escapes cookie before HTML response"
  lang go
  reject VYQL-INJ-004
  code
  ```
  package p

  import (
    "html"
    "github.com/gin-gonic/gin"
  )

  func helper(ctx *gin.Context) {
    token, _ := ctx.Cookie("token")
    ctx.Writer.WriteString(html.EscapeString(token))
  }
  ```
