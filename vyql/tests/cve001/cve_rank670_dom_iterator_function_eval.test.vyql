# Rank 670 / CVE-2024-21541: dom-iterator compiled string selectors with
# Function and evaluated them against a mutable node object.

test "rank670: Function predicate evaluates props expression against mutable node"
  lang javascript
  expect VYQL-INJ-147
  code
  ```
  var props = require('component-props');
  Iterator.prototype.compile = function(expr) {
    switch (typeof expr) {
      case 'string':
        return new Function('node', 'return ' + props(expr, 'node.'));
      default:
        return function() { return true; };
    }
  };
  ```

test "rank670: Function predicate freezes node before evaluating props expression"
  lang javascript
  reject VYQL-INJ-147
  code
  ```
  var props = require('component-props');
  Iterator.prototype.compile = function(expr) {
    switch (typeof expr) {
      case 'string':
        return new Function('node', 'Object.freeze(node); return ' + props(expr, 'node.'));
      default:
        return function() { return true; };
    }
  };
  ```
