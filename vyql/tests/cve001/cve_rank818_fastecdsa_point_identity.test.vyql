# Rank 818 / CVE-2020-12607: fastecdsa point arithmetic did not handle the
# elliptic-curve identity element before double/add/mul operations.

test "rank818: EC point arithmetic omits identity element handling"
  lang c
  file curveMath.c
  expect VYQL-CRY-026
  expect_review code.EcPointIdentityElementMissing
  code
  ```
  typedef struct { int x; int y; } PointZZ_p;
  typedef struct { int p; int a; } CurveZZ_p;
  typedef int mpz_t;

  void pointZZ_pDouble(PointZZ_p * rop, const PointZZ_p * op, const CurveZZ_p * curve) {
      mpz_t numer, denom, lambda;
      mpz_invert(denom, denom, curve->p);
      mpz_mod(lambda, lambda, curve->p);
  }

  void pointZZ_pAdd(PointZZ_p * rop, const PointZZ_p * op1, const PointZZ_p * op2, const CurveZZ_p * curve) {
      mpz_t xdiff, ydiff, lambda;
      mpz_invert(xdiff, xdiff, curve->p);
      mpz_mod(lambda, lambda, curve->p);
  }

  void pointZZ_pMul(PointZZ_p * rop, const PointZZ_p * point, const mpz_t scalar, const CurveZZ_p * curve) {
      PointZZ_p R0, R1, tmp;
      pointZZ_pDouble(&R1, point, curve);
      pointZZ_pAdd(&R0, &R1, &tmp, curve);
  }
  ```

test "rank818: EC point arithmetic handles identity element"
  lang c
  file curveMath.c
  reject VYQL-CRY-026
  reject_review code.EcPointIdentityElementMissing
  code
  ```
  typedef struct { int x; int y; } PointZZ_p;
  typedef struct { int p; int a; } CurveZZ_p;
  typedef int mpz_t;

  int pointZZ_pIsIdentityElement(const PointZZ_p * op) {
      return op->x == 0 && op->y == 0;
  }

  void pointZZ_pSetToIdentityElement(PointZZ_p * op) {
      op->x = 0;
      op->y = 0;
  }

  void pointZZ_pDouble(PointZZ_p * rop, const PointZZ_p * op, const CurveZZ_p * curve) {
      if (pointZZ_pIsIdentityElement(op)) {
          return pointZZ_pSetToIdentityElement(rop);
      }
      mpz_t numer, denom, lambda;
      mpz_invert(denom, denom, curve->p);
      mpz_mod(lambda, lambda, curve->p);
  }

  void pointZZ_pAdd(PointZZ_p * rop, const PointZZ_p * op1, const PointZZ_p * op2, const CurveZZ_p * curve) {
      if (pointZZ_pIsIdentityElement(op1) || pointZZ_pIsIdentityElement(op2)) {
          return pointZZ_pSetToIdentityElement(rop);
      }
      mpz_t xdiff, ydiff, lambda;
      mpz_invert(xdiff, xdiff, curve->p);
      mpz_mod(lambda, lambda, curve->p);
  }

  void pointZZ_pMul(PointZZ_p * rop, const PointZZ_p * point, const mpz_t scalar, const CurveZZ_p * curve) {
      if (pointZZ_pIsIdentityElement(point)) {
          return pointZZ_pSetToIdentityElement(rop);
      }
      PointZZ_p R0, R1, tmp;
      pointZZ_pDouble(&R1, point, curve);
      pointZZ_pAdd(&R0, &R1, &tmp, curve);
  }
  ```
