# Rank 720 / CVE-2022-31066: EdgeX message bus secret config exposure.
# Ledger verification: VYQL-SEC-021 catches password option left in service config.

test "rank720: EdgeX message bus password remains in optional config"
  lang go
  expect VYQL-SEC-021
  code
  ```
  package messaging

  func BootstrapHandler(dic *Container) bool {
      config := container.ConfigurationFrom(dic.Get)
      messageBusInfo := config.MessageQueue
      if len(messageBusInfo.AuthMode) > 0 {
          if err := bootstrapMessaging.SetOptionsAuthData(&messageBusInfo, lc, dic); err != nil {
              return false
          }
      }
      msgClient, err := messaging.NewMessageClient(types.MessageBusConfig{
          Optional: messageBusInfo.Optional,
      })
      if err != nil {
          return false
      }
      _ = msgClient
      return true
  }
  ```

test "rank720: EdgeX message bus password is deleted from optional config"
  lang go
  reject VYQL-SEC-021
  code
  ```
  package messaging

  func BootstrapHandler(dic *Container) bool {
      config := container.ConfigurationFrom(dic.Get)
      messageBusInfo := config.MessageQueue
      if len(messageBusInfo.AuthMode) > 0 {
          if err := bootstrapMessaging.SetOptionsAuthData(&messageBusInfo, lc, dic); err != nil {
              return false
          }
      }
      msgClient, err := messaging.NewMessageClient(types.MessageBusConfig{
          Optional: messageBusInfo.Optional,
      })
      if err != nil {
          return false
      }
      _ = msgClient
      delete(messageBusInfo.Optional, bootstrapMessaging.OptionsPasswordKey)
      return true
  }
  ```
