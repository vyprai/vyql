# Rank 755 / CVE-2020-36048: Engine.IO used a 100 MB default
# maxHttpBufferSize and forwarded it to WebSocket maxPayload.

test "rank755: Engine.IO oversized maxHttpBufferSize default"
  lang javascript
  file server.js
  expect VYQL-DOS-024
  expect_review code.OversizedWebsocketPayloadDefault
  code
  ```
  class Server {
    constructor(opts = {}) {
      this.opts = Object.assign(
        {
          wsEngine: process.env.EIO_WS_ENGINE || "ws",
          maxHttpBufferSize: 10e7
        },
        opts
      );
      const wsModule = require("ws");
      this.ws = new wsModule.Server({
        noServer: true,
        maxPayload: this.opts.maxHttpBufferSize
      });
    }
  }
  ```

test "rank755: Engine.IO lowered maxHttpBufferSize default"
  lang javascript
  file server.js
  reject VYQL-DOS-024
  reject_review code.OversizedWebsocketPayloadDefault
  code
  ```
  class Server {
    constructor(opts = {}) {
      this.opts = Object.assign(
        {
          wsEngine: process.env.EIO_WS_ENGINE || "ws",
          maxHttpBufferSize: 1e6
        },
        opts
      );
      const wsModule = require("ws");
      this.ws = new wsModule.Server({
        noServer: true,
        maxPayload: this.opts.maxHttpBufferSize
      });
    }
  }
  ```
