# Rank 760 / CVE-2026-22866: ENS DNSSEC RSA verification accepted a
# recovered signature block when only the trailing digest matched.

test "rank760: Solidity RSA SHA256 verifier checks only recovered digest suffix"
  lang solidity
  file RSASHA256Algorithm.sol
  expect VYQL-CRY-024
  expect_review code.RsaPkcs1DigestSuffixOnlyVerification
  code
  ```
  pragma solidity ^0.8.4;

  import "./RSAVerify.sol";

  contract RSASHA256Algorithm is Algorithm {
      function verify(
          bytes calldata key,
          bytes calldata data,
          bytes calldata sig
      ) external view override returns (bool) {
          bytes memory exponent;
          bytes memory modulus;

          bool ok;
          bytes memory result;
          (ok, result) = RSAVerify.rsarecover(modulus, exponent, sig);

          return ok && sha256(data) == result.readBytes32(result.length - 32);
      }
  }
  ```

test "rank760: Solidity RSA SHA1 verifier checks only recovered digest suffix"
  lang solidity
  file RSASHA1Algorithm.sol
  expect VYQL-CRY-024
  expect_review code.RsaPkcs1DigestSuffixOnlyVerification
  code
  ```
  pragma solidity ^0.8.4;

  import "./RSAVerify.sol";
  import "@ensdomains/solsha1/contracts/SHA1.sol";

  contract RSASHA1Algorithm is Algorithm {
      function verify(
          bytes calldata key,
          bytes calldata data,
          bytes calldata sig
      ) external view override returns (bool) {
          bytes memory exponent;
          bytes memory modulus;

          bool ok;
          bytes memory result;
          (ok, result) = RSAVerify.rsarecover(modulus, exponent, sig);

          return ok && SHA1.sha1(data) == result.readBytes20(result.length - 20);
      }
  }
  ```

test "rank760: Solidity RSA verifier delegates to PKCS1 validation"
  lang solidity
  file RSASHA256Algorithm.sol
  reject VYQL-CRY-024
  reject_review code.RsaPkcs1DigestSuffixOnlyVerification
  code
  ```
  pragma solidity ^0.8.4;

  import "./RSAPKCS1Verify.sol";

  contract RSASHA256Algorithm is Algorithm {
      function verify(
          bytes calldata key,
          bytes calldata data,
          bytes calldata sig
      ) external view override returns (bool) {
          bytes memory exponent;
          bytes memory modulus;
          return RSAPKCS1Verify.verifySHA256(modulus, exponent, sig, sha256(data));
      }
  }
  ```
