test "rank241: simplecrypt aes ecb rule password encryption is weak crypto"
  lang javascript
  expect VYQL-CRY-002
  code
  ```
  var simplecrypt = require('simplecrypt');
  var sc = simplecrypt({salt:'boopdeeboop', password:'blink1control', method:"aes-192-ecb"});
  function login(rule) {
    return sc.decrypt(rule.password);
  }
  ```

test "rank241: delegated decrypt helper has no simplecrypt weak cipher"
  lang javascript
  reject VYQL-CRY-002
  code
  ```
  var utils = require('../utils');
  function login(config) {
    return utils.decrypt(config.passwordHash);
  }
  ```
