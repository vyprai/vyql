# Rank 752 / CVE-2026-39847: Emmett's internal RSGI asset handler joined the
# route suffix under the package assets directory without canonical containment.

test "rank752: internal asset route lacks realpath containment"
  lang python
  expect VYQL-PATH-039
  expect_review code.InternalAssetRoutePathTraversal
  code
  ```
  import os

  class HTTPHandler:
      def _static_handler(self, scope, protocol, path: str):
          if path.startswith("/__emmett__"):
              file_name = path[12:]
              if not file_name:
                  return self._http_response(404)
              static_file = os.path.join(os.path.dirname(__file__), "..", "assets", file_name)
              if os.path.splitext(static_file)[1] == "html":
                  return self._http_response(404)
              return self._static_response(static_file)
          return self.dynamic_handler(scope, protocol, path)
  ```

test "rank752: internal asset route uses realpath containment"
  lang python
  reject VYQL-PATH-039
  reject_review code.InternalAssetRoutePathTraversal
  code
  ```
  import os

  _pkg_assets_path = os.path.realpath(os.path.join(os.path.dirname(__file__), "..", "assets"))

  class HTTPHandler:
      def _static_handler(self, scope, protocol, path: str):
          if path.startswith("/__emmett__"):
              file_name = path[12:]
              if not file_name:
                  return self._http_response(404)
              static_file = os.path.realpath(os.path.join(_pkg_assets_path, file_name))
              if not static_file.startswith(_pkg_assets_path):
                  return self._http_response(404)
              if os.path.splitext(static_file)[1] == "html":
                  return self._http_response(404)
              return self._static_response(static_file)
          return self.dynamic_handler(scope, protocol, path)
  ```
