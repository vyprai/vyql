# Rank 983 / CVE-2012-4573: Glance delayed deletion allowed deleting another
# user's image because the delete path did not verify admin or image ownership.

test "rank983: image delete lacks owner authorization before backend deletion"
  lang python
  file glance/api/v1/images.py
  expect VYQL-AUTH-076
  expect_review code.OwnedResourceDeleteMissingOwnershipCheck
  code
  ```
  class Controller(object):
      def delete(self, req, id):
          self._enforce(req, 'delete_image')
          if req.context.read_only:
              raise HTTPForbidden('Read-only access')

          image = self.get_image_meta_or_404(req, id)

          if image['protected']:
              raise HTTPForbidden('Image is protected')

          if image['location']:
              schedule_delete_from_backend(image['location'], self.conf,
                                           req.context, id)
          registry.delete_image_metadata(req.context, id)
  ```

test "rank983: image delete checks admin or owner before backend deletion"
  lang python
  file glance/api/v1/images.py
  reject VYQL-AUTH-076
  reject_review code.OwnedResourceDeleteMissingOwnershipCheck
  code
  ```
  class Controller(object):
      def delete(self, req, id):
          self._enforce(req, 'delete_image')
          if req.context.read_only:
              raise HTTPForbidden('Read-only access')

          image = self.get_image_meta_or_404(req, id)

          if not (req.context.is_admin
                  or image['owner'] == None
                  or image['owner'] == req.context.owner):
              raise HTTPForbidden('Unable to delete image you do not own')

          if image['protected']:
              raise HTTPForbidden('Image is protected')

          if image['location']:
              schedule_delete_from_backend(image['location'], self.conf,
                                           req.context, id)
          registry.delete_image_metadata(req.context, id)
  ```
