# Rank 964 / CVE-2024-31457: gin-vue-admin accepted a request plugin name
# containing path separators, then used it as the generated plugin filesystem
# component. The fix rejects filepath.Separator before CreatePlug.

test "rank964: request plugin name reaches plugin code generation without separator guard"
  lang go
  profile api
  file server/api/v1/system/sys_auto_code.go
  expect VYQL-PATH-054
  expect_review code.RequestPluginNamePathTraversal
  code
  ```
  package system

  import "strings"

  type Context struct{}

  func (c *Context) ShouldBindJSON(v any) error { return nil }

  type AutoPlugReq struct {
    PlugName string
    Snake string
  }

  type AutoCodeService struct{}

  func (s AutoCodeService) CreatePlug(a AutoPlugReq) error { return nil }

  var autoCodeService AutoCodeService

  type AutoCodeApi struct{}

  func (autoApi *AutoCodeApi) AutoPlug(c *Context) {
    var a AutoPlugReq
    if err := c.ShouldBindJSON(&a); err != nil {
      return
    }
    a.Snake = strings.ToLower(a.PlugName)
    _ = autoCodeService.CreatePlug(a)
  }
  ```

test "rank964: request plugin name rejects path separator before plugin generation"
  lang go
  profile api
  file server/api/v1/system/sys_auto_code.go
  reject VYQL-PATH-054
  reject_review code.RequestPluginNamePathTraversal
  code
  ```
  package system

  import (
    "path/filepath"
    "strings"
  )

  type Context struct{}

  func (c *Context) ShouldBindJSON(v any) error { return nil }

  type AutoPlugReq struct {
    PlugName string
    Snake string
  }

  type AutoCodeService struct{}

  func (s AutoCodeService) CreatePlug(a AutoPlugReq) error { return nil }

  var autoCodeService AutoCodeService

  type AutoCodeApi struct{}

  func (autoApi *AutoCodeApi) AutoPlug(c *Context) {
    var a AutoPlugReq
    if err := c.ShouldBindJSON(&a); err != nil {
      return
    }
    if strings.Contains(a.PlugName, string(filepath.Separator)) {
      return
    }
    a.Snake = strings.ToLower(a.PlugName)
    _ = autoCodeService.CreatePlug(a)
  }
  ```
