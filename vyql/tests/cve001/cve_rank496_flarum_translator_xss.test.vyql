# Rank 496 / CVE-2021-32671: Flarum translator rich rendering
# converted raw string parameters into HTML DOM nodes.

test "rank496: Flarum translator returns raw rich-rendered string parameters"
  lang javascript
  file Translator.ts
  expect VYQL-INJ-111
  expect_review code.FlarumTranslatorRawStringParameterXss
  code
  ```
  import username from './helpers/username';
  import extract from './utils/extract';

  type TranslatorParameters = Record<string, unknown>;

  export default class Translator {
    protected preprocessParameters(parameters: TranslatorParameters) {
      if ('user' in parameters) {
        const user = extract(parameters, 'user');

        if (!parameters.username) parameters.username = username(user);
      }
      return parameters;
    }
  }
  ```

test "rank496: Flarum translator wraps string parameters as text nodes"
  lang javascript
  file Translator.tsx
  reject VYQL-INJ-111
  reject_review code.FlarumTranslatorRawStringParameterXss
  code
  ```
  import username from './helpers/username';
  import extract from './utils/extract';

  type TranslatorParameters = Record<string, unknown>;

  export default class Translator {
    protected preprocessParameters(parameters: TranslatorParameters) {
      if ('user' in parameters) {
        const user = extract(parameters, 'user');

        if (!parameters.username) parameters.username = username(user);
      }

      const escapedParameters: TranslatorParameters = {};

      for (const param in parameters) {
        const paramValue = parameters[param];

        if (typeof paramValue === 'string') escapedParameters[param] = <>{parameters[param]}</>;
        else escapedParameters[param] = parameters[param];
      }

      return escapedParameters;
    }
  }
  ```
