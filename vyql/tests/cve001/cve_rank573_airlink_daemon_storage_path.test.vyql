# Rank 573 / CVE-2025-57802: Airlink daemon upload/create/append path traversal.
# Ledger verification: VYQL-PATH-001 catches relativePath reaching file writes.

test "rank573: Airlink daemon joins request path into storage file"
  lang javascript
  file storage.ts
  expect VYQL-PATH-001
  code
  ```
  import path from "path";
  import fs from "fs";

  export function append(req) {
    const relativePath = req.body.path;
    const target = path.join("/srv/storage", relativePath);
    fs.writeFileSync(target, req.body.data);
  }
  ```

test "rank573: Airlink daemon basename-normalizes storage path"
  lang javascript
  file storage.ts
  reject VYQL-PATH-001
  code
  ```
  import path from "path";
  import fs from "fs";

  export function append(req) {
    const relativePath = path.basename(req.body.path);
    const target = path.join("/srv/storage", relativePath);
    fs.writeFileSync(target, req.body.data);
  }
  ```
