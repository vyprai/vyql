test "rank529: Homarus formats request data into ffmpeg command string"
  lang php
  file HomarusController.php
  expect VYQL-INJ-119
  expect_review code.CommandStringWrapperExecution
  code
  ```
  <?php
  namespace App\Islandora\Homarus\Controller;

  use Islandora\Crayfish\Commons\CmdExecuteService;
  use Symfony\Component\HttpFoundation\Request;
  use Symfony\Component\HttpFoundation\Response;

  class HomarusController
  {
      private $cmd;
      private $executable;
      private $tempDirectory;

      public function convert(Request $request)
      {
          if (!$request->headers->has("Apix-Ldp-Resource")) {
              return new Response("bad", 400);
          } else {
              $source = $request->headers->get('Apix-Ldp-Resource');
          }

          $content_type = 'video/mp4';
          $format = 'mp4';
          $cmd_params = " -vcodec libx264 -preset medium -acodec aac ";
          $temp_file_path = $this->tempDirectory . basename(parse_url($source, PHP_URL_PATH)) . "." . $format;
          $args = $request->headers->get('X-Islandora-Args');
          if (!is_null($args) && strpos($args, '-loglevel') !== false) {
              return new Response("bad", 400);
          }
          $args .= ' -loglevel error';
          $token = $request->headers->get('Authorization');
          $headers = "'Authorization:  $token'";
          $cmd_string = "$this->executable -headers $headers -i $source  $args $cmd_params -f $format $temp_file_path";
          return $this->generateDerivativeResponse($cmd_string, $source, $temp_file_path, $content_type);
      }

      public function generateDerivativeResponse(
          string $cmd_string,
          string $source,
          string $path,
          string $content_type
      ) {
          $this->cmd->execute($cmd_string, $source);
      }
  }
  ```

test "rank529: Homarus passes argv array and HeaderBag to command wrapper"
  lang php
  file HomarusController.php
  reject VYQL-INJ-119
  reject_review code.CommandStringWrapperExecution
  code
  ```
  <?php
  namespace App\Islandora\Homarus\Controller;

  use Islandora\Crayfish\Commons\CmdExecuteService;
  use Symfony\Component\HttpFoundation\HeaderBag;
  use Symfony\Component\HttpFoundation\Request;
  use Symfony\Component\HttpFoundation\Response;

  class HomarusController
  {
      private $cmd;
      private $executable;
      private $tempDirectory;

      public function convert(Request $request)
      {
          if (!$request->headers->has("Apix-Ldp-Resource")) {
              return new Response("bad", 400);
          } else {
              $source = $request->headers->get('Apix-Ldp-Resource');
          }

          $content_type = 'video/mp4';
          $format = 'mp4';
          $cmd_params = ['-vcodec', 'libx264', '-preset', 'medium'];
          $temp_file_path = $this->tempDirectory . basename(parse_url($source, PHP_URL_PATH)) . "." . $format;
          $args = $request->headers->get('X-Islandora-Args');
          if (!is_null($args) && strpos($args, '-loglevel') !== false) {
              return new Response("bad", 400);
          }
          $args .= ' -loglevel error';
          $arg_array = array_filter(explode(' ', $args));

          $header_bag = new HeaderBag();
          if ($token = $request->headers->get('Authorization')) {
              $header_bag->set('Authorization', $token);
          }

          $cmd = array_merge(
              [
                $this->executable,
                '-headers', $header_bag,
                '-i', $source,
              ],
              $arg_array,
              $cmd_params,
              [
                  '-f', $format,
                  $temp_file_path,
              ],
          );
          return $this->generateDerivativeResponse($cmd, $source, $temp_file_path, $content_type);
      }

      public function generateDerivativeResponse(
          array $cmd,
          string $source,
          string $path,
          string $content_type
      ) {
          $this->cmd->execute($cmd, $source);
      }
  }
  ```
