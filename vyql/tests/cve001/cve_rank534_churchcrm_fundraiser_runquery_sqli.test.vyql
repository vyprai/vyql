# Rank 534 / CVE-2026-39319: ChurchCRM FundRaiserEditor built a raw
# donated-item SQL query with the request-derived fundraiser id before calling
# RunQuery. The fix moved to Propel ORM filtering/casting.

test "rank534: ChurchCRM FundRaiserEditor concatenates fundraiser id into RunQuery SQL"
  lang php
  file FundRaiserEditor.php
  expect VYQL-INJ-001
  code
  ```
  <?php

  use ChurchCRM\Utils\InputUtils;

  $iFundRaiserID = InputUtils::legacyFilterInputArr($_GET, 'FundRaiserID', 'int');

  if ($iFundRaiserID > 0) {
      $sSQL = "SELECT di_ID, di_Item
        FROM donateditem_di
        WHERE di_FR_ID = '" . $iFundRaiserID . "' ORDER BY di_multibuy";
      $rsDonatedItems = RunQuery($sSQL);
  }
  ```

test "rank534: ChurchCRM FundRaiserEditor uses ORM filter for fundraiser id"
  lang php
  file FundRaiserEditor.php
  reject VYQL-INJ-001
  code
  ```
  <?php

  use ChurchCRM\Utils\InputUtils;
  use ChurchCRM\model\ChurchCRM\DonatedItemQuery;

  $iFundRaiserID = InputUtils::legacyFilterInputArr($_GET, 'FundRaiserID', 'int');

  if ($iFundRaiserID > 0) {
      $donatedItems = DonatedItemQuery::create()
          ->filterByFrId((int) $iFundRaiserID)
          ->addAscendingOrderByColumn('di_multibuy')
          ->find();
  }
  ```
