# Rank 984 / CVE-2026-30930: Glances TimescaleDB export built SQL strings from
# process names and other runtime metric values instead of using psycopg binding.

test "rank984: timescaledb export builds insert sql from values list"
  lang python
  file glances/exports/glances_timescaledb/__init__.py
  expect VYQL-INJ-194
  expect_review code.UnparameterizedSqlExportStringBuilder
  code
  ```
  class Export(object):
      def export(self, plugin, creation_list, segmented_by, values_list):
          with self.client.cursor() as cur:
              cur.execute(f"select exists(select * from information_schema.tables where table_name='{plugin}')")
              if not cur.fetchone()[0]:
                  create_query = f"""
  CREATE TABLE {plugin} (
      {', '.join(creation_list)}
  )
  WITH (
      timescaledb.hypertable,
      timescaledb.partition_column='time',
      timescaledb.segmentby = '{", ".join(segmented_by)}'
  );"""
                  cur.execute(create_query)

              insert_list = [f"({','.join(i)})" for i in values_list]
              insert_query = f"INSERT INTO {plugin} VALUES {','.join(insert_list)};"
              cur.execute(insert_query)
  ```

test "rank984: timescaledb export uses identifiers and placeholders"
  lang python
  file glances/exports/glances_timescaledb/__init__.py
  reject VYQL-INJ-194
  reject_review code.UnparameterizedSqlExportStringBuilder
  code
  ```
  from psycopg import sql

  class Export(object):
      def export(self, plugin, creation_list, segmented_by, values_list):
          with self.client.cursor() as cur:
              cur.execute(
                  "SELECT EXISTS(SELECT * FROM information_schema.tables WHERE table_name=%s)",
                  [plugin],
              )
              if not cur.fetchone()[0]:
                  fields = sql.SQL(', ').join(
                      sql.SQL("{} {}").format(
                          sql.Identifier(item.split(' ')[0]),
                          sql.SQL(' '.join(item.split(' ')[1:]))
                      )
                      for item in creation_list
                  )
                  create_query = sql.SQL("CREATE TABLE {table} ({fields})").format(
                      table=sql.Identifier(plugin),
                      fields=fields,
                  )
                  cur.execute(create_query)

              col_names = [item.split(' ')[0] for item in creation_list]
              cols = sql.SQL(', ').join(sql.Identifier(c) for c in col_names)
              placeholders = sql.SQL(', ').join(sql.Placeholder() for _ in col_names)
              insert_query = sql.SQL("INSERT INTO {table} ({cols}) VALUES ({vals})").format(
                  table=sql.Identifier(plugin),
                  cols=cols,
                  vals=placeholders,
              )
              cur.executemany(insert_query, values_list)
  ```
