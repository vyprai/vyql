test "rank890: Forceworkbench footer scripts come from request bag"
  lang php
  expect VYQL-INJ-177
  expect_review code.RequestBackedFooterScriptXss
  code
  ```
  <?php
  function addFooterScript($script) {
      $scriptHash = md5($script);
      $_REQUEST["footerScripts"][$scriptHash] = $script;
  }

  if (isset($_REQUEST["footerScripts"])) {
      foreach ($_REQUEST["footerScripts"] as $script) {
          print $script . "\n";
      }
  }
  ?>
  ```

test "rank890: Forceworkbench footer scripts use server-owned globals"
  lang php
  reject VYQL-INJ-177
  reject_review code.RequestBackedFooterScriptXss
  code
  ```
  <?php
  function addFooterScript($script) {
      if (!isset($GLOBALS["footerScripts"])) {
          $GLOBALS["footerScripts"] = array();
      }
      $scriptHash = md5($script);
      $GLOBALS["footerScripts"][$scriptHash] = $script;
  }

  if (isset($GLOBALS["footerScripts"])) {
      foreach ($GLOBALS["footerScripts"] as $script) {
          print $script . "\n";
      }
  }
  ?>
  ```
