test "rank334: Jenkins CAS login redirects to session URL without safe redirect check"
  lang java
  expect VYQL-RF-013
  expect_review code.SessionStoredRedirectTarget
  code
  ```
  import javax.servlet.http.HttpServletRequest;
  import javax.servlet.http.HttpServletResponse;
  import javax.servlet.http.HttpSession;
  import org.springframework.security.web.authentication.SimpleUrlAuthenticationSuccessHandler;

  class SessionUrlAuthenticationSuccessHandler extends SimpleUrlAuthenticationSuccessHandler {
      private String targetUrlSessionAttribute = "spring-security-redirect";

      protected String determineTargetUrl(HttpServletRequest request, HttpServletResponse response) {
          String targetUrl = null;
          HttpSession session = request.getSession(false);
          if (session != null && targetUrlSessionAttribute != null) {
              targetUrl = (String) session.getAttribute(targetUrlSessionAttribute);
              session.removeAttribute(targetUrlSessionAttribute);
          }
          if (targetUrl.startsWith(request.getContextPath())) {
              return targetUrl.substring(request.getContextPath().length());
          }
          return targetUrl;
      }
  }
  ```

test "rank334: Jenkins CAS login rejects unsafe session redirect URLs"
  lang java
  reject VYQL-RF-013
  reject_review code.SessionStoredRedirectTarget
  code
  ```
  import javax.servlet.http.HttpServletRequest;
  import javax.servlet.http.HttpServletResponse;
  import javax.servlet.http.HttpSession;
  import org.springframework.security.web.authentication.SimpleUrlAuthenticationSuccessHandler;
  import hudson.Util;

  class SessionUrlAuthenticationSuccessHandler extends SimpleUrlAuthenticationSuccessHandler {
      private String targetUrlSessionAttribute = "spring-security-redirect";

      protected String determineTargetUrl(HttpServletRequest request, HttpServletResponse response) {
          String targetUrl = null;
          HttpSession session = request.getSession(false);
          if (session != null && targetUrlSessionAttribute != null) {
              targetUrl = (String) session.getAttribute(targetUrlSessionAttribute);
              session.removeAttribute(targetUrlSessionAttribute);
          }
          if (targetUrl.startsWith(request.getContextPath())) {
              targetUrl = targetUrl.substring(request.getContextPath().length());
          }
          if (!Util.isSafeToRedirectTo(targetUrl)) {
              targetUrl = getDefaultTargetUrl();
          }
          return targetUrl;
      }
  }
  ```
