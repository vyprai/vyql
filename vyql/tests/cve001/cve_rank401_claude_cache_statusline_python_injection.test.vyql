# Rank 401 / CVE-2026-45136: claude-code-cache-fix interpolated Claude
# Code statusline hook JSON into a Python triple-quoted literal. A ''' sequence
# in a reflected path field could close the literal and execute Python.

test "rank401: statusline hook input interpolated into python triple-quoted source"
  lang bash
  expect VYQL-INJ-071
  expect_review code.PythonTripleQuoteShellInterpolation
  code
  ```
  #!/bin/bash
  input=$(cat)

  result=$(python3 -c "
  import json
  stdin_data = json.loads('''$input''') if '''$input''' else {}
  ")

  [ -n "$result" ] && echo "$result"
  ```

test "rank401: statusline hook input passed through env and quoted heredoc"
  lang bash
  reject VYQL-INJ-071
  reject_review code.PythonTripleQuoteShellInterpolation
  code
  ```
  #!/bin/bash
  CC_INPUT=$(cat)
  export CC_INPUT

  result=$(python3 <<'PYEOF' 2>/dev/null
  import json, os
  stdin_data = json.loads(os.environ.get('CC_INPUT') or '{}')
  PYEOF
  )

  [ -n "$result" ] && echo "$result"
  ```
