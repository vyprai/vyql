# verify_current_expected: skip-fresh-target
# The fresh rank 57 checkout is already patched with URL/IP validation before
# favicon fetches; this synthetic CVE spec keeps the real SSRF mechanic covered.

test "rank57: favicon extractor fetches caller-controlled URL"
  lang csharp
  expect VYQL-RF-001
  code
  ```
  class FaviconExtractor {
    byte[] Extract(HttpRequest Request, WebClient client) {
      var candidate = Request.Query["url"];
      return client.DownloadData(candidate);
    }
  }
  ```

test "rank57: favicon extractor constant URL is clean"
  lang csharp
  reject VYQL-RF-001
  code
  ```
  class FaviconExtractor {
    byte[] Extract(HttpRequest Request, WebClient client) {
      return client.DownloadData("https://example.com/favicon.ico");
    }
  }
  ```
