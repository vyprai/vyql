# Rank 721 / CVE-2026-40489: editorconfig-core-c glob pattern unbounded copy.
# Fresh scan evidence includes VYQL-MEM-002 at src/lib/ec_glob.c strcpy.

test "rank721: editorconfig copies glob pattern with strcpy"
  lang c
  expect VYQL-MEM-002
  code
  ```
  void parse(char *pattern) {
      char l_pattern[256];
      strcpy(l_pattern, pattern);
  }
  ```

test "rank721: editorconfig copies glob pattern with bounded memcpy"
  lang c
  reject VYQL-MEM-002
  code
  ```
  void parse(char *pattern) {
      char l_pattern[256];
      unsigned long pattern_len = strlen(pattern);
      if (pattern_len >= sizeof(l_pattern)) {
          return;
      }
      memcpy(l_pattern, pattern, pattern_len + 1);
  }
  ```
