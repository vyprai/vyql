test "rank727: MFA secret falls back to request parameter"
  lang php
  file LoginController.php
  expect VYQL-AUTH-047
  expect_review code.RequestControlledMfaSecretBypass
  code
  ```
  <?php
  final class LoginController {
    private $Session;
    private $Request;

    private function getAuthService() {
      switch ($this->Request->request->get('auth_type')) {
        case AuthType::Mfa:
          return new Mfa(
            new MfaHelper($this->Session->get('mfa_secret') ?? $this->Request->request->get('mfa_secret')),
            $this->Session->get('auth_userid'),
            $this->Request->request->getAlnum('mfa_code'),
          );
      }
    }
  }
  ```

