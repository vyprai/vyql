# Rank 643 / CVE-2017-16764: django-make-app read project YAML with
# yaml.load before switching to a safe loader.

test "rank643: django-make-app read_yaml_file uses unsafe yaml.load"
  lang python
  profile library
  file django_make_app/io_utils.py
  expect VYQL-DESER-001
  code
  ```
  import io
  import yaml

  def read_yaml_file(filename):
      with io.open(filename, mode='r', encoding='utf-8') as the_file:
          return yaml.load(the_file)
  ```

test "rank643: django-make-app read_yaml_file uses safe_load"
  lang python
  profile library
  file django_make_app/io_utils.py
  reject VYQL-DESER-001
  code
  ```
  import io
  import yaml

  def read_yaml_file(filename):
      with io.open(filename, mode='r', encoding='utf-8') as the_file:
          return yaml.safe_load(the_file)
  ```

