# Rank 802 / CVE-2026-22822: external-secrets exposed a template helper that
# fetched arbitrary Kubernetes Secret keys through the controller's in-cluster
# client and made that helper available in text/template FuncMap.

test "rank802: Kubernetes template helper can read arbitrary Secret keys"
  lang go
  expect VYQL-SEC-027
  expect_review code.KubernetesTemplateSecretLookupExposure
  code
  ```
  package template

  import (
      "context"
      "fmt"
      tpl "text/template"

      "k8s.io/client-go/kubernetes"
      ctrlcfg "sigs.k8s.io/controller-runtime/pkg/client/config"
      metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
  )

  var tplFuncs = tpl.FuncMap{
      "getSecretKey": getSecretKey,
      "rsaDecrypt": rsaDecrypt,
  }

  func rsaDecrypt() {}

  func getSecretKey(secretName, namespace, keyName string) (string, error) {
      restCfg, err := ctrlcfg.GetConfig()
      if err != nil {
          return "", err
      }
      clientset, err := kubernetes.NewForConfig(restCfg)
      if err != nil {
          return "", err
      }
      secret, err := clientset.CoreV1().Secrets(namespace).Get(context.Background(), secretName, metav1.GetOptions{})
      if err != nil {
          return "", err
      }
      val, ok := secret.Data[keyName]
      if !ok {
          return "", fmt.Errorf("key %s not found", keyName)
      }
      return string(val), nil
  }
  ```

test "rank802: template function map without Kubernetes Secret lookup is clean"
  lang go
  reject VYQL-SEC-027
  reject_review code.KubernetesTemplateSecretLookupExposure
  code
  ```
  package template

  import tpl "text/template"

  var tplFuncs = tpl.FuncMap{
      "rsaDecrypt": rsaDecrypt,
  }

  func rsaDecrypt() {}
  ```
