test "rank825: Rails secret token is hardcoded for runtime"
  lang ruby
  expect VYQL-SEC-002
  code
  ```
  if defined?(FatFreeCRM::Application)
    FatFreeCRM::Application.config.secret_token = '51aa366864a80316a85cff0d3762347f4ae3d029d548bef034d56e82b1a2ffac5353ee6719d9b64e4354e2a0b1a901679f46a851c360a2ea377188e4b196b6b6'
  end
  ```

test "rank825: Rails secret token is test-only"
  lang ruby
  reject VYQL-SEC-002
  code
  ```
  if defined?(FatFreeCRM::Application)
    if Rails.env == 'test'
      FatFreeCRM::Application.config.secret_token = '51aa366864a80316a85cff0d3762347f4ae3d029d548bef034d56e82b1a2ffac5353ee6719d9b64e4354e2a0b1a901679f46a851c360a2ea377188e4b196b6b6'
    else
      raise "Please run 'rake ffcrm:secret' to generate a secret token."
    end
  end
  ```

test "rank825: Rails secret token comes from environment"
  lang ruby
  reject VYQL-SEC-002
  code
  ```
  if defined?(FatFreeCRM::Application)
    FatFreeCRM::Application.config.secret_token = ENV.fetch('SECRET_TOKEN')
  end
  ```

test "rank825: Rails secret token is generated dynamically"
  lang ruby
  reject VYQL-SEC-002
  code
  ```
  if defined?(FatFreeCRM::Application)
    require 'securerandom'
    FatFreeCRM::Application.config.secret_token = SecureRandom.hex(64)
  end
  ```
