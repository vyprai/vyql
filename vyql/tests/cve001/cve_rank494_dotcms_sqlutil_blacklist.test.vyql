# Rank 494 / CVE-2016-10007: dotCMS relied on SQL keyword blacklist
# sanitization for request-controlled admin SQL fragments.

test "rank494: dotCMS SQLUtil single blacklist sanitizer is bypass-prone"
  lang java
  file SQLUtil.java
  expect VYQL-INJ-109
  expect_review code.DotcmsSqlUtilBlacklistBypass
  code
  ```
  import com.dotcms.repackage.org.apache.commons.lang.StringEscapeUtils;
  import com.liferay.util.StringPool;

  public class SQLUtil {
      private static final java.util.Set<String> EVIL_SQL_WORDS =
          java.util.Set.of("select", "and", "or", "order", "--", ";");

      public static String sanitizeParameter(String parameter) {
          if (parameter == null || parameter.isEmpty()) {
              return StringPool.BLANK;
          }
          parameter = StringEscapeUtils.escapeSql(parameter);
          final String parameterLowercase = parameter.toLowerCase();
          for (String evilWord : EVIL_SQL_WORDS) {
              final int index = parameterLowercase.indexOf(evilWord);
              if (index != -1 &&
                  ((index == 0 || !isValidSQLCharacter(parameterLowercase.charAt(index - 1))) &&
                   (index + evilWord.length() == parameterLowercase.length() ||
                    !isValidSQLCharacter(parameterLowercase.charAt(index + evilWord.length()))))) {
                  return StringPool.BLANK;
              }
          }
          return parameter;
      }

      private static boolean isValidSQLCharacter(final char c) {
          return Character.isLetterOrDigit(c) || '-' == c || '_' == c;
      }
  }
  ```

test "rank494: dotCMS SQLUtil split sanitizer delegates to context-specific word sets"
  lang java
  file SQLUtil.java
  reject VYQL-INJ-109
  reject_review code.DotcmsSqlUtilBlacklistBypass
  code
  ```
  import com.dotcms.repackage.org.apache.commons.lang.StringEscapeUtils;
  import com.liferay.util.StringPool;

  public class SQLUtil {
      private static final java.util.Set<String> EVIL_SQL_CONDITION_WORDS =
          java.util.Set.of("insert", "delete", "drop", "--", ";");
      private static final java.util.Set<String> EVIL_SQL_PARAMETER_WORDS =
          java.util.Set.of("select", "and", "or", "order");
      private static final java.util.Set<String> EVIL_SQL_WORDS =
          java.util.Set.of("select", "and", "or", "order", "insert", "delete", "drop", "--", ";");

      public static String sanitizeParameter(String parameter) {
          return sanitizeSQL(parameter, EVIL_SQL_WORDS);
      }

      public static String sanitizeCondition(String condition) {
          return sanitizeSQL(condition, EVIL_SQL_CONDITION_WORDS);
      }

      private static String sanitizeSQL(String parameter, java.util.Set<String> evilWords) {
          if (parameter == null || parameter.isEmpty()) {
              return StringPool.BLANK;
          }
          parameter = StringEscapeUtils.escapeSql(parameter);
          final String parameterLowercase = parameter.toLowerCase();
          for (String evilWord : evilWords) {
              final int index = parameterLowercase.indexOf(evilWord);
              if (index != -1 &&
                  ((index == 0 || !isValidSQLCharacter(parameterLowercase.charAt(index - 1))) &&
                   (index + evilWord.length() == parameterLowercase.length() ||
                    !isValidSQLCharacter(parameterLowercase.charAt(index + evilWord.length()))))) {
                  return StringPool.BLANK;
              }
          }
          return parameter;
      }

      private static boolean isValidSQLCharacter(final char c) {
          return Character.isLetterOrDigit(c) || '-' == c || '_' == c;
      }
  }
  ```

test "rank494: dotCMS Forms orderBy request parameter reaches structure SQL lookup"
  lang java
  file ViewFormHandlerAction.java
  expect VYQL-INJ-110
  expect_review code.DotcmsFormsOrderBySqlInjection
  code
  ```
  import java.util.List;

  class ViewFormHandlerAction {
      protected void _loadStructures(RenderRequest req, User user, String countWebKey,
                                     String viewWebKey, String queryWebKey) throws Exception {
          List<Structure> structures = new java.util.ArrayList<Structure>();
          String queryCondition = "structuretype=1";
          String orderby = req.getParameter("orderBy");
          if (!UtilMethods.isSet(orderby)) {
              orderby = "upper(name)";
          }
          String direction = req.getParameter("direction");
          if (!UtilMethods.isSet(direction)) {
              direction = "asc";
          }
          int limit = Config.getIntProperty("PER_PAGE");
          int offset = 0;
          structures = StructureFactory.getStructuresByUser(user, queryCondition, orderby, limit, offset, direction);
      }
  }
  ```

test "rank494: dotCMS Forms orderBy is sanitized before structure SQL lookup"
  lang java
  file ViewFormHandlerAction.java
  reject VYQL-INJ-110
  reject_review code.DotcmsFormsOrderBySqlInjection
  code
  ```
  import java.util.List;

  class ViewFormHandlerAction {
      protected void _loadStructures(RenderRequest req, User user, String countWebKey,
                                     String viewWebKey, String queryWebKey) throws Exception {
          List<Structure> structures = new java.util.ArrayList<Structure>();
          String queryCondition = "structuretype=1";
          String orderby = req.getParameter("orderBy");
          if (!UtilMethods.isSet(orderby)) {
              orderby = "mod_date";
          } else {
              orderby = SQLUtil.sanitizeSortBy(orderby);
          }
          String direction = req.getParameter("direction");
          if (!UtilMethods.isSet(direction) || "desc".equalsIgnoreCase(direction)) {
              direction = "desc";
          } else {
              direction = "asc";
          }
          int limit = Config.getIntProperty("PER_PAGE");
          int offset = 0;
          structures = StructureFactory.getStructuresByUser(user, queryCondition, orderby, limit, offset, direction);
      }
  }
  ```
