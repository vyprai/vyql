# Rank 458 / CVE-2024-35241: Composer formatted Git branch names into
# a git diff command string in getUnpushedChanges(). The fix passes an argv
# array to ProcessExecutor so malicious branch names remain one argument.

test "rank458: Composer git branch names reach git diff shell command string"
  lang php
  expect VYQL-INJ-096
  expect_review code.ComposerGitBranchDiffCommandInjection
  code
  ```
  <?php
  class GitDownloader
  {
      public function getUnpushedChanges($package, string $path): ?string
      {
          $refs = '';
          Preg::isMatchAllStrictGroups('{^'.$headRef.' refs/heads/(.+)$}mi', $refs, $matches);
          $candidateBranches = $matches[1];
          $branch = $candidateBranches[0];
          foreach ($candidateBranches as $candidate) {
              if (Preg::isMatchAllStrictGroups('{^[a-f0-9]+ refs/remotes/((?:[^/]+)/'.preg_quote($candidate).')$}mi', $refs, $matches)) {
                  foreach ($matches[1] as $match) {
                      $branch = $candidate;
                      $remoteBranches[] = $match;
                  }
              }
          }
          foreach ($remoteBranches as $remoteBranch) {
              $command = sprintf('git diff --name-status %s...%s --', $remoteBranch, $branch);
              $this->process->execute($command, $output, $path);
          }
          return null;
      }
  }
  ```

test "rank458: Composer git diff uses argv array for branch names"
  lang php
  reject VYQL-INJ-096
  reject_review code.ComposerGitBranchDiffCommandInjection
  code
  ```
  <?php
  class GitDownloader
  {
      public function getUnpushedChanges($package, string $path): ?string
      {
          $refs = '';
          Preg::isMatchAllStrictGroups('{^'.$headRef.' refs/heads/(.+)$}mi', $refs, $matches);
          $candidateBranches = $matches[1];
          $branch = $candidateBranches[0];
          foreach ($candidateBranches as $candidate) {
              if (Preg::isMatchAllStrictGroups('{^[a-f0-9]+ refs/remotes/((?:[^/]+)/'.preg_quote($candidate).')$}mi', $refs, $matches)) {
                  foreach ($matches[1] as $match) {
                      $branch = $candidate;
                      $remoteBranches[] = $match;
                  }
              }
          }
          foreach ($remoteBranches as $remoteBranch) {
              $command = ['git', 'diff', '--name-status', $remoteBranch.'...'.$branch, '--'];
              $this->process->execute($command, $output, $path);
          }
          return null;
      }
  }
  ```
