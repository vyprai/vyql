test "rank229: BrOn parser validates type immediates but not popped ref operands"
  lang cpp
  expect VYQL-DOS-040
  expect_review code.ReachableAssertionReview
  code
  ```
  Result<> IRBuilder::makeBrOn(Index label,
                               BrOnOp op,
                               Type in,
                               Type out,
                               const CodeAnnotation& annotations) {
    std::optional<HeapType> descriptor;
    if (op == BrOnCastDescEq || op == BrOnCastDescEqFail) {
      assert(out.isRef());
      descriptor = out.getHeapType().getDescriptorType();
      if (!descriptor) {
        return Err{"cast target must have descriptor"};
      }
    }

    BrOn curr;
    curr.op = op;
    curr.castType = out;
    curr.desc = nullptr;
    if (op != BrOnNull && op != BrOnNonNull && !out.isCastable()) {
      return Err{"br_on cannot cast to invalid type"};
    }
    CHECK_ERR(visitBrOn(&curr));

    switch (op) {
      case BrOnNull:
      case BrOnNonNull:
        break;
      case BrOnCastDescEq:
      case BrOnCastDescEqFail: {
        CHECK_ERR(validateTypeAnnotation(out.with(*descriptor).with(Nullable),
                                         curr.desc));
      }
        [[fallthrough]];
      case BrOnCast:
      case BrOnCastFail:
        assert(in.isRef());
        CHECK_ERR(validateTypeAnnotation(in, curr.ref));
    }
    return Ok{};
  }
  ```

test "rank229: BrOn parser rejects non-ref popped operands before finalize"
  lang cpp
  reject VYQL-DOS-040
  reject_review code.ReachableAssertionReview
  code
  ```
  Result<> IRBuilder::makeBrOn(Index label,
                               BrOnOp op,
                               Type in,
                               Type out,
                               const CodeAnnotation& annotations) {
    std::optional<HeapType> descriptor;
    if (op == BrOnCastDescEq || op == BrOnCastDescEqFail) {
      assert(out.isRef());
      descriptor = out.getHeapType().getDescriptorType();
      if (!descriptor) {
        return Err{"cast target must have descriptor"};
      }
    }

    BrOn curr;
    curr.op = op;
    curr.castType = out;
    curr.desc = nullptr;
    if (op != BrOnNull && op != BrOnNonNull && !out.isCastable()) {
      return Err{"br_on cannot cast to invalid type"};
    }
    CHECK_ERR(visitBrOn(&curr));

    if (curr.ref->type != Type::unreachable && !curr.ref->type.isRef()) {
      return Err{"br_on* ref must be a ref"};
    }
    if (curr.desc && curr.desc->type != Type::unreachable &&
        !curr.desc->type.isRef()) {
      return Err{"br_on_cast_desc* must be a ref"};
    }

    switch (op) {
      case BrOnNull:
      case BrOnNonNull:
        break;
      case BrOnCastDescEq:
      case BrOnCastDescEqFail: {
        CHECK_ERR(validateTypeAnnotation(out.with(*descriptor).with(Nullable),
                                         curr.desc));
      }
        [[fallthrough]];
      case BrOnCast:
      case BrOnCastFail:
        assert(in.isRef());
        CHECK_ERR(validateTypeAnnotation(in, curr.ref));
    }
    return Ok{};
  }
  ```
