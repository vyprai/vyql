test "rank663: dojox jqMix recursively copies for-in keys without prototype guard"
  lang javascript
  expect VYQL-INJ-106
  code
  ```
  function jqMix(obj, props){
    if(obj == props){
      return obj;
    }
    var tobj = {};
    for(var x in props){
      if((tobj[x] === undefined || tobj[x] != props[x]) && props[x] !== undefined && obj != props[x]){
        if(dojo.isObject(obj[x]) && dojo.isObject(props[x])){
          if(dojo.isArray(props[x])){
            obj[x] = props[x];
          }else{
            obj[x] = jqMix(obj[x], props[x]);
          }
        }else{
          obj[x] = props[x];
        }
      }
    }
    return obj;
  }
  ```

test "rank663: dojox jqMix skips prototype-mutating keys"
  lang javascript
  reject VYQL-INJ-106
  code
  ```
  function jqMix(obj, props){
    if(obj == props){
      return obj;
    }
    var tobj = {};
    for(var x in props){
      if(x !== '__proto__ ' && ((tobj[x] === undefined || tobj[x] != props[x])) && props[x] !== undefined && obj != props[x]){
        if(dojo.isObject(obj[x]) && dojo.isObject(props[x])){
          if(dojo.isArray(props[x])){
            obj[x] = props[x];
          }else{
            obj[x] = jqMix(obj[x], props[x]);
          }
        }else{
          obj[x] = props[x];
        }
      }
    }
    return obj;
  }
  ```
