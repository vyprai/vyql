test "rank90: OpenSSL private-key export without a mode restriction"
  lang php
  expect VYQL-SEC-055
  expect_review code.SecretFilePermissionReview
  code
  ```
  <?php
  class CertificateStore {
    public function exportPrivateKey($key, $storageDir) {
      $out = $storageDir . '/server.key';
      openssl_pkey_export_to_file($key, $out);
      return $out;
    }
  }
  ```

test "rank90: OpenSSL private-key export chmods the file it wrote"
  lang php
  reject VYQL-SEC-055
  reject_review code.SecretFilePermissionReview
  code
  ```
  <?php
  class CertificateStore {
    public function exportPrivateKey($key, $storageDir) {
      $out = $storageDir . '/server.key';
      openssl_pkey_export_to_file($key, $out);
      chmod($out, 0600);
      return $out;
    }
  }
  ```
