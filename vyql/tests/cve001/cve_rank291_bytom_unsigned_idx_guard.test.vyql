test "rank291: Bytom validates unsigned topic index before signed conversion"
lang go
expect VYQL-NUM-007
code
```
package discover

import "errors"

type Topic string

type topicRegister struct {
	Topics []Topic
	Idx    uint
}

func checkTopicRegister(data *topicRegister) error {
	if data.Idx < 0 || int(data.Idx) >= len(data.Topics) {
		return errors.New("topic index out of range")
	}
	return nil
}

func handleTopicRegister(regdata *topicRegister) {
	useTicket(regdata.Topics, int(regdata.Idx))
}

func useTicket(topics []Topic, idx int) {}
```

