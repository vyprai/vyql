# Rank 951 / CVE-2026-39922: GeoNode 4.4.5 pins geonode-importer
# to the SSRF-fixed release.

test "rank951: open geonode-importer range can select SSRF-vulnerable release"
  lang python
  file setup.cfg
  expect VYQL-SCA-008
  expect_review sbom.SsrfDependency
  code
  ```
  [options]
  install_requires =
      geonode-importer>=1.0.2
  ```

test "rank951: geonode-importer fixed release suppresses SSRF dependency finding"
  lang python
  file setup.cfg
  reject VYQL-SCA-008
  reject_review sbom.SsrfDependency
  code
  ```
  [options]
  install_requires =
      geonode-importer==1.1.4
  ```
