# Rank 934 / CVE-2026-25751: FUXA exposed stored daqstore credentials through
# the settings API while only redacting smtp.password.

test "rank934: settings API redacts smtp password but leaks daqstore credentials"
  lang javascript
  file index.js
  expect VYQL-SEC-032
  expect_review code.RuntimeSettingsNestedCredentialsExposure
  code
  ```
  function init(_server, _runtime) {
    apiApp.get('/api/settings', function (req, res) {
      if (runtime.settings) {
        let tosend = JSON.parse(JSON.stringify(runtime.settings));
        if (tosend.smtp) {
          delete tosend.smtp.password;
        }
        res.json(tosend);
      }
    });
    function mergeUserSettings(settings) {
      if (settings.daqstore) {
        runtime.settings.daqstore = settings.daqstore;
      }
    }
  }
  ```

test "rank934: settings API also redacts daqstore credentials"
  lang javascript
  file index.js
  reject VYQL-SEC-032
  reject_review code.RuntimeSettingsNestedCredentialsExposure
  code
  ```
  function init(_server, _runtime) {
    apiApp.get('/api/settings', function (req, res) {
      if (runtime.settings) {
        let tosend = JSON.parse(JSON.stringify(runtime.settings));
        if (tosend.smtp) {
          delete tosend.smtp.password;
        }
        if (tosend.daqstore?.credentials) {
          delete tosend.daqstore.credentials;
        }
        res.json(tosend);
      }
    });
    function mergeUserSettings(settings) {
      if (settings.daqstore) {
        runtime.settings.daqstore = settings.daqstore;
      }
    }
  }
  ```
