# Rank 536 / CVE-2026-39401: Cronicle accepted update_event fields from
# child job/plugin JSON output and later applied them to the persistent schedule.

test "rank536: cronicle child job output can request event update"
  lang javascript
  file job.js
  expect VYQL-AUTH-030
  expect_review code.JobOutputEventUpdateAuthorizationBypass
  code
  ```
  module.exports = {
    handleChildResponse: function(job, worker, data) {
      this.logDebug(10, "Got job update from child: " + job.pid, data);
      if (job.complete) {
        return;
      }

      ['progress', 'complete', 'code', 'description', 'perf', 'update_event', 'table', 'html'].forEach( function(key) {
        if (key in data) job[key] = data[key];
      } );
    },

    finishLocalJob: function(job) {
      if (job.update_event) {
        this.storage.listFindUpdate('global/schedule', { id: job.event }, job.update_event, function(err) {});
      }
    }
  };
  ```

test "rank536: cronicle strips update_event unless config explicitly allows it"
  lang javascript
  file job.js
  reject VYQL-AUTH-030
  reject_review code.JobOutputEventUpdateAuthorizationBypass
  code
  ```
  module.exports = {
    handleChildResponse: function(job, worker, data) {
      this.logDebug(10, "Got job update from child: " + job.pid, data);
      if (job.complete) {
        return;
      }

      if (data.update_event && !this.server.config.get('allow_event_updates_from_jobs')) {
        delete data.update_event;
      }

      ['progress', 'complete', 'code', 'description', 'perf', 'update_event', 'table', 'html'].forEach( function(key) {
        if (key in data) job[key] = data[key];
      } );
    },

    finishLocalJob: function(job) {
      if (job.update_event) {
        this.storage.listFindUpdate('global/schedule', { id: job.event }, job.update_event, function(err) {});
      }
    }
  };
  ```
