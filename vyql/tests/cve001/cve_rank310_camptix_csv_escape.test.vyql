test "cve rank310 camptix: unescaped attendee CSV row is formula injection"
  lang php
  expect VYQL-INJ-014
  code
  ```
  <?php
  class CampTix_Plugin {
      public function generate_attendee_report($report) {
          $clean_line = array($_GET["attendee"]);
          fputcsv($report, $clean_line);
      }
  }
  ?>
  ```

test "cve rank310 camptix: esc_csv neutralizes attendee CSV row"
  lang php
  reject VYQL-INJ-014
  code
  ```
  <?php
  class CampTix_Plugin {
      public static function esc_csv($fields) {
          return $fields;
      }

      public function generate_attendee_report($report) {
          $clean_line = array($_GET["attendee"]);
          fputcsv($report, self::esc_csv($clean_line));
      }
  }
  ?>
  ```
