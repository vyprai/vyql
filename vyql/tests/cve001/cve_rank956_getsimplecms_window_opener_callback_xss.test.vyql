# Rank 956 / CVE-2015-5356: GetSimpleCMS rendered the func query
# parameter into a window.opener callback name in filebrowser.php.

test "rank956: raw func query parameter reaches window.opener callback JavaScript"
  lang php
  profile api
  file filebrowser.php
  expect VYQL-INJ-190
  expect_review code.PhpWindowOpenerCallbackNameXss
  code
  ```
  <?php
  $returnid = isset($_GET['returnid']) ? var_out($_GET['returnid']) : "";
  $func = (isset($_GET['func'])) ? $_GET['func'] : "";
  ?>
  <script>
  function submitLink($funcNum, $url) {
    <?php if (isset($_GET['returnid'])) { ?>
      <?php if (isset($_GET['func'])) {
        $func = @$_GET['func'];
      ?>
      if (window.opener) {
        if (typeof window.opener.<?php echo $func; ?> == 'function') {
          window.opener.<?php echo $func; ?>('<?php echo $returnid; ?>');
        }
      }
      <?php } ?>
    <?php } ?>
  }
  </script>
  ```

test "rank956: var_out guards window.opener callback name"
  lang php
  profile api
  file filebrowser.php
  reject VYQL-INJ-190
  reject_review code.PhpWindowOpenerCallbackNameXss
  code
  ```
  <?php
  $returnid = isset($_GET['returnid']) ? var_out($_GET['returnid']) : "";
  $func = (isset($_GET['func'])) ? var_out($_GET['func']) : "";
  ?>
  <script>
  function submitLink($funcNum, $url) {
    <?php if (isset($_GET['returnid'])) { ?>
      <?php if (isset($_GET['func'])) { ?>
      if (window.opener) {
        if (typeof window.opener.<?php echo $func; ?> == 'function') {
          window.opener.<?php echo $func; ?>('<?php echo $returnid; ?>');
        }
      }
      <?php } ?>
    <?php } ?>
  }
  </script>
  ```
