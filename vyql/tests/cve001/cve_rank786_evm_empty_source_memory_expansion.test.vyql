# Rank 786 / CVE-2021-29511: rust-evm Memory::set expanded and zero-filled a
# caller-selected target size even when the source slice was empty.

test "rank786: Rust memory set expands target size for empty source slice"
  lang rust
  file memory.rs
  expect VYQL-DOS-027
  expect_review code.EmptySourceSliceMemoryExpansion
  code
  ```
  impl Memory {
      pub fn set(
          &mut self,
          offset: usize,
          value: &[u8],
          target_size: Option<usize>
      ) -> Result<(), ExitFatal> {
          let target_size = target_size.unwrap_or(value.len());

          if self.data.len() < offset + target_size {
              self.data.resize(offset + target_size, 0);
          }

          for index in 0..target_size {
              if self.data.len() > offset + index && value.len() > index {
                  self.data[offset + index] = value[index];
              } else {
                  self.data[offset + index] = 0;
              }
          }

          Ok(())
      }
  }
  ```

test "rank786: Rust memory set returns early for empty source slice"
  lang rust
  file memory.rs
  reject VYQL-DOS-027
  reject_review code.EmptySourceSliceMemoryExpansion
  code
  ```
  impl Memory {
      pub fn set(
          &mut self,
          offset: usize,
          value: &[u8],
          target_size: Option<usize>
      ) -> Result<(), ExitFatal> {
          if value.is_empty() {
              return Ok(())
          }

          let target_size = target_size.unwrap_or(value.len());

          if self.data.len() < offset + target_size {
              self.data.resize(offset + target_size, 0);
          }

          for index in 0..target_size {
              if self.data.len() > offset + index && value.len() > index {
                  self.data[offset + index] = value[index];
              } else {
                  self.data[offset + index] = 0;
              }
          }

          Ok(())
      }
  }
  ```
