# Rank 427 / CVE-2022-2713: Cockpit/Lime reroute() used stop(), but
# stop() did not terminate execution after a response object existed.

test "rank427: Lime stop marks request stopped without terminating"
  lang php
  file App.php
  expect VYQL-AUTH-022
  expect_review code.CockpitLimeRedirectStopContinuation
  code
  ```
  <?php
  namespace Lime;

  class App implements \ArrayAccess {
      public function stop(mixed $data = null, ?int $status = null): void {
          if (!isset($this->response)) {
              if ($data) {
                  echo $data;
              }
              $this->trigger('after', [true]);
              exit;
          }

          if ($status) {
              $this->response->status = $status;
          }

          if ($data) {
              $this->response->body = $data;
          }

          $this->request->stopped = true;
      }

      public function reroute(string $path): void {
          $this->response->status = 307;
          $this->response->headers['Location'] = $path;
          $this->stop();
      }
  }
  ```

test "rank427: Lime stop terminates redirect response execution"
  lang php
  file App.php
  reject VYQL-AUTH-022
  reject_review code.CockpitLimeRedirectStopContinuation
  code
  ```
  <?php
  namespace Lime;

  class App implements \ArrayAccess {
      public function stop(mixed $data = null, ?int $status = null): void {
          if (!isset($this->response)) {
              if ($data) {
                  echo $data;
              }
              $this->trigger('after', [true]);
              exit;
          }

          if ($status) {
              $this->response->status = $status;
          }

          if ($data) {
              $this->response->body = $data;
          }

          $this->request->stopped = true;
          $this->trigger('app:request:stop');
          $this->trigger('after', [true]);
          exit;
      }

      public function reroute(string $path): void {
          $this->response->status = 307;
          $this->response->headers['Location'] = $path;
          $this->stop();
      }
  }
  ```
