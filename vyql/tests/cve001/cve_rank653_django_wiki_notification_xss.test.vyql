test "rank653: AJAX callback JSON rendered through jQuery HTML string is XSS"
  lang javascript
  expect VYQL-INJ-004
  code
  ```
  function get_update () {
    jsonWrapper(URL_NOTIFY_GET_NEW, function (data) {
      for (var i = 0; i < data.objects.length; i++) {
        var n = data.objects[i];
        var element = $('<div><a href="' + URL_NOTIFY_GOTO + n.pk + '/"><div>' + n.message + '</div><div class="since">' + n.since + '</div></a></div>');
        $('.notification-list').prepend(element);
      }
    });
  }
  ```

test "rank653: AJAX callback JSON rendered as text nodes is clean"
  lang javascript
  reject VYQL-INJ-004
  code
  ```
  function get_update () {
    jsonWrapper(URL_NOTIFY_GET_NEW, function (data) {
      for (var i = 0; i < data.objects.length; i++) {
        var n = data.objects[i];
        var elementOuterDiv = $('<div />');
        var elementA = $('<a />', { href: URL_NOTIFY_GOTO + n.pk + '/' });
        var message = $('<div />', { text: n.message });
        var since = $('<div />', { text: n.since, class: 'since' });
        elementA.append(message).append(since);
        $('.notification-list').prepend(elementOuterDiv.append(elementA));
      }
    });
  }
  ```
