test "rank290: byte-struct array deserializer writes into uninitialized array"
  lang rust
  expect VYQL-MEM-015
  expect_review code.UninitializedBufferExposure
  code
  ```
  trait ByteStructUnspecifiedByteOrder {
      fn read_bytes_default_le(bytes: &[u8]) -> Self;
  }

  macro_rules! byte_struct_array {
      ($x:expr) => {
          impl<T: ByteStructUnspecifiedByteOrder> ByteStructUnspecifiedByteOrder for [T; $x] {
              fn read_bytes_default_le(bytes: &[u8]) -> Self {
                  let mut pos = 0;
                  let len = T::BYTE_LEN;
                  let mut result: Self;
                  unsafe {
                      result = std::mem::uninitialized();
                      for i in 0 .. ($x) {
                          std::ptr::write(&mut result[i], <T>::read_bytes_default_le(&bytes[pos .. pos + len]));
                          pos += len;
                      }
                  }
                  result
              }
          }
      }
  }
  ```

test "rank290: byte-struct array deserializer avoids uninitialized array"
  lang rust
  reject VYQL-MEM-015
  reject_review code.UninitializedBufferExposure
  code
  ```
  use std::convert::TryInto;

  trait ByteStructUnspecifiedByteOrder {
      fn read_bytes_default_le(bytes: &[u8]) -> Self;
  }

  macro_rules! byte_struct_array {
      ($x:expr) => {
          impl<T: ByteStructUnspecifiedByteOrder> ByteStructUnspecifiedByteOrder for [T; $x] {
              fn read_bytes_default_le(bytes: &[u8]) -> Self {
                  let len = T::BYTE_LEN;
                  (0 .. ($x)).map(|i| {
                      <T>::read_bytes_default_le(&bytes[i * len .. (i + 1) * len])
                  }).collect::<Vec<_>>().try_into().map_err(|_|()).unwrap()
              }
          }
      }
  }
  ```
