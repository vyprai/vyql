# Rank 187 / CVE-2019-1003036: the Azure VM agents plugin exposes
# doAttachPublicIP on its agent descriptor, a Stapler web method any
# authenticated user with Overall/Read can reach. It resolves the node the
# caller names and attaches a public IP to it, so the caller gains a public
# address on a VM that was provisioned without one, and it performs neither a
# permission check nor a POST requirement. The fix puts @RequirePOST on the
# method and checks Computer.CONFIGURE before the lookup.

test "rank187: Jenkins Azure VM attach public IP endpoint lacks permission check"
  lang java
  expect VYQL-AUTH-079
  expect_review code.SensitiveOperation
  code
  ```
  import hudson.util.FormValidation;
  import org.kohsuke.stapler.QueryParameter;

  class AzureVMAgentDescriptor {
    public FormValidation doAttachPublicIP(@QueryParameter String vmAgentName) {
      AzureVMAgent vmAgent = (AzureVMAgent) Jenkins.getInstance().getNode(vmAgentName);
      String publicIP = "";
      if (vmAgent != null) {
        publicIP = vmAgent.attachPublicIP();
      }
      return FormValidation.ok(publicIP);
    }
  }
  ```

test "rank187: Jenkins Azure VM attach public IP endpoint checks configure permission"
  lang java
  reject VYQL-AUTH-079
  reject_review code.SensitiveOperation
  code
  ```
  import hudson.model.Computer;
  import hudson.util.FormValidation;
  import org.kohsuke.stapler.QueryParameter;
  import org.kohsuke.stapler.interceptor.RequirePOST;

  class AzureVMAgentDescriptor {
    @RequirePOST
    public FormValidation doAttachPublicIP(@QueryParameter String vmAgentName) {
      Jenkins.getInstance().checkPermission(Computer.CONFIGURE);
      AzureVMAgent vmAgent = (AzureVMAgent) Jenkins.getInstance().getNode(vmAgentName);
      String publicIP = "";
      if (vmAgent != null) {
        publicIP = vmAgent.attachPublicIP();
      }
      return FormValidation.ok(publicIP);
    }
  }
  ```
