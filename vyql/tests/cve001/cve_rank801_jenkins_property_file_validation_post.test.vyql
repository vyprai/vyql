# Rank 801 / CVE-2022-27204: Jenkins descriptor property-file validation
# endpoints loaded request-supplied files or URLs before the patch required POST.

test "rank801: Jenkins property-file validation endpoint lacks POST"
  lang java
  file ExtendedChoiceParameterDefinition.java
  expect VYQL-RF-030
  expect_review code.JenkinsDescriptorPropertyFileValidationMissingPost
  code
  ```
  import hudson.model.ParameterDefinition;
  import hudson.model.ParameterDescriptor;
  import hudson.util.FormValidation;
  import org.apache.tools.ant.Project;
  import org.apache.tools.ant.taskdefs.Property;
  import org.kohsuke.stapler.QueryParameter;
  import java.io.File;
  import java.net.URL;

  public class ExtendedChoiceParameterDefinition extends ParameterDefinition {
    public static class DescriptorImpl extends ParameterDescriptor {
      public FormValidation doCheckPropertyFile(@QueryParameter final String propertyFile,
          @QueryParameter final String propertyKey, @QueryParameter final String type) throws Exception {
        Project project = new Project();
        Property property = new Property();
        property.setProject(project);
        File prop = new File(propertyFile);
        if (prop.exists()) {
          property.setFile(prop);
        } else {
          URL propertyFileUrl = new URL(propertyFile);
          property.setUrl(propertyFileUrl);
        }
        property.execute();
        return FormValidation.ok();
      }

      public FormValidation doCheckPropertyKey(@QueryParameter final String propertyFile,
          @QueryParameter final String propertyKey, @QueryParameter final String type) throws Exception {
        return doCheckPropertyFile(propertyFile, propertyKey, type);
      }
    }
  }
  ```

test "rank801: Jenkins property-file validation endpoint requires POST"
  lang java
  file ExtendedChoiceParameterDefinition.java
  reject VYQL-RF-030
  reject_review code.JenkinsDescriptorPropertyFileValidationMissingPost
  code
  ```
  import hudson.model.ParameterDefinition;
  import hudson.model.ParameterDescriptor;
  import hudson.util.FormValidation;
  import org.apache.tools.ant.Project;
  import org.apache.tools.ant.taskdefs.Property;
  import org.kohsuke.stapler.QueryParameter;
  import org.kohsuke.stapler.verb.POST;
  import java.io.File;
  import java.net.URL;

  public class ExtendedChoiceParameterDefinition extends ParameterDefinition {
    public static class DescriptorImpl extends ParameterDescriptor {
      @POST
      public FormValidation doCheckPropertyFile(@QueryParameter final String propertyFile,
          @QueryParameter final String propertyKey, @QueryParameter final String type) throws Exception {
        Project project = new Project();
        Property property = new Property();
        property.setProject(project);
        File prop = new File(propertyFile);
        if (prop.exists()) {
          property.setFile(prop);
        } else {
          URL propertyFileUrl = new URL(propertyFile);
          property.setUrl(propertyFileUrl);
        }
        property.execute();
        return FormValidation.ok();
      }

      @POST
      public FormValidation doCheckPropertyKey(@QueryParameter final String propertyFile,
          @QueryParameter final String propertyKey, @QueryParameter final String type) throws Exception {
        return doCheckPropertyFile(propertyFile, propertyKey, type);
      }
    }
  }
  ```
