test "rank508: TypiCMS stores uploaded SVG without sanitizing XML content"
  lang php
  expect VYQL-INJ-115
  expect_review code.UnsanitizedSvgUpload
  code
  ```
  <?php
  use Illuminate\Http\UploadedFile;

  class FileUploader {
      public function handle(UploadedFile $file): array {
          $extension = $this->normalizeExtension($file);
          [$width, $height] = $this->getImageDimensions($file, $extension);
          $filename = 'upload.' . $extension;
          $path = $file->storeAs('files', $filename, 'public');
          return ['path' => $path, 'width' => $width, 'height' => $height];
      }

      private function normalizeExtension(UploadedFile $file): string {
          return mb_strtolower($file->getClientOriginalExtension());
      }

      private function getImageDimensions(UploadedFile $file, string $extension): array {
          if ($extension === 'svg') {
              return $this->getSvgDimensions($file);
          }
          return [0, 0];
      }

      private function getSvgDimensions(UploadedFile $file): array {
          preg_match('#viewbox#i', $file->getContent(), $matches);
          return [0, 0];
      }
  }
  ```

test "rank508: TypiCMS sanitizes uploaded SVG content before storing"
  lang php
  reject VYQL-INJ-115
  reject_review code.UnsanitizedSvgUpload
  code
  ```
  <?php
  use enshrined\svgSanitize\Sanitizer;
  use Illuminate\Http\UploadedFile;

  class FileUploader {
      public function handle(UploadedFile $file): array {
          $extension = $this->normalizeExtension($file);
          if ($extension === 'svg') {
              $this->sanitizeSvg($file);
          }
          [$width, $height] = $this->getImageDimensions($file, $extension);
          $filename = 'upload.' . $extension;
          $path = $file->storeAs('files', $filename, 'public');
          return ['path' => $path, 'width' => $width, 'height' => $height];
      }

      private function sanitizeSvg(UploadedFile $file): void {
          $sanitizer = new Sanitizer();
          file_put_contents($file->getPathname(), $sanitizer->sanitize($file->getContent()) ?: '');
      }

      private function normalizeExtension(UploadedFile $file): string {
          return mb_strtolower($file->getClientOriginalExtension());
      }

      private function getImageDimensions(UploadedFile $file, string $extension): array {
          if ($extension === 'svg') {
              return $this->getSvgDimensions($file);
          }
          return [0, 0];
      }

      private function getSvgDimensions(UploadedFile $file): array {
          preg_match('#viewbox#i', $file->getContent(), $matches);
          return [0, 0];
      }
  }
  ```
