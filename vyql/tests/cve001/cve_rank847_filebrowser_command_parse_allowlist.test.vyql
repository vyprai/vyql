# Rank 847 / CVE-2021-46398: FileBrowser checked command execution
# permission before parsing the command string it later executed.

test "rank847: command allowlist checked before canonical parsing"
  lang go
  file commands.go
  expect VYQL-AUTH-057
  expect_review code.CommandAllowlistBeforeParsing
  code
  ```
  package http

  import (
      "net/http"
      "os/exec"
      "strings"

      "github.com/filebrowser/filebrowser/v2/runner"
  )

  type user struct{}
  type data struct{ user *user }
  func (u *user) CanExecute(name string) bool { return true }

  func commandsHandler(w http.ResponseWriter, r *http.Request, d *data, raw string) (int, error) {
      raw = strings.TrimSpace(raw)
      if !d.user.CanExecute(strings.Split(raw, " ")[0]) {
          return 0, nil
      }
      command, err := runner.ParseCommand(nil, raw)
      if err != nil {
          return 0, nil
      }
      cmd := exec.Command(command[0], command[1:]...)
      _ = cmd
      return 0, nil
  }
  ```

test "rank847: command allowlist checks parsed command"
  lang go
  file commands.go
  reject VYQL-AUTH-057
  reject_review code.CommandAllowlistBeforeParsing
  code
  ```
  package http

  import (
      "net/http"
      "os/exec"
      "strings"

      "github.com/filebrowser/filebrowser/v2/runner"
  )

  type user struct{}
  type data struct{ user *user }
  func (u *user) CanExecute(name string) bool { return true }

  func commandsHandler(w http.ResponseWriter, r *http.Request, d *data, raw string) (int, error) {
      raw = strings.TrimSpace(raw)
      command, err := runner.ParseCommand(nil, raw)
      if err != nil {
          return 0, nil
      }
      if !d.user.CanExecute(command[0]) {
          return 0, nil
      }
      cmd := exec.Command(command[0], command[1:]...)
      _ = cmd
      return 0, nil
  }
  ```
