test "rank513: CoreOS installer writes Ignition config without restrictive permissions"
  lang rust
  expect VYQL-CFG-017
  code
  ```
  use std::fs::{create_dir_all, File, OpenOptions};
  use std::io::{copy, Result};
  use std::path::Path;

  fn write_ignition(mountpoint: &Path, mut config_in: &File) -> Result<()> {
      let mut config_dest = mountpoint.to_path_buf();
      config_dest.push("ignition");
      create_dir_all(&config_dest)?;

      config_dest.push("config.ign");
      let mut config_out = OpenOptions::new()
          .write(true)
          .create_new(true)
          .open(&config_dest)?;
      copy(&mut config_in, &mut config_out)?;

      Ok(())
  }
  ```

test "rank513: CoreOS installer restricts Ignition directory and config permissions"
  lang rust
  reject VYQL-CFG-017
  code
  ```
  use std::fs::{create_dir_all, set_permissions, File, OpenOptions, Permissions};
  use std::io::{copy, Result};
  use std::os::unix::fs::PermissionsExt;
  use std::path::Path;

  fn write_ignition(mountpoint: &Path, mut config_in: &File) -> Result<()> {
      let mut config_dest = mountpoint.to_path_buf();
      config_dest.push("ignition");
      if !config_dest.is_dir() {
          create_dir_all(&config_dest)?;
          set_permissions(&config_dest, Permissions::from_mode(0o700))?;
      }

      config_dest.push("config.ign");
      let mut config_out = OpenOptions::new()
          .write(true)
          .create_new(true)
          .open(&config_dest)?;
      set_permissions(&config_dest, Permissions::from_mode(0o600))?;
      copy(&mut config_in, &mut config_out)?;

      Ok(())
  }
  ```
