# Rank 286 / CVE-2021-21628: Jenkins Build With Parameters rendered job
# parameter names and descriptions in Jelly f:entry title/description fields
# without enabling the entry title/description escape behavior.

test "rank286: Build With Parameters renders parameter name and description without entry escaping"
  lang config
  file index.jelly
  expect VYQL-INJ-004
  code
  ```
  <?jelly escape-by-default='true'?>
  <j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <j:forEach var="parameter" items="${it.availableParameters}">
      <f:entry title="${parameter.name}" description="${parameter.description}">
        <div name="parameter"/>
      </f:entry>
    </j:forEach>
  </j:jelly>
  ```

test "rank286: Build With Parameters enables entry title and description escaping"
  lang config
  file index.jelly
  reject VYQL-INJ-004
  code
  ```
  <?jelly escape-by-default='true'?>
  <j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <j:forEach var="parameter" items="${it.availableParameters}">
      <j:set var="escapeEntryTitleAndDescription" value="true"/>
      <f:entry title="${parameter.name}" description="${parameter.description}">
        <div name="parameter"/>
      </f:entry>
    </j:forEach>
  </j:jelly>
  ```
