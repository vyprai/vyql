test "rank288: BusyBox udhcpc6 DNS_SERVERS allocation is one byte short"
  lang c
  expect VYQL-MEM-021
  code
  ```
  static void option_to_env(const unsigned char *option, const unsigned char *option_end) {
      unsigned addrs;
      unsigned option_offset;
      char *dlist;

      switch (option[0]) {
      case D6_OPT_DNS_SERVERS:
          if ((option[3] & 0x0f) != 0)
              break;

          addrs = option[3] >> 4;
          *new_env() = dlist = xmalloc(4 + addrs * 40 - 1);
          dlist = stpcpy(dlist, "dns=");
          option_offset = 0;

          while (addrs--) {
              sprint_nip6(dlist, option + 4 + option_offset);
              dlist += 39;
              option_offset += 16;
              if (addrs)
                  *dlist++ = ' ';
          }
          break;
      }
  }
  ```

test "rank288: DNS server address-list underallocation generalizes across variable names"
  lang c
  expect VYQL-MEM-021
  code
  ```
  static void emit_dns(const unsigned char *raw) {
      unsigned count;
      unsigned cursor;
      char *writer;

      switch (raw[0]) {
      case D6_OPT_DNS_SERVERS:
          count = raw[3] >> 4;
          writer = xmalloc(4 + count * 40 - 1);
          cursor = 0;
          while (count--) {
              sprint_nip6(writer, raw + 4 + cursor);
              writer += 39;
              cursor += 16;
          }
          break;
      }
  }
  ```

test "rank288: BusyBox udhcpc6 DNS_SERVERS allocation includes the terminator"
  lang c
  reject VYQL-MEM-021
  code
  ```
  static void option_to_env(const unsigned char *option, const unsigned char *option_end) {
      unsigned addrs;
      unsigned option_offset;
      char *dlist;

      switch (option[0]) {
      case D6_OPT_DNS_SERVERS:
          if ((option[3] & 0x0f) != 0)
              break;

          addrs = option[3] >> 4;
          *new_env() = dlist = xmalloc(4 + addrs * 40 + 1);
          dlist = stpcpy(dlist, "dns=");
          option_offset = 0;

          while (addrs-- != 0) {
              sprint_nip6(dlist, option + 4 + option_offset);
              dlist += 39;
              option_offset += 16;
              if (addrs != 0)
                  *dlist++ = ' ';
          }
          break;
      }
  }
  ```
