test "rank238: Jenkins doFill endpoint without RequirePOST is surfaced for CSRF review"
  lang java
  expect VYQL-RF-043
  expect_review code.StateChangingOp
  code
  ```
  import hudson.util.ListBoxModel;
  import org.kohsuke.stapler.QueryParameter;

  class DescriptorImpl {
    public ListBoxModel doFillWorkspaceIdItems(@QueryParameter("credentialsId") String credentialsId) {
      ListBoxModel items = new ListBoxModel();
      items.add(new ListBoxModel.Option(credentialsId, credentialsId, false));
      return items;
    }
  }
  ```

test "rank238: Jenkins doFill endpoint with RequirePOST is clean for CSRF review"
  lang java
  reject VYQL-RF-043
  reject_review code.StateChangingOp
  code
  ```
  import hudson.util.ListBoxModel;
  import org.kohsuke.stapler.QueryParameter;
  import org.kohsuke.stapler.interceptor.RequirePOST;

  class DescriptorImpl {
    @RequirePOST
    public ListBoxModel doFillWorkspaceIdItems(@QueryParameter("credentialsId") String credentialsId) {
      ListBoxModel items = new ListBoxModel();
      items.add(new ListBoxModel.Option(credentialsId, credentialsId, false));
      return items;
    }
  }
  ```
