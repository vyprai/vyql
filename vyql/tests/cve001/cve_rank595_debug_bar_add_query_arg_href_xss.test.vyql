test "rank595: WordPress add_query_arg href output requires URL escaping"
  lang php
  expect VYQL-INJ-128
  expect_review code.WordPressAddQueryArgHrefXss
  code
  ```
  <?php
  class Debug_Bar_Queries {
      public function render() {
          global $wpdb;
          $show_many = isset($_GET['debug_queries']);
          $out = '';

          if ( $wpdb->num_queries > 500 && !$show_many )
              $out .= "<p>" . sprintf( __('There are too many queries to show easily! <a href="%s">Show them anyway</a>', 'debug-bar'), add_query_arg( 'debug_queries', 'true' ) ) . "</p>";

          echo $out;
      }
  }
  ```

test "rank595: WordPress add_query_arg href output escaped with esc_url"
  lang php
  reject VYQL-INJ-128
  reject_review code.WordPressAddQueryArgHrefXss
  code
  ```
  <?php
  class Debug_Bar_Queries {
      public function render() {
          global $wpdb;
          $show_many = isset($_GET['debug_queries']);
          $out = '';

          if ( $wpdb->num_queries > 500 && !$show_many )
              $out .= "<p>" . sprintf( __('There are too many queries to show easily! <a href="%s">Show them anyway</a>', 'debug-bar'), esc_url( add_query_arg( 'debug_queries', 'true' ) ) ) . "</p>";

          echo $out;
      }
  }
  ```
