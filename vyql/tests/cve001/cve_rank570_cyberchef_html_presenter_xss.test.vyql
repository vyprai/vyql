test "cve rank570 cyberchef: HTML presenter escapes printable operation values"
  lang javascript
  expect VYQL-INJ-122
  code
  ```
  class TextEncodingBruteForce extends Operation {
    constructor() {
      super()
      this.outputType = "json"
      this.presentType = "html"
    }

    present(encodings) {
      let table = "<table><tr><th>Encoding</th><th>Value</th></tr>"
      for (const enc in encodings) {
        const value = Utils.printable(encodings[enc], true)
        table += `<tr><td>${enc}</td><td>${value}</td></tr>`
      }
      return table
    }
  }
  ```

test "cve rank570 cyberchef: Utils.escapeHtml suppresses HTML presenter XSS"
  lang javascript
  reject VYQL-INJ-122
  code
  ```
  class TextEncodingBruteForce extends Operation {
    constructor() {
      super()
      this.outputType = "json"
      this.presentType = "html"
    }

    present(encodings) {
      let table = "<table><tr><th>Encoding</th><th>Value</th></tr>"
      for (const enc in encodings) {
        const value = Utils.escapeHtml(Utils.printable(encodings[enc], true))
        table += `<tr><td>${enc}</td><td>${value}</td></tr>`
      }
      return table
    }
  }
  ```
