# Rank 420 / CVE-2017-1000495: QuickApps CMS stored XSS in the user's
# real-name field. The fix added a Cake entity _getName accessor that returns
# h($name) before templates read user()->name or related entity names.

test "rank420: QuickApps user entity exposes real name without escaped accessor"
  lang php
  file User.php
  expect VYQL-INJ-077
  expect_review code.QuickAppsUserRealNameStoredXss
  code
  ```
  <?php
  namespace User\Model\Entity;

  use Cake\ORM\Entity;
  use Cake\ORM\TableRegistry;
  use Cake\Utility\Security;
  use CMS\Core\StaticCacheTrait;

  class User extends Entity
  {
      use StaticCacheTrait;

      public function updateToken()
      {
          return TableRegistry::get('User.Users')->updateToken($this);
      }

      public function isAdmin()
      {
          $roles = $this->_getRoleIds();

          return in_array(ROLE_ID_ADMINISTRATOR, $roles);
      }

      protected function _getCancelCode()
      {
          $password = $this->password;

          return Security::hash($password, 'md5', true);
      }
  }
  ```

test "rank420: QuickApps user entity escapes real name through Cake h helper"
  lang php
  file User.php
  reject VYQL-INJ-077
  reject_review code.QuickAppsUserRealNameStoredXss
  code
  ```
  <?php
  namespace User\Model\Entity;

  use Cake\ORM\Entity;
  use Cake\ORM\TableRegistry;
  use Cake\Utility\Security;
  use CMS\Core\StaticCacheTrait;

  class User extends Entity
  {
      use StaticCacheTrait;

      public function updateToken()
      {
          return TableRegistry::get('User.Users')->updateToken($this);
      }

      public function isAdmin()
      {
          $roles = $this->_getRoleIds();

          return in_array(ROLE_ID_ADMINISTRATOR, $roles);
      }

      protected function _getName()
      {
          $name = isset($this->_properties['name']) ? $this->_properties['name'] : '';

          return h($name);
      }

      protected function _getCancelCode()
      {
          $password = $this->password;

          return Security::hash($password, 'md5', true);
      }
  }
  ```
