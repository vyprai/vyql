# Rank 744 / CVE-2022-36058: elrond-go depended on a vulnerable
# elrond-vm-common release; the fix updates the Go module to v1.3.10.

test "rank744: vulnerable elrond-vm-common go.mod pin is reported"
  lang go
  expect VYQL-SCA-001
  file main.go
  code
  ```
  package main

  func main() {}
  ```
  file go.mod
  code
  ```
  module github.com/ElrondNetwork/elrond-go

  go 1.15

  require (
      github.com/ElrondNetwork/elrond-vm-common v1.3.6
      github.com/pkg/errors v0.9.1
  )
  ```

test "rank744: patched elrond-vm-common go.mod pin is clean"
  lang go
  reject VYQL-SCA-001
  file main.go
  code
  ```
  package main

  func main() {}
  ```
  file go.mod
  code
  ```
  module github.com/ElrondNetwork/elrond-go

  go 1.15

  require (
      github.com/ElrondNetwork/elrond-vm-common v1.3.10
      github.com/pkg/errors v0.9.1
  )
  ```
