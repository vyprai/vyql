test "rank261: Bottle query parser treats semicolon as parameter separator"
  lang python
  expect VYQL-INJ-046
  expect_review code.AmbiguousQueryParameterSeparator
  code
  ```
  def _parse_qsl(qs):
      r = []
      for pair in qs.replace(';','&').split('&'):
          if not pair:
              continue
          nv = pair.split('=', 1)
          if len(nv) != 2:
              nv.append('')
          key = urlunquote(nv[0].replace('+', ' '))
          value = urlunquote(nv[1].replace('+', ' '))
          r.append((key, value))
      return r
  ```

test "rank261: Bottle query parser only uses ampersand as parameter separator"
  lang python
  reject VYQL-INJ-046
  reject_review code.AmbiguousQueryParameterSeparator
  code
  ```
  def _parse_qsl(qs):
      r = []
      for pair in qs.split('&'):
          if not pair:
              continue
          nv = pair.split('=', 1)
          if len(nv) != 2:
              nv.append('')
          key = urlunquote(nv[0].replace('+', ' '))
          value = urlunquote(nv[1].replace('+', ' '))
          r.append((key, value))
      return r
  ```
