# Rank 747 / CVE-2018-1000417: Jenkins email-ext template management
# state-changing Stapler actions required administrator permission but accepted GET.

test "rank747: Jenkins template save/delete actions lack RequirePOST"
  lang java
  expect VYQL-RF-029
  expect_review code.JenkinsStaplerStateChangeMissingPost
  code
  ```
  import jenkins.model.Jenkins;
  import org.kohsuke.stapler.HttpRedirect;
  import org.kohsuke.stapler.HttpResponse;
  import org.kohsuke.stapler.QueryParameter;
  import org.kohsuke.stapler.StaplerRequest;
  import org.kohsuke.stapler.StaplerResponse;

  class ExtEmailTemplateManagement {
      public HttpResponse doRemoveTemplate(StaplerRequest req, StaplerResponse rsp,
              @QueryParameter("id") String templateId) throws Exception {
          checkPermission(Jenkins.ADMINISTER);
          DescriptorImpl descriptor = getPublisherDescriptor();
          descriptor.removeTemplateById(templateId);
          return new HttpRedirect("index");
      }

      public HttpResponse doSaveTemplate(StaplerRequest req) throws Exception {
          checkPermission(Jenkins.ADMINISTER);
          DescriptorImpl descriptor = getPublisherDescriptor();
          ExtendedEmailPublisherTemplate template = descriptor.getTemplateById(req.getSubmittedForm().getString("id"));
          req.bindJSON(template, req.getSubmittedForm());
          descriptor.save();
          return new HttpRedirect("index");
      }
  }
  ```

test "rank747: Jenkins template save/delete actions with RequirePOST are clean"
  lang java
  reject VYQL-RF-029
  reject_review code.JenkinsStaplerStateChangeMissingPost
  code
  ```
  import jenkins.model.Jenkins;
  import org.kohsuke.stapler.HttpRedirect;
  import org.kohsuke.stapler.HttpResponse;
  import org.kohsuke.stapler.QueryParameter;
  import org.kohsuke.stapler.StaplerRequest;
  import org.kohsuke.stapler.StaplerResponse;
  import org.kohsuke.stapler.interceptor.RequirePOST;

  class ExtEmailTemplateManagement {
      @RequirePOST
      public HttpResponse doRemoveTemplate(StaplerRequest req, StaplerResponse rsp,
              @QueryParameter("id") String templateId) throws Exception {
          checkPermission(Jenkins.ADMINISTER);
          DescriptorImpl descriptor = getPublisherDescriptor();
          descriptor.removeTemplateById(templateId);
          return new HttpRedirect("index");
      }

      @RequirePOST
      public HttpResponse doSaveTemplate(StaplerRequest req) throws Exception {
          checkPermission(Jenkins.ADMINISTER);
          DescriptorImpl descriptor = getPublisherDescriptor();
          ExtendedEmailPublisherTemplate template = descriptor.getTemplateById(req.getSubmittedForm().getString("id"));
          req.bindJSON(template, req.getSubmittedForm());
          descriptor.save();
          return new HttpRedirect("index");
      }
  }
  ```
