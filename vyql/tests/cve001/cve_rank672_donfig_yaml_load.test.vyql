# Rank 672 / CVE-2019-7537: donfig parsed config files with yaml.load
# before switching to yaml.safe_load.

test "rank672: donfig collect_yaml uses unsafe yaml.load"
  lang python
  profile library
  file config_obj.py
  expect VYQL-DESER-001
  code
  ```
  import yaml

  def collect_yaml(paths):
      configs = []
      for path in paths:
          with open(path) as f:
              data = yaml.load(f.read()) or {}
              configs.append(data)
      return configs
  ```

test "rank672: donfig collect_yaml uses yaml.safe_load"
  lang python
  profile library
  file config_obj.py
  reject VYQL-DESER-001
  code
  ```
  import yaml

  def collect_yaml(paths):
      configs = []
      for path in paths:
          with open(path) as f:
              data = yaml.safe_load(f.read()) or {}
              configs.append(data)
      return configs
  ```
