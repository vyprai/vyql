test "rank247: Bludit accepts SVG image upload without sanitizing XML"
  lang php
  file bl-kernel/ajax/upload-images.php
  expect VYQL-INJ-115
  expect_review code.UnsanitizedSvgUpload
  code
  ```
  <?php
  foreach ($_FILES['images']['name'] as $uuid => $filename) {
      $fileExtension = Filesystem::extension($filename);
      $fileExtension = Text::lowercase($fileExtension);
      if (!in_array($fileExtension, $GLOBALS['ALLOWED_IMG_EXTENSION'])) {
          ajaxResponse(1, 'bad extension');
      }

      $fileMimeType = Filesystem::mimeType($_FILES['images']['tmp_name'][$uuid]);
      if ($fileMimeType !== false) {
          if (!in_array($fileMimeType, $GLOBALS['ALLOWED_IMG_MIMETYPES'])) {
              ajaxResponse(1, 'bad mime');
          }
      }

      Filesystem::mv($_FILES['images']['tmp_name'][$uuid], PATH_TMP . $filename);
  }
  ?>
  ```

test "rank247: Bludit SVG upload sanitized before storage is clean"
  lang php
  file bl-kernel/ajax/upload-images.php
  reject VYQL-INJ-115
  reject_review code.UnsanitizedSvgUpload
  code
  ```
  <?php
  foreach ($_FILES['images']['name'] as $uuid => $filename) {
      $fileExtension = Filesystem::extension($filename);
      $fileExtension = Text::lowercase($fileExtension);
      if (!in_array($fileExtension, $GLOBALS['ALLOWED_IMG_EXTENSION'])) {
          ajaxResponse(1, 'bad extension');
      }

      $fileMimeType = Filesystem::mimeType($_FILES['images']['tmp_name'][$uuid]);
      if ($fileMimeType !== false) {
          if (!in_array($fileMimeType, $GLOBALS['ALLOWED_IMG_MIMETYPES'])) {
              ajaxResponse(1, 'bad mime');
          }
      }

      sanitizeSvg($_FILES['images']['tmp_name'][$uuid]);
      Filesystem::mv($_FILES['images']['tmp_name'][$uuid], PATH_TMP . $filename);
  }
  ?>
  ```
