# Rank 880 / CVE-2022-30034: Flower authorized OAuth provider emails with
# re.match(auth_pattern, email), so literal auth patterns could be bypassed by
# emails that merely shared the allowed prefix.

test "rank880: OAuth email authorization uses prefix regex matching"
  lang python
  file auth.py
  expect VYQL-AUTH-063
  expect_review code.UnanchoredOAuthEmailRegexAuthBypass
  code
  ```
  import json
  import re
  import tornado.web

  class GithubLoginHandler(BaseHandler):
      def _on_auth(self, user):
          access_token = user['access_token']
          response = yield self.get_auth_http_client().fetch(
              'https://api.github.com/user/emails',
              headers={'Authorization': 'token ' + access_token})
          emails = [
              email['email'].lower()
              for email in json.loads(response.body.decode('utf-8'))
              if email['verified'] and re.match(self.application.options.auth, email['email'])
          ]
          if not emails:
              raise tornado.web.HTTPError(403, 'Access denied')
          self.set_secure_cookie("user", str(emails.pop()))
          self.redirect('/')
  ```

test "rank880: OAuth email authorization uses helper with full/exact matching"
  lang python
  file auth.py
  reject VYQL-AUTH-063
  reject_review code.UnanchoredOAuthEmailRegexAuthBypass
  code
  ```
  import json
  import re
  import tornado.web

  def authenticate(pattern, email):
      if '|' in pattern:
          return email in pattern.split('|')
      elif '*' in pattern:
          pattern = re.escape(pattern).replace('\\.\\*', "[A-Za-z0-9._-]*")
          return re.fullmatch(pattern, email)
      else:
          return pattern == email

  class GithubLoginHandler(BaseHandler):
      def _on_auth(self, user):
          access_token = user['access_token']
          response = yield self.get_auth_http_client().fetch(
              'https://api.github.com/user/emails',
              headers={'Authorization': 'token ' + access_token})
          emails = [
              email['email'].lower()
              for email in json.loads(response.body.decode('utf-8'))
              if email['verified'] and authenticate(self.application.options.auth, email['email'])
          ]
          if not emails:
              raise tornado.web.HTTPError(403, 'Access denied')
          self.set_secure_cookie("user", str(emails.pop()))
          self.redirect('/')
  ```
