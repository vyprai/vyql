test "rank228: decoder allocates attacker length before buffer availability check"
  lang go
  expect VYQL-DOS-006
  expect_review code.LengthDerivedAllocation
  code
  ```
  package binary

  import (
    "fmt"
    "io"
  )

  type peekAbleByteReader interface {
    io.ByteReader
    Peek(n int) ([]byte, error)
  }

  func readNBytes(n int, reader peekAbleByteReader) ([]byte, error) {
    if n == 0 {
      return make([]byte, 0), nil
    }
    if n < 0 || n > 0x7FFF_FFFF {
      return nil, fmt.Errorf("invalid length n: %v", n)
    }
    buf := make([]byte, n)
    for i := 0; i < n; i++ {
      b, err := reader.ReadByte()
      if err != nil {
        return nil, err
      }
      buf[i] = b
    }
    return buf, nil
  }
  ```

test "rank228: decoder proves available bytes and slices existing buffer"
  lang go
  reject VYQL-DOS-006
  reject_review code.LengthDerivedAllocation
  code
  ```
  package binary

  import "fmt"

  type Decoder struct {
    data []byte
    pos int
  }

  func readNBytes(n int, reader *Decoder) ([]byte, error) {
    if n == 0 {
      return make([]byte, 0), nil
    }
    if n < 0 || n > 0x7FFF_FFFF {
      return nil, fmt.Errorf("invalid length n: %v", n)
    }
    if reader.pos+n > len(reader.data) {
      return nil, fmt.Errorf("not enough data: %d bytes missing", reader.pos+n-len(reader.data))
    }
    out := reader.data[reader.pos : reader.pos+n]
    reader.pos += n
    return out, nil
  }
  ```
