test "rank832: Java temp file wrapper returns default-permission temp file"
  lang java
  expect VYQL-CFG-008
  expect_review code.InsecurePermission
  code
  ```
  import java.io.File;
  import java.io.IOException;

  class SystemHelper {
      public File createTempFile(final String prefix, final String suffix) {
          try {
              final File file = File.createTempFile(prefix, suffix);
              return file;
          } catch (final IOException e) {
              throw new RuntimeException(e);
          }
      }
  }
  ```

test "rank832: Java temp file wrapper hardens owner-only permissions"
  lang java
  reject VYQL-CFG-008
  reject_review code.InsecurePermission
  code
  ```
  import java.io.File;
  import java.io.IOException;

  class SystemHelper {
      public File createTempFile(final String prefix, final String suffix) {
          try {
              final File file = File.createTempFile(prefix, suffix);
              file.setReadable(false, false);
              file.setReadable(true, true);
              file.setWritable(false, false);
              file.setWritable(true, true);
              return file;
          } catch (final IOException e) {
              throw new RuntimeException(e);
          }
      }
  }
  ```

test "rank832: Java try-with-resources closes input stream implicitly"
  lang java
  reject VYQL-RES-001
  code
  ```
  import java.io.InputStream;
  import java.nio.file.Files;
  import java.nio.file.Path;
  import java.util.Properties;

  class SystemHelper {
      protected void parseProjectProperties(final Path propPath) throws Exception {
          try (final InputStream in = Files.newInputStream(propPath)) {
              final Properties prop = new Properties();
              prop.load(in);
          }
      }
  }
  ```
