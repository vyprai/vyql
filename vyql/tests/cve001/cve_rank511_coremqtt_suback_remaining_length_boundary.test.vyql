# Rank 511 / CVE-2026-8686: coreMQTT skipped SUB/UNSUB ACK property parsing
# when remainingLength was exactly 4, missing a protocol validation error.

test "rank511: suback property parser skipped at remaining length 4"
  lang c
  file core_mqtt_serializer.c
  expect VYQL-VAL-020
  code
  ```
  typedef int MQTTStatus_t;
  typedef struct { unsigned int remainingLength; unsigned char *pRemainingData; } MQTTPacketInfo_t;
  typedef struct {} MQTTReasonCodeInfo_t;
  typedef struct {} MQTTPropBuilder_t;
  #define MQTTSuccess 0
  #define MQTTBadResponse 1
  unsigned short UINT16_DECODE(unsigned char *p);
  MQTTStatus_t deserializeSubUnsubAckProperties(MQTTPropBuilder_t *p, unsigned char *idx, unsigned long *len, unsigned int remainingLength);
  MQTTStatus_t readSubackStatus(unsigned long n, const unsigned char *p, MQTTReasonCodeInfo_t *r);

  static MQTTStatus_t deserializeSubUnsubAck(const MQTTPacketInfo_t * incomingPacket,
                                             unsigned short * pPacketId,
                                             MQTTReasonCodeInfo_t * pReasonCodes,
                                             MQTTPropBuilder_t * pPropBuffer) {
      MQTTStatus_t status = MQTTSuccess;
      unsigned char * pIndex = incomingPacket->pRemainingData;
      unsigned long propertyLength = 0U;
      unsigned long statusTotalBytes = 0U;
      const unsigned char * pStatusStart;
      if (incomingPacket->remainingLength < 4U) {
          status = MQTTBadResponse;
      } else {
          *pPacketId = UINT16_DECODE(pIndex);
          pIndex = &pIndex[2];
      }
      if ((status == MQTTSuccess) && (incomingPacket->remainingLength > 4U)) {
          status = deserializeSubUnsubAckProperties(pPropBuffer, pIndex, &propertyLength, incomingPacket->remainingLength);
      }
      if (status == MQTTSuccess) {
          statusTotalBytes = incomingPacket->remainingLength - sizeof(unsigned short) - propertyLength;
          pStatusStart = &pIndex[propertyLength];
          status = readSubackStatus(statusTotalBytes, pStatusStart, pReasonCodes);
      }
      return status;
  }
  ```

test "rank511: suback property parser runs at remaining length 4"
  lang c
  file core_mqtt_serializer.c
  reject VYQL-VAL-020
