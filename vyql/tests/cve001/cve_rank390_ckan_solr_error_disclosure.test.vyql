# Rank 390 / CVE-2024-41674: CKAN package_search wrapped raw pysolr
# connection errors in SearchError, allowing Solr URLs and credentials to be
# returned through API error serialization.

test "rank390: CKAN package_search leaks raw Solr connection error details"
  lang python
  file ckan/lib/search/query.py
  expect VYQL-SEC-009
  expect_review code.CkanSolrConnectionErrorDisclosure
  code
  ```
  import pysolr

  class SearchError(Exception):
      pass

  class SearchQueryError(SearchError):
      pass

  def make_connection(decode_dates=False):
      return pysolr.Solr("http://user:pass@example.invalid/solr")

  class PackageSearchQuery:
      def run(self, query):
          conn = make_connection(decode_dates=False)
          try:
              solr_response = conn.search(**query)
          except pysolr.SolrError as e:
              if e.args and isinstance(e.args[0], str):
                  if "Can't determine Sort Order" in e.args[0]:
                      raise SearchQueryError('Invalid "sort" parameter')
              raise SearchError('SOLR returned an error running query: %r Error: %r' %
                                (query, e))
          self.count = solr_response.hits
  ```

test "rank390: CKAN package_search maps Solr connection failures to a generic error"
  lang python
  file ckan/lib/search/query.py
  reject VYQL-SEC-009
  reject_review code.CkanSolrConnectionErrorDisclosure
  code
  ```
  import pysolr

  class SearchError(Exception):
      pass

  class SearchQueryError(SearchError):
      pass

  class SolrConnectionError(Exception):
      pass

  def make_connection(decode_dates=False):
      return pysolr.Solr("http://user:pass@example.invalid/solr")

  class PackageSearchQuery:
      def run(self, query):
          conn = make_connection(decode_dates=False)
          try:
              solr_response = conn.search(**query)
          except pysolr.SolrError as e:
              if e.args and isinstance(e.args[0], str):
                  if "Can't determine Sort Order" in e.args[0]:
                      raise SearchQueryError('Invalid "sort" parameter')

                  if ("Failed to connect to server" in e.args[0] or
                          "Connection to server" in e.args[0]):
                      raise SolrConnectionError("Solr returned an error while searching.")

              raise SearchError('SOLR returned an error running query: %r Error: %r' %
                                (query, e))
          self.count = solr_response.hits
  ```
