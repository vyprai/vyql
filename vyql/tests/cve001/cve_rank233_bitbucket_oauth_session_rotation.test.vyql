test "rank233: Java OAuth login sets authentication without rotating the HTTP session"
  lang java
  expect VYQL-AUTH-074
  expect_review code.MissingSessionRotationAfterAuthentication
  code
  ```
  import javax.servlet.http.HttpSession;
  import org.acegisecurity.context.SecurityContextHolder;
  import org.kohsuke.stapler.StaplerRequest;

  class BitbucketSecurityRealm {
    Object doFinishLogin(StaplerRequest request, Object auth) throws Exception {
      String state = request.getParameter("state");
      if (state == null || !state.equals((String) request.getSession().getAttribute("state"))) {
        return null;
      }
      SecurityContextHolder.getContext().setAuthentication(auth);
      return null;
    }
  }
  ```

test "rank233: Java OAuth login rotates the HTTP session before authentication"
  lang java
  reject VYQL-AUTH-074
  reject_review code.MissingSessionRotationAfterAuthentication
  code
  ```
  import javax.servlet.http.HttpSession;
  import org.acegisecurity.context.SecurityContextHolder;
  import org.kohsuke.stapler.StaplerRequest;

  class BitbucketSecurityRealm {
    Object doFinishLogin(StaplerRequest request, Object auth) throws Exception {
      String state = request.getParameter("state");
      if (state == null || !state.equals(getSessionAttribute(request, "state"))) {
        return null;
      }
      HttpSession session = request.getSession(false);
      if (session != null) {
        session.invalidate();
      }
      request.getSession(true);
      SecurityContextHolder.getContext().setAuthentication(auth);
      return null;
    }

    private String getSessionAttribute(StaplerRequest request, String attributeName) {
      HttpSession session = request.getSession(false);
      if (session == null) {
        return null;
      }
      return (String) session.getAttribute(attributeName);
    }
  }
  ```
