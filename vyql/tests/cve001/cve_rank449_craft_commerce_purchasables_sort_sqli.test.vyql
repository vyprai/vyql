# Rank 449 / CVE-2026-29172: Craft Commerce purchasables table accepted
# request-controlled sort columns as Yii orderBy array keys.

test "rank449: Craft Commerce purchasables sort column reaches orderBy array key"
  lang php
  file OrdersController.php
  expect VYQL-INJ-091
  expect_review code.CraftCommercePurchasablesSortSqlInjection
  code
  ```
  <?php
  class OrdersController extends Controller {
      public function actionPurchasablesTable(): Response
      {
          $sort = $this->request->getParam('sort');
          $sqlQuery = (new Query())
              ->select(['purchasables.id', 'purchasables.price', 'purchasables.description', 'purchasables.sku'])
              ->from(['purchasables' => Table::PURCHASABLES]);

          if ($sort && strpos($sort, '|')) {
              [$column, $direction] = explode('|', $sort);
              if ($column && in_array($direction, ['asc', 'desc'], true)) {
                  $sqlQuery->orderBy([$column => $direction == 'asc' ? SORT_ASC : SORT_DESC]);
              }
          } else {
              $sqlQuery->orderBy(['id' => 'asc']);
          }
      }
  }
  ```

test "rank449: Craft Commerce purchasables sort column is allowlisted"
  lang php
  file OrdersController.php
  reject VYQL-INJ-091
  reject_review code.CraftCommercePurchasablesSortSqlInjection
  code
  ```
  <?php
  class OrdersController extends Controller {
      public function actionPurchasablesTable(): Response
      {
          $sort = $this->request->getParam('sort');
          $sqlQuery = (new Query())
              ->select(['purchasables.id', 'purchasables.price', 'purchasables.description', 'purchasables.sku'])
              ->from(['purchasables' => Table::PURCHASABLES]);

          if ($sort && strpos($sort, '|')) {
              [$column, $direction] = explode('|', $sort);

              if (!in_array($column, [
                  'description',
                  'sku',
                  'price',
              ])) {
                  $column = null;
              }

              if ($column && in_array($direction, ['asc', 'desc'], true)) {
                  $sqlQuery->orderBy([$column => $direction == 'asc' ? SORT_ASC : SORT_DESC]);
              }
          } else {
              $sqlQuery->orderBy(['id' => 'asc']);
          }
      }
  }
  ```
