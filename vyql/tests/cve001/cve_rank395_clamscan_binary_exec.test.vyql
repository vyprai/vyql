test "rank395: clamscan verifies configured scanner path through shell exec"
  lang javascript
  expect VYQL-INJ-068
  expect_review code.ClamscanBinaryPathShellCommandInjection
  code
  ```
  const fs = require('fs');
  const util = require('util');
  const child_process = require('child_process');
  const {exec, execFile} = child_process;
  const fs_access = util.promisify(fs.access);
  const cp_exec = util.promisify(exec);
  const cp_execfile = util.promisify(execFile);

  class NodeClam {
    async _is_clamav_binary(scanner) {
      const path = this.settings[scanner].path || null;
      if (!path) return false;

      const version_cmds = {
        clamdscan: `${path} --version`,
        clamscan: `${path} --version`,
      };

      await fs_access(path, fs.constants.R_OK);
      const {stdout} = await cp_exec(version_cmds[scanner]);
      return stdout.toString().match(/ClamAV/) !== null;
    }
  }
  ```

test "rank395: clamscan verifies configured scanner path with execFile args"
  lang javascript
  reject VYQL-INJ-068
  reject_review code.ClamscanBinaryPathShellCommandInjection
  code
  ```
  const fs = require('fs');
  const util = require('util');
  const child_process = require('child_process');
  const {exec, execFile} = child_process;
  const fs_access = util.promisify(fs.access);
  const cp_exec = util.promisify(exec);
  const cp_execfile = util.promisify(execFile);

  class NodeClam {
    async _is_clamav_binary(scanner) {
      const path = this.settings[scanner].path || null;
      if (!path) return false;

      const version_cmds = {
        clamdscan: `${path} --version`,
        clamscan: `${path} --version`,
      };

      await fs_access(path, fs.constants.R_OK);
      const version_cmds_exec = version_cmds[scanner].split(' ');
      const {stdout} = await cp_execfile(version_cmds_exec[0], [version_cmds_exec[1]]);
      return stdout.toString().match(/ClamAV/) !== null;
    }
  }
  ```
