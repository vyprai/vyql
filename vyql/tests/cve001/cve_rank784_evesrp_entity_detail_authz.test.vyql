# Rank 784 / CVE-2020-36660: evesrp exposed user and group detail API routes
# without login or administrator permission checks.

test "rank784: Flask user detail returns sensitive entity metadata without authz"
  lang python
  file api.py
  expect VYQL-AUTH-053
  expect_review code.FlaskEntityDetailMissingAuthorization
  code
  ```
  from flask import Blueprint, abort
  from flask_login import current_user
  from .util import jsonify
  from .models import User

  api = Blueprint('api', __name__)

  @api.route('/user/<int:user_id>/')
  def user_detail(user_id):
      user = User.query.get_or_404(user_id)
      submit = [p.division for p in user.permissions if p.permission == 'submit']
      resp = {
          u'name': user.name,
          u'groups': list(user.groups),
          u'divisions': {u'submit': list(set(submit))},
          u'admin': user.admin,
          u'requests': user.requests,
      }
      return jsonify(**resp)
  ```

test "rank784: Flask group detail returns sensitive entity metadata without authz"
  lang python
  file api.py
  expect VYQL-AUTH-053
  expect_review code.FlaskEntityDetailMissingAuthorization
  code
  ```
  from flask import Blueprint, abort
  from flask_login import current_user
  from .util import jsonify
  from .models import Group

  api = Blueprint('api', __name__)

  @api.route('/group/<int:group_id>/')
  def group_detail(group_id):
      group = Group.query.get_or_404(group_id)
      pay = [p.division for p in group.permissions if p.permission == 'pay']
      resp = {
          u'name': group.name,
          u'users': list(group.users),
          u'divisions': {u'pay': list(set(pay))},
      }
      return jsonify(**resp)
  ```

test "rank784: Flask entity detail is clean when guarded by login and admin permission"
  lang python
  file api.py
  reject VYQL-AUTH-053
  reject_review code.FlaskEntityDetailMissingAuthorization
  code
  ```
  from flask import Blueprint, abort
  from flask_login import login_required, current_user
  from .auth import PermissionType
  from .util import jsonify
  from .models import User

  api = Blueprint('api', __name__)

  @api.route('/user/<int:user_id>/')
  @login_required
  def user_detail(user_id):
      if not current_user.admin and not current_user.has_permission(PermissionType.admin):
          abort(403)
      user = User.query.get_or_404(user_id)
      submit = [p.division for p in user.permissions if p.permission == 'submit']
      resp = {
          u'name': user.name,
          u'groups': list(user.groups),
          u'divisions': {u'submit': list(set(submit))},
          u'admin': user.admin,
          u'requests': user.requests,
      }
      return jsonify(**resp)
  ```
