test "rank884: gzip compression output buffer uses fixed additive expansion"
  lang c
  file flb_gzip.c
  expect VYQL-MEM-043
  expect_review code.GzipDeflateFixedExpansionUnderallocation
  code
  ```
  #include <stdlib.h>

  typedef struct {
      void *next_in;
      void *next_out;
      unsigned int avail_in;
      unsigned int avail_out;
      unsigned int total_out;
  } z_stream;

  int deflateInit2(z_stream *strm, int level, int method, int window_bits, int mem_level, int strategy);
  int deflate(z_stream *strm, int flush);
  void *flb_malloc(size_t size);

  int flb_gzip_compress(void *in_data, size_t in_len, void **out_data, size_t *out_len)
  {
      size_t out_size;
      void *out_buf;
      z_stream strm;

      out_size = in_len + 32;
      out_buf = flb_malloc(out_size);
      strm.next_in = in_data;
      strm.avail_in = in_len;
      deflateInit2(&strm, 0, 0, 0, 0, 0);
      deflate(&strm, 0);
      *out_data = out_buf;
      *out_len = out_size;
      return 0;
  }
  ```

test "rank884: gzip compression output buffer includes worst-case expansion"
  lang c
  file flb_gzip.c
  reject VYQL-MEM-043
  reject_review code.GzipDeflateFixedExpansionUnderallocation
  code
  ```
  #include <stdlib.h>

  typedef struct {
      void *next_in;
      void *next_out;
      unsigned int avail_in;
      unsigned int avail_out;
      unsigned int total_out;
  } z_stream;

  int deflateInit2(z_stream *strm, int level, int method, int window_bits, int mem_level, int strategy);
  int deflate(z_stream *strm, int flush);
  void *flb_malloc(size_t size);

  int flb_gzip_compress(void *in_data, size_t in_len, void **out_data, size_t *out_len)
  {
      size_t out_size;
      void *out_buf;
      z_stream strm;
      int max_input_expansion = ((int)(in_len / 32000) + 1) * 5;

      out_size = 10 + 8 + max_input_expansion + in_len;
      out_buf = flb_malloc(out_size);
      strm.next_in = in_data;
      strm.avail_in = in_len;
      deflateInit2(&strm, 0, 0, 0, 0, 0);
      deflate(&strm, 0);
      *out_data = out_buf;
      *out_len = out_size;
      return 0;
  }
  ```
