test "rank577: Daptin aggregation must not pass request expressions to goqu.L"
  lang go
  expect VYQL-INJ-030
  code
  ```
  package resource

  type DbResource struct{}
  type Tx struct{}
  type AggregationRequest struct {
      RootEntity string
      ProjectColumn []string
      GroupBy []string
  }

  var statementbuilder struct {
      Squirrel squirrelBuilder
  }
  type squirrelBuilder struct{}
  type selectBuilder struct{}
  func (s squirrelBuilder) Select(args ...interface{}) selectBuilder { return selectBuilder{} }
  func (s selectBuilder) From(name string) selectBuilder { return s }
  func (s selectBuilder) GroupBy(args ...interface{}) selectBuilder { return s }

  var goqu goquNamespace
  type goquNamespace struct{}
  func (goquNamespace) L(s string) interface{} { return s }

  func (dbResource *DbResource) DataStats(req AggregationRequest, transaction *Tx) error {
      requestedGroupBys := req.GroupBy
      projections := req.ProjectColumn
      projectionsAdded := make([]interface{}, 0)
      for _, project := range projections {
          projectionsAdded = append(projectionsAdded, goqu.L(project))
      }
      groupBysAdded := make([]interface{}, 0)
      for _, group := range requestedGroupBys {
          projectionsAdded = append(projectionsAdded, goqu.L(group))
          groupBysAdded = append(groupBysAdded, goqu.L(group))
      }
      builder := statementbuilder.Squirrel.Select(projectionsAdded...).From(req.RootEntity)
      builder = builder.GroupBy(groupBysAdded...)
      _ = builder
      return nil
  }
  ```

test "rank577: Daptin aggregation schema parser suppresses raw goqu.L SQL expression review"
  lang go
  reject VYQL-INJ-030
  code
  ```
  package resource

  type DbResource struct{}
  type Tx struct{}
  type AggregationRequest struct {
      RootEntity string
      ProjectColumn []string
      GroupBy []string
  }

  var statementbuilder struct {
      Squirrel squirrelBuilder
  }
  type squirrelBuilder struct{}
  type selectBuilder struct{}
  func (s squirrelBuilder) Select(args ...interface{}) selectBuilder { return selectBuilder{} }
  func (s selectBuilder) From(name string) selectBuilder { return s }
  func (s selectBuilder) GroupBy(args ...interface{}) selectBuilder { return s }

  func (dbResource *DbResource) parseAggExpr(expr string, tables []string, allowAggregate bool) (interface{}, error) {
      return expr, nil
  }

  func (dbResource *DbResource) DataStats(req AggregationRequest, transaction *Tx) error {
      requestedGroupBys := req.GroupBy
      projections := req.ProjectColumn
      allowedTables := []string{req.RootEntity}
      projectionsAdded := make([]interface{}, 0)
      for _, project := range projections {
          expr, err := dbResource.parseAggExpr(project, allowedTables, true)
          if err != nil {
              return err
          }
          projectionsAdded = append(projectionsAdded, expr)
      }
      groupBysAdded := make([]interface{}, 0)
      for _, group := range requestedGroupBys {
          expr, err := dbResource.parseAggExpr(group, allowedTables, false)
          if err != nil {
              return err
          }
          projectionsAdded = append(projectionsAdded, expr)
          groupBysAdded = append(groupBysAdded, expr)
      }
      builder := statementbuilder.Squirrel.Select(projectionsAdded...).From(req.RootEntity)
      builder = builder.GroupBy(groupBysAdded...)
      _ = builder
      return nil
  }
  ```
