# Rank 986 / CVE-2024-8646: GlassFish form authentication restored saved
# request URLs without stripping protocol-relative leading slashes.

test "rank986: saved request url preserves protocol-relative redirect"
  lang java
  file appserver/web/web-core/src/main/java/org/apache/catalina/authenticator/FormAuthenticator.java
  expect VYQL-RF-042
  expect_review code.ProtocolRelativeSavedRequestRedirect
  code
  ```
  class FormAuthenticator {
      protected String savedRequestURL(Session session) {
          SavedRequest saved = (SavedRequest) session.getNote(FORM_REQUEST_NOTE);
          if (saved == null) {
              return null;
          }

          StringBuilder sb = new StringBuilder(saved.getRequestURI());
          if (saved.getQueryString() != null) {
              sb.append('?');
              sb.append(saved.getQueryString());
          }

          return sb.toString();
      }
  }
  ```

test "rank986: saved request url strips protocol-relative leading slashes"
  lang java
  file appserver/web/web-core/src/main/java/org/apache/catalina/authenticator/FormAuthenticator.java
  reject VYQL-RF-042
  reject_review code.ProtocolRelativeSavedRequestRedirect
  code
  ```
  class FormAuthenticator {
      protected String savedRequestURL(Session session) {
          SavedRequest saved = (SavedRequest) session.getNote(FORM_REQUEST_NOTE);
          if (saved == null) {
              return null;
          }

          StringBuilder sb = new StringBuilder(saved.getRequestURI());
          if (saved.getQueryString() != null) {
              sb.append('?');
              sb.append(saved.getQueryString());
          }

          while (sb.length() > 1 && sb.charAt(1) == '/') {
              sb.deleteCharAt(0);
          }

          return sb.toString();
      }
  }
  ```
