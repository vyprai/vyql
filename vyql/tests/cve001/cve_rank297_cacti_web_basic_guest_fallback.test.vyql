test "rank297: Cacti web basic auth exits before guest fallback"
lang php
expect VYQL-AUTH-007
expect_review code.MissingGuestFallbackForWebAuth
code
```
<?php
if (read_config_option('auth_method') == '2') {
    set_request_var('action', 'login');
}

if (get_nfilter_request_var('action') == 'login') {
    switch (read_config_option('auth_method')) {
    case '2':
        /* Web Basic Auth */
        $copy_user = true;
        $user_auth = true;
        $realm = 2;
        $user = db_fetch_row_prepared('SELECT * FROM user_auth WHERE username = ? AND realm = 2', array($username));

        if (!$user && read_config_option('user_template') == '0') {
            auth_display_custom_error_message('Template User is not defined');
            exit;
        }

        break;
    }

    if ((!sizeof($user)) && ($user_auth) && (read_config_option('guest_user') != '0')) {
        $user = db_fetch_row_prepared('SELECT * FROM user_auth WHERE username = ?', array(read_config_option('guest_user')));
    }
}
```

test "rank297: Cacti web basic auth checks guest fallback before exiting"
lang php
reject VYQL-AUTH-007
code
```
<?php
if (read_config_option('auth_method') == '2') {
    set_request_var('action', 'login');
}

if (get_nfilter_request_var('action') == 'login') {
    switch (read_config_option('auth_method')) {
    case '2':
        /* Web Basic Auth */
        $copy_user = true;
        $user_auth = true;
        $realm = 2;
        $user = db_fetch_row_prepared('SELECT * FROM user_auth WHERE username = ? AND realm = 2', array($username));

        if (!$user && read_config_option('user_template') == '0' && read_config_option('guest_user') == '0') {
            auth_display_custom_error_message('Template and Guest Users are not defined');
            exit;
        }

        break;
    }

    if ((!sizeof($user)) && ($user_auth) && (read_config_option('guest_user') != '0')) {
        $user = db_fetch_row_prepared('SELECT * FROM user_auth WHERE username = ?', array(read_config_option('guest_user')));
    }
}
```
