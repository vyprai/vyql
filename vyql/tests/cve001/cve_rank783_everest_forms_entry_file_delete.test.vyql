# Rank 783 / CVE-2025-5927: Everest Forms Pro arbitrary file deletion through
# delete_entry_files. The selected public everest-forms corpus commit is a 2022
# free-plugin version update, while public advisory/changelog evidence places
# the CVE in Everest Forms Pro 1.9.4 and the fix in Pro 1.9.5's backend file
# deletion handling. Public free-plugin commit a60ddb8a later moved the delete
# feature into free with a safe_delete_file helper that normalizes, realpaths,
# checks upload-directory containment, and only then calls wp_delete_file. This
# spec is a runnable local regression for the CVE mechanic but is skipped by the
# current fresh-target verifier because the selected corpus slice does not
# contain the Pro vulnerable/fixed source.
#
# verify_current_expected: skip-fresh-target

test "rank783: Everest Forms entry file deletion deletes metadata-derived paths without containment"
  lang php
  file includes/class-evf-form-task.php
  expect VYQL-PATH-060
  expect_review code.EverestFormsEntryFileDeleteWithoutPathGuard
  code
  ```
  <?php
  class EVF_Form_Task {
    public function delete_entry_files( $entry_id ) {
      $get_entry = evf_get_entry( $entry_id, 'meta' );
      if ( empty( $get_entry->meta ) ) {
        return;
      }
      foreach ( $get_entry->meta as $meta_key => $meta_value ) {
        $files = explode( "\n", $meta_value );
        foreach ( $files as $file ) {
          $path_from_url = wp_parse_url( $file, PHP_URL_PATH );
          $uploaded_file = wp_upload_dir()['basedir'] . preg_replace(
            '/.*uploads/',
            '/everest_forms_uploads',
            $path_from_url
          );
          wp_delete_file( $uploaded_file );
        }
      }
    }
  }
  ```

test "rank783: Everest Forms entry file deletion uses realpath containment helper"
  lang php
  file includes/class-evf-form-task.php
  reject VYQL-PATH-060
  reject_review code.EverestFormsEntryFileDeleteWithoutPathGuard
  code
  ```
  <?php
  class EVF_Form_Task {
    public function delete_entry_files( $entry_id ) {
      $get_entry = evf_get_entry( $entry_id, 'meta' );
      if ( empty( $get_entry->meta ) ) {
        return;
      }

      $uploads  = wp_upload_dir();
      $base_dir = realpath( $uploads['basedir'] );
      foreach ( $get_entry->meta as $meta_key => $meta_value ) {
        $files = explode( "\n", $meta_value );
        foreach ( $files as $file ) {
          $path_from_url = wp_parse_url( $file, PHP_URL_PATH );
          $uploaded_file = $uploads['basedir'] . preg_replace(
            '/.*uploads/',
            '/everest_forms_uploads',
            $path_from_url
          );
          $this->safe_delete_file( $uploaded_file, $base_dir );
        }
      }
    }

    private function safe_delete_file( $path, $allowed_base ) {
      if ( ! $allowed_base || empty( $path ) ) {
        return;
      }
      $normalized_path = wp_normalize_path( $path );
      $resolved_path   = realpath( $normalized_path );
      if ( $resolved_path && strpos( $resolved_path, $allowed_base ) === 0 ) {
        if ( is_file( $resolved_path ) ) {
          wp_delete_file( $resolved_path );
        }
      }
    }
  }
  ```
