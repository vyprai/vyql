# Rank 789 / CVE-2013-6373: Jenkins Exclusion Plugin redirect target bypass.
# Ledger verification: VYQL-RF-002 catches AdministrationPanel.doFreeResource.

test "rank789: Exclusion Plugin redirects to request-selected target"
  lang php
  expect VYQL-RF-002
  code
  ```
  <?php
  function doFreeResource() {
    $target = $_GET['redirect'];
    overlay_close_dialog($target, array('query' => array()));
  }
  ?>
  ```

test "rank789: Exclusion Plugin validates redirect target"
  lang php
  reject VYQL-RF-002
  code
  ```
  <?php
  function doFreeResource() {
    $target = $_GET['redirect'];
    if (url_is_external($target)) {
      $target = '<front>';
    }
    overlay_close_dialog($target, array('query' => array()));
  }
  ?>
  ```
