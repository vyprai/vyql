# Rank 483 / CVE-2025-55164: content-security-policy-parser preserved a
# __proto__ directive by defining it on a normal object result. The 0.6.0 fix
# parses directives into a Map instead.

test "rank483: CSP parser defines __proto__ directive on plain object"
  lang javascript
  file index.ts
  expect VYQL-INJ-105
  expect_review code.CspParserProtoDirectivePollution
  code
  ```
  interface PolicyResult {
    [key: string]: string[];
  }

  export = (policy: string): PolicyResult => {
    const result: PolicyResult = {};
    policy.split(";").forEach((directive) => {
      const [directiveKey, ...directiveValue] = directive.trim().split(/\s+/g);
      if (
        directiveKey &&
        !Object.prototype.hasOwnProperty.call(result, directiveKey)
      ) {
        if (directiveKey === "__proto__") {
          Object.defineProperty(result, directiveKey, {
            configurable: true,
            enumerable: true,
            writable: true,
            value: directiveValue,
          });
        } else {
          result[directiveKey] = directiveValue;
        }
      }
    });
    return result;
  };
  ```

test "rank483: CSP parser stores directives in Map"
  lang javascript
  file mod.ts
  reject VYQL-INJ-105
  reject_review code.CspParserProtoDirectivePollution
  code
  ```
  type ParsedContentSecurityPolicy = Map<string, string[]>;

  export default function parseContentSecurityPolicy(
    policy: string,
  ): ParsedContentSecurityPolicy {
    const result: ParsedContentSecurityPolicy = new Map();
    policy.split(";").forEach((directive) => {
      const [directiveKey, ...directiveValue] = directive.trim().split(/\s+/g);
      if (
        directiveKey &&
        !result.has(directiveKey)
      ) {
        result.set(directiveKey, directiveValue);
      }
    });
    return result;
  }
  ```
