# Rank 144 / CVE-2017-17054: aubio WAV duration divide-by-zero.
# Ledger verification: VYQL-NUM-002 catches tainted blockalign denominator use.

test "rank144: aubio divides by attacker-controlled WAV block alignment"
  lang c
  expect VYQL-NUM-002
  code
  ```
  int atoi(const char *);

  int duration(int argc, char **argv) {
      int blockalign = atoi(argv[1]);
      return 100 / blockalign;
  }
  ```

test "rank144: aubio constant block alignment is clean"
  lang c
  reject VYQL-NUM-002
  code
  ```
  int duration(int argc, char **argv) {
      int blockalign = 4;
      return 100 / blockalign;
  }
  ```
