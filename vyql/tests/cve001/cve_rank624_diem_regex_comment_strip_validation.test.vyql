# Rank 624 / CVE-2019-16214: Diem's IR parser stripped line comments with
# a multiline regex before enforcing the permitted source character set.
test "rank624: regex line-comment stripping lacks parser character whitelist"
  lang rust
  file parser.rs
  expect VYQL-VAL-006
  code
  ```
  use regex::Regex;
  use failure::*;

  fn strip_comments(string: &str) -> String {
      let line_comments = Regex::new(r"(?m)//.*$").unwrap();
      line_comments.replace_all(string, "$1").into_owned()
  }

  pub fn parse_program(program_str: &str) -> Result<ast::Program> {
      let stripped_string = &strip_comments(program_str);
      let parser = syntax::ProgramParser::new();
      parser.parse(stripped_string).map_err(|e| format_err!("{}", e))
  }
  ```

test "rank624: parser verifies characters before stripping comments"
  lang rust
  file parser.rs
  reject VYQL-VAL-006
  code
  ```
  use failure::*;

  fn is_permitted_char(c: char) -> bool {
      let x = c as u32;
      (x >= 0x20 && x <= 0x7E) || x == 0x09 || x == 0x0A
  }

  fn verify_string(string: &str) -> Result<()> {
      match string.chars().find(|c| !is_permitted_char(*c)) {
          None => Ok(()),
          Some(chr) => bail!("invalid character {}", chr),
      }
  }

  fn strip_comments(source: &str) -> String {
      let mut in_comment = false;
      let mut acc = String::with_capacity(source.len());
      let mut char_iter = source.chars().peekable();
      while let Some(chr) = char_iter.next() {
          let at_newline = chr == '\n';
          let at_or_after_slash_slash =
              in_comment || (chr == '/' && char_iter.peek().map(|c| *c == '/').unwrap_or(false));
          in_comment = !at_newline && at_or_after_slash_slash;
          acc.push(if in_comment { ' ' } else { chr });
      }
      acc
  }

  fn strip_comments_and_verify(string: &str) -> Result<String> {
      verify_string(string)?;
      Ok(strip_comments(string))
  }

  pub fn parse_program(program_str: &str) -> Result<ast::Program> {
      let stripped_string = &strip_comments_and_verify(program_str)?;
      let parser = syntax::ProgramParser::new();
      parser.parse(stripped_string).map_err(|e| format_err!("{}", e))
  }
  ```
