# Rank 729 / CVE-2024-52976: Elastic Agent allowed local parameter injection
# through osqueryd configuration by returning Windows platform arguments with
# allow_unsafe enabled. The selected elastic-agent corpus commit is the v8.15.4
# tag-tip release helper slice and does not contain the osquery source; the real
# patch lives in elastic/beats commit 70827e1, changing
# x-pack/osquerybeat/internal/osqd/osqueryd_windows.go so platformArgs returns
# nil. This spec is a runnable local regression but is skipped by the current
# fresh-target verifier.
#
# verify_current_expected: skip-fresh-target

test "rank729: Windows osquery platform args enable unsafe configuration"
  lang go
  file x-pack/osquerybeat/internal/osqd/osqueryd_windows.go
  expect VYQL-CFG-024
  expect_review code.OsqueryAllowUnsafePlatformArgs
  code
  ```
  package osqd

  func platformArgs() map[string]interface{} {
    return map[string]interface{}{
      "allow_unsafe": true,
    }
  }
  ```

test "rank729: Windows osquery platform args omit unsafe configuration"
  lang go
  file x-pack/osquerybeat/internal/osqd/osqueryd_windows.go
  reject VYQL-CFG-024
  reject_review code.OsqueryAllowUnsafePlatformArgs
  code
  ```
  package osqd

  func platformArgs() map[string]interface{} {
    return nil
  }
  ```
