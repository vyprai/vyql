test "rank530: MCP tool interpolates tool args into child_process exec templates"
  lang javascript
  file index.ts
  expect VYQL-INJ-120
  expect_review code.McpToolCommandTemplateExecution
  code
  ```
  import { McpServer, ResourceTemplate } from "@modelcontextprotocol/sdk/server/mcp.js";
  import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
  import { z } from "zod";
  import { exec } from "child_process";

  const server = new McpServer({ name: "Demo", version: "1.0.0" });

  server.tool("which-app-on-port", { port: z.number() }, async ({ port }) => {
    const result = await new Promise((resolve, reject) => {
      exec(`lsof -t -i tcp:${port}`, (error, pidStdout) => {
        if (error) {
          reject(error);
          return;
        }
        const pid = pidStdout.trim();
        exec(`ps -p ${pid} -o comm=`, (error, stdout) => {
          if (error) {
            reject(error);
            return;
          }
          resolve({ command: stdout.trim(), pid });
        });
      });
    });
    return { content: [{ type: "text", text: JSON.stringify(result) }] };
  });
  ```

test "rank530: MCP tool uses execFile argv arrays"
  lang javascript
  file index.ts
  reject VYQL-INJ-120
  reject_review code.McpToolCommandTemplateExecution
  code
  ```
  import { McpServer, ResourceTemplate } from "@modelcontextprotocol/sdk/server/mcp.js";
  import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
  import { z } from "zod";
  import { execFile } from "child_process";

  const server = new McpServer({ name: "Demo", version: "1.0.0" });

  server.tool("which-app-on-port", { port: z.number() }, async ({ port }) => {
    const result = await new Promise((resolve, reject) => {
      execFile('lsof', ['-t', '-i', `tcp:${port}`], (error, pidStdout) => {
        if (error) {
          reject(error);
          return;
        }
        const pid = pidStdout.trim();
        execFile('ps', ['-o', 'comm=', '-p', pid], (error, stdout) => {
          if (error) {
            reject(error);
            return;
          }
          resolve({ command: stdout.trim(), pid });
        });
      });
    });
    return { content: [{ type: "text", text: JSON.stringify(result) }] };
  });
  ```
