test "rank683: Drawnix global debug console value reaches innerHTML"
  lang javascript
  file app.tsx
  expect VYQL-INJ-004
  code
  ```
  function App() {
    return <Drawnix
      afterInit={(board) => {
        (window as any)['__drawnix__web__console'] = (value: string) => {
          addDebugLog(board, value);
        };
      }}
    />;
  }

  const addDebugLog = (board: PlaitBoard, value: string) => {
    const div = document.createElement('div');
    div.innerHTML = value;
    document.body.append(div);
  };
  ```

test "rank683: helper remains but global debug console is not exposed"
  lang javascript
  file app.tsx
  reject VYQL-INJ-004
  code
  ```
  function App() {
    return <Drawnix
      afterInit={(board) => {
        console.log('board initialized');
      }}
    />;
  }

  const addDebugLog = (board: PlaitBoard, value: string) => {
    const div = document.createElement('div');
    div.innerHTML = value;
    document.body.append(div);
  };
  ```
