test "rank314: cap-std Windows reserved device denylist misses superscript COM/LPT names"
  lang rust
  expect VYQL-PATH-010
  expect_review code.WindowsReservedDeviceNameBypass
  code
  ```
  use std::path::Path;
  use std::{fs, io};

  mod manually {
      use std::{fs, io};
      use std::path::Path;

      pub fn open(_start: &fs::File, _path: &Path, _options: &OpenOptions) -> io::Result<fs::File> {
          unimplemented!()
      }

      pub struct OpenOptions;
  }
  use manually::OpenOptions;

  pub(crate) fn open_impl(start: &fs::File, path: &Path, options: &OpenOptions) -> io::Result<fs::File> {
      if let Some(stem) = path.file_stem() {
          if let Some(stemstr) = stem.to_str() {
              match stemstr.to_uppercase().as_str() {
                  "CON" | "PRN" | "AUX" | "NUL" | "COM0" | "COM1" | "COM2" | "COM3" | "COM4"
                  | "COM5" | "COM6" | "COM7" | "COM8" | "COM9" | "LPT0" | "LPT1" | "LPT2"
                  | "LPT3" | "LPT4" | "LPT5" | "LPT6" | "LPT7" | "LPT8" | "LPT9" => {
                      return Err(io::Error::from_raw_os_error(2));
                  }
                  _ => {}
              }
          }
      }

      manually::open(start, path, options)
  }
  ```

