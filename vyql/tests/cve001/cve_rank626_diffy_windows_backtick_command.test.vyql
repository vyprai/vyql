# Rank 626 / CVE-2022-33127: diffy built a Windows shell command from
# diff options and file paths, then executed it with Ruby backticks.
test "rank626: Windows diff path uses shell command string"
  lang ruby
  file diff.rb
  expect VYQL-INJ-135
  code
  ```
  module Diffy
    class Diff
      def diff
        if WINDOWS
          cmd = sprintf '"%s" %s %s', diff_bin, diff_options.join(' '), @paths.map { |s| %("#{s}") }.join(' ')
          diff = `#{cmd}`
        else
          diff = Open3.popen3(diff_bin, *(diff_options + @paths)) { |i, o, e| o.read }
        end
      end
    end
  end
  ```

test "rank626: diff executes through argv-style Open3 capture"
  lang ruby
  file diff.rb
  reject VYQL-INJ-135
  code
  ```
  module Diffy
    class Diff
      def diff
        diff, stderr, process_status = Open3.capture3(diff_bin, *(diff_options + @paths))
      end
    end
  end
  ```
