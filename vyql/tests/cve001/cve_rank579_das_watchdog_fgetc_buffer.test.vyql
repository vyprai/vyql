test "rank579: fgetc loop must not write past a fixed stack buffer"
  lang c
  expect VYQL-MEM-032
  code
  ```
  #include <stdio.h>
  #include <string.h>

  static char *get_pid_environ_val(int pid, char *val) {
      char temp[500];
      int i = 0;
      int foundit = 0;
      FILE *fp;

      sprintf(temp, "/proc/%d/environ", pid);
      fp = fopen(temp, "r");
      if (fp == NULL) {
          return NULL;
      }

      for (;;) {
          temp[i] = fgetc(fp);
          if (foundit == 1 && (temp[i] == 0 || temp[i] == EOF)) {
              temp[i] = 0;
              return temp;
          }
          i++;
      }
  }
  ```

test "rank579: fgetc loop grows the buffer before writing"
  lang c
  reject VYQL-MEM-032
  code
  ```
  #include <stdio.h>
  #include <stdlib.h>

  static char *get_pid_environ_val(int pid, char *val) {
      int temp_size = 500;
      char *temp = malloc(temp_size);
      int i = 0;
      FILE *fp;

      sprintf(temp, "/proc/%d/environ", pid);
      fp = fopen(temp, "r");
      if (fp == NULL) {
          return NULL;
      }

      for (;;) {
          if (i >= temp_size) {
              temp_size *= 2;
              temp = realloc(temp, temp_size);
          }
          temp[i] = fgetc(fp);
          if (temp[i] == EOF) {
              return NULL;
          }
          i++;
      }
  }
  ```

test "rank579: unbounded fgetc fixed buffer generalizes across names"
  lang c
  expect VYQL-MEM-032
  code
  ```
  int fgetc(void *stream);

  static char *read_env(void *stream) {
    char scratch[128];
    int offset = 0;
    for (;;) {
      scratch[offset] = fgetc(stream);
      offset++;
    }
    return scratch;
  }
  ```
