test "rank183: Axis fork reports relative path on missing JWS file"
  lang java
  file JWSHandler.java
  reject VYQL-SEC-004
  code
  ```
  import java.io.File;
  import java.io.FileNotFoundException;
  import java.io.FileReader;

  class JWSHandler {
    void setupService(MessageContext msgContext) throws Exception {
      String realpath = msgContext.getStrProp(Constants.MC_REALPATH);
      String jwsFile = realpath;
      String rel = msgContext.getStrProp(Constants.MC_RELATIVE_PATH);
      File f2 = new File(jwsFile);
      if (!f2.exists()) {
        throw new FileNotFoundException(rel);
      }
      FileReader fr = new FileReader(jwsFile);
    }
  }
  ```
