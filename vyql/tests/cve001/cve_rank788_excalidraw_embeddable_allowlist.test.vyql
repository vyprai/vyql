# Rank 788 / CVE-2024-32472: Excalidraw allowed an attacker-hostable
# embeddable domain in the same-origin iframe allowlist.

test "rank788: Excalidraw embeddable allowlist includes dddice"
  lang javascript
  file embeddable.ts
  expect VYQL-INJ-020
  code
  ```
  const ALLOWED_DOMAINS = new Set([
    "youtube.com",
    "figma.com",
    "dddice.com",
  ]);
  ```

test "rank788: Excalidraw embeddable allowlist removes dddice"
  lang javascript
  file embeddable.ts
  reject VYQL-INJ-020
  code
  ```
  const ALLOWED_DOMAINS = new Set([
    "youtube.com",
    "figma.com",
  ]);

  const ALLOW_SAME_ORIGIN = new Set([
    "youtube.com",
    "figma.com",
  ]);
  ```
