module tests.cve.rank715.echo_static_posix_clean;

# verify_current_expected: skip-fresh-target
# Rank 715 / CVE-2020-36565: Labstack Echo used POSIX path.Clean for a
# Windows filesystem path after URL decoding, so backslash dot segments could
# traverse out of the configured static root.

test "rank715: Go static handler cleans URL path with path.Clean before filesystem join"
  lang go
  file middleware/static.go
  expect VYQL-PATH-059
  code
  ```
  package middleware

  import (
    "net/url"
    "os"
    "path"
    "path/filepath"
  )

  type Context interface {
    Path() string
    Param(string) string
    File(string) error
  }

  type StaticConfig struct{ Root string }

  func StaticWithConfig(config StaticConfig) func(Context) error {
    return func(ctx Context) error {
      requestPath := "/assets/index.html"
      if strings.HasSuffix(ctx.Path(), "*") {
        requestPath = ctx.Param("*")
      }
      decoded, err := url.PathUnescape(requestPath)
      if err != nil {
        return err
      }
      target := filepath.Join(config.Root, path.Clean("/"+decoded))
      if _, err := os.Stat(target); err != nil {
        return err
      }
      return ctx.File(target)
    }
  }
  ```

test "rank715: Go static handler uses filepath.Clean before filesystem join"
  lang go
  file middleware/static.go
  reject VYQL-PATH-059
  code
