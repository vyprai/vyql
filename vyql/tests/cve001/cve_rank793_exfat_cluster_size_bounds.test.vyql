# Rank 793 / CVE-2015-8026: exfat allocated CLUSTER_SIZE(*sb) before validating
# the sector and sectors-per-cluster shift fields from the filesystem header.

test "rank793: exfat cluster allocation before sector-bit lower bound"
  lang c
  file mount.c
  expect VYQL-MEM-039
  expect_review code.ShiftedClusterSizeAllocationMissingBounds
  code
  ```
  int exfat_mount(struct exfat* ef) {
    ef->zero_cluster = malloc(CLUSTER_SIZE(*ef->sb));
    if (ef->zero_cluster == NULL) {
      return -ENOMEM;
    }
    if (!verify_vbr_checksum(ef->dev, ef->zero_cluster, SECTOR_SIZE(*ef->sb))) {
      free(ef->zero_cluster);
      return -EIO;
    }
    if ((int) ef->sb->sector_bits + (int) ef->sb->spc_bits > 25) {
      free(ef->zero_cluster);
      return -EIO;
    }
    return 0;
  }
  ```

test "rank793: exfat validates sector-bit lower bound before cluster allocation"
  lang c
  file mount.c
  reject VYQL-MEM-039
  reject_review code.ShiftedClusterSizeAllocationMissingBounds
  code
  ```
  int exfat_mount(struct exfat* ef) {
    if (ef->sb->sector_bits < 9) {
      free(ef->sb);
      return -EIO;
    }
    if ((int) ef->sb->sector_bits + (int) ef->sb->spc_bits > 25) {
      free(ef->sb);
      return -EIO;
    }
    ef->zero_cluster = malloc(CLUSTER_SIZE(*ef->sb));
    if (ef->zero_cluster == NULL) {
      return -ENOMEM;
    }
    if (!verify_vbr_checksum(ef->dev, ef->zero_cluster, SECTOR_SIZE(*ef->sb))) {
      free(ef->zero_cluster);
      return -EIO;
    }
    return 0;
  }
  ```

test "rank793: shifted cluster allocation generalizes across names"
  lang c
  file mount.c
  expect VYQL-MEM-039
  expect_review code.ShiftedClusterSizeAllocationMissingBounds
  code
  ```
  int verify_vbr_checksum(void *dev, void *buf, int sz);
  void *malloc(int sz);
  #define CLUSTER_SIZE(sb) (1 << ((sb).sector_bits + (sb).spc_bits))
  #define SECTOR_SIZE(sb) (1 << (sb).sector_bits)

  int mount_volume(struct exfat *vol) {
    vol->zero_cluster = malloc(CLUSTER_SIZE(*vol->sb));
    if (!verify_vbr_checksum(vol->dev, vol->zero_cluster, SECTOR_SIZE(*vol->sb))) {
      return -1;
    }
    if ((int)vol->sb->sector_bits + (int)vol->sb->spc_bits > 25) {
      return -1;
    }
    return 0;
  }
  ```
