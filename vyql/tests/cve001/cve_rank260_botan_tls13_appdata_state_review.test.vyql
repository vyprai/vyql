test "rank260: Botan TLS 1.3 accepts application data before handshake completion check"
  lang cpp
  expect VYQL-AUTH-082
  expect_review code.ProtocolStateReview
  code
  ```
  enum class Record_Type { Handshake, ChangeCipherSpec, ApplicationData, Alert };
  struct Record {
    Record_Type type;
    int seq_no;
    int fragment;
  };
  class Channel_Impl_13 {
    bool is_handshake_complete();
    void process_dummy_change_cipher_spec();
    void process_alert(int fragment);
    struct Callbacks {
      void tls_record_received(int seq_no, int fragment);
    };
    Callbacks& callbacks();

    void from_peer_record(const Record& record) {
      if(record.type == Record_Type::Handshake) {
        if(!is_handshake_complete()) {
          return;
        }
      } else if(record.type == Record_Type::ChangeCipherSpec) {
        process_dummy_change_cipher_spec();
      } else if(record.type == Record_Type::ApplicationData) {
        callbacks().tls_record_received(record.seq_no, record.fragment);
      } else if(record.type == Record_Type::Alert) {
        process_alert(record.fragment);
      }
    }
  };
  ```

test "rank260: TLS application data state review generalizes across names"
  lang cpp
  expect VYQL-AUTH-082
  expect_review code.ProtocolStateReview
  code
  ```
  enum class Record_Type { ApplicationData, Alert };
  struct Packet { Record_Type type; int seq_no; int fragment; };
  struct Hooks { void tls_record_received(int seq, int body); };
  Hooks& callbacks();

  void accept_record(const Packet& pkt) {
    if (pkt.type == Record_Type::ApplicationData) {
      callbacks().tls_record_received(pkt.seq_no, pkt.fragment);
    }
  }
  ```

test "rank260: Botan TLS 1.3 checks application traffic decryptability before application data"
  lang cpp
  reject VYQL-AUTH-082
  reject_review code.ProtocolStateReview
  code
  ```
  enum class Record_Type { Handshake, ChangeCipherSpec, ApplicationData, Alert };
  struct Cipher_State {
    bool can_decrypt_application_traffic();
  };
  struct Record {
    Record_Type type;
    int seq_no;
    int fragment;
  };
  class Channel_Impl_13 {
    Cipher_State* m_cipher_state;
    bool is_handshake_complete();
    void process_dummy_change_cipher_spec();
    void process_alert(int fragment);
    struct Callbacks {
      void tls_record_received(int seq_no, int fragment);
    };
    Callbacks& callbacks();

    void from_peer_record(const Record& record) {
      if(record.type == Record_Type::Handshake) {
        if(!is_handshake_complete()) {
          return;
        }
      } else if(record.type == Record_Type::ChangeCipherSpec) {
        process_dummy_change_cipher_spec();
      } else if(record.type == Record_Type::ApplicationData) {
        if(!m_cipher_state->can_decrypt_application_traffic()) {
          throw 1;
        }
        callbacks().tls_record_received(record.seq_no, record.fragment);
      } else if(record.type == Record_Type::Alert) {
        process_alert(record.fragment);
      }
    }
  };
  ```
