test "rank213: PHP request global copied to template variable and echoed is XSS"
  lang php
  expect VYQL-INJ-039
  code
  ```
  <?php
  $GLOBALS['server'] = !empty($_GET['server']) ? $_GET['server'] : '';

  class Console {
      protected $_globalVar = array();
      protected $_tplVars = array();

      protected function __init() {
          $this->_globalVar = array('server' => $GLOBALS['server']);
          $this->_tplVars = $this->_globalVar;
      }

      protected function render() {
          $server = $this->_tplVars['server'];
          ?>
          <a href="./?server=<?php echo $server ?>"><?php echo $server ?></a>
          <?php
      }
  }
  ```

test "rank213: PHP request global escaped before template copy is clean"
  lang php
  reject VYQL-INJ-039
  code
  ```
  <?php
  $GLOBALS['server'] = !empty($_GET['server']) ? htmlspecialchars($_GET['server']) : '';

  class Console {
      protected $_globalVar = array();
      protected $_tplVars = array();

      protected function __init() {
          $this->_globalVar = array('server' => $GLOBALS['server']);
          $this->_tplVars = $this->_globalVar;
      }

      protected function render() {
          $server = $this->_tplVars['server'];
          ?>
          <a href="./?server=<?php echo $server ?>"><?php echo $server ?></a>
          <?php
      }
  }
  ```
