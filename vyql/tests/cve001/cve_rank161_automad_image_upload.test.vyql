test "cve rank 161: Automad image extension from request reaches upload write"
  lang php
  expect VYQL-INJ-015
  code
  ```
  <?php
  class Request {
    public static function post($key) {
      return $_POST[$key];
    }
  }

  class FileUtils {
    public static function allowedFileTypes() {
      return array('jpg', 'png');
    }
  }

  class Str {
    public static function slug($value) {
      return preg_replace('/[^a-z0-9]+/', '-', $value);
    }
  }

  class FileSystem {
    public static function write($file, $content) {
      file_put_contents($file, $content);
    }
  }

  class Image {
    public static function save($path, $name, $extension, $base64) {
      if (!in_array($extension, FileUtils::allowedFileTypes())) {
        return;
      }

      $data = base64_decode($base64);
      $name = $path . Str::slug($name) . '.' . $extension;
      FileSystem::write($name, $data);
    }
  }

  Image::save(
    '/media/',
    Request::post('name'),
    Request::post('extension'),
    Request::post('imageBase64')
  );
  ?>
  ```
