# An installer entry point that stays reachable after the application is
# installed rewrites the live configuration file from request input: the
# database credentials, the salt and the site root all come from the POST
# body, and nothing asks whether a configuration already exists, so any
# request to the installer owns the configuration the application loads next.
# The php binding labels the module-context shape and rule VYQL-AUTH-176
# judges it; the installed-state guard at the top of the file removes the
# label, because the guard's own literal names the file being written.

test "rank166: AVideo installer can recreate live configuration without an access gate"
  lang php
  expect VYQL-AUTH-176
  expect_review code.PrivilegedEntryPointReview
  code
  ```
  <?php
  header('Content-Type: application/json');
  $obj = new stdClass();
  $obj->post = $_POST;

  if (!file_exists($_POST['systemRootPath'] . "index.php")) {
      $obj->error = "bad root";
      echo json_encode($obj);
      exit;
  }

  $content = "<?php
  $global['webSiteRootURL'] = '{$_POST['webSiteRootURL']}';
  $global['systemRootPath'] = '{$_POST['systemRootPath']}';
  $mysqlHost = '{$_POST['databaseHost']}';
  require_once $global['systemRootPath'].'objects/include_config.php';
  ";

  $fp = fopen($_POST['systemRootPath'] . "videos/configuration.php", "wb");
  fwrite($fp, $content);
  fclose($fp);
  echo json_encode($obj);
  ```

test "rank166: AVideo installer refuses to recreate an existing configuration"
  lang php
  reject VYQL-AUTH-176
  reject_review code.PrivilegedEntryPointReview
  code
  ```
  <?php
  if (file_exists("../videos/configuration.php")) {
      error_log("Can not create configuration again: " . json_encode($_SERVER));
      exit;
  }

  header('Content-Type: application/json');
  $obj = new stdClass();
  $obj->post = $_POST;

  if (!file_exists($_POST['systemRootPath'] . "index.php")) {
      $obj->error = "bad root";
      echo json_encode($obj);
      exit;
  }

  $content = "<?php
  $global['webSiteRootURL'] = '{$_POST['webSiteRootURL']}';
  $global['systemRootPath'] = '{$_POST['systemRootPath']}';
  $mysqlHost = '{$_POST['databaseHost']}';
  require_once $global['systemRootPath'].'objects/include_config.php';
  ";

  $fp = fopen($_POST['systemRootPath'] . "videos/configuration.php", "wb");
  fwrite($fp, $content);
  fclose($fp);
  echo json_encode($obj);
  ```
