test "rank724: newsletter invalid email feedback strips tags without HTML escaping"
  lang php
  file lettreinfo.php
  expect VYQL-INJ-034
  expect_review code.IncompleteHtmlEntityEscape
  code
  ```
  <?php
  function style_newsletter() {
    global $news_reg_return;
    if (isset($_POST['news_email'])) {
      $email = stripslashes($_POST['news_email']);
      if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
        $news_reg_return.= strip_tags($email).' : '.__('invalid address', 'eelv_lettreinfo');
      }
    }
  }
  function get_news_form() {
    global $news_reg_return;
    if ($news_reg_return != '') {
      echo "<div class='news_return'>$news_reg_return</div>";
    }
  }
  ```

test "rank724: newsletter invalid email feedback is entity escaped"
  lang php
  file lettreinfo.php
  reject VYQL-INJ-034
  reject_review code.IncompleteHtmlEntityEscape
  code
  ```
  <?php
  function style_newsletter() {
    global $news_reg_return;
    if (isset($_POST['news_email'])) {
      $email = stripslashes($_POST['news_email']);
      if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
        $news_reg_return.= '<b>'.htmlspecialchars(strip_tags($email)).'</b> : '.__('invalid address', 'eelv_lettreinfo');
      }
    }
  }
  function get_news_form() {
    global $news_reg_return;
    if ($news_reg_return != '') {
      echo "<div class='news_return'>$news_reg_return</div>";
    }
  }
  ```
