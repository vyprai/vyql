test "rank330: CasaOS gateway forwards spoofable client IP headers"
  lang go
  expect VYQL-AUTH-012
  expect_review code.ProxyClientIpSpoofingBypass
  code
  ```
  package route

  import "net/http"

  type GatewayRoute struct {
      management *Management
  }

  type Management struct{}
  type Proxy struct{}

  func (m *Management) GetProxy(path string) *Proxy { return &Proxy{} }
  func (p *Proxy) ServeHTTP(w http.ResponseWriter, r *http.Request) {}

  func (g *GatewayRoute) GetRoute() *http.ServeMux {
      gatewayMux := http.NewServeMux()
      gatewayMux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
          proxy := g.management.GetProxy(r.URL.Path)
          if proxy == nil {
              w.WriteHeader(http.StatusNotFound)
              return
          }
          proxy.ServeHTTP(w, r)
      })
      return gatewayMux
  }
  ```

test "rank330: CasaOS gateway normalizes client IP headers before proxying"
  lang go
  reject VYQL-AUTH-012
  reject_review code.ProxyClientIpSpoofingBypass
  code
  ```
  package route

  import "net/http"

  type GatewayRoute struct {
      management *Management
  }

  type Management struct{}
  type Proxy struct{}

  func (m *Management) GetProxy(path string) *Proxy { return &Proxy{} }
  func (p *Proxy) ServeHTTP(w http.ResponseWriter, r *http.Request) {}
  func rewriteRequestSourceIP(r *http.Request) {}

  func (g *GatewayRoute) GetRoute() *http.ServeMux {
      gatewayMux := http.NewServeMux()
      gatewayMux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
          proxy := g.management.GetProxy(r.URL.Path)
          if proxy == nil {
              w.WriteHeader(http.StatusNotFound)
              return
          }
          rewriteRequestSourceIP(r)
          proxy.ServeHTTP(w, r)
      })
      return gatewayMux
  }
  ```
