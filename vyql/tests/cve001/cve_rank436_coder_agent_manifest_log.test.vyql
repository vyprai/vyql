# Rank 436 / CVE-2025-66411: Coder logged workspace-agent manifest
# protobufs at info level, exposing sensitive manifest values in logs.

test "rank436: Coder agent logs raw workspace manifest field at info level"
  lang go
  expect VYQL-SEC-011
  expect_review code.CoderAgentManifestInfoLog
  code
  ```
  package agent

  import "context"

  func (a *agent) handleManifest(manifestOK *checkpoint) func(ctx context.Context, aAPI api) error {
      return func(ctx context.Context, aAPI api) error {
          mp, err := aAPI.GetManifest(ctx, &proto.GetManifestRequest{})
          if err != nil {
              return err
          }
          a.logger.Info(ctx, "fetched manifest", slog.F("manifest", mp))
          manifest, err := agentsdk.ManifestFromProto(mp)
          if err != nil {
              a.logger.Critical(ctx, "failed to convert manifest", slog.F("manifest", mp), slog.Error(err))
              return err
          }
          _ = manifest
          return nil
      }
  }
  ```

test "rank436: Coder agent omits raw manifest field from info log"
  lang go
  reject VYQL-SEC-011
  reject_review code.CoderAgentManifestInfoLog
  code
  ```
