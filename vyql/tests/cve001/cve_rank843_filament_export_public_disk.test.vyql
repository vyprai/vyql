# Rank 843 / CVE-2024-51758: Filament exports inherited the default
# filesystem disk, which is public by default, before remapping public exports
# to local/private storage.

test "rank843: export helper returns default filesystem disk without public fallback"
  lang php
  file Exporter.php
  expect VYQL-CFG-021
  expect_review code.ExportDefaultPublicFilesystemDisk
  code
  ```
  <?php
  abstract class Exporter
  {
      public function getFileDisk(): string
      {
          return config('filament.default_filesystem_disk');
      }
  }
  ```

test "rank843: export helper remaps public default disk to local storage"
  lang php
  file Exporter.php
  reject VYQL-CFG-021
  reject_review code.ExportDefaultPublicFilesystemDisk
  code
  ```
  <?php
  abstract class Exporter
  {
      public function getFileDisk(): string
      {
          $disk = config('filament.default_filesystem_disk');

          if (($disk === 'public') && array_key_exists('local', config('filesystems.disks'))) {
              return 'local';
          }

          return $disk;
      }
  }
  ```
