test "rank292: bzip2-rs narrows slice lengths into libbzip2 c_uint fields"
lang rust
expect VYQL-NUM-008
code
```
use libc::{c_int, c_uint};

mod ffi {
    use libc::c_int;

    pub fn BZ2_bzDecompress<T>(_raw: &mut T) -> c_int {
        0
    }
}

struct Raw {
    avail_in: c_uint,
    avail_out: c_uint,
}

struct Stream {
    raw: Raw,
}

pub struct Decompress {
    inner: Stream,
}

impl Decompress {
    pub fn decompress(&mut self, input: &[u8], output: &mut [u8]) {
        self.inner.raw.avail_in = input.len() as c_uint;
        self.inner.raw.avail_out = output.len() as c_uint;
        ffi::BZ2_bzDecompress(&mut self.inner.raw);
    }
}
```

test "rank292: bzip2-rs clamps slice lengths before c_uint casts"
lang rust
reject VYQL-NUM-008
code
```
use libc::{c_int, c_uint};

mod ffi {
    use libc::c_int;

    pub fn BZ2_bzDecompress<T>(_raw: &mut T) -> c_int {
        0
    }
}

struct Raw {
    avail_in: c_uint,
    avail_out: c_uint,
}

struct Stream {
    raw: Raw,
}

pub struct Decompress {
    inner: Stream,
}

impl Decompress {
    pub fn decompress(&mut self, input: &[u8], output: &mut [u8]) {
        self.inner.raw.avail_in = input.len().min(c_uint::MAX as usize) as c_uint;
        self.inner.raw.avail_out = output.len().min(c_uint::MAX as usize) as c_uint;
        ffi::BZ2_bzDecompress(&mut self.inner.raw);
    }
}
```
