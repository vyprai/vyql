# Rank 764 / CVE-2013-3364: ep_imageconvert quoted request-derived
# filenames into shell command strings before invoking child_process.exec.

test "rank764: image conversion helper passes request filename through child_process.exec"
  lang javascript
  file imageConvert.js
  expect VYQL-INJ-002
  code
  ```
  const path = require('path');
  const child_process = require('child_process');

  function prepareExecArgs(args) {
    if (!args.length) return "";
    return "'" + args.join("' '") + "'";
  }

  function getPages(filename, cb) {
    child_process.exec(
      prepareExecArgs([path.normalize(path.join(__dirname, "..", "getPages.sh")), filename]),
      cb
    );
  }

  exports.onRequest = function(req, res) {
    const filePath = path.normalize(path.join("/uploads", req.params.filename));
    getPages(filePath, function () {});
  };
  ```

test "rank764: image conversion helper uses execFile argv array"
  lang javascript
  file imageConvert.js
  reject VYQL-INJ-002
  code
  ```
  const path = require('path');
  const child_process = require('child_process');

  function getPages(filename, cb) {
    child_process.execFile(
      path.normalize(path.join(__dirname, "..", "getPages.sh")),
      [filename],
      cb
    );
  }

  exports.onRequest = function(req, res) {
    const filePath = path.normalize(path.join("/uploads", req.params.filename));
    getPages(filePath, function () {});
  };
  ```
