# Rank 857 / CVE-2026-34232: Firebird xdr_status_vector treated unknown
# status-vector argument tags as numeric arguments and could crash on cstring.

test "rank857: C++ status vector parser falls back on unknown argument tags"
  lang cpp
  file protocol.cpp
  expect VYQL-DOS-033
  expect_review code.ProtocolStatusVectorUnknownArgumentFallback
  code
  ```
  static bool_t xdr_status_vector(XDR* xdrs, DynamicStatusVector*& vector)
  {
      StaticStatusVector vectorDecode;
      const ISC_STATUS* vectorEncode = vector->value();
      SLONG vec;

      while (true)
      {
          if (xdrs->x_op == XDR_ENCODE)
              vec = *vectorEncode++;
          if (!xdr_long(xdrs, &vec))
              goto brk;
          if (xdrs->x_op == XDR_DECODE)
              vectorDecode.push((ISC_STATUS) vec);

          switch (static_cast<ISC_STATUS>(vec))
          {
          case isc_arg_end:
              goto brk;

          case isc_arg_interpreted:
          case isc_arg_string:
          case isc_arg_sql_state:
              if (xdrs->x_op == XDR_ENCODE)
                  xdr_wrapstring(xdrs, (SCHAR**)(vectorEncode++));
              else
              {
                  SCHAR* sp = NULL;
                  xdr_wrapstring(xdrs, &sp);
                  vectorDecode.push((ISC_STATUS)(IPTR) sp);
              }
              break;

          case isc_arg_number:
          default:
              if (xdrs->x_op == XDR_ENCODE)
                  vec = *vectorEncode++;
              if (!xdr_long(xdrs, &vec))
                  goto brk;
              if (xdrs->x_op == XDR_DECODE)
                  vectorDecode.push((ISC_STATUS) vec);
              break;
          }
      }
  brk:
      return true;
  }
  ```

test "rank857: C++ status vector parser enumerates numeric tags and rejects unknown tags"
  lang cpp
  file protocol.cpp
  reject VYQL-DOS-033
  reject_review code.ProtocolStatusVectorUnknownArgumentFallback
  code
  ```
  static bool_t xdr_status_vector(XDR* xdrs, DynamicStatusVector*& vector)
  {
      StaticStatusVector vectorDecode;
      const ISC_STATUS* vectorEncode = vector->value();
      SLONG vec;

      while (true)
      {
          if (xdrs->x_op == XDR_ENCODE)
              vec = *vectorEncode++;
          if (!xdr_long(xdrs, &vec))
              goto brk;
          if (xdrs->x_op == XDR_DECODE)
              vectorDecode.push((ISC_STATUS) vec);

          switch (static_cast<ISC_STATUS>(vec))
          {
          case isc_arg_end:
              goto brk;

          case isc_arg_interpreted:
          case isc_arg_string:
          case isc_arg_sql_state:
              if (xdrs->x_op == XDR_ENCODE)
                  xdr_wrapstring(xdrs, (SCHAR**)(vectorEncode++));
              else
              {
                  SCHAR* sp = NULL;
                  xdr_wrapstring(xdrs, &sp);
                  vectorDecode.push((ISC_STATUS)(IPTR) sp);
              }
              break;

          case isc_arg_number:
          case isc_arg_unix:
          case isc_arg_win32:
          case isc_arg_gds:
          case isc_arg_warning:
          case isc_arg_next_mach:
              if (xdrs->x_op == XDR_ENCODE)
                  vec = *vectorEncode++;
              if (!xdr_long(xdrs, &vec))
                  goto brk;
              if (xdrs->x_op == XDR_DECODE)
                  vectorDecode.push((ISC_STATUS) vec);
              break;

          default:
              goto brk;
          }
      }
  brk:
      return true;
  }
  ```
