# Rank 776 / CVE-2018-16886: etcd accepted TLS certificate CommonName
# authentication for gRPC-gateway proxy requests.
test "rank776: gRPC TLS CommonName auth lacks gateway metadata rejection"
  lang go
  expect VYQL-AUTH-052
  expect_review code.GrpcGatewayCommonNameAuthenticationBypass
  code
  ```
  package auth

  import (
      "context"

      "google.golang.org/grpc/credentials"
      "google.golang.org/grpc/peer"
  )

  type AuthInfo struct {
      Username string
      Revision uint64
  }

  type authStore struct{}

  func (as *authStore) Revision() uint64 { return 1 }

  func (as *authStore) AuthInfoFromTLS(ctx context.Context) (ai *AuthInfo) {
      peerInfo, ok := peer.FromContext(ctx)
      if !ok || peerInfo == nil || peerInfo.AuthInfo == nil {
          return nil
      }

      tlsInfo := peerInfo.AuthInfo.(credentials.TLSInfo)
      for _, chains := range tlsInfo.State.VerifiedChains {
          if len(chains) < 1 {
              continue
          }
          ai = &AuthInfo{
              Username: chains[0].Subject.CommonName,
              Revision: as.Revision(),
          }
          break
      }
      return ai
  }
  ```

test "rank776: gRPC TLS CommonName auth rejects gateway metadata"
  lang go
  reject VYQL-AUTH-052
  reject_review code.GrpcGatewayCommonNameAuthenticationBypass
  code
  ```
  package auth

  import (
      "context"

      "google.golang.org/grpc/credentials"
      "google.golang.org/grpc/metadata"
      "google.golang.org/grpc/peer"
  )

  type AuthInfo struct {
      Username string
      Revision uint64
  }

  type authStore struct{}

  func (as *authStore) Revision() uint64 { return 1 }

  func (as *authStore) AuthInfoFromTLS(ctx context.Context) (ai *AuthInfo) {
      peerInfo, ok := peer.FromContext(ctx)
      if !ok || peerInfo == nil || peerInfo.AuthInfo == nil {
          return nil
      }

      tlsInfo := peerInfo.AuthInfo.(credentials.TLSInfo)
      for _, chains := range tlsInfo.State.VerifiedChains {
          if len(chains) < 1 {
              continue
          }
          ai = &AuthInfo{
              Username: chains[0].Subject.CommonName,
              Revision: as.Revision(),
          }
          md, ok := metadata.FromIncomingContext(ctx)
          if !ok {
              return nil
          }
          if gw := md["grpcgateway-accept"]; len(gw) > 0 {
              return nil
          }
          break
      }
      return ai
  }
  ```
