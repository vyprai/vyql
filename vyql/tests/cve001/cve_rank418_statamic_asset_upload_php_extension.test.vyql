# Rank 418 / CVE-2023-47129: Statamic front-end Forms asset fields accepted
# PHP files that were crafted to look like images because asset uploads used
# only Laravel's generic "file" rule.

test "rank418: Statamic asset form uploads use only generic file validation"
  lang php
  file FormController.php
  expect VYQL-INJ-075
  expect_review code.StatamicAssetUploadPhpExtensionValidationBypass
  code
  ```
  <?php
  class FormController
  {
      protected function extraRules($fields)
      {
          $assetFieldRules = $fields->all()
              ->filter(function ($field) {
                  return $field->fieldtype()->handle() === 'assets';
              })
              ->mapWithKeys(function ($field) {
                  return [$field->handle().'.*' => 'file'];
              })
              ->all();

          return $assetFieldRules;
      }
  }
  ```

test "rank418: Statamic asset form uploads reject PHP executable extensions"
  lang php
  file FormController.php
  reject VYQL-INJ-075
  reject_review code.StatamicAssetUploadPhpExtensionValidationBypass
  code
  ```
  <?php
  class FormController
  {
      protected function extraRules($fields)
      {
          $assetFieldRules = $fields->all()
              ->filter(function ($field) {
                  return $field->fieldtype()->handle() === 'assets';
              })
              ->mapWithKeys(function ($field) {
                  return [$field->handle().'.*' => ['file', function ($attribute, $value, $fail) {
                      if (in_array(trim(strtolower($value->getClientOriginalExtension())), ['php', 'php3', 'php4', 'php5', 'phtml'])) {
                          $fail(__('validation.uploaded'));
                      }
                  }]];
              })
              ->all();

          return $assetFieldRules;
      }
  }
  ```
