# Rank 412 / CVE-2023-25015: Clockwork Web < 0.1.2 did not enable Rails
# forgery protection around the POST action that enables or disables jobs.

test "rank412: Clockwork Web job action changes scheduler state without forgery protection"
  lang ruby
  expect VYQL-RF-015
  expect_review code.ClockworkWebJobCsrf
  code
  ```
  module ClockworkWeb
    class HomeController < ActionController::Base
      http_basic_authenticate_with name: ENV["CLOCKWORK_USERNAME"], password: ENV["CLOCKWORK_PASSWORD"] if ENV["CLOCKWORK_PASSWORD"]

      def job
        job = params[:job]
        enable = params[:enable] == "true"
        if enable
          ClockworkWeb.enable(job)
        else
          ClockworkWeb.disable(job)
        end
        redirect_to root_path
      end
    end
  end
  ```

test "rank412: Clockwork Web job action uses Rails forgery protection"
  lang ruby
  reject VYQL-RF-015
  reject_review code.ClockworkWebJobCsrf
  code
  ```
  module ClockworkWeb
    class HomeController < ActionController::Base
      protect_from_forgery with: :exception
      http_basic_authenticate_with name: ENV["CLOCKWORK_USERNAME"], password: ENV["CLOCKWORK_PASSWORD"] if ENV["CLOCKWORK_PASSWORD"]

      def job
        job = params[:job]
        enable = params[:enable] == "true"
        if enable
          ClockworkWeb.enable(job)
        else
          ClockworkWeb.disable(job)
        end
        redirect_to root_path
      end
    end
  end
  ```
