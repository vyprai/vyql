# Rank 997 / CVE-2025-58157: gnark depended on a vulnerable gnark-crypto
# pseudo-version before bumping to the fake-GLV fix.

test "rank997: vulnerable gnark crypto dependency is flagged"
  lang go
  file gnark.go
  code
  ```
  package gnark
  ```
  file go.mod
  expect VYQL-SCA-001
  code
  ```
  module github.com/consensys/gnark

  go 1.23

  require (
      github.com/consensys/gnark-crypto v0.17.1-0.20250415081852-c838dcdfa844
      github.com/stretchr/testify v1.10.0
  )
  ```

test "rank997: patched gnark crypto dependency is clean"
  lang go
  file gnark.go
  code
  ```
  package gnark
  ```
  file go.mod
  reject VYQL-SCA-001
  code
  ```
  module github.com/consensys/gnark

  go 1.23

  require (
      github.com/consensys/gnark-crypto v0.17.1-0.20250502112255-56600883e0e9
      github.com/stretchr/testify v1.10.0
  )
  ```
