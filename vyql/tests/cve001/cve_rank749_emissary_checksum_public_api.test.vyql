# Rank 749 / CVE-2025-27508: Emissary narrowed a checksum helper from public
# API to package-private after documenting that SHA-1/CRC32 are KFF-only, non-
# cryptographic similarity checks.

test "rank749: public weak checksum utility exposes digest API"
  lang java
  expect VYQL-CRY-022
  expect_review code.PublicWeakChecksumUtility
  code
  ```
  import java.security.MessageDigest;
  import java.util.ArrayList;
  import java.util.List;
  import java.util.zip.CRC32;

  public class ChecksumCalculator {
      private CRC32 crc = null;
      private final List<MessageDigest> digest = new ArrayList<>();

      public ChecksumCalculator() throws Exception {
          this("SHA-1", true);
      }

      public ChecksumCalculator(String alg, boolean useCrc) throws Exception {
          if (alg.equals("CRC32")) {
              setUseCrc(true);
          } else {
              digest.add(MessageDigest.getInstance(alg));
          }
      }

      public void setUseCrc(boolean use) {
          crc = use ? new CRC32() : null;
      }

      public ChecksumResults digest(byte[] buffer) {
          ChecksumResults res = new ChecksumResults();
          for (MessageDigest d : digest) {
              d.update(buffer, 0, buffer.length);
              res.setHash(d.getAlgorithm(), d.digest());
          }
          if (crc != null) {
              crc.update(buffer, 0, buffer.length);
              res.setCrc(crc.getValue());
          }
          return res;
      }
  }

  class ChecksumResults {
      void setHash(String alg, byte[] value) {}
      void setCrc(long value) {}
  }
  ```

test "rank749: package-private weak checksum helper is clean"
