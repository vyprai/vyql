# Rank 743 / CVE-2019-10764: elliptic-php used the raw
# variable-bit-length nonce for ECDSA generator multiplication.

test "rank743: ECDSA sign multiplies generator by variable-bit-length nonce"
  lang php
  expect VYQL-CRY-020
  expect_review code.EcdsaNonceBitLengthTimingLeak
  code
  ```
  <?php
  class EC {
      public function sign($msg, $key, $enc = null, $options = null) {
          $bytes = $this->n->byteLength();
          $drbg = new HmacDRBG(array(
              "hash" => $this->hash,
              "entropy" => $key->getPrivate()->toArray("be", $bytes),
              "nonce" => $msg->toArray("be", $bytes)
          ));
          $kFunc = function($iter) use ($drbg, $bytes) {
              return new BN($drbg->generate($bytes));
          };
          for ($iter = 0; true; $iter++) {
              $k = $kFunc($iter);
              $k = $this->_truncateToN($k, true);
              $kp = $this->g->mul($k);
              $r = $kp->getX()->umod($this->n);
              $s = $k->invm($this->n)->mul($r->mul($key->getPrivate())->iadd($msg));
              return new Signature(array("r" => $r, "s" => $s));
          }
      }
  }
  ?>
  ```

test "rank743: ECDSA sign fixed-bit-length nonce multiplication is clean"
  lang php
  reject VYQL-CRY-020
  reject_review code.EcdsaNonceBitLengthTimingLeak
  code
  ```
  <?php
  class EC {
      public function sign($msg, $key, $enc = null, $options = null) {
          $bytes = $this->n->byteLength();
          $drbg = new HmacDRBG(array(
              "hash" => $this->hash,
              "entropy" => $key->getPrivate()->toArray("be", $bytes),
              "nonce" => $msg->toArray("be", $bytes)
          ));
          $kFunc = function($iter) use ($drbg, $bytes) {
              return new BN($drbg->generate($bytes));
          };
          for ($iter = 0; true; $iter++) {
              $k = $kFunc($iter);
              $k = $this->_truncateToN($k, true);
              $ks = $k->add($this->n);
              $kt = $ks->add($this->n);
              if ($ks->bitLength() === $this->n->bitLength()) {
                  $kp = $this->g->mul($kt);
              } else {
                  $kp = $this->g->mul($ks);
              }
              $r = $kp->getX()->umod($this->n);
              $s = $k->invm($this->n)->mul($r->mul($key->getPrivate())->iadd($msg));
              return new Signature(array("r" => $r, "s" => $s));
          }
      }
  }
  ?>
  ```
