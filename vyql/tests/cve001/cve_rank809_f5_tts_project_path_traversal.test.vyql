# Rank 809 / CVE-2026-43624: F5-TTS Gradio handlers joined a
# caller-controlled project/dataset name under data and checkpoint roots
# without resolving and bounding the result to the intended base directory.

test "rank809: F5-TTS project name reaches project files through os.path.join"
  lang python
  file finetune_gradio.py
  expect VYQL-PATH-001
  code
  ```
  import json
  import os

  path_project_ckpts = "/srv/f5/ckpts"
  path_data = "/srv/f5/data"

  def save_settings(request, exp_name):
      project_name = request.args["project_name"]
      path_project = os.path.join(path_project_ckpts, project_name)
      os.makedirs(path_project, exist_ok=True)
      file_setting = os.path.join(path_project, "setting.json")
      with open(file_setting, "w") as f:
          json.dump({"exp_name": exp_name}, f)

  def start_training(request):
      dataset_name = request.args["dataset_name"]
      path_project = os.path.join(path_data, dataset_name)
      file_raw = os.path.join(path_project, "raw.arrow")
      return os.path.isfile(file_raw)
  ```

test "rank809: F5-TTS project name is resolved under the base directory"
  lang python
  file finetune_gradio.py
  reject VYQL-PATH-001
  code
  ```
  import json
  import os
  import re

  path_project_ckpts = "/srv/f5/ckpts"
  path_data = "/srv/f5/data"

  def _safe_project_path(base: str, name: str) -> str:
      if not name or os.path.isabs(name) or "\x00" in name:
          raise ValueError("invalid project_name")
      name = re.sub(r"[/\\]", "", name).strip()
      if not name or name in (".", ".."):
          raise ValueError("invalid project_name")
      candidate = os.path.realpath(os.path.join(base, name))
      base_real = os.path.realpath(base)
      if not (candidate + os.sep).startswith(base_real + os.sep):
          raise ValueError("project_name escapes base directory")
      return candidate

  def save_settings(request, exp_name):
      project_name = request.args["project_name"]
      path_project = _safe_project_path(path_project_ckpts, project_name)
      os.makedirs(path_project, exist_ok=True)
      file_setting = os.path.join(path_project, "setting.json")
      with open(file_setting, "w") as f:
          json.dump({"exp_name": exp_name}, f)

  def start_training(request):
      dataset_name = request.args["dataset_name"]
      path_project = _safe_project_path(path_data, dataset_name)
      file_raw = os.path.join(path_project, "raw.arrow")
      return os.path.isfile(file_raw)
  ```
