# Rank 637 / CVE-2017-20182: django-ajax-utilities blocked // URLs
# but missed /\ URLs that browsers normalize to protocol-relative URLs.
test "rank637: ajax pagination slash check misses backslash protocol-relative URL"
  lang javascript
  file pagination.js
  expect VYQL-INJ-140
  code
  ```
  var Pagination = new function() {
    this.init = function(processHash, document_containers, setHash) {
      function set_up(container) {
        function ajax(url, handler) {
          if (url[0] != '/' || url[1] == '/')
            url = (''+location).replace( /[#\?].*/, '') + url;

          $.ajax({
            type: 'GET',
            url: url,
            datatype: "html",
            success: handler
          });
        }

        function replacePage(url, receivedHtml) {
          receivedHtml = $.trim(receivedHtml);
          $(receivedHtml).find('.paginate-container').eq(0).each(function() {
            containers[0].append($(this).html());
          });
        }
      }
    };
  };
  ```

test "rank637: ajax pagination rejects backslash protocol-relative URL"
  lang javascript
  file pagination.js
  reject VYQL-INJ-140
  code
  ```
  var Pagination = new function() {
    this.init = function(processHash, document_containers, setHash) {
      function set_up(container) {
        function ajax(url, handler) {
          if (url[0] != '/' || url[1] == '/' || url.startsWith("/\\"))
            url = (''+location).replace( /[#\?].*/, '') + url;

          $.ajax({
            type: 'GET',
            url: url,
            datatype: "html",
            success: handler
          });
        }

        function replacePage(url, receivedHtml) {
          receivedHtml = $.trim(receivedHtml);
          $(receivedHtml).find('.paginate-container').eq(0).each(function() {
            containers[0].append($(this).html());
          });
        }
      }
    };
  };
  ```
