test "rank193: FreePBX backup manifest is unserialized from extracted archive contents"
  lang php
  expect VYQL-DESER-008
  code
  ```
  <?php
  use splitbrain\PHPArchive\Tar;

  class BackupSplFileInfo {
    public function getMetadata() {
      $backuptmpdir = sys_get_temp_dir().'/'.time();
      $tar = new Tar();
      $tar->open($this->getPathname());
      $tar->extract($backuptmpdir, '', '', '/(manifest|metadata\.json|files)/');
      $manafestfile = $backuptmpdir . '/manifest';
      if (file_exists($manafestfile)) {
        $manifestdata = file_get_contents($manafestfile);
        $tmpdata = unserialize($manifestdata);
        return ['manifest' => $tmpdata];
      }
      return [];
    }
  }
  ```

test "rank193: FreePBX backup manifest unserialize disables object classes"
  lang php
  reject VYQL-DESER-008
  code
  ```
  <?php
  use splitbrain\PHPArchive\Tar;

  class BackupSplFileInfo {
    public function getMetadata() {
      $backuptmpdir = sys_get_temp_dir().'/'.time();
      $tar = new Tar();
      $tar->open($this->getPathname());
      $tar->extract($backuptmpdir, '', '', '/(manifest|metadata\.json|files)/');
      $manafestfile = $backuptmpdir . '/manifest';
      if (file_exists($manafestfile)) {
        $manifestdata = file_get_contents($manafestfile);
        $tmpdata = json_decode($manifestdata, true);
        if ($tmpdata === null || json_last_error() !== JSON_ERROR_NONE || !is_array($tmpdata)) {
          $tmpdata = unserialize($manifestdata, ['allowed_classes' => false]);
        }
        if (!is_array($tmpdata)) {
          throw new \Exception('Invalid manifest data format');
        }
        return ['manifest' => $tmpdata];
      }
      return [];
    }
  }
  ```
