# Rank 820 / CVE-2022-31142: fastify-bearer-auth used the secure-compare
# package for bearer-token comparison before switching to crypto.timingSafeEqual.

test "rank820: bearer token auth uses vulnerable secure-compare helper"
  lang javascript
  file plugin.js
  expect VYQL-CRY-006
  expect_review code.SecretComparisonReview
  code
  ```
  const compare = require('secure-compare');

  function authenticate(keys, key) {
    return keys.findIndex((a) => compare(a, key)) !== -1;
  }
  ```

test "rank820: bearer token auth uses timingSafeEqual helper"
  lang javascript
  file plugin.js
  reject VYQL-CRY-006
  reject_review code.SecretComparisonReview
  code
  ```
  const crypto = require('crypto');

  function authenticate(keys, key) {
    return keys.findIndex((a) => compare(a, key)) !== -1;
  }

  function compare(a, b) {
    try {
      return crypto.timingSafeEqual(Buffer.from(a), Buffer.from(b));
    } catch {
      return false;
    }
  }
  ```
