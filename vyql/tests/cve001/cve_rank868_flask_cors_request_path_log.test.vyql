# Rank 868 / CVE-2024-1681: Flask-CORS logged request.path through a %s
# diagnostic format, allowing encoded control characters in request paths to
# appear unneutralized in logs. The fix switches the request-path slot to %r.

test "rank868: Flask-CORS request path debug log uses percent-s"
  lang python
  file extension.py
  expect VYQL-INJ-174
  expect_review code.RequestPathPercentSLogInjection
  code
  ```
  from urllib.parse import unquote_plus

  class Logger:
      def debug(self, message, *args):
          pass

  LOG = Logger()
  ACL_ORIGIN = "Access-Control-Allow-Origin"

  class Request:
      path = "/api/%0aInjected: yes"

  request = Request()

  def get_regexp_pattern(regex):
      return regex

  def set_cors_headers(resp, options):
      pass

  def try_match(path, regex):
      return True

  def make_after_request_function(resources):
      def cors_after_request(resp):
          if resp.headers is not None and resp.headers.get(ACL_ORIGIN):
              LOG.debug("CORS have been already evaluated, skipping")
              return resp
          normalized_path = unquote_plus(request.path)
          for res_regex, res_options in resources:
              if try_match(normalized_path, res_regex):
                  LOG.debug("Request to '%s' matches CORS resource '%s'. Using options: %s",
                            request.path, get_regexp_pattern(res_regex), res_options)
                  set_cors_headers(resp, res_options)
                  break
          else:
              LOG.debug("No CORS rule matches")
          return resp
      return cors_after_request
  ```

test "rank868: Flask-CORS request path debug log uses repr escaping"
  lang python
  file extension.py
  reject VYQL-INJ-174
  reject_review code.RequestPathPercentSLogInjection
  code
  ```
  from urllib.parse import unquote_plus

  class Logger:
      def debug(self, message, *args):
          pass

  LOG = Logger()
  ACL_ORIGIN = "Access-Control-Allow-Origin"

  class Request:
      path = "/api/%0aInjected: yes"

  request = Request()

  def get_regexp_pattern(regex):
      return regex

  def set_cors_headers(resp, options):
      pass

  def try_match(path, regex):
      return True

  def make_after_request_function(resources):
      def cors_after_request(resp):
          if resp.headers is not None and resp.headers.get(ACL_ORIGIN):
              LOG.debug("CORS have been already evaluated, skipping")
              return resp
          normalized_path = unquote_plus(request.path)
          for res_regex, res_options in resources:
              if try_match(normalized_path, res_regex):
                  LOG.debug("Request to '%r' matches CORS resource '%s'. Using options: %s",
                            request.path, get_regexp_pattern(res_regex), res_options)
                  set_cors_headers(resp, res_options)
                  break
          else:
              LOG.debug("No CORS rule matches")
          return resp
      return cors_after_request
  ```
