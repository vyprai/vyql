test "rank660: search highlighting returns unescaped indexed HTML"
  lang javascript
  expect VYQL-INJ-144
  code
  ```
  export function ignoreDiacriticalMarks(keyword) {
    return keyword.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  }

  export function search(query) {
    let resultStr = '';
    const postTitle = post.title && post.title.trim();
    const postContent = post.body && post.body.trim();
    keywords.forEach(keyword => {
      const regEx = new RegExp(ignoreDiacriticalMarks(keyword).replace(/[|\\{}()[\]^$+*?.]/g, '\\$&'), 'gi');
      const handlePostTitle = postTitle ? ignoreDiacriticalMarks(postTitle) : postTitle;
      const handlePostContent = postContent ? ignoreDiacriticalMarks(postContent) : postContent;
      resultStr += handlePostContent.replace(regEx, word => `<em class="search-keyword">${word}</em>`);
    });
    const matchingPost = {
      title: handlePostTitle,
      content: resultStr,
      url: post.slug,
    };
    return matchingPost;
  }
  ```

test "rank660: search highlighting escapes query and indexed HTML"
  lang javascript
  reject VYQL-INJ-144
  code
  ```
  export function ignoreDiacriticalMarks(keyword) {
    return keyword.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  }

  export function search(query) {
    let resultStr = '';
    const postTitle = post.title && post.title.trim();
    const postContent = post.body && post.body.trim();
    keywords.forEach(keyword => {
      const regEx = new RegExp(escapeHtml(ignoreDiacriticalMarks(keyword)).replace(/[|\\{}()[\]^$+*?.]/g, '\\$&'), 'gi');
      const handlePostTitle = postTitle ? escapeHtml(ignoreDiacriticalMarks(postTitle)) : postTitle;
      const handlePostContent = postContent ? escapeHtml(ignoreDiacriticalMarks(postContent)) : postContent;
      resultStr += handlePostContent.replace(regEx, word => `<em class="search-keyword">${word}</em>`);
    });
    const matchingPost = {
      title: handlePostTitle,
      content: resultStr,
      url: post.slug,
    };
    return matchingPost;
  }
  ```
