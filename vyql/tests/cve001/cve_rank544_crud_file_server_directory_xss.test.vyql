# Rank 544 / CVE-2018-3726: crud-file-server reflected request-derived error
# text in HTTP responses without escaping.

test "rank544: crud-file-server reflects request method in error response"
  lang javascript
  file crud-file-server.js
  expect VYQL-INJ-004
  code
  ```
  function handler(req, res, readOnly) {
    var writeError = function (err, code) {
      code = code || 500;
      res.statusCode = code;
      res.end(JSON.stringify(err));
    };

    if (readOnly && req.method != 'GET') {
      writeError(req.method + ' forbidden on this resource', 403);
    }
  }
  ```

test "rank544: crud-file-server escapes request method before error response"
  lang javascript
  file crud-file-server.js
  reject VYQL-INJ-004
  code
  ```
  const { encode } = require('html-entities');

  function handler(req, res, readOnly) {
    var writeError = function (err, code) {
      code = code || 500;
      res.statusCode = code;
      res.end(JSON.stringify(err));
    };

    if (readOnly && req.method != 'GET') {
      writeError(encode(req.method) + ' forbidden on this resource', 403);
    }
  }
  ```
