# Rank 34 / CVE-2026-47255: AgenticMail storage query HAVING SQL injection.
# Ledger verification: VYQL-INJ-001 catches req.body flowing to db.all.

test "rank34: AgenticMail raw HAVING clause reaches SQL"
  lang javascript
  file storage.ts
  expect VYQL-INJ-001
  code
  ```
  export async function storageQuery(req, db) {
    const having = req.body.having;
    return db.all("SELECT id FROM storage GROUP BY id HAVING " + having);
  }
  ```

test "rank34: AgenticMail parameterized storage query is clean"
  lang javascript
  file storage.ts
  reject VYQL-INJ-001
  code
  ```
  export async function storageQuery(req, db) {
    const id = req.body.id;
    return db.all("SELECT id FROM storage WHERE id = ?", [id]);
  }
  ```
