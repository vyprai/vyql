# Rank 718 / CVE-2023-38871: Economizzer v0.9-beta1 exposed user
# enumeration through login and forgot-password behavior provided by its
# locked amnah/yii2-user dependency.

test "rank718: vulnerable amnah yii2-user Composer lock pin is reported"
  lang php
  expect VYQL-SCA-001
  file index.php
  code
  ```
  <?php
  echo "economizzer";
  ```
  file composer.lock
  code
  ```
  {
    "packages": [
      {
        "name": "amnah/yii2-user",
        "version": "3.0.0"
      }
    ]
  }
  ```

test "rank718: unrelated Composer package is clean for this advisory"
  lang php
  reject VYQL-SCA-001
  file index.php
  code
  ```
  <?php
  echo "economizzer";
  ```
  file composer.lock
  code
  ```
  {
    "packages": [
      {
        "name": "yiisoft/yii2",
        "version": "2.0.49"
      }
    ]
  }
  ```
