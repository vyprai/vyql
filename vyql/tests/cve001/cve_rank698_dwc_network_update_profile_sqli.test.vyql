test "rank698: profile update interpolates caller-selected SQL column"
  lang python
  expect VYQL-INJ-152
  expect_review code.UnvalidatedSqlIdentifierInterpolation
  code
  ```
  class Transaction:
      def __init__(self, conn):
          self.conn = conn
      def __enter__(self):
          return self
      def __exit__(self, exc_type, exc, tb):
          return False
      def nonquery(self, query, params):
          pass

  class GamespyDatabase:
      def __init__(self, conn):
          self.conn = conn

      def update_profile(self, profileid, field):
          with Transaction(self.conn) as tx:
              q = "UPDATE users SET \"%s\" = ? WHERE profileid = ?"
              tx.nonquery(q % field[0], (field[1], profileid))
  ```

test "rank698: profile update allowlists supported SQL columns"
  lang python
  reject VYQL-INJ-152
  reject_review code.UnvalidatedSqlIdentifierInterpolation
  code
  ```
  class Transaction:
      def __init__(self, conn):
          self.conn = conn
      def __enter__(self):
          return self
      def __exit__(self, exc_type, exc, tb):
          return False
      def nonquery(self, query, params):
          pass

  class GamespyDatabase:
      def __init__(self, conn):
          self.conn = conn

      def update_profile(self, profileid, field):
          if field[0] in ["firstname", "lastname"]:
              with Transaction(self.conn) as tx:
                  q = "UPDATE users SET \"%s\" = ? WHERE profileid = ?"
                  tx.nonquery(q % field[0], (field[1], profileid))
  ```
