# Rank 826 / CVE-2025-11157: Feast's Kubernetes materializer used
# yaml.load with the unsafe PyYAML Loader before switching to safe_load.

test "rank826: feast Kubernetes materializer uses unsafe yaml.Loader"
  lang python
  profile web
  file main.py
  expect VYQL-DESER-016
  expect_review code.UnsafeYamlLoad
  code
  ```
  import yaml

  with open("/var/feast/feature_store.yaml") as f:
      feast_config = yaml.load(f, Loader=yaml.Loader)
  ```

test "rank826: feast Kubernetes materializer uses safe_load"
  lang python
  profile web
  file main.py
  reject VYQL-DESER-016
  reject_review code.UnsafeYamlLoad
  code
  ```
  import yaml

  with open("/var/feast/feature_store.yaml") as f:
      feast_config = yaml.safe_load(f)
  ```

test "rank826: explicit SafeLoader is not an unsafe YAML load"
  lang python
  profile web
  file main.py
  reject VYQL-DESER-016
  code
  ```
  import yaml

  with open("/var/feast/feature_store.yaml") as f:
      feast_config = yaml.load(f, Loader=yaml.SafeLoader)
  ```

test "rank826: yaml.unsafe_load is an unsafe YAML load"
  lang python
  profile web
  file main.py
  expect VYQL-DESER-016
  code
  ```
  import yaml

  with open("/var/feast/feature_store.yaml") as f:
      feast_config = yaml.unsafe_load(f)
  ```
