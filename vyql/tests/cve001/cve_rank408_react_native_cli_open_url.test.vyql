# Rank 408 / CVE-2025-11953: React Native Community CLI open-url middleware
# passed a request body URL to the open package without protocol validation.

test "rank408: React Native CLI opens request body URL without protocol validation"
  lang javascript
  file openURLMiddleware.ts
  expect VYQL-INJ-072
  expect_review code.ReactNativeCliOpenUrlMiddlewareCommandExecution
  code
  ```
  import type {IncomingMessage, ServerResponse} from 'http';
  import open from 'open';

  async function openURLMiddleware(
    req: IncomingMessage & { body?: Object },
    res: ServerResponse,
    next: (err?: Error) => void,
  ) {
    if (req.method === 'POST') {
      const {url} = req.body as {url: string};
      await open(url);
    }
    next();
  }
  ```

test "rank408: React Native CLI restricts open-url middleware to HTTP protocols"
  lang javascript
  file openURLMiddleware.ts
  reject VYQL-INJ-072
  reject_review code.ReactNativeCliOpenUrlMiddlewareCommandExecution
  code
  ```
  import type {IncomingMessage, ServerResponse} from 'http';
  import open from 'open';

  async function openURLMiddleware(
    req: IncomingMessage & { body?: Object },
    res: ServerResponse,
    next: (err?: Error) => void,
  ) {
    if (req.method === 'POST') {
      const {url} = req.body as {url: string};
      const parsedUrl = new URL(url);
      if (parsedUrl.protocol !== 'http:' && parsedUrl.protocol !== 'https:') {
        res.writeHead(400);
        return;
      }
      await open(url);
    }
    next();
  }
  ```
