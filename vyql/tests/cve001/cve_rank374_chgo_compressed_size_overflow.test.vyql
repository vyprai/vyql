# Rank 374 / CVE-2025-1386: ch-go compressed packet framing narrowed
# n + compressHeaderSize into a uint32 without an overflow guard, allowing
# malicious external data to desynchronize the stream and smuggle a query.

test "rank374: ch-go compressed size is narrowed to uint32 without overflow check"
  lang go
  expect VYQL-NUM-011
  expect_review code.ChGoCompressedSizeUint32Overflow
  code
  ```
  package compress

  import "encoding/binary"

  const (
      headerSize = 16
      compressHeaderSize = 9
      hRawSize = 1
      hDataSize = 5
  )

  type Writer struct {
      Data []byte
  }

  func (w *Writer) Compress(buf []byte) error {
      n := copy(w.Data[headerSize:], buf)
      w.Data = w.Data[:n+headerSize]
      binary.LittleEndian.PutUint32(w.Data[hRawSize:], uint32(n+compressHeaderSize))
      binary.LittleEndian.PutUint32(w.Data[hDataSize:], uint32(len(buf)))
      return nil
  }
  ```

test "rank374: ch-go compressed size with MaxUint32 guard is clean"
  lang go
  reject VYQL-NUM-011
  reject_review code.ChGoCompressedSizeUint32Overflow
  code
  ```
  package compress

  import (
      "encoding/binary"
      "math"
  )

  const (
      headerSize = 16
      compressHeaderSize = 9
      hRawSize = 1
      hDataSize = 5
  )

  var errOverflow error

  type Writer struct {
      Data []byte
  }

  func (w *Writer) Compress(buf []byte) error {
      n := copy(w.Data[headerSize:], buf)
      if uint64(n)+uint64(compressHeaderSize) > math.MaxUint32 {
          return errOverflow
      }
      w.Data = w.Data[:n+headerSize]
      binary.LittleEndian.PutUint32(w.Data[hRawSize:], uint32(n+compressHeaderSize))
      binary.LittleEndian.PutUint32(w.Data[hDataSize:], uint32(len(buf)))
      return nil
  }
  ```
