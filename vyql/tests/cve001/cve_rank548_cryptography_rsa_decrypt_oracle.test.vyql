# Rank 548 / CVE-2020-25659: pyca/cryptography's RSA PKCS#1 v1.5
# decryption path consumed/raised errors before making failure behavior more
# indistinguishable. The fix buffers output and clears OpenSSL error state
# before the failure branch.

test "rank548: RSA decrypt error branch before buffering and ERR_clear_error is an oracle"
  lang python
  file src/cryptography/hazmat/backends/openssl/rsa.py
  expect VYQL-CRY-032
  expect_review code.RsaPkcs1v15DecryptErrorOracle
  code
  ```
  def _enc_dec_rsa_pkey_ctx(backend, key, data, padding_enum, padding):
      if isinstance(key, _RSAPublicKey):
          init = backend._lib.EVP_PKEY_encrypt_init
          crypt = backend._lib.EVP_PKEY_encrypt
      else:
          init = backend._lib.EVP_PKEY_decrypt_init
          crypt = backend._lib.EVP_PKEY_decrypt

      pkey_ctx = backend._lib.EVP_PKEY_CTX_new(key._evp_pkey, backend._ffi.NULL)
      res = init(pkey_ctx)
      backend.openssl_assert(res == 1)
      res = backend._lib.EVP_PKEY_CTX_set_rsa_padding(pkey_ctx, padding_enum)
      backend.openssl_assert(res > 0)
      buf_size = backend._lib.EVP_PKEY_size(key._evp_pkey)
      outlen = backend._ffi.new("size_t *", buf_size)
      buf = backend._ffi.new("unsigned char[]", buf_size)
      res = crypt(pkey_ctx, buf, outlen, data, len(data))
      if res <= 0:
          _handle_rsa_enc_dec_error(backend, key)

      return backend._ffi.buffer(buf)[: outlen[0]]
  ```

test "rank548: RSA decrypt buffers and clears OpenSSL errors before failure branch"
  lang python
  file src/cryptography/hazmat/backends/openssl/rsa.py
  reject VYQL-CRY-032
  reject_review code.RsaPkcs1v15DecryptErrorOracle
  code
  ```
  def _enc_dec_rsa_pkey_ctx(backend, key, data, padding_enum, padding):
      if isinstance(key, _RSAPublicKey):
          init = backend._lib.EVP_PKEY_encrypt_init
          crypt = backend._lib.EVP_PKEY_encrypt
      else:
          init = backend._lib.EVP_PKEY_decrypt_init
          crypt = backend._lib.EVP_PKEY_decrypt

      pkey_ctx = backend._lib.EVP_PKEY_CTX_new(key._evp_pkey, backend._ffi.NULL)
      res = init(pkey_ctx)
      backend.openssl_assert(res == 1)
      res = backend._lib.EVP_PKEY_CTX_set_rsa_padding(pkey_ctx, padding_enum)
      backend.openssl_assert(res > 0)
      buf_size = backend._lib.EVP_PKEY_size(key._evp_pkey)
      outlen = backend._ffi.new("size_t *", buf_size)
      buf = backend._ffi.new("unsigned char[]", buf_size)
      res = crypt(pkey_ctx, buf, outlen, data, len(data))
      resbuf = backend._ffi.buffer(buf)[: outlen[0]]
      backend._lib.ERR_clear_error()
      if res <= 0:
          raise ValueError("Encryption/decryption failed.")
      return resbuf
  ```
