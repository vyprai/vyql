test "rank202: base64captcha accepts empty id and answer"
  lang go
  expect VYQL-AUTH-006
  code
  ```
  package base64Captcha

  type memoryStore struct{}

  func (s *memoryStore) Get(id string, clear bool) (value string) {
      return
