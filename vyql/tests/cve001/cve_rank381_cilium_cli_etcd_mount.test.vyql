# Rank 381 / CVE-2023-28114: cilium-cli generated a clustermesh
# apiserver deployment whose etcd init container enabled users and auth
# under /var/run/etcd, but mounted the shared data volume at a relative
# "etcd-data-dir" path. The main etcd container used /var/run/etcd, so
# the initialized auth state was not enforced.

test "rank381: cilium-cli etcd init container mounts data dir at the wrong path"
  lang go
  expect VYQL-AUTH-018
  code
  ```
  package clustermesh

  type VolumeMount struct {
    Name      string
    MountPath string
  }

  type Container struct {
    Name         string
    Args         []string
    VolumeMounts []VolumeMount
  }

  var initContainerArgs = []string{`/usr/local/bin/etcd --data-dir=/var/run/etcd &
  etcdctl user grant-role root root;
  etcdctl auth enable;
  exit`}

  func generateDeployment() Container {
    return Container{
      Name: "etcd-init",
      Args: initContainerArgs,
      VolumeMounts: []VolumeMount{
        {
          Name:      "etcd-data-dir",
          MountPath: "etcd-data-dir",
        },
      },
    }
  }
  ```

test "rank381: cilium-cli etcd init container mounts the shared data dir at /var/run/etcd"
  lang go
  reject VYQL-AUTH-018
  code
  ```
  package clustermesh

  type VolumeMount struct {
    Name      string
    MountPath string
  }

  type Container struct {
    Name         string
    Args         []string
    VolumeMounts []VolumeMount
  }

  var initContainerArgs = []string{`/usr/local/bin/etcd --data-dir=/var/run/etcd &
  etcdctl user grant-role root root;
  etcdctl auth enable;
  exit`}

  func generateDeployment() Container {
    return Container{
      Name: "etcd-init",
      Args: initContainerArgs,
      VolumeMounts: []VolumeMount{
        {
          Name:      "etcd-data-dir",
          MountPath: "/var/run/etcd",
        },
      },
    }
  }
  ```
