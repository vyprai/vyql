test "cve rank 178: Lambda multipart boundary header reaches RegExp"
  lang javascript
  expect VYQL-DOS-001
  file index.js
  code
  ```
  module.exports.parse = (event) => {
    const boundary = getValueIgnoringKeyCase(event.headers, 'Content-Type').split('=')[1];
    const body = (event.isBase64Encoded ? Buffer.from(event.body, 'base64').toString('binary') : event.body)
      .split(new RegExp(boundary))
      .filter(item => item.match(/Content-Disposition/));
    return body;
  };
  ```

test "cve rank 178: Lambda multipart boundary string split is clean"
  lang javascript
  reject VYQL-DOS-001
  file index.js
  code
  ```
  module.exports.parse = (event) => {
    const boundary = getValueIgnoringKeyCase(event.headers, 'Content-Type').split('=')[1];
    const body = (event.isBase64Encoded ? Buffer.from(event.body, 'base64').toString('binary') : event.body)
      .split(boundary)
      .filter(item => item.match(/Content-Disposition/));
    return body;
  };
