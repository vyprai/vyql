# Rank 380 / CVE-2023-27595: Cilium cleanup matched any TC BPF
# filter containing "cilium", temporarily removing endpoint datapath
# programs during agent restart. The fix narrows cleanup to known
# program-name prefixes such as cil_.

test "rank380: Cilium cleanup broadly matches cilium TC filter names"
  lang go
  expect VYQL-LIFE-002
  code
  ```
  package cleanup

  import "strings"

  type BpfFilter struct{ Name string }

  func getTCFilters(filters []*BpfFilter) []*BpfFilter {
    var allFilters []*BpfFilter
    for _, bpfFilter := range filters {
      if strings.Contains(bpfFilter.Name, "bpf_netdev") ||
        strings.Contains(bpfFilter.Name, "bpf_network") ||
        strings.Contains(bpfFilter.Name, "bpf_host") ||
        strings.Contains(bpfFilter.Name, "bpf_lxc") ||
        strings.Contains(bpfFilter.Name, "bpf_overlay") ||
        strings.Contains(bpfFilter.Name, "cilium") {
        allFilters = append(allFilters, bpfFilter)
      }
    }
    return allFilters
  }
  ```

test "rank380: Cilium cleanup uses narrowed cil program-name prefix"
  lang go
  reject VYQL-LIFE-002
  code
  ```
  package cleanup

  import "strings"

  type BpfFilter struct{ Name string }

  func getTCFilters(filters []*BpfFilter) []*BpfFilter {
    var allFilters []*BpfFilter
    for _, bpfFilter := range filters {
      if strings.Contains(bpfFilter.Name, "bpf_netdev") ||
        strings.Contains(bpfFilter.Name, "bpf_network") ||
        strings.Contains(bpfFilter.Name, "bpf_host") ||
        strings.Contains(bpfFilter.Name, "bpf_lxc") ||
        strings.Contains(bpfFilter.Name, "bpf_overlay") ||
        strings.Contains(bpfFilter.Name, "cil_") {
        allFilters = append(allFilters, bpfFilter)
      }
    }
    return allFilters
  }
  ```
