test "rank632: Ruby IO.popen string command assembly is command injection"
  lang ruby
  profile library
  expect VYQL-INJ-002
  code
  ```
  class Encoder
    def encode_file(file, options = '')
      command = "#{ffmpeg_command} -loglevel 0 -i \"#{file}\" #{options} -f s16le pipe:1"
      IO.popen(command)
    end

    private

    def ffmpeg_command
      @use_avconv ? 'avconv' : 'ffmpeg'
    end
  end
  ```

test "rank632: Ruby IO.popen argv array does not use shell command parsing"
  lang ruby
  profile library
  reject VYQL-INJ-002
  reject VYQL-INJ-004
  code
  ```
  class Encoder
    def encode_file(file, options = '')
      command = ffmpeg_command(input: file, options: options)
      IO.popen(command)
    end

    private

    def ffmpeg_command(input: '-', options: nil)
      [
        @use_avconv ? 'avconv' : 'ffmpeg',
        '-loglevel', '0',
        '-i', input,
        '-f', 's16le',
        'pipe:1',
      ].concat(options.split).reject { |segment| segment.nil? || segment == '' }
    end
  end
  ```
