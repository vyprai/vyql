# Rank 625 / CVE-2017-0359: diffoscope extracted archive members using
# attacker-controlled archive pathnames before switching to generated names.
test "rank625: archive member pathname is joined into extraction path"
  lang python
  file libarchive.py
  expect VYQL-PATH-001
  code
  ```
  import os

  def extract_member(request, tmpdir, entry):
      candidate_name = os.path.normpath(request.args["member"].rstrip('/' + os.sep))
      dst = os.path.normpath(os.path.join(tmpdir, candidate_name))
      with open(dst, 'wb') as f:
          for block in entry.get_blocks():
              f.write(block)
  ```

test "rank625: archive member pathname maps to generated extraction name"
  lang python
  file libarchive.py
  reject VYQL-PATH-001
  code
  ```
  import os

  def extract_member(request, tmpdir, entry, idx):
      dst = os.path.join(tmpdir, '{}'.format(idx))
      with open(dst, 'wb') as f:
          for block in entry.get_blocks():
              f.write(block)
  ```
