# Rank 597 / CVE-2021-25941: deep-override recursively copied caller object
# keys into target objects before filtering prototype-sensitive names.

test "rank597: deep-override recursively writes caller object keys without prototype guard"
  lang javascript
  profile library
  expect VYQL-INJ-013
  code
  ```
  function override(...rawArgs) {
    const target = rawArgs[0];
    const args = Array.prototype.slice.call(rawArgs, 1);
    args.forEach(obj => {
      Object.keys(obj).forEach(key => {
        const val = obj[key];
        const src = target[key];
        if (typeof val !== 'object' || val === null) {
          target[key] = val;
        } else if (typeof src !== 'object' || src === null) {
          target[key] = override({}, val);
        } else {
          target[key] = override(src, val);
        }
      });
    });
    return target;
  }

  module.exports = override;
  ```

test "rank597: deep-override rejects prototype-sensitive keys"
  lang javascript
  profile library
  reject VYQL-INJ-013
  code
  ```
  function override(...rawArgs) {
    const target = rawArgs[0];
    const args = Array.prototype.slice.call(rawArgs, 1);
    args.forEach(obj => {
      Object.keys(obj).forEach(key => {
        if (key === '__proto__' || key === 'constructor' || key === 'prototype') {
          return;
        }
        const val = obj[key];
        const src = target[key];
        if (typeof val !== 'object' || val === null) {
          target[key] = val;
        } else if (typeof src !== 'object' || src === null) {
          target[key] = override({}, val);
        } else {
          target[key] = override(src, val);
        }
      });
    });
    return target;
  }

  module.exports = override;
  ```
