# Rank 722 / CVE-2013-10023: Editorial Calendar copied `from`/`to` request
# dates into globals and appended them inside a WordPress posts_where filter.

test "rank722: WordPress posts_where date filter appends unvalidated dates"
  lang php
  file edcal.php
  expect VYQL-INJ-158
  expect_review code.WordPressPostsWhereDateSqlInjection
  code
  ```
  <?php
  class EdCal {
    function edcal_filter_where($where = '') {
      global $edcal_startDate, $edcal_endDate;
      if ($edcal_startDate == '00000000') {
        $where .= " AND post_date_gmt LIKE '0000%'";
      } else {
        $where .= " AND post_date >= '" . $edcal_startDate . "' AND post_date < '" . $edcal_endDate . "' AND post_date_gmt NOT LIKE '0000%'";
      }
      return $where;
    }
  }
  ```

test "rank722: WordPress posts_where date filter validates dates before SQL append"
  lang php
  file edcal.php
  reject VYQL-INJ-158
  reject_review code.WordPressPostsWhereDateSqlInjection
  code
  ```
  <?php
  class EdCal {
    function edcal_filter_where($where = '') {
      global $edcal_startDate, $edcal_endDate;
      if (!is_numeric(str_replace("-", "", $edcal_startDate)) || !is_numeric(str_replace("-", "", $edcal_endDate))) {
        die("The specified start date and end date for the posts query must be numeric.");
      }
      if ($edcal_startDate == '00000000') {
        $where .= " AND post_date_gmt LIKE '0000%'";
      } else {
        $where .= " AND post_date >= '" . $edcal_startDate . "' AND post_date < '" . $edcal_endDate . "' AND post_date_gmt NOT LIKE '0000%'";
      }
      return $where;
    }
  }
  ```
