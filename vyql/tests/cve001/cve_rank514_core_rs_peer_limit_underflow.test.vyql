test "rank514: peer handshake limit is decremented without saturation"
  lang rust
  expect VYQL-NUM-013
  code
  ```
  enum DiscoveryMessage {
      Handshake { limit: u32 },
      Other,
  }

  struct Config {
      update_limit: u32,
  }

  struct Handler {
      peer_list_limit: Option<u32>,
      config: Config,
  }

  impl Handler {
      fn get_peer_contacts(&self, limit: usize) -> Vec<u8> {
          Vec::with_capacity(limit)
      }

      fn poll(&mut self, message: DiscoveryMessage) {
          match message {
              DiscoveryMessage::Handshake { limit } => {
                  self.peer_list_limit = Some(limit);
                  let _ = self.get_peer_contacts(self.peer_list_limit.unwrap() as usize);
              }
              DiscoveryMessage::Other => {}
          }

          let _ = self.get_peer_contacts(self.peer_list_limit.unwrap() as usize - 1);
      }
  }
  ```

test "rank514: peer handshake limit is clamped and decremented with saturation"
  lang rust
  reject VYQL-NUM-013
  code
  ```
  enum DiscoveryMessage {
      Handshake { limit: u32 },
      Other,
  }

  struct Config {
      update_limit: u32,
  }

  struct Handler {
      peer_list_limit: Option<u32>,
      config: Config,
  }

  impl Handler {
      fn get_peer_contacts(&self, limit: usize) -> Vec<u8> {
          Vec::with_capacity(limit)
      }

      fn poll(&mut self, message: DiscoveryMessage) {
          match message {
              DiscoveryMessage::Handshake { limit } => {
                  self.peer_list_limit = Some(limit.min(self.config.update_limit));
                  let _ = self.get_peer_contacts(self.peer_list_limit.unwrap() as usize);
              }
              DiscoveryMessage::Other => {}
          }

          let _ = self.get_peer_contacts(
              (self.peer_list_limit.unwrap() as usize).saturating_sub(1),
          );
      }
  }
  ```
