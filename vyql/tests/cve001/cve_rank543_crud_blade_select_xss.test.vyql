# Rank 543 / CVE-2018-20962: CRUD Blade select-column XSS.
# Fresh scan evidence includes VYQL-INJ-004 on select.blade.php.

test "rank543: CRUD Blade option renders request value"
  lang php
  expect VYQL-INJ-004
  code
  ```
  <?php
  $label = $_GET["label"];
  echo "<option>" . $label . "</option>";
  ?>
  ```

test "rank543: CRUD Blade option escapes request value"
  lang php
  reject VYQL-INJ-004
  code
  ```
  <?php
  $label = $_GET["label"];
  echo "<option>" . htmlspecialchars($label, ENT_QUOTES, "UTF-8") . "</option>";
  ?>
  ```
