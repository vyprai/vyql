# Rank 849 / CVE-2026-22701: SoftFileLock created lock files without
# O_NOFOLLOW, allowing symlink races on platforms that support no-follow opens.

test "rank849: soft lock create omits no-follow open flag"
  lang python
  file _soft.py
  expect VYQL-PATH-045
  expect_review code.LockFileCreateMissingNoFollow
  code
  ```
  import os

  class SoftFileLock:
      def __init__(self, lock_file):
          self.lock_file = lock_file
          self._context = type("Context", (), {"mode": 0o644})()

      def _acquire(self):
          flags = (
              os.O_WRONLY
              | os.O_CREAT
              | os.O_EXCL
              | os.O_TRUNC
          )
          file_handler = os.open(self.lock_file, flags, self._context.mode)
          return file_handler
  ```

test "rank849: soft lock create uses no-follow open flag"
  lang python
  file _soft.py
  reject VYQL-PATH-045
  reject_review code.LockFileCreateMissingNoFollow
  code
  ```
  import os

  class SoftFileLock:
      def __init__(self, lock_file):
          self.lock_file = lock_file
          self._context = type("Context", (), {"mode": 0o644})()

      def _acquire(self):
          flags = (
              os.O_WRONLY
              | os.O_CREAT
              | os.O_EXCL
              | os.O_TRUNC
          )
          o_nofollow = getattr(os, "O_NOFOLLOW", None)
          if o_nofollow is not None:
              flags |= o_nofollow
          file_handler = os.open(self.lock_file, flags, self._context.mode)
          return file_handler
  ```
