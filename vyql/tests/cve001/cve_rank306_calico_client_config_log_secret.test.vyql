# Rank 306 / CVE-2026-6720: calicoctl logged the full loaded client config
# struct at info/debug levels, exposing embedded Kubernetes and etcd credentials.

test "rank306: calico logs full client config spec"
  lang go
  expect VYQL-SEC-001
  code
  ```
  package clientmgr

  import log "github.com/sirupsen/logrus"

  func NewClient(cf string) (any, error) {
      cfg, err := LoadClientConfig(cf)
      if err != nil {
          log.Info("Error loading config")
          return nil, err
      }
      log.Infof("Loaded client config: %#v", cfg.Spec)
      return NewClientFromConfig(cfg)
  }
  ```

test "rank306: calico logs only non-secret config fields and boolean secret presence"
  lang go
  reject VYQL-SEC-001
  code
  ```
  package clientmgr

  import log "github.com/sirupsen/logrus"

  func NewClient(cf string) (any, error) {
      cfg, err := LoadClientConfig(cf)
      if err != nil {
          log.Info("Error loading config")
          return nil, err
      }
      log.WithFields(log.Fields{
          "datastoreType":       cfg.Spec.DatastoreType,
          "etcdEndpoints":       cfg.Spec.EtcdEndpoints,
          "k8sAPIEndpoint":      cfg.Spec.K8sAPIEndpoint,
          "kubeconfig":          cfg.Spec.Kubeconfig,
          "kubeconfigInlineSet": cfg.Spec.KubeconfigInline != "",
          "etcdUsernameSet":     cfg.Spec.EtcdUsername != "",
          "etcdPasswordSet":     cfg.Spec.EtcdPassword != "",
          "etcdKeyInlineSet":    cfg.Spec.EtcdKey != "",
          "etcdCertInlineSet":   cfg.Spec.EtcdCert != "",
          "k8sAPITokenSet":      cfg.Spec.K8sAPIToken != "",
      }).Info("Loaded client config")
      return NewClientFromConfig(cfg)
  }
  ```
