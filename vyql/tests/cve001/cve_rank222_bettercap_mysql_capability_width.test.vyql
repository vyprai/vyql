test "rank222: bettercap mysql binary capability string is under-width before index"
  lang go
  expect VYQL-NUM-004
  expect_review code.UnderwidthFormattedIndex
  code
  ```
  package mysql_server

  import "fmt"

  func parse(readBuffer []byte) string {
      capabilities := fmt.Sprintf("%08b", (int(uint32(readBuffer[4]) | uint32(readBuffer[5])<<8)))
      loadData := string(capabilities[8])
      return loadData
  }
  ```

test "rank222: bettercap mysql binary capability string has enough width"
  lang go
  reject VYQL-NUM-004
  reject_review code.UnderwidthFormattedIndex
  code
  ```
  package mysql_server

  import "fmt"

  func parse(readBuffer []byte) string {
      capabilities := fmt.Sprintf("%016b", (int(uint32(readBuffer[4]) | uint32(readBuffer[5])<<8)))
      loadData := string(capabilities[8])
      return loadData
  }
  ```
