# Rank 502 / CVE-2012-2270: ownCloud login accepted redirect_url
# into the post-login Location header without a same-webroot guard.

test "rank502: ownCloud redirects to request redirect_url without webroot guard"
  lang php
  expect VYQL-RF-022
  expect_review code.OwnCloudLoginRedirectUrlOpenRedirect
  code
  ```
  <?php
  class OC_Util {
      public static function redirectToDefaultPage(){
          if(isset($_REQUEST['redirect_url'])) {
              header( 'Location: /'.htmlentities($_REQUEST['redirect_url']));
          } else {
              header( 'Location: '.OC::$WEBROOT.'/'.OC_Appconfig::getValue('core', 'defaultpage', '?app=files'));
          }
          exit();
      }
  }
  ```

test "rank502: ownCloud redirects only to same-webroot redirect_url"
  lang php
  reject VYQL-RF-022
  reject_review code.OwnCloudLoginRedirectUrlOpenRedirect
  code
  ```
  <?php
  class OC_Util {
      public static function redirectToDefaultPage(){
          if(isset($_REQUEST['redirect_url']) && substr($_REQUEST['redirect_url'], 0, strlen(OC::$WEBROOT)) == OC::$WEBROOT) {
              header( 'Location: '.$_REQUEST['redirect_url']);
          } else {
              header( 'Location: '.OC::$WEBROOT.'/'.OC_Appconfig::getValue('core', 'defaultpage', '?app=files'));
          }
          exit();
      }
  }
  ```
