# Rank 855 / CVE-2024-11023: Firebase JS SDK accepted an externally
# supplied authTokenSyncURL and sent auth/session tokens to it until the URL was
# constrained to same-origin paths.

test "rank855: TypeScript auth token sync URL setting is not path-constrained"
  lang javascript
  file index.ts
  expect VYQL-SEC-030
  expect_review code.ExternalSettingTokenSyncUrlExposure
  code
  ```
  import { getExperimentalSetting } from '@firebase/util';

  type User = { token?: string } | null;
  type Auth = {};

  const mintCookieFactory = (url: string) => async (user: User) => {
    const idToken = user?.token;
    await fetch(url, {
      method: idToken ? 'POST' : 'DELETE',
      headers: idToken ? { 'Authorization': `Bearer ${idToken}` } : {}
    });
  };

  export function getAuth(auth: Auth) {
    const authTokenSyncUrl = getExperimentalSetting('authTokenSyncURL');
    if (authTokenSyncUrl) {
      const mintCookie = mintCookieFactory(authTokenSyncUrl);
      onIdTokenChanged(auth, user => mintCookie(user));
    }
  }
  ```

test "rank855: TypeScript auth token sync URL setting is constrained to same-origin path"
  lang javascript
  file index.ts
  reject VYQL-SEC-030
  reject_review code.ExternalSettingTokenSyncUrlExposure
  code
  ```
  import { getExperimentalSetting } from '@firebase/util';

  type User = { token?: string } | null;
  type Auth = {};

  const mintCookieFactory = (url: string) => async (user: User) => {
    const idToken = user?.token;
    await fetch(url, {
      method: idToken ? 'POST' : 'DELETE',
      headers: idToken ? { 'Authorization': `Bearer ${idToken}` } : {}
    });
  };

  export function getAuth(auth: Auth) {
    const authTokenSyncPath = getExperimentalSetting('authTokenSyncURL');
    if (authTokenSyncPath && authTokenSyncPath.startsWith('/')) {
      const mintCookie = mintCookieFactory(authTokenSyncPath);
      onIdTokenChanged(auth, user => mintCookie(user));
    }
  }
  ```
