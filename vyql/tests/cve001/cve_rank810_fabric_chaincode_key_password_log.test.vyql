# Rank 810 / CVE-2026-45581: Hyperledger Fabric Chaincode Java logged the
# TLS key password at INFO level while dumping chaincode server properties.

test "rank810: Fabric Chaincode logs TLS key password"
  lang java
  file NettyGrpcServer.java
  expect VYQL-SEC-001
  code
  ```
  import java.util.logging.Level;
  import java.util.logging.Logger;

  public final class NettyGrpcServer {
      private static final Logger LOGGER = Logger.getLogger(NettyGrpcServer.class.getName());

      public NettyGrpcServer(final ChaincodeServerProperties chaincodeServerProperties) {
          if (LOGGER.isLoggable(Level.INFO)) {
              LOGGER.info("ServerAddress:" + chaincodeServerProperties.getServerAddress().toString());
              LOGGER.info("KeyPassword:" + chaincodeServerProperties.getKeyPassword());
              LOGGER.info("KeyCertChainFile:" + chaincodeServerProperties.getKeyCertChainFile());
          }
      }
  }
  ```

test "rank810: Fabric Chaincode omits TLS key password from logs"
  lang java
  file NettyGrpcServer.java
  reject VYQL-SEC-001
  code
  ```
  import java.util.logging.Level;
  import java.util.logging.Logger;

  public final class NettyGrpcServer {
      private static final Logger LOGGER = Logger.getLogger(NettyGrpcServer.class.getName());

      public NettyGrpcServer(final ChaincodeServerProperties chaincodeServerProperties) {
          if (LOGGER.isLoggable(Level.INFO)) {
              LOGGER.info("ServerAddress:" + chaincodeServerProperties.getServerAddress().toString());
              LOGGER.info("KeyCertChainFile:" + chaincodeServerProperties.getKeyCertChainFile());
              LOGGER.info("KeyFile:" + chaincodeServerProperties.getKeyFile());
          }
      }
  }
  ```
