# Rank 444 / CVE-2026-45154: Nextcloud Collectives exposed deleted pages
# through the public trash index for view-only collective shares.

test "rank444: public collective trash index lists deleted pages without edit permission"
  lang php
  file PublicPageTrashController.php
  expect VYQL-AUTH-024
  expect_review code.CollectivesPublicTrashMissingEditPermission
  code
  ```
  <?php
  class PublicPageTrashController extends CollectivesPublicOCSController {
      private function checkEditPermissions(): void {
          if (!$this->getCollectiveShare()->getEditable()) {
              throw new OCSForbiddenException('Not permitted to edit shared collective');
          }
      }

      public function index(): DataResponse {
          $pageInfos = $this->handleErrorResponse(function (): array {
              $owner = $this->getCollectiveShare()->getOwner();
              $collectiveId = $this->getCollectiveShare()->getCollectiveId();
              $pageInfos = $this->service->findAllTrash($collectiveId, $owner);
              foreach ($pageInfos as $pageInfo) {
                  $pageInfo->setCollectivePath('');
                  $pageInfo->setShareToken($this->getToken());
              }
              return $pageInfos;
          }, $this->logger);
          return new DataResponse(['pages' => $pageInfos]);
      }
  }
  ```

test "rank444: public collective trash index requires edit permission"
  lang php
  file PublicPageTrashController.php
  reject VYQL-AUTH-024
  reject_review code.CollectivesPublicTrashMissingEditPermission
  code
  ```
  <?php
  class PublicPageTrashController extends CollectivesPublicOCSController {
      private function checkEditPermissions(): void {
          if (!$this->getCollectiveShare()->getEditable()) {
              throw new OCSForbiddenException('Not permitted to edit shared collective');
          }
      }

      public function index(): DataResponse {
          $pageInfos = $this->handleErrorResponse(function (): array {
              $this->checkEditPermissions();
              $owner = $this->getCollectiveShare()->getOwner();
              $collectiveId = $this->getCollectiveShare()->getCollectiveId();
              $pageInfos = $this->service->findAllTrash($collectiveId, $owner);
              foreach ($pageInfos as $pageInfo) {
                  $pageInfo->setCollectivePath('');
                  $pageInfo->setShareToken($this->getToken());
              }
              return $pageInfos;
          }, $this->logger);
          return new DataResponse(['pages' => $pageInfos]);
      }
  }
  ```
