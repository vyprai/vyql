test "rank885: FluentCMS sanitizes SVG before storing the uploaded stream"
  lang csharp
  reject VYQL-INJ-115
  reject_review code.UnsanitizedSvgUpload
  code
  ```
  using System.IO;
  using System.Xml;
  using System.Xml.Linq;

  public class File {
      public string Name { get; set; } = "";
      public string NormalizedName { get; set; } = "";
      public string Extension { get; set; } = "";
      public string ContentType { get; set; } = "";
  }

  public class FileService {
      public async Task<File> Create(File file, Stream fileContent, CancellationToken cancellationToken = default) {
          file.NormalizedName = file.Name.Trim().ToLower();
          if (IsSvgFile(file)) {
              fileContent = SanitizeSvg(fileContent);
          }
          await fileStorageProvider.Upload(file.Id.ToString(), fileContent, cancellationToken);
          return file;
      }

      private static bool IsSvgFile(File file) {
          return file.Extension == ".svg" || file.ContentType == "image/svg+xml";
      }

      private static MemoryStream SanitizeSvg(Stream svgStream) {
          var readerSettings = new XmlReaderSettings { DtdProcessing = DtdProcessing.Prohibit, XmlResolver = null };
          using var reader = XmlReader.Create(svgStream, readerSettings);
          var doc = XDocument.Load(reader);
          var ms = new MemoryStream();
          doc.Save(ms);
          return ms;
      }
  }
  ```
