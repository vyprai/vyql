# Rank 366 / CVE-2020-36625: destinygg/chat configured Gorilla websocket
# Upgrader.CheckOrigin to unconditionally return true, disabling the origin check
# that protects browser-initiated WebSocket upgrades from CSRF.

test "rank366: Gorilla websocket CheckOrigin unconditionally returns true"
  lang go
  expect VYQL-CFG-001
  expect_review code.CsrfDisabled
  code
  ```
  package main

  import (
    "net/http"

    "github.com/gorilla/websocket"
  )

  var upgrader = websocket.Upgrader{
    ReadBufferSize:  1024,
    WriteBufferSize: 1024,
    CheckOrigin:     func(r *http.Request) bool { return true },
  }
  ```

test "rank366: Gorilla websocket default origin check is clean"
  lang go
  reject VYQL-CFG-001
  reject_review code.CsrfDisabled
  code
  ```
  package main

  import "github.com/gorilla/websocket"

  var upgrader = websocket.Upgrader{
    ReadBufferSize:  1024,
    WriteBufferSize: 1024,
  }
  ```

test "rank366: Gorilla websocket CheckOrigin with origin comparison is clean"
  lang go
  reject VYQL-CFG-001
  reject_review code.CsrfDisabled
  code
  ```
  package main

  import (
    "net/http"

    "github.com/gorilla/websocket"
  )

  var upgrader = websocket.Upgrader{
    CheckOrigin: func(r *http.Request) bool {
      return r.Header.Get("Origin") == "https://www.destiny.gg"
    },
  }
  ```
