test "rank232: Java URL policy trusts request server name as the allowlist host"
  lang java
  expect VYQL-RF-010
  code
  ```
  import java.net.URL;
  import javax.servlet.http.HttpServletRequest;

  class ParameterAccessor {
    static final String POLICY_ALL = "all";
    static final String POLICY_DOMAIN = "domain";
    static String urlReportPathPolicy = POLICY_DOMAIN;

    static boolean isValidFilePath(HttpServletRequest request, String filePath) throws Exception {
      if (!POLICY_ALL.equalsIgnoreCase(urlReportPathPolicy)) {
        URL url = new URL(filePath);
        if (POLICY_DOMAIN.equalsIgnoreCase(urlReportPathPolicy)) {
          String dm = request.getServerName();
          if (!dm.equals(url.getHost())) {
            return false;
          }
        }
      }
      return true;
    }
  }
  ```

test "rank232: Java URL policy uses an explicit configured domain allowlist"
  lang java
  reject VYQL-RF-010
  code
  ```
  import java.net.URL;
  import java.util.List;
  import javax.servlet.http.HttpServletRequest;

  class ParameterAccessor {
    static final String POLICY_ALL = "all";
    static final String POLICY_DOMAIN = "domain";
    static String urlReportPathPolicy = "none";
    static List<String> fUrlReportPathDomains;

    static boolean isValidFilePath(HttpServletRequest request, String filePath) throws Exception {
      if (!POLICY_ALL.equalsIgnoreCase(urlReportPathPolicy)) {
        URL url = new URL(filePath);
        if (POLICY_DOMAIN.equalsIgnoreCase(urlReportPathPolicy)) {
          if (!fUrlReportPathDomains.contains(url.getHost())) {
            return false;
          }
        }
      }
      return true;
    }
  }
  ```

test "rank232: Java URL parsing without a network operation is not SSRF"
  lang java
  reject VYQL-RF-001
  code
  ```
  import java.net.URL;
  import javax.servlet.http.HttpServletRequest;

  class ParserOnly {
    URL parse(HttpServletRequest request) throws Exception {
      String v = request.getParameter("u");
      return new URL(v);
    }
  }
  ```

test "rank232: Java URL openConnection remains SSRF"
  lang java
  expect VYQL-RF-001
  code
  ```
  import java.net.URL;
  import javax.servlet.http.HttpServletRequest;

  class Fetcher {
    Object fetch(HttpServletRequest request) throws Exception {
      String v = request.getParameter("u");
      return new URL(v).openConnection();
    }
  }
  ```
