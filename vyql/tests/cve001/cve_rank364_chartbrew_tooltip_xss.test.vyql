# Rank 364 / CVE-2026-41518: Chartbrew tooltip labels were assembled into an
# HTML string and assigned through innerHTML.

test "rank364: chartbrew tooltip model data reaches innerHTML"
  lang javascript
  expect VYQL-INJ-061
  expect_review code.UnescapedChartTooltipHtml
  code
  ```
  export const formatTotal = (value) => {
    return typeof value === "number" ? value.toLocaleString() : value;
  };

  export const generateTooltipContent = (titleLines, bodyLines, labelColors, isCategoryChart) => {
    let innerHtml = "<div class=\"py-1 px-1 z-50\">";

    titleLines.forEach(title => {
      innerHtml += `<span class="font-medium">${title}</span>`;
    });

    bodyLines.forEach((body, i) => {
      if (!body) return;
      const colors = labelColors[i];
      let category, value;
      if (typeof body === "string" && body.includes(":")) {
        [category, value] = body.split(":");
      } else {
        category = `Series ${i + 1}`;
        value = body;
      }
      const colorStyle = isCategoryChart
        ? `background-color: ${colors.backgroundColor}`
        : `background-color: ${colors.borderColor}`;
      innerHtml += `
        <div class="row">
          <div style="${colorStyle}"></div>
          <span>${category}</span>
          <span>${formatTotal(value)}</span>
        </div>`;
    });

    innerHtml += "</div>";
    return innerHtml;
  };

  export const tooltipPlugin = {
    external: function(context) {
      const tooltipModel = context.tooltip;
      if (tooltipModel.body) {
        const titleLines = tooltipModel.title || [];
        const bodyLines = tooltipModel.body.map(b => b.lines[0]);
        tooltipEl.innerHTML = generateTooltipContent(
          titleLines,
          bodyLines,
          tooltipModel.labelColors,
          context.tooltip.options.isCategoryChart
        );
      }
    }
  };
  ```

test "rank364: chartbrew tooltip model data is rendered with textContent"
  lang javascript
  reject VYQL-INJ-061
  reject_review code.UnescapedChartTooltipHtml
  code
  ```
  const createTooltipTextElement = (tagName, className, text) => {
    const element = document.createElement(tagName);
    element.className = className;
    element.textContent = text == null ? "" : String(text);
    return element;
  };

  export const generateTooltipContent = (titleLines, bodyLines, labelColors, isCategoryChart) => {
    const container = document.createElement("div");
    titleLines.forEach((title) => {
      container.appendChild(createTooltipTextElement("span", "font-medium", title));
    });
    bodyLines.forEach((body, i) => {
      if (!body) return;
      const colors = labelColors[i] || {};
      const row = document.createElement("div");
      const dot = document.createElement("div");
      dot.style.backgroundColor = isCategoryChart ? colors.backgroundColor : colors.borderColor;
      row.appendChild(dot);
      row.appendChild(createTooltipTextElement("span", "text", body));
      container.appendChild(row);
    });
    return container;
  };

  export const tooltipPlugin = {
    external: function(context) {
      const tooltipModel = context.tooltip;
      if (tooltipModel.body) {
        const titleLines = tooltipModel.title || [];
        const bodyLines = tooltipModel.body.map(b => b.lines[0]);
        tooltipEl.replaceChildren(
          generateTooltipContent(
            titleLines,
            bodyLines,
            tooltipModel.labelColors,
            context.tooltip.options.isCategoryChart
          )
        );
      }
    }
  };
  ```
