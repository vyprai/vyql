# Rank 859 / CVE-2025-57818: Firecrawl sent tenant-configured webhook
# URLs through a general HTTP client instead of the SSRF-safe dispatcher.

test "rank859: TypeScript webhook delivery posts caller URL through axios"
  lang javascript
  file webhook.ts
  expect VYQL-RF-035
  expect_review code.WebhookUrlFetchMissingSsrfGuard
  code
  ```
  export const callWebhook = async ({ webhook, awaitWebhook }) => {
    let webhookUrl = webhook;

    if (awaitWebhook) {
      const res = await axios.post(
        webhookUrl.url,
        {
          success: true,
          metadata: webhookUrl.metadata || undefined,
        },
        {
          headers: {
            "Content-Type": "application/json",
            ...webhookUrl.headers,
          },
          timeout: 10000,
        },
      );
      return res.status;
    }

    axios.post(
      webhookUrl.url,
      {
        success: true,
        metadata: webhookUrl.metadata || undefined,
      },
      {
        headers: {
          "Content-Type": "application/json",
          ...webhookUrl.headers,
        },
      },
    );
  };
  ```

test "rank859: TypeScript webhook delivery uses SSRF-safe dispatcher"
  lang javascript
  file webhook.ts
  reject VYQL-RF-035
  reject_review code.WebhookUrlFetchMissingSsrfGuard
  code
  ```
  import undici from "undici";
  import { secureDispatcher } from "./safeFetch";

  export const callWebhook = async ({ webhook, awaitWebhook }) => {
    let webhookUrl = webhook;

    if (awaitWebhook) {
      const res = await undici.fetch(webhookUrl.url, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          ...webhookUrl.headers,
        },
        body: JSON.stringify({
          success: true,
          metadata: webhookUrl.metadata || undefined,
        }),
        dispatcher: secureDispatcher,
        signal: AbortSignal.timeout(10000),
      });
      return res.status;
    }

    undici.fetch(webhookUrl.url, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        ...webhookUrl.headers,
      },
      body: JSON.stringify({
        success: true,
        metadata: webhookUrl.metadata || undefined,
      }),
      dispatcher: secureDispatcher,
    });
  };
  ```
