# Rank 922 / CVE-2026-37457: FRRouting FlowSpec operator decoders allowed
# loop == BGP_PBR_MATCH_VAL_MAX before writing the next mval entry.

test "rank922: flowspec operator loop guard is off by one"
  lang c
  file bgp_flowspec_util.c
  expect VYQL-MEM-047
  expect_review code.FlowSpecOperatorLoopBoundOffByOne
  code
  ```
  int bgp_flowspec_op_decode(int type, unsigned char *nlri_ptr,
                             unsigned int max_len, void *result, int *error)
  {
      int op[8];
      int value, value_size, loop = 0;
      unsigned int offset = 0;
      struct bgp_pbr_match_val *mval = (struct bgp_pbr_match_val *)result;

      do {
          if (loop > BGP_PBR_MATCH_VAL_MAX) {
              *error = -2;
              return offset;
          }
          hex2bin(&nlri_ptr[offset], op);
          value_size = 1 << (2 * op[2] + op[3]);
          value = hexstr2num(&nlri_ptr[offset], value_size);
          mval->value = value;
          mval++;
          loop++;
      } while (op[0] == 0 && offset < max_len - 1);
      return offset;
  }
  ```

