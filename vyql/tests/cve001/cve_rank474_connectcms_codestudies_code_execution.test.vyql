  <?php
  class ContentsPlugin extends UserPluginBase {
      public function getPublicFunctions() {
          $functions = array();
          $functions['post'] = ['save'];
          return $functions;
      }

      public function save($request) {
          $content = new Contents();
          $content->content_text = $request->content_text;
          $content->save();
