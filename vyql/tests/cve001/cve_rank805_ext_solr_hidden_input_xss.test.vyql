# Rank 805 / CVE-2013-6289: TYPO3 Solr preserved existing piVars in
# hidden search-form inputs without escaping the values before rendering.

test "rank805: TYPO3 Solr preserves piVars in hidden input values without escaping"
  lang php
  file class.tx_solr_pi_results_parameterkeepingformmodifier.php
  expect VYQL-INJ-168
  expect_review code.PreservedRequestHiddenInputValueXss
  code
  ```
  <?php
  class tx_solr_pi_results_ParameterKeepingFormModifier {
    protected $parentPlugin;
    protected $configuration;

    public function modifyForm(array $markers, tx_solr_Template $template) {
      $hiddenFields = array();

      if ($this->parentPlugin instanceof tx_solr_pi_results && $this->configuration['search.']['keepExistingParametersForNewSearches']) {
        foreach ($this->parentPlugin->piVars as $key => $value) {
          $name = $this->parentPlugin->prefixId . '[' . $key . ']';
          if (is_array($value)) {
            foreach ($value as $k => $v) {
              $hiddenFields[] = '<input type="hidden" name="' . $name . '[' . $k . ']" value="' . $v . '" />';
            }
          } else {
            $hiddenFields[] = '<input type="hidden" name="' . $name . '" value="' . $value . '" />';
          }
        }
      }

      $markers['hidden_parameter_fields'] = implode("\n", $hiddenFields);
      return $markers;
    }
  }
  ```

test "rank805: TYPO3 Solr escapes preserved hidden input values"
  lang php
  file class.tx_solr_pi_results_parameterkeepingformmodifier.php
  reject VYQL-INJ-168
  reject_review code.PreservedRequestHiddenInputValueXss
  code
  ```
  <?php
  class tx_solr_pi_results_ParameterKeepingFormModifier {
    protected $parentPlugin;
    protected $configuration;

    public function modifyForm(array $markers, tx_solr_Template $template) {
      $hiddenFields = array();

      if ($this->parentPlugin instanceof tx_solr_pi_results && $this->configuration['search.']['keepExistingParametersForNewSearches']) {
        foreach ($this->parentPlugin->piVars as $key => $value) {
          $name = $this->parentPlugin->prefixId . '[' . $key . ']';
          if (is_array($value)) {
            foreach ($value as $k => $v) {
              $hiddenFields[] = '<input type="hidden" name="' . $name . '[' . $k . ']" value="' . $this->cleanFormValue($v) . '" />';
            }
          } else {
            $hiddenFields[] = '<input type="hidden" name="' . $name . '" value="' . $this->cleanFormValue($value) . '" />';
          }
        }
      }

      $markers['hidden_parameter_fields'] = implode("\n", $hiddenFields);
      return $markers;
    }

    private function cleanFormValue($value) {
      $value = urldecode($value);
      $value = filter_var(strip_tags($value), FILTER_SANITIZE_STRING);
      $value = t3lib_div::removeXSS($value);
      return urlencode($value);
    }
  }
  ```
