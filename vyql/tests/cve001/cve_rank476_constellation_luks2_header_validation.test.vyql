# Rank 476 / CVE-2025-58356: Constellation opened existing LUKS2
# persistent-storage devices through host-provided attached headers. The fix
# extracts the header, verifies the LUKS2 JSON metadata shape/algorithms, then
# opens the data device with the verified detached header.

test "rank476: Constellation opens LUKS2 device with attached header only"
  lang go
  file cryptsetup_cgo.go
  expect VYQL-CRY-008
  expect_review code.ConstellationLuks2AttachedHeaderActivation
  code
  ```
  package cryptsetup

  import "github.com/martinjungblut/go-cryptsetup"

  type cryptDevice interface{}

  func initByDevicePath(devicePath string) (cryptDevice, error) {
      return cryptsetup.Init(devicePath)
  }

  func initByName(name string) (cryptDevice, error) {
      return cryptsetup.InitByName(name)
  }
  ```

test "rank476: Constellation verifies detached LUKS2 header before activation"
  lang go
  file cryptsetup_cgo.go
  reject VYQL-CRY-008
  reject_review code.ConstellationLuks2AttachedHeaderActivation
  code
  ```
  package cryptsetup

  import "github.com/martinjungblut/go-cryptsetup"

  type cryptDevice interface{}

  func initByDevicePath(devicePath string) (deviceDetachedHeader, deviceAttachedHeader cryptDevice, headerDevice string, headerFile string, err error) {
      tmpDevice, err := cryptsetup.Init(devicePath)
      if err != nil {
          return nil, nil, "", "", err
      }
      headerDevice, headerFile, err = detachHeader(tmpDevice)
      if err != nil {
          return nil, nil, "", "", err
      }
      cryptDevice, err := cryptsetup.InitDataDevice(headerDevice, devicePath)
      return cryptDevice, nil, headerDevice, headerFile, err
  }

  func initByName(name string) (deviceDetachedHeader, deviceAttachedHeader cryptDevice, headerDevice string, headerFile string, err error) {
      tmpDevice, err := cryptsetup.InitByName(name)
      if err != nil {
          return nil, nil, "", "", err
      }
      headerDevice, headerFile, err = detachHeader(tmpDevice)
      if err != nil {
          return nil, nil, "", "", err
      }
      cryptDevice, err := cryptsetup.InitByNameAndHeader(name, headerDevice)
      return cryptDevice, nil, headerDevice, headerFile, err
  }

  func detachHeader(device cryptDevice) (string, string, error) {
      metadata := cryptsetupMetadata{}
      if err := verifyLUKS2Header(metadata); err != nil {
          return "", "", err
      }
      return "/dev/loop0", "/tmp/header", nil
  }

  type cryptsetupMetadata struct{}

  func verifyLUKS2Header(metadata cryptsetupMetadata) error {
      return nil
  }
  ```
