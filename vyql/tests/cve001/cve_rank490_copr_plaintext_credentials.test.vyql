# Rank 490 / CVE-2020-2177: Jenkins Copr Plugin databound API credentials
# as plain strings, causing job config.xml to store them unencrypted.

test "rank490: Copr Jenkins plugin databinds API credentials as strings"
  lang java
  file CoprPlugin.java
  expect VYQL-SEC-015
  expect_review code.JenkinsPlaintextDataboundCredential
  code
  ```
  import hudson.tasks.Notifier;
  import org.kohsuke.stapler.DataBoundConstructor;

  public class CoprPlugin extends Notifier {
      private final String apilogin;
      private final String apitoken;

      @DataBoundConstructor
      public CoprPlugin(String coprname, String username, String srpm,
              String apilogin, String apitoken, String apiurl) {
          this.apilogin = apilogin;
          this.apitoken = apitoken;
      }
  }
  ```

test "rank490: Copr Jenkins plugin stores API credentials as Secret"
  lang java
  file CoprPlugin.java
  reject VYQL-SEC-015
  reject_review code.JenkinsPlaintextDataboundCredential
  code
  ```
  import hudson.tasks.Notifier;
  import hudson.util.Secret;
  import org.kohsuke.stapler.DataBoundConstructor;

  public class CoprPlugin extends Notifier {
      private final Secret apilogin;
      private final Secret apitoken;

      @DataBoundConstructor
      public CoprPlugin(String coprname, String username, String srpm,
              Secret apilogin, Secret apitoken, String apiurl) {
          this.apilogin = apilogin;
          this.apitoken = apitoken;
      }
  }
  ```
