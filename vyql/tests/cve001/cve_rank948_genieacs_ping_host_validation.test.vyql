# Rank 948 / CVE-2021-46704: GenieACS interpolated a public ping host
# parameter into a shell command before validating host characters.

test "rank948: exported ping host reaches exec command string"
  lang javascript
  profile library
  file ping.ts
  expect VYQL-INJ-002
  reject VYQL-INJ-001
  code
  ```
  import { platform } from "os";
  import { exec } from "child_process";

  export function ping(host: string, callback: (err: Error) => void): void {
    let cmd: string;
    host = host.replace("[", "").replace("]", "");
    switch (platform()) {
      case "linux":
        cmd = `ping -w 1 -i 0.2 -c 3 ${host}`;
        break;
      default:
        return callback(new Error("Platform not supported"));
    }

    exec(cmd, (err) => callback(err));
  }
  ```

test "rank948: exported ping host validation dominates exec command string"
  lang javascript
  profile library
  file ping.ts
  reject VYQL-INJ-001
  reject VYQL-INJ-002
  code
  ```
  import { platform } from "os";
  import { exec } from "child_process";
  import { domainToASCII } from "url";

  function isValidHost(host: string): boolean {
    if (/^[a-zA-Z0-9\-.:[\]-]+$/.test(host)) return true;
    return /^[a-zA-Z0-9\-.:[\]-]+$/.test(domainToASCII(host));
  }

  export function ping(host: string, callback: (err: Error) => void): void {
    let cmd: string;
    if (!isValidHost(host)) return callback(new Error("Invalid host"));
    host = host.replace("[", "").replace("]", "");
    switch (platform()) {
      case "linux":
        cmd = `ping -w 1 -i 0.2 -c 3 ${host}`;
        break;
      default:
        return callback(new Error("Platform not supported"));
    }

    exec(cmd, (err) => callback(err));
  }
  ```
