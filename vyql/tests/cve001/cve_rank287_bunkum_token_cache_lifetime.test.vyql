test "rank287: Bunkum token cache is only cleared on AddParameterToEndpoint fallthrough"
  lang csharp
  expect VYQL-RES-003
  code
  ```
  using System;
  using System.Reflection;

  public class AuthenticationService {
      private readonly ThreadLocal<IToken<IUser>?> _tokenCache = new(() => null);

      public object? AddParameterToEndpoint(ListenerContext context, ParameterInfo parameter, Lazy<IDatabaseContext> database) {
          if (ParameterBasedFrom<IToken<IUser>>(parameter))
              return this.AuthenticateToken(context, database);

          if (ParameterBasedFrom<IUser>(parameter)) {
              IToken<IUser>? token = this.AuthenticateToken(context, database);
              if (token != null) return token.User;
          }

          this._tokenCache.Value = null;
          return null;
      }
  }
  ```

test "rank287: Bunkum token cache is cleared after request handling"
  lang csharp
  reject VYQL-RES-003
  code
  ```
  using System;
  using System.Reflection;

  public class AuthenticationService {
      private readonly ThreadLocal<IToken<IUser>?> _tokenCache = new(() => null);

      public object? AddParameterToEndpoint(ListenerContext context, ParameterInfo parameter, Lazy<IDatabaseContext> database) {
          if (ParameterBasedFrom<IToken<IUser>>(parameter))
              return this.AuthenticateToken(context, database);

          if (ParameterBasedFrom<IUser>(parameter)) {
              IToken<IUser>? token = this.AuthenticateToken(context, database);
              if (token != null) return token.User;
          }

          return null;
      }

      public void AfterRequestHandled(ListenerContext context, Response response, MethodInfo method, Lazy<IDatabaseContext> database) {
          this._tokenCache.Value = null;
      }
  }
  ```
