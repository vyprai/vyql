test "rank207: bbolt branch page reads last element without count guard"
  lang go
  expect VYQL-MEM-017
  code
  ```
  package bbolt

  type Bucket struct{}
  type BucketStats struct{ BranchInuse int }
  type Pgid uint64
  type Page struct{}
  type Element struct{}

  func (b *Bucket) forEachPage(fn func(*Page, int, []Pgid)) {}
  func (p *Page) IsBranchPage() bool { return true }
  func (p *Page) Count() uint16 { return 0 }
  func (p *Page) BranchPageElement(i uint16) *Element { return nil }
  func (e *Element) Pos() uint32 { return 0 }
  func (e *Element) Ksize() uint32 { return 0 }

  func (b *Bucket) Stats() BucketStats {
    var s BucketStats
    b.forEachPage(func(p *Page, depth int, pgstack []Pgid) {
      if p.IsBranchPage() {
        lastElement := p.BranchPageElement(p.Count() - 1)
        used := uintptr(lastElement.Pos() + lastElement.Ksize())
        s.BranchInuse += int(used)
      }
    })
    return s
  }
  ```

test "rank207: bbolt branch page checks count before last element"
  lang go
  reject VYQL-MEM-017
  code
  ```
  package bbolt

  type Bucket struct{}
  type BucketStats struct{ BranchInuse int }
  type Pgid uint64
  type Page struct{}
  type Element struct{}

  func (b *Bucket) forEachPage(fn func(*Page, int, []Pgid)) {}
  func (p *Page) IsBranchPage() bool { return true }
  func (p *Page) Count() uint16 { return 0 }
  func (p *Page) BranchPageElement(i uint16) *Element { return nil }
  func (e *Element) Pos() uint32 { return 0 }
  func (e *Element) Ksize() uint32 { return 0 }

  func (b *Bucket) Stats() BucketStats {
    var s BucketStats
    b.forEachPage(func(p *Page, depth int, pgstack []Pgid) {
      if p.IsBranchPage() {
        used := uintptr(0)
        if p.Count() != 0 {
          lastElement := p.BranchPageElement(p.Count() - 1)
          used += uintptr(lastElement.Pos() + lastElement.Ksize())
        }
        s.BranchInuse += int(used)
      }
    })
    return s
  }
  ```
