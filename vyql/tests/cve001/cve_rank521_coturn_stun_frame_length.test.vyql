# verify_current_expected: skip-fresh-target
# Rank 521 / CVE-2026-40613: the selected pool commit is the 4.10.0 release
# tag metadata update, and its parent is already past the source hardening.
# This spec covers the real STUN/TCP channel-frame mechanic fixed in the
# 4.10.0 range: adding a 16-bit wire length to the header size must happen in
# a widened accumulator before comparing against the available buffer.

test "rank521: STUN channel frame length wraps in uint16 accumulator"
  lang c
  file ns_turn_msg.c
  expect VYQL-MEM-051
  expect_review code.ProtocolFrameLengthUint16Wrap
  code
  ```
  typedef unsigned char uint8_t;
  typedef unsigned short uint16_t;
  typedef unsigned int uint32_t;
  typedef unsigned long size_t;

  static uint16_t nswap16(uint16_t v);
  #define VALID_CHANNEL(ch) ((ch) >= 0x4000)

  int parse_frame(uint8_t *buf, size_t blen, size_t *app_len) {
    uint16_t chn = nswap16(((const uint16_t *)buf)[0]);
    if (VALID_CHANNEL(chn)) {
      uint16_t total = 4 + nswap16(((const uint16_t *)buf)[1]);
      *app_len = total;
      if (total <= blen) {
        return total;
      }
    }
    return -1;
  }
  ```

test "rank521: STUN channel frame length uses widened accumulator"
  lang c
  file ns_turn_msg.c
  reject VYQL-MEM-051
  reject_review code.ProtocolFrameLengthUint16Wrap
  code
  ```
  typedef unsigned char uint8_t;
  typedef unsigned short uint16_t;
  typedef unsigned int uint32_t;
  typedef unsigned long size_t;

  static uint16_t nswap16(uint16_t v);
  #define VALID_CHANNEL(ch) ((ch) >= 0x4000)

  int parse_frame(uint8_t *buf, size_t blen, size_t *app_len) {
    uint16_t chn = nswap16(((const uint16_t *)buf)[0]);
    if (VALID_CHANNEL(chn)) {
      uint32_t total = 4u + (uint32_t)nswap16(((const uint16_t *)buf)[1]);
      *app_len = total;
      if (total <= blen) {
        return (int)total;
      }
    }
    return -1;
  }
  ```
