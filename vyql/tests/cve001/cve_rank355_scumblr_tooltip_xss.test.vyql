test "rank355: Scumblr task status message is concatenated unescaped"
  lang config
  file index.html.erb
  expect VYQL-INJ-028
  code
  ```
  <% message +=  "<br/>" + task.metadata.try(:[], "_last_status_message").to_s if task.metadata.try(:[], "_last_status_message")%>
  <td class="<%= status_class %> has-tip bettertooltip" data-tooltip title="<%= message %>">&nbsp;</td>
  ```

test "rank355: Scumblr task status message is escaped before tooltip render"
  lang config
  file index.html.erb
  reject VYQL-INJ-028
  code
  ```
  <% message +=  "<br/>" + h(task.metadata.try(:[], "_last_status_message").to_s) if task.metadata.try(:[], "_last_status_message") %>
  <td class="<%= status_class %> has-tip bettertooltip" data-tooltip title="<%= message %>">&nbsp;</td>
  ```
