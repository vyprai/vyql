test "rank355: Scumblr attack vector tooltip note is unescaped ERB"
  lang config
  file _vulnerability.html.erb
  expect VYQL-INJ-028
  code
  ```
  <span data-tooltip aria-haspopup="true" class="has-tip tip-left" title="<%= vect["note"]%>"><i class="fi-info"></i></span>
  ```

test "rank355: Scumblr attack vector tooltip note is escaped"
  lang config
  file _vulnerability.html.erb
  reject VYQL-INJ-028
  code
  ```
  <span data-tooltip aria-haspopup="true" class="has-tip tip-left" title="<%= h(vect["note"])%>"><i class="fi-info"></i></span>
  ```

