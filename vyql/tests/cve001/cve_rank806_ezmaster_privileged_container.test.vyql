# Rank 806 / CVE-2019-16767: EzMaster created every application
# instance as a privileged Docker container with SYS_ADMIN instead of making
# that capability an explicit app-manifest opt-in.

test "rank806: EzMaster unconditionally creates privileged Docker instances"
  lang javascript
  file v1-instances.js
  expect VYQL-CFG-010
  code
  ```
  const exec = require("child_process").exec;

  router.route("").post(bodyParser(), function(req, res, next) {
    app.readEzmasterAppConfig(image, function(err, appConfig) {
      var cmd =
        "docker run -dt" +
        " -v " + process.env.EZMASTER_PATH + "/data/instances/" + technicalName + "/tmp/:/tmp" +
        " -p " + portMax + ":" + appConfig.httpPort + " " +
        "--net=ezmaster_eznetwork --link ezmaster_db --link ezmaster-api --ulimit core=0 --privileged=true --cap-add SYS_ADMIN --device /dev/fuse " +
        "--name " + technicalName + " " + image;

      exec(cmd, function(err, stdout, stderr) {
        if (err) return next(err);
        res.status(200).send("Instance technicalName created");
      });
    });
  });
  ```

test "rank806: EzMaster gates SYS_ADMIN privileged mode on app capabilities"
  lang javascript
  file v1-instances.js
  reject VYQL-CFG-010
  code
  ```
  const exec = require("child_process").exec;

  router.route("").post(bodyParser(), function(req, res, next) {
    app.readEzmasterAppConfig(image, function(err, appConfig) {
      var cmd =
        "docker run -dt" +
        " -v " + process.env.EZMASTER_PATH + "/data/instances/" + technicalName + "/tmp/:/tmp" +
        " -p " + portMax + ":" + appConfig.httpPort + " " +
        "--net=ezmaster_eznetwork --link ezmaster_db --link ezmaster-api --ulimit core=0 " +
        (appConfig.capabilities === "SYS_ADMIN"
          ? "--privileged=true --cap-add SYS_ADMIN --device /dev/fuse "
          : "--privileged=false ") +
        "--name " + technicalName + " " + image;

      exec(cmd, function(err, stdout, stderr) {
        if (err) return next(err);
        res.status(200).send("Instance technicalName created");
      });
    });
  });
  ```
