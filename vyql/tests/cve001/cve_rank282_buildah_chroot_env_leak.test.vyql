# Rank 282 / CVE-2021-3602: Buildah chroot isolation passed the full parent
# process environment to intermediate helper processes, exposing CI secrets to
# build/run commands that could inspect parent/grandparent environments.

test "rank282: buildah chroot helper inherits full process environment"
  lang go
  expect VYQL-SEC-005
  code
  ```
  package chroot

  import (
    "fmt"
    "os"
    "github.com/containers/storage/pkg/unshare"
    "github.com/sirupsen/logrus"
  )

  const runUsingChrootCommand = "buildah-chroot"

  func RunUsingChroot() error {
    cmd := unshare.Command(runUsingChrootCommand)
    cmd.Dir = "/"
    cmd.Env = append([]string{fmt.Sprintf("LOGLEVEL=%d", logrus.GetLevel())}, os.Environ()...)
    return cmd.Run()
  }
  ```

test "rank282: buildah chroot helper receives only curated log level environment"
  lang go
  reject VYQL-SEC-005
  code
  ```
  package chroot

  import (
    "fmt"
    "github.com/containers/storage/pkg/unshare"
    "github.com/sirupsen/logrus"
  )

  const runUsingChrootCommand = "buildah-chroot"

  func RunUsingChroot() error {
    cmd := unshare.Command(runUsingChrootCommand)
    cmd.Dir = "/"
    cmd.Env = []string{fmt.Sprintf("LOGLEVEL=%d", logrus.GetLevel())}
    return cmd.Run()
  }
  ```
