# Rank 115 / CVE-2024-37152: the Argo CD settings service answers the login
# page, so AuthFuncOverride swallows the authentication error for Get and the
# handler runs unauthenticated. The response carried PasswordPattern, the
# configured password regular expression, alongside fields the same handler
# already gated behind sessionmgr.LoggedIn. The fix moves that field behind
# the same session check.

test "rank115: settings response carries the password pattern ungated"
  lang go
  expect VYQL-AUTH-175
  code
  ```
  package settings

  import (
      "context"

      sessionmgr "github.com/argoproj/argo-cd/v2/util/session"
      settingspkg "github.com/argoproj/argo-cd/v2/pkg/apiclient/settings"
  )

  // Get returns the public settings used by the login page.
  func (s *Server) Get(ctx context.Context, q *settingspkg.SettingsQuery) (*settingspkg.Settings, error) {
      argoCDSettings, err := s.mgr.GetSettings()
      if err != nil {
          return nil, err
      }
      set := settingspkg.Settings{
          URL:                argoCDSettings.URL,
          UiCssURL:           argoCDSettings.UiCssURL,
          UserLoginsDisabled: s.userLoginsDisabled,
          PasswordPattern:    argoCDSettings.PasswordPattern,
          TrackingMethod:     argoCDSettings.TrackingMethod,
      }
      if sessionmgr.LoggedIn(ctx) || s.disableAuth {
          set.UiBannerContent = argoCDSettings.UiBannerContent
          set.UiBannerURL = argoCDSettings.UiBannerURL
      }
      return &set, nil
  }
  ```

test "rank115: password pattern assigned only inside the session gate"
  lang go
  reject VYQL-AUTH-175
  code
  ```
  package settings

  import (
      "context"

      sessionmgr "github.com/argoproj/argo-cd/v2/util/session"
      settingspkg "github.com/argoproj/argo-cd/v2/pkg/apiclient/settings"
  )

  // Get returns the public settings used by the login page.
  func (s *Server) Get(ctx context.Context, q *settingspkg.SettingsQuery) (*settingspkg.Settings, error) {
      argoCDSettings, err := s.mgr.GetSettings()
      if err != nil {
          return nil, err
      }
      set := settingspkg.Settings{
          URL:                argoCDSettings.URL,
          UiCssURL:           argoCDSettings.UiCssURL,
          UserLoginsDisabled: s.userLoginsDisabled,
          TrackingMethod:     argoCDSettings.TrackingMethod,
      }
      if sessionmgr.LoggedIn(ctx) || s.disableAuth {
          set.UiBannerContent = argoCDSettings.UiBannerContent
          set.UiBannerURL = argoCDSettings.UiBannerURL
      }
      if sessionmgr.LoggedIn(ctx) {
          set.PasswordPattern = argoCDSettings.PasswordPattern
      }
      return &set, nil
  }
  ```
