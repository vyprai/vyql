# Rank 750 / CVE-2026-34229: emlog's UBB parser rendered [url]/[img]
# values directly into href/src attributes until the fix restricted them to
# http/https URL schemes.

test "rank750: UBB url and image tags lack protocol allowlist"
  lang php
  expect VYQL-INJ-164
  expect_review code.BbcodeUrlTagProtocolXss
  code
  ```
  <?php
  function parseUBB($content)
  {
      if (empty($content)) {
          return $content;
      }

      $ubbPatterns = array(
          '/\[b\](.*?)\[\/b\]/is' => '<b>$1</b>',
          '/\[url\](.*?)\[\/url\]/is' => '<a href="$1" target="_blank" rel="nofollow">$1</a>',
          '/\[img\](.*?)\[\/img\]/is' => '<img src="$1" alt="UBB image" style="max-width:100%;height:auto;" />',
      );

      foreach ($ubbPatterns as $pattern => $replacement) {
          $content = preg_replace($pattern, $replacement, $content);
      }

      return $content;
  }
  ?>
  ```

test "rank750: UBB url and image tags restrict protocols"
  lang php
  reject VYQL-INJ-164
  reject_review code.BbcodeUrlTagProtocolXss
  code
  ```
  <?php
  function parseUBB($content)
  {
      if (empty($content)) {
          return $content;
      }

      $ubbPatterns = array(
          '/\[b\](.*?)\[\/b\]/is' => '<b>$1</b>',
          '/\[url\]((?:https?:\/\/)[^\s<>"\']+)\[\/url\]/is' => '<a href="$1" target="_blank" rel="nofollow noopener noreferrer">$1</a>',
          '/\[img\]((?:https?:\/\/)[^\s<>"\']+)\[\/img\]/is' => '<img src="$1" alt="UBB image" style="max-width:100%;height:auto;" />',
      );

      foreach ($ubbPatterns as $pattern => $replacement) {
          $content = preg_replace($pattern, $replacement, $content);
      }

      return $content;
  }
  ?>
  ```
