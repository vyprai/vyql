test "rank726: route config key is persisted without ID validation"
  lang go
  file meta_init.go
  expect VYQL-INJ-159
  expect_review code.UnvalidatedRouteConfigKeyStoredXss
  code
  ```
  package server

  import (
    "encoding/json"
    "io"
    "net/http"
  )

  var meta = struct {
    AddConnectionConfKey func(string, string, string, map[string]interface{}) error
  }{}
  var mux = struct {
    Vars func(*http.Request) map[string]string
  }{}

  func getLanguage(r *http.Request) string { return "en_US" }
  func handleError(http.ResponseWriter, error, string, interface{}) {}
  var logger interface{}

  func connectionConfKeyHandler(w http.ResponseWriter, r *http.Request) {
    vars := mux.Vars(r)
    pluginName := vars["name"]
    confKey := vars["confKey"]
    language := getLanguage(r)
    if r.Method == http.MethodPut {
      v, err := io.ReadAll(r.Body)
      if err != nil {
        handleError(w, err, "Invalid body", logger)
        return
      }
      reqField := make(map[string]interface{})
      err = json.Unmarshal(v, &reqField)
      if err != nil {
        handleError(w, err, "Invalid body", logger)
        return
      }
      _ = meta.AddConnectionConfKey(pluginName, confKey, language, reqField)
    }
  }
  ```

test "rank726: route config key is validated before persistence"
  lang go
  file meta_init.go
  reject VYQL-INJ-159
  reject_review code.UnvalidatedRouteConfigKeyStoredXss
  code
  ```
  package server

  import (
    "encoding/json"
    "io"
    "net/http"
  )

  var meta = struct {
    AddConnectionConfKey func(string, string, string, map[string]interface{}) error
  }{}
  var mux = struct {
    Vars func(*http.Request) map[string]string
  }{}
  var validate = struct {
    ValidateID func(string) error
  }{}

  func getLanguage(r *http.Request) string { return "en_US" }
  func handleError(http.ResponseWriter, error, string, interface{}) {}
  var logger interface{}

  func connectionConfKeyHandler(w http.ResponseWriter, r *http.Request) {
    vars := mux.Vars(r)
    pluginName := vars["name"]
    confKey := vars["confKey"]
    language := getLanguage(r)
    if r.Method == http.MethodPut {
      if err := validate.ValidateID(confKey); err != nil {
        handleError(w, err, "Invalid confKey", logger)
        return
      }
      v, err := io.ReadAll(r.Body)
      if err != nil {
        handleError(w, err, "Invalid body", logger)
        return
      }
      reqField := make(map[string]interface{})
      err = json.Unmarshal(v, &reqField)
      if err != nil {
        handleError(w, err, "Invalid body", logger)
        return
      }
      _ = meta.AddConnectionConfKey(pluginName, confKey, language, reqField)
    }
  }
  ```
