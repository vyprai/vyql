test "rank596: URL object built from http endpoint and fetched is cleartext"
  lang javascript
  expect VYQL-CFG-006
  code
  ```
  import { URL, URLSearchParams } from 'node:url';

  export default async function dectalk(text) {
    const url = new URL('http://tts.cyzon.us/tts');
    url.search = new URLSearchParams({ text }).toString();
    return await fetch(url);
  }
  ```

test "rank596: URL object built from https endpoint and fetched is encrypted"
  lang javascript
  reject VYQL-CFG-006
  code
  ```
  import { URL, URLSearchParams } from 'node:url';

  export default async function dectalk(text) {
    const url = new URL('https://tts.cyzon.us/tts');
    url.search = new URLSearchParams({ text }).toString();
    return await fetch(url);
  }
  ```
