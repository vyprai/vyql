# Rank 95 / CVE-2024-36127: apko logged the marshalled image configuration
# on build failure, and ImageContents can carry credentialed APK repository
# URLs. The fix gives ImageContents a MarshalYAML that parses and rewrites
# those URLs, so the marshalled form no longer embeds credentials.

test "rank95: image contents type with repository URLs has no safe marshal"
  lang go
  expect VYQL-SEC-041
  code
  ```
  package types

  type ImageContents struct {
  	Repositories []string `json:"repositories,omitempty"`
  	Keyring      []string `json:"keyring,omitempty"`
  	Packages     []string `json:"packages,omitempty"`
  }
  ```

test "rank95: image contents type defines a redacting MarshalYAML"
  lang go
  reject VYQL-SEC-041
  code
  ```
  package types

  type ImageContents struct {
  	Repositories []string `json:"repositories,omitempty"`
  	Keyring      []string `json:"keyring,omitempty"`
  	Packages     []string `json:"packages,omitempty"`
  }

  func (ic ImageContents) MarshalYAML() (interface{}, error) {
  	redacted := ic
  	redacted.Repositories = rewriteCredentialedURLs(ic.Repositories)
  	return redacted, nil
  }
  ```
