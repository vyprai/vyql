# verify_current_expected: skip-fresh-target
# Rank 598 / CVE-2026-45311: the fresh checkout is already the v0.8.23
# security release where run_tests requires approval. This spec covers the real
# vulnerable mechanic while the corpus pointer remains an attention item.

test "rank598: run_tests executes cargo test with automatic approval"
  lang rust
  file test_runner.rs
  expect VYQL-AUTH-091
  expect_review code.RunTestsAutoApprovalExecutesCode
  code
  ```
  pub enum ApprovalRequirement {
      Auto,
      Required,
      Suggest,
  }

  pub enum ToolCapability {
      ExecutesCode,
      Sandboxable,
  }

  pub trait ToolSpec {
      fn name(&self) -> &'static str;
      fn capabilities(&self) -> Vec<ToolCapability>;
      fn approval_requirement(&self) -> ApprovalRequirement {
          ApprovalRequirement::Auto
      }
      fn command(&self) -> &'static str;
  }

  pub struct RunTestsTool;

  impl ToolSpec for RunTestsTool {
      fn name(&self) -> &'static str {
          "run_tests"
      }

      fn capabilities(&self) -> Vec<ToolCapability> {
          vec![ToolCapability::ExecutesCode, ToolCapability::Sandboxable]
      }

      fn command(&self) -> &'static str {
          "cargo test"
      }
  }
  ```

test "rank598: run_tests requires approval before executing cargo test"
  lang rust
  file test_runner.rs
  reject VYQL-AUTH-091
  reject_review code.RunTestsAutoApprovalExecutesCode
  code
  ```
  pub enum ApprovalRequirement {
      Auto,
      Required,
      Suggest,
  }

  pub enum ToolCapability {
      ExecutesCode,
      Sandboxable,
  }

  pub trait ToolSpec {
      fn name(&self) -> &'static str;
      fn capabilities(&self) -> Vec<ToolCapability>;
      fn approval_requirement(&self) -> ApprovalRequirement;
      fn command(&self) -> &'static str;
  }

  pub struct RunTestsTool;

  impl ToolSpec for RunTestsTool {
      fn name(&self) -> &'static str {
          "run_tests"
