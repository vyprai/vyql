# Rank 598 / CVE-2026-45311: the real fix is DeepSeek-TUI 401c1f6cf8
# ("fix(security): tighten approval policy for run_tests"), which flips
# run_tests from ApprovalRequirement::Auto to Required. The extractor accepts
# the real cargo-test spellings (backticked `cargo test` in the description,
# Command::new("cargo") beside vec!["test"]) as well as the command() literal.

test "rank598: run_tests executes cargo test with automatic approval"
  lang rust
  file test_runner.rs
  expect VYQL-AUTH-091
  expect_review code.RunTestsAutoApprovalExecutesCode
  code
  ```
  pub enum ApprovalRequirement {
      Auto,
      Required,
      Suggest,
  }

  pub enum ToolCapability {
      ExecutesCode,
      Sandboxable,
  }

  pub trait ToolSpec {
      fn name(&self) -> &'static str;
      fn capabilities(&self) -> Vec<ToolCapability>;
      fn approval_requirement(&self) -> ApprovalRequirement {
          ApprovalRequirement::Auto
      }
      fn command(&self) -> &'static str;
  }

  pub struct RunTestsTool;

  impl ToolSpec for RunTestsTool {
      fn name(&self) -> &'static str {
          "run_tests"
      }

      fn capabilities(&self) -> Vec<ToolCapability> {
          vec![ToolCapability::ExecutesCode, ToolCapability::Sandboxable]
      }

      fn command(&self) -> &'static str {
          "cargo test"
      }
  }
  ```

