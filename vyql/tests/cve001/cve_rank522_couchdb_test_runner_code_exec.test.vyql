# Rank 522 / CVE-2012-5649: CouchDB test runner code execution.
# Ledger verification: VYQL-INJ-003 catches script-controlled evaluation.

test "rank522: CouchDB test runner evaluates query script"
  lang javascript
  expect VYQL-INJ-003
  code
  ```
  function runTest(req) {
    const source = req.query.test;
    return eval(source);
  }
  ```

test "rank522: CouchDB test runner evaluates static script"
  lang javascript
  reject VYQL-INJ-003
  code
  ```
  function runTest(req) {
    return eval("1 + 1");
  }
  ```
