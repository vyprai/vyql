test "rank128 assign-deep recursively assigns caller object keys without prototype guard"
  lang javascript
  profile library
  expect VYQL-INJ-013
  code
  ```
  var typeOf = require('kind-of');

  function assign(target) {
    target = target || {};
    var len = arguments.length, i = 0;
    while (++i < len) {
      var val = arguments[i];
      if (isObject(val)) {
        extend(target, val);
      }
    }
    return target;
  }

  function extend(target, obj) {
    for (var key in obj) {
      if (hasOwn(obj, key)) {
        var val = obj[key];
        if (isObject(val)) {
          target[key] = assign(target[key] || {}, val);
        } else {
          target[key] = val;
        }
      }
    }
    return target;
  }

  function isObject(obj) {
    return typeOf(obj) === 'object' || typeOf(obj) === 'function';
  }

  function hasOwn(obj, key) {
    return Object.prototype.hasOwnProperty.call(obj, key);
  }

  module.exports = assign;
  ```

test "rank128 assign-deep prototype key guard suppresses recursive assignment pollution"
  lang javascript
  profile library
  reject VYQL-INJ-013
  code
  ```
  var typeOf = require('kind-of');

  function assign(target) {
    target = target || {};
    var len = arguments.length, i = 0;
    while (++i < len) {
      var val = arguments[i];
      if (isObject(val)) {
        extend(target, val);
      }
    }
    return target;
  }

  function extend(target, obj) {
    for (var key in obj) {
      if (key === '__proto__') continue;
      if (hasOwn(obj, key)) {
        var val = obj[key];
        if (isObject(val)) {
          target[key] = assign(target[key] || {}, val);
        } else {
          target[key] = val;
        }
      }
    }
    return target;
  }

  function isObject(obj) {
    return typeOf(obj) === 'object' || typeOf(obj) === 'function';
  }

  function hasOwn(obj, key) {
    return Object.prototype.hasOwnProperty.call(obj, key);
  }

  module.exports = assign;
  ```
