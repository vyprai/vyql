# Rank 863 / CVE-2024-10073: Flair's clustering model loader nested
# joblib.load under pickle.loads before clustering support was removed.

test "rank863: model loader passes joblib artifact through pickle.loads"
  lang python
  profile library
  file flair/models/clustering.py
  expect VYQL-DESER-018
  expect_review code.PickleLoadsJoblibModelLoader
  code
  ```
  import pickle
  import joblib

  class ClusteringModel:
      @staticmethod
      def load(model_file):
          return pickle.loads(joblib.load(str(model_file)))
  ```

test "rank863: removed model loader has no nested pickle/joblib load"
  lang python
  profile library
  file flair/models/clustering.py
  reject VYQL-DESER-018
  reject_review code.PickleLoadsJoblibModelLoader
  code
  ```
  class ClusteringModel:
      pass
  ```

test "rank863: restricted unpickler suppresses nested model loader review"
  lang python
  profile library
  file flair/models/clustering.py
  reject VYQL-DESER-018
  code
  ```
  import joblib

  class RestrictedUnpickler:
      @staticmethod
      def loads(data):
          return data

  class ClusteringModel:
      @staticmethod
      def load(model_file):
          return RestrictedUnpickler.loads(joblib.load(str(model_file)))
  ```
