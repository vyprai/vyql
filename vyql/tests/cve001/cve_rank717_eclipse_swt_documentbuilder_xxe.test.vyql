# Rank 717 / CVE-2023-4218: Eclipse SWT XML document builder XXE.
# Ledger verification: VYQL-DESER-004 catches unhardened DocumentBuilder parse.

test "rank717: Eclipse SWT document builder parses input without hardening"
  lang java
  expect VYQL-DESER-004
  code
  ```
  import javax.xml.parsers.DocumentBuilder;
  import javax.xml.parsers.DocumentBuilderFactory;
  import org.xml.sax.InputSource;

  class MacGenerator {
      void getDocument(InputSource input) throws Exception {
          DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
          DocumentBuilder builder = factory.newDocumentBuilder();
          builder.parse(input);
      }
  }
  ```

test "rank717: Eclipse SWT document builder disallows doctype"
  lang java
  reject VYQL-DESER-004
  code
  ```
  import javax.xml.parsers.DocumentBuilder;
  import javax.xml.parsers.DocumentBuilderFactory;
  import org.xml.sax.InputSource;

  class MacGenerator {
      void getDocument(InputSource input) throws Exception {
          DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
          factory.setFeature("http://apache.org/xml/features/disallow-doctype-decl", true);
          DocumentBuilder builder = factory.newDocumentBuilder();
          builder.parse(input);
      }
  }
  ```
