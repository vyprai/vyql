# Rank 869 / CVE-2016-1000001: Flask-OIDC carried the post-login
# destination through the OIDC state value unsigned, then redirected to it after
# callback. A rogue or compromised IdP could alter that destination.

test "rank869: OIDC state destination is redirected without signing"
  lang python
  file __init__.py
  expect VYQL-RF-038
  expect_review code.UnsignedOidcStateDestinationRedirect
  code
  ```
  import json
  from flask import request, redirect

  class OpenIDConnect:
      def redirect_to_auth_server(self, destination):
          state = {
              "csrf_token": "token",
              "destination": destination,
          }
          extra_params = {
              "state": json.dumps(state),
          }
          return redirect("/authorize?state=" + extra_params["state"])

      def _oidc_callback(self):
          state = json.loads(request.args["state"])
          csrf_token = state["csrf_token"]
          destination = state["destination"]
          code = request.args["code"]
          if not csrf_token or not code:
              return redirect("/")
          response = redirect(destination)
          return response
  ```

test "rank869: OIDC state destination is signed before callback redirect"
  lang python
  file __init__.py
  reject VYQL-RF-038
  reject_review code.UnsignedOidcStateDestinationRedirect
  code
  ```
  import json
  from flask import request, redirect
  from itsdangerous import BadSignature, JSONWebSignatureSerializer

  class OpenIDConnect:
      def __init__(self, secret):
          self.destination_serializer = JSONWebSignatureSerializer(secret)

      def redirect_to_auth_server(self, destination):
          destination = self.destination_serializer.dumps(destination)
          state = {
              "csrf_token": "token",
              "destination": destination,
          }
          extra_params = {
              "state": json.dumps(state),
          }
          return redirect("/authorize?state=" + extra_params["state"])

      def _oidc_callback(self):
          state = json.loads(request.args["state"])
          csrf_token = state["csrf_token"]
          destination = state["destination"]
          code = request.args["code"]
          if not csrf_token or not code:
              return redirect("/")
          try:
              response = redirect(self.destination_serializer.loads(destination))
          except BadSignature:
              response = redirect("/")
          return response
  ```
