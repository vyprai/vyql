# Rank 680 / CVE-2024-47182: Dozzle stored and verified file-auth passwords
# with fast SHA-256 hashes before switching generated hashes to bcrypt.

test "rank680: Dozzle generates and verifies passwords with sha256sum"
  lang go
  file users.go
  expect VYQL-CRY-013
  code
  ```
  package auth

  import "crypto/sha256"

  type User struct {
      Username string
      Password string
  }

  func GenerateUsers(user User, hashPassword bool) User {
      if hashPassword {
          user.Password = sha256sum(user.Password)
      }
      return user
  }

  func (u *UserDatabase) FindByPassword(username, password string) *User {
      user := u.Find(username)
      if user == nil {
          return nil
      }
      if user.Password != sha256sum(password) {
          return nil
      }
      return user
  }

  func sha256sum(s string) string {
      bytes := sha256.Sum256([]byte(s))
      return string(bytes[:])
  }
  ```

test "rank680: Dozzle generates bcrypt hashes and delegates password verification"
  lang go
  file users.go
  reject VYQL-CRY-013
  code
  ```
  package auth

  import "golang.org/x/crypto/bcrypt"

  type User struct {
      Username string
      Password string
  }

  func GenerateUsers(user User, hashPassword bool) User {
      if hashPassword {
          hash, err := bcrypt.GenerateFromPassword([]byte(user.Password), 11)
          if err != nil {
              panic(err)
          }
          user.Password = string(hash)
      }
      return user
  }

  func (u *UserDatabase) FindByPassword(username, password string) *User {
      user := u.Find(username)
      if user == nil {
          return nil
      }
      if !CompareHashAndPassword(user.Password, password) {
          return nil
      }
      return user
  }
  ```
