# Rank 757 / CVE-2024-24294: Blackprint path setters rejected literal
# prototype keys, but non-primitive path segments could coerce to those keys.

test "rank757: path setter indexes untyped path segments after literal prototype-key guard"
  lang javascript
  file utils.js
  expect VYQL-INJ-165
  expect_review code.CoerciblePathSegmentPrototypePollution
  code
  ```
  function setDeepProperty(obj, path, value, onCreate){
    let temp;

    for(var i = 0, n = path.length-1; i < n; i++){
      temp = path[i];

      if(temp === "constructor" || temp === "__proto__" || temp === "prototype")
        return;

      if(obj[temp] === void 0){
        obj[temp] = {};
        onCreate && onCreate(obj[temp]);
      }

      obj = obj[temp];
    }

    temp = path[i];
    if(temp === "constructor" || temp === "__proto__" || temp === "prototype")
      return;

    obj[temp] = value;
  }
  ```

test "rank757: path setter rejects non-string and non-number segments"
  lang javascript
  file utils.js
  reject VYQL-INJ-165
  reject_review code.CoerciblePathSegmentPrototypePollution
  code
  ```
  function setDeepProperty(obj, path, value, onCreate){
    let temp;

    for(var i = 0, n = path.length-1; i < n; i++){
      temp = path[i];

      if(temp.constructor !== String && temp.constructor !== Number)
        throw new Error("Object field must be Number or String");

      if(temp === "constructor" || temp === "__proto__" || temp === "prototype")
        return;

      if(obj[temp] === void 0){
        obj[temp] = {};
        onCreate && onCreate(obj[temp]);
      }

      obj = obj[temp];
    }

    temp = path[i];
    if(temp.constructor !== String && temp.constructor !== Number)
      throw new Error("Object field must be Number or String");

    if(temp === "constructor" || temp === "__proto__" || temp === "prototype")
      return;

    obj[temp] = value;
  }
  ```
