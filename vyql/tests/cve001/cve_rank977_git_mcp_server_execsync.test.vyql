# Rank 977 / CVE-2026-4496: Git-MCP-Server built git shell command
# strings from branch/file arguments and executed them through execSync.

test "rank977: TypeScript git helper executes command string with execSync"
  lang javascript
  file src/gitUtils.ts
  expect VYQL-INJ-119
  expect VYQL-VAL-005
  expect_review code.CommandStringWrapperExecution
  code
  ```
  import { execSync } from 'child_process';

  export class GitUtils {
    static executeGit(command, repoPath) {
      return execSync(command, { cwd: repoPath, encoding: 'utf8' }).toString().trim();
    }

    static getFileDiff(repoPath, filename, fromBranch, toBranch) {
      return this.executeGit(
        `git diff ${fromBranch}..${toBranch} -- "${filename}"`,
        repoPath
      );
    }
  }
  ```

test "rank977: TypeScript git helper uses execFileSync argv"
  lang javascript
  file src/gitUtils.ts
  reject VYQL-INJ-119
  reject VYQL-VAL-005
  reject_review code.CommandStringWrapperExecution
  code
  ```
  import { execFileSync } from 'child_process';

  export class GitUtils {
    static executeGit(args, repoPath) {
      return execFileSync('git', args, { cwd: repoPath, encoding: 'utf8' }).toString().trim();
    }

    static getFileDiff(repoPath, filename, fromBranch, toBranch) {
      return this.executeGit(
        ['diff', `${fromBranch}..${toBranch}`, '--', filename],
        repoPath
      );
    }
  }
  ```
