# Rank 677 / CVE-2014-4172: dotnet-cas-client added a CAS service ticket to
# the validation URL query without URL-encoding the ticket value.

test "rank677: CAS validate URL adds raw service ticket query parameter"
  lang csharp
  file UrlUtil.cs
  expect VYQL-INJ-150
  code
  ```
  using System.Web;

  class UrlUtil {
      public static string ConstructValidateUrl(string serviceTicket) {
          EnhancedUriBuilder ub = new EnhancedUriBuilder("https://cas.example/serviceValidate");
          ub.QueryItems.Add(CasAuthentication.TicketValidator.ArtifactParameterName, serviceTicket);
          return ub.Uri.AbsoluteUri;
      }
  }
  ```

test "rank677: CAS validate URL encodes service ticket query parameter"
  lang csharp
  file UrlUtil.cs
  reject VYQL-INJ-150
  code
  ```
  using System.Web;

  class UrlUtil {
      public static string ConstructValidateUrl(string serviceTicket) {
          EnhancedUriBuilder ub = new EnhancedUriBuilder("https://cas.example/serviceValidate");
          ub.QueryItems.Add(CasAuthentication.TicketValidator.ArtifactParameterName, HttpUtility.UrlEncode(serviceTicket));
          return ub.Uri.AbsoluteUri;
      }
  }
  ```
