# Rank 854 / CVE-2023-40582: find-exec passed public API `arguments`
# through command lookup into child_process.execSync without shell quoting.

test "rank854: CommonJS arguments flow into execSync shell command"
  lang javascript
  profile library
  file index.js
  expect VYQL-INJ-002
  code
  ```
  var exec = require('child_process').execSync;
  var platform = require('os').platform();

  module.exports = function(){
    var commands = Array.isArray(arguments[0]) ? arguments[0] : Array.prototype.slice.apply(arguments);
    var command = null;

    commands.some(function(c){
      if (isExec(findCommand(c))){
        command = c;
        return true;
      }
    });

    return command;
  };

  function isExec(command){
    exec(command, {stdio: 'ignore'});
  }

  function findCommand(command){
    if (/^win/.test(platform)){
      return "where " + command;
    }

    return "command -v " + command;
  }
  ```

test "rank854: shell-quote escapes command probe"
  lang javascript
  profile library
  file index.js
  reject VYQL-INJ-002
  code
  ```
  var exec = require('child_process').execSync;
  var platform = require('os').platform();
  var quote = require("shell-quote").quote;

  module.exports = function(){
    var commands = Array.isArray(arguments[0]) ? arguments[0] : Array.prototype.slice.apply(arguments);
    var command = null;

    commands.some(function(c){
      if (isExec(findCommand(c))){
        command = c;
        return true;
      }
    });

    return command;
  };

  function isExec(command){
    exec(quote(command.split(" ")), {stdio: 'ignore'});
  }

  function findCommand(command){
    if (/^win/.test(platform)){
      return "where " + command;
    }

    return "command -v " + command;
  }
  ```
