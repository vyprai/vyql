# Rank 568 / CVE-2020-2324: Jenkins CVS changelog XML external entity parsing.
# Ledger verification: VYQL-DESER-002 catches tainted XML parser input.

test "rank568: CVS changelog parser parses request-controlled XML"
  lang java
  expect VYQL-DESER-002
  code
  ```
  class CvsChangeLogParser {
    void parse(HttpServletRequest req, DocumentBuilder builder) throws Exception {
      String xml = req.getParameter("changelog");
      builder.parse(xml);
    }
  }
  ```

test "rank568: CVS changelog parser disables doctype"
  lang java
  reject VYQL-DESER-002
  code
  ```
  class CvsChangeLogParser {
    void parse(HttpServletRequest req, DocumentBuilder builder) throws Exception {
      String xml = req.getParameter("changelog");
      parser.setFeature("http://apache.org/xml/features/disallow-doctype-decl", true);
      builder.parse("safe.xml");
    }
  }
  ```
