# Rank 770 / CVE-2022-4942: eslint-detailed-reporter rendered ESLint
# issue messages into an HTML report template without escaping.

test "rank770: linter issue message is passed to HTML template unescaped"
  lang javascript
  file template-generator.js
  expect VYQL-INJ-166
  expect_review code.UnescapedLinterIssueMessageXss
  code
  ```
  const _ = require('lodash');
  const fs = require('fs');
  const issueTemplate = _.template(fs.readFileSync('issue.html', 'utf-8'));

  function severityString(severity) {
    return severity === 1 ? 'warning' : 'error';
  }

  function renderIssue(message) {
    return issueTemplate({
      severity: severityString(message.severity),
      severityName: message.severity === 1 ? 'Warning' : 'Error',
      lineNumber: message.line,
      column: message.column,
      message: message.message,
      ruleId: message.ruleId
    });
  }
  ```

test "rank770: linter issue message is escaped before HTML template"
  lang javascript
  file template-generator.js
  reject VYQL-INJ-166
  reject_review code.UnescapedLinterIssueMessageXss
  code
  ```
  const _ = require('lodash');
  const fs = require('fs');
  const issueTemplate = _.template(fs.readFileSync('issue.html', 'utf-8'));

  function severityString(severity) {
    return severity === 1 ? 'warning' : 'error';
  }

  function renderIssue(message) {
    return issueTemplate({
      severity: severityString(message.severity),
      severityName: message.severity === 1 ? 'Warning' : 'Error',
      lineNumber: message.line,
      column: message.column,
      message: _.escape(message.message),
      ruleId: message.ruleId
    });
  }
  ```
