test "rank709: Jenkins EC2 launcher logs private key material"
  lang java
  expect VYQL-SEC-001
  code
  ```
  package hudson.plugins.ec2.ssh;

  class EC2UnixLauncher {
      private void logInfo(Object computer, Object listener, String message) {
          System.out.println(message);
      }

      private boolean bootstrap(Object computer, Object listener, KeyPair key) {
          logInfo(computer, listener, "Using key: " + key.getKeyName() + "\n" +
              key.getKeyFingerprint() + "\n" + key.getKeyMaterial().substring(0, 160));
          return true;
      }
  }

  interface KeyPair {
      String getKeyName();
      String getKeyFingerprint();
      String getKeyMaterial();
  }
  ```

test "rank709: Jenkins EC2 launcher logs only key name and fingerprint"
  lang java
  reject VYQL-SEC-001
  code
  ```
  package hudson.plugins.ec2.ssh;

  class EC2UnixLauncher {
      private void logInfo(Object computer, Object listener, String message) {
          System.out.println(message);
      }

      private boolean bootstrap(Object computer, Object listener, KeyPair key) {
          logInfo(computer, listener,
              String.format("Using private key %s (SHA-1 fingerprint %s)",
                  key.getKeyName(), key.getKeyFingerprint()));
          return true;
      }
  }

  interface KeyPair {
      String getKeyName();
      String getKeyFingerprint();
      String getKeyMaterial();
  }
  ```
