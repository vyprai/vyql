test "rank507: network manager role has overbroad backup and restore permissions"
  lang go
  expect VYQL-AUTH-028
  expect_review code.OverbroadRolePermissionGrant
  code
  ```
  package server

  type RoleID int

  const (
      RoleAdmin RoleID = 1
      RoleNetworkManager RoleID = 3
  )

  var PermissionsByRole = map[RoleID][]string{
      RoleAdmin: {"*"},
      RoleNetworkManager: {
          PermReadUser, PermUpdateOperatorSlice,
          PermBackup, PermRestore, PermSupportBundle,
      },
  }

  const (
      PermBackup = "backup:create"
      PermRestore = "backup:restore"
      PermSupportBundle = "support_bundle:generate"
  )
  ```

test "rank507: network manager role keeps support bundle but not backup restore"
