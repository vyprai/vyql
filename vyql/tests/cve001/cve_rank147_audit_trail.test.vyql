test "rank147: Jenkins regex validation exception message rendered as markup"
  lang java
  expect VYQL-INJ-033
  code
  ```
  import hudson.util.FormValidation;
  import org.kohsuke.stapler.QueryParameter;
  import java.util.regex.Pattern;

  class AuditTrailPlugin {
    public FormValidation doRegexCheck(@QueryParameter final String value) {
      try {
        Pattern.compile(value);
        return FormValidation.ok();
      } catch (Exception ex) {
        return FormValidation.errorWithMarkup("Invalid regular expression (" + ex.getMessage() + ")");
      }
    }
  }
  ```

test "rank147: Jenkins regex validation exception message escaped before markup"
  lang java
  reject VYQL-INJ-033
  code
  ```
  import hudson.Util;
  import hudson.util.FormValidation;
  import org.kohsuke.stapler.QueryParameter;
  import java.util.regex.Pattern;

  class AuditTrailPlugin {
    public FormValidation doRegexCheck(@QueryParameter final String value) {
      try {
        Pattern.compile(value);
        return FormValidation.ok();
      } catch (Exception ex) {
        return FormValidation.errorWithMarkup("Invalid regular expression (" + Util.escape(ex.getMessage()) + ")");
      }
    }
  }
  ```

test "rank147: Stapler query parameter directly returned as markup is reflected XSS"
  lang java
  expect VYQL-INJ-004
  code
  ```
  import hudson.util.FormValidation;
  import org.kohsuke.stapler.QueryParameter;

  class DescriptorImpl {
    public FormValidation doCheckName(@QueryParameter String value) {
      return FormValidation.errorWithMarkup("Name: " + value);
    }
  }
  ```

test "rank147: Stapler query parameter escaped before markup is clean"
  lang java
  reject VYQL-INJ-004
  code
  ```
  import hudson.Util;
  import hudson.util.FormValidation;
  import org.kohsuke.stapler.QueryParameter;

  class DescriptorImpl {
    public FormValidation doCheckName(@QueryParameter String value) {
      return FormValidation.errorWithMarkup("Name: " + Util.escape(value));
    }
  }
  ```
