# Rank 303 / CVE-2026-30853: calibre's RocketBook reader wrote table-of-
# contents item names directly under the extraction directory, allowing crafted
# .rb entries with traversal components to escape the container directory.

test "rank303: calibre RB entry name reaches output file write without containment"
  lang python
  expect VYQL-PATH-001
  code
  ```
  import os

  class Reader:
      def get_text(self, toc_item, output_dir):
          output = ''
          self.stream.seek(toc_item.offset)
          output += self.stream.read(toc_item.size).decode('cp1252', 'replace')

          with open(os.path.join(output_dir, toc_item.name.decode('utf-8')), 'wb') as html:
              html.write(output.replace('<TITLE>', '<TITLE> ').encode('utf-8'))

      def get_image(self, toc_item, output_dir):
          if toc_item.flags != 0:
              return

          self.stream.seek(toc_item.offset)
          data = self.stream.read(toc_item.size)

          with open(os.path.join(output_dir, toc_item.name.decode('utf-8')), 'wb') as img:
              img.write(data)
  ```

test "rank303: calibre RB entry name is confined through get_safe_path"
  lang python
  reject VYQL-PATH-001
  code
  ```
  import os

  class Reader:
      def get_safe_path(self, output_dir, name):
          base = os.path.abspath(output_dir)
          if not base.endswith(os.sep):
              base += os.sep
          ans = os.path.abspath(os.path.join(base, name))
          if os.path.commonprefix([ans, base]) != base:
              ans = ''
          return ans

      def get_text(self, toc_item, output_dir):
          output = ''
          self.stream.seek(toc_item.offset)
          output += self.stream.read(toc_item.size).decode('cp1252', 'replace')

          if path := self.get_safe_path(output_dir, toc_item.name.decode('utf-8')):
              with open(path, 'wb') as html:
                  html.write(output.replace('<TITLE>', '<TITLE> ').encode('utf-8'))

      def get_image(self, toc_item, output_dir):
          if toc_item.flags != 0:
              return

          self.stream.seek(toc_item.offset)
          data = self.stream.read(toc_item.size)

          if path := self.get_safe_path(output_dir, toc_item.name.decode('utf-8')):
              with open(path, 'wb') as img:
                  img.write(data)
  ```
