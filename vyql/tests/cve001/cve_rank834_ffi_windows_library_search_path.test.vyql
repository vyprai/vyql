test "rank834: Ruby FFI searches POSIX library dirs on native Windows"
  lang ruby
  expect VYQL-PATH-044
  expect_review code.RubyFfiWindowsPosixLibrarySearchPath
  code
  ```
  module FFI
    module Platform
      def self.windows?; false; end
    end

    module Library
      def ffi_lib(*names)
        names.each do |libname|
          begin
            FFI::DynamicLibrary.open(libname, lib_flags)
          rescue Exception => ex
            unless libname.start_with?("/")
              path = ['/usr/lib/','/usr/local/lib/'].find do |pth|
                File.exist?(pth + libname)
              end
              retry if path
            end
          end
        end
      end
    end
  end
  ```

test "rank834: Ruby FFI skips POSIX fallback on native Windows"
  lang ruby
  reject VYQL-PATH-044
  reject_review code.RubyFfiWindowsPosixLibrarySearchPath
  code
  ```
  module FFI
    module Platform
      def self.windows?; true; end
    end

    module Library
      def ffi_lib(*names)
        names.each do |libname|
          begin
            FFI::DynamicLibrary.open(libname, lib_flags)
          rescue Exception => ex
            unless libname.start_with?("/") || FFI::Platform.windows?
              path = ['/usr/lib/','/usr/local/lib/'].find do |pth|
                File.exist?(pth + libname)
              end
              retry if path
            end
          end
        end
      end
    end
  end
  ```
