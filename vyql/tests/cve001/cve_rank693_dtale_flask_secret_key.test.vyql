# Rank 693 / CVE-2024-3408: D-Tale used a fixed Flask SECRET_KEY, allowing
# forged signed session data in deployments that did not override it.

test "rank693: Flask app config uses a hardcoded SECRET_KEY literal"
  lang python
  file app.py
  expect VYQL-SEC-002
  code
  ```
  from flask import Flask

  class DtaleFlask(Flask):
      pass

  def build_app():
      app = DtaleFlask("dtale")
      app.config["SECRET_KEY"] = "Dtale"
      return app
  ```

test "rank693: Flask app config uses a generated SECRET_KEY"
  lang python
  file app.py
  reject VYQL-SEC-002
  code
  ```
  import numpy as np
  import string
  from flask import Flask

  class DtaleFlask(Flask):
      pass

  def build_secret_key():
      return "".join(np.random.choice(list(string.ascii_uppercase + string.digits), 10))

  def build_app():
      app = DtaleFlask("dtale")
      app.config["SECRET_KEY"] = build_secret_key()
      return app
  ```
