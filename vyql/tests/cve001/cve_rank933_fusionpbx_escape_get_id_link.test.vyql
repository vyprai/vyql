# Rank 933 / CVE-2019-16968: FusionPBX rendered the request id directly
# into conference control add-link hrefs before the patch wrapped it with
# escape().

test "rank933: FusionPBX renders raw GET id into add-link href"
  lang php
  file conference_control_details.php
  expect VYQL-INJ-004
  code
  ```
  <?php
  if (permission_exists('conference_control_detail_add')) {
      echo "<a href='conference_control_detail_edit.php?conference_control_uuid=".$_GET['id']."' alt='".$text['button-add']."'>$v_link_label_add</a>";
  }
  ?>
  ```

test "rank933: FusionPBX escapes GET id before add-link href"
  lang php
  file conference_control_details.php
  reject VYQL-INJ-004
  code
  ```
  <?php
  if (permission_exists('conference_control_detail_add')) {
      echo "<a href='conference_control_detail_edit.php?conference_control_uuid=".escape($_GET['id'])."' alt='".$text['button-add']."'>$v_link_label_add</a>";
  }
  ?>
  ```
