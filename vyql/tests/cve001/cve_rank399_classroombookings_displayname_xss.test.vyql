# Rank 399 / CVE-2026-6486: classroombookings rendered a stored
# user display name into a CodeIgniter img() alt attribute string. The
# fix switches to the array form and escapes/strips the label.

test "rank399: classroombookings global menu label reaches img alt attribute string"
  lang php
  expect VYQL-INJ-069
  expect_review code.ClassroomBookingsDisplayNameAltXss
  code
  ```
  <?php
  $global_menu = $this->menu_model->global();
  if ( ! empty($global_menu)) {
      echo "<p class='iconbar'>";
      foreach ($global_menu as $idx => $item) {
          $icon = img(asset_url('assets/images/ui/' . $item['icon']), FALSE, "align='top' alt='{$item['label']}'");
          $label = $icon . html_escape($item['label']);
          echo anchor($item['url'], $label);
      }
      echo "</p>";
  }
  ```

test "rank399: classroombookings escapes global menu label before img alt"
  lang php
  reject VYQL-INJ-069
  reject_review code.ClassroomBookingsDisplayNameAltXss
  code
  ```
  <?php
  $global_menu = $this->menu_model->global();
  if ( ! empty($global_menu)) {
      echo "<p class='iconbar'>";
      foreach ($global_menu as $idx => $item) {
          $icon = img([
              'src' => asset_url('assets/images/ui/' . $item['icon']),
              'align' => 'top',
              'alt' => html_escape(strip_tags( (string) $item['label'] )),
          ]);
          $label = $icon . html_escape($item['label']);
          echo anchor($item['url'], $label);
      }
      echo "</p>";
  }
  ```
