test "rank886: Fluentd Apache2 parser accepts escape-any quoted fields"
  lang ruby
  profile library
  expect VYQL-DOS-003
  expect_review code.CatastrophicRegex
  code
  ```
  module Fluent
    module Plugin
      class Apache2Parser < Parser
        REGEXP = /^(?<host>[^ ]*) [^ ]* (?<user>[^ ]*) \[(?<time>[^\]]*)\] "(?<method>\S+)(?: +(?<path>(?:[^\"]|\\.)*?)(?: +\S*)?)?" (?<code>[^ ]*) (?<size>[^ ]*)(?: "(?<referer>(?:[^\"]|\\.)*)" "(?<agent>(?:[^\"]|\\.)*)")?$/

        def parse(text)
          m = REGEXP.match(text)
          yield m["time"], {"path" => m["path"]}
        end
      end
    end
  end
  ```

test "rank886: Fluentd Apache2 parser only treats escaped quotes as quoted-field escapes"
  lang ruby
  profile library
  reject VYQL-DOS-003
  reject_review code.CatastrophicRegex
  code
  ```
  module Fluent
    module Plugin
      class Apache2Parser < Parser
        REGEXP = /^(?<host>[^ ]*) [^ ]* (?<user>[^ ]*) \[(?<time>[^\]]*)\] "(?<method>\S+)(?: +(?<path>(?:[^\"]|\\")*?)(?: +\S*)?)?" (?<code>[^ ]*) (?<size>[^ ]*)(?: "(?<referer>(?:[^\"]|\\")*)" "(?<agent>(?:[^\"]|\\")*)")?$/

        def parse(text)
          m = REGEXP.match(text)
          yield m["time"], {"path" => m["path"]}
        end
      end
    end
  end
  ```
