# Rank 481 / CVE-2017-16558: Contao's listing module accepted
# request-selected search, order_by, and sort identifiers in front-end SQL
# construction. The fix validates search and order fields against configured
# field allowlists and restricts sort direction.

test "rank481: Contao listing module uses request SQL identifiers"
  lang php
  file ModuleListing.php
  expect VYQL-INJ-103
  expect_review code.ContaoListingModuleSqlIdentifierInjection
  code
  ```
  <?php
  namespace Contao;

  class ModuleListing
  {
      protected function compile()
      {
          $strWhere = '';
          $varKeyword = '';
          $arrSearchFields = \StringUtil::trimsplit(',', $this->list_search);

          if (!empty($arrSearchFields) && is_array($arrSearchFields)) {
              if (\Input::get('search') && \Input::get('for')) {
                  $varKeyword = '%' . \Input::get('for') . '%';
                  $strWhere = (!$this->list_where ? " WHERE " : " AND ") . \Input::get('search') . " LIKE ?";
              }
          }

          $strQuery = "SELECT " . $this->strPk . "," . $this->list_fields;
          $strQuery .= " FROM " . $this->list_table . " t1";
          $strQuery .= $strWhere;

          if (\Input::get('order_by')) {
              $strQuery .= " ORDER BY " . \Input::get('order_by') . ' ' . \Input::get('sort');
          }

          $objDataStmt = $this->Database->prepare($strQuery);
          $objData = $objDataStmt->execute($varKeyword);
      }
  }
  ```

test "rank481: Contao listing module allowlists SQL identifiers"
  lang php
  file ModuleListing.php
  reject VYQL-INJ-103
  reject_review code.ContaoListingModuleSqlIdentifierInjection
  code
  ```
  <?php
  namespace Contao;

  class ModuleListing
  {
      protected function compile()
      {
          $strWhere = '';
          $varKeyword = '';
          $strSearch = \Input::get('search');
          $strFor = \Input::get('for');
          $arrFields = \StringUtil::trimsplit(',', $this->list_fields);
          $arrSearchFields = \StringUtil::trimsplit(',', $this->list_search);

          if (!empty($arrSearchFields) && is_array($arrSearchFields)) {
              if ($strSearch && !in_array($strSearch, $arrSearchFields, true)) {
                  $strSearch = '';
                  $strFor = '';
              }

              if ($strSearch && $strFor) {
                  $varKeyword = '%' . $strFor . '%';
                  $strWhere = (!$this->list_where ? " WHERE " : " AND ") . $strSearch . " LIKE ?";
              }
          }

          $strQuery = "SELECT " . $this->strPk . "," . $this->list_fields;
          $strQuery .= " FROM " . $this->list_table . " t1";
          $strQuery .= $strWhere;

          $order_by = \Input::get('order_by');

          if ($order_by && !in_array($order_by, $arrFields, true)) {
              $order_by = '';
          }

          $sort = \Input::get('sort');

          if ($sort && !in_array($sort, array('asc', 'desc'))) {
              $sort = '';
          }

          if ($order_by) {
              $strQuery .= " ORDER BY " . $order_by . ' ' . $sort;
          }

          $objDataStmt = $this->Database->prepare($strQuery);
          $objData = $objDataStmt->execute($varKeyword);
      }
  }
  ```
