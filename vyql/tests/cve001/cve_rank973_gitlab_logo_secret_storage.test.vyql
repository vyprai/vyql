# Rank 973 / CVE-2019-10429: Jenkins GitLab Logo Plugin stored its private
# token as a plain String instead of hudson.util.Secret.

test "rank973: Jenkins descriptor stores private token string from form data"
  lang java
  profile api
  file src/main/java/org/jenkinsci/plugins/gitlablogo/GitlabLogoProperty.java
  expect VYQL-SEC-015
  expect_review code.JenkinsPlaintextDataboundCredential
  code
  ```
  import hudson.model.JobPropertyDescriptor;
  import net.sf.json.JSONObject;
  import org.kohsuke.stapler.StaplerRequest;

  public class GitlabLogoProperty {
      public static final class DescriptorImpl extends JobPropertyDescriptor {
          private String privateToken;
          private String endpointUrl;

          @Override
          public boolean configure(StaplerRequest req, JSONObject formData) throws FormException {
              privateToken = formData.getString("privateToken");
              endpointUrl = formData.getString("endpointUrl");
              save();
              return super.configure(req, formData);
          }
      }
  }
  ```

test "rank973: Jenkins descriptor converts private token to Secret"
  lang java
  profile api
  file src/main/java/org/jenkinsci/plugins/gitlablogo/GitlabLogoProperty.java
  reject VYQL-SEC-015
  reject_review code.JenkinsPlaintextDataboundCredential
  code
  ```
  import hudson.model.JobPropertyDescriptor;
  import hudson.util.Secret;
  import net.sf.json.JSONObject;
  import org.kohsuke.stapler.StaplerRequest;

  public class GitlabLogoProperty {
      public static final class DescriptorImpl extends JobPropertyDescriptor {
          private Secret privateToken;
          private String endpointUrl;

          @Override
          public boolean configure(StaplerRequest req, JSONObject formData) throws FormException {
              privateToken = Secret.fromString(formData.getString("privateToken"));
              endpointUrl = formData.getString("endpointUrl");
              save();
              return super.configure(req, formData);
          }
      }
  }
  ```
