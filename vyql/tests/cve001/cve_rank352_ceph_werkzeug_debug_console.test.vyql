test "rank352: ceph-iscsi Flask debug console is exposed on all interfaces"
  lang python
  expect VYQL-INJ-057
  expect_review code.WerkzeugDebugConsoleExposure
  code
  ```
  from flask import Flask

  app = Flask("rbd-target-api")
  def main():
      app.run(host='0.0.0.0',
              port=settings.config.api_port,
              debug=True,
              threaded=True,
              use_reloader=False)
  ```

test "rank352: ceph-iscsi disables Werkzeug eval console"
  lang python
  reject VYQL-INJ-057
  reject_review code.WerkzeugDebugConsoleExposure
  code
  ```
  from flask import Flask

  app = Flask("rbd-target-api")
  def main():
      app.run(host='0.0.0.0',
              port=settings.config.api_port,
              debug=settings.config.debug,
              use_evalex=False,
              threaded=True,
              use_reloader=False)
  ```

test "rank352: local-only Flask debug server is not the ceph remote console exposure"
  lang python
  reject VYQL-INJ-057
  reject_review code.WerkzeugDebugConsoleExposure
  code
  ```
  from flask import Flask

  app = Flask(__name__)
  def main():
      app.run(host='127.0.0.1',
              debug=True)
  ```
