# Rank 441 / CVE-2017-11366: Codiad Filemanager command injection in
# search/find shell command arguments.

test "rank441: Codiad Filemanager stores raw search parameters before shell execution"
  lang php
  file class.filemanager.php
  expect VYQL-INJ-087
  expect_review code.CodiadFilemanagerSearchCommandInjection
  code
  ```
  <?php

  class Filemanager
  {
    public $search_string = "";
    public $search_file_type = "";
    public $query = "";

    public function __construct($get, $post, $files)
    {
      if (!empty($get['query'])) {
        $this->query = $get['query'];
      }
      if (!empty($post['search_string'])) {
        $this->search_string = $post['search_string'];
      }
      if (!empty($post['search_file_type'])) {
        $this->search_file_type = $post['search_file_type'];
      }
    }

    public function find()
    {
      $input = str_replace('"', '', $this->query);
      $cmd = 'find -L -iname "' . $input . '*"';
      return shell_exec($cmd);
    }

    public function search()
    {
      $input = preg_quote($this->search_string);
      return shell_exec('find -L ' . $this->path . ' -iregex  ".*' . $this->search_file_type . '" -type f | xargs grep -i -I -n -R -H "' . $input . '"');
    }
  }
  ```

test "rank441: Codiad Filemanager escapes search parameters before shell execution"
  lang php
  file class.filemanager.php
  reject VYQL-INJ-087
  reject_review code.CodiadFilemanagerSearchCommandInjection
  code
  ```
  <?php

  class Filemanager
  {
    public $search_string = "";
    public $search_file_type = "";
    public $query = "";

    public function __construct($get, $post, $files)
    {
      if (!empty($get['query'])) {
        $this->query = escapeshellarg($get['query']);
      }
      if (!empty($post['search_string'])) {
        $this->search_string = escapeshellarg($post['search_string']);
      }
      if (!empty($post['search_file_type'])) {
        $this->search_file_type = escapeshellarg($post['search_file_type']);
      }
    }

    public function find()
    {
      $input = str_replace('"', '', $this->query);
      $cmd = 'find -L -iname "' . $input . '*"';
      return shell_exec($cmd);
    }

    public function search()
    {
      $input = preg_quote($this->search_string);
      return shell_exec('find -L ' . $this->path . ' -iregex  ".*' . $this->search_file_type . '" -type f | xargs grep -i -I -n -R -H "' . $input . '"');
    }
  }
  ```
