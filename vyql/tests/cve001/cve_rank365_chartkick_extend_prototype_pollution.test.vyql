# Rank 365 / CVE-2019-18841: Chartkick.js 3.1.x recursively extended chart
# data/options without skipping prototype-mutating keys.

test "rank365: Chartkick recursive extend copies source keys without proto guard"
  lang javascript
  expect VYQL-INJ-062
  expect_review code.ChartkickRecursiveExtendPrototypePollution
  code
  ```
  function isArray(variable) {
    return Object.prototype.toString.call(variable) === "[object Array]";
  }

  function isPlainObject(variable) {
    return Object.prototype.toString.call(variable) === "[object Object]";
  }

  function extend(target, source) {
    var key;
    for (key in source) {
      if (isPlainObject(source[key]) || isArray(source[key])) {
        if (isPlainObject(source[key]) && !isPlainObject(target[key])) {
          target[key] = {};
        }
        if (isArray(source[key]) && !isArray(target[key])) {
          target[key] = [];
        }
        extend(target[key], source[key]);
      } else if (source[key] !== undefined) {
        target[key] = source[key];
      }
    }
  }
  ```

test "rank365: Chartkick recursive extend skips __proto__ keys"
  lang javascript
  reject VYQL-INJ-062
  reject_review code.ChartkickRecursiveExtendPrototypePollution
  code
  ```
  function isArray(variable) {
    return Object.prototype.toString.call(variable) === "[object Array]";
  }

  function isFunction(variable) {
    return variable instanceof Function;
  }

  function isPlainObject(variable) {
    return Object.prototype.toString.call(variable) === "[object Object]" && !isFunction(variable) && variable instanceof Object;
  }

  function extend(target, source) {
    var key;
    for (key in source) {
      if (key === "__proto__") { continue; }

      if (isPlainObject(source[key]) || isArray(source[key])) {
        if (isPlainObject(source[key]) && !isPlainObject(target[key])) {
          target[key] = {};
        }
        if (isArray(source[key]) && !isArray(target[key])) {
          target[key] = [];
        }
        extend(target[key], source[key]);
      } else if (source[key] !== undefined) {
        target[key] = source[key];
      }
    }
  }
  ```
