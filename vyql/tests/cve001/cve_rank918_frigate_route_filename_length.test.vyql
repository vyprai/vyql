# Rank 918 / CVE-2024-32874: Frigate routed media filenames were sanitized
# but not length-bounded before cache filesystem access.

test "rank918: route-derived cache filename lacks length cap"
  lang python
  file media.py
  expect VYQL-RES-006
  expect_review code.UnboundedRouteFilenameCacheAccess
  code
  ```
  from flask import jsonify, make_response
  from werkzeug.utils import secure_filename

  @MediaBp.route("/<camera_name>/start/<int:start_ts>/end/<int:end_ts>/clip.mp4")
  def recording_clip(camera_name, start_ts, end_ts):
      file_name = secure_filename(f"clip_{camera_name}_{start_ts}-{end_ts}.mp4")
      path = os.path.join(CACHE_DIR, file_name)
      if not os.path.exists(path):
          return make_response(jsonify({"success": False}), 404)
      return path

  @MediaBp.route("/preview/<file_name>/thumbnail.webp")
  def preview_thumbnail(file_name):
      safe_file_name_current = secure_filename(file_name)
      preview_dir = os.path.join(CACHE_DIR, "preview_frames")
      path = os.path.join(preview_dir, safe_file_name_current)
      return path
  ```

test "rank918: route-derived cache filename is length bounded"
  lang python
  file media.py
  reject VYQL-RES-006
  reject_review code.UnboundedRouteFilenameCacheAccess
  code
  ```
  from flask import jsonify, make_response
  from werkzeug.utils import secure_filename

  @MediaBp.route("/<camera_name>/start/<int:start_ts>/end/<int:end_ts>/clip.mp4")
  def recording_clip(camera_name, start_ts, end_ts):
      file_name = f"clip_{camera_name}_{start_ts}-{end_ts}.mp4"
      if len(file_name) > 1000:
          return make_response(jsonify({"success": False}), 403)
      file_name = secure_filename(file_name)
      path = os.path.join(CACHE_DIR, file_name)
      if not os.path.exists(path):
          return make_response(jsonify({"success": False}), 404)
      return path

  @MediaBp.route("/preview/<file_name>/thumbnail.webp")
  def preview_thumbnail(file_name):
      if len(file_name) > 1000:
          return make_response(jsonify({"success": False}), 403)
      safe_file_name_current = secure_filename(file_name)
      preview_dir = os.path.join(CACHE_DIR, "preview_frames")
      path = os.path.join(preview_dir, safe_file_name_current)
      return path
  ```
