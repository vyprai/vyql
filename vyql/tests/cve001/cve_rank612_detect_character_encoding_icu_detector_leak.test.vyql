test "rank612 detect-character-encoding: ICU detector leaks on failure returns"
  lang cpp
  expect VYQL-RES-001
  code
  ```
  #include <unicode/ucsdet.h>

  void DetectCharacterEncoding() {
    UErrorCode errorCode = U_ZERO_ERROR;
    UCharsetDetector *charsetDetector = ucsdet_open(&errorCode);
    if (U_FAILURE(errorCode)) {
      return;
    }
    ucsdet_setText(charsetDetector, data, len, &errorCode);
    if (U_FAILURE(errorCode)) {
      return;
    }
    const UCharsetMatch *charsetMatch = ucsdet_detect(charsetDetector, &errorCode);
    if (U_FAILURE(errorCode)) {
      return;
    }
  }
  ```

test "rank612 detect-character-encoding: ICU detector closes on every path"
  lang cpp
  reject VYQL-RES-001
  code
  ```
  #include <unicode/ucsdet.h>

  void DetectCharacterEncoding() {
    UErrorCode errorCode = U_ZERO_ERROR;
    UCharsetDetector *charsetDetector = ucsdet_open(&errorCode);
    if (U_FAILURE(errorCode)) {
      return;
    }
    ucsdet_setText(charsetDetector, data, len, &errorCode);
    if (U_FAILURE(errorCode)) {
      ucsdet_close(charsetDetector);
      return;
    }
    const UCharsetMatch *charsetMatch = ucsdet_detect(charsetDetector, &errorCode);
    if (U_FAILURE(errorCode)) {
      ucsdet_close(charsetDetector);
      return;
    }
    ucsdet_close(charsetDetector);
  }
  ```
