# Rank 275 / CVE-2026-44318: free5GC BSF read Subscriptions under the
# GetSubscription lock path, then directly wrote BsfSelf.Subscriptions[subId] for
# missing IDs without taking the update mutex. Concurrent PUTs can crash Go with
# concurrent map read/write.

test "rank275: bsf PUT missing subId writes shared subscription map directly"
  lang go
  expect VYQL-RACE-002
  expect_review code.LocklessSharedMutation
  code
  ```
  package processor

  func ReplaceIndividualSubcription(c *gin.Context) {
      subId := c.Param("subId")
      _, exists := bsfContext.BsfSelf.GetSubscription(subId)
      subscription := &bsfContext.BsfSubscription{}

      if exists {
          bsfContext.BsfSelf.UpdateSubscription(subId, subscription)
          c.JSON(http.StatusOK, subscription)
      } else {
          subscription.SubId = subId
          bsfContext.BsfSelf.Subscriptions[subId] = subscription
          c.Status(http.StatusNoContent)
      }
  }
  ```

test "rank275: bsf PUT missing subId returns not found instead of map write"
  lang go
  reject VYQL-RACE-002
  reject_review code.LocklessSharedMutation
  code
  ```
  package processor

  func ReplaceIndividualSubcription(c *gin.Context) {
      subId := c.Param("subId")
      _, exists := bsfContext.BsfSelf.GetSubscription(subId)
      subscription := &bsfContext.BsfSubscription{}

      if !exists {
          problemDetail := models.ProblemDetails{
              Status: http.StatusNotFound,
              Cause:  "RESOURCE_NOT_FOUND",
          }
          c.JSON(http.StatusNotFound, problemDetail)
          return
      }

      bsfContext.BsfSelf.UpdateSubscription(subId, subscription)
      c.JSON(http.StatusOK, subscription)
  }
  ```
