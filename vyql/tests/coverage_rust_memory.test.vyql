# Rust unsafe-memory parity where the frontend can expose honest review points.
# Rust RAII resources are intentionally not modeled as leaks; this file covers
# index and raw-pointer shapes that can participate in existing memory rules.

test "rust memory: routed index controls vector access"
  lang rust
  expect VYQL-MEM-005
  code
  ```
  #[get("/")]
  fn handler(i: usize, data: Vec<u8>) {
      let _x = data[i];
  }
  ```

test "rust memory: constant vector index is clean"
  lang rust
  reject VYQL-MEM-005
  code
  ```
  fn f(data: Vec<u8>) {
      let _x = data[0];
  }
  ```

test "rust memory: raw pointer dereference is nullable-deref review point"
  lang rust
  expect VYQL-MEM-006
  code
  ```
  fn f(p: *const i32) {
      unsafe {
          let _x = *p;
      }
  }
  ```

test "rust memory: plain value read is not a dereference smell"
  lang rust
  reject VYQL-MEM-006
  code
  ```
  fn f(x: i32) {
      let _y = x;
  }
  ```

test "rust memory: unsafe mutable alias cast is review finding"
  lang rust
  expect VYQL-MEM-009
  code
  ```
  fn f(buf: bytes::BytesMut) {
      let _alias: &mut [u8] = unsafe { &mut *(buf.as_ref() as *const _ as *mut _) };
  }
  ```

test "rust memory: raw pointer cast without mutable reference is clean"
  lang rust
  reject VYQL-MEM-009
  code
  ```
  fn f(ptr: *const u8) {
      let _p = ptr as *mut u8;
  }
  ```

test "rust memory: mutable buffer pointer cast is not immutable alias"
  lang rust
  reject VYQL-MEM-009
  code
  ```
  fn f(buffer: bytes::BytesMut) {
      unsafe {
          let _buf = &mut *(buffer.bytes_mut() as *mut [u8]);
      }
  }
  ```

test "rust memory: C repr enum crossing FFI is a layout review point"
  lang rust
  expect VYQL-MEM-014
  expect_review code.FfiEnumLayoutRisk
  code
  ```
  #[repr(C)]
  #[derive(Clone, Copy, Debug, PartialEq)]
  pub enum DType {
      F32 = 0,
      F64 = 1,
  }

  extern "C" {
      fn af_create_array(out: *mut i64, dtype: DType) -> i32;
  }
  ```

test "rust memory: read_exact into Vec capacity before set_len exposes uninitialized buffer"
  lang rust
  expect VYQL-MEM-015
  expect_review code.UninitializedBufferExposure
  code
  ```
  use std::{io, slice};

  pub fn read_spv<R: io::Read + io::Seek>(x: &mut R) -> io::Result<Vec<u32>> {
      let words = 8usize;
      let mut result = Vec::<u32>::with_capacity(words);
      unsafe {
          x.read_exact(slice::from_raw_parts_mut(
              result.as_mut_ptr() as *mut u8,
              words * 4,
          ))?;
          result.set_len(words);
      }
      Ok(result)
  }
  ```

test "rust memory: read_exact into zeroed Vec buffer is clean"
  lang rust
  reject VYQL-MEM-015
  code
  ```
  use std::{io, slice};

  pub fn read_spv<R: io::Read + io::Seek>(x: &mut R) -> io::Result<Vec<u32>> {
      let words = 8usize;
      let mut result = vec![0u32; words];
      x.read_exact(unsafe {
          slice::from_raw_parts_mut(result.as_mut_ptr() as *mut u8, words * 4)
      })?;
      Ok(result)
  }
  ```

test "rust memory: explicit integer repr enum is clean for FFI layout"
  lang rust
  reject VYQL-MEM-014
  reject_review code.FfiEnumLayoutRisk
  code
  ```
  #[repr(u32)]
  #[derive(Clone, Copy, Debug, PartialEq)]
  pub enum DType {
      F32 = 0,
      F64 = 1,
  }

  extern "C" {
      fn af_create_array(out: *mut i64, dtype: DType) -> i32;
  }
  ```
