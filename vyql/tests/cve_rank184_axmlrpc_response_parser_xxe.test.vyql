# Rank 184 / CVE-2020-36641: aXMLRPC parsed XML-RPC server responses with a
# raw DocumentBuilderFactory before disabling external entity processing.

test "rank184: aXMLRPC response parser uses raw DocumentBuilderFactory"
  lang java
  file src/main/java/de/timroes/axmlrpc/ResponseParser.java
  expect VYQL-DESER-004
  code
  ```
  import java.io.InputStream;
  import javax.xml.parsers.DocumentBuilder;
  import javax.xml.parsers.DocumentBuilderFactory;
  import org.w3c.dom.Document;

  class ResponseParser {
    public Object parse(SerializerHandler serializerHandler, InputStream response, boolean debugMode) throws Exception {
      DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
      factory.setNamespaceAware(true);
      DocumentBuilder builder = factory.newDocumentBuilder();
      Document dom = builder.parse(response);
      return dom.getDocumentElement();
    }
  }
  ```

test "rank184: aXMLRPC response parser disables external entity processing"
  lang java
  file src/main/java/de/timroes/axmlrpc/ResponseParser.java
  reject VYQL-DESER-004
  code
  ```
  import java.io.InputStream;
  import javax.xml.parsers.DocumentBuilder;
  import javax.xml.parsers.DocumentBuilderFactory;
  import org.w3c.dom.Document;

  class ResponseParser {
    public Object parse(SerializerHandler serializerHandler, InputStream response, boolean debugMode) throws Exception {
      DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
      factory.setNamespaceAware(true);
      factory.setFeature("http://apache.org/xml/features/disallow-doctype-decl", true);
      factory.setFeature("http://xml.org/sax/features/external-general-entities", false);
      factory.setFeature("http://xml.org/sax/features/external-parameter-entities", false);
      factory.setXIncludeAware(false);
      factory.setExpandEntityReferences(false);
      DocumentBuilder builder = factory.newDocumentBuilder();
      Document dom = builder.parse(response);
      return dom.getDocumentElement();
    }
  }
  ```
