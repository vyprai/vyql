# Rank 434 / CVE-2015-3907: CodeIgniter Rest Server parsed XML request
# bodies before disabling libxml external entity loading.

test "rank434: CodeIgniter Rest Server XML body parsing lacks entity loader hardening"
  lang php
  file REST_Controller.php
  expect VYQL-DESER-014
  expect_review code.CodeIgniterRestserverXmlEntityLoaderXxe
  code
  ```
  <?php
  abstract class REST_Controller extends CI_Controller
  {
      protected $_supported_formats = [
          'xml' => 'application/xml',
          'json' => 'application/json'
      ];

      public function __construct($config = 'rest')
      {
          parent::__construct();
          $this->load->library('format');
          $this->request = new stdClass();
          $this->request->format = $this->_detect_input_format();
          $this->request->body = null;
          $this->{'_parse_' . $this->request->method}();
          if ($this->request->format && $this->request->body) {
              $this->request->body = $this->format->factory($this->request->body, $this->request->format)->to_array();
          }
      }
  }
  ```

test "rank434: CodeIgniter Rest Server disables XML entity loading before parsing body"
  lang php
  file REST_Controller.php
  reject VYQL-DESER-014
  reject_review code.CodeIgniterRestserverXmlEntityLoaderXxe
  code
  ```
  <?php
  abstract class REST_Controller extends CI_Controller
  {
      protected $_supported_formats = [
          'xml' => 'application/xml',
          'json' => 'application/json'
      ];

      public function __construct($config = 'rest')
      {
          parent::__construct();
          libxml_disable_entity_loader(true);
          $this->load->library('format');
          $this->request = new stdClass();
          $this->request->format = $this->_detect_input_format();
          $this->request->body = null;
          $this->{'_parse_' . $this->request->method}();
          if ($this->request->format && $this->request->body) {
              $this->request->body = $this->format->factory($this->request->body, $this->request->format)->to_array();
          }
      }
  }
  ```
