# --- Insecure direct object reference (VYQL-AUTH-002) ---
test "p0 javascript: request id lookup is IDOR"
  lang javascript
  expect VYQL-AUTH-002
  code
  ```
  function handler(req) {
    return User.findById(req.params.id);
  }
  ```

test "p0 javascript: ownership guard suppresses IDOR"
  lang javascript
  reject VYQL-AUTH-002
  code
  ```
  function handler(req) {
    checkOwnership(req.user, req.params.id);
    return User.findById(req.params.id);
  }
  ```

test "p0 python: request id lookup is IDOR"
  lang python
  expect VYQL-AUTH-002
  code
  ```
  def handler(request):
      return get_user(request.args["id"])
  ```

test "p0 python: ownership guard suppresses IDOR"
  lang python
  reject VYQL-AUTH-002
  code
  ```
  def handler(request):
      check_ownership(request.user, request.args["id"])
      return get_user(request.args["id"])
  ```

test "p0 php: request id lookup is IDOR"
  lang php
  expect VYQL-AUTH-002
  code
  ```
  <?php
  function handler($repo) {
      return $repo->find($_GET["id"]);
  }
  ?>
  ```

test "p0 php: ownership guard suppresses IDOR"
  lang php
  reject VYQL-AUTH-002
  code
  ```
  <?php
  function handler($repo) {
      checkOwnership($_SESSION["user"], $_GET["id"]);
      return $repo->find($_GET["id"]);
  }
  ?>
  ```

test "p0 ruby: request id lookup is IDOR"
  lang ruby
  expect VYQL-AUTH-002
