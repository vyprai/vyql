# P0 parity: exploit-class coverage with paired positive and negative fixtures.
#
# These tests lock the current high-priority parity surface to executable specs:
# missing authentication, IDOR, archive extraction traversal, and static IV/nonce.

# --- Missing authentication (VYQL-AUTH-001) ---
test "p0 javascript: sensitive operation without auth is reported"
  lang javascript
  expect VYQL-AUTH-001
  code
  ```
  function handler(req) {
    changePassword(req.body.password);
  }
  ```

test "p0 javascript: auth guard suppresses sensitive operation"
  lang javascript
  reject VYQL-AUTH-001
  code
  ```
  function handler(req) {
    requireAuth(req);
    changePassword(req.body.password);
  }
  ```

test "p0 python: sensitive operation without auth is reported"
  lang python
  expect VYQL-AUTH-001
  code
  ```
  def handler(request):
      change_password(request.form["password"])
  ```

test "p0 python: auth guard suppresses sensitive operation"
  lang python
  reject VYQL-AUTH-001
  code
  ```
  def handler(request):
      require_auth(request)
      change_password(request.form["password"])
  ```

test "p0 php: sensitive operation without auth is reported"
