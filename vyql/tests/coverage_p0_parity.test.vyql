# --- Archive extraction traversal (VYQL-PATH-004) ---
test "p0 javascript: tainted archive entry extraction is traversal"
  lang javascript
  expect VYQL-PATH-004
  code
  ```
  function extract(req, zip) {
    zip.extractEntryTo(req.params.name);
  }
  ```

test "p0 javascript: basename archive entry is clean"
  lang javascript
  reject VYQL-PATH-004
  code
  ```
  function extract(req, zip) {
    const name = path.basename(req.params.name);
    zip.extractEntryTo(name);
  }
  ```

test "p0 python: tainted archive entry extraction is traversal"
  lang python
  expect VYQL-PATH-004
  code
  ```
  def handler(request, archive):
      archive.extract(request.args["name"])
  ```

test "p0 python: basename archive entry is clean"
  lang python
  reject VYQL-PATH-004
  code
  ```
  import os
  def handler(request, archive):
      name = os.path.basename(request.args["name"])
      archive.extract(name)
  ```

test "p0 php: tainted archive entry extraction is traversal"
  lang php
  expect VYQL-PATH-004
  code
  ```
  <?php
  function handler($zip) {
      $zip->extractTo("/tmp/out", $_GET["name"]);
  }
  ?>
  ```

test "p0 php: basename archive entry is clean"
  lang php
  reject VYQL-PATH-004
  code
  ```
  <?php
  function handler($zip) {
      $name = basename($_GET["name"]);
      $zip->extractTo("/tmp/out", $name);
  }
  ?>
  ```

test "p0 ruby: tainted archive entry extraction is traversal"
  lang ruby
  expect VYQL-PATH-004
  code
  ```
  def handler(zip)
    zip.extract(params[:name])
  end
  ```

test "p0 ruby: basename archive entry is clean"
  lang ruby
  reject VYQL-PATH-004
  code
  ```
  def handler(zip)
    name = File.basename(params[:name])
    zip.extract(name)
  end
  ```

test "p0 java: tainted archive entry extraction is traversal"
  lang java
  expect VYQL-PATH-004
  code
  ```
  class App {
    void handler(Request req, Extractor extractor) {
      extractor.extractEntry(req.getParameter("name"));
    }
  }
  ```

test "p0 java: constant archive entry is clean"
  lang java
  reject VYQL-PATH-004
  code
  ```
  class App {
    void handler(Extractor extractor) {
      extractor.extractEntry("safe.txt");
    }
  }
  ```

test "p0 go: tainted archive entry extraction is traversal"
  lang go
  expect VYQL-PATH-004
  code
  ```
  package p
  import "net/http"
  func handler(r *http.Request) {
    extractEntry(r.URL.Query().Get("name"))
  }
  ```

test "p0 go: basename archive entry is clean"
  lang go
  reject VYQL-PATH-004
  code
  ```
  package p
  import (
    "net/http"
    "path/filepath"
  )
  func handler(r *http.Request) {
    name := filepath.Base(r.URL.Query().Get("name"))
    extractEntry(name)
  }
  ```

test "p0 csharp: tainted archive entry extraction is traversal"
  lang csharp
  expect VYQL-PATH-004
  code
  ```
  class App {
    void Handler(dynamic entry) {
      entry.ExtractToFile(Request.Query["name"]);
    }
  }
  ```

test "p0 csharp: basename archive entry is clean"
  lang csharp
  reject VYQL-PATH-004
  code
  ```
  class App {
    void Handler(dynamic entry) {
      var name = Path.GetFileName(Request.Query["name"]);
      entry.ExtractToFile(name);
    }
  }
  ```

test "p0 swift: tainted archive entry extraction is traversal"
  lang swift
  expect VYQL-PATH-004
  code
  ```
  func handler(request: Request, archive: Archive) {
    archive.extractEntry(request.query["name"])
  }
  ```

test "p0 swift: safe archive entry is clean"
  lang swift
  reject VYQL-PATH-004
  code
  ```
  func handler(request: Request, archive: Archive) {
    let name = safePath(request.query["name"])
    archive.extractEntry(name)
  }
  ```

# --- Static IV / nonce (VYQL-CRY-004) ---
test "p0 javascript: static IV is reported"
  lang javascript
  expect VYQL-CRY-004
  code
  ```
  const crypto = require("crypto");
  function enc(key) {
    return crypto.createCipheriv("aes-128-cbc", key, "0000000000000000");
  }
  ```

test "p0 javascript: runtime IV is clean"
  lang javascript
  reject VYQL-CRY-004
  code
  ```
  const crypto = require("crypto");
  function enc(key, iv) {
    return crypto.createCipheriv("aes-128-cbc", key, iv);
  }
  ```

test "p0 python: static IV is reported"
  lang python
  expect VYQL-CRY-004
  code
  ```
  from Crypto.Cipher import AES
  def enc(key, data):
      return AES.new(key, AES.MODE_CBC, "0000000000000000")
  ```

test "p0 python: runtime IV is clean"
  lang python
  reject VYQL-CRY-004
  code
  ```
  from Crypto.Cipher import AES
  def enc(key, data, iv):
      return AES.new(key, AES.MODE_CBC, iv)
  ```

test "p0 php: static IV is reported"
  lang php
  expect VYQL-CRY-004
  code
  ```
  <?php
  function enc($key, $data) {
      return openssl_encrypt($data, "AES-128-CBC", $key, 0, "0000000000000000");
  }
  ?>
  ```

test "p0 php: runtime IV is clean"
  lang php
  reject VYQL-CRY-004
  code
  ```
  <?php
  function enc($key, $data, $iv) {
      return openssl_encrypt($data, "AES-128-CBC", $key, 0, $iv);
  }
  ?>
  ```

test "p0 ruby: static IV is reported"
  lang ruby
  expect VYQL-CRY-004
  code
  ```
  def enc
    cipher = OpenSSL::Cipher.new("aes-128-cbc")
    cipher.iv = "0000000000000000"
  end
  ```

test "p0 ruby: runtime IV is clean"
  lang ruby
  reject VYQL-CRY-004
  code
  ```
  def enc(iv)
    cipher = OpenSSL::Cipher.new("aes-128-cbc")
    cipher.iv = iv
  end
  ```

test "p0 java: static IV is reported"
  lang java
  expect VYQL-CRY-004
  code
  ```
  class App {
    void enc() {
      new IvParameterSpec("0000000000000000".getBytes());
    }
  }
  ```

test "p0 java: runtime IV is clean"
  lang java
  reject VYQL-CRY-004
  code
  ```
  class App {
    void enc(byte[] iv) {
      new IvParameterSpec(iv);
    }
  }
  ```

test "p0 kotlin: static IV is reported"
  lang kotlin
  expect VYQL-CRY-004
  code
  ```
  fun enc() {
      IvParameterSpec("0000000000000000".toByteArray())
  }
  ```

test "p0 kotlin: runtime IV is clean"
  lang kotlin
  reject VYQL-CRY-004
  code
  ```
  fun enc(iv: ByteArray) {
      IvParameterSpec(iv)
  }
  ```

test "p0 scala: static IV is reported"
  lang scala
  expect VYQL-CRY-004
  code
  ```
  def enc() = {
    new IvParameterSpec("0000000000000000".getBytes)
  }
  ```

test "p0 scala: runtime IV is clean"
  lang scala
  reject VYQL-CRY-004
  code
  ```
  def enc(iv: Array[Byte]) = {
    new IvParameterSpec(iv)
  }
  ```

test "p0 elixir: static IV is reported"
  lang elixir
  expect VYQL-CRY-004
  code
  ```
  def enc(key, data) do
    :crypto.crypto_one_time(:aes_128_cbc, key, "0000000000000000", data, true)
  end
  ```

test "p0 elixir: runtime IV is clean"
  lang elixir
  reject VYQL-CRY-004
  code
  ```
  def enc(key, iv, data) do
    :crypto.crypto_one_time(:aes_128_cbc, key, iv, data, true)
  end
  ```

test "p0 go: static IV is reported"
  lang go
  expect VYQL-CRY-004
  code
  ```
  package p
  import "crypto/cipher"
  func enc(block cipher.Block) {
    cipher.NewCBCEncrypter(block, []byte("0000000000000000"))
  }
  ```

test "p0 go: runtime IV is clean"
  lang go
  reject VYQL-CRY-004
  code
  ```
  package p
  import "crypto/cipher"
  func enc(block cipher.Block, iv []byte) {
    cipher.NewCBCEncrypter(block, iv)
  }
  ```

