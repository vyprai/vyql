  reject VYQL-CFG-005
  reject VYQL-CFG-006
  reject VYQL-CFG-007
  reject VYQL-CFG-008
  reject VYQL-PATH-003
  reject VYQL-RES-001
  code
  ```
  def handler
    Digest::SHA256.hexdigest(data)
    OpenSSL::Cipher.new("aes-256-gcm")
    cipher.iv = iv
    SecureRandom.random_bytes(16)
    JWT.decode(token, key, true, {algorithm: "RS256"})
    http.verify_mode = OpenSSL::SSL::VERIFY_PEER
    HTTParty.get("https://example.com")
    HTTParty.get("http://127.0.0.1:8080")
    set_cookie("sid", true)
    File.chmod(0600, "/tmp/x")
    Tempfile.create("safe")
    s = TCPSocket.open("example.com", 443)
    s.close
  end
  ```
