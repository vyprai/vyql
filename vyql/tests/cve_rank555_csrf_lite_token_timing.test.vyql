# Rank 555 / CVE-2016-10535: csrf-lite compared submitted CSRF tokens with
# ordinary string equality instead of a constant-time comparison.

test "rank555: csrf token ordinary equality leaks timing"
  lang javascript
  expect VYQL-CRY-006
  expect_review code.SecretComparisonReview
  code
  ```
  var crypto = require('crypto')

  function csrf(token) {
    if (token && typeof token === 'string')
      return token

    return crypto.randomBytes(24).toString('base64')
  }

  csrf.valid = csrf.validate = function (data, token) {
    if (!token || typeof token !== 'string')
      return false

    var valid = data['x-csrf-token'] === token
    delete data['x-csrf-token']
    return valid
  }
  ```

test "rank555: csrf token constant-time comparison is clean"
  lang javascript
  reject VYQL-CRY-006
  reject_review code.SecretComparisonReview
  code
  ```
  var crypto = require('crypto')
  var scmp = require('scmp')

  function csrf(token) {
    if (token && typeof token === 'string')
      return token

    return crypto.randomBytes(24).toString('base64')
  }

  csrf.valid = csrf.validate = function (data, token) {
    if (!token || typeof token !== 'string')
      return false

    var valid = scmp(data['x-csrf-token'], token)
    delete data['x-csrf-token']
    return valid
  }
  ```
