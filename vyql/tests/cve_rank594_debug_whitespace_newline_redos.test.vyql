test "rank594: debug formatter trims inspected output with ambiguous whitespace regex"
  lang javascript
  expect VYQL-DOS-003
  expect_review code.CatastrophicRegex
  code
  ```
  const util = require('util');

  const formatters = {};
  formatters.o = function (v) {
    this.inspectOpts.colors = this.useColors;
    return util.inspect(v, this.inspectOpts)
      .replace(/\s*\n\s*/g, ' ');
  };
  ```

test "rank594: debug formatter splits lines before trimming whitespace"
  lang javascript
  reject VYQL-DOS-003
  reject_review code.CatastrophicRegex
  code
  ```
  const util = require('util');

  const formatters = {};
  formatters.o = function (v) {
    this.inspectOpts.colors = this.useColors;
    return util.inspect(v, this.inspectOpts)
      .split('\n')
      .map(str => str.trim())
      .join(' ');
  };
  ```
