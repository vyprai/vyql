test "rank242: Blinko upsertUser updates supplied account id without ownership check"
  lang javascript
  expect_review code.IdorPolicyReview
  code
  ```
  const upsertUser = authProcedure
    .use(demoAuthMiddleware)
    .mutation(async ({ input }) => {
      return prisma.$transaction(async () => {
        const { id, password, originalPassword } = input;
        const update: Prisma.accountsUpdateInput = {};

        if (id) {
          if (password) {
            const passwordHash = await hashPassword(password);
            update.password = passwordHash;
          }

          if (originalPassword) {
            const user = await prisma.accounts.findFirst({ where: { id } });
            if (user && !(await verifyPassword(originalPassword, user?.password ?? ""))) {
              throw new TRPCError({ code: "UNAUTHORIZED" });
            }
          }

          await prisma.accounts.update({ where: { id }, data: update });
          return true;
        }
      });
    });
  ```

test "rank242: Blinko upsertUser constrains updates to self or superadmin"
  lang javascript
  reject_review code.IdorPolicyReview
  code
  ```
  const upsertUser = authProcedure
    .use(demoAuthMiddleware)
    .mutation(async ({ input, ctx }) => {
      return prisma.$transaction(async () => {
        const { id, password, originalPassword } = input;
        const currentUserId = Number(ctx.id);
        const currentUser = await prisma.accounts.findFirst({ where: { id: currentUserId } });
        const update: Prisma.accountsUpdateInput = {};

        if (id) {
          const targetId = id;
          if (targetId !== currentUserId && currentUser.role !== "superadmin") {
            throw new TRPCError({ code: "FORBIDDEN" });
          }

          const targetUser = await prisma.accounts.findFirst({ where: { id: targetId } });
          if (password) {
            if (!originalPassword) {
              throw new TRPCError({ code: "BAD_REQUEST" });
            }
            if (!(await verifyPassword(originalPassword, targetUser.password ?? ""))) {
              throw new TRPCError({ code: "UNAUTHORIZED" });
            }
            const passwordHash = await hashPassword(password);
            update.password = passwordHash;
          }

          await prisma.accounts.update({ where: { id: targetId }, data: update });
          return true;
        }
      });
    });
  ```

test "rank242: Blinko admin-only upsert route is not the affected endpoint"
  lang javascript
  reject_review code.IdorPolicyReview
  code
  ```
  const upsertUserByAdmin = authProcedure
    .use(superAdminAuthMiddleware)
    .use(demoAuthMiddleware)
    .mutation(async ({ input }) => {
      return prisma.$transaction(async () => {
        const { id, nickname, name, password } = input;
        const update: Prisma.accountsUpdateInput = {};

        if (id) {
          if (name) update.name = name;
          if (password) {
            const passwordHash = await hashPassword(password);
            update.password = passwordHash;
          }
          if (nickname) update.nickname = nickname;
          await prisma.accounts.update({ where: { id }, data: update });
          return true;
        }
      });
    });
  ```
