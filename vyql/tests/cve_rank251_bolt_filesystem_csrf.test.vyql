# Rank 251 / CVE-2020-4040: Bolt file operations accepted POST/AJAX
# requests without a CSRF token. The fix adds token parameters in the UI and
# calls checkToken($request) before create/delete/rename/duplicate operations.

test "rank251: filesystem delete consumes request data without csrf token check"
  lang php
  expect VYQL-RF-003
  code
  ```
  <?php
  class FilesystemManager {
    public function deleteFile(Request $request) {
      $namespace = $_POST['namespace'];
      $filename = $_POST['filename'];
      $this->filesystem()->delete("$namespace://$filename");
    }
  }
  ```

test "rank251: filesystem delete is guarded by local csrf token helper"
  lang php
  reject VYQL-RF-003
  code
  ```
  <?php
  class FilesystemManager {
    public function deleteFile(Request $request) {
      $this->checkToken($request);
      $namespace = $_POST['namespace'];
      $filename = $_POST['filename'];
      $this->filesystem()->delete("$namespace://$filename");
    }

    private function checkToken(Request $request) {
      $token = new CsrfToken('bolt', $request->request->get('token'));
      if (! $this->app['csrf']->isTokenValid($token)) {
        $this->abort(Response::HTTP_UNAUTHORIZED, 'Token not valid');
      }
    }
  }
  ```
