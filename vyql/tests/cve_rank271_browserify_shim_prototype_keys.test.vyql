# Rank 271 / CVE-2022-37617: browserify-shim copied config object keys into
# plain objects without filtering prototype-mutating names.

test "rank271: browserify-shim unfiltered shim keys can pollute prototypes"
  lang javascript
  expect VYQL-INJ-048
  expect_review code.UncheckedPrototypeConfigKey
  code
  ```
  function separateExposeGlobals(shims) {
    var onlyShims = {}
      , exposeGlobals = {};

    Object.keys(shims).forEach(function (k) {
      var val = shims[k]
        , exp = val && val.exports;

      if (exp && /^global\:/.test(exp)) {
        exposeGlobals[k] = exp;
      } else {
        onlyShims[k] = val;
      }
    });

    return { shims: onlyShims, exposeGlobals: mapifyExposeGlobals(exposeGlobals) };
  }
  ```

test "rank271: browserify-shim filters prototype-mutating shim keys"
  lang javascript
  reject VYQL-INJ-048
  reject_review code.UncheckedPrototypeConfigKey
  code
  ```
  function separateExposeGlobals(shims) {
    var onlyShims = {}
      , exposeGlobals = {};

    Object.keys(shims).forEach(function (k) {
      if (k === '__proto__' || k === 'constructor') {
        return;
      }

      var val = shims[k]
        , exp = val && val.exports;

      if (exp && /^global\:/.test(exp)) {
        exposeGlobals[k] = exp;
      } else {
        onlyShims[k] = val;
      }
    });

    return { shims: onlyShims, exposeGlobals: mapifyExposeGlobals(exposeGlobals) };
  }
  ```
