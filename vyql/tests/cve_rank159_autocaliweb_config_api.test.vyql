# Rank 159 / CVE-2025-55165: autocaliweb's ConfigSQL.to_dict serialized
# public configuration fields, including API-related fields. The fix excludes
# API-named keys before returning the config dictionary.

test "rank159: python config dict serialization without API redaction requires review"
  lang python
  expect_review code.ConfigExposureReview
  code
  ```
  class ConfigSQL:
      def to_dict(self):
          storage = {}
          for k, v in self.__dict__.items():
              if k[0] != '_' and not k.endswith("_e") and not k == "cli":
                  storage[k] = v
          return storage
  ```

test "rank159: python config dict serialization with API redaction is clean"
  lang python
  reject_review code.ConfigExposureReview
  code
  ```
  class ConfigSQL:
      def to_dict(self):
          storage = {}
          for k, v in self.__dict__.items():
              if k[0] != '_' and not k.endswith("_e") and k != "cli" and 'api' not in k.lower():
                  storage[k] = v
          return storage
  ```
