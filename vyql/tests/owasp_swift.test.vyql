# OWASP-replica coverage for Swift — true positive plus opaque-predicate pruning.

test "swift: CommandLine arg -> sqlite3_exec is SQLi"
  lang swift
  expect VYQL-INJ-001
  code
  ```
  func g(db: OpaquePointer) {
    let name = CommandLine.arguments[1]
    sqlite3_exec(db, "SELECT * FROM users WHERE name = '" + name + "'", nil, nil, nil)
  }
  ```

test "swift: opaque if/else assigns constant on the live branch — clean SQLi"
  lang swift
  reject VYQL-INJ-001
  code
  ```
  func h(db: OpaquePointer) {
    let name = CommandLine.arguments[1]
    let num = 88
    var bar = ""
    if (7*42)-num > 200 { bar = "safe" } else { bar = "alsosafe" }
    sqlite3_exec(db, "SELECT * FROM users WHERE name = '" + bar + "'", nil, nil, nil)
  }
  ```

test "swift: opaque switch routes taint to a dead arm — clean SQLi"
  lang swift
  reject VYQL-INJ-001
  code
  ```
  func k(db: OpaquePointer) {
    let name = CommandLine.arguments[1]
    var bar = "x"
    switch 1 {
    case 9: bar = name
    default: bar = "ok"
    }
    sqlite3_exec(db, "SELECT '" + bar + "'", nil, nil, nil)
  }
  ```

test "swift: tainted assign in a live switch arm is still SQLi (no FN)"
  lang swift
  expect VYQL-INJ-001
  code
  ```
  func k(db: OpaquePointer) {
    let name = CommandLine.arguments[1]
    var bar = "x"
    switch 1 {
    case 1: bar = name
    default: bar = "ok"
    }
    sqlite3_exec(db, "SELECT '" + bar + "'", nil, nil, nil)
  }
  ```
