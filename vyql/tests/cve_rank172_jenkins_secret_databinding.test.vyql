test "rank172: Jenkins databound AWS secret key is accepted as Secret parameter"
  lang java
  expect_review code.SecretDatabindingReview
  code
  ```
  import hudson.util.Secret;
  import org.kohsuke.stapler.DataBoundConstructor;

  public class AWSCodeDeployPublisher {
    private final Secret awsSecretKey;

    @DataBoundConstructor
    public AWSCodeDeployPublisher(String awsAccessKey, Secret awsSecretKey) {
      this.awsSecretKey = awsSecretKey;
    }
  }
  ```

test "rank172: Jenkins databound AWS secret key is converted into Secret storage"
  lang java
  reject_review code.SecretDatabindingReview
  code
  ```
  import hudson.util.Secret;
  import org.kohsuke.stapler.DataBoundConstructor;

  public class AWSCodeDeployPublisher {
    private final Secret awsSecretKey;

    @DataBoundConstructor
    public AWSCodeDeployPublisher(String awsAccessKey, String awsSecretKey) {
      this.awsSecretKey = Secret.fromString(awsSecretKey);
    }
  }
  ```
