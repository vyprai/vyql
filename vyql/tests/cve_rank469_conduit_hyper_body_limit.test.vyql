# Rank 469 / CVE-2022-39294: conduit-hyper collected the whole Hyper
# request body without a Content-Length/size-hint guard, allowing oversized
# requests to trigger memory exhaustion or panic.

test "rank469: conduit-hyper blocking handler collects request body without size limit"
  lang rust
  file blocking_handler.rs
  expect VYQL-DOS-018
  expect_review code.ConduitHyperUnboundedBodyToBytes
  code
  ```
  pub(crate) async fn blocking_handler(
      self: Arc<Self>,
      request: Request<Body>,
      remote_addr: SocketAddr,
  ) -> Result<HyperResponse, ServiceError> {
      let (parts, body) = request.into_parts();
      let now = StartInstant::now();
      let full_body = hyper::body::to_bytes(body).await?;
      let request = Request::from_parts(parts, full_body);

      tokio::task::spawn_blocking(move || {
          let conduit_request = ConduitRequest::new(request, remote_addr, now);
          handler.call(conduit_request)
      })
      .await?
  }
  ```

test "rank469: conduit-hyper blocking handler checks body size before collection"
  lang rust
  file blocking_handler.rs
  reject VYQL-DOS-018
  reject_review code.ConduitHyperUnboundedBodyToBytes
  code
  ```
  const MAX_CONTENT_LENGTH: u64 = 128 * 1024 * 1024;

  pub(crate) async fn blocking_handler(
      self: Arc<Self>,
      request: Request<Body>,
      remote_addr: SocketAddr,
  ) -> Result<HyperResponse, ServiceError> {
      if let Err(response) = check_content_length(&request) {
          return Ok(response);
      }

      let (parts, body) = request.into_parts();
      let now = StartInstant::now();
      let full_body = hyper::body::to_bytes(body).await?;
      let request = Request::from_parts(parts, full_body);

      tokio::task::spawn_blocking(move || {
          let conduit_request = ConduitRequest::new(request, remote_addr, now);
          handler.call(conduit_request)
      })
      .await?
  }

  fn check_content_length(request: &Request<Body>) -> Result<(), HyperResponse> {
      if request.size_hint().lower() > MAX_CONTENT_LENGTH {
          return Err(Response::builder().status(StatusCode::BAD_REQUEST).body(Body::empty()).unwrap());
      }
      Ok(())
  }
  ```
