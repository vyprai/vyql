test "rank319: Carbon resetMessages includes locale before validation"
  lang php
  expect VYQL-PATH-011
  expect_review code.UnvalidatedLocaleFileInclude
  code
  ```
  <?php

  abstract class AbstractTranslator
  {
      private array $messages = [];

      abstract public function getDirectories(): array;
      abstract public function addResource(string $type, array $messages, string $locale): void;

      public function resetMessages(?string $locale = null): bool
      {
          if ($locale === null) {
              $this->messages = [];

              return true;
          }

          foreach ($this->getDirectories() as $directory) {
              $data = @include \sprintf('%s/%s.php', rtrim($directory, '\\/'), $locale);

              if ($data !== false) {
                  $this->messages[$locale] = $data;
                  $this->addResource('array', $this->messages[$locale], $locale);

                  return true;
              }
          }

          return false;
      }
  }
  ```

test "rank319: Carbon resetMessages validates locale before include"
  lang php
  reject VYQL-PATH-011
  reject_review code.UnvalidatedLocaleFileInclude
  code
  ```
  <?php

  abstract class AbstractTranslator
  {
      private array $messages = [];

      abstract public function getDirectories(): array;
      abstract public function assertValidLocale(string $locale): void;
      abstract public function addResource(string $type, array $messages, string $locale): void;

      public function resetMessages(?string $locale = null): bool
      {
          if ($locale === null) {
              $this->messages = [];

              return true;
          }

          $this->assertValidLocale($locale);

          foreach ($this->getDirectories() as $directory) {
              $data = @include \sprintf('%s/%s.php', rtrim($directory, '\\/'), $locale);

              if ($data !== false) {
                  $this->messages[$locale] = $data;
                  $this->addResource('array', $this->messages[$locale], $locale);

                  return true;
              }
          }

          return false;
      }
  }
  ```
