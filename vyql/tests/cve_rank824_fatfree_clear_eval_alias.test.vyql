# Rank 824 / CVE-2020-5203: f3-factory/fatfree-core is a duplicate owner alias
# for the same Fat-Free Framework clear($key) eval issue covered by rank 823.

test "rank824: clear key reaches eval compile without code-execution validation"
  lang php
  file base.php
  expect VYQL-INJ-003
  code
  ```
  <?php
  final class Base {
    function compile($expr) { return $expr; }
    function clear($key) {
      eval('unset('.$this->compile('@this->hive.'.$key).');');
    }
  }
  $fw = new Base();
  $fw->clear($_GET['key']);
  ```

test "rank824: public clear key is an external entry into eval compile"
  lang php
  file base.php
  expect VYQL-INJ-003
  code
  ```
  <?php
  final class Base {
    function compile($expr) { return $expr; }
    function clear($key) {
      eval('unset('.$this->compile('@this->hive.'.$key).');');
    }
  }
  ```

test "rank824: clear key strips eval-breaking suffix before compile"
  lang php
  file base.php
  reject VYQL-INJ-003
  code
  ```
  <?php
  final class Base {
    function compile($expr) { return $expr; }
    function clear($key) {
      $key = preg_replace('/(\)\W*\w+.*$)/', '', $key);
      eval('unset('.$this->compile('@this->hive.'.$key).');');
    }
  }
  $fw = new Base();
  $fw->clear($_GET['key']);
  ```
