test "python: repr-based query parser SQL fragment is reported"
  lang python
  expect VYQL-INJ-030
  code
  ```
  class QueryParser:
      DEFAULT_FIELD = "text"

      def __repr__(self):
          return '"text" ILIKE \'%%term%%\''

      def parse(self, query, default_field=None):
          default_field = default_field or QueryParser.DEFAULT_FIELD
          return repr(query_expr.parseString(query)[0]).replace("__default_field__", default_field)
  ```

test "python: parameterized query parser SQL output is clean"
  lang python
  reject VYQL-INJ-030
  code
  ```
  class QueryParser:
      DEFAULT_FIELD = "text"

      def parse(self, query, default_field=None):
          default_field = default_field or QueryParser.DEFAULT_FIELD
          params = {}
          parsed = query_expr.parseString(query)[0]
          sql = parsed.to_sql(params)
          return sql.replace("__default_field__", default_field), params
  ```
