# Rank 908 / CVE-2026-35614: Frappe expanded Link and Dynamic Link fields by
# fetching referenced documents without read permission and field-level filtering.

test "rank908: Frappe link expansion fetches linked docs without read permission"
  lang python
  file v1.py
  expect VYQL-AUTH-065
  expect_review code.FrappeLinkExpansionMissingReadPermission
  code
  ```
  import frappe

  def get_values_for_link_and_dynamic_link_fields(doc_dict):
      meta = frappe.get_meta(doc_dict.doctype)
      link_fields = meta.get_link_fields() + meta.get_dynamic_link_fields()

      for field in link_fields:
          if not (doc_fieldvalue := getattr(doc_dict, field.fieldname, None)):
              continue

          doctype = field.options if field.fieldtype == "Link" else doc_dict.get(field.options)

          link_doc = frappe.get_doc(doctype, doc_fieldvalue)
          doc_dict.update({field.fieldname: link_doc})
  ```

test "rank908: Frappe link expansion enforces read permission and field-level filtering"
  lang python
  file v1.py
  reject VYQL-AUTH-065
  reject_review code.FrappeLinkExpansionMissingReadPermission
  code
  ```
  import frappe

  def get_values_for_link_and_dynamic_link_fields(doc_dict):
      meta = frappe.get_meta(doc_dict.doctype)
      link_fields = meta.get_link_fields() + meta.get_dynamic_link_fields()

      for field in link_fields:
          if not (doc_fieldvalue := getattr(doc_dict, field.fieldname, None)):
              continue

          doctype = field.options if field.fieldtype == "Link" else doc_dict.get(field.options)

          link_doc = frappe.get_doc(doctype, doc_fieldvalue, check_permission="read")
          link_doc.apply_fieldlevel_read_permissions()
          doc_dict.update({field.fieldname: link_doc})
  ```
