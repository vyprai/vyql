# Rank 1059 / CVE-2026-20613: apple/containerization joins an archive entry's
# own path to the extraction directory and writes it, so an entry named with
# leading traversal escapes the directory (CWE-22, CWE-59).
# ArchiveReader.extractContents holds
#
#   guard let p = entry.path else { continue }
#   let target = directory.appending(path: p)
#   ...
#   try data.write(to: target, options: .atomic)
#   chmod(target.path(), entry.permissions)
#
# with no containment check and no O_NOFOLLOW, so a symlink entry extracted
# first redirects the writes that follow. The fixed revision adds
# FileDescriptor+SecurePath.swift and rewrites extraction to walk from a root
# descriptor with mkdirSecure and openat carrying
# O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW, returning the entry paths it rejects.
#
# ATTENTION, vocabulary gap, and the rule is not the problem. VYQL-PATH-004 is
# `taint core.UserControlledData -> code.ArchiveEntryWrite` with
# `unless path coveredBy core.PathCanonicalization` and
# `unless endpoint coveredBy core.PathAccessCheck`, which is this weakness
# stated language-neutrally. Both ends are missing in Swift.
#
#  - No source. code.ArchiveEntryName is bound in java, javascript, php,
#    powershell and python, and not in swift, so an entry's own name is not
#    attacker-controlled data to the engine and the taint rule has nothing to
#    start from.
#  - The one sink binding is repro-shaped, and it labels the wrong revision.
#    Swift emits code.ArchiveEntryWrite from a single binding,
#    `query pattern callExpr where callee.method == "extractEntry"`. The
#    vulnerable code has no such method -- it writes through
#    `data.write(to: target, options: .atomic)` inside `extractContents` --
#    while the fixed revision introduces a private `extractEntry` helper, so
#    the label appears only at the fixed revision. On the real package nothing
#    archive-related is labelled at the vulnerable revision, and
#    code.ArchiveEntryWrite is labelled at ArchiveReader.swift:205 at the
#    fixed one. Neither revision reports, because the source is absent either
#    way, but the label is exactly backwards. This is what a binding written
#    from one repository's method name rather than from a library's
#    documentation does, and it is worth fixing on its own account.
#
# The last two snippets are that pair, differing only in the name of the method
# doing the write.
#
# verify_current_expected: attention-vocabulary-gap

test "rank1059: the entry path is joined to the destination and written"
  lang swift
  file Sources/ContainerizationArchive/Reader.swift
  reject VYQL-PATH-004
  code
  ```
  import Foundation

  public final class ArchiveReader {
      public func extractContents(to directory: URL) throws {
          let fm = FileManager.default
          try fm.createDirectory(at: directory, withIntermediateDirectories: true)

          for (entry, data) in self {
              guard let p = entry.path else { continue }
              let target = directory.appending(path: p)

              if entry.fileType == .directory {
                  try fm.createDirectory(at: target, withIntermediateDirectories: true)
              } else {
                  try data.write(to: target, options: .atomic)
              }

              chmod(target.path(), entry.permissions)
          }
      }
  }
  ```

test "rank1059: the fixed revision walks from a root descriptor with openat and O_NOFOLLOW"
  lang swift
  file Sources/ContainerizationArchive/ArchiveReader.swift
  reject VYQL-PATH-004
  code
  ```
  import Foundation
  import SystemPackage

  public final class ArchiveReader {
      private func extractEntry(memberPath: FilePath, rootFileDescriptor: FileDescriptor, fileMode: mode_t) throws -> Bool {
          guard let lastComponent = memberPath.lastComponent else { return false }
          let relativePath = memberPath.removingLastComponent()

          try rootFileDescriptor.mkdirSecure(relativePath, makeIntermediates: true) { fd in
              try? fd.unlinkRecursiveSecure(filename: lastComponent)
              let fileFd = openat(fd.rawValue, lastComponent.string, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, fileMode)
              guard fileFd >= 0 else {
                  throw ArchiveError.failedToExtractArchive("failed to create file: \(memberPath)")
              }
          }
          return true
      }
  }
  ```

test "rank1059: the binding's pair, the write the vulnerable code actually does"
  lang swift
  file Sources/ContainerizationArchive/Reader.swift
  reject VYQL-PATH-004
  code
  ```
  import Foundation

  func extractContents(to directory: URL, entryPath: String, data: Data) throws {
      let target = directory.appending(path: entryPath)
      try data.write(to: target, options: .atomic)
  }
  ```

