test "recheck: javascript CLI token guarded protected route is clean"
  lang javascript
  reject_review code.LocalRequestBypassReview
  code
  ```
  async function hasValidCliToken(request) {
    const token = request.headers.get("x-cli-token");
    return token && token === await getCliToken();
  }

  export async function proxy(request) {
    const { pathname } = request.nextUrl;
    if (pathname.startsWith("/api/shutdown")) {
      if (await hasValidCliToken(request) || await hasValidToken(request)) return NextResponse.next();
      return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
    }
  }
  ```

test "recheck: rust async stream receive without timeout is review-visible"
  lang rust
  expect_review code.UnboundedResourceOperation
  code
  ```
  async fn handle_tcp(mut hickory_stream: TcpStream, sender: Sender) {
      while let Some(message) = hickory_stream.next().await {
          process_message(message, &sender, Protocol::Tcp);
      }
  }
  ```

test "recheck: rust async stream receive with timeout is clean"
  lang rust
  reject_review code.UnboundedResourceOperation
  code
  ```
  async fn handle_tcp(mut hickory_stream: TcpStream, sender: Sender) {
      match tokio::time::timeout(Duration::from_secs(3), hickory_stream.next()).await {
          Ok(message) => {
              if let Some(msg) = message {
                  process_message(msg, &sender, Protocol::Tcp);
              }
          }
          Err(_) => debug!("timeout"),
      }
  }
  ```

test "recheck: go overflow bucket for unbounded key cardinality is review-visible"
  lang go
  expect_review code.UnboundedStateGrowthReview
  code
  ```
  package utils

  import "sync"

  const maxPaths = 120

  type StatManager struct {
      stats sync.Map
      pathCount Counter
  }

  func (sm *StatManager) RecordStat(path string, count int64) {
      val, loaded := sm.stats.Load(path)
      if !loaded {
          if sm.pathCount.Load() >= maxPaths {
              val, _ = sm.stats.LoadOrStore("overflow", new(int64))
          } else {
              val = new(int64)
              sm.stats.Store(path, val)
              sm.pathCount.Add(1)
          }
      }
      _ = val
  }
  ```

test "recheck: go explicit fail closed path cardinality limit is clean"
  lang go
  reject_review code.UnboundedStateGrowthReview
  code
  ```
  package utils

  import "fmt"

  const maxPaths = 45

  type StatManager struct {
      stats Map
      pathCount Counter
  }

  func (sm *StatManager) RecordStat(path string, count int64) {
      val, loaded := sm.stats.Load(path)
      if !loaded {
          if sm.pathCount.Load() >= maxPaths {
              panic(fmt.Sprintf("Stats path limit exceeded: %d paths is the maximum allowed", maxPaths))
          }
          val = new(int64)
          sm.stats.Store(path, val)
          sm.pathCount.Add(1)
      }
      _ = val
  }
  ```

test "recheck: rust unsafe Send and Sync without matching generic bounds is reported"
  lang rust
  expect VYQL-RACE-003
  expect_review code.UnsafeAutoTraitImpl
  code
  ```
  pub struct AtomicBox<T> {
      value: *mut T,
  }

  unsafe impl<T: Sized> Sync for AtomicBox<T> {}
  unsafe impl<T: Sized> Send for AtomicBox<T> {}
  ```

test "recheck: rust unsafe Send and Sync with matching generic bounds is clean"
  lang rust
  reject VYQL-RACE-003
  reject_review code.UnsafeAutoTraitImpl
  code
  ```
  pub struct AtomicBox<T> {
      value: *mut T,
  }

  unsafe impl<T: Sized + Sync> Sync for AtomicBox<T> {}
  unsafe impl<T: Sized + Send> Send for AtomicBox<T> {}
  ```

