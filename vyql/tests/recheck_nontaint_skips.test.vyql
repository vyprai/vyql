test "recheck: c privileged trigger with uid guard is clean"
  lang c
  reject_review code.PrivilegedEntryPointReview
  code
  ```
  static int perform_http_xact(void) {
      if (url_type == CREATION_NOTIFICATION) {
          if (client_uid != 0) {
              return 403;
          }
          messagebuf_data[messagebuf_len] = '\0';
          return run_post_create(messagebuf_data);
      }
      return 0;
  }
  ```

test "recheck: java ignored authorization result is review-visible"
  lang java
  expect_review code.IgnoredAuthorizationResult
  code
  ```
  class MasterClientServiceHandler {
    Master master;
    public void shutdown(TCredentials c, boolean stopTabletServers) throws Exception {
      master.security.canPerformSystemActions(c);
      master.setMasterGoalState(MasterGoalState.CLEAN_STOP);
    }
  }
  ```

test "recheck: java authorization result enforced by throw is clean"
  lang java
  reject_review code.IgnoredAuthorizationResult
  code
  ```
  class MasterClientServiceHandler {
    Master master;
    public void shutdown(TCredentials c, boolean stopTabletServers) throws Exception {
      if (!master.security.canPerformSystemActions(c)) {
        throw new ThriftSecurityException(c.getPrincipal(), SecurityErrorCode.PERMISSION_DENIED);
      }
      master.setMasterGoalState(MasterGoalState.CLEAN_STOP);
    }
  }
  ```

test "recheck: jenkins credential test endpoint without admin guard is review-visible"
  lang java
  expect_review code.CredentialedEndpointReview
  code
  ```
  class DescriptorImpl {
    public FormValidation doTest(String host, String credentialsId) {
      AccurevServer server = new AccurevServer("", "name", host);
      server.setCredentialsId(credentialsId);
      if (Login.accurevLoginFromGlobalConfig(server)) {
        return FormValidation.ok("SUCCESS");
      }
      return FormValidation.error("FAILURE");
    }
  }
  ```

test "recheck: jenkins credential test endpoint with post and admin guard is clean"
  lang java
  reject_review code.CredentialedEndpointReview
  code
  ```
  class DescriptorImpl {
    @RequirePOST
    public FormValidation doTest(String host, String credentialsId) {
      if (!Jenkins.getInstance().hasPermission(Jenkins.ADMINISTER)) {
        return FormValidation.ok();
      }
      AccurevServer server = new AccurevServer("", "name", host);
      server.setCredentialsId(credentialsId);
      if (Login.accurevLoginFromGlobalConfig(server)) {
        return FormValidation.ok("SUCCESS");
      }
      return FormValidation.error("FAILURE");
    }
  }
  ```
