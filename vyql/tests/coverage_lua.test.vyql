# Lua (OpenResty) coverage breadth: SQLi, reflected XSS, SSRF.

test "lua: ngx arg -> db query is SQL injection"
  lang lua
  expect VYQL-INJ-001
  code
  ```
  local u = ngx.var.arg_id
  db:query("select * from t where id = " .. u)
  ```

test "lua: ngx arg -> ngx.say is reflected XSS"
  lang lua
  expect VYQL-INJ-004
  code
  ```
  local u = ngx.var.arg_q
  ngx.say("<p>" .. u .. "</p>")
  ```

test "lua: ngx arg -> http.request is SSRF"
  lang lua
  expect VYQL-RF-001
  code
  ```
  local u = ngx.var.arg_url
  http.request(u)
  ```

test "lua: a constant URL is clean (SSRF)"
  lang lua
  reject VYQL-RF-001
  code
  ```
  http.request("https://api.example.com/v1")
  ```
