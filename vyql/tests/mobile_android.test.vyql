# Mobile / Android threat model: IPC is the trust boundary. Intent extras and deep-link
# URIs are attacker-controlled (any app can send them). They reach local SQLite, OS
# commands, files, and — the mobile-specific surface — the WebView.

test "android: intent extra -> SQLite rawQuery is SQLi"
  lang java
  expect VYQL-INJ-001
  code
  ```
  class A {
    void onCreate() {
      String q = getIntent().getStringExtra("q");
      db.rawQuery("SELECT * FROM users WHERE name = '" + q + "'", null);
    }
  }
  ```

test "android: deep-link param -> Runtime.exec is command injection"
  lang java
  expect VYQL-INJ-002
  code
  ```
  class A {
    void onCreate() {
      String c = getIntent().getData().getQueryParameter("cmd");
      Runtime.getRuntime().exec(c);
    }
  }
  ```

test "android: intent extra -> WebView.loadUrl is WebView injection"
  lang java
  expect VYQL-MOB-001
  code
  ```
  class A {
    void onCreate() {
      String u = getIntent().getStringExtra("url");
      webView.loadUrl(u);
    }
  }
  ```

test "android: intent extra -> evaluateJavascript is WebView injection"
  lang java
  expect VYQL-MOB-001
  code
  ```
  class A {
    void onCreate() {
      String s = getIntent().getStringExtra("js");
      webView.evaluateJavascript(s, null);
    }
  }
  ```

test "android: addJavascriptInterface exposes a native bridge"
  lang java
  expect VYQL-MOB-002
  code
  ```
  class A {
    void onCreate() {
      webView.addJavascriptInterface(new Bridge(), "android");
    }
  }
  ```

test "android: removing a JavaScript interface is clean"
  lang java
  reject VYQL-MOB-002
  code
  ```
  class A {
    void onCreate() {
      webView.removeJavascriptInterface("android");
    }
  }
  ```

test "android (kotlin): intent extra -> WebView.loadUrl is WebView injection"
  lang kotlin
  expect VYQL-MOB-001
  code
  ```
  class A {
    fun onCreate() {
      val u = intent.getStringExtra("url")
      webView.loadUrl(u)
    }
  }
  ```

test "android (kotlin): addJavascriptInterface exposes a native bridge"
  lang kotlin
  expect VYQL-MOB-002
  code
  ```
  class A {
    fun onCreate() {
      webView.addJavascriptInterface(Bridge(), "android")
    }
  }
  ```

test "android (kotlin): removing a JavaScript interface is clean"
  lang kotlin
  reject VYQL-MOB-002
  code
  ```
  class A {
    fun onCreate() {
      webView.removeJavascriptInterface("android")
    }
  }
  ```

test "android: a constant WebView URL is clean"
  lang java
  reject VYQL-MOB-001
  code
  ```
  class A {
    void onCreate() {
      webView.loadUrl("https://example.com/home");
    }
  }
  ```
