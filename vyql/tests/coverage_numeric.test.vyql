# Numeric / size computation coverage.

test "numeric: attacker-controlled allocation size is reported (c)"
  lang c
  expect VYQL-NUM-001
  code
  ```
  int atoi(const char *);
  void *malloc(unsigned long);
  void f(int argc, char **argv) {
      int n = atoi(argv[1]);
      void *p = malloc(n * 32);
      (void)p;
  }
  ```

test "numeric: attacker-controlled division denominator is reported (c)"
  lang c
  expect VYQL-NUM-002
  code
  ```
  int atoi(const char *);
  int f(int argc, char **argv) {
      int d = atoi(argv[1]);
      return 100 / d;
  }
  ```

test "numeric: attacker-controlled size arithmetic is reported (c)"
  lang c
  expect VYQL-NUM-003
  code
  ```
  int atoi(const char *);
  int f(int argc, char **argv) {
      int n = atoi(argv[1]);
      return n * 1024;
  }
  ```

test "numeric: C assignment in condition reaches later offset arithmetic"
  lang c
  expect VYQL-NUM-003
  code
  ```
  int atoi(const char *);
  void parse_qt(unsigned end);
  void fseek(void *fp, unsigned off, int whence);
  void parse(int argc, char **argv, int end, void *fp) {
      unsigned save, size;
      save = 10;
      if ((size = atoi(argv[1])) < 8)
          return;
      parse_qt(save + size);
      fseek(fp, save + size, 0);
  }
  ```

test "numeric: C offset overflow guards suppress later arithmetic"
  lang c
  reject VYQL-NUM-003
  code
  ```
  int atoi(const char *);
  void parse_qt(unsigned end);
  void fseek(void *fp, unsigned off, int whence);
  void parse(int argc, char **argv, int end, void *fp) {
      unsigned save, size;
      save = 10;
      if ((size = atoi(argv[1])) < 8)
          return;
      if ((int)size < 0)
          return;
      if (save + size < save)
          return;
      parse_qt(save + size);
      fseek(fp, save + size, 0);
  }
  ```
