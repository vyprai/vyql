# Rank 453 / CVE-2019-19619: Documize rendered Markdown through blackfriday
# and returned the HTML directly. The fix sanitizes the generated HTML with
# bluemonday before returning it to the browser rendering path.

test "rank453: Documize Markdown Render returns blackfriday HTML without sanitizer"
  lang go
  expect VYQL-INJ-093
  expect_review code.DocumizeMarkdownRenderWithoutSanitizer
  code
  ```
  package markdown

  import "github.com/documize/blackfriday"

  type Provider struct{}
  type Context struct{}

  func (*Provider) Render(ctx *Context, config, data string) string {
      result := blackfriday.Run([]byte(data))

      return string(result)
  }
  ```

test "rank453: Documize Markdown Render sanitizes blackfriday HTML"
  lang go
  reject VYQL-INJ-093
  reject_review code.DocumizeMarkdownRenderWithoutSanitizer
  code
  ```
  package markdown

  import (
      "github.com/documize/blackfriday"
      "github.com/microcosm-cc/bluemonday"
  )

  type Provider struct{}
  type Context struct{}

  func (*Provider) Render(ctx *Context, config, data string) string {
      unsafe := blackfriday.Run([]byte(data))

      safe := bluemonday.UGCPolicy().SanitizeBytes(unsafe)

      return string(safe)
  }
  ```
