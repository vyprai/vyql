test "swift exhaustive: WebView and response writers render tainted HTML"
  lang swift
  expect VYQL-MOB-001
  expect VYQL-INJ-004
  code
  ```
  func handler(webView: WKWebView, response: Response) {
    let html = UIPasteboard.general.string ?? ""
    webView.evaluateJavaScript(html)
    webView.loadHTMLString(html, baseURL: nil)
    response.write(html)
    response.send(html)
  }
  ```

test "swift exhaustive: escaped response HTML and constant WebView script are clean"
  lang swift
  reject VYQL-MOB-001
  reject VYQL-INJ-004
  code
  ```
  func handler(webView: WKWebView, response: Response) {
    let html = escapeHtml(UIPasteboard.general.string ?? "")
    webView.evaluateJavaScript("init()")
    response.write(html)
  }
  ```

