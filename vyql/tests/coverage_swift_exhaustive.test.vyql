# Swift language-gap narrowing: exhaustive coverage for adapter-claimed idioms.

test "swift exhaustive: environment input reaches sqlite and raw query methods"
  lang swift
  expect VYQL-INJ-001
  code
  ```
  func handler(db: OpaquePointer, conn: Conn) {
    let q = ProcessInfo.processInfo.environment["Q"]!
    sqlite3_exec(db, q, nil, nil, nil)
    sqlite3_prepare_v2(db, q, -1, nil, nil)
    conn.execute(q)
    conn.run(q)
  }
  ```

test "swift exhaustive: constant sqlite and raw query calls are clean"
  lang swift
  reject VYQL-INJ-001
  code
  ```
  func handler(db: OpaquePointer, conn: Conn) {
    sqlite3_exec(db, "select 1", nil, nil, nil)
    conn.execute("select 1")
  }
  ```

test "swift exhaustive: command strings reach libc command execution"
  lang swift
  expect VYQL-INJ-002
  code
  ```
  func handler() {
    let cmd = ProcessInfo.processInfo.environment["CMD"]!
    system(cmd)
    popen(cmd, "r")
  }
  ```

test "swift exhaustive: shell escaping suppresses command injection"
  lang swift
  reject VYQL-INJ-002
  code
  ```
  func handler() {
    let cmd = escapeShell(ProcessInfo.processInfo.environment["CMD"]!)
    system(cmd)
  }
  ```

test "swift exhaustive: file APIs access tainted paths"
  lang swift
  expect VYQL-PATH-001
  code
  ```
  func handler() {
    let p = ProcessInfo.processInfo.environment["PATH_INFO"]!
    String(contentsOfFile: p)
    FileHandle(forReadingAtPath: p)
  }
  ```

