test "swift exhaustive: LDAP XPath and trust-boundary sinks receive tainted data"
  lang swift
  expect VYQL-INJ-005
  expect VYQL-INJ-006
  expect VYQL-CFG-014
  code
  ```
  func handler(directory: Directory, xpath: XPath, session: Session) {
    let filter = ProcessInfo.processInfo.environment["FILTER"]!
    let xp = ProcessInfo.processInfo.environment["XPATH"]!
    let role = ProcessInfo.processInfo.environment["ROLE"]!
    directory.search("dc=example", filter)
    xpath.evaluate(xp)
    session.setAttribute("role", role)
  }
  ```

test "swift exhaustive: LDAP XPath and trust-boundary controls suppress findings"
  lang swift
  reject VYQL-INJ-005
  reject VYQL-INJ-006
  reject VYQL-CFG-014
  code
  ```
  func handler(directory: Directory, xpath: XPath, session: Session) {
    let filter = encodeForLDAP(ProcessInfo.processInfo.environment["FILTER"]!)
    let xp = escapeXPath(ProcessInfo.processInfo.environment["XPATH"]!)
    let role = validateRole(ProcessInfo.processInfo.environment["ROLE"]!)
    directory.search("dc=example", filter)
    xpath.evaluate(xp)
    session.setAttribute("role", role)
  }
  ```

test "swift exhaustive: auth and IDOR findings are reported"
  lang swift
  expect VYQL-AUTH-001
  expect VYQL-AUTH-002
  code
  ```
  func handler(request: Request, repo: Repo) {
    changePassword(request.query["password"])
    repo.findById(request.query["id"])
  }
  ```

test "swift exhaustive: auth and ownership guards suppress findings"
  lang swift
  reject VYQL-AUTH-001
  reject VYQL-AUTH-002
  code
  ```
  func handler(request: Request, repo: Repo) {
    requireAuth(request)
    changePassword(request.query["password"])
    checkOwnership(request.query["id"])
    repo.findById(request.query["id"])
  }
  ```

test "swift exhaustive: weak crypto random static IV cert cookie CORS and frame config are reported"
  lang swift
  expect VYQL-CRY-001
  expect VYQL-CRY-002
  expect VYQL-CRY-003
  expect VYQL-CRY-004
  expect VYQL-CFG-003
  expect VYQL-CFG-004
  expect VYQL-CFG-007
  expect VYQL-CFG-009
  code
  ```
  func handler(response: Response) {
    Insecure.MD5.hash(data: Data())
    CC_SHA1(ptr, len, out)
    Cipher("DES")
    Cipher("RC4")
    Cipher("0000000000000000")
    AES.GCM.Nonce(data: "000000000000")
    arc4random()
    setSecure(false)
    setHttpOnly(false)
    allowsAnyHTTPSCertificate(true)
    serverTrustPolicy("disableEvaluation")
    response.setHeader("Access-Control-Allow-Origin", "*")
    response.setHeader("X-Frame-Options", "ALLOWALL")
  }
  ```

test "swift exhaustive: stronger crypto and secure config are clean"
  lang swift
  reject VYQL-CRY-001
  reject VYQL-CRY-002
  reject VYQL-CRY-003
  reject VYQL-CRY-004
  reject VYQL-CFG-003
  reject VYQL-CFG-004
  reject VYQL-CFG-007
  reject VYQL-CFG-009
  code
  ```
  func handler(response: Response) {
    SHA256.hash(data: Data())
    Cipher("AES")
    AES.GCM.Nonce()
    SecRandomCopyBytes(nil, 16, out)
    setSecure(true)
    setHttpOnly(true)
    allowsAnyHTTPSCertificate(false)
    response.setHeader("Access-Control-Allow-Origin", "https://example.com")
    response.setHeader("X-Frame-Options", "DENY")
  }
  ```

test "swift exhaustive: resource handles closed are clean"
  lang swift
  reject VYQL-RES-001
  code
  ```
  func handler() {
    let h = FileHandle.forReadingAtPath("data.txt")
    h.closeFile()
  }
  ```

test "swift exhaustive: resource handles leak"
  lang swift
  expect VYQL-RES-001
  code
  ```
  func handler() {
    let h = FileHandle.forReadingAtPath("data.txt")
    h.readDataToEndOfFile()
  }
  ```
