# JavaScript static-regex ReDoS coverage: user input matched by a vulnerable literal pattern.

test "javascript: replace against ambiguous quantified regex is ReDoS"
  lang javascript
  profile library
  expect VYQL-DOS-002
  code
  ```
  module.exports = ansiHTML;
  function ansiHTML(text) {
    return text.replace(/\033\[(\d+)*m/g, function () { return ""; });
  }
  ```

test "javascript: replace against fixed ansi regex is clean"
  lang javascript
  profile library
  reject VYQL-DOS-002
  code
  ```
  module.exports = ansiHTML;
  function ansiHTML(text) {
    return text.replace(/\033\[(\d+)m/g, function () { return ""; });
  }
  ```

test "javascript: constructed ansi regex with ambiguous quantified branch is ReDoS"
  lang javascript
  expect VYQL-DOS-003
  code
  ```
  module.exports = () => {
    const pattern = [
      '[\\u001B\\u009B][[\\]()#;?]*(?:(?:(?:[a-zA-Z\\d]*(?:;[a-zA-Z\\d]*)*)?\\u0007)',
      '(?:(?:\\d{1,4}(?:;\\d{0,4})*)?[\\dA-PRZcf-ntqry=><~]))'
    ].join('|');

    return new RegExp(pattern, 'g');
  };
  ```

test "javascript: constructed ansi regex with separated branch is clean"
  lang javascript
  reject VYQL-DOS-003
  code
  ```
  module.exports = () => {
    const pattern = [
      '[\\u001B\\u009B][[\\]()#;?]*(?:(?:(?:(?:;[-a-zA-Z\\d\\/#&.:=?%@~_]+)*|[a-zA-Z\\d]+(?:;[a-zA-Z\\d]*)*)?\\u0007)',
      '(?:(?:\\d{1,4}(?:;\\d{0,4})*)?[\\dA-PRZcf-ntqry=><~]))'
    ].join('|');

    return new RegExp(pattern, 'g');
  };
  ```
