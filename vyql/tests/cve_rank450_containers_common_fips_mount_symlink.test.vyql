# Rank 450 / CVE-2024-9341: containers/common joined a FIPS backend path
# under the container root with filepath.Join before using it as a bind-mount
# source, allowing symlinks in the image to redirect the mount to host paths.

test "rank450: containers common FIPS backend mount uses filepath Join"
  lang go
  file subscriptions.go
  expect VYQL-PATH-023
  expect_review code.ContainersCommonFipsModeMountSymlink
  code
  ```
  package subscriptions

  import (
    "path/filepath"

    "github.com/containers/storage/pkg/fileutils"
    rspec "github.com/opencontainers/runtime-spec/specs-go"
  )

  func addFIPSModeSubscription(mounts *[]rspec.Mount, containerRunDir, mountPoint, mountLabel string, uid, gid int) error {
    srcBackendDir := "/usr/share/crypto-policies/back-ends/FIPS"
    destDir := "/etc/crypto-policies/back-ends"
    srcOnHost := filepath.Join(mountPoint, srcBackendDir)
    if err := fileutils.Exists(srcOnHost); err != nil {
      return nil
    }

    m := rspec.Mount{
      Source: srcOnHost,
      Destination: destDir,
      Type: "bind",
      Options: []string{"bind", "rprivate"},
    }
    *mounts = append(*mounts, m)
    return nil
  }
  ```

test "rank450: containers common FIPS backend mount uses securejoin"
  lang go
  file subscriptions.go
  reject VYQL-PATH-023
  reject_review code.ContainersCommonFipsModeMountSymlink
  code
  ```
  package subscriptions

  import (
    "fmt"

    "github.com/containers/storage/pkg/fileutils"
    securejoin "github.com/cyphar/filepath-securejoin"
    rspec "github.com/opencontainers/runtime-spec/specs-go"
  )

  func addFIPSModeSubscription(mounts *[]rspec.Mount, containerRunDir, mountPoint, mountLabel string, uid, gid int) error {
    srcBackendDir := "/usr/share/crypto-policies/back-ends/FIPS"
    destDir := "/etc/crypto-policies/back-ends"
    srcOnHost, err := securejoin.SecureJoin(mountPoint, srcBackendDir)
    if err != nil {
      return fmt.Errorf("resolve %s in the container: %w", srcBackendDir, err)
    }
    if err := fileutils.Exists(srcOnHost); err != nil {
      return nil
    }

    m := rspec.Mount{
      Source: srcOnHost,
      Destination: destDir,
      Type: "bind",
      Options: []string{"bind", "rprivate"},
    }
    *mounts = append(*mounts, m)
    return nil
  }
  ```
