# A4 — clickjacking via explicitly-disabled frame protection (CWE-1021, VYQL-CFG-009).
# Only EXPLICIT disabling (X-Frame-Options: ALLOWALL / helmet frameguard off) is flagged;
# pure omission and protective values (DENY/SAMEORIGIN) are clean.

test "clickjacking: X-Frame-Options ALLOWALL is flagged (javascript)"
  lang javascript
  expect VYQL-CFG-009
  code
  ```
  res.setHeader("X-Frame-Options", "ALLOWALL");
  ```

test "clickjacking: helmet frameguard disabled is flagged (javascript)"
  lang javascript
  expect VYQL-CFG-009
  code
  ```
  app.use(helmet({ frameguard: false }));
  ```

test "clickjacking: a protective frame value is clean (javascript)"
  lang javascript
  reject VYQL-CFG-009
  code
  ```
  res.setHeader("X-Frame-Options", "DENY");
  ```

test "clickjacking: X-Frame-Options ALLOWALL is flagged (go)"
  lang go
  expect VYQL-CFG-009
  code
  ```
  package main
  import "net/http"
  func h(w http.ResponseWriter) {
  	w.Header().Set("X-Frame-Options", "ALLOWALL")
  }
  ```

test "clickjacking: header set via call is flagged (python)"
  lang python
  expect VYQL-CFG-009
  code
  ```
  resp.headers.add("X-Frame-Options", "ALLOWALL")
  ```
