# Rank 560 / CVE-2026-27447: CUPS authorized local users and groups with
# case-insensitive comparisons of supplied names instead of canonical OS names.

test "rank560: cups group membership uses case-insensitive supplied username"
  lang c
  file auth.c
  expect VYQL-AUTH-032
  expect_review code.CaseInsensitiveLocalIdentityAuthorizationBypass
  code
  ```
  typedef struct passwd {
    char *pw_name;
    int pw_gid;
  } passwd_t;

  typedef struct group {
    char **gr_mem;
  } group_t;

  extern int _cups_strcasecmp(const char *a, const char *b);
  extern int strcmp(const char *a, const char *b);

  int cupsdCheckGroup(const char *username, passwd_t *user, const char *groupname) {
    group_t *group;
    int i;

    if (group != 0) {
      for (i = 0; group->gr_mem[i]; i ++) {
        if (!_cups_strcasecmp(username, group->gr_mem[i]))
          return 1;
      }
    }
    return 0;
  }
  ```

test "rank560: cups group membership uses canonical passwd name"
  lang c
  file auth.c
  reject VYQL-AUTH-032
  reject_review code.CaseInsensitiveLocalIdentityAuthorizationBypass
  code
  ```
  typedef struct passwd {
    char *pw_name;
    int pw_gid;
  } passwd_t;

  typedef struct group {
    char **gr_mem;
  } group_t;

  extern int _cups_strcasecmp(const char *a, const char *b);
  extern int strcmp(const char *a, const char *b);

  int cupsdCheckGroup(const char *username, passwd_t *user, const char *groupname) {
    group_t *group;
    int i;

    if (user && group) {
      for (i = 0; group->gr_mem[i]; i ++) {
        if (!strcmp(user->pw_name, group->gr_mem[i]))
          return 1;
      }
    }
    return 0;
  }
  ```

test "rank560: cups policy names use case-insensitive supplied username"
  lang c
  file auth.c
  expect VYQL-AUTH-032
  expect_review code.CaseInsensitiveLocalIdentityAuthorizationBypass
  code
  ```
  typedef struct passwd {
    char *pw_name;
  } passwd_t;

  extern int _cups_strcasecmp(const char *a, const char *b);
  extern int strcmp(const char *a, const char *b);

  int cupsdIsAuthorized(const char *username, passwd_t *pw, const char *name, const char *ownername, int owner) {
    if (!_cups_strcasecmp(name, "@OWNER") && owner &&
        !_cups_strcasecmp(username, ownername))
      return 1;
    else if (!_cups_strcasecmp(username, name))
      return 1;
    return 0;
  }
  ```

test "rank560: cups policy names use canonical passwd name"
  lang c
  file auth.c
  reject VYQL-AUTH-032
  reject_review code.CaseInsensitiveLocalIdentityAuthorizationBypass
  code
  ```
  typedef struct passwd {
    char *pw_name;
  } passwd_t;

  extern int _cups_strcasecmp(const char *a, const char *b);
  extern int strcmp(const char *a, const char *b);

  int cupsdIsAuthorized(const char *username, passwd_t *pw, const char *name, const char *ownername, int owner) {
    if (!_cups_strcasecmp(name, "@OWNER") && owner && pw &&
        !strcmp(pw->pw_name, ownername))
      return 1;
    else if (pw && !strcmp(pw->pw_name, name))
      return 1;
    return 0;
  }
  ```
