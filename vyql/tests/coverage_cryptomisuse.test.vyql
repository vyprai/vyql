# A9 — crypto-misuse (lite, Pattern subset of VYQL-CRY-002 WeakCipher). ECB mode and
# NullCipher are unambiguous weaknesses; CBC/GCM are clean. (Static-IV / hardcoded-key
# detection is deferred to the type-state engine B2.)

test "crypto-misuse: AES ECB mode is flagged (python)"
  lang python
  expect VYQL-CRY-002
  code
  ```
  from Crypto.Cipher import AES
  def enc(key, data):
      return AES.new(key, AES.MODE_ECB).encrypt(data)
  ```

test "crypto-misuse: AES CBC mode is clean (python)"
  lang python
  reject VYQL-CRY-002
  code
  ```
  from Crypto.Cipher import AES
  def enc(key, iv, data):
      return AES.new(key, AES.MODE_CBC, iv).encrypt(data)
  ```

test "crypto-misuse: NullCipher is flagged (java)"
  lang java
  expect VYQL-CRY-002
  code
  ```
  import javax.crypto.NullCipher;
  class X { void f() { NullCipher c = new NullCipher(); } }
  ```
