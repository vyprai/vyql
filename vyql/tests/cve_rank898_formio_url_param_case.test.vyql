# Rank 898 / CVE-2025-67718: Formio parsed URL path parameter names with
# caller-controlled case, while later request lookups expected canonical keys.

test "rank898: formio url params preserve caller-controlled key case"
  lang javascript
  file util.js
  expect VYQL-VAL-013
  code
  ```
  const nodeUrl = require('url');
  const _ = require('lodash');

  const Utils = {
    getUrlParams(url) {
      const urlParams = {};
      if (!url) {
        return urlParams;
      }
      const parsed = nodeUrl.parse(url);
      let parts = parsed.pathname.split('/');
      parts = _.tail(parts);

      if ((parts.length % 2) !== 0) {
        parts.push('');
      }

      for (let a = 0; a < parts.length; a += 2) {
        urlParams[parts[a]] = parts[a + 1];
      }

      return urlParams;
    },
  };
  ```

test "rank898: formio url params canonicalize key case"
  lang javascript
  file util.js
  reject VYQL-VAL-013
  code
  ```
  const nodeUrl = require('url');
  const _ = require('lodash');

  const Utils = {
    getUrlParams(url) {
      const urlParams = {};
      if (!url) {
        return urlParams;
      }
      const parsed = nodeUrl.parse(url);
      let parts = parsed.pathname.split('/');
      parts = _.tail(parts);

      if ((parts.length % 2) !== 0) {
        parts.push('');
      }

      for (let a = 0; a < parts.length; a += 2) {
        urlParams[parts[a].toLowerCase()] = parts[a + 1];
      }

      return urlParams;
    },
  };
  ```
