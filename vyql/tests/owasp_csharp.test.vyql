# OWASP-replica coverage for C# / ASP.NET — true positives plus precision patterns
# (opaque-predicate pruning) unlocked by the parity port.

# --- SQL injection (INJ-001) ---
test "csharp: QueryString -> SqlCommand is SQLi"
  lang csharp
  expect VYQL-INJ-001
  code
  ```
  using System.Data.SqlClient;
  class T { void g(System.Web.HttpRequest req) {
    string p = req.QueryString["id"];
    var cmd = new SqlCommand("SELECT * FROM u WHERE id='" + p + "'");
    cmd.ExecuteReader();
  } }
  ```

test "csharp: opaque if/else assigns constant on the live branch — clean SQLi"
  lang csharp
  reject VYQL-INJ-001
  code
  ```
  using System.Data.SqlClient;
  class T { void h(System.Web.HttpRequest req) {
    string p = req.QueryString["id"]; int num = 88; string bar;
    if ((7*42)-num > 200) bar = "safe"; else bar = "alsosafe";
    var cmd = new SqlCommand("SELECT * FROM u WHERE id='" + bar + "'");
    cmd.ExecuteReader();
  } }
  ```

test "csharp: ternary routes to a constant — clean SQLi"
  lang csharp
  reject VYQL-INJ-001
  code
  ```
  using System.Data.SqlClient;
  class T { void h(System.Web.HttpRequest req) {
    string p = req.QueryString["id"]; int num = 106;
    string bar = ((7*18)+num > 200) ? "safe" : p;
    var cmd = new SqlCommand("SELECT * FROM u WHERE id='" + bar + "'");
    cmd.ExecuteReader();
  } }
  ```

# --- command injection (INJ-002) ---
test "csharp: QueryString -> Process.Start is command injection"
  lang csharp
  expect VYQL-INJ-002
  code
  ```
  using System.Diagnostics;
  class T { void g(System.Web.HttpRequest req) {
    string p = req.QueryString["cmd"];
    Process.Start(p);
  } }
  ```

# --- weak hash (CRY-001) ---
test "csharp: MD5.Create is weak hash"
  lang csharp
  expect VYQL-CRY-001
  code
  ```
  using System.Security.Cryptography;
  class T { void h() { var md5 = MD5.Create(); } }
  ```
