# verify_current_expected: skip-fresh-target
# Rank 713 / CVE-2026-33638: the fresh checkout is already past the real
# security fix, and the selected corpus commit only bumps the version to 4.2.0.
# This spec covers the vulnerable route mechanic: /allusers must be registered
# under an authenticated route group, not a public route group.

test "rank713: public all-users route exposes user listing"
  lang go
  file user.go
  expect VYQL-AUTH-092
  expect_review code.PublicUserListRouteMissingAuthentication
  code
  ```
  package router

  type AppRouterGroup struct {
      PublicRouterGroup *RouterGroup
      AuthRouterGroup   *RouterGroup
  }
  type RouterGroup struct{}
  type UserHandler struct{}
  type HandlerBundle struct{ UserHandler *UserHandler }

  func (g *RouterGroup) GET(path string, handlers ...any) {}
  func (h *UserHandler) GetAllUsers() any { return nil }

  func setupUserRoutes(groups *AppRouterGroup, h *HandlerBundle) {
      groups.PublicRouterGroup.GET("/allusers", h.UserHandler.GetAllUsers())
  }
  ```

test "rank713: authenticated all-users route is clean"
  lang go
  file user.go
  reject VYQL-AUTH-092
  reject_review code.PublicUserListRouteMissingAuthentication
  code
  ```
  package router

  type AppRouterGroup struct {
      PublicRouterGroup *RouterGroup
      AuthRouterGroup   *RouterGroup
  }
  type RouterGroup struct{}
  type UserHandler struct{}
  type HandlerBundle struct{ UserHandler *UserHandler }

  func (g *RouterGroup) GET(path string, handlers ...any) {}
  func (h *UserHandler) GetAllUsers() any { return nil }

  func setupUserRoutes(groups *AppRouterGroup, h *HandlerBundle) {
      groups.AuthRouterGroup.GET("/allusers", h.UserHandler.GetAllUsers())
  }
  ```
