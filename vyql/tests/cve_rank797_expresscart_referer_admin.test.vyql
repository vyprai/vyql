# Rank 797 / CVE-2018-12457: expressCart created an admin account when the
# request Referer path looked like /admin/setup. The fix uses server-side user
# count instead of trusting the header.

test "rank797: JavaScript user creation trusts Referer for admin privilege"
  lang javascript
  file user.js
  expect VYQL-AUTH-050
  expect_review code.RefererBasedAdminUserCreation
  code
  ```
  router.post('/admin/user/insert', common.restrict, (req, res) => {
      let urlParts = url.parse(req.header('Referer'));
      let isAdmin = false;
      if (urlParts.path === '/admin/setup') {
          isAdmin = true;
      }
      let doc = {
          usersName: req.body.usersName,
          userEmail: req.body.userEmail,
          userPassword: bcrypt.hashSync(req.body.userPassword, 10),
          isAdmin: isAdmin
      };
      db.users.insert(doc, (err, doc) => {
          res.redirect('/admin/users');
      });
  });
  ```

test "rank797: JavaScript user creation uses server-side first-user check"
  lang javascript
  file user.js
  reject VYQL-AUTH-050
  reject_review code.RefererBasedAdminUserCreation
  code
  ```
  router.post('/admin/user/insert', common.restrict, (req, res) => {
      let urlParts = url.parse(req.header('Referer'));
      db.users.count({}, (err, userCount) => {
          let isAdmin = false;
          if (userCount === 0) {
              isAdmin = true;
          }
          let doc = {
              usersName: req.body.usersName,
              userEmail: req.body.userEmail,
              userPassword: bcrypt.hashSync(req.body.userPassword, 10),
              isAdmin: isAdmin
          };
          db.users.insert(doc, (err, doc) => {
              res.redirect('/admin/users');
          });
      });
  });
  ```
