# Rank 901 / CVE-2022-25188: Fortify Jenkins plugin built summary XML
# filenames from user-controlled application/version names without encoding.

test "rank901: Fortify summary filename builder returns raw app name and version"
  lang java
  profile library
  expect VYQL-PATH-049
  expect_review code.CallerControlledFilenameComponentPathTraversal
  code
  ```
  package com.fortify.plugin.jenkins;

  import java.io.File;
  import hudson.XmlFile;

  public class FPRSummary {
      private static final String FILE_BASENAME = "fortify";
      private static final String FILE_EXTENSION = ".xml";

      private String buildFilename(String appName, String appVersion) {
          String filename = FILE_BASENAME;
          if (appName != null) {
              filename += "-" + appName;
          }
          if (appVersion != null) {
              filename += "-" + appVersion;
          }
          filename += FILE_EXTENSION;
          return filename;
      }

      public void save(File parent, String appName, String appVersion) throws Exception {
          File file = new File(parent, buildFilename(appName, appVersion));
          XmlFile xml = new XmlFile(null, file);
          xml.write(new Object());
      }
  }
  ```

test "rank901: Fortify summary filename builder raw-encodes app name and version"
  lang java
  profile library
  reject VYQL-PATH-049
  reject_review code.CallerControlledFilenameComponentPathTraversal
  code
  ```
  package com.fortify.plugin.jenkins;

  import java.io.File;
  import hudson.Util;
  import hudson.XmlFile;

  public class FPRSummary {
      private static final String FILE_BASENAME = "fortify";
      private static final String FILE_EXTENSION = ".xml";

      private String buildFilename(String appName, String appVersion) {
          String filename = FILE_BASENAME;
          if (appName != null) {
              filename += "-" + appName;
          }
          if (appVersion != null) {
              filename += "-" + appVersion;
          }
          filename += FILE_EXTENSION;
          return Util.rawEncode(filename);
      }

      public void save(File parent, String appName, String appVersion) throws Exception {
          File file = new File(parent, buildFilename(appName, appVersion));
          XmlFile xml = new XmlFile(null, file);
          xml.write(new Object());
      }
  }
  ```
