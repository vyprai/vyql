# Missing-authentication coverage (VYQL-AUTH-003): a privileged operation (OS command
# execution) inside an HTTP request handler, reachable by an unauthenticated caller.
# The rule is a context+control query — it does not require request data to flow into
# the command, only that the operation sits in HTTP-exposed code with no dominating
# auth check.

# --- positive: unauthenticated remote command (AUTH-003) ---
test "go: command exec in an HTTP handler with no auth check is missing-auth"
  lang go
  expect VYQL-AUTH-003
  code
  ```
  package main
  import ("net/http"; "os/exec")
  func handleDeleteUser(w http.ResponseWriter, r *http.Request) {
    id := r.URL.Query().Get("id")
    exec.Command("userdel", id).Run()
  }
  func main() { http.HandleFunc("/admin/delete", handleDeleteUser) }
  ```

# --- negative: an auth check that dominates the command suppresses the finding ---
test "go: command exec guarded by a dominating auth check is not missing-auth"
  lang go
  reject VYQL-AUTH-003
  code
  ```
  package main
  import ("net/http"; "os/exec")
  func RequireAuth(r *http.Request) bool { return r.Header.Get("Authorization") != "" }
  func handleResetPassword(w http.ResponseWriter, r *http.Request) {
    if !RequireAuth(r) {
      http.Error(w, "no", 401)
      return
    }
    id := r.URL.Query().Get("id")
    exec.Command("passwd", id).Run()
  }
  func main() { http.HandleFunc("/admin/reset", handleResetPassword) }
  ```

# --- negative: command exec in a non-HTTP (CLI) context is not flagged ---
test "go: command exec with no HTTP input in scope is not missing-auth"
  lang go
  reject VYQL-AUTH-003
  code
  ```
  package main
  import ("os"; "os/exec")
  func main() {
    name := os.Args[1]
    exec.Command("echo", name).Run()
  }
  ```
