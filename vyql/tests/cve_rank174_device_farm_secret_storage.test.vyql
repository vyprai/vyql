test "rank174: Jenkins AWS Device Farm descriptor stores AWS keys as Secret values"
  lang java
  reject_review code.SecretDatabindingReview
  code
  ```
  import hudson.util.Secret;

  public class AWSDeviceFarmRecorder {
    public static final class DescriptorImpl {
      public Secret akid;
      public Secret skid;

      protected final void setAkid(String akidValue) {
        akid = Secret.fromString(akidValue);
      }

      protected final void setSkid(String skidValue) {
        skid = Secret.fromString(skidValue);
      }
    }
  }
  ```
