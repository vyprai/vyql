  ```
  public class AWSDeviceFarmRecorder {
    public static final class DescriptorImpl {
      public String akid;
      public String skid;

      protected final void setAkid(String akidValue) {
        akid = akidValue;
      }

      protected final void setSkid(String skidValue) {
        skid = skidValue;
