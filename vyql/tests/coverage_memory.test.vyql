# Memory-safety coverage: taint-proven memory operands plus assumption-gated smells.

test "memory: argv reaches strcpy source and unbounded-copy smell is reported (c)"
  lang c
  expect VYQL-MEM-001
  expect VYQL-MEM-002
  expect_evidence VYQL-MEM-001 unsafe copy primitive strcpy receives tainted input
  code
  ```
  void f(int argc, char **argv) {
      char dst[8];
      strcpy(dst, argv[1]);
  }
  ```

test "memory: constant strcpy is only the low-confidence smell (c)"
  lang c
  expect VYQL-MEM-002
  reject VYQL-MEM-001
  code
  ```
  void f() {
      char dst[8];
      strcpy(dst, "ok");
  }
  ```

test "memory: attacker-controlled memcpy size is reported (c)"
  lang c
  expect VYQL-MEM-003
  code
  ```
  int atoi(const char *);
  void f(int argc, char **argv, char *dst, char *src) {
      int n = atoi(argv[1]);
      memcpy(dst, src, n);
  }
  ```

test "memory: stack allocation smell is reported (c)"
  lang c
  expect VYQL-MEM-004
  code
  ```
  void f(int n) {
      char *buf = alloca(n);
      (void)buf;
  }
  ```

test "memory: attacker-controlled array index is reported (c)"
  lang c
  expect VYQL-MEM-005
  code
  ```
  int atoi(const char *);
  int f(int argc, char **argv, int *arr) {
      int i = atoi(argv[1]);
      return arr[i];
  }
  ```

test "memory: pointer dereference is reported as nullable-deref smell (c)"
  lang c
  expect VYQL-MEM-006
  code
  ```
  void f(int *p) {
      *p = 1;
  }
  ```

test "memory: free before dereference is reported as potential use-after-free (c)"
  lang c
  expect VYQL-MEM-007
  code
  ```
  void free(void *);
  void f(int *p) {
      free(p);
      *p = 1;
  }
  ```

test "memory: repeated free is reported as potential double-free (c)"
  lang c
  expect VYQL-MEM-008
  code
  ```
  void free(void *);
  void f(int *p) {
      free(p);
      free(p);
  }
  ```

test "memory: C++ owned buffer freed on failure path is double-free relevant"
  lang cpp
  expect VYQL-MEM-011
  code
  ```
  class Player {
    unsigned char *song_data;
    bool load(bool ok, int n) {
      song_data = new unsigned char[n];
      if (!ok) {
        delete[] song_data;
        return false;
      }
      return true;
    }
  };
  ```

test "memory: C++ local temporary freed on failure path is clean"
  lang cpp
  reject VYQL-MEM-011
  code
  ```
  bool load(bool ok, int n) {
    unsigned char *tmp = new unsigned char[n];
    if (!ok) {
      delete[] tmp;
      return false;
    }
    return true;
  }
  ```

test "memory: computed size reaches reallocarray without a zero-size exit guard"
  lang c
  expect VYQL-MEM-012
  code
  ```
  typedef unsigned char GifPixelType;
  void *reallocarray(void *, unsigned long, unsigned long);

  void resize(unsigned int width, unsigned int height, GifPixelType *bits) {
      unsigned long new_size = width * height;
      bits = reallocarray(bits, new_size, sizeof(GifPixelType));
  }
  ```

test "memory: zero-size exit guard suppresses reallocarray lifetime smell"
  lang c
  reject VYQL-MEM-012
  code
  ```
  typedef unsigned char GifPixelType;
  void *reallocarray(void *, unsigned long, unsigned long);
  void free(void *);

  void resize(unsigned int width, unsigned int height, GifPixelType *bits) {
      unsigned long new_size = width * height;
      if (new_size == 0) {
          free(bits);
          bits = 0;
          return;
      }
      bits = reallocarray(bits, new_size, sizeof(GifPixelType));
  }
  ```

test "memory: unrelated zero-size exit guard does not suppress reallocarray lifetime smell"
  lang c
  expect VYQL-MEM-012
  code
  ```
  typedef unsigned char GifPixelType;
  void *reallocarray(void *, unsigned long, unsigned long);

  void resize(unsigned int width, unsigned int height, unsigned long other, GifPixelType *bits) {
      unsigned long new_size = width * height;
      if (other == 0) {
          return;
      }
      bits = reallocarray(bits, new_size, sizeof(GifPixelType));
  }
  ```

test "memory: escaped terminator reaches decoded buffer write"
  lang cpp
  expect VYQL-MEM-013
  code
  ```
  char unescapeChar(char c);

  char *extractFrom(char *input) {
      char *readPtr = input + 1;
      char *writePtr = readPtr;
      char c;

      for (;;) {
          c = *readPtr++;
          if (c == '\0') return 0;
          if (c == '"') break;
          if (c == '\\') {
              c = unescapeChar(*readPtr++);
          }
          *writePtr++ = c;
      }

      *writePtr = '\0';
      return input + 1;
  }
  ```

test "memory: escaped terminator check before decoded buffer write is clean"
  lang cpp
  reject VYQL-MEM-013
  code
  ```
  char unescapeChar(char c);

  char *extractFrom(char *input) {
      char *readPtr = input + 1;
      char *writePtr = readPtr;
      char c;

      for (;;) {
          c = *readPtr++;
          if (c == '\0') return 0;
          if (c == '"') break;
          if (c == '\\') {
              c = unescapeChar(*readPtr++);
              if (c == '\0') return 0;
          }
          *writePtr++ = c;
      }

      *writePtr = '\0';
      return input + 1;
  }
  ```
