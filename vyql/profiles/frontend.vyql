// Browser / single-page app. Trust boundary = the DOM and the URL: the attacker
// controls location/hash/referrer/window-name/storage and the markup these flow into.
// Full-stack JavaScript repos often mix React/Vue assets with route handlers in the
// same package, so keep HTTP request entry points active as well.
profile frontend {
  title: "Frontend / single-page app (browser)"
  priority: "70"
  detect: ["dep:react", "dep:vue", "dep:@angular/core", "dep:svelte", "dep:preact",
           "file:angular.json", "ext:.jsx", "ext:.tsx", "ext:.vue", "ext:.svelte"]
  entrypoints: [DomInput, HttpInput, HttpHeader, Cookie, FileUpload, PatternOptionInput, SecretValue, ComputedSizeValue,
                ArchiveEntryName]
}
