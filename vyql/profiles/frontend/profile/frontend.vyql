module profiles;

profile frontend {
  detect: ["dep:react", "dep:vue", "dep:@angular/core", "dep:svelte", "dep:preact", "file:angular.json", "ext:.jsx", "ext:.tsx", "ext:.vue", "ext:.svelte"]
  entrypoints: [DomInput, HttpInput, HttpHeader, Cookie, FileUpload, PatternOptionInput, SecretValue, ComputedSizeValue, ArchiveEntryName]
  priority: "70"
  title: "Frontend / single-page app (browser)"
}
