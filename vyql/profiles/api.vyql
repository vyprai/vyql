// HTTP API / microservice (no server-rendered HTML). Every request is hostile,
// including authenticated ones — emphasis on injection, authz/IDOR, mass-assignment,
// SSRF, deserialization, and JWT handling.
profile api {
  title: "HTTP API server"
  priority: "80"
  detect: ["dep:fastapi", "dep:@nestjs/core", "dep:gin-gonic/gin", "dep:express",
           "dep:grpc", "file:openapi.yaml", "file:openapi.json",
           // Go HTTP routers/servers — a service exposing these has an HTTP attack
           // surface even when it ALSO ships a CLI (e.g. a cobra-based daemon).
           "dep:gorilla/mux", "dep:go-chi/chi", "dep:gofiber/fiber", "dep:labstack/echo"]
  entrypoints: [HttpInput, HttpHeader, PatternOptionInput, SecretValue, ComputedSizeValue, ArchiveEntryName]
}
