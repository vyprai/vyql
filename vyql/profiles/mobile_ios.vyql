// iOS app. Trust boundary = inter-app input: custom URL schemes / universal links, the
// pasteboard, WKWebView message handlers, plus network responses and on-device data. The
// WKWebView bridge and local SQLite/file sinks are the high-risk surface. (URL-scheme
// delegate-param sourcing is deferred — see plan/threat-model-checklist.md.)
profile mobile_ios {
  title: "Mobile app — iOS"
  priority: "90"
  detect: ["file:Info.plist", "file:Package.swift", "dep:UIKit", "dep:SwiftUI",
           "dep:WebKit", "ext:.xcodeproj", "ext:.swift"]
  entrypoints: [PasteboardInput, URLSchemeInput, ExternalApiResponse, DatabaseRead, SecretValue]
}
