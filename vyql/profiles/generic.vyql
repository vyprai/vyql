// Default / unknown application. Permissive: HTTP request data, uploads, cookies,
// secrets, store/external reads, AND process-level inputs (argv/env/stdin) are all
// treated as untrusted. Public library API params are active only under the library
// profile; browser/mobile entry points are likewise scoped to their own profiles.
profile generic {
  title: "Generic application (no archetype detected)"
  entrypoints: [HttpInput, HttpHeader, HttpRequest, Cookie, FileUpload, SecretValue,
                DatabaseRead, ExternalApiResponse, MessageInput, IntentInput, PasteboardInput,
                CliArgument, EnvVariable, StdinInput, ConfigFileInput]
}
