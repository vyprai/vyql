module profiles;

profile api {
  detect: ["dep:fastapi", "dep:@nestjs/core", "dep:gin-gonic/gin", "dep:express", "dep:grpc", "file:openapi.yaml", "file:openapi.json", "dep:gorilla/mux", "dep:go-chi/chi", "dep:gofiber/fiber", "dep:labstack/echo"]
  entrypoints: [HttpInput, HttpHeader, PatternOptionInput, SecretValue, ComputedSizeValue, ArchiveEntryName]
  priority: "80"
  title: "HTTP API server"
}
