module profiles;

profile cli {
  detect: ["dep:cobra", "dep:click", "dep:argparse", "dep:clap", "dep:commander", "dep:yargs", "dep:picocli", "dep:thor"]
  entrypoints: [CliArgument, EnvVariable, StdinInput, ConfigFileInput, StoredDataRead, ExternalApiResponse, PatternOptionInput, SecretValue, ComputedSizeValue, ArchiveEntryName]
  priority: "20"
  title: "Command-line tool"
}
