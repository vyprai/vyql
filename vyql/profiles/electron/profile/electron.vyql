module profiles;

profile electron {
  detect: ["dep:electron", "dep:electron-builder", "file:electron.js", "file:main.js"]
  entrypoints: [UserControlledData, HttpInput, IntentInput, ExternalApiResponse, StoredDataRead, PatternOptionInput, SecretValue, EnvVariable, CliArgument, StdinInput, ComputedSizeValue, ArchiveEntryName]
  priority: "90"
  title: "Desktop app (Electron)"
}
