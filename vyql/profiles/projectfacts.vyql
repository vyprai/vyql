module profiles;

// How a profile's `detect:` predicates are answered against a project on disk.
//
// A profile declares WHICH facts identify its archetype; this declares WHAT each fact
// means -- which files are read to answer dependency(), what a language() name is on
// disk, what makes a directory a project root, and what a satisfied predicate is worth
// when profiles are ranked against each other. All of it was compiled into Go, so
// teaching VyQL a new ecosystem meant editing the scanner rather than the knowledge
// base, and the relative weighting of predicates was invisible to a profile author.
policy projectFacts default {

  // Concatenated per project root and searched by dependency(), framework() and
  // import(). A manifest missing from this list makes every dependency fingerprint in
  // that ecosystem unanswerable, and the project is profiled as something else.
  manifests: [
    "package.json", "requirements.txt", "pyproject.toml", "go.mod",
    "Pipfile", "Pipfile.lock", "poetry.lock", "Gemfile", "Gemfile.lock",
    "pom.xml", "build.gradle", "Cargo.toml", "composer.json"
  ]

  // A scanned path walks UP to the nearest directory holding one of these, and that
  // directory is the root every other fact is answered against. Entries containing '*'
  // are globbed; the rest are looked up by name.
  projectMarkers: [
    ".git", "package.json", "setup.py", "setup.cfg", "pyproject.toml", "go.mod",
    "Pipfile", "requirements.txt", "Gemfile", "pom.xml", "build.gradle",
    "Cargo.toml", "composer.json", "AndroidManifest.xml", "Info.plist",
    "Package.swift", "*.xcodeproj"
  ]

  // What one satisfied predicate contributes to a profile's detection score. Profiles
  // are ranked by total score, so these are the relative weights: a publishable-package
  // fact is deliberately worth two ordinary fingerprints, because a repo can depend on
  // express AND ship as a library, and the library reading should win.
  score {
    dependency: 1
    framework: 1
    import: 1
    language: 1
    file: 1
    ext: 1
    not: 1
    fact: 2
  }

  // What language("x") means on disk. Names are matched case-insensitively.
  language: [
    { name: "c",           exts: [".c", ".h"] }
    { name: "cpp",         exts: [".cc", ".cpp", ".cxx", ".hpp", ".hh", ".hxx"] }
    { name: "csharp",      exts: [".cs"] }
    { name: "dart",        exts: [".dart"] }
    { name: "elixir",      exts: [".ex", ".exs"] }
    { name: "go",          exts: [".go"] }
    { name: "groovy",      exts: [".groovy"] }
    { name: "java",        exts: [".java"] }
    { name: "javascript",  exts: [".js", ".jsx", ".mjs", ".cjs"] }
    { name: "kotlin",      exts: [".kt", ".kts"] }
    { name: "objective-c", exts: [".m", ".mm"] }
    { name: "php",         exts: [".php"] }
    { name: "python",      exts: [".py"] }
    { name: "ruby",        exts: [".rb"] }
    { name: "rust",        exts: [".rs"] }
    { name: "scala",       exts: [".scala"] }
    { name: "swift",       exts: [".swift"] }
    { name: "typescript",  exts: [".ts", ".tsx", ".mts", ".cts"] }
  ]

  // Named facts answered by walking the project for a file that satisfies one of the
  // `match` entries. project.has("<name>") consults this table; project.has("ext:.tsx")
  // is answered by the extension inventory instead and needs no entry here.
  //
  // Each match entry names a file (`file:` exact, `suffix:` extension) and, optionally,
  // what its contents must show:
  //   contains:   any one of these substrings is present
  //   absent:     none of these substrings is present
  //   jsonEquals: this top-level JSON field holds exactly this string
  //   jsonFalse:  this top-level JSON field is absent or not true
  //   jsonAnySet: any one of these top-level JSON fields is present and not ""
  // A match with no content clause is satisfied by the file existing.
  fact: [
    {
      // A non-private npm package that declares any publish surface. `main` is often
      // omitted (it defaults to index.js), so files/types/bin count too.
      name: "npm:publishable"
      skipDirs: ["node_modules"]
      match: [
        {
          file: "package.json"
          jsonFalse: ["private"]
          jsonAnySet: ["main", "module", "exports", "files", "types", "typings", "bin"]
        }
      ]
    }
    {
      // A publishable package manifest in any other ecosystem.
      name: "manifest:publishable"
      skipDirs: ["node_modules", "vendor"]
      match: [
        { suffix: ".gemspec" }
        { suffix: ".podspec" }
        { suffix: ".nuspec" }
        {
          // A .NET project that declares NuGet PACKAGE metadata is a publishable
          // artifact; an Exe output project is an application.
          suffix: ".csproj"
          absent: ["<OutputType>Exe</OutputType>", "<OutputType>WinExe</OutputType>"]
          contains: [
            "<PackageId>", "<PackageLicenseExpression>",
            "<PackageLicenseFile>", "<GeneratePackageOnBuild>"
          ]
        }
        {
          // hpi/maven-plugin packaging is a publishable plugin. Plain-jar poms are too
          // ambiguous to use as a profile fingerprint.
          file: "pom.xml"
          contains: ["<packaging>hpi</packaging>", "<packaging>maven-plugin</packaging>"]
        }
        { file: "Cargo.toml", contains: ["[lib]"] }
        {
          // Explicit only -- an absent type is ambiguous, because PHP applications
          // omit it.
          file: "composer.json"
          jsonEquals: { type: "library" }
        }
      ]
    }
  ]
}
