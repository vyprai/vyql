// Reusable library / SDK. There is no single entry point — any caller may pass attacker
// data through a public API. Treat externally-derived data and any user-controlled value
// as untrusted, and flag unsafe defaults. Public-API-param tainting is REAL here:
// ExternalEntryInput labels function parameters as a (low-confidence) source.
profile library {
  title: "Library / SDK"
  detect: ["file:setup.py", "file:pyproject.toml", "npm:publishable",
           "dep:rollup", "dep:tsup", "manifest:publishable"]
  entrypoints: [UserControlledData, ExternalEntryInput, DomInput, ExternalApiResponse, HttpInput, DatabaseRead, SecretValue]
}
