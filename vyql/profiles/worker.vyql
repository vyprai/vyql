// Background worker / queue consumer. Trust boundary = the message payload (queue/topic),
// webhook bodies, dropped files, and rows written by other systems — all semi-trusted.
// Deserialization and injection of message payloads are the main risks.
profile worker {
  title: "Background worker / queue consumer"
  priority: "60"
  detect: ["dep:celery", "dep:sidekiq", "dep:bull", "dep:bullmq", "dep:kafkajs",
           "dep:amqplib", "dep:@aws-sdk/client-sqs"]
  entrypoints: [MessageInput, ExternalApiResponse, HttpInput, FileUpload, DatabaseRead, SecretValue,
                ComputedSizeValue, ArchiveEntryName]
}
