module profiles;

profile web {
  detect: [any(dependency("flask"), dependency("django"), dependency("rails"), dependency("express"), dependency("laravel"), dependency("spring-boot-starter-web"), file("config/routes.rb"))]
  entrypoints: [code.HttpInput, code.HttpHeader, code.Cookie, code.FileUpload, code.PatternOptionInput, code.SecretValue, code.DatabaseRead, code.StoredDataRead, code.DomInput, code.ComputedSizeValue, code.ArchiveEntryName, code.RenderedMarkup]
  priority: 80
  title: "Server-rendered web application"
}
