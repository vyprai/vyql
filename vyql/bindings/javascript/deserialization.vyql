module bindings.javascript.deserialization;

// Structured-text parsers that yield plain data: JSON.parse builds only JSON
// scalars/containers, Date.parse returns a number, and url/querystring parsing returns a
// plain object of strings. None can instantiate arbitrary types or execute code, so none is
// CWE-502 object deserialization. They were being reported because ~46 generated package
// bindings (content-type, css, esprima, @babel/parser, …) declare a RECEIVER-AGNOSTIC
// `callee.method == "parse"` deserialization sink: depending on any one of those packages
// turned every `.parse()` in the codebase into a critical finding, JSON.parse included.
// Exact path matches, so genuinely unsafe loaders (node-serialize.unserialize, cryo.parse,
// yaml.load) are untouched.
binding jsonParseIsNotObjectDeserialization {
  query pattern callExpr where callee.path == "JSON.parse"
  emit check core.SafeDeserialization at args[0] {
    covers path {
      from: args[0]
      to: call
    }
  }
}

binding dateParseIsNotObjectDeserialization {
  query pattern callExpr where callee.path == "Date.parse"
  emit check core.SafeDeserialization at args[0] {
    covers path {
      from: args[0]
      to: call
    }
  }
}

binding urlParseIsNotObjectDeserialization {
  query pattern callExpr where callee.path == "url.parse"
  emit check core.SafeDeserialization at args[0] {
    covers path {
      from: args[0]
      to: call
    }
  }
}

binding querystringParseIsNotObjectDeserialization {
  query pattern callExpr where callee.path == "querystring.parse"
  emit check core.SafeDeserialization at args[0] {
    covers path {
      from: args[0]
      to: call
    }
  }
}
