module bindings.javascript.mcp_tool_schema_secret_parameter;

// An MCP server registers a tool with `server.tool(name, description, schema,
// handler)` or `server.registerTool(name, config, handler)` from
// @modelcontextprotocol/sdk. The schema object is the tool's declared input:
// the host advertises it to the model and the model fills it in, so every
// value in it travels as tool-call JSON over the MCP transport and into
// whatever conversation transcript the host keeps. A schema property named
// after key material therefore puts that key material everywhere the
// transcript goes. The documented way to give a tool access to a secret is a
// reference the server resolves on its own side, not the secret itself.
//
// The property value has to look like a schema entry — a zod builder, which is
// the schema library the SDK documents, or a JSON Schema object — so that an
// ordinary `{ mnemonic: someLocal }` argument elsewhere in the same module is
// not read as a declared tool input.
binding mcpToolSchemaSecretParameter {
  query pattern presenceNode where node.context.language == "javascript" and node.context.literal contains "@modelcontextprotocol/sdk" and containsAny(node.context.call, ["tool", "registerTool"]) and containsAny(node.context.prop, ["mnemonic=z.", "mnemonic={type:", "seedPhrase=z.", "seedPhrase={type:", "seed_phrase=z.", "seed_phrase={type:", "recoveryPhrase=z.", "recoveryPhrase={type:", "recovery_phrase=z.", "recovery_phrase={type:", "privateKey=z.", "privateKey={type:", "private_key=z.", "private_key={type:", "secretKey=z.", "secretKey={type:", "secret_key=z.", "secret_key={type:", "signingKey=z.", "signingKey={type:", "signing_key=z.", "signing_key={type:", "passphrase=z.", "passphrase={type:", "apiSecret=z.", "apiSecret={type:", "api_secret=z.", "api_secret={type:", "clientSecret=z.", "clientSecret={type:", "client_secret=z.", "client_secret={type:"])
  emit issue code.McpToolSchemaSecretParameter at node
}
