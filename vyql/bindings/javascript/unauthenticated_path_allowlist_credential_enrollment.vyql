module bindings.javascript.unauthenticated_path_allowlist_credential_enrollment;

// Node authentication middleware is written the same way everywhere: the
// middleware runs on every request, and a hard-coded list of request paths
// names the handful of endpoints that must answer before a session exists --
// the login form, the password check, the token refresh, the logout. Express,
// Koa, Nest and Next all document that shape, and the list is spelled as a
// module-level array of path strings with a predicate over it
// (`isPublicEndpoint`, `publicPaths`, `authWhitelist`, `skipAuthPaths`,
// `unprotectedRoutes`).
//
// What belongs on that list is an *authentication* endpoint: one that takes a
// credential the caller already holds and turns it into a session. An
// *enrollment* endpoint is the opposite operation. WebAuthn's registration
// ceremony, and every MFA or TOTP setup flow built on the same idea, creates a
// new authenticator and binds it to an account; the specification and every
// library implementing it (SimpleWebAuthn, webauthn4j, py_webauthn, Duo,
// Authy) describe it as an operation performed *by the already-authenticated
// user whose account is being enrolled*. Exempting it from authentication
// hands an anonymous client the ability to register its own authenticator
// against someone's account and then log in as them through the perfectly
// legitimate authentication path next to it -- a full account takeover with no
// credential and no prior access, which is why this is CWE-306 rather than a
// weaker authorization finding.
//
// So the binding reads three facts out of the module, which is the unit
// because the list, the predicate over it and the request inspection are all
// module-level declarations:
//
//   * the module names an authentication-exemption list or the predicate that
//     tests it, in the spellings the ecosystem uses for that idea;
//   * it inspects a live request, so the list is a routing decision rather
//     than a static configuration table or a client-side route map;
//   * and one of its path literals is a credential-enrollment endpoint.
//
// The third is the defect, and it is stated positively -- as the entry the
// list should not contain -- rather than as the absence of a check the fix
// might have added somewhere else. That matters for this weakness class: the
// remediation is deleting the entry, so a binding keyed on the entry itself
// discriminates without naming anything the fix introduced.
//
// Account *signup* is deliberately not matched. `PUBLIC_PATHS = ["/login",
// "/register"]` is correct and common, because creating a new account is a
// public operation; every needle here therefore carries the authenticator
// vocabulary (`passkey`, `webauthn`, `fido`, `security-key`, `mfa`, `2fa`,
// `totp`, `otp`) in the segment before the action, and a bare `/register`
// never matches.
//
// The two anchor clauses are AST-derived and comment-proof: `identifier:`
// resolves against name nodes and `selector:` against member expressions, so
// prose cannot supply either. The literal clause is not. At module scope a
// `containsAny(node.context.literal, ...)` predicate reaches the module's raw
// source, so a comment naming an enrollment path satisfies it -- measured
// here, both prepended and appended. The exposure is stated rather than
// hidden, and it is in the false-positive direction only: it takes a module
// that already declares an authentication-exemption list and inspects
// requests, whose prose then names an enrollment endpoint the list does not
// contain. The comment-proof alternatives cost the vocabulary that makes this
// a statement about the weakness class instead of about one path spelling --
// `in [...]` compares whole literals, so it cannot see an enrollment path
// under an application's own mount prefix, and `endsWith` takes a single
// value, so it would cover one spelling per binding.
binding jsUnauthenticatedPathAllowlistNamesCredentialEnrollment {
  query pattern presenceNode where node.scope == "module"
    and node.context.language == "javascript"
    and containsAny(node.context.identifier, ["isPublicEndpoint", "isPublicPath", "isPublicRoute", "isPublicUrl", "publicPaths", "publicRoutes", "publicEndpoints", "publicUrls", "authWhitelist", "authAllowlist", "whitelistedPaths", "allowlistedPaths", "skipAuthPaths", "skipAuthRoutes", "shouldSkipAuth", "noAuthPaths", "noAuthRoutes", "unprotectedPaths", "unprotectedRoutes", "unauthenticatedPaths", "unauthenticatedRoutes", "anonymousPaths", "anonymousRoutes", "bypassAuthPaths", "excludedAuthPaths", "authExemptPaths"])
    and containsAny(node.context.selector, ["req.user", "req.method", "req.path", "req.url", "req.originalUrl", "req.baseUrl", "request.path", "request.url", "request.method", "ctx.path", "ctx.method", "ctx.request.path"])
    and containsAny(node.context.literal, ["/passkeys/register", "/passkey/register", "/passkeys/registration", "/passkey/registration", "/webauthn/register", "/webauthn/registration", "/fido/register", "/fido2/register", "/security-key/register", "/security-keys/register", "/mfa/enroll", "/mfa/setup", "/mfa/register", "/2fa/enroll", "/2fa/setup", "/2fa/register", "/totp/enroll", "/totp/setup", "/totp/register", "/otp/setup", "/otp/enroll"])
  emit issue code.UnauthenticatedCredentialEnrollmentPath at node
}
