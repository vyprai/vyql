module bindings.javascript.generated.mfb63017a;

binding electronNodeIntegration210 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "javascript" and node.context.literal contains "will-attach-webview" and node.context.assign contains "webPreferences.nodeIntegration=false" and not (node.context.assign contains "webPreferences.contextIsolation=true")
  emit issue code.ElectronNodeIntegration at node
