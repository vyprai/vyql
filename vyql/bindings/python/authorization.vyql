    and args.any.literal contains "module_call_path:request.cookies.get"
    and (
      (args.any.literal contains "module_literal:user_token"
        and args.any.literal contains "module_selector:company.id")
      or (args.any.literal contains "module_literal:identity"
        and args.any.literal contains "module_selector:account.id")
      or (args.any.literal contains "module_literal:access_token"
        and args.any.literal contains "module_selector:user.id")
      or (args.any.literal contains "module_literal:auth_token"
        and args.any.literal contains "module_selector:principal.id")
      or (args.any.literal contains "module_literal:credential"
        and args.any.literal contains "module_selector:identity.id")
    )
    and not (containsAny(args.any.literal, ["module_call_path:jwt.encode", "module_call_path:hmac.new", "module_call_path:hmac.digest", "module_call_path:itsdangerous.dumps", "module_call_path:serializer.dumps", "module_call_path:Fernet.encrypt"]))
  emit issue code.ForgeableIdentityToken at call
}
