module bindings.python.generated.m21017d75;

binding commandStringWrapperExecution244 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "python" and containsAny(node.context.callPath, ["subprocess.run", "subprocess.call", "subprocess.Popen", "subprocess.check_output", "subprocess.check_call"]) and node.token contains "shell=True" and containsAny(node.context.assign, ["command=f\"", "command=f'", "cmd=f\"", "cmd=f'", "shell_command=f\"", "shell_command=f'"]) and containsAny(node.context.callArg, ["subprocess.run:command", "subprocess.call:command", "subprocess.Popen:command", "subprocess.check_output:command", "subprocess.check_call:command", "subprocess.run:cmd", "subprocess.call:cmd", "subprocess.Popen:cmd", "subprocess.check_output:cmd", "subprocess.check_call:cmd", "subprocess.run:shell_command", "subprocess.call:shell_command", "subprocess.Popen:shell_command", "subprocess.check_output:shell_command", "subprocess.check_call:shell_command"]) and not (containsAny(node.context.callPath, ["shlex.quote", "shlex.join", "subprocess.list2cmdline"])) and not (node.identifier contains "pkgmgr")
  emit issue code.CommandStringWrapperExecution at node
}
