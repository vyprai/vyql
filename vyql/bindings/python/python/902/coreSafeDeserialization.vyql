module bindings.python.deserialization;

// json.loads builds only str/int/float/bool/None/list/dict — it cannot instantiate
// arbitrary types or execute code, so it is not CWE-502 unsafe deserialization. It was
// being flagged because the pickle/marshal sink patterns match loosely on the `loads`
// method name whenever the receiver is unresolved. Exact path match so this never
// covers pickle.loads / dill.loads / marshal.loads.
binding jsonLoadsIsNotObjectDeserialization902 {
  query pattern callExpr where callee.path == "json.loads"
  emit check core.SafeDeserialization at args[0] {
    covers path {
      from: args[0]
      to: call
    }
  }
}
