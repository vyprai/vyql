module bindings.python.generated.m21017d75;

binding codeRedProtectedMediaPathTraversal448 {
  query pattern presenceNode where node.scope == "function" and node.context.name contains "serve_protected_file" and node.token contains "os.path.join(cr_settings['PROTECTED_MEDIA_ROOT'],path)" and node.token contains "os.path.isfile(fullpath)" and node.token contains "open(fullpath,'rb')" and not (node.token contains "fullpath.startswith(mediapath)") and not (node.token contains "os.path.abspath(os.path.join(mediapath,path))")
  emit issue code.CodeRedProtectedMediaPathTraversal at node
}
