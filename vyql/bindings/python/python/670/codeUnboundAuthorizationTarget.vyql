module bindings.python.authorization;

binding graphqlIdentityArgumentLookup670 {
  query pattern callExpr where callee.analysis == "function.local.end"
    and args.any.literal contains "class_base:graphene.ObjectType"
    and args.any.literal contains "function_name:resolve_"
    and (
      (args.any.literal contains "param_name:user_id"
        and args.any.literal contains "filter_by(user_id=user_id)"
        and not (containsAny(args.any.literal, ["ifinfo.context.user.id!=user_id:return", "ifuser_id!=info.context.user.id:return", "info.context.user.id!=user_idandinfo.context.user.username!=\"admin\":return", "info.context.user.id!=user_idandinfo.context.user.username!='admin':return", "info.context.user.id!=user_idandinfo.context.user.username!=\"admin\"):return", "info.context.user.id!=user_idandinfo.context.user.username!='admin'):return", "ifcurrent_user.id!=user_id:return", "ifuser_id!=current_user.id:return", "ifinfo.context.user.id!=user_id:raise", "ifuser_id!=info.context.user.id:raise", "ifcurrent_user.id!=user_id:raise", "ifuser_id!=current_user.id:raise"])))
      or (args.any.literal contains "param_name:account_id"
        and args.any.literal contains "filter_by(account_id=account_id)"
        and not (containsAny(args.any.literal, ["ifinfo.context.user.id!=account_id:return", "ifaccount_id!=info.context.user.id:return", "ifcurrent_user.id!=account_id:return", "ifaccount_id!=current_user.id:return", "ifinfo.context.user.id!=account_id:raise", "ifaccount_id!=info.context.user.id:raise", "ifcurrent_user.id!=account_id:raise", "ifaccount_id!=current_user.id:raise"])))
      or (args.any.literal contains "param_name:tenant_id"
        and args.any.literal contains "filter_by(tenant_id=tenant_id)"
        and not (containsAny(args.any.literal, ["ifinfo.context.user.id!=tenant_id:return", "iftenant_id!=info.context.user.id:return", "ifcurrent_user.id!=tenant_id:return", "iftenant_id!=current_user.id:return", "ifinfo.context.user.id!=tenant_id:raise", "iftenant_id!=info.context.user.id:raise", "ifcurrent_user.id!=tenant_id:raise", "iftenant_id!=current_user.id:raise"])))
      or (args.any.literal contains "param_name:owner_id"
        and args.any.literal contains "filter_by(owner_id=owner_id)"
        and not (containsAny(args.any.literal, ["ifinfo.context.user.id!=owner_id:return", "ifowner_id!=info.context.user.id:return", "ifcurrent_user.id!=owner_id:return", "ifowner_id!=current_user.id:return", "ifinfo.context.user.id!=owner_id:raise", "ifowner_id!=info.context.user.id:raise", "ifcurrent_user.id!=owner_id:raise", "ifowner_id!=current_user.id:raise"])))
    )
  emit issue code.UnboundAuthorizationTarget at call
}

binding graphqlIdentityArgumentMutation670 {
  query pattern callExpr where callee.analysis == "function.local.end"
    and args.any.literal contains "class_base:graphene.Mutation"
    and args.any.literal contains "function_name:mutate"
    and args.any.literal contains "reachable_call_method:commit"
    and (
      (args.any.literal contains "param_name:user_id"
        and args.any.literal contains "user_id=user_id"
        and not (containsAny(args.any.literal, ["ifinfo.context.user.id!=user_id:return", "ifuser_id!=info.context.user.id:return", "info.context.user.id!=user_idandinfo.context.user.username!=\"admin\":return", "info.context.user.id!=user_idandinfo.context.user.username!='admin':return", "info.context.user.id!=user_idandinfo.context.user.username!=\"admin\"):return", "info.context.user.id!=user_idandinfo.context.user.username!='admin'):return", "ifcurrent_user.id!=user_id:return", "ifuser_id!=current_user.id:return", "ifinfo.context.user.id!=user_id:raise", "ifuser_id!=info.context.user.id:raise", "ifcurrent_user.id!=user_id:raise", "ifuser_id!=current_user.id:raise"])))
      or (args.any.literal contains "param_name:account_id"
        and args.any.literal contains "account_id=account_id"
        and not (containsAny(args.any.literal, ["ifinfo.context.user.id!=account_id:return", "ifaccount_id!=info.context.user.id:return", "ifcurrent_user.id!=account_id:return", "ifaccount_id!=current_user.id:return", "ifinfo.context.user.id!=account_id:raise", "ifaccount_id!=info.context.user.id:raise", "ifcurrent_user.id!=account_id:raise", "ifaccount_id!=current_user.id:raise"])))
      or (args.any.literal contains "param_name:tenant_id"
        and args.any.literal contains "tenant_id=tenant_id"
        and not (containsAny(args.any.literal, ["ifinfo.context.user.id!=tenant_id:return", "iftenant_id!=info.context.user.id:return", "ifcurrent_user.id!=tenant_id:return", "iftenant_id!=current_user.id:return", "ifinfo.context.user.id!=tenant_id:raise", "iftenant_id!=info.context.user.id:raise", "ifcurrent_user.id!=tenant_id:raise", "iftenant_id!=current_user.id:raise"])))
      or (args.any.literal contains "param_name:owner_id"
        and args.any.literal contains "owner_id=owner_id"
        and not (containsAny(args.any.literal, ["ifinfo.context.user.id!=owner_id:return", "ifowner_id!=info.context.user.id:return", "ifcurrent_user.id!=owner_id:return", "ifowner_id!=current_user.id:return", "ifinfo.context.user.id!=owner_id:raise", "ifowner_id!=info.context.user.id:raise", "ifcurrent_user.id!=owner_id:raise", "ifowner_id!=current_user.id:raise"])))
    )
  emit issue code.UnboundAuthorizationTarget at call
}
