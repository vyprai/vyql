module bindings.python.authorization;

binding routeTargetMutation667 {
  query pattern callExpr where callee.analysis == "function.local.end"
    and containsAny(args.any.literal, ["decorator_method:route", "decorator_method:get", "decorator_method:post", "decorator_method:put", "decorator_method:patch", "decorator_method:delete"])
    and args.any.literal contains "reachable_call_method:commit"
    and (
      (args.any.literal contains "param_name:order_id" and args.any.literal contains "==order_id).first_or_404()")
      or (args.any.literal contains "param_name:record_id" and args.any.literal contains "==record_id).first_or_404()")
      or (args.any.literal contains "param_name:resource_id" and args.any.literal contains "==resource_id).first_or_404()")
      or (args.any.literal contains "param_name:object_id" and args.any.literal contains "==object_id).first_or_404()")
      or (args.any.literal contains "param_name:item_id" and args.any.literal contains "==item_id).first_or_404()")
      or (args.any.literal contains "param_name:document_id" and args.any.literal contains "==document_id).first_or_404()")
      or (args.any.literal contains "param_name:invoice_id" and args.any.literal contains "==invoice_id).first_or_404()")
      or (args.any.literal contains "param_name:account_id" and args.any.literal contains "==account_id).first_or_404()")
      or (args.any.literal contains "param_name:company_id" and args.any.literal contains "==company_id).first_or_404()")
      or (args.any.literal contains "param_name:user_id" and args.any.literal contains "==user_id).first_or_404()")
    )
  emit issue code.UnboundAuthorizationTarget at call
}
