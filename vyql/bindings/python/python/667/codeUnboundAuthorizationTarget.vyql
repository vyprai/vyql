module bindings.python.authorization;

binding routeOrderTargetMutation667 {
  query pattern callExpr where callee.analysis == "function.local.end"
    and args.any.literal contains "param_name:order_id"
    and args.any.literal contains ".commit()"
    and args.any.literal contains "==order_id).first_or_404()"
    and not (args.any.literal contains ">=0:return")
  emit issue code.UnboundAuthorizationTarget at call
}

