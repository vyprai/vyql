      or (args.any.literal contains "param_name:account_id"
        and args.any.literal contains ".query.get(account_id)"
        and not (containsAny(args.any.literal, ["terminal_guard_blocks_return:use=account;guard_kind=mismatch;guard_target=account.owner;counterpart_source=session;", "terminal_guard_blocks_return:use=account;guard_kind=mismatch;guard_target=account.owner_id;counterpart_source=session;", "terminal_guard_blocks_return:use=account;guard_kind=mismatch;guard_target=account.user_id;counterpart_source=session;", "terminal_guard_blocks_return:use=account;guard_kind=mismatch;guard_target=account.tenant_id;counterpart_source=session;", "terminal_guard_blocks_return:use=account;guard_kind=mismatch;guard_target=account.company_id;counterpart_source=session;", "terminal_guard_blocks_call:operation=query.get;args=account_id;guard_kind=mismatch;guard_target=account_id;counterpart_source=session;", "terminal_guard_blocks_return:use=account;guard_kind=mismatch;guard_target=account_id;counterpart_source=session;", "terminal_guard_blocks_call:operation=query.get;args=account_id;guard_kind=non_null;guard_target=account_id;counterpart_source=literal;", "terminal_guard_blocks_return:use=account;guard_kind=non_null;guard_target=account_id;counterpart_source=literal;", "terminal_guard_blocks_return:use=account;guard_kind=non_null;guard_target=account;counterpart_source=literal;"])))
