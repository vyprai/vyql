module bindings.python.authorization;

binding routeOrderDirectLookupMissingRelation666 {
  query pattern callExpr where callee.analysis == "function.local.end"
    and args.any.literal contains "param_name:order_id"
    and args.any.literal contains ".query.get(order_id)"
    and args.any.literal contains "call_path:session.get"
    and not (containsAny(args.any.literal, ["order.owner", "order.owner_id", "order.user_id", "order.tenant_id", "order.company_id"]))
  emit issue code.UnboundAuthorizationTarget at call
}

binding routeOrderDirectLookupRelationWithoutDenial666 {
  query pattern callExpr where callee.analysis == "function.local.end"
    and args.any.literal contains "param_name:order_id"
    and args.any.literal contains ".query.get(order_id)"
    and args.any.literal contains "call_path:session.get"
    and containsAny(args.any.literal, ["order.owner", "order.owner_id", "order.user_id", "order.tenant_id", "order.company_id"])
    and not (containsAny(args.any.literal, ["call_path:abort", "abort(", "raise ", ":raise", "returnNone", "return[]", "return{}", "returnredirect(", "status=401", "status=403"]))
  emit issue code.UnboundAuthorizationTarget at call
}

