        and not (containsAny(args.any.literal, ["terminal_guard_blocks_return:use=user;guard_kind=mismatch;guard_target=user.owner;counterpart_source=session;", "terminal_guard_blocks_return:use=user;guard_kind=mismatch;guard_target=user.owner_id;counterpart_source=session;", "terminal_guard_blocks_return:use=user;guard_kind=mismatch;guard_target=user.user_id;counterpart_source=session;", "terminal_guard_blocks_return:use=user;guard_kind=mismatch;guard_target=user.tenant_id;counterpart_source=session;", "terminal_guard_blocks_return:use=user;guard_kind=mismatch;guard_target=user.company_id;counterpart_source=session;", "terminal_guard_blocks_call:operation=query.get;args=user_id;guard_kind=mismatch;guard_target=user_id;counterpart_source=session;", "terminal_guard_blocks_return:use=user;guard_kind=mismatch;guard_target=user_id;counterpart_source=session;", "terminal_guard_blocks_call:operation=query.get;args=user_id;guard_kind=non_null;guard_target=user_id;counterpart_source=literal;", "terminal_guard_blocks_return:use=user;guard_kind=non_null;guard_target=user_id;counterpart_source=literal;", "terminal_guard_blocks_return:use=user;guard_kind=non_null;guard_target=user;counterpart_source=literal;"])))
    )
  emit issue code.UnboundAuthorizationTarget at call
}
