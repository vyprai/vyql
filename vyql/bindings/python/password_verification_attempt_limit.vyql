module bindings.python.password_verification_attempt_limit;

// An account-level password verifier -- `check_password`,
// `check_password_hash`, `verify_password`, or passlib's
// `pwd_context.verify`/`password_context.verify` -- answers one question:
// is this string the account's password. Django's `AbstractBaseUser`,
// werkzeug's `security` module, Flask-Security and passlib all document
// theirs as exactly that comparison, and nothing else. The comparison is
// cheap and the answer is a single bit, so wherever a caller can drive it
// with strings of its choosing, it can be driven at machine speed until
// the password is found.
//
// The login flow is where projects put the counterweight: a failed-attempt
// counter, a lockout check, a throttle. The documented frameworks route
// credential verification through a login routine that carries that
// machinery, or declare a throttle on the endpoint (DRF's
// `throttle_classes`, the `@ratelimit` decorator, a limiter). But a
// password re-verification wired into any other handler -- the
// change-password form, an account-settings confirmation, an unlock flow
// -- goes through the bare verifier, and unless the handler itself carries
// the attempt-limiting machinery, the endpoint inherits the brute-force
// surface without the countermeasure: the answer bit is handed out
// unlimited times to whoever can reach the route.
//
// The flagged shape is therefore a function whose own scope calls an
// account-level verifier while carrying no attempt-limiting machinery of
// its own. The machinery is read from the identifiers and calls the
// function actually contains -- failed-attempt counters, lockout and
// blocked checks, rate limits, throttles, cooldowns -- plus the throttle
// spellings a framework applies from outside the body: decorators
// (`@ratelimit`, `limiter.limit`) and class-level declarations
// (`throttle_classes=[`, `DEFAULT_THROTTLE_RATES`), which Python emits no
// structured token for and which are therefore matched, punctuation and
// all, against the enclosing class body's text. A function that verifies
// through its framework's login routine, or that throttles by any of
// these spellings, does not match; the raw verifier with none of them
// does, wherever it is wired.
binding passwordVerificationAttemptLimitRequired {
  query pattern presenceNode where node.scope == "function"
    and node.context.language == "python"
    and containsAny(node.context.callPath, ["check_password", "verify_password", "check_password_hash", "pwd_context.verify", "password_context.verify"])
    and not (containsAny(node.context.identifier, ["failed_login", "failed_attempt", "login_attempt", "attempt_count", "attempts_count", "max_attempts", "too_many_attempts", "too_many_requests", "is_blocked", "is_locked", "locked_out", "lockout", "lock_out", "blocked_until", "locked_until", "rate_limit", "ratelimit", "RateLimiter", "rateLimiter", "throttle", "limiter", "Limiter", "cooldown"]))
    and not (containsAny(node.context.decoratorPath, ["ratelimit", "limiter", "Limiter", "throttle"]))
    and not (containsAny(node.token, ["throttle_classes=[", "throttle_classes=(", "throttle_scope=", "get_throttles(", "DEFAULT_THROTTLE_CLASSES", "DEFAULT_THROTTLE_RATES", "@ratelimit"]))
  emit issue code.RateLimitRequiredOp at node
}
