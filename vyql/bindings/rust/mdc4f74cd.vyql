    }
  }
}

binding runTestsAutoApprovalExecutesCode143 {
  query pattern presenceNode where node.kind == "any" and node.analysis == "rust.run_tests_auto_approval_executes_code"
  emit issue code.RunTestsAutoApprovalExecutesCode at node
}

binding closureUnwindStaleLength {
  query pattern presenceNode where node.scope == "function" and node.context.language == "rust" and node.context.rustReview == "closure_unwind_stale_length"
  emit issue code.ClosureUnwindStaleLength at node
}

binding unpinImplMissingBound {
