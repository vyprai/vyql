  query pattern callExpr where callee.path ~= "check_ownership"
  emit check core.OwnershipCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

binding ownershipCheck142 {
  query pattern callExpr where callee.path ~= "require_owner"
  emit check core.OwnershipCheck at call {
    covers endpoint {
