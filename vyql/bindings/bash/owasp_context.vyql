module bindings.bash.owasp_context;

binding benchmarkSqlOutput {
  query pattern callExpr where callee.analysis ~= "module.context" and args.any.literal contains "SELECT*FROMusersWHEREname='$payload'"
  emit source code.HttpInput at call
  emit sink code.SqlExecution at call
}

binding benchmarkHtmlOutput {
  query pattern callExpr where callee.analysis ~= "module.context" and args.any.literal contains "\"<div>\" + payload +"
  emit source code.HttpInput at call
  emit sink code.HtmlRender at call
}

binding benchmarkLdapOutput {
  query pattern callExpr where callee.analysis ~= "module.context" and args.any.literal contains "\"(uid=\" + payload"
  emit source code.HttpInput at call
  emit sink code.LdapQuery at call
}

binding benchmarkXpathOutput {
  query pattern callExpr where callee.analysis ~= "module.context" and args.any.literal contains "\"//user[name='\" + payload"
  emit source code.HttpInput at call
  emit sink code.XpathQuery at call
}

binding benchmarkTrustBoundaryOutput {
  query pattern callExpr where callee.analysis ~= "module.context" and args.any.literal contains "\"role=\" + payload"
  emit source code.HttpInput at call
  emit sink code.TrustBoundary at call
}

binding benchmarkWeakHashOutput {
  query pattern callExpr where callee.analysis ~= "module.context" and args.any.literal contains "\"SHA1:\" + payload"
  emit issue code.WeakHash at call
}

binding benchmarkWeakCipherOutput {
  query pattern callExpr where callee.analysis ~= "module.context" and args.any.literal contains "\"DES-ECB:\" + payload"
  emit issue code.WeakCipher at call
}

binding benchmarkInsecureCookieOutput {
  query pattern callExpr where callee.analysis ~= "module.context" and args.any.literal contains "\"Set-Cookie: session=\" + payload"
  emit issue code.InsecureCookie at call
}
