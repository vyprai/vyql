module bindings.cpp.request_serialized_without_credential_mask;

// An HTTP request serializer whose signature takes a mask parameter
// defaults that parameter to off, so the plain call serializes
// authorization and proxy-authorization headers verbatim. Whether that
// is an exposure is decided by where the bytes go: the same unmasked
// call is correct on a debug dump, an IPC message or a cache-store
// write, and is a leak on a reply the client reads or a URL an error
// page embeds. The two anchors below are delivery calls rather than
// serialization calls for exactly that reason -- StoreEntry::
// replaceHttpReply installs the reply a client receives, and
// AnyP::Uri::Encode percent-encodes a buffer bound for a URL -- and
// each is required to sit in the same function as the serialization,
// so the channel and the unmasked bytes are one code path.
//
// The discriminator is the mask argument itself. The call_arg_at
// context token carries the serializer's argument list, and a second
// argument present means the caller passed the mask explicitly --
// `pack(&buf)` leaves `request.pack:1:` absent whatever the argument
// is spelled, so a variable, a constant and a defaulted call all read
// correctly. The serialization spellings are both accepted because the
// store-entry route serializes by handing the entry to the request
// (`request->swapOut(entry)`) while the buffer route packs into a
// caller-owned buffer, and a reply can be assembled from either.
//
// Reachable set, measured on the tree the shape was first seen in
// (Squid src/, 1406 files): exactly one function per anchor, the TRACE
// echo and the error-page mailto body, both of which stop matching once
// the mask is threaded. The remaining unmasked pack and packInto sites
// -- debug dumps, IPC, SNMP, HTCP and cache serialisation -- carry
// neither delivery call and are left standing. The anchors are absent
// from six other C and C++ trees (protobuf, qpdf, quassel, radare2,
// redis, wireshark), so the bindings report nothing there.

binding requestPackedIntoReplyWithoutMask {
  query pattern presenceNode where node.scope == "function" and node.context.language == "cpp" and node.context.callPath contains "replaceHttpReply" and containsAny(node.context.callPath, ["request.swapOut", "request.pack"]) and not (node.context.callArgAt contains "request.pack:1:")
  emit issue code.SensitiveDataInResponse at node
}

binding requestPackedIntoUrlWithoutMask {
  query pattern presenceNode where node.scope == "function" and node.context.language == "cpp" and node.context.callPath contains "Uri.Encode" and node.context.callPath contains "request.pack" and not (node.context.callArgAt contains "request.pack:1:")
  emit issue code.VerboseHttpErrorObjectDisclosure at node
}
