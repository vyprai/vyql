module bindings.go.delimiterJoinedCredentialComparison;

// net/http documents (*http.Request).Cookie as "Cookie returns the named cookie
// provided in the request" -- a value the client sends and can set to anything, so
// an equality test in a function that reads one is deciding whether request-supplied
// material matches server-held material: an authentication check.
//
// Joining several fields with a separator is not injective once any field may
// contain that separator: "a:b" + ":" + "c" and "a" + ":" + "b:c" are the same
// string. A check that compares the whole joined composite therefore proves only
// that the concatenations agree, not that the fields do, so a field carrying an
// extra separator shifts the boundaries and still compares equal. The construct is
// visible on the comparison itself: one operand is produced by a string
// concatenation that interleaves constant separators (code.Const feeding
// code.Format) with variable fields, whether the join is written inline or returned
// by a helper, while the other operand is the stored field being matched against.
//
// The documented way to take a delimited composite apart again is strings.Split,
// strings.SplitN or strings.Cut, and comparing the parts those return is what makes
// the check injective, so a scope that parses the stored value does not report.
binding goDelimiterJoinedCookieBoundCredentialComparison {
  query pattern presenceNode where node.kind == "binop" and node.op in ["==", "!="] and node.context.scopeCall contains ".Cookie" and not (containsAny(node.context.scopeCall, ["strings.Split", "strings.SplitN", "strings.SplitAfterN", "strings.Cut"])) and operand(node, where: operand.any contains "code.Format" and operand.any contains "code.Const") and operand(node, where: operand.any contains "code.Attr")
  emit issue code.DelimiterJoinedCredentialComparison at node
}
