module bindings.go.passwordResetTokenReplay;

// A password-reset finalisation handler has to answer one question before it
// writes the new credential: what proves this request is the one the reset mail
// authorised? Two answers are in wide use. Either the server issued a recovery
// record and the reset spends it -- looked up by its code (GetByCode,
// GetByToken, GetRecovery) and then deleted, consumed or marked used -- or the
// handler recomputes the token from a salt held in configuration and compares
// it against a value the request carries.
//
// The second answer is a bearer capability with no server-side existence, so
// there is nothing to invalidate: it stays valid for its whole embedded
// lifetime, for as many resets as it is presented for, including after the
// reset it was issued for has already changed the password. Configuration
// fields of this kind document themselves as the signing input for reset mail
// -- Mattermost's EmailSettings.PasswordResetSalt is "32 characters ... added
// to the signing of password reset emails" -- so a handler that reads one,
// compares a request-supplied hash against it and then writes a credential is
// authorising the write on a replayable token (CWE-640/CWE-294).
//
// Two shapes are not this. A change-password handler compares the account's
// own stored hash and writes back to the session's user, so it carries a
// Session selector and the credential it spends is not a mailed token. A reset
// that consumes a stored recovery record carries that store's own vocabulary in
// the same body; either form means the capability is revocable and neither
// reports.
binding goPasswordResetTokenReplay {
  query pattern presenceNode where node.scope == "function" and node.context.language == "go" and containsAny(node.context.call, ["UpdatePassword", "SetPassword", "ChangePassword", "UpdateUserPassword"]) and containsAny(node.context.call, ["ComparePassword", "CompareHashAndPassword", "ConstantTimeCompare", "ValidateSignature"]) and containsAny(node.context.identifier, ["PasswordResetSalt", "ResetPasswordSalt", "PasswordRecoverySalt", "ResetTokenSalt", "PasswordResetSecret", "ResetTokenSecret"]) and not (node.context.selector contains "Session.") and not containsAny(node.context.call, ["GetByCode", "GetByToken", "GetRecovery", "GetPasswordRecovery", "ConsumeToken", "InvalidateToken", "MarkTokenUsed", "DeleteToken", "DeleteRecovery"]) and not (node.context.callPath contains "PasswordRecovery")
  emit issue code.PasswordResetTokenReplay at node
}
