module bindings.powershell.owasp_output;

binding outputSqlExecution {
  query pattern callExpr where callee.path ~= "powershell.output" and args.any.literal contains "SELECT"
  emit sink code.SqlExecution at args[0]
}

binding outputHtmlRender {
  query pattern callExpr where callee.path ~= "powershell.output" and args.any.literal contains "<div>"
  emit sink code.HtmlRender at args[0]
}

binding outputLdapQuery {
  query pattern callExpr where callee.path ~= "powershell.output" and args.any.literal contains "(uid="
  emit sink code.LdapQuery at args[0]
}

binding outputXpathQuery {
  query pattern callExpr where callee.path ~= "powershell.output" and args.any.literal contains "//user"
  emit sink code.XpathQuery at args[0]
}

binding outputTrustBoundary {
  query pattern callExpr where callee.path ~= "powershell.output" and args.any.literal contains "role="
  emit sink code.TrustBoundary at args[0]
}

binding outputWeakHash {
  query pattern callExpr where callee.path ~= "powershell.output" and args.any.literal contains "SHA1:"
  emit issue code.WeakHash at call
}

binding outputWeakCipher {
  query pattern callExpr where callee.path ~= "powershell.output" and args.any.literal contains "DES-ECB:"
  emit issue code.WeakCipher at call
}

binding getRandomWeakRandom {
  query pattern callExpr where callee.path ~= "Get-Random"
  emit issue code.WeakRandomValue at call
}

binding outputInsecureCookie {
  query pattern callExpr where callee.path ~= "powershell.output" and args.any.literal contains "Set-Cookie: session=" and args.any.literal contains "payload"
  emit issue code.InsecureCookie at call
}

binding replaceHtmlEscape {
  query pattern callExpr where callee.method == "replace" and args.any.literal contains "&lt;"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}

binding splitPathCanonicalization {
  query pattern callExpr where callee.path ~= "Split-Path"
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
  }
}
