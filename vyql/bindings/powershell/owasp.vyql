module bindings.powershell.owasp;

binding invokeExpressionCommandExecution {
  query pattern callExpr where callee.path ~= "Invoke-Expression"
  emit sink code.CommandExecution at args[0]
}

binding replaceShellEscape {
  query pattern callExpr where callee.path ~= "powershell.replace" and args.any.literal contains "[^a-zA-Z0-9_.-]"
  emit check core.ShellEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}
