module bindings.java.native_object_stream_class_allowlist;

// java.io.ObjectInputStream reconstructs whatever classes the byte stream names,
// running their readObject/readResolve/finalize code as it goes; its own javadoc
// says a stream from an untrusted source must be read with a filter that limits
// the classes it may name (ObjectInputStream.setObjectInputFilter, or a
// resolveClass override rejecting everything outside a list). The shape labelled
// here is the one where that obligation is unavoidable and unowned: a method
// that takes the serialized bytes as a byte[] parameter, wraps them in a
// ByteArrayInputStream and reads the graph back with readObject/readUnshared. A
// helper of that shape decides nothing about where the bytes came from, so it
// carries the whole burden of bounding the class set for every caller, and its
// callers -- request parameters, cookies, cache entries, message payloads --
// routinely hand it bytes an attacker chose.
//
// The clauses together are what make this a blob decoder rather than
// ordinary Java serialization plumbing: a non-public helper has a closed caller
// set inside its own class, a stream opened over a file or a socket
// is reachable by taint from a labelled source and is VYQL-DESER-001's business,
// and a class's own private readObject(ObjectInputStream) hook takes the stream,
// not a byte[]. Whether the class set is bounded is the rule's question, not
// this binding's: the filter APIs below emit the control the rule consumes.

binding unrestrictedClassDeserialization900 {
  query pattern presenceNode where node.scope == "function" and node.context.functionModifier in ["public"] and node.context.paramType in ["byte"] and containsAny(node.context.callPath, ["ByteArrayInputStream"]) and containsAny(node.context.call, ["readObject", "readUnshared"])
  emit issue code.UnrestrictedClassDeserialization at node
}

// JEP 290's filter hooks and commons-io's ValidatingObjectInputStream are the
// documented ways to bound the class set an object stream may name: each rejects
// a class the reader did not accept before it is resolved. The filter is set on
// the stream rather than passed to the read, so it covers the lexical scope it
// runs in rather than one call's arguments.

binding safeDeserialization901 {
  query pattern callExpr where callee.path ~= "setObjectInputFilter"
  emit check core.SafeDeserialization at call {
    covers sameScope {
      anchor: call
    }
  }
}

binding safeDeserialization902 {
  query pattern callExpr where callee.path ~= "ObjectInputFilter.Config.createFilter"
  emit check core.SafeDeserialization at call {
    covers sameScope {
      anchor: call
    }
  }
}

binding safeDeserialization903 {
  query pattern callExpr where callee.path ~= "ValidatingObjectInputStream.accept"
  emit check core.SafeDeserialization at call {
    covers sameScope {
      anchor: call
    }
  }
}

// The other place the class set runs unbounded is the serialization hook
// itself. java.io.Serializable's contract names the JVM-invoked private
// readObject(ObjectInputStream) (and Externalizable's readExternal(ObjectInput)),
// and every value such a hook reads with s.readObject() is attacker-chosen
// whenever the stream is. A hook that resolves one of those values as a class
// name with Class.forName and instantiates the result -- newInstance directly
// or through a Constructor -- runs the constructor of whatever class the
// stream named, which is the same unrestricted-class-set obligation the blob
// decoders above carry, reached through reflection instead of through the
// stream's own class resolution. Class.isAssignableFrom, Class.isInstance and
// Class.asSubclass are the documented ways to bound the set before
// instantiating; a check applied to the constructed object does not bound it,
// because its constructor has already run, so only the Class-level checks
// neutralise this binding. Whether the bound is narrow enough is the rule's
// question, and the filter controls above are what the rule consumes.

binding unrestrictedClassDeserialization905 {
  query pattern presenceNode where node.scope == "function" and containsAny(node.context.functionName, ["readObject", "readExternal"]) and node.context.paramType contains "ObjectInput" and node.context.callPath contains "Class.forName" and node.context.callPath contains "newInstance" and not (containsAny(node.context.call, [isAssignableFrom, isInstance, asSubclass]))
  emit issue code.UnrestrictedClassDeserialization at node
}
