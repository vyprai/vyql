module bindings.java.filecredentials_file_name_storage;

// org.jenkinsci.plugins.plaincredentials.FileCredentials#getFileName() is the
// file name the credential's creator configured: plain-credentials stores it
// beside the secret bytes, and a credential is created by a user holding only
// Credentials/Create while the job that binds it runs somewhere that user
// cannot reach. The value is therefore stored configuration that happens to
// look like a file name -- it decides a path component wherever a binding
// materializes the secret, and the FilePath materialization calls are child
// (resolve a path relative to the directory), copyFrom (write content into
// the file) and unzipFrom (extract an archive into the directory).
//
// This labels a function that reads the credential's own file name and
// materializes storage under it while no call in that function reduces the
// value to a bare name first. That is the shape a traversal takes: the
// resolved path is <secret dir>/<whatever the credential carries>, so `..`
// segments in the stored name decide where the bytes land. The reductions
// listed as neutralising are the documented ones: java.io File#getName (the
// last name in the pathname's name sequence), commons-io FilenameUtils,
// Paths.get, canonicalisation, and component encoding. Any of them in the
// function means the name was reduced before it was joined.
//
// Residual, stated rather than hidden: the neutralising test is by call path,
// so a project that centralises the reduction in a helper of its own is
// recognised only when that helper hangs off the listed families. And the
// file-name read is keyed on the method name, so a different API's
// getFileName() in the same function as a FilePath materialization reads the
// same -- the storage side is what confines this to FilePath trees.
binding fileCredentialsFileNameStorage9207 {
  query pattern presenceNode where node.scope == "function" and node.context.callPath contains "getFileName" and containsAny(node.context.call, ["child", "copyFrom", "unzipFrom"]) and not (containsAny(node.context.callPath, ["getName", "FilenameUtils.", "Paths.get", "getBaseName", "getCanonicalPath", "getCanonicalFile", "toRealPath", "cleanPath", "normalize", "substringAfterLast", "URLEncoder.encode", "Util.rawEncode"]))
  emit issue code.UploadFilePathTraversalWrite at node
}
