module bindings.java.generated.mxmlentityresolver;

pattern bindingMetadata {
  binding: {
    name: "java"
    meta: {
      fidelity: "resolved"
      match: "contains"
    }
  }
}

binding xmlParseUnmarshal {
  query pattern callExpr where callee.method == "unmarshalHelper"
  emit sink code.XmlParse at args[0]
}
