module bindings.php.password_change_session_invalidation;

// A PHP password-change endpoint re-authenticates the caller by reading the
// submitted current_password field and hands the account to a Password-named
// credential write (changeClientPassword, changeAdminPassword, setPassword,
// ...): the person who completes the flow is whoever knew the old credential,
// and the new hash is stored by the delegated call. PHP's session controls
// are the vocabulary that invalidates the sessions minted against the old
// credential -- session_destroy() and session_regenerate_id() in the core,
// ->destroy()/->invalidate()/->regenerate() on a framework session object, a
// logout, an invalidateSession*/revoke* sweep, or a stored token-version /
// password-changed timestamp that outstanding tokens are checked against.
// Their absence means a session captured before the change keeps
// authenticating after it, which is what the account owner took the change
// to prevent.
//
// The function name and the current_password field name are the endpoint's
// own spelling of the flow (change_password/changePassword is the near
// universal action name; current_password is Laravel's documented field for
// "must match the user's current password"), and the capital-P Password
// fragment recognises the delegated camelCase credential write that stays in
// the endpoint. Residual, stated: a reset-from-link flow (no
// current_password, the caller is not yet authenticated) is not reported --
// the concept is the authenticated change; a revocation control spelled with
// a name outside the documented set is invisible, which is the
// false-negative direction; and session data cleared with flush() alone
// (which does not rotate the identifier) is deliberately NOT accepted as a
// control.
binding passwordChangeWithoutSessionInvalidation {
  query pattern presenceNode where node.scope == "function" and node.context.language == "php"
    and containsAny(node.context.functionName, ["change_password", "changePassword", "update_password", "updatePassword"])
    and containsAny(node.context.subscript, ["['current_password']", "[\"current_password\"]"])
    and containsAny(node.context.callPath, ["Password"])
    and not (containsAny(node.context.callPath, ["session_destroy", "session_regenerate_id", "session.destroy", "session.invalidate", "session.regenerate", "invalidateSession", "destroySession", "deleteAllSessions", "destroyAllSessions", "revokeAllTokens", "revokeAllSessions", "revokeRefreshTokens", "logout", "logOut"]))
    and not (containsAny(node.context.identifier, ["tokenVersion", "token_version", "sessionVersion", "session_version", "passwordChangedAt", "password_changed_at", "credentialsUpdatedAt", "tokensValidFrom"]))
  emit issue code.PasswordChangeWithoutSessionInvalidation at node
}
