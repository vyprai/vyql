module bindings.php.upload_content_scan_phar_stub;

binding uploadContentScanMissingPharStub {
  query pattern presenceNode where node.scope == "function" and node.context.language == "php" and node.token contains "tmp_name" and containsAny(node.context.callPath, ["fread", "fgets", "file_get_contents"]) and containsAny(node.token, ["call_arg_method:stristr:'<?php'", "call_arg_method:stristr:\"<?php\"", "call_arg_method:stripos:'<?php'", "call_arg_method:stripos:\"<?php\"", "call_arg_method:strstr:'<?php'", "call_arg_method:strstr:\"<?php\"", "call_arg_method:strpos:'<?php'", "call_arg_method:strpos:\"<?php\"", "call_arg_method:str_contains:'<?php'", "call_arg_method:str_contains:\"<?php\""]) and not (node.token contains "__HALT_COMPILER") and not (node.token contains "__halt_compiler")
  emit issue code.UploadContentScanMissingPharStub at node
}
