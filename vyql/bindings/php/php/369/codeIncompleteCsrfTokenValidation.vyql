module bindings.php.generated.mfbe84119;

binding incompleteCsrfTokenValidation369 {
  query pattern presenceNode where node.scope == "function" and node.context.language == "php" and node.context.name contains "restart" and node.token contains "delete_option" and node.token contains "$wpdb->query" and node.token contains "DELETE FROM" and not (node.token contains "check_admin_referer") and not (node.token contains "wp_verify_nonce")
  emit issue code.IncompleteCsrfTokenValidation at node
}
