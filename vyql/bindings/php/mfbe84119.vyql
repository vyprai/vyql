// A renderTwigTemplateWithLanguage-shaped method (the trait a Twig-based
// document renderer uses to render caller-selected templates) that calls
// $twig->render(...) with no SandboxExtension anywhere in its own body is
// the same structural gap already caught for Jinja2 (rank 661,
// code.IncompleteTemplateValidation / VYQL-INJ-024): a template environment
// that renders caller-authored templates was built and used with no
// sandbox, so a template's own markup can reach arbitrary methods and
// functions rather than only what a sandbox policy allows. Requiring the
// method body to be free of "SandboxExtension" keeps this from firing once
// the sandbox is wired up, regardless of where in the body it is added.
binding customTemplateRenderMissingSandbox474 {
  query pattern presenceNode where node.analysis == "function.context" and node.token contains "renderTwigTemplateWithLanguage" and node.token contains "$twig->render(" and not (node.token contains "SandboxExtension")
  emit issue code.IncompleteTemplateValidation at node
}

// A call that tests a string for the literal directory-traversal sequence
// "../" (via strstr, strpos, stripos, or the PHP 8 str_contains) and rejects
// the value when found is the textbook blacklist mitigation for path
// traversal that the PHP manual's own traversal-prevention examples show:
// check for the sequence, refuse the request if present, the same shape as
// an allow-listed template name or an isBelow() containment check already
// covers. It is a gate on the value, not a transform of it, so it is bound
// the same way as the existing in_array/isBelow endpoint checks rather than
// as a path rewrite.
binding pathAccessCheck475 {
  query pattern callExpr where callee.path ~= "strstr" and args.any.literal contains "../"
  emit check core.PathAccessCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

binding pathAccessCheck476 {
  query pattern callExpr where callee.path ~= "strpos" and args.any.literal contains "../"
  emit check core.PathAccessCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

binding pathAccessCheck477 {
  query pattern callExpr where callee.path ~= "stripos" and args.any.literal contains "../"
  emit check core.PathAccessCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

binding pathAccessCheck478 {
  query pattern callExpr where callee.path ~= "str_contains" and args.any.literal contains "../"
  emit check core.PathAccessCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

// A preg_match() pattern that carries both a "^" and a "$" is PCRE's own
// documented idiom for a full-string allowlist match rather than a
// substring search: the PHP manual's own filename-validation examples
// anchor the pattern this way precisely so preg_match cannot be satisfied
// by a match anywhere inside the subject. It is the allowlist counterpart
// of the "../" denylist checks above, gated the same way -- an endpoint
// guard, not a value transform.
binding pathAccessCheck479 {
  query pattern callExpr where callee.path ~= "preg_match" and args.any.literal contains "^" and args.any.literal contains "$"
  emit check core.PathAccessCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

// A PHP template whose markup a client-side template engine compiles -- an
// AngularJS or Vue directive attribute beside a `{{ ... }}` interpolation --
// and that echoes a request superglobal into that markup is the same
// structural gap already caught for Jinja2 and Twig
// (code.IncompleteTemplateValidation / VYQL-INJ-024): a template engine is
// handed caller-supplied template syntax with nothing making it inert. HTML
// escaping does not qualify here, because htmlspecialchars, strip_tags and
// json_encode all leave `{` and `}` alone while both engines evaluate
// `{{ ... }}` in text nodes and in attribute values; the documented remedy is
// to keep request data out of the compiled markup, so the token clears once the
// delimiters themselves are rewritten.
binding incompleteTemplateValidation480 {
  query pattern presenceNode where node.scope == "module" and node.context.language == "php" and node.context.phpReview == "client_template_interpolates_request_input"
  emit issue code.IncompleteTemplateValidation at node
}
