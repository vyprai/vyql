module bindings.php.upload_extension_denylist_missing_protected_extensions;

binding uploadExtensionDenylistMissingProtectedExtensions {
  query pattern presenceNode where node.scope == "function" and node.context.language == "php" and node.token contains "ExcludeExtension" and containsAny(node.token, ["call_arg_method:addValidator:'ExcludeExtension'", "call_arg_method:addValidator:\"ExcludeExtension\""]) and not (node.token contains "getProtectedFileExtensions") and not (node.token contains "NotProtectedExtension") and not containsAny(node.token, ["phtml", "phar", "php3", "php4", "php5", "php7"])
  emit issue code.IncompleteDangerousUploadExtensionBlocklist at node
}
