module bindings.php.script_login_untyped_cookie_credential;

// MantisBT's authentication API spells two things a login handler can drive.
// auth_user_id_from_cookie() / user_get_id_by_cookie() authenticate a secret by a
// database equality lookup on the user table's cookie_string column, and
// auth_attempt_script_login( $username, $password = null ) skips password
// validation altogether when it is called with no password -- its own contract.
// A handler that drives both is deciding identity from the lookup's result, so
// the value it looks up has to be a string before it is spent: a character
// column compared against a non-string bound parameter is coerced by the column,
// not by the parameter. A scalar type declaration on the parameters, an
// is_string() guard, strval() or settype() each pin it.
binding scriptLoginUntypedCookieCredential {
  query pattern presenceNode where node.scope == "function" and node.context.language == "php" and containsAny(node.context.callPath, ["auth_user_id_from_cookie", "user_get_id_by_cookie"]) and node.context.callPath contains "auth_attempt_script_login" and not (node.context.functionParamType contains "string") and not (containsAny(node.context.callPath, ["is_string", "strval", "settype"]))
  emit issue code.NonStringCredentialCoercionAuthBypass at node
}
