module bindings.c.generated.m2816daee;

binding cleartextChannel22 {
  requires {
    dependency("libcurl")
  }
  query pattern callExpr where callee.path ~= "curl_easy_setopt" and args.any.literal contains "http://" and not args.any.literal contains "127.0"
  emit issue code.CleartextChannel at call
}
