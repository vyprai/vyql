module bindings.objc.generated.m3f1906eb;

binding inputValidation0 {
  requires {
    dependency("Liferay-iOS-SDK")
  }
  query pattern callExpr where callee.method == "encodeURL"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}

