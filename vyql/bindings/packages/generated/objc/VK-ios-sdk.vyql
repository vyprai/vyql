module bindings.objc.generated.m8a869a50;

binding authenticationCheck0 {
  requires {
    dependency("VK-ios-sdk")
  }
  query pattern callExpr where callee.method == "authorize"
  emit check core.AuthenticationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

binding secretValue1 {
  requires {
    dependency("VK-ios-sdk")
  }
  query pattern callExpr where callee.method == "accessToken"
  emit source code.SecretValue at call.result
}

binding secretValue2 {
  requires {
    dependency("VK-ios-sdk")
  }
  query pattern callExpr where callee.method == "setAccessToken"
  emit source code.SecretValue at call.result
}

binding inputValidation3 {
  requires {
    dependency("VK-ios-sdk")
  }
  query pattern callExpr where callee.method == "processOpenURL"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
