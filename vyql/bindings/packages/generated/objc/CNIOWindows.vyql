module bindings.objc.generated.m7b0b866c;

binding networkSend0 {
  requires {
    dependency("CNIOWindows")
  }
  query pattern callExpr where callee.method == "CNIOWindows_sendmmsg"
  emit sink code.NetworkSend at args[0]
}

binding networkData1 {
  requires {
    dependency("CNIOWindows")
  }
  query pattern callExpr where callee.method == "CNIOWindows_recvmmsg"
  emit source code.NetworkData at call.result
}
