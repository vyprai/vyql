binding databaseRead0 {
  requires {
    dependency("couchbase-lite-ios")
  }
  query pattern callExpr where callee.method == "run:"
  emit sink code.DatabaseReadSink at args[0]
}

binding deserialization1 {
  requires {
    dependency("couchbase-lite-ios")
  }
  query pattern callExpr where callee.method == "validateJSONObject:"
  emit sink code.Deserialization at args[0]
}

