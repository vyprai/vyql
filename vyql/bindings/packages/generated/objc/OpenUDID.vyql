module bindings.objc.generated.m2a69cfe6;

binding secretValue0 {
  requires {
    dependency("OpenUDID")
  }
  query pattern callExpr where callee.method == "value"
  emit source code.SecretValue at call.result
}

binding secretValue1 {
  requires {
    dependency("OpenUDID")
  }
  query pattern callExpr where callee.method == "valueWithError"
  emit source code.SecretValue at call.result
}

binding inputValidation2 {
  requires {
    dependency("OpenUDID")
  }
  query pattern callExpr where callee.method == "setOptOut"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
