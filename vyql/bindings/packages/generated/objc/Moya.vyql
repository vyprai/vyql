module bindings.objc.generated.m5d49181c;

binding networkData0 {
  requires {
    dependency("Moya")
  }
  query pattern callExpr where callee.method == "stream"
  emit source code.NetworkData at call.result
}

binding networkSend1 {
  requires {
    dependency("Moya")
  }
  query pattern callExpr where callee.method == "add"
  emit sink code.NetworkSend at args[0]
}

binding filePathAccess2 {
  requires {
    dependency("Moya")
  }
  query pattern callExpr where callee.method == "let"
  emit sink code.FilePathAccess at args[0]
}

binding weakHash3 {
  requires {
    dependency("Moya")
  }
  query pattern presenceNode where node.path ~= "moya.hash"
  emit issue code.WeakHash at node
}
