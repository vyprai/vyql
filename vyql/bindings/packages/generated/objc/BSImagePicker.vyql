binding authorizationCheck0 {
  requires {
    dependency("BSImagePicker")
  }
  query pattern callExpr where callee.method == "authorize"
  emit check core.AuthorizationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

binding authorizationCheck1 {
  requires {
    dependency("BSImagePicker")
  }
  query pattern callExpr where callee.method == "requestAuthorization"
