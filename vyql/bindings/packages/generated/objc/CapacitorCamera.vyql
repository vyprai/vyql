module bindings.objc.generated.m77cc40e3;

binding userControlledData0 {
  requires {
    dependency("CapacitorCamera")
  }
  query pattern callExpr where callee.method == "presentSystemAppropriateImagePicker"
  emit source core.UserControlledData at call.result
}

binding fileUse1 {
  requires {
    dependency("CapacitorCamera")
  }
  query pattern callExpr where callee.method == "saveTemporaryImage"
  emit sink code.FileUseSink at args[0]
}
