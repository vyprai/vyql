module bindings.objc.generated.m15006c85;

binding inputValidation0 {
  requires {
    dependency("MASShortcut")
  }
  query pattern callExpr where callee.method == "isShortcutValid:"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}

