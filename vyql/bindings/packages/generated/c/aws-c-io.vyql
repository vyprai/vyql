module bindings.c.generated.m56be988b;

binding networkConnect0 {
  requires {
    dependency("aws-c-io")
  }
  query pattern callExpr where callee.method == "aws_socket_connect"
  emit sink code.NetworkConnectSink at args[0]
}

binding networkBind1 {
  requires {
    dependency("aws-c-io")
  }
  query pattern callExpr where callee.method == "aws_socket_bind"
  emit sink code.NetworkBind at args[0]
}

binding inputValidation2 {
  requires {
    dependency("aws-c-io")
  }
  query pattern callExpr where callee.method == "aws_sanitize_pem"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
