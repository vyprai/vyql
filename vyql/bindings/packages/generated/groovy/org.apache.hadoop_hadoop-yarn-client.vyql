module bindings.groovy.generated.m4b4a65da;

binding commandExecution0 {
  requires {
    dependency("org.apache.hadoop:hadoop-yarn-client")
  }
  query pattern callExpr where callee.method == "run"
  emit sink code.CommandExecution at args[0]
}

binding stdinInput1 {
  requires {
    dependency("org.apache.hadoop:hadoop-yarn-client")
  }
  query pattern callExpr where callee.method == "read"
  emit source code.StdinInput at call.result
}
