binding deserialization0 {
  requires {
    dependency("net.minidev:json-smart")
  }
  query pattern callExpr where callee.method == "parse"
  emit sink code.Deserialization at args[0]
}

binding htmlEscape1 {
  requires {
    dependency("net.minidev:json-smart")
  }
  query pattern callExpr where callee.method == "escape"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}
