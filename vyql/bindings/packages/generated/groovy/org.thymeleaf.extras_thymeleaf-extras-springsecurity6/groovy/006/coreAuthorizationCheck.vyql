module bindings.groovy.generated.m416a4aa4;

binding authorizationCheck6 {
  requires {
    dependency("org.thymeleaf.extras:thymeleaf-extras-springsecurity6")
  }
  query pattern callExpr where callee.method == "Authorization.url"
  emit check core.AuthorizationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}
