module bindings.groovy.generated.m26e066b8;

binding networkData0 {
  requires {
    dependency("io.netty:netty-buffer")
  }
  query pattern callExpr where callee.method == "ByteBufInputStream.read"
  emit source code.NetworkData at call.result
}

binding networkSend1 {
  requires {
    dependency("io.netty:netty-buffer")
  }
  query pattern callExpr where callee.method == "ByteBufOutputStream.write"
  emit sink code.NetworkSend at args[0]
}
