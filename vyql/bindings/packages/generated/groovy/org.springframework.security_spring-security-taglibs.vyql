module bindings.groovy.generated.m76731d1d;

binding authorizationCheck0 {
  requires {
    dependency("org.springframework.security:spring-security-taglibs")
  }
  query pattern callExpr where callee.method == "authorizeUsingUrlCheck"
  emit check core.AuthorizationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

binding htmlEscape1 {
  requires {
    dependency("org.springframework.security:spring-security-taglibs")
  }
  query pattern callExpr where callee.method == "setHtmlEscape"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}

binding csrfProtection2 {
  requires {
    dependency("org.springframework.security:spring-security-taglibs")
  }
  query pattern callExpr where callee.method == "handleToken"
  emit check core.CsrfProtection at call {
    covers endpoint {
      anchor: call
    }
  }
}
