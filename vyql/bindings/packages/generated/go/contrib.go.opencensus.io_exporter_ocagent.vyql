module bindings.go.generated.m364c6374;

binding networkSend0 {
  requires {
    dependency("contrib.go.opencensus.io/exporter/ocagent")
  }
  query pattern callExpr where callee.method == "WithHeaders"
  emit sink code.NetworkSend at args[0]
}

binding cleartextChannel1 {
  requires {
    dependency("contrib.go.opencensus.io/exporter/ocagent")
  }
  query pattern callExpr where callee.method == "WithInsecure"
  emit issue code.CleartextChannel at call
}

binding authenticationCheck2 {
  requires {
    dependency("contrib.go.opencensus.io/exporter/ocagent")
  }
  query pattern callExpr where callee.method == "WithTLSCredentials"
  emit check core.AuthenticationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}
