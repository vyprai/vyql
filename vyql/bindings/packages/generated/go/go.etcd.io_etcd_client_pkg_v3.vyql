module bindings.go.generated.m6bc05322;

binding filePathAccess0 {
  requires {
    dependency("go.etcd.io/etcd/client/pkg/v3")
  }
  query pattern callExpr where callee.method == "OpenDir"
  emit sink code.FilePathAccess at args[0]
}

binding pathCanonicalization1 {
  requires {
    dependency("go.etcd.io/etcd/client/pkg/v3")
  }
  query pattern callExpr where callee.method == "CanonicalURLPath"
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
  }
}
