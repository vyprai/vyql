binding pathCanonicalization0 {
  requires {
    dependency("github.com/opencontainers/runtime-tools")
  }
  query pattern callExpr where callee.method == "Abs"
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
  }
}

