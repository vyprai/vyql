module bindings.ruby.generated.me5149708;

binding shellEscape0 {
  requires {
    dependency("grit")
  }
  query pattern callExpr where callee.method == "shell_escape"
  emit check core.ShellEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}

binding commandExecution1 {
  requires {
    dependency("grit")
  }
  query pattern callExpr where callee.method == "run"
  emit sink code.CommandExecution at args[0]
}
