module bindings.ruby.generated.mf7df03c8;

binding authorizationCheck0 {
  requires {
    dependency("cancan")
  }
  query pattern callExpr where callee.method == "can"
  emit check core.AuthorizationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

