module bindings.ruby.generated.m34e3f5af;

binding codeEval0 {
  requires {
    dependency("sdoc")
  }
  query pattern callExpr where callee.method == "eval_template"
  emit sink code.CodeEval at args[0]
}

binding codeEval1 {
  requires {
    dependency("sdoc")
  }
  query pattern callExpr where callee.method == "render_template"
  emit sink code.CodeEval at args[0]
}

binding htmlEscape2 {
  requires {
    dependency("sdoc")
  }
  query pattern callExpr where callee.method == "strip_tags"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}
