module bindings.ruby.generated.m4ae0f6f1;

binding networkSend0 {
  requires {
    dependency("twilio-ruby")
  }
  query pattern callExpr where callee.method == "send"
  emit sink code.NetworkSend at args[0]
}

binding inputValidation1 {
  requires {
    dependency("twilio-ruby")
  }
  query pattern callExpr where callee.method == "validate"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
