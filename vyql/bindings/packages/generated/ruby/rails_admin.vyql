module bindings.ruby.generated.m68f6610f;

binding authenticationCheck0 {
  requires {
    dependency("rails_admin")
  }
  query pattern callExpr where callee.method == "authenticate_with"
  emit check core.AuthenticationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

binding authorizationCheck1 {
  requires {
    dependency("rails_admin")
  }
  query pattern callExpr where callee.method == "authorize_with"
  emit check core.AuthorizationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

binding secretValue2 {
  requires {
    dependency("rails_admin")
  }
  query pattern callExpr where callee.method == "current_user_method"
  emit source code.SecretValue at call.result
}
