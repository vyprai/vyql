module bindings.ruby.generated.m6eb0dab2;

binding networkSend0 {
  requires {
    dependency("net-smtp")
  }
  query pattern callExpr where callee.method == "send_message"
  emit sink code.NetworkSend at args[0]
}

binding networkSend1 {
  requires {
    dependency("net-smtp")
  }
  query pattern callExpr where callee.method == "data"
  emit sink code.NetworkSend at args[0]
}

binding authenticationCheck2 {
  requires {
    dependency("net-smtp")
  }
  query pattern callExpr where callee.method == "authenticate"
  emit check core.AuthenticationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}
