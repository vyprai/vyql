module bindings.ruby.generated.m46b2b4d8;

binding commandExecution0 {
  requires {
    dependency("net-ssh")
  }
  query pattern callExpr where callee.method == "exec"
  emit sink code.CommandExecution at args[0]
}

binding networkData1 {
  requires {
    dependency("net-ssh")
  }
  query pattern callExpr where callee.method == "read"
  emit source code.NetworkData at call.result
}

binding networkSend2 {
  requires {
    dependency("net-ssh")
  }
  query pattern callExpr where callee.method == "send"
  emit sink code.NetworkSend at args[0]
}

binding networkConnect3 {
  requires {
    dependency("net-ssh")
  }
  query pattern callExpr where callee.method == "connection"
  emit sink code.NetworkConnectSink at args[0]
}
