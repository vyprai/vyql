module bindings.ruby.generated.m0dfe475d;

binding htmlEscape0 {
  requires {
    dependency("actionview")
  }
  query pattern callExpr where callee.method == "sanitize"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}

