module bindings.ruby.generated.m1f3e101e;

binding deserialization0 {
  requires {
    dependency("creole")
  }
  query pattern callExpr where callee.method == "creolize"
  emit sink code.Deserialization at args[0]
}

binding htmlEscape1 {
  requires {
    dependency("creole")
  }
  query pattern callExpr where callee.method == "escape_html"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}

binding inputValidation2 {
  requires {
    dependency("creole")
  }
  query pattern callExpr where callee.method == "escape_url"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
