module bindings.ruby.generated.m40df21f5;

binding httpInput0 {
  requires {
    dependency("rack-openid")
  }
  query pattern callExpr where callee.method == "call"
  emit source code.HttpInput at call.result
}

binding inputValidation1 {
  requires {
    dependency("rack-openid")
  }
  query pattern callExpr where callee.method == "sanitize_params!"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}

binding authenticationCheck2 {
  requires {
    dependency("rack-openid")
  }
  query pattern callExpr where callee.method == "authenticate_session"
  emit check core.AuthenticationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

binding storedDataRead3 {
  requires {
    dependency("rack-openid")
  }
  query pattern callExpr where callee.method == "session"
  emit source code.StoredDataRead at call.result
