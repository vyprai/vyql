module bindings.python.generated.m457fbe87;

binding networkSend0 {
  requires {
    dependency("pyfcm")
  }
  query pattern callExpr where callee.method == "notify"
  emit sink code.NetworkSend at args[0]
}

binding networkSend1 {
  requires {
    dependency("pyfcm")
  }
  query pattern callExpr where callee.method == "async_notify_multiple_devices"
  emit sink code.NetworkSend at args[0]
}
