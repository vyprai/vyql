module bindings.python.generated.m69de2c61;

binding cliArgument0 {
  requires {
    dependency("awscli")
  }
  query pattern callExpr where callee.method == "parse"
  emit source code.CliArgument at call.result
}

binding shellEscape1 {
  requires {
    dependency("awscli")
  }
  query pattern callExpr where callee.method == "compat_shell_quote"
  emit check core.ShellEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}
