module bindings.python.generated.ma2b95db9;

binding csrfProtection0 {
  requires {
    dependency("flask-wtf")
  }
  query pattern callExpr where callee.method == "validate_csrf"
  emit check core.CsrfProtection at call {
    covers endpoint {
      anchor: call
    }
  }
}

binding csrfProtection1 {
  requires {
    dependency("flask-wtf")
  }
  query pattern callExpr where callee.method == "csrf_protect"
  emit check core.CsrfProtection at call {
    covers endpoint {
      anchor: call
    }
  }
}

binding inputValidation2 {
  requires {
    dependency("flask-wtf")
  }
  query pattern callExpr where callee.method == "same_origin"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}

binding userControlledData3 {
  requires {
    dependency("flask-wtf")
  }
  query pattern callExpr where callee.method == "process_formdata"
  emit source core.UserControlledData at call.result
}
