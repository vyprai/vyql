module bindings.python.generated.m19bab4be;

binding filePathAccess0 {
  requires {
    dependency("pydocstyle")
  }
  query pattern callExpr where callee.method == "read"
  emit sink code.FilePathAccess at args[0]
}

binding cliArgument1 {
  requires {
    dependency("pydocstyle")
  }
  query pattern callExpr where callee.method == "run_pydocstyle"
  emit source code.CliArgument at call.result
}
