binding filePathAccess0 {
  requires {
    dependency("pyopenssl")
  }
  query pattern callExpr where callee.method == "use_privatekey_file"
  emit sink code.FilePathAccess at args[0]
}

binding filePathAccess1 {
  requires {
    dependency("pyopenssl")
  }
  query pattern callExpr where callee.method == "use_certificate_file"
  emit sink code.FilePathAccess at args[0]
}

binding inputValidation2 {
  requires {
    dependency("pyopenssl")
  }
  query pattern callExpr where callee.method == "load_verify_locations"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
