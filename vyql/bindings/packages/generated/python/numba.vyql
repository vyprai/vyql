  query pattern callExpr where callee.path ~= "subprocess.run"
  emit sink code.CommandExecution at args[0]
}

binding commandExecution1 {
  requires {
    dependency("numba")
  }
  query pattern callExpr where callee.method == "run_command"
  emit sink code.CommandExecution at args[0]
}
