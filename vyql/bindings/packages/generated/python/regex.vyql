binding regexCompile0 {
  requires {
    dependency("regex")
  }
  query pattern callExpr where callee.method == "compile"
  emit issue code.RegexCompile at call
  emit sink code.RegexCompileSink at call
}

binding inputValidation1 {
  requires {
    dependency("regex")
  }
  query pattern callExpr where callee.method == "escape"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
