module bindings.python.generated.m9b6216be;

binding deserialization0 {
  requires {
    dependency("pyxdg")
  }
  query pattern callExpr where callee.method == "parse"
  emit sink code.Deserialization at args[0]
}

binding filePathAccess1 {
  requires {
    dependency("pyxdg")
  }
  query pattern callExpr where callee.method == "write"
  emit sink code.FilePathAccess at args[0]
}

binding inputValidation2 {
  requires {
    dependency("pyxdg")
  }
  query pattern callExpr where callee.method == "validate"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
