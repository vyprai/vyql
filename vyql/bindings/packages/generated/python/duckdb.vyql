module bindings.python.generated.m0f9e9c43;

binding sqlExecution0 {
  requires {
    dependency("duckdb")
  }
  query pattern callExpr where callee.method == "Query"
  emit sink code.SqlExecution at args[0]
}

binding sqlParameterization1 {
  requires {
    dependency("duckdb")
  }
  query pattern callExpr where callee.method == "parameters"
  emit check core.SqlParameterization at call {
    covers path {
      from: call
      to: call
    }
  }
}

binding deserialization2 {
  requires {
    dependency("duckdb")
  }
  query pattern callExpr where callee.method == "read"
  emit sink code.Deserialization at args[0]
}
