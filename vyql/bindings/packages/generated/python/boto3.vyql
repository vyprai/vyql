binding fileUpload0 {
  requires {
    dependency("boto3")
  }
  query pattern callExpr where callee.method == "upload_file"
  emit issue code.FileUpload at call
  emit source code.FileUploadSource at call
}

binding fileUpload1 {
  requires {
    dependency("boto3")
  }
  query pattern callExpr where callee.method == "upload_fileobj"
  emit issue code.FileUpload at call
  emit source code.FileUploadSource at call
}

