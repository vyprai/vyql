module bindings.python.generated.m429c74e7;

binding networkSend0 {
  requires {
    dependency("pyusb")
  }
  query pattern callExpr where callee.method == "write"
  emit sink code.NetworkSend at args[0]
}

binding networkData1 {
  requires {
    dependency("pyusb")
  }
  query pattern callExpr where callee.method == "read"
  emit source code.NetworkData at call.result
}

binding networkSend2 {
  requires {
    dependency("pyusb")
  }
  query pattern callExpr where callee.method == "ctrl_transfer"
  emit sink code.NetworkSend at args[0]
}
