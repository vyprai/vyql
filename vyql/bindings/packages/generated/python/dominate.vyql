module bindings.python.generated.mecd2f6e9;

binding commandExecution0 {
  requires {
    dependency("dominate")
  }
  query pattern callExpr where callee.method == "system"
  emit sink code.CommandExecution at args[0]
}

binding htmlEscape1 {
  requires {
    dependency("dominate")
  }
  query pattern callExpr where callee.method == "escape"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}
