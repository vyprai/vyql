module bindings.python.generated.m3daaaeef;

binding secretValue0 {
  requires {
    dependency("firebase-admin")
  }
  query pattern callExpr where callee.method == "create_custom_token"
  emit source code.SecretValue at call.result
}

binding authenticationCheck1 {
  requires {
    dependency("firebase-admin")
  }
  query pattern callExpr where callee.method == "verify_id_token"
  emit check core.AuthenticationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

