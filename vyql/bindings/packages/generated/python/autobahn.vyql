module bindings.python.generated.m0d97c43e;

binding networkData0 {
  requires {
    dependency("autobahn")
  }
  query pattern callExpr where callee.method == "onMessage"
  emit source code.NetworkData at call.result
}

binding networkSend1 {
  requires {
    dependency("autobahn")
  }
  query pattern callExpr where callee.method == "send"
  emit sink code.NetworkSend at args[0]
}

binding networkConnect2 {
  requires {
    dependency("autobahn")
  }
  query pattern callExpr where callee.method == "abortConnection"
  emit sink code.NetworkConnectSink at args[0]
}
