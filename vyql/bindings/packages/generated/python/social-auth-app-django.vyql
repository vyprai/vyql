module bindings.python.generated.mf95c8770;

binding authenticationCheck0 {
  requires {
    dependency("social-auth-app-django")
  }
  query pattern callExpr where callee.method == "authenticate"
  emit check core.AuthenticationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

binding storedDataRead1 {
  requires {
    dependency("social-auth-app-django")
  }
  query pattern callExpr where callee.method == "session"
  emit source code.StoredDataRead at call.result
}

binding storedDataWrite2 {
  requires {
    dependency("social-auth-app-django")
  }
  query pattern callExpr where callee.method == "session"
  emit sink code.StoredDataWrite at args[0]
}

binding redirectTarget3 {
  requires {
    dependency("social-auth-app-django")
  }
  query pattern callExpr where callee.method == "redirect"
  emit issue code.RedirectTarget at call
  emit sink code.RedirectTargetSink at call
