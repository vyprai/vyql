binding networkConnect0 {
  requires {
    dependency("tweepy")
  }
  query pattern callExpr where callee.method == "API.request"
  emit sink code.NetworkConnectSink at args[0]
}

binding networkSend1 {
  requires {
    dependency("tweepy")
  }
  query pattern callExpr where callee.method == "API.request"
  emit sink code.NetworkSend at args[0]
}

binding authenticationCheck2 {
  requires {
    dependency("tweepy")
  }
  query pattern callExpr where callee.method == "API.request"
  emit check core.AuthenticationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}
