module bindings.python.generated.mac4e01b5;

binding authenticationCheck0 {
  requires {
    dependency("djangorestframework-simplejwt")
  }
  query pattern callExpr where callee.method == "authenticate"
  emit check core.AuthenticationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

binding deserialization1 {
  requires {
    dependency("djangorestframework-simplejwt")
  }
  query pattern callExpr where callee.method == "decode"
  emit sink code.Deserialization at args[0]
}

binding authenticationCheck2 {
  requires {
    dependency("djangorestframework-simplejwt")
  }
  query pattern callExpr where callee.method == "check_blacklist"
  emit check core.AuthenticationCheck at call {
    covers endpoint {
