binding httpInput0 {
  requires {
    dependency("django-ckeditor")
  }
  query pattern callExpr where callee.method == "ckeditor_uploader.views.post"
  emit source code.HttpInput at call.result
}

binding fileUpload1 {
  requires {
    dependency("django-ckeditor")
  }
  query pattern callExpr where callee.method == "ckeditor_uploader.views.post"
  emit issue code.FileUpload at call
