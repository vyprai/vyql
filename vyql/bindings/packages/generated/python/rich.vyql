module bindings.python.generated.m7f5f6fe8;

binding htmlEscape0 {
  requires {
    dependency("rich")
  }
  query pattern callExpr where callee.method == "escape"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}

binding inputValidation1 {
  requires {
    dependency("rich")
  }
  query pattern callExpr where callee.method == "parse"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
