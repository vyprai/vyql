binding pathCanonicalization0 {
  requires {
    dependency("w3lib")
  }
  query pattern callExpr where callee.method == "canonicalize_url"
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
  }
}

