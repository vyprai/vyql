module bindings.python.generated.m045e3ddb;

binding userControlledData0 {
  requires {
    dependency("pytest-pythonpath")
  }
  query pattern callExpr where callee.method == "pytest_addoption"
  emit source core.UserControlledData at call.result
}

binding filePathAccess1 {
  requires {
    dependency("pytest-pythonpath")
  }
  query pattern callExpr where callee.method == "pytest_load_initial_conftests"
  emit sink code.FilePathAccess at args[0]
}
