module bindings.python.generated.m4954436b;

binding authenticationCheck0 {
  requires {
    dependency("anaconda-client")
  }
  query pattern callExpr where callee.method == "authenticate"
  emit check core.AuthenticationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

binding urlFetch1 {
  requires {
    dependency("anaconda-client")
  }
  query pattern callExpr where callee.method == "download"
  emit sink code.UrlFetch at args[0]
}
