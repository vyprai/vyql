module bindings.python.generated.ma7acf84c;

binding commandExecution0 {
  requires {
    dependency("pywinpty")
  }
  query pattern callExpr where callee.method == "spawn"
  emit sink code.CommandExecution at args[0]
}

binding userControlledData1 {
  requires {
    dependency("pywinpty")
  }
  query pattern callExpr where callee.method == "read"
  emit source core.UserControlledData at call.result
}

binding stdinInput2 {
  requires {
    dependency("pywinpty")
  }
  query pattern callExpr where callee.method == "write"
  emit source code.StdinInput at call.result
}
