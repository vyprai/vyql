binding networkSend0 {
  requires {
    dependency("fcm-django")
  }
  query pattern callExpr where callee.method == "send_message"
  emit sink code.NetworkSend at args[0]
}

binding networkSend1 {
  requires {
    dependency("fcm-django")
  }
  query pattern callExpr where callee.method == "send_messages"
  emit sink code.NetworkSend at args[0]
}

binding inputValidation2 {
  requires {
    dependency("fcm-django")
  }
  query pattern callExpr where callee.method == "validate"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
