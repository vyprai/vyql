module bindings.python.generated.md7c15f32;

binding deserialization0 {
  requires {
    dependency("ninja")
  }
  query pattern callExpr where callee.method == "parse"
  emit sink code.Deserialization at args[0]
}

binding shellEscape1 {
  requires {
    dependency("ninja")
  }
  query pattern callExpr where callee.method == "escape"
  emit check core.ShellEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}
