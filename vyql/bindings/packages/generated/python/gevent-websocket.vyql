module bindings.python.generated.m2e706cc9;

binding networkData0 {
  requires {
    dependency("gevent-websocket")
  }
  query pattern callExpr where callee.method == "read_message"
  emit source code.NetworkData at call.result
}

binding networkSend1 {
  requires {
    dependency("gevent-websocket")
  }
  query pattern callExpr where callee.method == "send"
  emit sink code.NetworkSend at args[0]
}

binding inputValidation2 {
  requires {
    dependency("gevent-websocket")
  }
  query pattern callExpr where callee.method == "validate"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
