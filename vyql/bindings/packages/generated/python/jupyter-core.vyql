module bindings.python.generated.m2386b237;

binding commandExecution0 {
  requires {
    dependency("jupyter-core")
  }
  query pattern callExpr where callee.method == "launch_instance"
  emit sink code.CommandExecution at args[0]
}

binding fileUse1 {
  requires {
    dependency("jupyter-core")
  }
  query pattern callExpr where callee.method == "secure_write"
  emit sink code.FileUseSink at args[0]
}

binding inputValidation2 {
  requires {
    dependency("jupyter-core")
  }
  query pattern callExpr where callee.method == "secure_write"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
