module bindings.python.generated.mf4a7c720;

binding filePathAccess0 {
  requires {
    dependency("sphinxcontrib-devhelp")
  }
  query pattern callExpr where callee.method == "build_devhelp"
  emit sink code.FilePathAccess at args[0]
}

binding urlFetch1 {
  requires {
    dependency("sphinxcontrib-devhelp")
  }
  query pattern callExpr where callee.method == "write_toc"
  emit sink code.UrlFetch at args[0]
}
