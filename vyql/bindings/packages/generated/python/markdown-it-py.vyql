binding deserialization0 {
  requires {
    dependency("markdown-it-py")
  }
  query pattern callExpr where callee.method == "parse"
  emit sink code.Deserialization at args[0]
}

binding deserialization1 {
  requires {
    dependency("markdown-it-py")
  }
  query pattern callExpr where callee.method == "parseInline"
  emit sink code.Deserialization at args[0]
}

binding htmlRender2 {
  requires {
    dependency("markdown-it-py")
  }
  query pattern callExpr where callee.method == "render"
