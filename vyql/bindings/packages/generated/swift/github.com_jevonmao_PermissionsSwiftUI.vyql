module bindings.swift.generated.m6811125b;

binding authorizationCheck0 {
  requires {
    dependency("github.com/jevonmao/PermissionsSwiftUI")
  }
  query pattern callExpr where callee.method == "requestPermission"
  emit check core.AuthorizationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

