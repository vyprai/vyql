module bindings.java.generated.m8a3460e9;

binding networkSend0 {
  requires {
    dependency("org.eclipse.paho:org.eclipse.paho.client.mqttv3")
  }
  query pattern callExpr where callee.method == "publish"
  emit sink code.NetworkSend at args[0]
}

binding networkData1 {
  requires {
    dependency("org.eclipse.paho:org.eclipse.paho.client.mqttv3")
  }
  query pattern callExpr where callee.method == "subscribe"
  emit source code.NetworkData at call.result
}

binding inputValidation2 {
  requires {
    dependency("org.eclipse.paho:org.eclipse.paho.client.mqttv3")
  }
  query pattern callExpr where callee.method == "validate"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
