binding networkSend0 {
  requires {
    dependency("io.dropwizard.metrics:metrics-graphite")
  }
  query pattern callExpr where callee.method == "send"
  emit sink code.NetworkSend at args[0]
}

binding networkConnect1 {
  requires {
    dependency("io.dropwizard.metrics:metrics-graphite")
  }
  query pattern callExpr where callee.method == "connect"
  emit sink code.NetworkConnectSink at args[0]
}

binding inputValidation2 {
  requires {
    dependency("io.dropwizard.metrics:metrics-graphite")
  }
  query pattern callExpr where callee.method == "sanitize"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
