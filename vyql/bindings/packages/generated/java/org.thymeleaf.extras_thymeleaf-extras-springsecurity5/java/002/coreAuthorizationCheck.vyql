module bindings.java.generated.m299dbf4d;

binding authorizationCheck2 {
  requires {
    dependency("org.thymeleaf.extras:thymeleaf-extras-springsecurity5")
  }
  query pattern callExpr where callee.method == "authorizeUsingAccessControlList"
  emit check core.AuthorizationCheck at call {
    covers endpoint {
      anchor: call
    }
