binding authenticationCheck0 {
  requires {
    dependency("Atompub")
  }
  query pattern callExpr where callee.method == "authenticate"
  emit check core.AuthenticationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

binding userControlledData1 {
  requires {
    dependency("Atompub")
  }
  query pattern callExpr where callee.method == "get_auth_info"
  emit source core.UserControlledData at call.result
}
