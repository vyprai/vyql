module bindings.perl.generated.m1fa597e9;

binding filePathAccess0 {
  requires {
    dependency("Poet")
  }
  query pattern callExpr where callee.method == "read_file"
  emit sink code.FilePathAccess at args[0]
}

binding htmlEscape1 {
  requires {
    dependency("Poet")
  }
  query pattern callExpr where callee.method == "html_escape"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}
