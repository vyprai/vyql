binding redirectTarget0 {
  requires {
    dependency("OX")
  }
  query pattern callExpr where callee.method == "uri_for"
  emit issue code.RedirectTarget at call
  emit sink code.RedirectTargetSink at call
}

binding pathCanonicalization1 {
  requires {
    dependency("OX")
  }
  query pattern callExpr where callee.method == "canonicalize_path"
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
  }
}
