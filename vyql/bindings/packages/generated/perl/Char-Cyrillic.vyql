module bindings.perl.generated.md5b2a6ed;

binding commandExecution0 {
  requires {
    dependency("Char-Cyrillic")
  }
  query pattern callExpr where callee.method == "_systemx"
  emit sink code.CommandExecution at args[0]
}

binding shellEscape1 {
  requires {
    dependency("Char-Cyrillic")
  }
  query pattern callExpr where callee.method == "_escapeshellcmd"
  emit check core.ShellEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}

