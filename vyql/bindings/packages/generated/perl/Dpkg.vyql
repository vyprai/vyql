module bindings.perl.generated.m9783b49f;

binding commandExecution0 {
  requires {
    dependency("Dpkg")
  }
  query pattern callExpr where callee.method == "exec"
  emit sink code.CommandExecution at args[0]
}

binding commandExecution1 {
  requires {
    dependency("Dpkg")
  }
  query pattern callExpr where callee.method == "spawn"
  emit sink code.CommandExecution at args[0]
}

binding userControlledData2 {
  requires {
    dependency("Dpkg")
  }
  query pattern callExpr where callee.method == "parse"
  emit source core.UserControlledData at call.result
}

binding filePathAccess3 {
  requires {
    dependency("Dpkg")
  }
  query pattern callExpr where callee.method == "open"
  emit sink code.FilePathAccess at args[0]
}

binding pathCanonicalization4 {
  requires {
    dependency("Dpkg")
  }
  query pattern callExpr where callee.method == "canonpath"
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
  }
}
