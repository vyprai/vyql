module bindings.perl.generated.m8cbcb66c;

binding inputValidation2 {
  requires {
    dependency("Apache2-WebApp-Plugin-Validate")
  }
  query pattern callExpr where callee.method == "date_is_future"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
