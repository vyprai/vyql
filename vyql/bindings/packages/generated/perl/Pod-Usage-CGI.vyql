module bindings.perl.generated.m1ea35854;

binding userControlledData0 {
  requires {
    dependency("Pod-Usage-CGI")
  }
  query pattern callExpr where callee.method == "pod2usage"
  emit source core.UserControlledData at call.result
}

binding htmlEscape1 {
  requires {
    dependency("Pod-Usage-CGI")
  }
  query pattern callExpr where callee.method == "_html_escape"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}
