module bindings.rust.generated.m953cfa5f;

binding filePathAccess0 {
  requires {
    dependency("vcpkg")
  }
  query pattern callExpr where callee.method == "find_vcpkg_root"
  emit sink code.FilePathAccess at args[0]
}

binding pathAccessCheck1 {
  requires {
    dependency("vcpkg")
  }
  query pattern callExpr where callee.method == "validate_vcpkg_root"
  emit check core.PathAccessCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}
