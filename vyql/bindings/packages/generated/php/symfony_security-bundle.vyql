module bindings.php.generated.m190c713b;

binding authenticationCheck0 {
  requires {
    dependency("symfony/security-bundle")
  }
  query pattern callExpr where callee.method == "login"
  emit check core.AuthenticationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

binding authenticationCheck1 {
  requires {
    dependency("symfony/security-bundle")
  }
  query pattern callExpr where callee.method == "logout"
  emit check core.AuthenticationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}

binding csrfProtection2 {
  requires {
    dependency("symfony/security-bundle")
  }
  query pattern callExpr where callee.method == "logout"
  emit check core.CsrfProtection at call {
    covers endpoint {
      anchor: call
    }
  }
}

binding secretValue3 {
  requires {
    dependency("symfony/security-bundle")
  }
  query pattern callExpr where callee.method == "getToken"
  emit source code.SecretValue at call.result
}
