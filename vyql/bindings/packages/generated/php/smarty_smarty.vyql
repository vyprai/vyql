module bindings.php.generated.m9cc235f9;

binding templateRender0 {
  requires {
    dependency("smarty/smarty")
  }
  query pattern callExpr where callee.method == "fetch"
  emit sink code.TemplateRender at args[0]
}

binding templateRender1 {
  requires {
    dependency("smarty/smarty")
  }
  query pattern callExpr where callee.method == "display"
  emit sink code.TemplateRender at args[0]
}

binding inputValidation2 {
  requires {
    dependency("smarty/smarty")
  }
  query pattern callExpr where callee.method == "sanitize"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
