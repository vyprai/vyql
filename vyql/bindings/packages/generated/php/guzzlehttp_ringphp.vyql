module bindings.php.generated.ma476dac8;

binding networkConnect0 {
  requires {
    dependency("guzzlehttp/ringphp")
  }
  query pattern callExpr where callee.method == "curl_setopt_array"
  emit sink code.NetworkConnectSink at args[0]
}

binding networkSend1 {
  requires {
    dependency("guzzlehttp/ringphp")
  }
  query pattern callExpr where callee.method == "curl_setopt_array"
  emit sink code.NetworkSend at args[0]
}

binding networkData2 {
  requires {
    dependency("guzzlehttp/ringphp")
  }
  query pattern callExpr where callee.method == "createResponse"
  emit source code.NetworkData at call.result
}
