module bindings.php.generated.mac7238f3;

binding inputValidation0 {
  requires {
    dependency("spatie/laravel-backup")
  }
  query pattern callExpr where callee.method == "FileSelection::sanitize"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}

binding filePathAccess1 {
  requires {
    dependency("spatie/laravel-backup")
  }
  query pattern callExpr where callee.path ~= "file_put_contents"
  emit sink code.FilePathAccess at args[0]
}
