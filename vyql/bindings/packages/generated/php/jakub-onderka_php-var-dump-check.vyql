module bindings.php.generated.m20758425;

binding cliArgument0 {
  requires {
    dependency("jakub-onderka/php-var-dump-check")
  }
  query pattern callExpr where callee.method == "JakubOnderkaPhpVarDumpCheckSettings::parseArguments"
  emit source code.CliArgument at call.result
}

binding filePathAccess1 {
  requires {
    dependency("jakub-onderka/php-var-dump-check")
  }
  query pattern callExpr where callee.method == "JakubOnderkaPhpVarDumpCheckManager::checkFile"
  emit sink code.FilePathAccess at args[0]
}

binding filePathAccess2 {
  requires {
    dependency("jakub-onderka/php-var-dump-check")
  }
  query pattern callExpr where callee.method == "JakubOnderkaPhpVarDumpCheckManager::loadFile"
  emit sink code.FilePathAccess at args[0]
