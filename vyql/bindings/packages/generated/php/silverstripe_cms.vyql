module bindings.php.generated.m5fa69edc;

binding inputValidation0 {
  requires {
    dependency("silverstripe/cms")
  }
  query pattern callExpr where callee.method == "validate"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}

binding pathCanonicalization1 {
  requires {
    dependency("silverstripe/cms")
  }
  query pattern callExpr where callee.method == "generateURLSegment"
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
  }
}
