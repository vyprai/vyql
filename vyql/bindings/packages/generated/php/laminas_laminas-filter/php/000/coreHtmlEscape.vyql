module bindings.php.generated.m4f20d06e;

binding htmlEscape0 {
  requires {
    dependency("laminas/laminas-filter")
  }
  query pattern callExpr where callee.method == "LaminasFilterStripTags.filter"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}
