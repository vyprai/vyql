binding commandExecution0 {
  requires {
    dependency("tracy/tracy")
  }
  query pattern callExpr where callee.method == "exec"
  emit sink code.CommandExecution at args[0]
}

binding htmlEscape1 {
  requires {
    dependency("tracy/tracy")
  }
  query pattern callExpr where callee.method == "escapeHtml"
  emit check core.HtmlEscape at call {
    covers path {
