module bindings.php.generated.m47de4297;

binding filePathAccess0 {
  requires {
    dependency("cakephp/plugin-installer")
  }
  query pattern callExpr where callee.method == "file_put_contents"
  emit sink code.FilePathAccess at args[0]
}

binding pathCanonicalization1 {
  requires {
    dependency("cakephp/plugin-installer")
  }
  query pattern callExpr where callee.method == "getFullPath"
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
  }
}
