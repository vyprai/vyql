module bindings.php.generated.m92c776b0;

binding htmlEscape0 {
  requires {
    dependency("ezyang/htmlpurifier")
  }
  query pattern callExpr where callee.method == "purify"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}

binding htmlEscape1 {
  requires {
    dependency("ezyang/htmlpurifier")
  }
  query pattern callExpr where callee.method == "purifyArray"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}
