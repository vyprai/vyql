module bindings.php.generated.md7c84739;

binding htmlEscape0 {
  requires {
    dependency("drupal/core-utility")
  }
  query pattern callExpr where callee.method == "Html::escape"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}

binding deserialization1 {
  requires {
    dependency("drupal/core-utility")
  }
  query pattern callExpr where callee.method == "Html::load"
  emit sink code.Deserialization at args[0]
}

binding userControlledData2 {
  requires {
    dependency("drupal/core-utility")
  }
  query pattern callExpr where callee.method == "UrlHelper::parse"
  emit source core.UserControlledData at call.result
}
