module bindings.php.generated.m1db1da0e;

binding redirectTarget0 {
  requires {
    dependency("inertiajs/inertia-laravel")
  }
  query pattern callExpr where callee.method == "location"
  emit issue code.RedirectTarget at call
  emit sink code.RedirectTargetSink at call
}

binding urlFetch1 {
  requires {
    dependency("inertiajs/inertia-laravel")
  }
  query pattern callExpr where callee.path ~= "InertiaCommandsStopSsr.handle"
  emit sink code.UrlFetch at args[0]
}
