module bindings.php.generated.m5fd067ea;

binding redirectTarget0 {
  requires {
    dependency("mcamara/laravel-localization")
  }
  query pattern callExpr where callee.method == "localizeURL"
  emit issue code.RedirectTarget at call
  emit sink code.RedirectTargetSink at call
}

binding redirectTarget1 {
  requires {
    dependency("mcamara/laravel-localization")
  }
  query pattern callExpr where callee.method == "getLocalizedURL"
  emit issue code.RedirectTarget at call
  emit sink code.RedirectTargetSink at call
}

binding redirectTarget2 {
  requires {
    dependency("mcamara/laravel-localization")
  }
  query pattern callExpr where callee.method == "getNonLocalizedURL"
  emit issue code.RedirectTarget at call
  emit sink code.RedirectTargetSink at call
}
