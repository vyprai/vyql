module bindings.php.generated.m99099147;

binding httpInput0 {
  requires {
    dependency("silverstripe/framework")
  }
  query pattern callExpr where callee.method == "SilverStripe\\Control\\HTTPRequest::getBody"
  emit source code.HttpInput at call.result
}

binding htmlEscape1 {
  requires {
    dependency("silverstripe/framework")
  }
  query pattern callExpr where callee.method == "SilverStripe\\Core\\Convert::raw2htmlatt"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}
