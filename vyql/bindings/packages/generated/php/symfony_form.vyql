module bindings.php.generated.m7d34f016;

binding httpInput0 {
  requires {
    dependency("symfony/form")
  }
  query pattern callExpr where callee.method == "handleRequest"
  emit source code.HttpInput at call.result
}

binding htmlRender1 {
  requires {
    dependency("symfony/form")
  }
  query pattern callExpr where callee.method == "renderBlock"
  emit sink code.HtmlRender at args[0]
}

binding csrfProtection2 {
  requires {
    dependency("symfony/form")
  }
  query pattern callExpr where callee.method == "renderCsrfToken"
  emit check core.CsrfProtection at call {
    covers endpoint {
      anchor: call
    }
  }
}
