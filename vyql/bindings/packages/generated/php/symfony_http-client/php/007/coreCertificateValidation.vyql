module bindings.php.generated.m5e085d6c;

binding certificateValidation7 {
  requires {
    dependency("symfony/http-client")
  }
  query pattern callExpr where callee.method == "setCaPath"
  emit check core.CertificateValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
