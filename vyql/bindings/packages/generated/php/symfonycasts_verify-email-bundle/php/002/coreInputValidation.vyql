module bindings.php.generated.m2bfc241b;

binding inputValidation2 {
  requires {
    dependency("symfonycasts/verify-email-bundle")
  }
  query pattern callExpr where callee.method == "validateEmailConfirmationFromRequest"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
