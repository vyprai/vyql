binding redirectTarget0 {
  requires {
    dependency("codeception/module-yii2")
  }
  query pattern callExpr where callee.method == "amOnRoute"
  emit issue code.RedirectTarget at call
  emit sink code.RedirectTargetSink at call
}

binding cookie1 {
  requires {
    dependency("codeception/module-yii2")
  }
  query pattern callExpr where callee.method == "setCookie"
  emit source code.Cookie at call.result
}
