module bindings.php.generated.m6f0d9635;

binding filePathAccess0 {
  requires {
    dependency("yiisoft/yii2-gii")
  }
  query pattern callExpr where callee.method == "file_put_contents"
  emit sink code.FilePathAccess at args[0]
}

binding cliArgument1 {
  requires {
    dependency("yiisoft/yii2-gii")
  }
  query pattern callExpr where callee.method == "run"
  emit source code.CliArgument at call.result
}
