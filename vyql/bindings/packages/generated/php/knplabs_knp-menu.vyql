binding htmlEscape0 {
  requires {
    dependency("knplabs/knp-menu")
  }
  query pattern callExpr where callee.method == "KnpMenuRendererRenderer::escape"
  emit check core.HtmlEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}

