module bindings.php.generated.mc4d66368;

binding commandExecution0 {
  requires {
    dependency("hoa/console")
  }
  query pattern callExpr where callee.method == "HoaConsoleProcessus::run"
  emit sink code.CommandExecution at args[0]
}

binding cliArgument1 {
  requires {
    dependency("hoa/console")
  }
  query pattern callExpr where callee.method == "HoaConsoleParser::parse"
  emit source code.CliArgument at call.result
}
