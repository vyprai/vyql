module bindings.php.generated.mfab4b72a;

binding htmlRender0 {
  requires {
    dependency("aptoma/twig-markdown")
  }
  query pattern callExpr where callee.method == "parseMarkdown"
  emit sink code.HtmlRender at args[0]
}

binding inputValidation1 {
  requires {
    dependency("aptoma/twig-markdown")
  }
  query pattern callExpr where callee.method == "setSafeMode"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
