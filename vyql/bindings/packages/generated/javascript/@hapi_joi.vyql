module bindings.javascript.generated.me392aa7e;

binding inputValidation0 {
  requires {
    dependency("@hapi/joi")
  }
  query pattern callExpr where callee.method == "validate"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}

binding inputValidation1 {
  requires {
    dependency("@hapi/joi")
  }
  query pattern callExpr where callee.method == "validateAsync"
  emit check core.InputValidation at call {
    covers path {
      from: call
      to: call
    }
  }
}
