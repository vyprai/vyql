binding networkConnect0 {
  requires {
    dependency("http-proxy-middleware")
  }
  query pattern callExpr where callee.method == "HttpProxyMiddleware"
  emit sink code.NetworkConnectSink at args[0]
}

binding urlFetch1 {
  requires {
    dependency("http-proxy-middleware")
  }
  query pattern callExpr where callee.method == "HttpProxyMiddleware"
  emit sink code.UrlFetch at args[0]
}

binding pathCanonicalization2 {
  requires {
    dependency("http-proxy-middleware")
  }
  query pattern callExpr where callee.method == "createPathRewriter"
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
  }
}

binding inputValidation3 {
