module bindings.javascript.generated.m2cbd08e3;

binding commandExecution0 {
  requires {
    dependency("cross-spawn")
  }
  query pattern callExpr where callee.method == "spawn"
  emit sink code.CommandExecution at args[0]
}

binding commandExecution1 {
  requires {
    dependency("cross-spawn")
  }
  query pattern callExpr where callee.method == "spawnSync"
  emit sink code.CommandExecution at args[0]
}

binding shellEscape2 {
  requires {
    dependency("cross-spawn")
  }
  query pattern callExpr where callee.method == "escapeCommand"
  emit check core.ShellEscape at call {
    covers path {
      from: call
      to: call
    }
  }
}

binding shellEscape3 {
  requires {
    dependency("cross-spawn")
  }
  query pattern callExpr where callee.method == "escapeArgument"
  emit check core.ShellEscape at call {
    covers path {
