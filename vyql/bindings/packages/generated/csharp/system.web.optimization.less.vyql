module bindings.csharp.generated.mbffe8cc2;

binding deserialization0 {
  requires {
    dependency("system.web.optimization.less")
  }
  query pattern callExpr where callee.method == "Process"
  emit sink code.Deserialization at args[0]
}

binding filePathAccess1 {
  requires {
    dependency("system.web.optimization.less")
  }
  query pattern callExpr where callee.method == "GetFileContents"
  emit sink code.FilePathAccess at args[0]
}

binding pathCanonicalization2 {
  requires {
    dependency("system.web.optimization.less")
  }
  query pattern callExpr where callee.method == "GetFullPath"
  emit check core.PathCanonicalization at call {
    covers path {
      from: call
      to: call
    }
