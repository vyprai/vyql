module bindings.csharp.generated.m3e29ef3a;

binding redirectTarget0 {
  requires {
    dependency("twilio.twiml")
  }
  query pattern callExpr where callee.method == "TwilioResponse.Redirect"
  emit issue code.RedirectTarget at call
  emit sink code.RedirectTargetSink at call
}

binding redirectTarget1 {
  requires {
    dependency("twilio.twiml")
  }
  query pattern callExpr where callee.method == "Redirect.ctor"
  emit issue code.RedirectTarget at call
  emit sink code.RedirectTargetSink at call
}

binding authenticationCheck2 {
  requires {
    dependency("twilio.twiml")
  }
  query pattern callExpr where callee.method == "RequestValidator.IsValidRequest"
  emit check core.AuthenticationCheck at call {
    covers endpoint {
      anchor: call
    }
  }
}
