concept McpToolCommandTemplateExecution : sink {
  vulnerable_to: [injection.CommandInjection]
  cwe: [CWE_77, CWE_78]
  review_category: "command"
  review_condition: "MCP tool handler parameters are interpolated into child_process.exec command templates"
  review_evidence: "MCP tool handler context {pattern} formats a tool argument into a shell command template"
