  vulnerable_to: [deserialization.Xxe]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_611]
}
// Construction of an XML parser/factory (newSAXParser / newDocumentBuilder /
// createXMLReader …). Distinct from XmlParse (the .parse call) so the structural
// XXE rule can flag an unhardened parser precisely without matching bare `.parse`
// (Date.parse, JSON.parse, …).
concept XmlParserCreate : sink {
  vulnerable_to: [deserialization.XxeUnhardened]
  cwe: [CWE_611]
}
concept XpathQuery : sink {
  vulnerable_to: [injection.XpathInjection]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_643]
}

module core;

concept ResourceRelease : control {
  neutralizes: [resource.ResourceLeak]
  cwe: [CWE_772]
}
concept LockRelease : control {
  neutralizes: [concurrency.Deadlock]
  cwe: [CWE_667]
}
concept AllowlistValidation : control {
  neutralizes: [injection.CommandInjection, request_forgery.Ssrf]
  applies: path
}
concept InputValidation : control {
  // a function that validates/authenticates untrusted input before it crosses a trust
  // boundary (e.g. login()/authenticate() returning an authenticated identity). Clears the
  // trust-boundary threat: storing the result into a trusted store is then legitimate.
  neutralizes: [validation.TrustBoundary, validation.ImproperInputValidation]
  applies: path
}
concept AuthenticationCheck : control {
  neutralizes: [authentication.MissingAuthentication]
  cwe: [CWE_306]
  applies: endpoint
}
concept AuthorizationCheck : control {
  neutralizes: [access_control.BrokenAccess]
  applies: endpoint
}
concept CsrfProtection : control {
  neutralizes: [request_forgery.Csrf]
  applies: endpoint
}
// Privacy/data-collection opt-in or opt-out controls exposed by SDKs.
concept DataCollectionControl : control {
  applies: scope
}
concept CertificateValidation : control {
  neutralizes: [crypto.ImproperCertValidation]
  cwe: [CWE_295]
  applies: scope
}
concept EncryptionAtRest : control {
  neutralizes: [crypto.CleartextStorage]
  cwe: [CWE_312]
  applies: scope
}
concept EncryptionInTransit : control {
  neutralizes: [crypto.CleartextTransmission]
  cwe: [CWE_319]
  applies: scope
}
concept HtmlEscape : control {
  neutralizes: [injection.Xss]
  applies: path
}
concept LdapEscape : control {
  neutralizes: [injection.LdapInjection]
  cwe: [CWE_90]
  applies: path
}
concept XpathEscape : control {
  neutralizes: [injection.XpathInjection]
  cwe: [CWE_643]
  applies: path
}
concept MfaRequirement : control {
  neutralizes: [authentication.ImproperAuthentication]
  cwe: [CWE_287]
  applies: endpoint
}
concept OutputEncoding : control {
  neutralizes: [injection.Xss]
  cwe: [CWE_116]
  applies: path
}
concept OwnershipCheck : control {
  neutralizes: [access_control.BrokenAccess, access_control.Idor]
  applies: endpoint
}
concept PathCanonicalization : control {
  neutralizes: [path.PathTraversal]
  cwe: [CWE_22]
  applies: path
}
concept PathAccessCheck : control {
  neutralizes: [path.PathTraversal]
  cwe: [CWE_22]
  applies: endpoint
}
concept RateLimit : control {
  neutralizes: [dos.UncontrolledResourceConsumption]
  cwe: [CWE_400]
  applies: endpoint
}
concept RedirectAllowlist : control {
  neutralizes: [request_forgery.OpenRedirect]
  cwe: [CWE_601]
  applies: path
}
concept SafeDeserialization : control {
  neutralizes: [deserialization.DeserializationAbuse]
  cwe: [CWE_502]
  applies: path
}
concept SecretRedaction : control {
  neutralizes: [secrets.SensitiveLog]
  cwe: [CWE_532]
  applies: path
}
concept SecureRandom : control {
  neutralizes: [crypto.InsufficientEntropy]
  cwe: [CWE_331]
  applies: scope
}
concept ShellEscape : control {
  neutralizes: [injection.CommandInjection]
  applies: path
}
concept SqlParameterization : control {
  neutralizes: [injection.SqlInjection]
  applies: path
}
concept StrongHashing : control {
  neutralizes: [crypto.WeakHash]
  cwe: [CWE_328]
  applies: scope
}
concept UserControlledData : source {
  taint: [taint.UntrustedData]
}
concept XmlHardening : control {
  neutralizes: [deserialization.Xxe]
  cwe: [CWE_611]
  applies: path
}

module identity;

concept AdminPrivilege : privilege { }
concept Anonymous : principal { }
concept AuthenticatedUser : principal { }
concept CiPrincipal : principal { }
concept ExternalPrincipal : principal { }
concept SuperAdminPrivilege : privilege { }
concept WorkloadIdentity : principal { }

module runtime;

concept Connection : observation { }
concept HttpRequest : source {
  taint: [taint.UntrustedData]
}
concept Process : observation { }
concept ShellExecution : sink {
  vulnerable_to: [injection.CommandInjection]
  enabled_by: [taint.UntrustedData]
}

module sbom;

concept ReachableSymbol : exposure { }
concept VulnerableDependency : asset { }
// A dependency whose name typosquats a popular package, or an unreviewed version of a
// package with malicious history (CWE-1357 reliance on an undesirable component).
concept SuspiciousDependency : asset { }
// A dependency on a confirmed-malicious package version (CWE-506 embedded malicious code).
concept MaliciousDependency : asset { }

module threat;

concept MiningPool : indicator { }


// A character-filtering replace(); the engine records its proven output alphabet and
// treats it as a sound sanitizer for any sink whose dangerous_chars it excludes.
concept CharFilter : control {
}

// An UNSOUND neutralizer — a guard or sanitizer that *might* defuse a threat but cannot be
// proven to (a prefix/normalize check, an escaper vyql can't verify). Never suppresses a
// flow; the engine attaches an assumption note so the finding lands in the review queue
// rather than the confident bucket. Declared via the `assume` adapter directive.
concept Assumption : control {
}
