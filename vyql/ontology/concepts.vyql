}
// A contract storage write (member/mapping assignment). Paired with ExternalCall by the
// reentrancy order-rule: an external call BEFORE a state write is the reentrancy anti-pattern.
concept StateWrite : sink {
  vulnerable_to: [smartcontract.Reentrancy]
  cwe: [CWE_841]
}
// A resource allocation (raw socket/handle). A leak when no ResourceRelease post-dominates
