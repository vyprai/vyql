// IaC / container misconfig — presence findings from the config frontend (K8s YAML,
// Dockerfile, Terraform). Each is a markable token labeled by the config adapter.
concept PrivilegedContainer : sink {
  vulnerable_to: [iac.PrivilegedContainer]
  cwe: [CWE_250]
}
