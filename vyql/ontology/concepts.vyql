// VyQL ontology — the curated analysis vocabulary (docs/06).

module business;

concept Order : asset { }
concept PaymentSystem : asset { }
concept Refund : action { }

module cloud;

concept Database : asset {
  context_asset_target_prop: database
  context_asset_label: "sink database {target} holds [{kinds}]"
}
concept Internet : exposure {
  context_reach_source: true
  context_reach_label: "internet-reachable"
  context_reach_target_prop: service
}
concept ObjectStore : asset { }
concept PublicStorage : exposure { }
concept SecretStore : asset { }

module code;

concept CliArgument : source {
  taint: [taint.UntrustedData]
  refines: core.UserControlledData
}
// A public-API / exported-function parameter, treated as attacker-controlled under the
// library/SDK archetype (any caller may pass untrusted data). Active only when the
// library profile's trust boundary enables it — never under application profiles.
concept ExternalEntryInput : source {
  taint: [taint.UntrustedData]
  refines: core.UserControlledData
  source_policy: caller_conditional
  source_condition_category: "caller-controlled-input"
  source_condition: "a caller forwards attacker-controlled data into the public-API parameter {param}"
  source_assumption: "the library is invoked with untrusted input at this entry point"
  source_confidence: medium
}
concept PatternOptionInput : source {
  taint: [taint.UntrustedData]
  refines: core.UserControlledData
}
concept CodeEval : sink {
  vulnerable_to: [injection.CodeInjection]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_94]
}
concept Vm2HostCallbackBridge : sink {
  vulnerable_to: [injection.CodeInjection]
  cwe: [CWE_94]
  review_category: "code_execution"
  review_condition: "vm2 sandbox exposes host callbacks or globals while sandbox code is executed"
  review_evidence: "vm2 context {pattern} bridges host callbacks into the sandbox and executes vm.run"
  review_assumption: "template or sandbox-executed code can invoke the bridged host callbacks"
  review_confidence: medium
}
concept RequestReferenceEval : sink {
  vulnerable_to: [injection.CodeInjection]
  cwe: [CWE_94]
  review_category: "code_execution"
  review_condition: "request-controlled reference paths are evaluated as code to read response fields"
  review_evidence: "request reference context {pattern} builds an eval string from parsed request path parts"
  review_assumption: "an attacker can submit batch request paths containing reference expressions"
  review_confidence: high
}
concept DynamicFunctionMutableObjectEval : sink {
  vulnerable_to: [injection.CodeInjection]
  cwe: [CWE_94]
  review_category: "code_execution"
  review_condition: "a string expression is compiled with the Function constructor and evaluated against a mutable object"
  review_evidence: "dynamic predicate context {pattern} builds a Function body from an expression and object property expansion without freezing or isolating the object first"
  review_assumption: "attacker-controlled expression text or object properties can influence generated code or mutate the evaluated object"
  review_confidence: high
}
concept WerkzeugDebugConsoleExposure : sink {
  vulnerable_to: [injection.CodeInjection, injection.CommandInjection]
  cwe: [CWE_94, CWE_77]
  review_category: "code_execution"
  review_condition: "Flask/Werkzeug debug mode is bound to an externally reachable interface with the eval console enabled"
  review_evidence: "application run context {pattern} enables debug=True on 0.0.0.0 without disabling evalex"
  review_assumption: "the development server can be reached by an unauthenticated network client"
  review_confidence: high
}
concept DynamicCodeLoad : sink {
  vulnerable_to: [injection.UnsafeDynamicLoading]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_829]
  review_category: "code_loading"
  review_condition: "attacker-controlled module or library name reaches a dynamic code loader"
  review_evidence: "dynamic loader {pattern} receives tainted input"
  review_assumption: "the resolved module/library path or search path can be influenced by the attacker"
  review_confidence: medium
}
concept UnqualifiedDatabaseRoutineReview : sink {
  vulnerable_to: [injection.UnsafeDynamicLoading]
  cwe: [CWE_426]
  review_category: "path"
  review_condition: "database routine names are resolved through the active search path instead of an explicit trusted schema"
  review_evidence: "SQL routine reference {pattern} is unqualified"
  review_assumption: "an attacker or tenant can influence routine resolution through database search-path state"
  review_confidence: possibility
}
concept ExternalResourceIntegrityReview : sink {
  vulnerable_to: [injection.UnsafeDynamicLoading]
  cwe: [CWE_345, CWE_829]
  review_category: "supply_chain"
  review_condition: "external script or style integrity metadata can register an unapproved resource as trusted"
  review_evidence: "resource integrity context {pattern} accepts provided integrity metadata without an observed allowlist decision"
  review_assumption: "the HTML/resource reference may be attacker-controlled or may point at an untrusted external origin"
  review_confidence: possibility
}
concept PackageInstallExecution : sink {
  vulnerable_to: [injection.CodeInjection]
  cwe: [CWE_94]
}
concept PrivilegedWorkflowUntrustedCodeExecution : sink {
  vulnerable_to: [injection.CodeInjection]
  cwe: [CWE_94, CWE_95]
  review_category: "code_execution"
  review_condition: "a privileged CI workflow stages untrusted pull-request code before invoking a code-loading framework command"
  review_evidence: "workflow context {pattern} combines a privileged PR trigger, untrusted file copy, and framework code execution"
  review_assumption: "the copied files can contain code imported by the framework command during the privileged workflow run"
  review_confidence: high
}
concept PackageVersionSpecifierValidationReview : sink {
  vulnerable_to: [validation.ImproperInputValidation, injection.CodeInjection]
  cwe: [CWE_20, CWE_94]
  review_category: "supply_chain"
  review_condition: "package version specifier validation accepts arbitrary trailing dependency syntax"
  review_evidence: "package specifier validation context {pattern} uses a permissive regex before installation"
  review_assumption: "project metadata or action inputs can influence the dependency specifier passed to the package installer"
  review_confidence: medium
}
concept UnboundedJupyterKernelDependency : sink {
  vulnerable_to: [dos.UncontrolledResourceConsumption]
  cwe: [CWE_1104]
  review_category: "supply_chain"
  review_condition: "Jupyter kernel runtime dependencies are installed without an upper compatibility cap"
  review_evidence: "dependency context {pattern} installs ipykernel without an observed upper bound"
  review_assumption: "the image or environment is used to run remote kernels whose message protocol must remain compatible with the gateway/server stack"
  review_confidence: high
}
concept CommandExecution : sink {
  vulnerable_to: [injection.CommandInjection]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_78]
  excluded_chars: ";|&$<>()"
}
concept ApiScanFoundActionCommandExecution : sink {
  vulnerable_to: [injection.CommandInjection, injection.CodeInjection]
  cwe: [CWE_78, CWE_15]
  review_category: "command"
  review_condition: "API request bodies can configure scan options that trigger host-side found-action command execution"
  review_evidence: "API scan handler context {pattern} binds request options and forwards them to the scan engine without stripping found-action command fields"
  review_assumption: "the scan engine executes configured found-action commands when a finding is produced"
  review_confidence: high
}
concept RubyPipeOpenCommandExecution : sink {
  vulnerable_to: [injection.CommandInjection]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_78]
  review_category: "command"
  review_condition: "caller-controlled Ruby open path can select process execution with a pipe prefix"
  review_evidence: "Ruby Kernel.open context {pattern} receives caller-controlled input"
  review_assumption: "the path can begin with a pipe character and reach Ruby's process-opening behavior"
  review_confidence: high
}
concept CommandOptionInjection : sink {
  vulnerable_to: [injection.ArgumentInjection]
  cwe: [CWE_74, CWE_88]
}

concept ProtocolCommandInjection : sink {
  vulnerable_to: [injection.ProtocolStateConfusion]
  cwe: [CWE_349]
}

concept CommandLineAssemblyReview : sink {
  vulnerable_to: [injection.CommandInjection, injection.ArgumentInjection, injection.UnsafeDynamicLoading]
  cwe: [CWE_77, CWE_88, CWE_829]
  review_category: "command"
  review_condition: "command line text is assembled from contextual values without observed shell quoting"
  review_evidence: "command-line assembly context {pattern} appends a placeholder value before process/application launch"
  review_assumption: "the appended value can be influenced through a document, URI, desktop action, or caller-controlled parameter"
  review_confidence: medium
}
concept MsgfmtPathShellCommandInterpolation : sink {
  vulnerable_to: [injection.CommandInjection]
  cwe: [CWE_78]
  review_category: "command"
  review_condition: "message compilation command text interpolates filesystem-derived .po/.mo paths before shell execution"
  review_evidence: "msgfmt command context {pattern} formats a path-derived stem into os.system(cmd)"
  review_assumption: "an attacker can introduce a translation filename or directory containing shell metacharacters"
  review_confidence: high
}
concept UnsafeBuildClientCommandAssembly : sink {
  vulnerable_to: [injection.CommandInjection]
  cwe: [CWE_78]
  review_category: "command"
  review_condition: "client build command text includes caller-controlled build fields before shell execution"
  review_evidence: "build-client command context {pattern} formats input fields into a shell command"
  review_assumption: "the build request can control filename, server address, or server port values"
  review_confidence: high
}
concept ShellTruePackageManagerProbe : sink {
  vulnerable_to: [injection.CommandInjection]
  cwe: [CWE_78]
  review_category: "command"
  review_condition: "package-manager availability probe formats command text and executes it through shell=True"
  review_evidence: "package probe context {pattern} builds a pkgmgr flag/library command string before subprocess.Popen(..., shell=True)"
  review_assumption: "package-manager, flag, or package-name values should remain argv-separated so shell metacharacters cannot alter command execution"
  review_confidence: high
}
concept TemplateInstallScriptHostExecution : sink {
  vulnerable_to: [injection.CommandInjection, access_control.PrivilegeEscalation]
  cwe: [CWE_78, CWE_269]
  review_category: "command"
  review_condition: "template-defined install scripts execute on the host shell instead of an isolated runtime"
  review_evidence: "template install context {pattern} forwards the install script to host bash -c"
  review_assumption: "a lower-privileged template author can define or update install scripts that run on cluster nodes"
  review_confidence: medium
}
concept HostExpandedUrlSanitizedBeforeExpansionSsti : sink {
  vulnerable_to: [injection.CodeInjection, injection.TemplateInjection]
  cwe: [CWE_94, CWE_1336]
  review_category: "code_execution"
  review_condition: "a request-derived URL is sanitized before host/protocol expansion, allowing attacker-controlled Host metadata to be reintroduced into a template-rendered URL"
  review_evidence: "canonical URL context {pattern} sanitizes the path before building an absolute URL from request host metadata"
  review_assumption: "the resulting absolute URL is rendered through a server-side template or metadata renderer that evaluates template syntax"
  review_confidence: high
}
concept PartiallyEscapedSshCommand : sink {
  vulnerable_to: [injection.CommandInjection]
  cwe: [CWE_77]
  review_category: "command"
  review_condition: "an SSH command string escapes only some attacker-controlled fields before shell execution"
  review_evidence: "SSH command assembly context {pattern} quotes password/remote command but interpolates username, host, or port directly"
  review_assumption: "an agent, upstream target, or caller can influence SSH connection fields"
  review_confidence: medium
}
concept IncompleteCommandEscapeRegex : sink {
  vulnerable_to: [injection.CommandInjection]
  cwe: [CWE_77]
  review_category: "command"
  review_condition: "command sanitizer regex omits intended shell metacharacters because alternation is used instead of a character class"
  review_evidence: "command escape helper {pattern} feeds a shell command execution site"
  review_assumption: "attacker-controlled command fragments can include shell metacharacters that survive the sanitizer"
  review_confidence: high
}
concept ClamscanBinaryPathShellCommandInjection : sink {
  vulnerable_to: [injection.CommandInjection]
  cwe: [CWE_78]
  review_category: "command"
  review_condition: "Clamscan verifies a configured scanner binary path by interpolating it into a shell command"
  review_evidence: "binary verification context {pattern} builds a --version command string from the configured scanner path and executes it through a shell"
  review_assumption: "library callers can configure the scanner path and an attacker can arrange a matching filesystem entry so shell metacharacters survive the access check"
  review_confidence: high
}
concept PythonTripleQuoteShellInterpolation : sink {
  vulnerable_to: [injection.CodeInjection, injection.CommandInjection]
  cwe: [CWE_94, CWE_77]
  review_category: "code_execution"
  review_condition: "shell-captured hook input is interpolated into Python source inside a triple-quoted string literal"
  review_evidence: "shell interpreter context {pattern} passes a python3 -c program that embeds $input in json.loads('''...''')"
  review_assumption: "the hook JSON can contain user-controlled path fields with apostrophe sequences that close the Python literal"
  review_confidence: high
}
concept ReactNativeCliOpenUrlMiddlewareCommandExecution : sink {
  vulnerable_to: [injection.CommandInjection]
  cwe: [CWE_78]
  review_category: "command"
  review_condition: "React Native CLI opens a request-supplied URL in the system browser without an http/https protocol allowlist"
  review_evidence: "openURLMiddleware context {pattern} extracts url from req.body and passes it to open(url) before validating the URL protocol"
  review_assumption: "an attacker can reach the development server endpoint and choose a URL scheme that the OS open handler interprets as command execution"
  review_confidence: high
}
concept CloudStackBaremetalMacCommandInjection : sink {
  vulnerable_to: [injection.CommandInjection]
  cwe: [CWE_78, CWE_20]
  review_category: "command"
  review_condition: "CloudStack baremetal provision-done route forwards an unvalidated MAC path parameter into a shell curl command"
  review_evidence: "baremetal-vr route context {pattern} accepts /baremetal/provisiondone/<mac> and calls server.notify_provisioning_done(mac) before a MAC-format allowlist"
  review_assumption: "the baremetal virtual router endpoint is reachable and shell metacharacters in the mac path segment can break out of the quoted curl URL"
  review_confidence: high
}
concept CodecovNodeGcovCommandInjection : sink {
  vulnerable_to: [injection.CommandInjection]
  cwe: [CWE_78]
  review_category: "command"
  review_condition: "Codecov Node upload builds a gcov shell command from upload options after stripping only ampersands"
  review_evidence: "Codecov upload context {pattern} combines gcov-root, gcov-exec, or gcov-args into a command string passed to execSync"
  review_assumption: "library callers can supply upload options containing shell metacharacters such as backticks that survive sanitizeVar"
  review_confidence: high
}
concept CompileSassCleanupShellCommandWithoutPathCheck : sink {
  vulnerable_to: [injection.CommandInjection]
  cwe: [CWE_78]
  review_category: "command"
