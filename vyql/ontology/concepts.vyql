// VyQL ontology — the curated analysis vocabulary (docs/06).

module business;

concept Order : asset { }
concept PaymentSystem : asset { }
concept Refund : action { }

module cloud;

concept Database : asset {
  context_asset_target_prop: database
  context_asset_label: "sink database {target} holds [{kinds}]"
}
concept Internet : exposure {
  context_reach_source: true
  context_reach_label: "internet-reachable"
  context_reach_target_prop: service
}
concept ObjectStore : asset { }
concept PublicStorage : exposure { }
concept SecretStore : asset { }

module code;

concept CliArgument : source {
  taint: [taint.UntrustedData]
  refines: core.UserControlledData
}
// A public-API / exported-function parameter, treated as attacker-controlled under the
// library/SDK archetype (any caller may pass untrusted data). Active only when the
// library profile's trust boundary enables it — never under application profiles.
concept ExternalEntryInput : source {
  taint: [taint.UntrustedData]
  refines: core.UserControlledData
  source_policy: caller_conditional
  source_condition_category: "caller-controlled-input"
  source_condition: "a caller forwards attacker-controlled data into the public-API parameter {param}"
  source_assumption: "the library is invoked with untrusted input at this entry point"
  source_confidence: medium
}
concept CodeEval : sink {
  vulnerable_to: [injection.CodeInjection]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_94]
}
concept DynamicCodeLoad : sink {
  vulnerable_to: [injection.UnsafeDynamicLoading]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_829]
  review_category: "code_loading"
  review_condition: "attacker-controlled module or library name reaches a dynamic code loader"
  review_evidence: "dynamic loader {pattern} receives tainted input"
  review_assumption: "the resolved module/library path or search path can be influenced by the attacker"
  review_confidence: medium
}
concept ExternalResourceIntegrityReview : sink {
  vulnerable_to: [injection.UnsafeDynamicLoading]
  cwe: [CWE_345, CWE_829]
  review_category: "supply_chain"
  review_condition: "external script or style integrity metadata can register an unapproved resource as trusted"
  review_evidence: "resource integrity context {pattern} accepts provided integrity metadata without an observed allowlist decision"
  review_assumption: "the HTML/resource reference may be attacker-controlled or may point at an untrusted external origin"
  review_confidence: possibility
}
concept PackageInstallExecution : sink {
  vulnerable_to: [injection.CodeInjection]
  cwe: [CWE_94]
}
concept CommandExecution : sink {
  vulnerable_to: [injection.CommandInjection]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_78]
  excluded_chars: ";|&$<>()"
}
concept CommandOptionInjection : sink {
  vulnerable_to: [injection.ArgumentInjection]
  cwe: [CWE_74, CWE_88]
}

concept CommandLineAssemblyReview : sink {
  vulnerable_to: [injection.CommandInjection, injection.ArgumentInjection, injection.UnsafeDynamicLoading]
  cwe: [CWE_77, CWE_88, CWE_829]
  review_category: "command"
  review_condition: "command line text is assembled from contextual values without observed shell quoting"
  review_evidence: "command-line assembly context {pattern} appends a placeholder value before process/application launch"
  review_assumption: "the appended value can be influenced through a document, URI, desktop action, or caller-controlled parameter"
  review_confidence: medium
}

concept FormatString : sink {
  vulnerable_to: [injection.FormatString]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_134]
}

concept RegexCompile : sink {
  vulnerable_to: [dos.ReDoS]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_1333]
}

concept RegexMatch : sink {
  vulnerable_to: [dos.ReDoS]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_1333]
}

concept CatastrophicRegex : sink {
  vulnerable_to: [dos.ReDoS, dos.UncontrolledResourceConsumption]
  cwe: [CWE_1333, CWE_400]
  review_category: "resource"
  review_condition: "a static regular expression has catastrophic-backtracking structure"
  review_evidence: "regex construction {pattern} contains nested or ambiguous quantified branches"
  review_assumption: "an attacker can supply input matched by this exported or reachable regex"
  review_confidence: medium
}

concept MassAssign : sink {
  vulnerable_to: [injection.MassAssignment]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_915]
}

concept ProtoPollute : sink {
  vulnerable_to: [injection.PrototypePollution]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_1321]
  analysis_role: attribute_sink
}
concept SchemaCodegenValidationBypass : sink {
  vulnerable_to: [injection.PrototypePollution, injection.MassAssignment]
  cwe: [CWE_1321, CWE_915]
}

concept WeakHash : sink {
  vulnerable_to: [crypto.WeakHash]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_327]
}

concept CsrfDisabled : sink {
  vulnerable_to: [access_control.CsrfDisabled]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_352]
}

concept CsvCell : sink {
  vulnerable_to: [injection.CsvInjection]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_1236]
}

concept UnsafeUpload : sink {
  vulnerable_to: [injection.UnrestrictedUpload]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_434]
}

concept ExpressionEval : sink {
  vulnerable_to: [injection.ExpressionLanguageInjection]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_917]
}

concept WeakCipher : sink {
  vulnerable_to: [crypto.WeakCipher]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_327]
}
// A cryptographic operation (sign/verify/encrypt/decrypt/hash/key-derivation) whose
// CORRECTNESS — algorithm choice, signature verification, key/IV handling — can't be
// proven by static analysis. Surfaced only by the possibility tier for AI/triage review
// of crypto logic (the bug class behind many crypto CVEs: bypassed verification, weak
// key management). Not used by the confirmed rules, so it never affects default output.
concept CryptoOperation : sink {
  vulnerable_to: [crypto.WeakCrypto]
  cwe: [CWE_327]
}

concept SessionId : sink {
  vulnerable_to: [session.SessionFixation]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_384]
}

concept PermissiveCors : sink {
  vulnerable_to: [access_control.PermissiveCors]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_942]
}

concept MailHeaderWrite : sink {
  vulnerable_to: [injection.CrlfInjection]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_93]
}

concept InsecureTempFile : sink {
  vulnerable_to: [path.InsecureTempFile, path.LinkFollowing]
  cwe: [CWE_377, CWE_59]
}

// Review-only: security-sensitive virtual filesystem paths (for example procfs
// control files) opened through ordinary path APIs may be redirected or resolved
// outside the intended special filesystem. This stays review-only because the
// exploitability depends on mount/user namespace context.
concept SpecialFileAccessReview : sink {
  vulnerable_to: [path.LinkFollowing]
  cwe: [CWE_61, CWE_706]
  review_category: "path"
  review_condition: "security-sensitive virtual filesystem path is opened without an observed secure filesystem boundary"
  review_evidence: "special-file access context {pattern} uses ordinary path opening"
  review_assumption: "the path may be redirected away from the intended special filesystem"
  review_confidence: possibility
}

concept CertValidationDisabled : sink {
  vulnerable_to: [crypto.ImproperCertValidation]
  cwe: [CWE_295]
}

concept JwtUnverified : sink {
  vulnerable_to: [crypto.ImproperSignatureCheck]
  cwe: [CWE_347]
}

concept ShortSecurityIdentifier : source {
  taint: [taint.WeakSecurityIdentifier]
  cwe: [CWE_358]
  review_category: "crypto"
  review_condition: "a security identifier is shortened before it is used for a trust decision"
  review_evidence: "identifier truncation {pattern} produces a shortened value"
  review_assumption: "the shortened identifier can collide with a different trusted identity"
  review_confidence: medium
}

concept SecurityKeyTrustOperation : sink {
  vulnerable_to: [crypto.IncompleteSecurityIdentifier, crypto.ImproperSignatureCheck]
  enabled_by: [taint.WeakSecurityIdentifier]
  cwe: [CWE_358, CWE_347]
  review_category: "crypto"
  review_condition: "a shortened security key identifier reaches a key trust operation"
  review_evidence: "trust operation {pattern} receives a shortened identifier"
  review_assumption: "the keyserver or trust store may contain a colliding key identifier"
  review_confidence: medium
}

concept SecretComparisonReview : sink {
  vulnerable_to: [crypto.ObservableDiscrepancy]
  cwe: [CWE_203, CWE_208]
  review_category: "crypto"
  review_condition: "secret material is compared with an ordinary equality operation instead of a constant-time comparison"
  review_evidence: "secret comparison context {pattern} derives request data and secret data without an observed constant-time compare"
  review_assumption: "an attacker can repeatedly submit candidate values and observe timing or error differences"
  review_confidence: medium
}

concept CleartextChannel : sink {
  vulnerable_to: [crypto.CleartextTransmission]
  cwe: [CWE_319]
}

concept InsecureCookie : sink {
  vulnerable_to: [session.InsecureCookie]
  cwe: [CWE_614]
}

concept WebViewLoad : sink {
  vulnerable_to: [mobile.WebViewInjection]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_749]
}
concept ElectronNodeIntegration : sink {
  vulnerable_to: [desktop.InsecureElectronConfig]
  cwe: [CWE_829]
}
concept WebViewJsInterface : sink {
  vulnerable_to: [mobile.WebViewInjection]
  cwe: [CWE_749]
}
// Mobile config presence concepts (AndroidManifest.xml / iOS Info.plist) — flagged
// by the config frontend, no taint flow required.
concept ExportedComponent : sink {
  vulnerable_to: [mobile.ExportedComponent]
  cwe: [CWE_926]
}
concept CleartextConfig : sink {
  vulnerable_to: [crypto.CleartextTransmission]
  cwe: [CWE_319]
}
concept DebuggableApp : sink {
  vulnerable_to: [mobile.DebuggableBuild]
  cwe: [CWE_489]
}
concept BackupAllowedConfig : sink {
  vulnerable_to: [mobile.BackupExposure]
  cwe: [CWE_922]
}

// IaC / container misconfig — presence findings from the config frontend (K8s YAML,
// Dockerfile, Terraform). Each is a markable token labeled by the config adapter.
concept PrivilegedContainer : sink {
  vulnerable_to: [iac.PrivilegedContainer]
  cwe: [CWE_250]
}
concept HostNamespaceShare : sink {
  vulnerable_to: [iac.HostNamespaceShare]
  cwe: [CWE_653]
}
concept PublicNetworkExposure : sink {
  vulnerable_to: [iac.PublicNetworkExposure]
  cwe: [CWE_284]
}
concept WildcardIamPolicy : sink {
  vulnerable_to: [iac.WildcardIamPolicy]
  cwe: [CWE_284]
}

concept ExternalCall : sink {
  vulnerable_to: [smartcontract.ExternalCallInjection]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_829]
}

concept PrivilegedOp : sink {
  vulnerable_to: [smartcontract.PrivilegedDestruct]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_284]
}
// A contract storage write (member/mapping assignment). Paired with ExternalCall by the
// reentrancy order-rule: an external call BEFORE a state write is the reentrancy anti-pattern.
concept StateWrite : sink {
  vulnerable_to: [smartcontract.Reentrancy]
  cwe: [CWE_841]
}
// A resource allocation (raw socket/handle). A leak when no ResourceRelease post-dominates
// it (type-state, B2). CWE-772.
concept ResourceHandle : sink {
  vulnerable_to: [resource.ResourceLeak]
  cwe: [CWE_772]
}
concept StructuredInputDecode : sink {
  vulnerable_to: [validation.ImproperInputValidation]
  cwe: [CWE_20]
  review_category: "input_validation"
  review_condition: "structured input bytes are decoded and should be validated against the target format"
  review_evidence: "decoder operation {pattern} consumes structured bytes"
  review_assumption: "malformed or out-of-alphabet input can reach callers that trust the decoded value"
  review_confidence: possibility
}
concept OwnerFieldClear : sink {
  vulnerable_to: [resource.ResourceLeak]
  cwe: [CWE_401]
  review_category: "resource"
  review_condition: "an owned field is cleared before the owning object is released"
  review_evidence: "field-clear operation {pattern} dominates owner release"
  review_assumption: "the cleared field owns nested allocation state that the owner release would otherwise free"
  review_confidence: low
}
concept OwnerFree : sink {
  vulnerable_to: [resource.ResourceLeak]
  cwe: [CWE_401]
  review_category: "resource"
  review_condition: "owner release follows a dominating field clear"
  review_evidence: "owner release primitive {pattern} is reached after an owned field clear"
  review_assumption: "the release routine frees nested fields unless they are cleared first"
  review_confidence: low
}
concept LockAcquire : sink {
  vulnerable_to: [concurrency.Deadlock]
  cwe: [CWE_667]
  review_category: "lifecycle"
  review_condition: "a lock acquisition may not be released on every path"
  review_evidence: "lock primitive {pattern} is acquired"
  review_assumption: "an unreleased lock can be triggered to deadlock or starve concurrent work"
  review_confidence: medium
}
concept UnboundedCopy : sink {
  vulnerable_to: [memory.OobWrite]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_787, CWE_120]
  review_category: "memory"
  review_condition: "attacker-controlled bytes reach an unbounded copy into a fixed-size destination"
  review_evidence: "unsafe copy primitive {pattern} receives tainted input"
  review_assumption: "the destination capacity can be smaller than the copied bytes"
  review_confidence: high
}
concept UnboundedCopySmell : sink {
  vulnerable_to: [memory.OobWrite]
  cwe: [CWE_787, CWE_120]
  review_category: "memory"
  review_condition: "an unbounded copy can overflow its destination"
  review_evidence: "unsafe copy primitive {pattern} is present"
  review_assumption: "an attacker can influence source length or destination capacity is insufficient"
  review_confidence: low
}
concept RawMemoryCopySize : sink {
  vulnerable_to: [memory.OobWrite]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_787]
  review_category: "memory"
  review_condition: "raw memory copy size expression needs bounds review"
  review_evidence: "copy-size argument to {pattern} is computed or externally influenced"
  review_assumption: "the size or source offset can exceed the destination/source object bounds"
  review_confidence: medium
}
concept UnsafeMutableAlias : sink {
  vulnerable_to: [memory.OobWrite, memory.UseAfterFree]
  cwe: [CWE_787, CWE_416]
}
concept UnsafeAutoTraitImpl : sink {
  vulnerable_to: [concurrency.RaceCondition, memory.OobRead, memory.OobWrite]
  cwe: [CWE_362, CWE_119]
}
concept FfiEnumLayoutRisk : sink {
  vulnerable_to: [memory.OobRead, memory.OobWrite]
  cwe: [CWE_119]
  review_category: "memory"
  review_condition: "a language enum crosses an FFI boundary with ABI-sensitive representation"
  review_evidence: "enum representation metadata {pattern} requires layout review"
  review_assumption: "the foreign ABI expects a fixed-width integer representation"
  review_confidence: low
}
concept UninitializedBufferExposure : sink {
  vulnerable_to: [memory.UninitializedUse]
  cwe: [CWE_908]
  review_category: "memory"
  review_condition: "a buffer with reserved capacity is exposed as initialized mutable storage"
  review_evidence: "uninitialized buffer lifecycle {pattern} is present"
  review_assumption: "the callee can observe or depend on bytes before they are initialized"
  review_confidence: medium
}
concept FailurePathOwnedBufferFree : sink {
  vulnerable_to: [memory.DoubleFree]
  cwe: [CWE_415]
}
concept ComputedSizeValue : source {
  taint: [taint.ComputedSize]
}
concept SizeComputation : sink {
  vulnerable_to: [memory.IntegerOverflow]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_190]
  review_category: "numeric"
  review_condition: "attacker-controlled size feeds allocation or bounds-sensitive operation"
  review_evidence: "size argument to {pattern} is tainted"
  review_assumption: "the value is not range-checked before memory use"
  review_confidence: medium
}
concept StackAllocationSmell : sink {
  vulnerable_to: [dos.UncontrolledResourceConsumption]
  cwe: [CWE_400]
  review_category: "memory"
  review_condition: "unbounded stack allocation can exhaust stack or corrupt nearby state"
  review_evidence: "stack allocation primitive {pattern} is present"
  review_assumption: "the allocation size can be attacker-influenced or unexpectedly large"
  review_confidence: low
}
concept FileCheck : sink {
  vulnerable_to: [concurrency.Toctou]
  cwe: [CWE_367]
  review_category: "race"
  review_condition: "filesystem state is checked before a later use"
  review_evidence: "check primitive {pattern} observes path state"
  review_assumption: "an attacker can change the path target between check and use"
  review_confidence: medium
}
concept FileUse : sink {
  vulnerable_to: [concurrency.Toctou]
  cwe: [CWE_367]
  review_category: "race"
  review_condition: "checked filesystem state is later used"
  review_evidence: "use primitive {pattern} acts on the path"
  review_assumption: "the use is not protected by atomic open flags or symlink-safe handling"
  review_confidence: medium
}
concept LocklessSharedMutation : sink {
  vulnerable_to: [concurrency.RaceCondition]
  cwe: [CWE_362]
  review_category: "race"
  review_condition: "shared state appears to be mutated without an observed lock or atomic guard"
  review_evidence: "concurrency-capable mutation primitive {pattern} is present"
  review_assumption: "multiple attacker-triggerable executions can interleave on the same state"
  review_confidence: low
}
concept IndexAccess : sink {
  vulnerable_to: [memory.OobRead, memory.OobWrite]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_125, CWE_787]
  review_category: "memory"
  review_condition: "attacker-controlled index reaches an array/subscript access"
  review_evidence: "subscript index flows into {pattern}"
  review_assumption: "the index is not range-checked against the accessed object"
  review_confidence: medium
}
concept FieldDerivedIndexAccess : sink {
  vulnerable_to: [memory.OobRead, memory.OobWrite]
  cwe: [CWE_129, CWE_125, CWE_787]
}
concept DivisionDenominator : sink {
  vulnerable_to: [numeric.DivideByZero]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_369]
  review_category: "numeric"
  review_condition: "attacker-controlled denominator reaches division or modulo"
  review_evidence: "denominator operand for {pattern} is tainted"
  review_assumption: "zero or unsafe divisor values are not excluded before the operation"
  review_confidence: medium
}
concept IntegerSizeArithmetic : sink {
  vulnerable_to: [memory.IntegerOverflow]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_190]
  review_category: "numeric"
  review_condition: "attacker-controlled value participates in size-sensitive arithmetic"
  review_evidence: "arithmetic operation {pattern} receives tainted input"
  review_assumption: "the arithmetic result is later used for allocation, indexing, copy size, or bounds"
  review_confidence: low
}
concept ZeroSizeReallocation : sink {
  vulnerable_to: [memory.DoubleFree]
  enabled_by: [taint.ComputedSize]
  cwe: [CWE_415]
  review_category: "memory"
  review_condition: "computed allocation size reaches a reallocation primitive that can treat zero size as free"
  review_evidence: "computed size value reaches {pattern}"
  review_assumption: "zero is not excluded on the same size value before reallocation"
  review_confidence: low
}
concept PointerFree : sink {
  vulnerable_to: [memory.UseAfterFree, memory.DoubleFree]
  cwe: [CWE_416, CWE_415]
  review_category: "memory"
  review_condition: "a pointer is released and may be released or used again later"
  review_evidence: "release primitive {pattern} is observed"
  review_assumption: "the same allocation or alias is involved and remains attacker-reachable"
  review_confidence: low
}
concept PointerUse : sink {
  vulnerable_to: [memory.UseAfterFree]
  cwe: [CWE_416]
  review_category: "memory"
  review_condition: "a pointer is dereferenced or otherwise used after a prior release"
  review_evidence: "pointer-use primitive {pattern} is observed"
  review_assumption: "the pointer aliases the released allocation and no safe reinitialization occurs"
  review_confidence: low
}
concept NullableDeref : sink {
  vulnerable_to: [memory.NullDereference]
  cwe: [CWE_476]
  review_category: "memory"
  review_condition: "a pointer-like value is dereferenced without an observed null exclusion"
  review_evidence: "dereference primitive {pattern} is present"
  review_assumption: "the dereferenced value may be null on an attacker-triggerable path"
  review_confidence: low
}
concept EscapedTerminatorWrite : sink {
  vulnerable_to: [memory.OobRead, memory.OobWrite]
  cwe: [CWE_119, CWE_125, CWE_787]
  review_category: "memory"
  review_condition: "an escape decoder writes a decoded byte without rejecting an escaped string terminator"
  review_evidence: "escape decoder context {pattern} writes the decoded byte immediately after unescaping"
  review_assumption: "attacker-controlled input can end with an escape marker followed by a terminator"
  review_confidence: medium
}
concept AuthenticationRequiredOp : sink {
  vulnerable_to: [authentication.MissingAuthentication]
  cwe: [CWE_306]
  review_category: "auth"
  review_condition: "security-sensitive operation is reachable without an observed authentication guard"
  review_evidence: "sensitive operation {pattern} is present"
  review_assumption: "the enclosing endpoint or entry point can be reached by an unauthenticated actor"
  review_confidence: low
}
// Review-only: UI/navigation exit paths from an authentication or lock flow. This is not
// a confirmed vulnerability by itself; it gives the review/AI pass the code locations where
// alternate platform exits may bypass the expected authentication state.
concept AuthFlowBypassReview : sink {
  vulnerable_to: [authentication.ImproperAuthentication]
  cwe: [CWE_287]
}
concept LocalRequestBypassReview : sink {
  vulnerable_to: [access_control.MissingAuthorization]
  cwe: [CWE_266, CWE_285, CWE_862]
}
concept PrivilegedEntryPointReview : sink {
  vulnerable_to: [access_control.MissingAuthorization]
  cwe: [CWE_862]
}
concept IgnoredAuthorizationResult : sink {
  vulnerable_to: [access_control.IncorrectAuthorization]
  cwe: [CWE_252, CWE_285, CWE_863]
}
concept CredentialedEndpointReview : sink {
  vulnerable_to: [access_control.MissingAuthorization, secrets.SecretLeak]
  cwe: [CWE_200, CWE_862]
}
concept TimeBoundAccessTokenReview : sink {
  vulnerable_to: [access_control.BrokenAccess]
  cwe: [CWE_284]
}
// Review-only: authentication challenge, retry, or attempt-limit logic. Used for
// cases where static analysis should hand context to the AI/manual stage to verify
// brute-force limits, rate limiting, and concurrency around failed-attempt counters.
concept AuthAttemptLimitReview : sink {
  vulnerable_to: [authentication.ImproperAuthentication]
  cwe: [CWE_307]
}
concept ProtocolFrameBindingReview : sink {
  vulnerable_to: [authentication.ImproperAuthentication]
  cwe: [CWE_287]
}
concept ObjectLookupByUserInput : sink {
  vulnerable_to: [access_control.Idor]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_639]
  review_category: "access_control"
  review_condition: "attacker-controlled object id reaches a direct object lookup"
  review_evidence: "lookup primitive {pattern} receives tainted input"
  review_assumption: "the object is not constrained to the authenticated principal or tenant"
  review_confidence: medium
}
// A privileged / state-changing operation (delete/grant/setRole/admin, DB writes) whose
// access-control can't be verified statically. POSSIBILITY-tier review concept (broader than
// the curated AuthenticationRequiredOp the confirmed AUTH rules use): surfaces "verify this
// operation is authorized" for the AI pass — the missing/wrong-check bug class behind authz
// CVEs. No confirmed rule consumes it, so default output is unaffected.
concept SensitiveOperation : sink {
  vulnerable_to: [access_control.MissingAuthorization]
  cwe: [CWE_862]
}
// Review-only: static role/group policy configuration that may grant access to a broader
// principal than intended. Used to feed the AI/manual review pass for authz config CVEs.
concept AccessPolicyReview : sink {
  vulnerable_to: [access_control.IncorrectAuthorization]
  cwe: [CWE_863]
}
// Review-only: a handler resolves request metadata and resource metadata but does
// not show a consistency check between request scope and resource scope. Used for
// authz CVEs where the policy boundary is the request/resource scope contract.
concept RequestScopePolicyReview : sink {
  vulnerable_to: [access_control.IncorrectAuthorization]
  cwe: [CWE_863]
  review_category: "auth"
  review_condition: "request metadata and resource metadata are used without an observed request/resource scope consistency check"
  review_evidence: "handler context {pattern} resolves request and resource metadata without a scope comparison"
  review_assumption: "the request may be authorized or dispatched under the wrong resource scope"
  review_confidence: possibility
}
// Review-only: an admission or policy hook ignores all subresources instead of
// making the admitted subresources explicit. Used for bypasses where an alternate
// API path skips the same admission/security policy applied to the primary object.
concept AdmissionSubresourcePolicyReview : sink {
  vulnerable_to: [access_control.IncorrectAuthorization]
  cwe: [CWE_288, CWE_863]
  review_category: "auth"
  review_condition: "admission logic returns early for a non-empty subresource without an observed explicit subresource policy"
  review_evidence: "admission ignore context {pattern} checks subresource presence but does not show an allowlist or handled-subresource branch"
  review_assumption: "an alternate subresource path may bypass the policy applied to the primary resource"
  review_confidence: possibility
}
// Review-only: business workflow/status policy that guards a protected action (for
// example payment state before a digital download). Inert for confirmed scan rules.
concept WorkflowPolicyReview : sink {
  vulnerable_to: [access_control.IncorrectAuthorization]
  cwe: [CWE_841, CWE_862, CWE_863]
}
// Review-only: object lookup/update/delete criteria that identify a user-owned
// record but omit the current-principal ownership constraint. Used for IDOR
// patch-review cases without promoting broad authz heuristics to scan findings.
concept IdorPolicyReview : sink {
  vulnerable_to: [access_control.Idor]
  cwe: [CWE_639]
}
// A network address denylist that recognizes special/private address classes but omits
// ranges needed to keep SSRF fetches away from local or nonsensical endpoints.
concept IncompleteIpDenylist : sink {
  vulnerable_to: [request_forgery.Ssrf]
  cwe: [CWE_918]
}
// Server/port validation that attempts to block privileged or out-of-range
// outbound connections but can be bypassed by PHP string-to-number coercion.
concept IncompleteServerPortValidation : sink {
  vulnerable_to: [request_forgery.Ssrf]
  cwe: [CWE_918]
}
// A resource-acquiring / potentially-unbounded operation (open file/socket/connection,
// spawn thread, allocate, read-all). POSSIBILITY-tier review concept for the resource/DoS
// bucket: "verify this resource is bounded and released". Inert for confirmed rules.
concept ResourceReview : sink {
  vulnerable_to: [dos.UncontrolledResourceConsumption]
  cwe: [CWE_400]
}
concept UnboundedResourceOperation : sink {
  vulnerable_to: [dos.UncontrolledResourceConsumption]
  cwe: [CWE_400, CWE_772]
}
concept UnboundedStateGrowthReview : sink {
  vulnerable_to: [dos.UncontrolledResourceConsumption]
  cwe: [CWE_400, CWE_770]
}
concept UnboundedAllocationReview : sink {
  vulnerable_to: [dos.UncontrolledResourceConsumption]
  cwe: [CWE_400, CWE_770]
}
// Configuration or diagnostic serialization that may include inline secrets unless redacted.
// Review-only: static analysis cannot know which config fields are sensitive in every
// project, so the AI/manual pass should verify redaction before exposure through APIs,
// logs, diagnostics, or support bundles.
concept ConfigExposureReview : sink {
  vulnerable_to: [secrets.SecretLeak, crypto.CleartextStorage]
  cwe: [CWE_200, CWE_312, CWE_522, CWE_532]
  review_category: "secret"
  review_condition: "configuration or diagnostic serialization may expose inline secrets without an observed redaction path"
  review_evidence: "config-like serialization site {pattern} lacks a matching redaction control"
  review_assumption: "repository, keyring, credential, or diagnostic fields may contain inline credentials"
  review_confidence: possibility
}
// Review-only: API settings responses that include password policy, token, or
// similar security-setting fields should be gated by authentication.
concept SensitiveSettingsExposureReview : sink {
  vulnerable_to: [authentication.MissingAuthentication, secrets.SecretLeak]
  cwe: [CWE_306, CWE_287, CWE_200]
  review_category: "auth"
  review_condition: "sensitive settings fields are included in an API settings response without an observed authentication gate"
  review_evidence: "settings response construction {pattern} includes a sensitive settings field"
  review_assumption: "the settings response can be requested by unauthenticated callers"
  review_confidence: possibility
}
// Review-only: generated/internal application content is serialized into a platform
// document or page without an observed visibility/access-control hardening step. Used for
// CWE-200 cases where the issue is not taint, but default platform visibility.
concept InternalContentExposureReview : sink {
  vulnerable_to: [secrets.SecretLeak, access_control.IncorrectAuthorization]
  cwe: [CWE_200, CWE_863]
  review_category: "secret"
  review_condition: "internal or diagnostic content is persisted without an observed visibility restriction"
  review_evidence: "document serialization context {pattern} lacks a matching hidden or access-policy hardening call"
  review_assumption: "the generated page or document may be readable by principals beyond the intended operators"
  review_confidence: possibility
}
