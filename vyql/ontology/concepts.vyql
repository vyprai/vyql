concept McpSqlExecutionMissingValidation : sink {
  vulnerable_to: [injection.SqlInjection, access_control.IncorrectAuthorization]
  cwe: [CWE_89, CWE_863]
  review_category: "sql"
  review_condition: "an MCP SQL helper executes caller-provided SQL through an internal query executor without applying the configured SQL security policy"
  review_evidence: "MCP SQL execution context {pattern} builds a QueryRequest from sql and executes it before validate_sql_security or equivalent authorization/operation checks"
