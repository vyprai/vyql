concept CommandStringWrapperExecution : sink {
  vulnerable_to: [injection.CommandInjection, injection.ArgumentInjection]
  cwe: [CWE_78, CWE_88, CWE_150, CWE_157]
  review_category: "command"
  review_condition: "a command execution wrapper receives one formatted shell command string instead of an argv array"
  review_evidence: "command wrapper context {pattern} builds a command string from request-controlled values before execute"
