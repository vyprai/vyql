// A hardcoded secret literal flagged by the secretscan frontend (presence — no flow).
concept HardcodedSecret : sink {
  vulnerable_to: [secrets.HardcodedCredentials]
  cwe: [CWE_798]
}
// Insecure (non-cryptographic) PRNG — Math.random / random.* / rand() etc. A PRESENCE
// finding (CWE-330): security-sensitive code should use a CSPRNG (secrets / os.urandom /
// SystemRandom / crypto.randomBytes / SecureRandom), which are deliberately NOT marked.
concept WeakRandomValue : sink {
  vulnerable_to: [crypto.InsufficientEntropy]
  cwe: [CWE_330]
}
// World-writable / overly-broad file mode (chmod 0o777, umask 000) — presence (CWE-732).
concept InsecurePermission : sink {
  vulnerable_to: [access_control.InsecurePermission]
  cwe: [CWE_732]
}
// Frame protection explicitly disabled — X-Frame-Options: ALLOWALL, helmet frameguard
// off, CSP frame-ancestors * (CWE-1021 clickjacking). Presence (value-matched).
concept MissingFrameProtection : sink {
  vulnerable_to: [access_control.Clickjacking]
  cwe: [CWE_1021]
}
// Personally-identifiable / regulated data read from a field or getter (SSN, credit
// card, passport, DOB…). A taint SOURCE: a finding when it reaches a log/output sink
// (GDPR / CWE-532 sensitive-data exposure). Scoped to high-signal identifiers only.
concept PiiValue : source {
  taint: [taint.PiiData]
}
// Untrusted data stored across a trust boundary — e.g. into the HTTP session (CWE-501).
concept TrustBoundary : sink {
  vulnerable_to: [validation.TrustBoundary]
  enabled_by: [taint.UntrustedData]
  cwe: [CWE_501]
}
