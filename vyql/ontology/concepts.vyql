  review_confidence: possibility
}
// Insecure (non-cryptographic) PRNG — Math.random / random.* / rand() etc. A PRESENCE
// finding (CWE-330): security-sensitive code should use a CSPRNG (secrets / os.urandom /
// SystemRandom / crypto.randomBytes / SecureRandom), which are deliberately NOT marked.
concept WeakRandomValue : sink {
  vulnerable_to: [crypto.InsufficientEntropy]
  cwe: [CWE_330]
}
