concept ConnectCmsCodestudiesPluginCodeExecution : sink {
  vulnerable_to: [injection.CodeInjection, injection.CommandInjection]
  cwe: [CWE_94, CWE_78]
  review_category: "code-injection"
  review_condition: "Connect-CMS Code Study plugin saves user-submitted code and executes the saved PHP or Java program on the server"
