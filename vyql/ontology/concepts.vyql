concept CatastrophicRegex : sink {
  vulnerable_to: [dos.ReDoS, dos.UncontrolledResourceConsumption]
  cwe: [CWE_1333, CWE_400]
  review_category: "resource"
  review_condition: "a static regular expression has catastrophic-backtracking structure"
  review_evidence: "regex construction {pattern} contains nested or ambiguous quantified branches"
  review_assumption: "an attacker can supply input matched by this exported or reachable regex"
  review_confidence: medium
}
concept UnboundedEmailRegexValidation : sink {
  vulnerable_to: [dos.ReDoS, dos.UncontrolledResourceConsumption]
  cwe: [CWE_1333, CWE_400]
  review_category: "resource"
  review_condition: "email syntax validation applies a broad regular expression before bounding input length"
  review_evidence: "email validation context {pattern} tests email with /^\\S+@\\S+$/ and then performs MX lookup without an observed maximum email length check"
  review_assumption: "attackers can submit very long email strings to the validator and consume regex or downstream processing resources"
  review_confidence: high
}
concept OversizedWebsocketPayloadDefault : sink {
  vulnerable_to: [dos.UncontrolledResourceConsumption]
  cwe: [CWE_400]
  review_category: "resource"
  review_condition: "a WebSocket or long-polling server exposes an oversized default request payload limit"
  review_evidence: "server initialization context {pattern} sets a very large maxHttpBufferSize default and forwards it into the WebSocket maxPayload limit"
  review_assumption: "malicious clients can connect without overriding the server default and submit large payloads to consume memory or CPU"
  review_confidence: high
}

