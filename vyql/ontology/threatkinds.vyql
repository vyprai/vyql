// VyQL weakness-class vocabulary (docs/06) — the threats sinks are
// vulnerable_to and controls neutralize.

module access_control;
threat PermissiveCors { cwe: [CWE_942], desc: "Permissive CORS — Access-Control-Allow-Origin set to '*'" }
threat CsrfDisabled { cwe: [CWE_352], desc: "CSRF protection explicitly disabled / exempted" }
threat BrokenAccess { cwe: [CWE_284], desc: "Improper access control" }
threat Idor { cwe: [CWE_639], desc: "Insecure direct object reference" }
threat IncorrectAuthorization { cwe: [CWE_863], desc: "Incorrect authorization logic" }
threat MissingAuthorization { cwe: [CWE_862], desc: "Missing authorization check" }
threat PrivilegeEscalation { cwe: [CWE_269], desc: "Improper privilege management" }
threat InsecurePermission { cwe: [CWE_732], desc: "Incorrect permission assignment for a critical resource (world-writable / overly broad mode)" }
threat Clickjacking { cwe: [CWE_1021], desc: "Improper restriction of rendered UI layers/frames — frame protection explicitly disabled (clickjacking)" }

module authentication;
threat ImproperAuthentication { cwe: [CWE_287], desc: "Improper authentication" }
threat MissingAuthentication { cwe: [CWE_306], desc: "Missing authentication for critical function" }

module business_logic;
threat BusinessLogic { cwe: [CWE_841], desc: "Improper enforcement of behavioral workflow (business logic)" }

module resource;
threat ResourceLeak { cwe: [CWE_772], desc: "Missing release of a resource on some path (file/socket/handle leak)" }

module concurrency;
threat RaceCondition { cwe: [CWE_362], desc: "Concurrent execution using shared resource" }
threat Toctou { cwe: [CWE_367], desc: "Time-of-check time-of-use race" }
threat Deadlock { cwe: [CWE_667], desc: "Improper locking — acquired lock is not released on every path" }

module crypto;
threat WeakCipher { cwe: [CWE_327], desc: "Use of a broken/weak symmetric cipher (DES/RC4/Blowfish/RC2)" }
threat WeakHash { cwe: [CWE_327], desc: "Use of a broken/weak cryptographic primitive (MD5/SHA1/DES/RC4/ECB)" }
threat StaticIv { cwe: [CWE_329], desc: "Use of a static, predictable, or repeated IV/nonce in a mode that requires uniqueness" }
threat CleartextStorage { cwe: [CWE_312], desc: "Cleartext storage of sensitive information" }
threat CleartextTransmission { cwe: [CWE_319], desc: "Cleartext transmission of sensitive information" }
threat HardcodedCryptoKey { cwe: [CWE_321], desc: "Use of a hard-coded cryptographic key" }
threat InsufficientEntropy { cwe: [CWE_331], desc: "Insufficient entropy" }
threat MissingEncryption { cwe: [CWE_311], desc: "Missing encryption of sensitive data" }
threat WeakCrypto { cwe: [CWE_327], desc: "Use of a broken/risky cryptographic algorithm" }
threat ImproperCertValidation { cwe: [CWE_295], desc: "Improper certificate validation (verification disabled)" }
threat ImproperSignatureCheck { cwe: [CWE_347], desc: "Improper verification of cryptographic signature (e.g. JWT alg none)" }
threat IncompleteSecurityIdentifier { cwe: [CWE_358], desc: "Security-sensitive identity check uses a shortened or ambiguous identifier" }
threat ObservableDiscrepancy { cwe: [CWE_203, CWE_208], desc: "Secret-dependent comparison may expose observable or timing differences" }

module deserialization;
threat DeserializationAbuse { cwe: [CWE_502], desc: "Deserialization of untrusted data" }
threat UnsafeReflection { cwe: [CWE_470], desc: "Untrusted data selecting classes/code via reflection" }
threat Xxe { cwe: [CWE_611], desc: "Improper restriction of XML external entities" }
threat XxeUnhardened { cwe: [CWE_611], desc: "XML parser created without entity hardening" }

module dos;
threat ReDoS { cwe: [CWE_1333], desc: "Untrusted data compiled as a regular expression (catastrophic backtracking)" }
threat UncontrolledResourceConsumption { cwe: [CWE_400], desc: "Uncontrolled resource consumption (DoS)" }

module injection;
threat ArgumentInjection { cwe: [CWE_88], desc: "Untrusted data injected as command arguments" }
threat CodeInjection { cwe: [CWE_94], desc: "Untrusted data evaluated as code" }
threat CommandInjection { cwe: [CWE_78], desc: "Untrusted data in an OS command" }
threat MassAssignment { cwe: [CWE_915], desc: "Untrusted request body bulk-bound to object attributes (mass assignment)" }
threat CsvInjection { cwe: [CWE_1236], desc: "Untrusted data written to a spreadsheet/CSV cell (formula injection)" }
threat UnsafeDynamicLoading { cwe: [CWE_829], desc: "Untrusted data selecting a module, package, or native library to load dynamically" }
threat UnrestrictedUpload { cwe: [CWE_434], desc: "Untrusted filename/destination when saving an uploaded file" }
threat PrototypePollution { cwe: [CWE_1321], desc: "Untrusted object recursively merged, polluting Object.prototype" }
threat FormatString { cwe: [CWE_134], desc: "Untrusted data used as a format string" }
threat CrlfInjection { cwe: [CWE_93], desc: "Improper neutralization of CRLF sequences" }
threat ExpressionLanguageInjection { cwe: [CWE_917], desc: "Untrusted data in an expression-language statement" }
threat HttpResponseSplitting { cwe: [CWE_113], desc: "Untrusted data in HTTP headers" }
threat ProtocolStateConfusion { cwe: [CWE_349], desc: "Protocol state transition accepts stale untrusted data as trusted data" }
threat LdapInjection { cwe: [CWE_90], desc: "Untrusted data in an LDAP query" }
threat LogInjection { cwe: [CWE_117], desc: "Untrusted data in log output" }
threat NosqlInjection { cwe: [CWE_943], desc: "Untrusted data in a data-query/NoSQL command" }
threat SqlInjection { cwe: [CWE_89], desc: "Untrusted data in a SQL command" }
threat TemplateInjection { cwe: [CWE_1336], desc: "Server-side template injection" }
threat XmlInjection { cwe: [CWE_91], desc: "Untrusted data in an XML document" }
threat XpathInjection { cwe: [CWE_643], desc: "Untrusted data in an XPath query" }
threat Xss { cwe: [CWE_79], desc: "Untrusted data in rendered HTML (cross-site scripting)" }

module memory;
threat BufferOverflow { cwe: [CWE_120], desc: "Classic buffer copy without size check" }
threat DoubleFree { cwe: [CWE_415], desc: "Double free" }
threat IntegerOverflow { cwe: [CWE_190], desc: "Integer overflow/wraparound" }
threat NullDereference { cwe: [CWE_476], desc: "NULL pointer dereference" }
threat OobRead { cwe: [CWE_125], desc: "Out-of-bounds read" }
threat OobWrite { cwe: [CWE_787], desc: "Out-of-bounds write (buffer overflow)" }
threat TypeConfusion { cwe: [CWE_843], desc: "Type confusion" }
threat UninitializedUse { cwe: [CWE_908], desc: "Use of uninitialized resource" }
threat UseAfterFree { cwe: [CWE_416], desc: "Use after free" }

module numeric;
threat DivideByZero { cwe: [CWE_369], desc: "Attacker-controlled denominator can reach division or modulo by zero" }

module path;
threat FileInclusion { cwe: [CWE_98], desc: "Untrusted data controlling an include/require path" }
threat LinkFollowing { cwe: [CWE_59], desc: "Improper link resolution before file access" }
threat PathTraversal { cwe: [CWE_22], desc: "Untrusted data in a filesystem path" }
threat InsecureTempFile { cwe: [CWE_377], desc: "Insecure temporary file (predictable name / race)" }

module request_forgery;
threat Csrf { cwe: [CWE_352], desc: "Cross-site request forgery" }
threat OpenRedirect { cwe: [CWE_601], desc: "Untrusted data controlling a redirect target" }
threat Ssrf { cwe: [CWE_918], desc: "Server-side request forgery" }

module secrets;
threat HardcodedCredentials { cwe: [CWE_798], desc: "Use of hard-coded credentials" }
threat SecretLeak { cwe: [CWE_200], desc: "Exposure of sensitive information" }
threat SensitiveLog { cwe: [CWE_532], desc: "Insertion of sensitive info into log files" }

module session;
threat SessionFixation { cwe: [CWE_384], desc: "Session fixation" }
threat InsecureCookie { cwe: [CWE_614], desc: "Sensitive cookie without Secure/HttpOnly flag" }

module supply_chain;
threat MaliciousCode { cwe: [CWE_506], desc: "Embedded malicious code" }
threat VulnerableDependency { cwe: [CWE_1104], desc: "Use of unmaintained/vulnerable third-party component" }
threat Typosquat { cwe: [CWE_1357], desc: "Reliance on a dependency whose name typosquats a popular package" }

module iac;
threat PrivilegedContainer { cwe: [CWE_250], desc: "Container running privileged / as root (execution with unnecessary privileges)" }
threat HostNamespaceShare { cwe: [CWE_653], desc: "Pod/container shares a host namespace or mounts a host path (weak compartmentalization)" }
threat PublicNetworkExposure { cwe: [CWE_284], desc: "Security group / firewall rule open to 0.0.0.0/0" }
threat WildcardIamPolicy { cwe: [CWE_284], desc: "IAM policy grants wildcard action or resource" }

module validation;
threat ImproperEncoding { cwe: [CWE_116], desc: "Improper encoding/escaping of output" }
threat ImproperInputValidation { cwe: [CWE_20], desc: "Improper input validation" }
threat TrustBoundary { cwe: [CWE_501], desc: "Untrusted data stored across a trust boundary (e.g. into the HTTP session)" }

module smartcontract;
threat ExternalCallInjection { cwe: [CWE_829], desc: "Untrusted address/value in a low-level external call (.call/.delegatecall/.send/.transfer)" }
threat PrivilegedDestruct { cwe: [CWE_284], desc: "Untrusted-reachable selfdestruct/privileged operation" }
threat TxOriginAuth { cwe: [CWE_477], desc: "Authorization via tx.origin (phishing-vulnerable)" }
threat Reentrancy { cwe: [CWE_841], desc: "External call before a state update — reentrancy (checks-effects-interactions violated)" }


module mobile;
threat WebViewInjection { cwe: [CWE_749], desc: "Untrusted data loaded/evaluated in a WebView, or a native bridge exposed to it" }
threat ExportedComponent { cwe: [CWE_926], desc: "Android component exported to other apps without permission (android:exported=\"true\")" }
threat DebuggableBuild { cwe: [CWE_489], desc: "Application shipped with debugging enabled (android:debuggable=\"true\")" }
threat BackupExposure { cwe: [CWE_922], desc: "Sensitive mobile app data can be included in platform backup or restore" }

module desktop;
threat InsecureElectronConfig { cwe: [CWE_829], desc: "Electron renderer with nodeIntegration enabled / contextIsolation disabled (untrusted web content can run Node)" }
