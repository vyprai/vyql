module code;

concept ArchiveEntryRawPrefixContainment : issue {
  cwe: [CWE_22, CWE_184]
  reviewAssumption: "an attacker-controlled archive or filesystem image entry name can contain dot segments or sibling-prefix paths"
  reviewCategory: path
  reviewCondition: "archive entry paths are joined under an extraction directory and checked with raw string-prefix containment"
  reviewConfidence: high
  reviewEvidence: "archive extraction context {pattern} joins an entry filename under the output directory, checks startswith(out_dir), then creates directories or writes files"
  vulnerableTo: [path.PathTraversal, validation.ImproperInputValidation]
}
