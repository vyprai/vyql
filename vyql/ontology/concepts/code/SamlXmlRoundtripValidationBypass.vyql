module code;

concept SamlXmlRoundtripValidationBypass : issue {
  cwe: [CWE_287, CWE_347]
  reviewAssumption: "an attacker can submit a crafted SAML response whose signed XML view differs from the application-unmarshaled assertion view"
  reviewCategory: auth
  reviewCondition: "SAML response handling verifies XML signatures and then unmarshals assertion data without first checking that XML parsing round-trips safely"
  reviewConfidence: high
  reviewEvidence: "SAML HandlePOST context {pattern} decodes, verifies, and unmarshals the response before an observed XML round-trip validation call"
  vulnerableTo: [authentication.ImproperAuthentication, crypto.ImproperSignatureCheck]
}
