module code;

concept JenkinsJellySecretTextboxExposure : issue {
  cwe: [CWE_200, CWE_522]
  reviewAssumption: "normal Jenkins textboxes round-trip and display field values in clear text to users who can view the configuration form"
  reviewCategory: secret
  reviewCondition: "a Jenkins Jelly configuration view renders a secret-like form field with a normal textbox"
  reviewConfidence: high
  reviewEvidence: "Jenkins Jelly form context {pattern} uses f:textbox for a secret, password, token, credential, or key field instead of f:password"
  vulnerableTo: [secrets.SecretLeak]
}
