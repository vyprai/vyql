module code;

concept SamlRelayStateOpenRedirect : issue {
  cwe: [CWE_601]
  reviewAssumption: "IdP-initiated SSO or a crafted SAML flow can provide RelayState and cause an authenticated browser redirect"
  reviewCategory: request_forgery
  reviewCondition: "SAML RelayState is accepted as a post-login redirect URL without a safe-url allowlist"
  reviewConfidence: high
  reviewEvidence: "SAML RelayState context {pattern} parses relay_state and returns it as next_url when it has a scheme, netloc, or absolute path"
  vulnerableTo: [request_forgery.OpenRedirect]
}
