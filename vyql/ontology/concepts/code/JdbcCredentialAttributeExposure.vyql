module code;

concept JdbcCredentialAttributeExposure : issue {
  cwe: [CWE_200, CWE_522]
  reviewAssumption: "database-name fields may be visible in protocol metadata, logs, or DatabaseMetaData.getURL output while credentials should travel only through the authentication mechanism"
  reviewCategory: secret
  reviewCondition: "JDBC URL or connection properties preserve user/password attributes in a database-name or metadata URL path"
  reviewConfidence: high
  reviewEvidence: "JDBC driver connection context {pattern} forwards parsed URL/properties attributes to the database name without filtering credential keys"
  vulnerableTo: [secrets.SecretLeak]
}
