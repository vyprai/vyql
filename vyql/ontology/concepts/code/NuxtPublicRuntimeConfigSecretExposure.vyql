module code;

concept NuxtPublicRuntimeConfigSecretExposure : issue {
  cwe: [CWE_200, CWE_522]
  review_assumption: "Nuxt public runtime config is serialized to client-side application code or otherwise readable by untrusted users"
  reviewCategory: secret
  reviewCondition: "a Nuxt module merges a token, credential, or secret-bearing config object into public runtimeConfig"
  reviewConfidence: high
  reviewEvidence: "Nuxt module context {pattern} passes a secret-bearing config object into runtimeConfig.public through a merge helper"
  vulnerableTo: [secrets.SecretLeak]
}
