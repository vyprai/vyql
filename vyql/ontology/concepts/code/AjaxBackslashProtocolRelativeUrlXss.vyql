module code;

concept AjaxBackslashProtocolRelativeUrlXss : issue {
  cwe: [CWE_79]
  review_assumption: "attacker-controlled links or hashes can supply a /\\ host-prefixed URL whose response is inserted into the page"
  reviewCategory: xss
  reviewCondition: "AJAX URL validation blocks ordinary protocol-relative URLs but misses browser-normalized backslash variants"
  reviewConfidence: high
  reviewEvidence: "AJAX pagination context {pattern} checks url[0] and url[1] before $.ajax and HTML replacement without a startsWith(\"/\\\\\") guard"
  vulnerableTo: [injection.Xss]
}
