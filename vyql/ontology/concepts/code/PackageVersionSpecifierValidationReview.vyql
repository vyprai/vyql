module code;

concept PackageVersionSpecifierValidationReview : issue {
  cwe: [CWE_20, CWE_94]
  review_assumption: "project metadata or action inputs can influence the dependency specifier passed to the package installer"
  reviewCategory: supply_chain
  reviewCondition: "package version specifier validation accepts arbitrary trailing dependency syntax"
  reviewConfidence: medium
  reviewEvidence: "package specifier validation context {pattern} uses a permissive regex before installation"
  vulnerableTo: [validation.ImproperInputValidation, injection.CodeInjection]
}
