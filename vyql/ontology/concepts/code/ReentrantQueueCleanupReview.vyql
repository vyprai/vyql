module code;

concept ReentrantQueueCleanupReview : issue {
  cwe: [CWE_415, CWE_416]
  reviewAssumption: "a callback invoked during queue cleanup can reenter cancellation for an operation still owned by the cleanup traversal"
  reviewCategory: memory
  reviewCondition: "queue cleanup and cancellation can both own queued entries without an observed reentrant cleanup guard"
  reviewConfidence: medium
  reviewEvidence: "queue-cancel context {pattern} removes queued operations and destroys them without a disconnect-cleanup diversion"
  vulnerableTo: [memory.DoubleFree, memory.UseAfterFree]
}
