module code;

concept LocalFileUrlNavigation : issue {
  cwe: [CWE_22]
  review_assumption: "the request URL can use the file:// protocol and the rendered output is returned to the caller"
  reviewCategory: path
  reviewCondition: "caller-controlled file URLs can be navigated by a headless browser and expose local file contents"
  reviewConfidence: medium
  reviewEvidence: "headless-browser navigation context {pattern} passes a request URL to page navigation without an observed file-protocol branch"
  vulnerableTo: [path.PathTraversal]
}
