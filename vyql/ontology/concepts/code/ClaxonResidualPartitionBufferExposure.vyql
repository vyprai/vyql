module code;

concept ClaxonResidualPartitionBufferExposure : issue {
  cwe: [CWE_908]
  reviewAssumption: "a malformed FLAC bitstream can choose a partition order that leaves part of the decoded output buffer uninitialized"
  reviewCategory: memory
  reviewCondition: "residual partition decoding slices the sample buffer by a bitstream-derived partition count without first proving the block size divides evenly"
  reviewConfidence: high
  reviewEvidence: "Claxon residual decoder context {pattern} derives n_partitions and n_samples, slices buffer[start..start + len], and calls both Rice partition decoders without a partition-order guard"
  vulnerableTo: [memory.UninitializedUse]
}
