module code;

concept InternalAssetRoutePathTraversal : issue {
  cwe: [CWE_22]
  reviewAssumption: "the routed path suffix can contain traversal segments that escape the intended package asset directory"
  reviewCategory: path
  reviewCondition: "an internal static-asset route joins the requested suffix under a package asset directory without canonical containment"
  reviewConfidence: high
  reviewEvidence: "static asset handler context {pattern} slices a route prefix into a filename, joins it under an asset directory, and serves the file before realpath/root checks"
  vulnerableTo: [path.PathTraversal]
}
