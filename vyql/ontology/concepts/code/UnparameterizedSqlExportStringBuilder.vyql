module code;

concept UnparameterizedSqlExportStringBuilder : issue {
  cwe: [CWE_89]
  review_assumption: "exported metric names, keys, process names, or values can contain attacker-controlled SQL metacharacters"
  reviewCategory: sql
  reviewCondition: "database export code assembles CREATE or INSERT statements from runtime table, column, or value lists and executes them without parameterization"
  reviewConfidence: high
  reviewEvidence: "SQL export context {pattern} builds query strings from collected values before executing them without sql.Identifier/sql.Placeholder or executemany-style binding"
  vulnerableTo: [injection.SqlInjection]
}
