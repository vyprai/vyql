module code;

concept HtmlSanitizerLogicReview : issue {
  cwe: [CWE_79]
  reviewAssumption: "the parsed HTML may be attacker-controlled and the cleaned serialization is trusted by callers"
  reviewCategory: xss
  reviewCondition: "review HTML sanitizer/parser raw-text, comment-preservation, and serialization behavior for sanitizer-bypass or mutation-XSS cases"
  reviewConfidence: possibility
  reviewEvidence: "HTML parser/sanitizer operation {pattern} is part of the cleaned-output pipeline"
  vulnerableTo: [injection.Xss]
}
