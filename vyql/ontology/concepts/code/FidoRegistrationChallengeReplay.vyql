module code;

concept FidoRegistrationChallengeReplay : issue {
  cwe: [CWE_294]
  reviewAssumption: "an attacker can replay a captured or previously issued registration response while the session challenge remains reusable"
  reviewCategory: auth
  reviewCondition: "FIDO/WebAuthn registration challenge is reused after successful registration"
  reviewConfidence: high
  reviewEvidence: "FIDO registration context {pattern} passes request.session['fido_state'] to register_complete and saves a credential without invalidating the session challenge"
  vulnerableTo: [authentication.AuthenticationBypass]
}
