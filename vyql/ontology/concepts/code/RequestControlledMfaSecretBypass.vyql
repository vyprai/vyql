module code;

concept RequestControlledMfaSecretBypass : issue {
  cwe: [CWE_287, CWE_288]
  reviewAssumption: "an attacker can supply the request secret and corresponding code during the MFA step"
  reviewCategory: auth
  reviewCondition: "MFA verification accepts a secret from request data when the trusted session secret is missing"
  reviewConfidence: high
  reviewEvidence: "MFA service construction context {pattern} falls back from session state to request data for the TOTP secret"
  vulnerableTo: [authentication.AuthenticationBypass]
}
