module code;

concept UnderwidthFormattedIndex : issue {
  cwe: [CWE_192, CWE_125]
  review_assumption: "the formatted numeric value can be small enough to produce the minimum-width string"
  reviewCategory: numeric
  reviewCondition: "formatted numeric output may be shorter than a later fixed index expects"
  reviewConfidence: medium
  reviewEvidence: "format/index context {pattern} indexes a formatted value beyond the requested minimum width"
  vulnerableTo: [memory.OobRead]
}
