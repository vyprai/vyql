module code;

concept ClockworkWebJobCsrf : issue {
  cwe: [CWE_352]
  review_assumption: "the job action is reachable through the mounted Rails engine POST route"
  reviewCategory: csrf
  reviewCondition: "Clockwork Web job enable/disable action lacks a Rails forgery-protection guard"
  reviewConfidence: high
  reviewEvidence: "Ruby controller context {pattern} reads params[:job]/params[:enable] and calls ClockworkWeb.enable/disable without protect_from_forgery"
  vulnerableTo: [request_forgery.Csrf]
}
