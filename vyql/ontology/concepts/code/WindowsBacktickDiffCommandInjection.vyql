module code;

concept WindowsBacktickDiffCommandInjection : issue {
  cwe: [CWE_78, CWE_88]
  reviewAssumption: "library callers can supply diff options or file path values containing shell metacharacters on Windows"
  reviewCategory: command
  reviewCondition: "a Windows-specific diff execution path builds one shell string from options and file paths before executing it with backticks"
  reviewConfidence: high
  reviewEvidence: "Ruby diff execution context {pattern} formats diff options and paths into a command string and evaluates it through shell backticks"
  vulnerableTo: [injection.CommandInjection, injection.ArgumentInjection]
}
