module code;

concept UnauthenticatedCredentialEnrollmentPath : issue {
  cwe: [CWE_306, CWE_862, CWE_284]
  reviewAssumption: "any client can reach a request path the authentication middleware exempts, holding no session and presenting no credential"
  reviewCategory: auth
  reviewCondition: "a request-path allowlist that skips the authentication middleware names a credential-enrollment endpoint, so an unauthenticated client can bind a new passkey, security key or second factor to an account and then authenticate as it"
  reviewConfidence: high
  reviewEvidence: "unauthenticated-path allowlist context {pattern} lists a passkey, WebAuthn or MFA enrollment path among the paths that skip authentication"
  vulnerableTo: [authentication.MissingAuthentication, access_control.MissingAuthorization]
}
