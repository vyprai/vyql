module code;

concept UnescapedHtmlOptionRenderer : issue {
  cwe: [CWE_79]
  reviewAssumption: "the rendered option label can contain stored or attacker-provided text"
  reviewCategory: xss
  reviewCondition: "a frontend option renderer returns HTML containing model fields without escaping"
  reviewConfidence: medium
  reviewEvidence: "HTML renderer {pattern} returns option markup"
  vulnerableTo: [injection.Xss]
}
