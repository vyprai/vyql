module code;

concept IncompleteCommandEscapeRegex : issue {
  cwe: [CWE_77]
  reviewAssumption: "attacker-controlled command fragments can include shell metacharacters that survive the sanitizer"
  reviewCategory: command
  reviewCondition: "command sanitizer regex omits intended shell metacharacters, either by alternation where a character class is required or by escaping the separator metacharacters while leaving line terminators unescaped"
  reviewConfidence: high
  reviewEvidence: "command escape helper {pattern} feeds a shell command execution site with metacharacters its patterns do not neutralize"
  vulnerableTo: [injection.CommandInjection]
}
