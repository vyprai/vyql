module code;

concept IncompleteCommandEscapeRegex : issue {
  cwe: [CWE_77]
  reviewAssumption: "attacker-controlled command fragments can include shell metacharacters that survive the sanitizer"
  reviewCategory: command
  reviewCondition: "command sanitizer regex omits intended shell metacharacters because alternation is used instead of a character class"
  reviewConfidence: high
  reviewEvidence: "command escape helper {pattern} feeds a shell command execution site"
  vulnerableTo: [injection.CommandInjection]
}
