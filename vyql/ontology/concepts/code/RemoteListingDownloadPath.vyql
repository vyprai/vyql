module code;

concept RemoteListingDownloadPath : issue {
  cwe: [CWE_22]
  review_assumption: "the remote server can provide listing names containing path separators or traversal components"
  reviewCategory: path
  reviewCondition: "remote directory listing filenames are joined into local download paths without rejecting path components"
  reviewConfidence: medium
  reviewEvidence: "recursive download context {pattern} combines a local directory with a remote listing filename"
  vulnerableTo: [path.PathTraversal]
}
