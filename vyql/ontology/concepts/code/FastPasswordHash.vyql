module code;

concept FastPasswordHash : issue {
  cwe: [CWE_328]
  review_assumption: "an attacker who obtains the stored hash can perform offline guessing more cheaply than with a password hashing KDF"
  reviewCategory: crypto
  reviewCondition: "stored passwords are generated or verified with a fast general-purpose hash instead of a password hashing KDF"
  reviewConfidence: high
  reviewEvidence: "password hashing context {pattern} uses SHA-style hashing for password storage or comparison without bcrypt, scrypt, or Argon2"
  vulnerableTo: [crypto.WeakHash]
}
