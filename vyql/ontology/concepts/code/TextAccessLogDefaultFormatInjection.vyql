module code;

concept TextAccessLogDefaultFormatInjection : issue {
  cwe: [CWE_117, CWE_150]
  reviewAssumption: "generated access logs include request headers or paths supplied by remote clients and are consumed as structured log records"
  reviewCategory: injection
  reviewCondition: "a proxy access-log translator defaults to text formatting instead of structured JSON formatting"
  reviewConfidence: high
  reviewEvidence: "access-log translator context {pattern} constructs a default text-format access log, allowing request-derived log fields to be rendered without JSON escaping"
  vulnerableTo: [injection.LogInjection]
}
