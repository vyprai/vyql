module code;

concept HardcodedSecretLiteral : issue {
  cwe: [CWE_798]
  reviewAssumption: "the source tree is readable by someone who should not hold the secret"
  reviewCategory: secret
  reviewCondition: "a secret-named binding is assigned a non-trivial literal in source"
  reviewConfidence: medium
  reviewEvidence: "secret assignment {pattern} carries a literal value"
  vulnerableTo: [access_control.IncorrectAuthorization]
}
