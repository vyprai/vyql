module code;

concept WildcardAuthScopeCredentialRegistration : issue {
  cwe: [CWE_200, CWE_522]
  reviewAssumption: "the HTTP client contacts more during the session than the endpoint the credentials were configured for -- a redirect target, a mirror, any second repository -- and the credential provider serves the registered credentials to whichever host its scope matches"
  reviewCategory: secret
  reviewCondition: "an HTTP credential registration is scoped by Apache HttpClient's wildcard host or port constants instead of the host the credentials are meant for, so every host the client contacts can claim them"
  reviewConfidence: high
  reviewEvidence: "credential-configuring class {pattern} passes AuthScope.ANY_HOST or AuthScope.ANY_PORT into a call while registering credentials through CredentialsProvider.setCredentials, so the registration's scope matches any host"
  vulnerableTo: [secrets.SecretLeak]
}
