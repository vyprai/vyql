module code;

concept RelativeOnlyFilenameValidation : issue {
  cwe: [CWE_22, CWE_184]
  review_assumption: "the validated filename may later be resolved by file access code that treats absolute paths as escaping the intended base directory"
  reviewCategory: path
  reviewCondition: "filename validation rejects parent-directory traversal but still permits absolute path forms"
  reviewConfidence: high
  reviewEvidence: "filename validation context {pattern} checks for '../' and an allowlist regex while lacking an absolute-path rejection"
  vulnerableTo: [path.PathTraversal, validation.ImproperInputValidation]
}
