module code;

concept ForgeableIdentityToken : issue {
  cwe: [CWE_345, CWE_639]
  reviewAssumption: "the encoded value is accepted as proof of identity"
  reviewCategory: authentication
  reviewCondition: "a reversible encoding is used as an identity credential without integrity protection"
  reviewConfidence: high
  reviewEvidence: "authentication module {pattern} issues and accepts a reversible identity token"
  vulnerableTo: [authentication.ImproperAuthentication, access_control.Idor]
}
