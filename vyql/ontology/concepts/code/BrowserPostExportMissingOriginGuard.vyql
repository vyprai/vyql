module code;

concept BrowserPostExportMissingOriginGuard : issue {
  cwe: [CWE_352, CWE_346]
  reviewAssumption: "the route is reachable from a browser context and the export operation writes or exposes local emulator/project data"
  reviewCategory: request
  reviewCondition: "a browser-reachable POST export endpoint performs filesystem or emulator export work without checking Origin or an equivalent CSRF guard"
  reviewConfidence: high
  reviewEvidence: "POST export context {pattern} reads request-body export path data and calls an export operation without an Origin/CSRF guard"
  vulnerableTo: [request_forgery.Csrf, access_control.OriginValidationError]
}
