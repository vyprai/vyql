module code;

concept CloudBaseOpenUrlSsrf : issue {
  cwe: [CWE_918]
  reviewAssumption: "the interactive open-url endpoint is reachable by a remote or browser-backed attacker"
  reviewCategory: request_forgery
  reviewCondition: "CloudBase MCP open-url endpoint accepts a request-body URL before SSRF validation"
  reviewConfidence: high
  reviewEvidence: "interactive-server route context {pattern} reads req.body.url and calls openUrl without the fixed isUrlSafeToOpen validation"
  vulnerableTo: [request_forgery.Ssrf]
}
