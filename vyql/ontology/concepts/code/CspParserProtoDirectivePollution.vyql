module code;

concept CspParserProtoDirectivePollution : issue {
  cwe: [CWE_1321]
  review_assumption: "an attacker can supply a Content-Security-Policy header or string containing a __proto__ directive"
  reviewCategory: prototype_pollution
  reviewCondition: "content-security-policy-parser stores a __proto__ directive on a plain object result"
  reviewConfidence: high
  reviewEvidence: "CSP parser context {pattern} creates a normal object result and uses Object.defineProperty to preserve a __proto__ directive value"
  vulnerableTo: [injection.PrototypePollution]
}
