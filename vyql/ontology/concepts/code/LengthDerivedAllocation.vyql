module code;

concept LengthDerivedAllocation : issue {
  cwe: [CWE_400, CWE_789]
  reviewAssumption: "the encoded length can be attacker-controlled and larger than the remaining input"
  reviewCategory: resource
  reviewCondition: "parsed length controls allocation before the available input bytes are proven"
  reviewConfidence: medium
  reviewEvidence: "length-derived allocation context {pattern} allocates a buffer and then reads bytes into it"
  vulnerableTo: [dos.UncontrolledResourceConsumption]
}
