module code;

concept PrefixWildcardKeyEnumeration : issue {
  cwe: [CWE_22, CWE_200]
  reviewAssumption: "the requested key can be a prefix of other records that should not be included in the export or read response"
  reviewCategory: path
  reviewCondition: "key-value store wildcard enumeration appends '*' directly to an attacker-selected key prefix"
  reviewConfidence: high
  reviewEvidence: "key enumeration context {pattern} calls findKeys with a namespace prefix plus user key plus '*' and then reads each returned record"
  vulnerableTo: [path.PathTraversal, secrets.SecretLeak]
}
