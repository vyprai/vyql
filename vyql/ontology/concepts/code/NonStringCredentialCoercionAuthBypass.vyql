module code;

concept NonStringCredentialCoercionAuthBypass : issue {
  cwe: [CWE_305, CWE_1287]
  reviewAssumption: "the caller chooses the credential's runtime type, and the database compares a character column against a non-string bound parameter by coercing the column rather than the parameter"
  reviewCategory: auth
  reviewCondition: "a secret authenticated by a database equality lookup, whose match then authorises a login with no password argument, reaches that lookup from a parameter carrying no scalar type declaration or guard"
  reviewConfidence: high
  reviewEvidence: "login handler context {pattern} spends a credential parameter of unconstrained type on a cookie-string lookup and treats the match as identity, logging the named user in without a password"
  vulnerableTo: [authentication.AuthenticationBypass]
}
