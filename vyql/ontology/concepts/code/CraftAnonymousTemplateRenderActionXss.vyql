module code;

concept CraftAnonymousTemplateRenderActionXss : issue {
  cwe: [CWE_79]
  review_assumption: "a direct action request can reach the template renderer and cause attacker-controlled template output to be served to a browser"
  reviewCategory: xss
  reviewCondition: "Craft CMS exposes the anonymous TemplatesController render action without rejecting direct /templates action access"
  reviewConfidence: high
  reviewEvidence: "TemplatesController context {pattern} allows anonymous actionRender() to render a requested template"
  vulnerableTo: [injection.Xss]
}
