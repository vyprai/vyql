module code;

concept ColorscoreImagemagickCommandInjection : issue {
  cwe: [CWE_78]
  reviewAssumption: "library callers can pass attacker-controlled image_path, colors, or depth values containing shell metacharacters"
  reviewCategory: "command-injection"
  reviewCondition: "colorscore interpolates image path and quantization options directly into an ImageMagick shell command"
  reviewConfidence: high
  reviewEvidence: "Histogram initialize context {pattern} builds a backtick convert command with image_path, colors, and depth before shellescape/to_i hardening"
  vulnerableTo: [injection.CommandInjection]
}
