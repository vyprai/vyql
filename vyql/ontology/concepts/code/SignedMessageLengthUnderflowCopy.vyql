module code;

concept SignedMessageLengthUnderflowCopy : issue {
  cwe: [CWE_121, CWE_122, CWE_191]
  reviewAssumption: "callers can supply a short signed message length, causing unsigned underflow and an oversized copy"
  reviewCategory: memory
  reviewCondition: "signed-message open logic subtracts signature size from the supplied signed-message length before checking that the signed message is at least that long"
  reviewConfidence: high
  reviewEvidence: "signature-open context {pattern} computes message length from signed length minus signature size and then copies that derived length"
  vulnerableTo: [memory.OobWrite, memory.IntegerOverflow]
}
