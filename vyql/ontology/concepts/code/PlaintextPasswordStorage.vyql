module code;

concept PlaintextPasswordStorage : issue {
  cwe: [CWE_256, CWE_312, CWE_916]
  reviewAssumption: "the column holds a real credential rather than an opaque handle"
  reviewCategory: secret
  reviewCondition: "a password column is declared as a plain string type with no hashing"
  reviewConfidence: medium
  reviewEvidence: "model column {pattern} stores a password in the clear"
  vulnerableTo: [crypto.CleartextStorage]
}
