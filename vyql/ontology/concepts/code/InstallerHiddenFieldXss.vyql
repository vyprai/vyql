module code;

concept InstallerHiddenFieldXss : issue {
  cwe: [CWE_79]
  reviewAssumption: "the installer step can receive attacker-controlled uchidden state"
  reviewCategory: xss
  reviewCondition: "installer form renders a hidden-field value from preserved request state without HTML escaping"
  reviewConfidence: high
  reviewEvidence: "installer next-step context {pattern} echoes uchidden into a hidden input before dhtmlspecialchars validation"
  vulnerableTo: [injection.Xss]
}
