module code;

concept McpToolCommandTemplateExecution : issue {
  cwe: [CWE_77, CWE_78]
  review_assumption: "MCP tool callers can provide argument values that reach the handler"
  reviewCategory: command
  reviewCondition: "MCP tool handler parameters are interpolated into child_process.exec command templates"
  reviewConfidence: high
  reviewEvidence: "MCP tool handler context {pattern} formats a tool argument into a shell command template"
  vulnerableTo: [injection.CommandInjection]
}
