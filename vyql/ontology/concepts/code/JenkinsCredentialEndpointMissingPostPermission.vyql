module code;

concept JenkinsCredentialEndpointMissingPostPermission : issue {
  cwe: [CWE_862, CWE_352]
  reviewAssumption: "the Stapler doCreate/doCheck/doTest endpoint is reachable from users with less privilege than Overall/Administer or from CSRF-triggerable requests"
  reviewCategory: auth
  reviewCondition: "Jenkins descriptor endpoint creates or tests external credentials without requiring POST and an administrator permission check"
  reviewConfidence: high
  reviewEvidence: "credential endpoint context {pattern} handles token creation or remote repository/account tests before observed @POST and checkPermission/hasPermission guards"
  vulnerableTo: [access_control.MissingAuthorization, request_forgery.Csrf]
}
