module code;

concept SecretFilePermissionReview : issue {
  cwe: [CWE_522, CWE_732]
  reviewAssumption: "the helper may create the private key file with permissions broader than intended"
  reviewCategory: secret
  reviewCondition: "secret or key material is generated without an observed restrictive file-permission hardening call"
  reviewConfidence: possibility
  reviewEvidence: "key-generation context {pattern} does not include a chmod-style permission hardening call"
  vulnerableTo: [secrets.SecretLeak, access_control.InsecurePermission]
}
