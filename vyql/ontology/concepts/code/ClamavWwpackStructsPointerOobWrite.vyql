module code;

concept ClamavWwpackStructsPointerOobWrite : issue {
  cwe: [CWE_787]
  reviewAssumption: "a malformed packed executable can make the derived section-table pointer or section count exceed the rewritten executable buffer"
  reviewCategory: memory
  reviewCondition: "WWPack section headers are rewritten through a computed structs pointer without checking it remains inside the executable buffer"
  reviewConfidence: high
  reviewEvidence: "WWPack unpacker context {pattern} derives structs from PE header data, writes section records, advances by 0x28, and zeroes the next record"
  vulnerableTo: [memory.OobWrite]
}
