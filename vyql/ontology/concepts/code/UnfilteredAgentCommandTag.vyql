module code;

concept UnfilteredAgentCommandTag : issue {
  cwe: [CWE_94]
  review_assumption: "model output or imported content can contain command tags that later drive agent/tool execution or unsafe preview behavior"
  reviewCategory: code_execution
  reviewCondition: "AI/agent command tags are not included in the custom-tag parser allowlist and can fall through to rendered markdown or output"
  reviewConfidence: high
  reviewEvidence: "custom tag parser context {pattern} handles write/edit/SQL-style control tags but omits the command tag from parser and render suppression"
  vulnerableTo: [injection.CodeInjection]
}
