module code;

concept SensitiveDataInResponse : issue {
  cwe: [CWE_200, CWE_312]
  reviewAssumption: "the field is not intended for the caller"
  reviewCategory: secret
  reviewCondition: "credential or token material is serialized into an HTTP response"
  reviewConfidence: medium
  reviewEvidence: "response {pattern} carries credential material"
  vulnerableTo: [crypto.CleartextStorage]
}
