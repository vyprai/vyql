module code;

concept BufReadDiscardLoopWithoutEofGuard : issue {
  cwe: [CWE_400, CWE_835]
  reviewAssumption: "the input can end before the requested discard length, making fill_buf return an empty buffer while the loop condition remains true"
  reviewCategory: resource
  reviewCondition: "a buffered-read discard loop can consume zero bytes at EOF without reducing the remaining length"
  reviewConfidence: high
  reviewEvidence: "buffered discard context {pattern} derives consume length from fill_buf and subtracts the consumed length without an empty-buffer EOF guard"
  vulnerableTo: [dos.UncontrolledResourceConsumption]
}
