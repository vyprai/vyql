module code;

concept DesktopProtocolRedirectWithoutAllowlist : issue {
  cwe: [CWE_601, CWE_20]
  review_assumption: "the desktop-link URL can be influenced by workspace, IDE, or caller-controlled service state"
  reviewCategory: request_forgery
  reviewCondition: "desktop deep-link redirect logic allows every non-http(s) protocol instead of an explicit trusted protocol allowlist"
  reviewConfidence: high
  reviewEvidence: "desktop redirect context {pattern} parses a URL, rejects http/https only, and assigns the original URL to window.location.href"
  vulnerableTo: [request_forgery.OpenRedirect, validation.ImproperInputValidation]
}
