module code;

concept BladeRawMarkdownRenderWithoutSanitizer : issue {
  cwe: [CWE_79]
  review_assumption: "the rendered content can be supplied by a lower-trust dashboard/editor user and viewed by another user"
  reviewCategory: xss
  reviewCondition: "Blade templates render content-like data through Markdown in a raw echo without stripping or escaping HTML"
  reviewConfidence: high
  reviewEvidence: "Blade template context {pattern} uses raw echo Markdown rendering for stored content without strip_tags, htmlspecialchars, e(), or a sanitizer"
  vulnerableTo: [injection.Xss]
}
