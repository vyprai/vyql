module code;

concept SensitiveTempFileDefaultPermission : issue {
  cwe: [CWE_200, CWE_522, CWE_732]
  reviewAssumption: "the temporary directory may be shared with local users while the helper file exists"
  reviewCategory: secret
  reviewCondition: "credential or private-key helper material is written to a temporary file without owner-only permissions"
  reviewConfidence: high
  reviewEvidence: "sensitive temp-file context {pattern} creates a default-permission temporary file and writes private key, passphrase, or password material before an observed owner-only permission setting"
  vulnerableTo: [secrets.SecretLeak, access_control.InsecurePermission]
}
