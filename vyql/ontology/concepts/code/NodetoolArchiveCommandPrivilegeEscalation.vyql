module code;

concept NodetoolArchiveCommandPrivilegeEscalation : issue {
  cwe: [CWE_269, CWE_78]
  reviewAssumption: "a lower-privileged operator with JMX/nodetool access can invoke the logging endpoint with an archive command"
  reviewCategory: auth
  reviewCondition: "JMX/nodetool users can supply a local archive command that runs as the Cassandra process user"
  reviewConfidence: medium
  reviewEvidence: "full query logging context {pattern} forwards the archive command without requiring the nodetool archive-command opt-in"
  vulnerableTo: [access_control.PrivilegeEscalation, injection.CommandInjection]
}
