module code;

concept OverbroadRolePermissionGrant : issue {
  cwe: [CWE_269, CWE_863]
  review_assumption: "the role can be held by a lower-privileged operator and the granted operation should be admin-only or separately scoped"
  reviewCategory: auth
  reviewCondition: "a non-admin or read-only role permission table grants configuration, backup, restore, or similarly privileged operational permissions"
  reviewConfidence: high
  reviewEvidence: "role permission context {pattern} assigns privileged operations to a lower-privileged role or scope list"
  vulnerableTo: [access_control.PrivilegeEscalation, access_control.IncorrectAuthorization]
}
