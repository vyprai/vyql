module code;

concept FullSizeMediaFileMissingViewFullAuthorization : issue {
  cwe: [CWE_862, CWE_863]
  reviewAssumption: "full/original media files are more sensitive than thumbnails or resized derivatives and require a distinct permission"
  reviewCategory: access_control
  reviewCondition: "a media/data file endpoint serves the original full-size file with only generic view authorization instead of a stronger full-view permission"
  reviewConfidence: high
  reviewEvidence: "file-serving context {pattern} accepts a full-size option, resolves the original file path, and streams file bytes without an observed view_full-style authorization check"
  vulnerableTo: [access_control.MissingAuthorization, access_control.IncorrectAuthorization]
}
