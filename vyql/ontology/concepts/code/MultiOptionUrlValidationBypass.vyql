module code;

concept MultiOptionUrlValidationBypass : issue {
  cwe: [CWE_601]
  review_assumption: "the validated URL is later used as an authentication callback or redirect target"
  reviewCategory: request_forgery
  reviewCondition: "multi-option authentication URL validation accepts absolute URLs without host allowlisting"
  reviewConfidence: medium
  reviewEvidence: "URL validation context {pattern} checks URL syntax but does not validate the callback host"
  vulnerableTo: [request_forgery.OpenRedirect]
}
