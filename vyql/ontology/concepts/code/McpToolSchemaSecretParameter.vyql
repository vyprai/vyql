module code;

concept McpToolSchemaSecretParameter : issue {
  cwe: [CWE_200, CWE_522, CWE_532]
  reviewAssumption: "an MCP tool argument is produced by the model, so it is carried in the tool-call JSON, over the MCP transport, and into whatever conversation transcript or debug log the host keeps"
  reviewCategory: secret
  reviewCondition: "an MCP tool input schema declares a parameter that carries key material such as a mnemonic, a private key, a passphrase or an API token, instead of an opaque handle to a secret the server already holds"
  reviewConfidence: high
  reviewEvidence: "MCP tool registration context {pattern} declares a schema property whose name is key material"
  vulnerableTo: [secrets.SecretLeak, crypto.CleartextStorage]
}
