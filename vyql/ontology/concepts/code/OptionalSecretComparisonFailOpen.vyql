module code;

concept OptionalSecretComparisonFailOpen : issue {
  cwe: [CWE_287, CWE_1188]
  reviewAssumption: "the configuration read is optional or its schema is not enforced, so a deployment can reach the comparison with it unset, and interpolating or defaulting an unset value yields a guessable literal the caller can send verbatim"
  reviewCategory: auth
  reviewCondition: "a credential comparison builds its expected side from an environment or configuration read while no fail-closed presence check on that read guards the decision"
  reviewConfidence: high
  reviewEvidence: "credential comparison {pattern} derives its expected side from a configuration read with no presence guard on that read in the deciding function"
  vulnerableTo: [authentication.ImproperAuthentication, authentication.AuthenticationBypass]
}
