module code;

concept UnboundedFileReadIntoFixedBuffer : issue {
  cwe: [CWE_787, CWE_121]
  reviewAssumption: "the file content can contain more bytes than the fixed buffer capacity before termination is reached"
  reviewCategory: memory
  reviewCondition: "a repeated file read writes into a fixed-size stack buffer through an unbounded index"
  reviewConfidence: high
  reviewEvidence: "file-read buffer fill context {pattern} writes fgetc output into a fixed buffer without a capacity guard"
  vulnerableTo: [memory.OobWrite]
}
