module code;

concept FeehiUsernameStoredXss : issue {
  cwe: [CWE_79]
  review_assumption: "stored usernames can be controlled by a user and rendered when posts are browsed"
  reviewCategory: xss
  reviewCondition: "Feehi CMS frontend users expose stored usernames without the afterFind HTML-encoding hook"
  reviewConfidence: high
  reviewEvidence: "frontend user model context {pattern} contains username validation and labels but lacks Html::encode on username after load"
  vulnerableTo: [injection.Xss]
}
