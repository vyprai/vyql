module code;

concept ReconfirmationDirtyTrackingRace : issue {
  cwe: [CWE_362, CWE_287]
  review_assumption: "concurrent attacker-triggered reconfirmation requests can interleave writes to the confirmation token and pending email"
  reviewCategory: race
  reviewCondition: "a reconfirmation flow regenerates the confirmation token while restoring the persisted email and assigning the pending email without forcing the pending-email write"
  reviewConfidence: high
  reviewEvidence: "reconfirmation context {pattern} mutates unconfirmed_email and confirmation_token without a dirty-tracking write marker"
  vulnerableTo: [concurrency.RaceCondition, authentication.AuthenticationBypass]
}
