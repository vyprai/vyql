module code;

concept SizeComputation : sink {
  cwe: [CWE_190]
  enabledBy: [taint.UntrustedData]
  review_assumption: "the value is not range-checked before memory use"
  reviewCategory: numeric
  reviewCondition: "attacker-controlled size feeds allocation or bounds-sensitive operation"
  reviewConfidence: medium
  reviewEvidence: "size argument to {pattern} is tainted"
  vulnerableTo: [memory.IntegerOverflow]
}
