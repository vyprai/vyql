module code;

concept UnboundedCopySmell : issue {
  cwe: [CWE_787, CWE_120]
  review_assumption: "an attacker can influence source length or destination capacity is insufficient"
  reviewCategory: memory
  reviewCondition: "an unbounded copy can overflow its destination"
  reviewConfidence: low
  reviewEvidence: "unsafe copy primitive {pattern} is present"
  vulnerableTo: [memory.OobWrite]
}
