module code;

concept ComposerGitBranchDiffCommandInjection : issue {
  cwe: [CWE_78, CWE_88]
  review_assumption: "a dependency installed from source can contain specially crafted local or remote Git branch names"
  reviewCategory: command
  reviewCondition: "Composer formats Git branch names into a git diff shell command instead of passing argv"
  reviewConfidence: high
  reviewEvidence: "getUnpushedChanges context {pattern} builds git diff --name-status from remoteBranch and branch before ProcessExecutor::execute"
  vulnerableTo: [injection.CommandInjection, injection.ArgumentInjection]
}
