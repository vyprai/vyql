module code;

concept GitCloneBranchOptionShellInjection : issue {
  cwe: [CWE_78, CWE_88]
  reviewAssumption: "repository branch names can be attacker-controlled or supplied by untrusted project metadata"
  reviewCategory: command
  reviewCondition: "a git clone shell command interpolates a branch name into the --branch option without shell escaping"
  reviewConfidence: high
  reviewEvidence: "git clone context {pattern} builds --branch from an interpolated branch value before SharedHelpers.run_shell_command without Shellwords or argv execution"
  vulnerableTo: [injection.CommandInjection, injection.ArgumentInjection]
}
