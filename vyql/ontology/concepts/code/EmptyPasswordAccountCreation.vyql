module code;

concept EmptyPasswordAccountCreation : issue {
  cwe: [CWE_287, CWE_521]
  reviewAssumption: "an optional form field cleans to the empty string, and a password backend treats the empty string as a value, so only absence carried as null keeps the account unloginable by password"
  reviewCategory: auth
  reviewCondition: "a signup or password-setting flow makes a password form field optional at runtime and passes the field's cleaned value into account creation or a password setter without consulting the field's required-ness or the value's emptiness"
  reviewConfidence: high
  reviewEvidence: "signup context {pattern} makes the password form field optional and consumes its cleaned value into user creation with no required-ness or emptiness check"
  vulnerableTo: [authentication.ImproperAuthentication, authentication.AuthenticationBypass]
}
