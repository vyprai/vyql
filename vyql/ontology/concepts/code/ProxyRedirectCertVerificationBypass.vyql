module code;

concept ProxyRedirectCertVerificationBypass : issue {
  cwe: [CWE_295]
  reviewAssumption: "an HTTPS redirect can be followed while the client is configured to use an HTTP proxy"
  reviewCategory: crypto
  reviewCondition: "redirect client construction disables TLS certificate or hostname verification for proxied HTTPS redirects instead of preserving the caller's verification settings"
  reviewConfidence: high
  reviewEvidence: "HTTPS redirect client context {pattern} configures proxy handling and calls certificate and hostname verification toggles with false before following the redirected request"
  vulnerableTo: [crypto.ImproperCertValidation]
}
