module code;

concept OwnerFree : issue {
  cwe: [CWE_401]
  review_assumption: "the release routine frees nested fields unless they are cleared first"
  reviewCategory: resource
  reviewCondition: "owner release follows a dominating field clear"
  reviewConfidence: low
  reviewEvidence: "owner release primitive {pattern} is reached after an owned field clear"
  vulnerableTo: [resource.ResourceLeak]
}
