module code;

concept CloudreveWeakSecretPrng : issue {
  cwe: [CWE_338, CWE_330]
  review_assumption: "the generated value is used as a persisted signing secret, salt, session secret, OAuth secret, callback secret, viewer token, or reset secret"
  reviewCategory: crypto
  reviewCondition: "Cloudreve generates persisted or session secrets with util.RandStringRunes instead of crypto/rand"
  reviewConfidence: high
  reviewEvidence: "Cloudreve secret-generation call {pattern} uses the math/rand-backed utility for security-sensitive token or key material"
  vulnerableTo: [crypto.InsufficientEntropy]
}
