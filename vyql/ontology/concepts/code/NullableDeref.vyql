module code;

concept NullableDeref : issue {
  cwe: [CWE_476]
  reviewAssumption: "the dereferenced value may be null on an attacker-triggerable path"
  reviewCategory: memory
  reviewCondition: "a pointer-like value is dereferenced without an observed null exclusion"
  reviewConfidence: low
  reviewEvidence: "dereference primitive {pattern} is present"
  vulnerableTo: [memory.NullDereference]
}
