module code;

// Credential material a peer handed over that the transport or the protocol
// has not verified yet. The distinction from core.UserControlledData is the
// role the value plays: an authentication callback receives it as a claim of
// identity, so anything derived from it inherits the claim rather than the
// data. Deliberately not a refinement of core.UserControlledData -- rules over
// that concept judge input handling, and a credential offered for
// authentication is not request input.
concept UnverifiedCredential : source {
  taint: [taint.UntrustedData]
}
