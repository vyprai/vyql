module code;

concept EscapedTerminatorWrite : issue {
  cwe: [CWE_119, CWE_125, CWE_787]
  reviewAssumption: "attacker-controlled input can end with an escape marker followed by a terminator"
  reviewCategory: memory
  reviewCondition: "an escape decoder writes a decoded byte without rejecting an escaped string terminator"
  reviewConfidence: medium
  reviewEvidence: "escape decoder context {pattern} writes the decoded byte immediately after unescaping"
  vulnerableTo: [memory.OobRead, memory.OobWrite]
}
