module code;

concept CordysRequestParamXssFilterDisabled : issue {
  cwe: [CWE_79]
  reviewAssumption: "stored request fields such as announcements or follow-up content can later be rendered to another user"
  reviewCategory: xss
  reviewCondition: "CordysCRM request string deserialization trims user strings but leaves XSS escaping disabled by default"
  reviewConfidence: high
  reviewEvidence: "RequestParamTrimConfig context {pattern} returns trimmed JSON string values when the global escape flag is false"
  vulnerableTo: [injection.Xss]
}
