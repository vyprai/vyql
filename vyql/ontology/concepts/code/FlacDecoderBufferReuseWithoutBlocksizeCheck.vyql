module code;

concept FlacDecoderBufferReuseWithoutBlocksizeCheck : issue {
  cwe: [CWE_125, CWE_787]
  review_assumption: "a malformed or changing FLAC stream can make the current frame blocksize exceed the cached callback buffer capacity before reuse"
  reviewCategory: memory
  reviewCondition: "a FLAC decoder reuses the callback sample buffer after only checking against the maximum FLAC block size"
  reviewConfidence: high
  reviewEvidence: "FLAC buffer copy context {pattern} copies frame->header.blocksize samples from the cached write buffer into rbuffer without tracking the actual callback buffer size"
  vulnerableTo: [memory.OobRead, memory.OobWrite]
}
