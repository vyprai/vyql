module code;

concept HardlinkedFileOverwriteWithoutClobber : issue {
  cwe: [CWE_59]
  reviewAssumption: "the writer is used on archive or package entries where an attacker can arrange an existing hard link at the target path"
  reviewCategory: path
  reviewCondition: "file writer reuses an existing hard-linked file path instead of clobbering it before writing"
  reviewConfidence: high
  reviewEvidence: "file writer context {pattern} opens an existing target for create/write without exclusive replacement or hard-link/symlink clobber protection"
  vulnerableTo: [path.LinkFollowing]
}
