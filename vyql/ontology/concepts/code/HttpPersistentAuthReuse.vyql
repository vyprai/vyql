module code;

concept HttpPersistentAuthReuse : issue {
  cwe: [CWE_287, CWE_613]
  reviewAssumption: "HTTP request authentication state is retained across requests on a persistent connection unless explicitly cleared"
  reviewCategory: auth
  reviewCondition: "a persistent HTTP connection reuses prior authenticated user/authstate for a new request before dropping credentials for non-backend server traffic"
  reviewConfidence: high
  reviewEvidence: "HTTP request handler {pattern} reads Authorization and Authorize-As headers, keeps per-connection auth state, and reaches protected namespace auth without an intervening credential reset"
  vulnerableTo: [authentication.ImproperAuthentication, authentication.AuthenticationBypass, session.SessionFixation]
}
