module code;

concept JenkinsPlaintextDataboundCredential : issue {
  cwe: [CWE_312, CWE_522]
  reviewAssumption: "Jenkins persists job configuration fields in config.xml where users with Extended Read or filesystem access may read them"
  reviewCategory: secret
  reviewCondition: "Jenkins plugin databinds credential-like configuration fields as plain strings"
  reviewConfidence: high
  reviewEvidence: "Jenkins configuration context {pattern} accepts or reads API login/token configuration as String values instead of protected Secret storage"
  vulnerableTo: [secrets.SecretLeak, crypto.CleartextStorage]
}
