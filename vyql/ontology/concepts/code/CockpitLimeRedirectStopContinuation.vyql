module code;

concept CockpitLimeRedirectStopContinuation : issue {
  cwe: [CWE_613]
  reviewAssumption: "protected controller initialization can reroute unauthenticated or expired sessions before state-changing code continues"
  reviewCategory: auth
  reviewCondition: "Cockpit Lime redirects mark the request stopped but do not terminate response execution"
  reviewConfidence: high
  reviewEvidence: "Lime App::stop context {pattern} sets request->stopped without the app:request:stop termination path"
  vulnerableTo: [authentication.ImproperAuthentication]
}
