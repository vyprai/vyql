module code;

concept UnboundedRouteFilenameCacheAccess : issue {
  cwe: [CWE_20, CWE_400]
  reviewAssumption: "attackers can supply an overlong route segment that survives filename sanitization and triggers filesystem errors or repeated expensive cache work"
  reviewCategory: resource
  reviewCondition: "a routed filename or route-derived filename is materialized under a cache directory without a length cap"
  reviewConfidence: high
  reviewEvidence: "route filename context {pattern} accepts a route parameter, calls secure_filename, and joins the result into a cache path before a len(...) bound"
  vulnerableTo: [validation.ImproperInputValidation, dos.UncontrolledResourceConsumption]
}
