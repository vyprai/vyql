module code;

concept InternalServiceUrlPathTraversal : issue {
  cwe: [CWE_22]
  review_assumption: "the downstream service interprets URL path segments after percent-decoding and exposes privileged internal routes or objects"
  reviewCategory: path
  reviewCondition: "a caller-controlled path segment is joined into an internal service base URL without decoded traversal validation"
  reviewConfidence: high
  reviewEvidence: "internal service request context {pattern} combines a base URL with a path parameter and returns the composed URL for an authenticated service call"
  vulnerableTo: [path.PathTraversal]
}
