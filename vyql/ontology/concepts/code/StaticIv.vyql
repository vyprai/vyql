module code;

concept StaticIv : issue {
  cwe: [CWE_329]
  review_assumption: "the mode requires nonce/IV uniqueness for confidentiality or integrity"
  reviewCategory: crypto
  reviewCondition: "cipher operation uses a static or predictable IV/nonce"
  reviewConfidence: low
  reviewEvidence: "cipher primitive {pattern} is called with static-looking IV material"
  vulnerableTo: [crypto.StaticIv]
}
