module code;

concept JmxRmiRegistryExposure : issue {
  cwe: [CWE_306, CWE_94]
  reviewAssumption: "default authentication may be disabled and the registry may bind beyond loopback, exposing remote JMX/RMI code execution"
  reviewCategory: auth
  reviewCondition: "a JMX/RMI server is registered through a custom RMI exporter path that can expose unauthenticated remote management"
  reviewConfidence: medium
  reviewEvidence: "JMX server setup context {pattern} uses the custom RMI exporter/registry binding path instead of creating the registry with the configured socket factories"
  vulnerableTo: [authentication.MissingAuthentication, injection.CodeInjection]
}
