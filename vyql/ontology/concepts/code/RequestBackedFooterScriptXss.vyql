module code;

concept RequestBackedFooterScriptXss : issue {
  cwe: [CWE_79]
  reviewAssumption: "attackers can supply GET, POST, or cookie parameters named footerScripts that reach the footer renderer"
  reviewCategory: xss
  reviewCondition: "footer script rendering reads script markup from the merged request bag instead of server-only state"
  reviewConfidence: high
  reviewEvidence: "PHP footer/script context {pattern} references $_REQUEST['footerScripts'] before printing scripts"
  vulnerableTo: [injection.Xss]
}
