module code;

concept ExternalResourceNamespaceControl : issue {
  cwe: [CWE_610, CWE_639]
  reviewAssumption: "the custom resource can be created or updated by a lower-privileged tenant in a namespace watched by the controller"
  reviewCategory: auth
  reviewCondition: "a user-controlled Kubernetes resource field selects the namespace for a privileged object operation"
  reviewConfidence: medium
  reviewEvidence: "Kubernetes object context {pattern} uses a custom resource namespace selector instead of the reconciled resource namespace"
  vulnerableTo: [access_control.IncorrectAuthorization]
}
