module code;

concept BackendServiceResourceTraversal : issue {
  cwe: [CWE_22]
  reviewAssumption: "the backend service handler interprets the resource value as an object path, file path, or nested service route"
  reviewCategory: path
  reviewCondition: "request route/resource path segments are forwarded to a backend service dispatcher without rejecting parent-directory traversal"
  reviewConfidence: medium
  reviewEvidence: "service dispatch context {pattern} forwards a resource route value to a backend service handler without an observed traversal-segment strip or path access guard"
  vulnerableTo: [path.PathTraversal]
}
