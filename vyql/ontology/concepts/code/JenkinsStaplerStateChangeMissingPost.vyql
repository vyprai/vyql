module code;

concept JenkinsStaplerStateChangeMissingPost : issue {
  cwe: [CWE_352]
  reviewAssumption: "a browser-backed request can invoke the Stapler action with the caller's Jenkins session"
  reviewCategory: csrf
  reviewCondition: "Jenkins Stapler state-changing endpoint is reachable without an explicit POST requirement"
  reviewConfidence: high
  reviewEvidence: "Jenkins Stapler action context {pattern} changes persisted configuration or deletes data without observed @RequirePOST/@POST"
  vulnerableTo: [request_forgery.Csrf]
}
