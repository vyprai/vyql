module code;

concept EffectMixedSchedulerSharedRunner : issue {
  cwe: [CWE_362]
  reviewAssumption: "multiple concurrent Effect fibers can enqueue continuations into the same scheduler runner while request-local async context depends on per-fiber execution isolation"
  reviewCategory: race
  reviewCondition: "MixedScheduler batches task continuations through shared running/tasks state instead of dispatching through a SchedulerRunner keyed by the owning fiber"
  reviewConfidence: high
  reviewEvidence: "Effect scheduler context {pattern} drains a shared PriorityBuckets queue from MixedScheduler.scheduleTask without the fiber-scoped SchedulerRunner cache"
  vulnerableTo: [concurrency.RaceCondition]
}
