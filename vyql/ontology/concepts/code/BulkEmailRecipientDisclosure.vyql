module code;

concept BulkEmailRecipientDisclosure : issue {
  cwe: [CWE_200]
  review_assumption: "the mail sender exposes recipient addresses in visible To or Cc headers to every recipient"
  reviewCategory: privacy
  reviewCondition: "notification email is sent once with a collected multi-recipient address list"
  reviewConfidence: high
  reviewEvidence: "mail recipient context {pattern} collects user Email fields and passes the recipient slice to a mail sender instead of a one-recipient send or blind-copy path"
  vulnerableTo: [secrets.SecretLeak]
}
