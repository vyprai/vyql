module code;

concept CoerciblePathSegmentPrototypePollution : issue {
  cwe: [CWE_1321]
  review_assumption: "a caller can provide a path array containing objects whose toString/valueOf result is __proto__, constructor, or prototype"
  reviewCategory: prototype_pollution
  reviewCondition: "nested path assignment rejects literal prototype-mutating strings but indexes objects with non-primitive path segments that JavaScript can coerce to prototype names"
  reviewConfidence: high
  reviewEvidence: "path setter context {pattern} compares each path segment to prototype-sensitive strings, then uses the same segment in obj[segment] reads/writes without a string/number type guard"
  vulnerableTo: [injection.PrototypePollution]
}
