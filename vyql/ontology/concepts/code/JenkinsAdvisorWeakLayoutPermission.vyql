module code;

concept JenkinsAdvisorWeakLayoutPermission : issue {
  cwe: [CWE_862]
  reviewAssumption: "the view is reachable through the ManagementLink URL and should require Overall/Administer"
  reviewCategory: access_control
  reviewCondition: "Jenkins Advisor administrative configuration view uses the weaker it.ADMINISTRATOR layout permission"
  reviewConfidence: high
  reviewEvidence: "Jelly layout event {pattern} gates the management page with permission=\"${it.ADMINISTRATOR}\" instead of app.ADMINISTER"
  vulnerableTo: [access_control.MissingAuthorization]
}
