module code;

concept RequestReferenceEval : issue {
  cwe: [CWE_94]
  reviewAssumption: "an attacker can submit batch request paths containing reference expressions"
  reviewCategory: code_execution
  reviewCondition: "request-controlled reference paths are evaluated as code to read response fields"
  reviewConfidence: high
  reviewEvidence: "request reference context {pattern} builds an eval string from parsed request path parts"
  vulnerableTo: [injection.CodeInjection]
}
