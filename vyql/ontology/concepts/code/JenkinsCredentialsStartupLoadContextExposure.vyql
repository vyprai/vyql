module code;

concept JenkinsCredentialsStartupLoadContextExposure : issue {
  cwe: [CWE_200]
  review_assumption: "lazy loading after startup can occur under a lower-privileged authentication context and expose credential metadata or material"
  reviewCategory: secret
  reviewCondition: "Jenkins system credentials are loaded or migrated outside an observed SYSTEM startup initializer"
  reviewConfidence: high
  reviewEvidence: "credentials provider class context {pattern} unmarshals and migrates credentials without a startup @Initializer force-load"
  vulnerableTo: [secrets.SecretLeak]
}
