module code;

concept PasswordHashMissingUserBalance : issue {
  cwe: [CWE_203, CWE_208]
  review_assumption: "an attacker can repeatedly attempt login for chosen usernames and observe timing or response differences"
  reviewCategory: auth
  reviewCondition: "database-backed login checks a password hash only for existing active users"
  reviewConfidence: high
  reviewEvidence: "auth context {pattern} looks up a user and verifies the real password hash without an observed dummy hash check for missing or inactive users"
  vulnerableTo: [crypto.ObservableDiscrepancy, authentication.ImproperAuthentication]
}
