module code;

concept DataExposureSmell : issue {
  cwe: [CWE_200, CWE_201, CWE_359]
  reviewAssumption: "the record carries fields this caller should not see"
  reviewCategory: secret
  reviewCondition: "a route returns a database record whose field set is not narrowed for this caller"
  reviewConfidence: medium
  reviewEvidence: "route {pattern} returns a record directly"
  vulnerableTo: [access_control.IncorrectAuthorization, authentication.MissingAuthentication]
}
