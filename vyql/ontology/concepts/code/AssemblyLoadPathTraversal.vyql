module code;

concept AssemblyLoadPathTraversal : issue {
  cwe: [CWE_22]
  reviewAssumption: "library callers can pass type names containing assembly components such as '../payload' or drive-qualified paths"
  reviewCategory: path
  reviewCondition: "a dynamic assembly-load path is built from a caller-controlled assembly/type-name component without rejecting traversal or drive-qualified paths"
  reviewConfidence: high
  reviewEvidence: "assembly load context {pattern} joins AppContext.BaseDirectory with a split type-name component and loads it via LoadFromAssemblyPath"
  vulnerableTo: [path.PathTraversal]
}
