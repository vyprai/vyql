module code;

concept UnderallocatedFormattedAddressList : issue {
  cwe: [CWE_787]
  reviewAssumption: "the address count can be influenced by a malformed network option"
  reviewCategory: memory
  reviewCondition: "a formatted address-list buffer allocation is smaller than the bytes subsequently written"
  reviewConfidence: medium
  reviewEvidence: "address-list formatting context {pattern} allocates from a count-derived formula and writes fixed-width entries plus separators"
  vulnerableTo: [memory.OobWrite]
}
