module code;

concept PasswordChangeWithoutSessionInvalidation : issue {
  cwe: [CWE_613]
  reviewAssumption: "authentication material issued before the credential change is still held and replayable by whoever obtained it, including the party the password change is meant to lock out"
  reviewCategory: auth
  reviewCondition: "an authenticated password-change flow stores the new credential without invalidating the sessions or bearer tokens minted against the old one"
  reviewConfidence: high
  reviewEvidence: "password change context {pattern} establishes an authenticated principal and derives a new password hash while no session destroy, session regeneration, token revocation, or token-version bump appears in the same function"
  vulnerableTo: [authentication.ImproperAuthentication]
}
