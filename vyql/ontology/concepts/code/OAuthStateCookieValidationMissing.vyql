module code;

concept OAuthStateCookieValidationMissing : issue {
  cwe: [CWE_352, CWE_287]
  reviewAssumption: "attackers can supply or replay OAuth callback state values unless the callback compares them with a value stored during login initiation"
  reviewCategory: auth
  reviewCondition: "an OAuth/SSO login flow sends a state parameter but does not bind callback state to a stored cookie/session value"
  reviewConfidence: high
  reviewEvidence: "SSO context {pattern} passes state into the authorization URL and reads callback state before process_login without storing or comparing sso_state"
  vulnerableTo: [request_forgery.Csrf, authentication.AuthenticationBypass]
}
