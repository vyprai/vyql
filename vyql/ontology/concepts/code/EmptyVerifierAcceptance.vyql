module code;

concept EmptyVerifierAcceptance : issue {
  cwe: [CWE_345, CWE_670]
  reviewAssumption: "a failed lookup returns an empty value and the verifier is reachable with attacker-supplied challenge id and answer"
  reviewCategory: auth
  reviewCondition: "verification succeeds when a missing stored challenge value equals an empty supplied answer"
  reviewConfidence: medium
  reviewEvidence: "verifier context {pattern} compares the looked-up value to the supplied answer without excluding an empty stored value"
  vulnerableTo: [authentication.AuthenticationBypass]
}
