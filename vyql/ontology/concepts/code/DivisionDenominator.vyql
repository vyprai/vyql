module code;

concept DivisionDenominator : sink {
  cwe: [CWE_369]
  enabledBy: [taint.UntrustedData]
  review_assumption: "zero or unsafe divisor values are not excluded before the operation"
  reviewCategory: numeric
  reviewCondition: "attacker-controlled denominator reaches division or modulo"
