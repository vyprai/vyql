module code;

concept MessageBusSecretConfigExposure : issue {
  cwe: [CWE_200, CWE_522]
  reviewAssumption: "the service exposes or serializes its runtime configuration to callers such as diagnostics or /config endpoints"
  reviewCategory: secret
  reviewCondition: "message-bus password options remain in service configuration after creating the client"
  reviewConfidence: high
  reviewEvidence: "message-bus bootstrap context {pattern} loads auth data into messageBusInfo and passes messageBusInfo.Optional into the message client without deleting the password option"
  vulnerableTo: [secrets.SecretLeak]
}
