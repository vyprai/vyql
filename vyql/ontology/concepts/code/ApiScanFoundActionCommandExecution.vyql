module code;

concept ApiScanFoundActionCommandExecution : issue {
  cwe: [CWE_78, CWE_15]
  review_assumption: "the scan engine executes configured found-action commands when a finding is produced"
  reviewCategory: command
  reviewCondition: "API request bodies can configure scan options that trigger host-side found-action command execution"
  reviewConfidence: high
  reviewEvidence: "API scan handler context {pattern} binds request options and forwards them to the scan engine without stripping found-action command fields"
  vulnerableTo: [injection.CommandInjection, injection.CodeInjection]
}
