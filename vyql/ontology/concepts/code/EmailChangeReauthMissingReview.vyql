module code;

concept EmailChangeReauthMissingReview : issue {
  cwe: [CWE_306, CWE_287]
  reviewAssumption: "changing the account email can transfer control through confirmation, password-reset, or identity-provider flows"
  reviewCategory: auth
  reviewCondition: "authenticated email-change flow updates the account email without a same-flow password, OTP, or explicit reauthentication check"
  reviewConfidence: high
  reviewEvidence: "account update context {pattern} calls an auth provider email-update API with an email field while no reauthentication call is observed in the same function"
  vulnerableTo: [authentication.MissingAuthentication, authentication.ImproperAuthentication]
}
