module code;

concept RateLimitedMbufResponseLeak : issue {
  cwe: [CWE_772, CWE_400]
  reviewAssumption: "the response helper owns or must consume the mbuf argument on every return path"
  reviewCategory: resource
  reviewCondition: "a rate-limited TCP response helper consumes an mbuf only on the send path and lacks a release on the suppressed path"
  reviewConfidence: high
  reviewEvidence: "mbuf response context {pattern} checks a TCP challenge-ACK limiter and calls tcp_respond without an alternate m_freem release"
  vulnerableTo: [resource.ResourceLeak, dos.UncontrolledResourceConsumption]
}
