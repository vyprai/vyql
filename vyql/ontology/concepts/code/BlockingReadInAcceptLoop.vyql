module code;

concept BlockingReadInAcceptLoop : issue {
  cwe: [CWE_400, CWE_667]
  reviewAssumption: "an idle client can hold the accept loop and prevent other clients from being accepted"
  reviewCategory: resource
  reviewCondition: "a network accept loop performs a blocking per-connection read before handing the connection to concurrent processing"
  reviewConfidence: high
  reviewEvidence: "accept-loop context {pattern} accepts a connection and reads from it in the same loop body before dispatch"
  vulnerableTo: [dos.UncontrolledResourceConsumption]
}
