module code;

concept CaptchaValidationTruthyReturnBypass : issue {
  cwe: [CWE_20, CWE_287]
  review_assumption: "callers may compare validation failure with == False or otherwise require a real boolean false result"
  reviewCategory: auth
  reviewCondition: "captcha validation can return a non-boolean falsey value instead of explicit False for invalid or empty input"
  reviewConfidence: high
  reviewEvidence: "captcha validation context {pattern} returns a truthy-input and equality expression after invalidating the stored answer"
  vulnerableTo: [validation.ImproperInputValidation, authentication.AuthenticationBypass]
}
