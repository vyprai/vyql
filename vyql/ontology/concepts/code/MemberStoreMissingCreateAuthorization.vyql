module code;

concept MemberStoreMissingCreateAuthorization : issue {
  cwe: [CWE_862, CWE_863]
  review_assumption: "route-level form checks can be bypassed by direct POSTs or alternate create routes, so the store path must enforce create authorization itself"
  reviewCategory: access_control
  reviewCondition: "a member storage endpoint checks edit permissions for existing members but creates new non-self members without a local create-permission guard"
  reviewConfidence: high
  reviewEvidence: "member store context {pattern} parses POST data, handles self-membership, checks canEdit on updates, and persists the member without an observed canCreate check for new member creation"
  vulnerableTo: [access_control.MissingAuthorization, access_control.IncorrectAuthorization]
}
