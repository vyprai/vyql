module code;

concept DynamicCommandExec : issue {
  cwe: [CWE_78]
  reviewAssumption: "some component of the command is influenced by input"
  reviewCategory: command
  reviewCondition: "an OS command string is assembled dynamically before execution"
  reviewConfidence: medium
  reviewEvidence: "command execution {pattern} receives a dynamically built string"
  vulnerableTo: [injection.CommandInjection]
}
