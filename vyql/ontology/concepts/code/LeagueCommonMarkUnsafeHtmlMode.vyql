module code;

concept LeagueCommonMarkUnsafeHtmlMode : issue {
  cwe: [CWE_79]
  reviewAssumption: "Markdown content can be supplied by lower-trust authors and rendered in another user's browser"
  reviewCategory: xss
  reviewCondition: "league/commonmark renders Markdown with raw HTML enabled by default"
  reviewConfidence: high
  reviewEvidence: "CommonMark converter context {pattern} creates a Markdown environment without html_input escaping, DisallowedRawHtmlExtension, or an observed HTML sanitizer"
  vulnerableTo: [injection.Xss]
}
