module code;

concept UnescapedDiagnosticHtml : issue {
  cwe: [CWE_79]
  reviewAssumption: "the diagnostic log is visible in a browser context"
  reviewCategory: xss
  reviewCondition: "diagnostic or log text containing remote response data is rendered as HTML without escaping"
  reviewConfidence: medium
  reviewEvidence: "diagnostic assembly context {pattern} appends unescaped data into an HTML-rendered log field"
  vulnerableTo: [injection.Xss]
}
