module code;

concept UnvalidatedRatingRange : issue {
  cwe: [CWE_20]
  reviewAssumption: "callers can submit rating values outside the intended product range"
  reviewCategory: input_validation
  reviewCondition: "a user-controlled rating value is applied without server-side range validation"
  reviewConfidence: medium
  reviewEvidence: "rating update context {pattern} passes the rating directly into the backing rating operation"
  vulnerableTo: [validation.ImproperInputValidation]
}
