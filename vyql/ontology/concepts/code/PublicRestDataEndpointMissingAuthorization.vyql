module code;

concept PublicRestDataEndpointMissingAuthorization : issue {
  cwe: [CWE_862, CWE_863, CWE_200]
  reviewAssumption: "draft, archived, private, inactive, or otherwise restricted resources can expose related data that should be visible only to privileged users"
  reviewCategory: access_control
  reviewCondition: "a public REST route returns resource data without checking the resource status, page privacy, ownership, or equivalent view permission inside the handler"
  reviewConfidence: high
  reviewEvidence: "REST controller context {pattern} registers a public readable route, loads resource data, and queries related comments, donations, or records without an observed private-resource authorization branch"
  vulnerableTo: [access_control.MissingAuthorization, access_control.IncorrectAuthorization, secrets.SecretLeak]
}
