module code;

concept GatedSecretVerificationBypass : issue {
  cwe: [CWE_287, CWE_306]
  reviewAssumption: "the operand that gates the verification can be made false by the caller or by configuration"
  reviewCategory: auth
  reviewCondition: "a credential release's secret verification is a skip-able conjunct of the guard rather than the whole guard, so the verification never runs for some reachable inputs"
  reviewConfidence: high
  reviewEvidence: "credential release context {pattern} negates its secret verification behind another conjunct of the guard"
  vulnerableTo: [authentication.AuthenticationBypass, authentication.MissingAuthentication]
}
