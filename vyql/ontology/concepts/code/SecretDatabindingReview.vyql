module code;

concept SecretDatabindingReview : issue {
  cwe: [CWE_311, CWE_522]
  review_assumption: "the configuration framework may persist or display the value unless it is converted to protected secret storage"
  reviewCategory: secret
  reviewCondition: "secret configuration data is databound without an observed protected-secret conversion"
  reviewConfidence: possibility
  reviewEvidence: "secret parameter {pattern} is accepted at a configuration boundary"
  vulnerableTo: [secrets.SecretLeak, crypto.CleartextStorage]
}
