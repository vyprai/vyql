module code;

concept DebugInfoExposure : issue {
  cwe: [CWE_215]
  reviewAssumption: "the response is reachable without operator privilege"
  reviewCategory: secret
  reviewCondition: "environment or configuration values are serialized into an HTTP response"
  reviewConfidence: medium
  reviewEvidence: "response {pattern} carries environment or path configuration"
  vulnerableTo: [access_control.IncorrectAuthorization]
}
