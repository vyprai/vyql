module code;

concept FlowSpecOperatorLoopBoundOffByOne : issue {
  cwe: [CWE_193, CWE_787]
  reviewAssumption: "a crafted FlowSpec component can contain enough chained operators to reach the fixed mval array limit"
  reviewCategory: memory
  reviewCondition: "a chained FlowSpec operator decoder writes match values while allowing the loop counter to reach the fixed match-value capacity"
  reviewConfidence: high
  reviewEvidence: "FlowSpec operator decode context {pattern} checks loop > BGP_PBR_MATCH_VAL_MAX before writing mval and advancing it"
  vulnerableTo: [memory.OobWrite]
}
