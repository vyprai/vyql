module code;

concept ClosureUnwindStaleLength : issue {
  cwe: [CWE_415]
  reviewAssumption: "the caller-supplied closure can unwind while the buffer still carries its pre-compaction length"
  reviewCategory: memory
  reviewCondition: "a raw buffer compaction runs caller code before the collection length is restored"
  reviewConfidence: medium
  reviewEvidence: "closure-unwind buffer lifecycle {pattern} is present"
  vulnerableTo: [memory.DoubleFree, memory.UseAfterFree]
}
