module code;

concept LogoutReturnUrlRedirectWithoutAllowlist : issue {
  cwe: [CWE_601]
  reviewAssumption: "an attacker can place an absolute or scheme-relative URL in the return query parameter and cause the browser to follow the logout redirect"
  reviewCategory: request_forgery
  reviewCondition: "logout or redirect handling sends a request return URL to RedirectResponse without a same-origin allowlist"
  reviewConfidence: high
  reviewEvidence: "logout redirect context {pattern} reads a return query parameter and constructs RedirectResponse before sanitizeReturnUrl or equivalent allowlist validation"
  vulnerableTo: [request_forgery.OpenRedirect]
}
