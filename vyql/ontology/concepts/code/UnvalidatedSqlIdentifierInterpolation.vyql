module code;

concept UnvalidatedSqlIdentifierInterpolation : issue {
  cwe: [CWE_89]
  reviewAssumption: "attackers can control the identifier value passed into the update or query helper"
  reviewCategory: sql
  reviewCondition: "SQL identifier text is selected from caller-controlled data and interpolated into a statement without an identifier allowlist"
  reviewConfidence: high
  reviewEvidence: "SQL builder context {pattern} formats a table, column, or ORDER BY identifier into SQL before validating it against allowed names"
  vulnerableTo: [injection.SqlInjection]
}
