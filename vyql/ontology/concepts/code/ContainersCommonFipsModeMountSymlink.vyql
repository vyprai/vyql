module code;

concept ContainersCommonFipsModeMountSymlink : issue {
  cwe: [CWE_59, CWE_22]
  reviewAssumption: "a container image can place symlinks under the mounted root so ordinary path joins can resolve outside the intended container filesystem"
  reviewCategory: path
  reviewCondition: "containers/common FIPS subscription mount resolves a container-image path with filepath.Join before bind-mounting it from the host"
  reviewConfidence: high
  reviewEvidence: "addFIPSModeSubscription context {pattern} joins mountPoint with the FIPS backend path, checks existence, and uses the result as an rspec.Mount source before securejoin hardening"
  vulnerableTo: [path.LinkFollowing, path.PathTraversal]
}
