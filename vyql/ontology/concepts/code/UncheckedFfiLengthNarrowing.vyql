module code;

concept UncheckedFfiLengthNarrowing : issue {
  cwe: [CWE_190]
  review_assumption: "attacker-controlled or file-derived input can make the slice length exceed the C integer maximum"
  reviewCategory: numeric
  reviewCondition: "a host slice length is narrowed into an FFI length field without clamping to the C field width"
  reviewConfidence: medium
  reviewEvidence: "FFI length context {pattern} casts len() directly into a narrower C integer type"
  vulnerableTo: [memory.IntegerOverflow, dos.UncontrolledResourceConsumption]
}
