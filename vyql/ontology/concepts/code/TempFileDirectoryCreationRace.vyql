module code;

concept TempFileDirectoryCreationRace : issue {
  cwe: [CWE_377, CWE_367, CWE_59]
  reviewAssumption: "an attacker with access to the temporary parent directory can race the delete/mkdir window or substitute a link/path before the directory is recreated"
  reviewCategory: path
  reviewCondition: "a temporary directory is created by first creating a temporary file, deleting it, and then calling mkdir"
  reviewConfidence: high
  reviewEvidence: "temporary-directory context {pattern} calls File.createTempFile, deletes the created path, and recreates it as a directory instead of using an atomic directory-creation API"
  vulnerableTo: [path.InsecureTempFile, path.LinkFollowing]
}
