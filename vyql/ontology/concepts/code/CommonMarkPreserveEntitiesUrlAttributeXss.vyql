module code;

concept CommonMarkPreserveEntitiesUrlAttributeXss : issue {
  cwe: [CWE_79]
  reviewAssumption: "applications may render attacker-controlled Markdown output in a browser context"
  reviewCategory: xss
  reviewCondition: "league/commonmark preserves HTML entities while escaping rendered URL attributes"
  reviewConfidence: high
  reviewEvidence: "CommonMark renderer context {pattern} writes href or src values with Xml::escape(..., true), allowing double-encoded entities such as javascript&amp;colon; to survive as browser-interpreted URL syntax"
  vulnerableTo: [injection.Xss]
}
