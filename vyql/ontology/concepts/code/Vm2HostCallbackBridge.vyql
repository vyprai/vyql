module code;

concept Vm2HostCallbackBridge : issue {
  cwe: [CWE_94]
  review_assumption: "template or sandbox-executed code can invoke the bridged host callbacks"
  reviewCategory: code_execution
  reviewCondition: "vm2 sandbox exposes host callbacks or globals while sandbox code is executed"
  reviewConfidence: medium
  reviewEvidence: "vm2 context {pattern} bridges host callbacks into the sandbox and executes vm.run"
  vulnerableTo: [injection.CodeInjection]
}
