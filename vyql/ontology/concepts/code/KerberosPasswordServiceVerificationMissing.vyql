module code;

concept KerberosPasswordServiceVerificationMissing : issue {
  cwe: [CWE_287, CWE_290]
  reviewAssumption: "password-based Kerberos authentication is intended to prove the KDC can issue credentials for the configured server principal"
  reviewCategory: auth
  reviewCondition: "Kerberos password verification obtains initial credentials with a NULL service principal and no observed service-ticket verification step"
  reviewConfidence: high
  reviewEvidence: "krb5_get_init_creds_password is called with its service argument set to NULL while krb5_verify_init_creds/get_credentials/request APIs are absent from the same function context"
  vulnerableTo: [authentication.ImproperAuthentication]
}
