module code;

concept PublicUploadChunkPathTraversal : issue {
  cwe: [CWE_22]
  review_assumption: "unauthenticated or public upload callers can supply checksum values containing traversal components"
  reviewCategory: path
  reviewCondition: "public chunk-upload handlers join a request checksum into a temporary file path before writes without sanitization or canonical containment"
  reviewConfidence: high
  reviewEvidence: "public upload chunk context {pattern} reads a checksum-like form field, joins it into a temp path, and opens the path before a sanitizer or realpath containment check"
  vulnerableTo: [path.PathTraversal]
}
