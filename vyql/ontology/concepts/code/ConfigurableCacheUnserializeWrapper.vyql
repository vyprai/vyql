module code;

concept ConfigurableCacheUnserializeWrapper : issue {
  cwe: [CWE_502, CWE_248]
  review_assumption: "cache contents may be attacker-influenced through cache poisoning, shared backing stores, or application-controlled cache writes"
  reviewCategory: deserialization
  reviewCondition: "a framework cache driver wrapper selects an unserializer from configuration and applies it to cached data using a restrictive vulnerable signature"
  reviewConfidence: high
  reviewEvidence: "cache unserialize context {pattern} reads the unserializer callable from options and invokes it on cache data"
  vulnerableTo: [deserialization.DeserializationAbuse, dos.UncontrolledResourceConsumption]
}
