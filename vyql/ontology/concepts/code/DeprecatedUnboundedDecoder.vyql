module code;

concept DeprecatedUnboundedDecoder : issue {
  cwe: [CWE_125, CWE_20]
  reviewAssumption: "the buffer being decoded can be a truncated or attacker-supplied protocol message"
  reviewCategory: memory
  reviewCondition: "a decoder that takes no buffer-size argument parses a message, so a truncated payload reads past the end"
  reviewConfidence: low
  reviewEvidence: "deprecated unbounded decode primitive {pattern} is present, and the library supplies a size-taking replacement"
  vulnerableTo: [memory.OobRead, validation.ImproperInputValidation]
}
