module code;

concept UnboundedProtocolStateByIdentifier : issue {
  cwe: [CWE_400, CWE_770]
  reviewAssumption: "the identifier bytes can be supplied by a remote peer and can be large enough or numerous enough to amplify memory/CPU"
  reviewCategory: resource
  reviewCondition: "protocol message identifiers are stored in peer state or queued before per-identifier size/type limits are enforced"
  reviewConfidence: medium
  reviewEvidence: "protocol state context {pattern} accepts remote message entries into state and task queues without an observed identifier size/type rejection"
  vulnerableTo: [dos.UncontrolledResourceConsumption]
}
