module code;

concept GoStaticPosixCleanWindowsTraversal : issue {
  cwe: [CWE_22]
  reviewAssumption: "the static file server can run on Windows and receive URL paths containing backslash parent-directory segments"
  reviewCategory: path
  reviewCondition: "a Go static-file handler URL-decodes request paths, joins them under a filesystem root, and uses path.Clean instead of filepath.Clean before serving files"
  reviewConfidence: high
  reviewEvidence: "Go static-file context {pattern} decodes a URL path, joins it with a filesystem root, stats or serves the joined path, and lacks filepath.Clean"
  vulnerableTo: [path.PathTraversal]
}
