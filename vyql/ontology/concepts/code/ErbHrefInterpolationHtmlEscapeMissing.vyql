module code;

concept ErbHrefInterpolationHtmlEscapeMissing : issue {
  cwe: [CWE_79, CWE_116]
  review_assumption: "the interpolated href value can be supplied by gem metadata, content, or another attacker-controlled stored field"
  reviewCategory: xss
  reviewCondition: "Ruby ERB interpolates a dynamic value into an HTML href attribute without an HTML escaping helper"
  reviewConfidence: high
  reviewEvidence: "ERB template context {pattern} renders a href attribute interpolation without h, html_escape, escape_html, or equivalent escaping"
  vulnerableTo: [injection.Xss]
}
