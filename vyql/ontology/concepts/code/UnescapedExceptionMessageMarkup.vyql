module code;

concept UnescapedExceptionMessageMarkup : issue {
  cwe: [CWE_79]
  reviewAssumption: "the exception message can include attacker-controlled request, URL, parser, or validation text and is later rendered in a browser"
  reviewCategory: xss
  reviewCondition: "exception text is propagated into a markup-rendered error response without escaping"
  reviewConfidence: medium
  reviewEvidence: "exception rendering context {pattern} passes a raw caught exception or exception message into an HTML-facing error helper"
  vulnerableTo: [injection.Xss]
}
