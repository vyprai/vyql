module code;

concept FixedChunkCapacityGrowthIndex : issue {
  cwe: [CWE_119, CWE_787]
  review_assumption: "crafted input can select a requested index or continuation level larger than the fixed growth step"
  reviewCategory: memory
  reviewCondition: "capacity grows by a fixed chunk even though the requested index or level may jump beyond the new capacity"
  reviewConfidence: high
  reviewEvidence: "capacity-growth context {pattern} compares the requested index with capacity, reallocates after a fixed-size growth assignment, and later indexes by the requested value"
  vulnerableTo: [memory.OobWrite, memory.OobRead]
}
