module code;

concept ShiftedClusterSizeAllocationMissingBounds : issue {
  cwe: [CWE_190, CWE_787]
  review_assumption: "a malformed filesystem header can provide sector or sectors-per-cluster shift values that make derived allocation sizes wrap or undersize buffers"
  reviewCategory: memory
  reviewCondition: "cluster-size allocation uses filesystem sector and cluster shift fields before validating their safe range"
  reviewConfidence: high
  reviewEvidence: "mount context {pattern} allocates CLUSTER_SIZE-derived memory and verifies sectors before the sector/cluster bit bounds are observed"
  vulnerableTo: [memory.IntegerOverflow, memory.OobWrite]
}
