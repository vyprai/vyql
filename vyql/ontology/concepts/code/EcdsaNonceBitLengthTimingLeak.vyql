module code;

concept EcdsaNonceBitLengthTimingLeak : issue {
  cwe: [CWE_200, CWE_203, CWE_208]
  reviewAssumption: "an attacker can request repeated signatures and observe timing differences correlated with nonce bit length"
  reviewCategory: crypto
  reviewCondition: "ECDSA signing uses a variable-bit-length nonce in scalar multiplication"
  reviewConfidence: high
  reviewEvidence: "ECDSA sign context {pattern} generates an HMAC-DRBG nonce, truncates it to n, multiplies the generator by k, and inverts k without fixed-bit-length mitigation"
  vulnerableTo: [crypto.ObservableDiscrepancy]
}
