module code;

concept RequestSelectedDeserializationFormat : issue {
  cwe: [CWE_502]
  reviewAssumption: "the selected serde registry includes an unsafe object deserialization format"
  reviewCategory: deserialization
  reviewCondition: "request-controlled media type selects a deserialization format before HTTP request body decoding"
  reviewConfidence: medium
  reviewEvidence: "request deserialization context {pattern} selects a serde from request Content-Type"
  vulnerableTo: [deserialization.DeserializationAbuse]
}
