module code;

concept ContaoListingModuleSqlIdentifierInjection : issue {
  cwe: [CWE_89]
  reviewAssumption: "front-end visitors can reach a configured listing module and control the query parameters"
  reviewCategory: sql
  reviewCondition: "Contao listing module concatenates request-selected search, order, or sort identifiers into SQL without checking them against configured field allowlists"
  reviewConfidence: high
  reviewEvidence: "ModuleListing::compile context {pattern} uses Input::get search/order_by/sort values while building strWhere/ORDER BY and preparing strQuery"
  vulnerableTo: [injection.SqlInjection]
}
