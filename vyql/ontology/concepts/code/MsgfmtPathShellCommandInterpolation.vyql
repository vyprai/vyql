module code;

concept MsgfmtPathShellCommandInterpolation : issue {
  cwe: [CWE_78]
  reviewAssumption: "an attacker can introduce a translation filename or directory containing shell metacharacters"
  reviewCategory: command
  reviewCondition: "message compilation command text interpolates filesystem-derived .po/.mo paths before shell execution"
  reviewConfidence: high
  reviewEvidence: "msgfmt command context {pattern} formats a path-derived stem into os.system(cmd)"
  vulnerableTo: [injection.CommandInjection]
}
