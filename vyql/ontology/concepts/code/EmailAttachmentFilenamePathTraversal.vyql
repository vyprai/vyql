module code;

concept EmailAttachmentFilenamePathTraversal : issue {
  cwe: [CWE_22]
  reviewAssumption: "email attachment filename metadata can contain path separators, traversal segments, or absolute paths"
  reviewCategory: path
  reviewCondition: "email attachment filenames are joined into an output directory without basename canonicalization"
  reviewConfidence: high
  reviewEvidence: "attachment extraction context {pattern} writes decoded attachment data using attachment filename metadata before stripping directory components"
  vulnerableTo: [path.PathTraversal]
}
