module code;

concept CraftCommercePurchasablesSortSqlInjection : issue {
  cwe: [CWE_89]
  review_assumption: "authenticated Commerce users can reach the purchasables table endpoint and control the sort parameter"
  reviewCategory: sql
  reviewCondition: "Craft Commerce purchasables table sorting passes a request-selected column name into Yii orderBy array keys without a column allowlist"
  reviewConfidence: high
  reviewEvidence: "actionPurchasablesTable context {pattern} splits the sort request parameter and uses the column as an orderBy array key before the patched description/sku/price allowlist"
  vulnerableTo: [injection.SqlInjection]
}
