module code;

concept JenkinsTestResultNameXss : issue {
  cwe: [CWE_79]
  review_assumption: "test result names can be influenced by build or report input and later rendered by Jenkins test result UI routes"
  reviewCategory: xss
  reviewCondition: "Jenkins test-result names are returned from UI-facing getName accessors without HTML escaping"
  reviewConfidence: high
  reviewEvidence: "Jenkins TestResult name context {pattern} returns the stored name field before hudson.Util.escape or equivalent HTML escaping"
  vulnerableTo: [injection.Xss]
}
