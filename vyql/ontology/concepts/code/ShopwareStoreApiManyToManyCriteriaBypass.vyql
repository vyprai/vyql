module code;

concept ShopwareStoreApiManyToManyCriteriaBypass : issue {
  cwe: [CWE_284]
  review_assumption: "extensions can define ManyToMany associations whose target entity exposes non-ApiAware fields through Store API criteria"
  reviewCategory: access_control
  reviewCondition: "Shopware Store API criteria processing walks requested associations without applying ApiAware protections to ManyToMany target definitions"
  reviewConfidence: high
  reviewEvidence: "SalesChannelRepository processCriteria context {pattern} queues only getReferenceDefinition() and de-duplicates by definition class before the patched ManyToManyAssociationField/getToManyReferenceDefinition path-aware traversal"
  vulnerableTo: [access_control.BrokenAccess]
}
