module code;

concept PgEscapeStringSqlFilterInjection : issue {
  cwe: [CWE_89]
  reviewAssumption: "HTTP parameters can control the escaped filter value"
  reviewCategory: sql
  reviewCondition: "PostgreSQL filter fragments are built with pg_escape_string instead of pg_escape_literal before query composition"
  reviewConfidence: high
  reviewEvidence: "Search/filter builder context {pattern} concatenates pg_escape_string output into SQL fragments that are later added to a search query"
  vulnerableTo: [injection.SqlInjection]
}
