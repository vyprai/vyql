module code;

concept CopypartyCprStaticPathTraversal : issue {
  cwe: [CWE_22]
  review_assumption: "unauthenticated clients can request /.cpr paths containing traversal components"
  reviewCategory: path
  reviewCondition: "copyparty /.cpr static paths are joined from the request vpath before file reads without canonical containment"
  reviewConfidence: high
  reviewEvidence: "copyparty handle_get context {pattern} joins self.vpath[5:] into the embedded web directory and serves it with tx_file"
  vulnerableTo: [path.PathTraversal]
}
