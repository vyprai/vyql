module code;

concept CheckmkPendingChangeTextUnescapeXss : issue {
  cwe: [CWE_79]
  reviewAssumption: "pending change text can include folder or change attributes controlled by an operator/admin and is inserted with innerHTML"
  reviewCategory: xss
  reviewCondition: "pending-change text is HTML-unescaped before being returned to a frontend popout that renders it as HTML"
  reviewConfidence: high
  reviewEvidence: "activation popout context {pattern} assigns html.unescape(change[\"text\"]) to the pending-change text field"
  vulnerableTo: [injection.Xss]
}
