module code;

concept PublicUserListRouteMissingAuthentication : issue {
  cwe: [CWE_306, CWE_862, CWE_200]
  reviewAssumption: "a route group named public, anonymous, or unauthenticated is reachable without a prior authentication gate"
  reviewCategory: auth
  reviewCondition: "a public GET route exposes an all-users listing handler without moving the route under an authenticated group or equivalent auth middleware"
  reviewConfidence: high
  reviewEvidence: "Go route registration {pattern} maps an /allusers endpoint on a public route group to a user-list handler"
  vulnerableTo: [authentication.MissingAuthentication, access_control.MissingAuthorization, secrets.SecretLeak]
}
