module code;

concept CowAgentMemoryFilenameTraversal : issue {
  cwe: [CWE_22]
  reviewAssumption: "the memory content API can pass remote filename payload values to this resolver"
  reviewCategory: path
  reviewCondition: "memory content filenames are joined under workspace directories without canonical containment"
  reviewConfidence: high
  reviewEvidence: "memory path resolver context {pattern} returns os.path.join(..., filename) without realpath containment"
  vulnerableTo: [path.PathTraversal]
}
