module code;

concept MiddlewarePathMatchNormalizationMismatch : issue {
  cwe: [CWE_863, CWE_436]
  reviewAssumption: "whatever first decides access to a request — the router that dispatches it, a middleware it runs, an authorization check over its path — is what every later derivation of the request path has to agree with, so any component that derives its own view of the path can act on a request the earlier decision was never given"
  reviewCategory: access_control
  reviewCondition: "a component canonicalizes or percent-decodes the request path differently from the decision that dispatched or authorized it, so the path it matches, opens or looks up is not the path that decision was taken from"
  reviewConfidence: high
  reviewEvidence: "request path context {pattern} re-derives the request path for itself — percent-decoding alone where the deciding component also normalizes duplicate slashes, trailing slashes, case and parameter delimiters, or decoding the reserved delimiters it left encoded — and matches or opens the result"
  vulnerableTo: [access_control.IncorrectAuthorization, access_control.BrokenAccess]
}
