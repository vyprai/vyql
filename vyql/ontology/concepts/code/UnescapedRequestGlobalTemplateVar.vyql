module code;

concept UnescapedRequestGlobalTemplateVar : issue {
  cwe: [CWE_79]
  reviewAssumption: "the template variables are later rendered into HTML or script context"
  reviewCategory: xss
  reviewCondition: "request data is copied through PHP globals into template variables without an observed HTML escape"
  reviewConfidence: medium
  reviewEvidence: "PHP template context {pattern} copies request-backed globals into render variables"
  vulnerableTo: [injection.Xss]
}
