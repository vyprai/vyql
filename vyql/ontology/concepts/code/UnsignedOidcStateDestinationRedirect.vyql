module code;

concept UnsignedOidcStateDestinationRedirect : issue {
  cwe: [CWE_601]
  review_assumption: "the identity provider or an attacker controlling the callback state value can alter the post-login destination"
  reviewCategory: request_forgery
  reviewCondition: "OIDC callback redirects to a destination carried through the provider-controlled state value without signing or verifying that destination"
  reviewConfidence: high
  reviewEvidence: "OIDC state redirect context {pattern} serializes a destination into state and later redirects the recovered destination without destination_serializer signing"
  vulnerableTo: [request_forgery.OpenRedirect]
}
