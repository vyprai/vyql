module code;

concept RecursiveObjectParentResolveWithoutCycleGuard : issue {
  cwe: [CWE_400, CWE_674]
  reviewAssumption: "a crafted object graph can contain cyclic parent references and force repeated resolution until resource exhaustion or recursion failure"
  reviewCategory: resource
  reviewCondition: "object parent traversal repeatedly resolves parent references without sharing a visited-object or recursion guard"
  reviewConfidence: high
  reviewEvidence: "parent traversal context {pattern} resolves dictionary Parent references through the object resolver while no shared ensured/visited object list is passed"
  vulnerableTo: [dos.UncontrolledResourceConsumption]
}
