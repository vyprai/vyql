module code;

concept CollectiveContactWidgetTitleXss : issue {
  cwe: [CWE_79]
  review_assumption: "contact titles can contain attacker-controlled stored content rendered in the Plone term-contact viewlet"
  reviewCategory: xss
  reviewCondition: "collective.contact.widget term-contact viewlet renders contact titles into a hidden HTML input without escaping"
  reviewConfidence: high
  reviewEvidence: "TermViewlet context {pattern} derives title from context get_full_title or Title and includes self.title in the objpath input value"
  vulnerableTo: [injection.Xss]
}
