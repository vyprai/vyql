module code;

concept StoredUrlHrefAttributeXss : issue {
  cwe: [CWE_79, CWE_116, CWE_20]
  review_assumption: "the stored URL-like field can be supplied by an authenticated user and is later rendered in another user's browser"
  reviewCategory: xss
  reviewCondition: "stored URL fields are rendered into HTML href attributes without URL validation and attribute escaping"
  reviewConfidence: high
  reviewEvidence: "function context {pattern} builds an anchor href from a stored URL-like field through a formatting helper without sanitizeURL/htmlspecialchars-style hardening"
  vulnerableTo: [injection.Xss, validation.ImproperInputValidation]
}
