module code;

concept CredentialAttributeLogExposure : issue {
  cwe: [CWE_532]
  review_assumption: "debug or diagnostic logs may be collected by lower-trust operators or support systems"
  reviewCategory: secret
  reviewCondition: "credential attributes such as access keys or secret keys are included in application log messages"
  reviewConfidence: high
  reviewEvidence: "logging context {pattern} references credential attributes in the same function as a logging call"
  vulnerableTo: [secrets.SecretLeak]
}
