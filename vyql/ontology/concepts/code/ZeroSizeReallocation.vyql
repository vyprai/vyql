module code;

concept ZeroSizeReallocation : issue {
  cwe: [CWE_415]
  enabledBy: [taint.ComputedSize]
  reviewAssumption: "zero is not excluded on the same size value before reallocation"
  reviewCategory: memory
  reviewCondition: "computed allocation size reaches a reallocation primitive that can treat zero size as free"
  reviewConfidence: low
  reviewEvidence: "computed size value reaches {pattern}"
  vulnerableTo: [memory.DoubleFree]
}
