module code;

concept PostTlsIdentityRebindingMissingCheck : issue {
  cwe: [CWE_287, CWE_290, CWE_349, CWE_841]
  review_assumption: "an attacker can make the encrypted identity packet differ from the pre-TLS identity packet and impersonate or rebind the channel peer"
  reviewCategory: request
  reviewCondition: "a protocol handshake exchanges identity packets again after TLS but overwrites the active peer identity without comparing stable identity fields"
  reviewConfidence: high
  reviewEvidence: "post-TLS identity exchange context {pattern} sends local identity, reads a second packet, and reassigns the active identity without observed device-id or protocol-version equality checks"
  vulnerableTo: [authentication.AuthenticationBypass, injection.ProtocolStateConfusion]
}
