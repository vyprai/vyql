module code;

concept OsqueryAllowUnsafePlatformArgs : issue {
  cwe: [CWE_15, CWE_88]
  reviewAssumption: "Elastic Agent can launch osqueryd with agent-controlled configuration that must not enable unsafe osquery flags"
  reviewCategory: misconfig
  reviewCondition: "Windows osqueryd platform arguments set allow_unsafe to true instead of omitting the unsafe flag"
  reviewConfidence: high
  reviewEvidence: "Go osquery platform arguments context {pattern} returns a map containing allow_unsafe: true from platformArgs"
  vulnerableTo: [injection.ArgumentInjection]
}
