module code;

concept UnvalidatedRouteConfigKeyStoredXss : issue {
  cwe: [CWE_79, CWE_20]
  reviewAssumption: "the stored configuration key is later rendered by management UI or metadata responses"
  reviewCategory: xss
  reviewCondition: "route-derived configuration keys are persisted without identifier validation"
  reviewConfidence: high
  reviewEvidence: "configuration-key write context {pattern} forwards a route key into persisted connection configuration"
  vulnerableTo: [injection.Xss]
}
