module code;

concept RequestPluginNamePathTraversal : issue {
  cwe: [CWE_22]
  reviewAssumption: "the plugin or module name is later joined under generated server or web plugin directories"
  reviewCategory: path
  reviewCondition: "a request-bound plugin or module name is passed into code-generation file creation without rejecting path separators"
  reviewConfidence: high
  reviewEvidence: "plugin creation context {pattern} binds request JSON, derives a filesystem component from a plugin name, and calls a create/generate helper before an observed path-separator rejection"
  vulnerableTo: [path.PathTraversal]
}
