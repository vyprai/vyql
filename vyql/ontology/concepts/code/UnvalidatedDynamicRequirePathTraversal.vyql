module code;

concept UnvalidatedDynamicRequirePathTraversal : issue {
  cwe: [CWE_22, CWE_829]
  reviewAssumption: "the module id can cross a trust boundary such as IPC, plugin code, or renderer-controlled widget configuration"
  reviewCategory: code_loading
  reviewCondition: "a caller-controlled module id is joined into a local require path without an allowlist or canonical containment check"
  reviewConfidence: high
  reviewEvidence: "dynamic require context {pattern} builds a JavaScript module path from an identifier and loads it before the patched validation/containment helper"
  vulnerableTo: [path.PathTraversal, injection.UnsafeDynamicLoading]
}
