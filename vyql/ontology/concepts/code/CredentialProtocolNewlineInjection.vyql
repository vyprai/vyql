module code;

concept CredentialProtocolNewlineInjection : issue {
  cwe: [CWE_93, CWE_349, CWE_200]
  reviewAssumption: "credential values can be decoded from attacker-controlled URLs or helper input and an embedded newline can inject additional protocol records"
  reviewCategory: injection
  reviewCondition: "a line-oriented credential protocol writes key/value records without rejecting embedded newlines"
  reviewConfidence: high
  reviewEvidence: "credential protocol writer context {pattern} emits key=value records with newline delimiters before an observed newline rejection"
  vulnerableTo: [injection.ProtocolStateConfusion, injection.CrlfInjection, secrets.SecretLeak]
}
