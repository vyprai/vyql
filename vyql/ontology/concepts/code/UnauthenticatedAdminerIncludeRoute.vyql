module code;

concept UnauthenticatedAdminerIncludeRoute : issue {
  cwe: [CWE_306, CWE_862]
  reviewAssumption: "the framework route is reachable by unauthenticated users when auth_required is false"
  reviewCategory: auth
  reviewCondition: "a web administration route loads the Adminer UI while route authentication is disabled and no session gate is checked"
  reviewConfidence: high
  reviewEvidence: "Adminer route context {pattern} declares auth_required false and requires the Adminer PHP UI before checking an authenticated session marker"
  vulnerableTo: [authentication.MissingAuthentication, access_control.MissingAuthorization]
}
