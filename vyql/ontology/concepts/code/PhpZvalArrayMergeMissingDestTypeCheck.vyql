module code;

concept PhpZvalArrayMergeMissingDestTypeCheck : issue {
  cwe: [CWE_843, CWE_787, CWE_125]
  reviewAssumption: "crafted nested query or parameter data can make the existing destination zval non-array while the incoming zval is an array"
  reviewCategory: memory
  reviewCondition: "PHP C API array-merge logic descends through a destination zval as an array after only checking the incoming zval type"
  reviewConfidence: high
  reviewEvidence: "PHP zval merge context {pattern} checks Z_TYPE_PP(test_ptr) before using Z_ARRVAL_PP(ptr) without an observed Z_TYPE_PP(ptr) array guard"
  vulnerableTo: [memory.TypeConfusion, memory.OobRead, memory.OobWrite]
}
