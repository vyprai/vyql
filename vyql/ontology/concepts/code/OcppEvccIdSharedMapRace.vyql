module code;

concept OcppEvccIdSharedMapRace : issue {
  cwe: [CWE_362, CWE_416]
  review_assumption: "EV information callbacks and transaction/session handlers can concurrently update and read EVCCID strings"
  reviewCategory: concurrency
  reviewCondition: "OCPP EVCCID state is stored in a shared std::map of std::string values without a monitor or lock wrapper"
  reviewConfidence: high
  reviewEvidence: "OCPP module context {pattern} declares EVCCID state as a raw std::map keyed by EVSE id"
  vulnerableTo: [concurrency.RaceCondition, memory.UseAfterFree]
}
