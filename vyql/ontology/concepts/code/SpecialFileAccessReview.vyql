module code;

concept SpecialFileAccessReview : issue {
  cwe: [CWE_61, CWE_706]
  reviewAssumption: "the path may be redirected away from the intended special filesystem"
  reviewCategory: path
  reviewCondition: "security-sensitive virtual filesystem path is opened without an observed secure filesystem boundary"
  reviewConfidence: possibility
  reviewEvidence: "special-file access context {pattern} uses ordinary path opening"
  vulnerableTo: [path.LinkFollowing]
}
