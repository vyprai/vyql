module code;

concept DropdownEntryLabelInnerHtmlXss : issue {
  cwe: [CWE_79]
  reviewAssumption: "dropdown labels can originate from user-controlled names or external API data"
  reviewCategory: xss
  reviewCondition: "dropdown entry helper interpolates a label into innerHTML without sanitizing the label"
  reviewConfidence: high
  reviewEvidence: "dropdown entry context {pattern} builds li.innerHTML from label before sanitizeHTML(label)"
  vulnerableTo: [injection.Xss]
}
