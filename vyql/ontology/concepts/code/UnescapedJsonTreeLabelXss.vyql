module code;

concept UnescapedJsonTreeLabelXss : issue {
  cwe: [CWE_79]
  review_assumption: "the frontend component renders the text label as HTML or otherwise interprets markup in tree/list labels"
  reviewCategory: xss
  reviewCondition: "JSON tree or list node labels include stored names without HTML escaping before the browser UI renders them"
  reviewConfidence: high
  reviewEvidence: "tree-node label context {pattern} returns a stored name in a text label without htmlspecialchars or equivalent escaping"
  vulnerableTo: [injection.Xss]
}
