module code;

concept NodePreGypRemoteBinaryInstall : issue {
  cwe: [CWE_829, CWE_494]
  reviewAssumption: "installing the package can fetch and execute a remote native binary outside the package tarball's integrity boundary"
  reviewCategory: supply_chain
  reviewCondition: "an npm package lifecycle install script invokes node-pre-gyp to download and load a prebuilt native binary from a remote host"
  reviewConfidence: high
  reviewEvidence: "npm package manifest context {pattern} declares node-pre-gyp, a binary host, and an install lifecycle script"
  vulnerableTo: [injection.UnsafeDynamicLoading, injection.CodeInjection]
}
