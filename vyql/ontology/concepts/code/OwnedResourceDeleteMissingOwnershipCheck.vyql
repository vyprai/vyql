module code;

concept OwnedResourceDeleteMissingOwnershipCheck : issue {
  cwe: [CWE_639, CWE_862, CWE_863]
  review_assumption: "the request parameter identifies a resource owned by another principal and the delete operation is externally reachable"
  reviewCategory: auth
  reviewCondition: "a delete handler loads resource metadata and deletes backend state without constraining the action to an admin or the resource owner"
  reviewConfidence: high
  reviewEvidence: "resource delete context {pattern} fetches object metadata and reaches backend or registry deletion before an observed owner/admin authorization check"
  vulnerableTo: [access_control.Idor, access_control.IncorrectAuthorization]
}
