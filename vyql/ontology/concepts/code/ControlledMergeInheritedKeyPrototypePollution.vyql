module code;

concept ControlledMergeInheritedKeyPrototypePollution : issue {
  cwe: [CWE_1321]
  reviewAssumption: "an attacker can supply an object whose inherited keys include prototype-mutating names such as __proto__"
  reviewCategory: prototype_pollution
  reviewCondition: "controlled-merge copies inherited source keys into result object properties during recursive merge"
  reviewConfidence: high
  reviewEvidence: "controlled merge context {pattern} iterates over a source object and writes keyed values into a target object without limiting keys to own/safe properties"
  vulnerableTo: [injection.PrototypePollution]
}
