module code;

concept CockpitAuthArrayNosqlInjection : issue {
  cwe: [CWE_943]
  reviewAssumption: "the Cockpit authentication backend builds a MongoLite query from the supplied auth fields"
  reviewCategory: nosql
  reviewCondition: "Cockpit Auth check passes request auth array fields into authentication before scalar type validation"
  reviewConfidence: high
  reviewEvidence: "Cockpit Auth::check context {pattern} reads auth data and calls authenticate($data) without is_string guards on user/password"
  vulnerableTo: [injection.NosqlInjection]
}
