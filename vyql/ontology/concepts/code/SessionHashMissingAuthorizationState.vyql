module code;

concept SessionHashMissingAuthorizationState : issue {
  cwe: [CWE_863, CWE_613]
  reviewAssumption: "existing sessions are accepted until the stored hash changes, so changing authorization fields should invalidate or rebind the session"
  reviewCategory: auth
  reviewCondition: "session validity hashes omit authorization state that can change while a session remains active"
  reviewConfidence: high
  reviewEvidence: "authentication context {pattern} stores a session hash from the password only while role, home directory, or permissions can be updated separately"
  vulnerableTo: [access_control.IncorrectAuthorization, session.SessionFixation]
}
