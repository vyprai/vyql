module code;

concept SecretComparisonReview : issue {
  cwe: [CWE_200, CWE_203, CWE_208]
  review_assumption: "an attacker can repeatedly submit candidate values and observe timing or error differences"
  reviewCategory: crypto
  reviewCondition: "secret material is compared with an ordinary equality operation instead of a constant-time comparison"
  reviewConfidence: medium
  reviewEvidence: "secret comparison context {pattern} derives request data and secret data without an observed constant-time compare"
  vulnerableTo: [crypto.ObservableDiscrepancy]
}
