module code;

concept UnfilteredSearchWhereColumns : issue {
  cwe: [CWE_89, CWE_287]
  review_assumption: "unauthenticated API callers can include both allowed and disallowed search keys"
  reviewCategory: sql
  reviewCondition: "request-derived search keys are only partially checked before the full search array reaches a query where()"
  reviewConfidence: medium
  reviewEvidence: "search scope context {pattern} intersects keys with an allowlist but passes the original search array into where()"
  vulnerableTo: [injection.SqlInjection]
}
