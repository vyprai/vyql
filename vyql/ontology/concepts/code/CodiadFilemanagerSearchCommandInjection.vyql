module code;

concept CodiadFilemanagerSearchCommandInjection : issue {
  cwe: [CWE_78]
  review_assumption: "filemanager actions can receive attacker-controlled search parameters"
  reviewCategory: "command-injection"
  reviewCondition: "Codiad Filemanager stores raw search parameters before building shell find/grep commands"
  reviewConfidence: high
  reviewEvidence: "Filemanager class context {pattern} assigns query, search_string, and search_file_type without escapeshellarg before shell_exec"
  vulnerableTo: [injection.CommandInjection]
}
