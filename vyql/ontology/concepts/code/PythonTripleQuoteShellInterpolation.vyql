module code;

concept PythonTripleQuoteShellInterpolation : issue {
  cwe: [CWE_94, CWE_77]
  review_assumption: "the hook JSON can contain user-controlled path fields with apostrophe sequences that close the Python literal"
  reviewCategory: code_execution
  reviewCondition: "shell-captured hook input is interpolated into Python source inside a triple-quoted string literal"
  reviewConfidence: high
  reviewEvidence: "shell interpreter context {pattern} passes a python3 -c program that embeds $input in json.loads('''...''')"
  vulnerableTo: [injection.CodeInjection, injection.CommandInjection]
}
