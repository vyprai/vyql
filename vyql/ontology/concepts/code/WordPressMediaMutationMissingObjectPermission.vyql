module code;

concept WordPressMediaMutationMissingObjectPermission : issue {
  cwe: [CWE_862, CWE_863]
  review_assumption: "callers that satisfy broad upload privileges may still target media owned by another author unless the attachment object is checked"
  reviewCategory: access_control
  reviewCondition: "a WordPress media controller uses a request-selected attachment/post for media replacement without an object-specific permission check"
  reviewConfidence: high
  reviewEvidence: "media mutation context {pattern} loads the attachment/post and prepares or runs a replacement flow before an observed checkImagePermission or edit_post capability gate"
  vulnerableTo: [access_control.MissingAuthorization]
}
