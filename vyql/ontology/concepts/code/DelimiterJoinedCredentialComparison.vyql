module code;

concept DelimiterJoinedCredentialComparison : issue {
  cwe: [CWE_287, CWE_303]
  reviewAssumption: "at least one of the joined fields carries attacker-chosen text, so it can contain the separator the join uses"
  reviewCategory: auth
  reviewCondition: "an authentication check compares a whole delimiter-joined composite for equality instead of comparing the fields it is built from"
  reviewConfidence: high
  reviewEvidence: "equality check {pattern} tests a concatenation that interleaves constant separators with variable fields against a stored value, with no split of that value in the same scope"
  vulnerableTo: [authentication.ImproperAuthentication, authentication.AuthenticationBypass]
}
