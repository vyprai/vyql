module code;

concept SamlAssertionWrappingBypass : issue {
  cwe: [CWE_287, CWE_347]
  reviewAssumption: "an attacker can submit a SAML response with wrapping or duplicate Assertion elements so the signed assertion differs from the assertion later unmarshaled for authentication"
  reviewCategory: auth
  reviewCondition: "SAML assertion signature validation searches and rewrites signed Assertion elements without proving there is exactly one direct assertion in the expected namespace"
  reviewConfidence: high
  reviewEvidence: "SAML assertion validation context {pattern} iterates namespace matches, detaches an assertion for signature validation, and replaces children in the response tree"
  vulnerableTo: [authentication.ImproperAuthentication, crypto.ImproperSignatureCheck]
}
