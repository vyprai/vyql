module code;

concept NamespacedSubjectKeyCollision : issue {
  cwe: [CWE_200, CWE_863]
  reviewAssumption: "tenant owners are ServiceAccounts with colliding names in different namespaces and the reflector cache is enabled"
  reviewCategory: auth
  reviewCondition: "namespaced Kubernetes ServiceAccount subjects are indexed without namespace in authorization or cache keys"
  reviewConfidence: medium
  reviewEvidence: "role binding reflector context {pattern} builds subject lookup keys from subject kind and name but omits namespace"
  vulnerableTo: [access_control.IncorrectAuthorization, secrets.SecretLeak]
}
