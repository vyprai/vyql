module code;

concept SensitiveSettingsExposureReview : issue {
  cwe: [CWE_306, CWE_287, CWE_200]
  reviewAssumption: "the settings response can be requested by unauthenticated callers"
  reviewCategory: auth
  reviewCondition: "sensitive settings fields are included in an API settings response without an observed authentication gate"
  reviewConfidence: possibility
  reviewEvidence: "settings response construction {pattern} includes a sensitive settings field"
  vulnerableTo: [authentication.MissingAuthentication, secrets.SecretLeak]
}
