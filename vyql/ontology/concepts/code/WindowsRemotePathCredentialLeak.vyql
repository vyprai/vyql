module code;

concept WindowsRemotePathCredentialLeak : issue {
  cwe: [CWE_200, CWE_522]
  reviewAssumption: "probing a UNC path from a privileged Windows service can trigger outbound SMB authentication and expose machine or service credential material"
  reviewCategory: secret
  reviewCondition: "privileged Windows service code probes or opens a caller-configurable path before rejecting UNC or network paths"
  reviewConfidence: high
  reviewEvidence: "Windows path handling context {pattern} uses a configured path in QFileInfo/QSettings/watchdog setup without an observed remote-path guard"
  vulnerableTo: [secrets.SecretLeak]
}
