module code;

concept UnverifiedKeyIdPathResolution : issue {
  cwe: [CWE_22]
  reviewAssumption: "an attacker can modify an unverified vault or configuration file before the key is loaded"
  reviewCategory: path
  reviewCondition: "code resolves an unverified key identifier or scheme-specific URI value under a trusted vault/base path before selecting or loading the key file"
  reviewConfidence: high
  reviewEvidence: "key-loading context {pattern} resolves keyId.getSchemeSpecificPart() under the vault path and checks or loads the resulting file before replacing it with a fixed trusted filename or containment check"
  vulnerableTo: [path.PathTraversal]
}
