module code;

concept KubernetesCurlAuthorizationHeaderLogLeak : issue {
  cwe: [CWE_532]
  reviewAssumption: "debugCurlCommand logging is enabled at high verbosity and request headers may contain bearer or authorization tokens"
  reviewCategory: secret
  reviewCondition: "Kubernetes client-go curl debug logging formats request authorization headers without redaction"
  reviewConfidence: high
  reviewEvidence: "requestInfo.toCurl context {pattern} iterates RequestHeaders and formats key/value header pairs before a maskValue call"
  vulnerableTo: [secrets.SecretLeak]
}
