module code;

concept LdapCrlCredentialReuse : issue {
  cwe: [CWE_200, CWE_522]
  review_assumption: "the CRL Distribution Point URL can be supplied through a client certificate and can point to an attacker-controlled LDAP endpoint"
  reviewCategory: secret
  reviewCondition: "LDAP CRL fetching reuses configured LDAP bind credentials for certificate-controlled LDAP URLs"
  reviewConfidence: medium
  reviewEvidence: "LDAP CRL connection context {pattern} copies an authenticated connection config, replaces the LDAP URL, and opens a connection without clearing bind initializers"
  vulnerableTo: [secrets.SecretLeak]
}
