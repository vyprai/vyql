module code;

concept UnsanitizedFrameDocumentWrite : issue {
  cwe: [CWE_79]
  reviewAssumption: "the markup written into the frame can carry content a caller or a remote service supplies"
  reviewCategory: xss
  reviewCondition: "a frame's own document is filled with a markup string -- through a write on its document or through its srcdoc property -- while the frame carries no sandbox restriction and the string passes through no sanitizer"
  reviewConfidence: medium
  reviewEvidence: "frame rendering context {pattern} fills the frame's own document with markup -- writing into its contentDocument or assigning its srcdoc -- with neither a sandbox restriction on the frame nor a sanitizer on the markup"
  vulnerableTo: [injection.Xss]
}
