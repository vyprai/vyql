module code;

concept EmptySourceSliceMemoryExpansion : issue {
  cwe: [CWE_400, CWE_770, CWE_789]
  reviewAssumption: "callers can request a large target size while the selected source slice is empty"
  reviewCategory: resource
  reviewCondition: "an empty source slice can still drive target-size memory expansion and zero-fill writes"
  reviewConfidence: high
  reviewEvidence: "memory setter context {pattern} unwraps a caller-supplied target size, resizes storage, and loops over the target size without an empty-source guard"
  vulnerableTo: [dos.UncontrolledResourceConsumption]
}
