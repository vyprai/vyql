module code;

concept PasswordRecoveryLinkHostControl : issue {
  cwe: [CWE_640]
  reviewAssumption: "the inbound Host header or proxy host metadata can be attacker-controlled when the reset email is generated"
  reviewCategory: auth
  reviewCondition: "password recovery notifications build reset links from request-derived or ambient host metadata"
  reviewConfidence: high
  reviewEvidence: "password recovery link context {pattern} sends a reset-token URL without an observed configured application base URL"
  vulnerableTo: [authentication.WeakPasswordRecovery]
}
