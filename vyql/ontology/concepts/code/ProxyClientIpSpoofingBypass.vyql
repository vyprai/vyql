module code;

concept ProxyClientIpSpoofingBypass : issue {
  cwe: [CWE_287, CWE_348]
  review_assumption: "backend services trust X-Forwarded-For or X-Real-IP to distinguish local or trusted requests"
  reviewCategory: auth
  reviewCondition: "gateway proxying forwards client-controlled source-IP headers to backend authorization logic without normalizing them against the direct peer"
  reviewConfidence: medium
  reviewEvidence: "gateway route context {pattern} selects a backend proxy and forwards the request without observed source-IP header rewriting"
  vulnerableTo: [authentication.ImproperAuthentication, access_control.IncorrectAuthorization]
}
