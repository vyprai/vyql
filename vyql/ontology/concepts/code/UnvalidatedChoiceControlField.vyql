module code;

concept UnvalidatedChoiceControlField : issue {
  cwe: [CWE_20]
  reviewAssumption: "callers can supply the choice field and downstream authorization or business logic depends on the canonical value set"
  reviewCategory: input_validation
  reviewCondition: "a request- or caller-controlled choice field can bypass normalization when it is merely truthy"
  reviewConfidence: medium
  reviewEvidence: "choice normalization context {pattern} returns early on a truthy control field before assigning canonical allowed values"
  vulnerableTo: [validation.ImproperInputValidation]
}
