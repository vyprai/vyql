module code;

concept ManualZipEntryFileWrite : issue {
  cwe: [CWE_22]
  review_assumption: "archive member names can include parent-directory components or absolute path forms"
  reviewCategory: path
  reviewCondition: "zip entry names are joined into filesystem paths before writes without a containment check"
  reviewConfidence: medium
  reviewEvidence: "manual zip extraction context {pattern} joins an archive member name into the destination path"
  vulnerableTo: [path.PathTraversal]
}
