module code;

concept ProtocolListAmplification : issue {
  cwe: [CWE_400]
  reviewAssumption: "a remote peer can send zero-sized list metadata with a very large element count and force per-element iteration"
  reviewCategory: resource
  reviewCondition: "protocol list readers accept zero-sized element counts without charging an equivalent traversal budget"
  reviewConfidence: medium
  reviewEvidence: "protocol list context {pattern} builds a list reader from attacker-controlled element counts without an observed amplification charge"
  vulnerableTo: [dos.UncontrolledResourceConsumption]
}
