module code;

concept DhcpOptionLengthUncheckedRead : issue {
  cwe: [CWE_125, CWE_20]
  reviewAssumption: "a network client can send a truncated DHCP option buffer to the parser"
  reviewCategory: memory
  reviewCondition: "DHCP option parsing reads option payload bytes before validating the option length fits in the packet"
  reviewConfidence: high
  reviewEvidence: "DHCP option parser context {pattern} reads optptr+2/optptr[1] and advances by the advertised length without observed end and option-length checks"
  vulnerableTo: [memory.OobRead, validation.ImproperInputValidation]
}
