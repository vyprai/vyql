module code;

concept FrameworkRequestBeforeSessionValidation : issue {
  cwe: [CWE_20]
  review_assumption: "attackers can supply an invalid session identifier that should be rejected before framework request setup"
  reviewCategory: input_validation
  reviewCondition: "framework request or transport state should be created only after request session identifiers are validated"
  reviewConfidence: medium
  reviewEvidence: "request handler context {pattern} builds framework request state before validating the session lookup"
  vulnerableTo: [validation.ImproperInputValidation]
}
