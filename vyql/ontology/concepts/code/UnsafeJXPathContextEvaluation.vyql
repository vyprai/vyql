module code;

concept UnsafeJXPathContextEvaluation : issue {
  cwe: [CWE_94, CWE_95]
  reviewAssumption: "the XPath expression can be influenced by service filters, property names, or XML/query inputs"
  reviewCategory: code_execution
  reviewCondition: "JXPath expressions are evaluated with a context that still exposes Java method/function invocation"
  reviewConfidence: high
  reviewEvidence: "JXPath context {pattern} is created and used for getValue/selectNodes/iterate without an empty FunctionLibrary or safe context helper"
  vulnerableTo: [injection.CodeInjection, injection.ExpressionLanguageInjection]
}
