module code;

concept CiviCrmScientificNotationNumericValidationBypass : issue {
  cwe: [CWE_89, CWE_20]
  review_assumption: "request parameters validated as Int or Positive can later be interpolated into SQL fragments such as the AJAX location lookups"
  reviewCategory: sql
  reviewCondition: "CiviCRM numeric validation accepts exponent-form numeric strings before downstream SQL integer use"
  reviewConfidence: high
  reviewEvidence: "CRM_Utils_Rule numeric validator context {pattern} combines is_numeric with regex checks without the fail-closed !is_numeric gate added by CRM-13460"
  vulnerableTo: [injection.SqlInjection, validation.ImproperInputValidation]
}
