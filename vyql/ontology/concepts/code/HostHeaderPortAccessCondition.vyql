module code;

concept HostHeaderPortAccessCondition : issue {
  cwe: [CWE_290, CWE_346]
  reviewAssumption: "the request Host header is client-supplied, so its port component only echoes the port the caller claims rather than the listener that accepted the connection"
  reviewCategory: auth
  reviewCondition: "a request gate branches on the port component of the request Host header instead of the connection's server-side local endpoint"
  reviewConfidence: medium
  reviewEvidence: "port gate context {pattern} compares the Host header's port component inside a branch condition"
  vulnerableTo: [access_control.OriginValidationError, access_control.IncorrectAuthorization]
}
