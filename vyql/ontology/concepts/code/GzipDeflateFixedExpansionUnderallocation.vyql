module code;

concept GzipDeflateFixedExpansionUnderallocation : issue {
  cwe: [CWE_119, CWE_787]
  reviewAssumption: "some inputs can expand by more than the fixed slack under the deflate worst-case expansion bound"
  reviewCategory: memory
  reviewCondition: "a gzip or deflate output buffer is sized as input length plus a fixed constant"
  reviewConfidence: high
  reviewEvidence: "gzip/deflate context {pattern} initializes deflate, allocates output from input length plus a fixed additive slack, and then compresses into that buffer"
  vulnerableTo: [memory.OobWrite]
}
