  reviewCondition: "native Windows FFI library loading falls back to POSIX library directories"
  reviewConfidence: high
  reviewEvidence: "Ruby FFI library loader context {pattern} searches /usr library paths after DynamicLibrary.open fails without a Windows guard"
  vulnerableTo: [path.UncontrolledSearchPath]
}
