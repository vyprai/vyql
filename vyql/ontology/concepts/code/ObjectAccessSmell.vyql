module code;

concept ObjectAccessSmell : sink {
  cwe: [CWE_639, CWE_862, CWE_863, CWE_284]
  enabledBy: [taint.UntrustedData]
  reviewAssumption: "the object is not constrained to the authenticated principal or tenant"
  reviewCategory: access_control
  reviewCondition: "attacker-controlled input reaches an object fetch with no ownership constraint"
  reviewConfidence: medium
  reviewEvidence: "object fetch {pattern} receives tainted input"
  vulnerableTo: [access_control.Idor, access_control.BrokenAccess]
}
