module code;

concept WordPressOptionUpdateMissingCsrf : issue {
  cwe: [CWE_352]
  reviewAssumption: "an authenticated administrator can be induced to submit the settings request cross-site"
  reviewCategory: csrf
  reviewCondition: "WordPress option updates consume request data without nonce verification"
  reviewConfidence: high
  reviewEvidence: "WordPress settings context {pattern} reads request parameters and calls update_option without check_admin_referer or wp_verify_nonce"
  vulnerableTo: [request_forgery.Csrf]
}
