module code;

concept KubernetesTemplateSecretLookupExposure : issue {
  cwe: [CWE_200, CWE_522, CWE_863]
  reviewAssumption: "lower-trust users can author or influence templates executed by a controller service account with broader Secret read permissions"
  reviewCategory: secret
  reviewCondition: "a template helper can read arbitrary Kubernetes Secret keys through the in-cluster client"
  reviewConfidence: high
  reviewEvidence: "Kubernetes template helper context {pattern} builds an in-cluster client and reads CoreV1 Secrets using caller-supplied secret, namespace, and key inputs"
  vulnerableTo: [secrets.SecretLeak, access_control.MissingAuthorization]
}
