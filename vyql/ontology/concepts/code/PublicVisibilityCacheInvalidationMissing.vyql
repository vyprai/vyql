module code;

concept PublicVisibilityCacheInvalidationMissing : issue {
  cwe: [CWE_863]
  review_assumption: "the cached public-status response gates unauthenticated or cross-tenant access to sandbox proxy or preview data"
  reviewCategory: auth
  reviewCondition: "public-visibility cache entries are not invalidated when the public status changes"
  reviewConfidence: high
  reviewEvidence: "cache invalidation service {pattern} clears sandbox runner cache on lifecycle events but lacks public-status update invalidation"
  vulnerableTo: [access_control.IncorrectAuthorization]
}
