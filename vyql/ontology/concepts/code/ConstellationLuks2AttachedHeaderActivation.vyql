module code;

concept ConstellationLuks2AttachedHeaderActivation : issue {
  cwe: [CWE_347]
  reviewAssumption: "the encrypted persistent-storage device is supplied by an untrusted host to the confidential guest"
  reviewCategory: crypto
  reviewCondition: "Constellation opens an existing LUKS2 device through an attached, host-provided header without detached-header validation"
  reviewConfidence: high
  reviewEvidence: "cryptsetup initialization context {pattern} initializes the data device directly without extracting and verifying the LUKS2 header metadata"
  vulnerableTo: [crypto.ImproperSignatureCheck]
}
