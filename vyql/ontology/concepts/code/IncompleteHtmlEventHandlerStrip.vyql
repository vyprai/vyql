module code;

concept IncompleteHtmlEventHandlerStrip : issue {
  cwe: [CWE_79]
  reviewAssumption: "attacker-controlled or user-editable HTML can contain inline event handlers that execute when rendered back into the editor"
  reviewCategory: xss
  reviewCondition: "an HTML source/editor sanitizer strips scripts and iframes but leaves inline event-handler attributes"
  reviewConfidence: high
  reviewEvidence: "HTML source filter {pattern} removes script/iframe content without an observed on* attribute removal step"
  vulnerableTo: [injection.Xss]
}
