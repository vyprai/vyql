module code;

concept CinnyServiceWorkerMediaAuthLeak : issue {
  cwe: [CWE_20, CWE_200, CWE_522]
  reviewAssumption: "an attacker-controlled media URL can contain Matrix media path fragments while targeting a non-homeserver origin"
  reviewCategory: secret
  reviewCondition: "service-worker media fetch authorization is selected by substring path checks before a bearer token is attached"
  reviewConfidence: high
  reviewEvidence: "service-worker fetch context {pattern} obtains an access token from the client and uses Matrix media path includes checks before fetchConfig(token)"
  vulnerableTo: [secrets.SecretLeak]
}
