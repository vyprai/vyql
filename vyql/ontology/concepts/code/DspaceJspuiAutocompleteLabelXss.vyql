module code;

concept DspaceJspuiAutocompleteLabelXss : issue {
  cwe: [CWE_79]
  review_assumption: "autocomplete suggestions may contain attacker-controlled or indexed metadata that jQuery UI renders as HTML"
  reviewCategory: xss
  reviewCondition: "JSPUI autocomplete labels escape server-provided display text before inserting it into the jQuery UI label HTML"
  reviewConfidence: high
  reviewEvidence: "autocomplete label context {pattern} concatenates item.displayedValue into label without escapeHtml or equivalent encoding"
  vulnerableTo: [injection.Xss]
}
