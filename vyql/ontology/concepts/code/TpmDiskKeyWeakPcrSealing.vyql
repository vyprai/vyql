module code;

concept TpmDiskKeyWeakPcrSealing : issue {
  cwe: [CWE_327, CWE_347]
  review_assumption: "disk-key unsealing relies on this PCR selection to bind the key to measured boot state"
  reviewCategory: crypto
  reviewCondition: "disk-key TPM sealing binds to SHA1 PCR selections and omits the measured PCR used by the secure boot chain"
  reviewConfidence: high
  reviewEvidence: "TPM sealing context {pattern} initializes DiskKeySealingPCRs with tpm2.AlgSHA1 and the pre-fix PCR list"
  vulnerableTo: [crypto.WeakHash, crypto.ImproperSignatureCheck]
}
