module code;

concept CallFutureRawWeakStateRef : issue {
  cwe: [CWE_401, CWE_400]
  reviewAssumption: "repeated polling before completion can allocate additional weak references that no callback consumes"
  reviewCategory: resource
  reviewCondition: "a raw weak reference to call future state should only be created when the IC call callback is registered"
  reviewConfidence: medium
  reviewEvidence: "call future polling creates raw weak state reference {pattern}"
  vulnerableTo: [resource.ResourceLeak, dos.UncontrolledResourceConsumption]
}
