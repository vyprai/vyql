module code;

concept PremasterSecretLengthReview : issue {
  cwe: [CWE_203]
  review_assumption: "an attacker can submit malformed RSA ciphertexts and observe alert, exception, or handshake behavior differences"
  reviewCategory: crypto
  reviewCondition: "TLS RSA premaster-secret decryption output is used without confirming the required 48-byte length"
  reviewConfidence: medium
  reviewEvidence: "premaster-secret context {pattern} decrypts attacker-controlled ciphertext and later uses fixed premaster-secret offsets"
  vulnerableTo: [crypto.ObservableDiscrepancy]
}
