module code;

concept UnboundedCopy : sink {
  cwe: [CWE_787, CWE_120]
  enabledBy: [taint.UntrustedData]
  review_assumption: "the destination capacity can be smaller than the copied bytes"
  reviewCategory: memory
  reviewCondition: "attacker-controlled bytes reach an unbounded copy into a fixed-size destination"
  reviewConfidence: high
  reviewEvidence: "unsafe copy primitive {pattern} receives tainted input"
  vulnerableTo: [memory.OobWrite]
}
