module code;

concept TyperPrettyExceptionLocalsSecretExposure : issue {
  cwe: [CWE_200, CWE_209, CWE_532]
  review_assumption: "exceptions may be surfaced in GitHub Actions logs or other CI output where local variables become visible"
  reviewCategory: secret
  reviewCondition: "Typer/Rich pretty exceptions can display local variables while the CLI keeps bearer tokens in locals"
