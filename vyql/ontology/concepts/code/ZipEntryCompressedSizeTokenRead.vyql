module code;

concept ZipEntryCompressedSizeTokenRead : issue {
  cwe: [CWE_400]
  reviewAssumption: "attacker-controlled ZIP metadata can select a large or amplification-prone entry consumed during type detection"
  reviewCategory: resource
  reviewCondition: "ZIP entry parsing reads a StringType sized directly from the compressed-size header before applying an inflate/output limit"
  reviewConfidence: high
  reviewEvidence: "ZIP parser call {pattern} passes zipHeader.compressedSize into Token.StringType for tokenizer.readToken"
  vulnerableTo: [dos.UncontrolledResourceConsumption]
}
