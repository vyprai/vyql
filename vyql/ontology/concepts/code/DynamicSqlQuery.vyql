module code;

concept DynamicSqlQuery : issue {
  cwe: [CWE_89]
  reviewAssumption: "some component of the query is influenced by input"
  reviewCategory: sql
  reviewCondition: "a SQL string built by interpolation or concatenation reaches an execute primitive unparameterized"
  reviewConfidence: medium
  reviewEvidence: "query execution {pattern} receives a dynamically built string"
  vulnerableTo: [injection.SqlInjection]
}
