module code;

concept ErrorDetailDisclosure : issue {
  cwe: [CWE_209]
  reviewAssumption: "the detail describes internals the caller should not learn"
  reviewCategory: secret
  reviewCondition: "exception detail is serialized into an HTTP response"
  reviewConfidence: medium
  reviewEvidence: "response {pattern} carries exception detail"
  vulnerableTo: [access_control.IncorrectAuthorization]
}
