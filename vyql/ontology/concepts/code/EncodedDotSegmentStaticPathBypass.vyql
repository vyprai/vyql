module code;

concept EncodedDotSegmentStaticPathBypass : issue {
  cwe: [CWE_22, CWE_184]
  review_assumption: "request paths can contain percent-encoded dot segments that downstream URL or filesystem handling normalizes before static file resolution"
  reviewCategory: path
  reviewCondition: "static-file path filtering rejects literal dot-slash traversal but misses percent-encoded dot segments"
  reviewConfidence: high
  reviewEvidence: "static-file path context {pattern} checks request pathname for './' before file serving without decoding or rejecting %2e dot encodings"
  vulnerableTo: [path.PathTraversal, validation.ImproperInputValidation]
}
