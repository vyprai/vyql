module code;

concept SnsCertificateUrlTrustBypass : issue {
  cwe: [CWE_295, CWE_918]
  reviewAssumption: "an attacker can provide a signed SNS/SES notification whose SigningCertURL points at an attacker-controlled matching cloud hostname"
  reviewCategory: crypto
  reviewCondition: "SNS/SES message verification accepts a broad certificate URL host suffix before downloading and trusting the certificate"
  reviewConfidence: high
  reviewEvidence: "SNS certificate URL context {pattern} returns SigningCertURL after only HTTPS and trusted-domain suffix checks, without the strict SimpleNotificationService certificate URL allowlist"
  vulnerableTo: [crypto.ImproperCertValidation, request_forgery.Ssrf]
}
