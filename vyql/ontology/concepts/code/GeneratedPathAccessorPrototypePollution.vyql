module code;

concept GeneratedPathAccessorPrototypePollution : issue {
  cwe: [CWE_1321, CWE_94]
  reviewAssumption: "a caller can provide path segments such as __proto__, constructor, prototype, or code metacharacters that affect the generated accessor"
  reviewCategory: prototype_pollution
  reviewCondition: "nested path accessors generate JavaScript property-access code from caller path strings and compile it with Function"
  reviewConfidence: high
  reviewEvidence: "path accessor context {pattern} splits a path, builds property access strings, caches the generated function, and compiles it with new Function"
  vulnerableTo: [injection.PrototypePollution, injection.CodeInjection]
}
