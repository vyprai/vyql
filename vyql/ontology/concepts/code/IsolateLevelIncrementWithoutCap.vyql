module code;

concept IsolateLevelIncrementWithoutCap : issue {
  cwe: [CWE_787, CWE_125]
  review_assumption: "attacker-controlled bidi isolate characters can drive nesting high enough to exceed the explicit-level array bounds"
  reviewCategory: memory
  reviewCondition: "Unicode bidi isolate nesting increments isolate_level without capping it before using it as an isolate-level array index"
  reviewConfidence: high
  reviewEvidence: "bidi isolate context {pattern} stores RL_ISOLATE_LEVEL from isolate_level++ and then indexes base_level_per_iso_level or run_per_isolate_level by isolate_level"
  vulnerableTo: [memory.OobWrite, memory.OobRead]
}
