module code;

concept UnescapedMysqlDsnDatabaseName : issue {
  cwe: [CWE_89, CWE_20]
  review_assumption: "the database name later becomes the path component of a MySQL DSN where query separators can alter connection parameters"
  reviewCategory: sql
  reviewCondition: "a caller-selected MySQL database name is kept in migration or connection context without URL escaping before DSN use"
  reviewConfidence: high
  reviewEvidence: "migration CLI context {pattern} accepts or derives DatabaseName and continues without an observed url.QueryEscape normalization"
  vulnerableTo: [injection.SqlInjection, validation.ImproperInputValidation]
}
