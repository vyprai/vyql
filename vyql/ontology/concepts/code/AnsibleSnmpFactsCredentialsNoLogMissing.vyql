module code;

concept AnsibleSnmpFactsCredentialsNoLogMissing : issue {
  cwe: [CWE_532]
  review_assumption: "Ansible module argument values are echoed in console output or failure diagnostics unless no_log marks them sensitive"
  reviewCategory: secret
  reviewCondition: "Ansible snmp_facts declares SNMPv3 authkey and privkey module options without no_log redaction"
  reviewConfidence: high
  reviewEvidence: "snmp_facts module context {pattern} defines authkey/privkey options and uses them in UsmUserData without no_log=True"
  vulnerableTo: [secrets.SecretLeak]
}
