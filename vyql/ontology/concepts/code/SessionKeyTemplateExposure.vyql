module code;

concept SessionKeyTemplateExposure : issue {
  cwe: [CWE_200, CWE_522]
  reviewAssumption: "session primary keys are bearer credentials that allow session hijacking if disclosed"
  reviewCategory: secret
  reviewCondition: "a template exposes server session keys in a rendered action URL or form"
  reviewConfidence: high
  reviewEvidence: "session-management template context {pattern} uses the session primary key in a rendered action"
  vulnerableTo: [secrets.SecretLeak]
}
