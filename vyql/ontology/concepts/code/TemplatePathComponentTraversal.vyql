module code;

concept TemplatePathComponentTraversal : issue {
  cwe: [CWE_22]
  reviewAssumption: "at least one interpolated template path component can contain a path separator, absolute path, or parent-directory segment"
  reviewCategory: path
  reviewCondition: "template or resource path builders interpolate path components before basename canonicalization"
  reviewConfidence: high
  reviewEvidence: "template path builder context {pattern} returns a templates/... path containing interpolated components without observed basename canonicalization for those components"
  vulnerableTo: [path.PathTraversal]
}
