module code;

concept TenantServiceAccountAdmissionBypass : issue {
  cwe: [CWE_863]
  review_assumption: "tenant namespace service accounts can be granted namespace update or patch permissions and reach namespace admission webhooks"
  reviewCategory: auth
  reviewCondition: "tenant namespace service accounts are not recognized by the admission-user predicate"
  reviewConfidence: medium
  reviewEvidence: "admission user helper {pattern} checks configured groups but lacks a tenant namespace service-account lookup"
  vulnerableTo: [access_control.IncorrectAuthorization]
}
