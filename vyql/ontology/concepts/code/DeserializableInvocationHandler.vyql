module code;

concept DeserializableInvocationHandler : issue {
  cwe: [CWE_502]
  reviewAssumption: "attacker-controlled serialized data can include or reach the proxy handler object graph"
  reviewCategory: deserialization
  reviewCondition: "a dynamic-proxy invocation handler can be serialized without an observed rejection hook"
  reviewConfidence: medium
  reviewEvidence: "invocation handler class context {pattern} lacks readResolve/readObject rejection"
  vulnerableTo: [deserialization.DeserializationAbuse]
}
