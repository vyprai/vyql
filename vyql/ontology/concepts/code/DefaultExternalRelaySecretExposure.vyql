module code;

concept DefaultExternalRelaySecretExposure : issue {
  cwe: [CWE_200]
  review_assumption: "the fallback host may be outside the product trust boundary or operational owner for the supplied connection metadata"
  reviewCategory: secret
  reviewCondition: "a public library builds a relay/proxy/websocket URL using a hardcoded fallback host while embedding a token, credential, or caller URL in the outbound path"
  reviewConfidence: medium
  reviewEvidence: "relay URL builder context {pattern} selects a default host and places sensitive connection metadata into the URL sent to that host"
  vulnerableTo: [secrets.SecretLeak]
}
