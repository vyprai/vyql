module code;

concept EnvFileVariableInjection : issue {
  cwe: [CWE_15, CWE_74]
  review_assumption: "the token or setting value can contain newline or quote characters that introduce additional environment variables"
  reviewCategory: injection
  reviewCondition: ".env update helper writes caller-supplied values into environment assignment lines without escaping newline or quote syntax"
  reviewConfidence: high
  reviewEvidence: "environment file update context {pattern} interpolates update values into raw KEY=value lines before writeFileSync instead of using dotenv stringify or equivalent escaping"
  vulnerableTo: [injection.CodeInjection, validation.ImproperInputValidation]
}
