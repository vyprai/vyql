module code;

concept GleezRedactorEditorStoredXss : issue {
  cwe: [CWE_79]
  reviewAssumption: "authors can save HTML-mode content that is later opened by an administrator in the editor"
  reviewCategory: xss
  reviewCondition: "Gleez CMS enables the Redactor source editor for stored HTML content without server-side sanitization"
  reviewConfidence: high
  reviewEvidence: "editor bootstrap {pattern} initializes Redactor on CMS textareas before the security patch disabled it"
  vulnerableTo: [injection.Xss]
}
