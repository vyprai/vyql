module code;

concept UnsanitizedSvgUpload : issue {
  cwe: [CWE_79]
  reviewAssumption: "stored SVG files can be served back to users and scriptable SVG content can execute in a browser"
  reviewCategory: xss
  reviewCondition: "uploaded SVG content is accepted and stored without an observed SVG sanitizer"
  reviewConfidence: high
  reviewEvidence: "file upload context {pattern} detects or handles SVG uploads and stores the file before sanitizing its XML content"
  vulnerableTo: [injection.Xss]
}
