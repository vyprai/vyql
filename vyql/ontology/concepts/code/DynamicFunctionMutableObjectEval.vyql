module code;

concept DynamicFunctionMutableObjectEval : issue {
  cwe: [CWE_94]
  reviewAssumption: "attacker-controlled expression text or object properties can influence generated code or mutate the evaluated object"
  reviewCategory: code_execution
  reviewCondition: "a string expression is compiled with the Function constructor and evaluated against a mutable object"
  reviewConfidence: high
  reviewEvidence: "dynamic predicate context {pattern} builds a Function body from an expression and object property expansion without freezing or isolating the object first"
  vulnerableTo: [injection.CodeInjection]
}
