module code;

concept UnanchoredOAuthEmailRegexAuthBypass : issue {
  cwe: [CWE_287, CWE_184]
  reviewAssumption: "configured auth patterns may be literal emails or domains where prefix regex matching lets attacker-controlled suffixes pass authorization"
  reviewCategory: auth
  reviewCondition: "OAuth callback email authorization uses prefix regex matching against configured auth patterns instead of exact or full-string matching"
  reviewConfidence: high
  reviewEvidence: "OAuth email authorization call {pattern} uses re.match with the configured auth pattern and an email-like identity operand"
  vulnerableTo: [authentication.ImproperAuthentication, authentication.AuthenticationBypass, validation.ImproperInputValidation]
}
