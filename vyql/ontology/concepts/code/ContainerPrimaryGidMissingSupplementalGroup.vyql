module code;

concept ContainerPrimaryGidMissingSupplementalGroup : issue {
  cwe: [CWE_284, CWE_732]
  reviewAssumption: "the container runtime requires the effective GID to appear in the process supplemental group list for expected filesystem/group access semantics"
  reviewCategory: auth
  reviewCondition: "container process setup applies an effective primary GID without also adding that GID to supplemental groups"
  reviewConfidence: high
  reviewEvidence: "container user setup context {pattern} calls SetProcessGID and adds other supplemental groups before the patched AddProcessAdditionalGid(gid) call"
  vulnerableTo: [access_control.InsecurePermission, access_control.MissingAuthorization]
}
