module code;

concept FrappeLinkExpansionMissingReadPermission : issue {
  cwe: [CWE_862, CWE_863]
  reviewAssumption: "expanded linked documents may reference records or fields the caller cannot read directly"
  reviewCategory: auth
  reviewCondition: "Frappe document link expansion fetches linked documents without enforcing read permission and field-level read filtering"
  reviewConfidence: high
  reviewEvidence: "link expansion context {pattern} resolves Link and Dynamic Link fields through frappe.get_doc before updating the response document"
  vulnerableTo: [access_control.MissingAuthorization, access_control.BrokenAccess]
}
