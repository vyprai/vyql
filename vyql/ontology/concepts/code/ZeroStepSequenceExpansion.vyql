module code;

concept ZeroStepSequenceExpansion : issue {
  cwe: [CWE_400]
  reviewAssumption: "a zero step leaves the loop variable unchanged while the loop condition remains true"
  reviewCategory: resource
  reviewCondition: "sequence expansion loop can use a zero increment"
  reviewConfidence: high
  reviewEvidence: "sequence expansion context {pattern} derives the loop step from parsed input without excluding zero before incrementing the loop variable"
  vulnerableTo: [dos.UncontrolledResourceConsumption]
}
