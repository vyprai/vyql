module code;

concept RawMemoryCopySizeSink : sink {
  cwe: [CWE_787]
  enabledBy: [taint.UntrustedData]
  reviewAssumption: "the size or source offset can exceed the destination/source object bounds"
  reviewCategory: memory
  reviewCondition: "raw memory copy size expression needs bounds review"
  reviewConfidence: medium
  reviewEvidence: "copy-size argument to {pattern} is computed or externally influenced"
  vulnerableTo: [memory.OobWrite]
}
