module code;

concept UntrustedSupportUrlNotification : issue {
  cwe: [CWE_20]
  review_assumption: "mail clients or administrator workflows may auto-link the supplied URL, causing the notification to imply trust in an attacker-selected site"
  reviewCategory: validation
  reviewCondition: "a support or contact endpoint forwards a user-supplied site URL into an administrator notification as trusted context"
  reviewConfidence: high
  reviewEvidence: "support notification context {pattern} validates request data, formats a Site field from request URL input, and schedules or sends the administrator notification without trusted-host derivation or URL defanging"
  vulnerableTo: [validation.ImproperInputValidation]
}
