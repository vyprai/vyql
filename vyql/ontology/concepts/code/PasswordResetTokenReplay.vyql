module code;

concept PasswordResetTokenReplay : issue {
  cwe: [CWE_640, CWE_294]
  reviewAssumption: "the reset link reaches the account's mailbox and can be observed, forwarded or replayed after the reset it was issued for has already completed"
  reviewCategory: auth
  reviewCondition: "a password reset is authorised by a self-describing token the request carries, recomputed at verification time from a static configured reset salt, with no server-side recovery record the reset consumes"
  reviewConfidence: high
  reviewEvidence: "password reset context {pattern} checks a request-supplied reset hash against a value recomputed from the configured reset salt and writes the new credential, with no stored recovery record read or invalidated and no binding to the authenticated session"
  vulnerableTo: [authentication.WeakPasswordRecovery, authentication.AuthenticationBypass]
}
