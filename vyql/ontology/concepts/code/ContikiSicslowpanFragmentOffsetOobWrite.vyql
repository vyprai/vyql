module code;

concept ContikiSicslowpanFragmentOffsetOobWrite : issue {
  cwe: [CWE_787]
  reviewAssumption: "an attacker can send forged 6LoWPAN fragments that control the reassembly offset and fragment length metadata"
  reviewCategory: memory
  reviewCondition: "Contiki-NG 6LoWPAN reassembly copies a stored fragment into uip_buf using an unchecked forged fragment offset"
  reviewConfidence: high
  reviewEvidence: "copy_frags2uip context {pattern} shifts frag_buf[i].offset into the UIP_IP_BUF destination pointer and copies frag_buf[i].len without checking offset + length against uip_buf"
  vulnerableTo: [memory.OobWrite]
}
