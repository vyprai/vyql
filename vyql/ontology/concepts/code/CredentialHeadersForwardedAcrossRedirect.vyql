module code;

concept CredentialHeadersForwardedAcrossRedirect : issue {
  cwe: [CWE_200]
  reviewAssumption: "the 3xx that starts the next hop is chosen by whoever runs the server the first request reached, so the redirect target is that server's choice and not the caller's"
  reviewCategory: secret
  reviewCondition: "a client that follows a redirect builds the next request from the previous request's header set and never removes the credential headers when the redirect target's host differs from the current one"
  reviewConfidence: high
  reviewEvidence: "redirect-following context {pattern} reads a Location header and carries a header set into the next request while naming none of the credential headers a change of host would have to drop"
  vulnerableTo: [secrets.SecretLeak]
}
