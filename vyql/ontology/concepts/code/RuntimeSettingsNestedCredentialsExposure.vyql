module code;

concept RuntimeSettingsNestedCredentialsExposure : issue {
  cwe: [CWE_200, CWE_522]
  review_assumption: "the settings response is reachable by users that should not receive stored integration credentials"
  reviewCategory: secret
  reviewCondition: "a settings API serializes cloned runtime configuration after redacting one credential subtree while leaving a sibling nested credentials object unredacted"
  reviewConfidence: high
  reviewEvidence: "settings response context {pattern} clones runtime settings, deletes a known password field, and returns the settings object without deleting the nested credentials field"
  vulnerableTo: [secrets.SecretLeak]
}
