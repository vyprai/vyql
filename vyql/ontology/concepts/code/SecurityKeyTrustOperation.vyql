module code;

concept SecurityKeyTrustOperation : sink {
  cwe: [CWE_358, CWE_347]
  enabledBy: [taint.WeakSecurityIdentifier]
  reviewAssumption: "the keyserver or trust store may contain a colliding key identifier"
  reviewCategory: crypto
  reviewCondition: "a shortened security key identifier reaches a key trust operation"
  reviewConfidence: medium
  reviewEvidence: "trust operation {pattern} receives a shortened identifier"
  vulnerableTo: [crypto.IncompleteSecurityIdentifier, crypto.ImproperSignatureCheck]
}
